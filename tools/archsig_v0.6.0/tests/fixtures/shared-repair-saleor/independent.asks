i=evaluate(Selected.internal,r=@v/root)
x=evaluate(Selected.x,r=@v/root)
xy=evaluate(Selected.xy,r=@v/root)
xyz=evaluate(Selected.xyz,r=@v/root)
task=solve(Selected.task,using=Selected.choose,on=@v/root,r=@v/root)
payment=solve(Selected.payment,using=Selected.choose,on=@v/root,r=@v/root)
shared=solve(Selected.valid,using=Selected.choose,on=@v/root,r=@v/root)
c=candidate($shared.solutions,index=0)
a=apply($c.assignment,in=$shared.solutions)
ok=check(Selected.valid,on=$a.object,r=@v/root)
