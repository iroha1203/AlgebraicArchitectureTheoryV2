law "archsig.law/2" semantics "archsig/0.6.0";
reading Assembly {
  use vocabulary Assemble version "1" digest "sha256:70e64f16f80c3bbf72183abe6484522a516abf45472ce742952a557faa23abe2";
  view amount(p:Part):Z = p.quantity;
  view ownerOf(p:Part):Root = p.owner;
  view fragments(a:Root,b:Root,ma:Part,mb:Part):Set<Root> = set<Root>{a,b};
  view interfaces(a:Root,b:Root,ma:Part,mb:Part):List<(Part,Part)> = list<(Part,Part)>[(ma,mb)];
  view singleton(p:Part):Set<Part> = set<Part>{p};
  change choose(p:Part,q:Bool) = p with {quantity=if q then 1 else 0};
  view moves(x:Move,y:Move):Set<Move> = set<Move>{x,y};law required zero(p:Part):p.quantity=0;
}
