law "archsig.law/2" semantics "archsig/0.6.0";reading Selected{use vocabulary Pattern version "1" digest "sha256:a58703ca86def7d070f1affd096bc1cc599a9255222081141defa3382bfed0f4";view input(r:Root):Bool=r.h;view all(r:Root):Set<Part> =Part[r];view small(r:Root):Set<Part> =set{c|c in Part[r] where c.label="x"};change choose(c:Part,p:Bool)=c with{flag=p};law required valid(r:Root):forall c in Part[r]. if c.label="z" then true else c.flag=r.h;}