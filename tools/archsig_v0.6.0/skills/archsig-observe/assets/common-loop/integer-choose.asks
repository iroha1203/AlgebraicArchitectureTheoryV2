u=evaluate(Pair.all,s=@v/s)
n=evaluate(Pair.vacant,s=@v/s)
p=prepare(Pair.valid,using=Pair.choose,on=@v/s,inputs=Pair.input,s=@v/s)
d=observe(Pair.constant,on=$p.problem,within=$u.value,output=decision,s=@v/s)
a=observe(Pair.input,on=$p.problem,within=$u.value,output=assignment,s=@v/s)
ranges=scopes($p.problem)
small=solve($p.problem,within=$n.value)
wide=solve($p.problem,within=$u.value)
first=candidate($wide.solutions,index=0)
other=candidate($wide.solutions,index=1)
ap=apply($first.assignment,in=$wide.solutions)
ok=check(Pair.valid,on=$ap.object,s=@v/s)
