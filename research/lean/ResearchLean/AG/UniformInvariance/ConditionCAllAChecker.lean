import ResearchLean.AG.UniformInvariance.PresentationASubnerveDefect
import Formal.Util.AssertStandardAxioms

/-!
# Executable checker for Condition C on every target subnerve

This module discharges the executable-checker obligation in claim (iii) of
`G-107-aat-uniform-invariance-characterization`.  It reads only the finite raw
tables of a `FiniteComparisonPresentation`.  Finite graph reachability decides
C1, while exact rational ranks of the fiber boundary maps decide C3.

The checker does not evaluate the semantic proposition with `Classical.dec`,
and the presentation stores no condition bit, path, filling chain, matrix,
rank, or checker result.  Correctness is proved by transporting the raw cells
to the actual canonical A-subnerves generated by `toGeometry`.
-/

namespace AAT.AG.ResolutionInvariance

open CanonicalResolution BigOperators
open ExecutableRationalLinearAlgebra

universe u

/-! ## A rank criterion for a finite two-step chain complex -/

namespace ExecutableRationalLinearAlgebra

/-- For a finite two-step complex over `ℚ`, exactness in the middle is
equivalent to the sum of the two executable ranks being the number of middle
basis vectors. -/
theorem ker_le_range_iff_finrank_range_add_eq_card
    {F E V : Type*} [Fintype F] [Fintype E] [Fintype V]
    (boundaryTwo : (F → ℚ) →ₗ[ℚ] (E → ℚ))
    (boundaryOne : (E → ℚ) →ₗ[ℚ] (V → ℚ))
    (hcomplex : boundaryOne.comp boundaryTwo = 0) :
    (∀ chain, boundaryOne chain = 0 →
        ∃ faces, boundaryTwo faces = chain) ↔
      Module.finrank ℚ (LinearMap.range boundaryOne) +
          Module.finrank ℚ (LinearMap.range boundaryTwo) =
        Fintype.card E := by
  have hrangeKer : LinearMap.range boundaryTwo ≤ LinearMap.ker boundaryOne := by
    rintro chain ⟨faces, rfl⟩
    change boundaryOne (boundaryTwo faces) = 0
    have happly := LinearMap.congr_fun hcomplex faces
    simpa using happly
  have hrankNullity := LinearMap.finrank_range_add_finrank_ker boundaryOne
  rw [Module.finrank_fintype_fun_eq_card] at hrankNullity
  constructor
  · intro hexact
    have hkerRange : LinearMap.ker boundaryOne ≤ LinearMap.range boundaryTwo := by
      intro chain hchain
      obtain ⟨faces, hfaces⟩ := hexact chain hchain
      exact ⟨faces, hfaces⟩
    have heq : LinearMap.ker boundaryOne = LinearMap.range boundaryTwo :=
      le_antisymm hkerRange hrangeKer
    rw [heq] at hrankNullity
    exact hrankNullity
  · intro hranks chain hchain
    have hfinrank :
        Module.finrank ℚ (LinearMap.range boundaryTwo) =
          Module.finrank ℚ (LinearMap.ker boundaryOne) := by
      omega
    have heq : LinearMap.range boundaryTwo = LinearMap.ker boundaryOne :=
      Submodule.eq_of_le_of_finrank_eq hrangeKer hfinrank
    have : chain ∈ LinearMap.range boundaryTwo := by
      rw [heq]
      exact hchain
    exact this

end ExecutableRationalLinearAlgebra

namespace FiniteComparisonPresentation

/-- Every finite coarse-target subset is the finite set underlying a sublist
of the presentation's explicit target enumeration.  This local coverage API
keeps the Condition C checker independent of the uniformity decider. -/
theorem exists_conditionC_sublists_toFinset_eq
    (P : FiniteComparisonPresentation) (A : Finset P.CoarseTarget) :
    ∃ targets ∈ P.coarseTargetEntries.sublists, targets.toFinset = A := by
  let targets := P.coarseTargetEntries.filter fun target => decide (target ∈ A)
  refine ⟨targets, List.mem_sublists.mpr List.filter_sublist, ?_⟩
  ext target
  simp [targets, P.coarseTarget_mem_coarseTargetEntries]

/-! ## Raw endpoint fibers and finite reachability -/

/-- A selected raw fine edge has both endpoint images equal to one selected
coarse chart. -/
def rawFiberEdge (P : FiniteComparisonPresentation)
    (A : Finset P.CoarseTarget) (coarseChart : P.CoarseChartIn A)
    (fineEdge : P.FineEdgeIn A) : Prop :=
  P.chartMapIn A (P.fineEdgeLeftIn A fineEdge) = coarseChart ∧
    P.chartMapIn A (P.fineEdgeRightIn A fineEdge) = coarseChart

/-- Raw endpoint-fiber membership is decidable from the finite chart table. -/
instance rawFiberEdgeDecidable (P : FiniteComparisonPresentation)
    (A : Finset P.CoarseTarget) (coarseChart : P.CoarseChartIn A)
    (fineEdge : P.FineEdgeIn A) :
    Decidable (P.rawFiberEdge A coarseChart fineEdge) := by
  unfold rawFiberEdge
  infer_instance

/-- A selected raw fine face all of whose three boundary edges lie in one
endpoint fiber. -/
def rawInternalFace (P : FiniteComparisonPresentation)
    (A : Finset P.CoarseTarget) (coarseChart : P.CoarseChartIn A)
    (fineFace : P.FineFaceIn A) : Prop :=
  P.rawFiberEdge A coarseChart (P.fineFaceEdge0In A fineFace) ∧
    P.rawFiberEdge A coarseChart (P.fineFaceEdge1In A fineFace) ∧
      P.rawFiberEdge A coarseChart (P.fineFaceEdge2In A fineFace)

/-- Raw internal-face membership is decidable from the three finite incidence
tables and endpoint-fiber membership. -/
instance rawInternalFaceDecidable (P : FiniteComparisonPresentation)
    (A : Finset P.CoarseTarget) (coarseChart : P.CoarseChartIn A)
    (fineFace : P.FineFaceIn A) :
    Decidable (P.rawInternalFace A coarseChart fineFace) := by
  unfold rawInternalFace
  infer_instance

/-- Raw undirected adjacency inside one endpoint-defined chart fiber. -/
def rawFiberAdjacent (P : FiniteComparisonPresentation)
    (A : Finset P.CoarseTarget) (coarseChart : P.CoarseChartIn A)
    (left right : P.FineChartIn A) : Prop :=
  ∃ fineEdge : P.FineEdgeIn A,
    P.rawFiberEdge A coarseChart fineEdge ∧
      ((P.fineEdgeLeftIn A fineEdge = left ∧
          P.fineEdgeRightIn A fineEdge = right) ∨
        (P.fineEdgeLeftIn A fineEdge = right ∧
          P.fineEdgeRightIn A fineEdge = left))

/-- Raw fiber adjacency has a constructive decision procedure obtained by
finite search through the selected raw edge table. -/
instance rawFiberAdjacentDecidable (P : FiniteComparisonPresentation)
    (A : Finset P.CoarseTarget) (coarseChart : P.CoarseChartIn A) :
    DecidableRel (P.rawFiberAdjacent A coarseChart) := by
  intro left right
  unfold rawFiberAdjacent rawFiberEdge
  infer_instance

/-- The executable simple graph underlying one raw endpoint fiber.  Removing
loops does not change reflexive-transitive reachability. -/
def fiberGraph (P : FiniteComparisonPresentation)
    (A : Finset P.CoarseTarget) (coarseChart : P.CoarseChartIn A) :
    SimpleGraph (P.FineChartIn A) :=
  SimpleGraph.fromRel (P.rawFiberAdjacent A coarseChart)

/-- Adjacency in the executable fiber graph is exactly unequal raw vertices
joined by raw fiber adjacency in either orientation.  This definition-owner
API lets finite counterexamples reason about the graph without unfolding its
`SimpleGraph.fromRel` representation. -/
theorem fiberGraph_adj_iff (P : FiniteComparisonPresentation)
    (A : Finset P.CoarseTarget) (coarseChart : P.CoarseChartIn A)
    (left right : P.FineChartIn A) :
    (P.fiberGraph A coarseChart).Adj left right ↔
      left ≠ right ∧
        (P.rawFiberAdjacent A coarseChart left right ∨
          P.rawFiberAdjacent A coarseChart right left) :=
  SimpleGraph.fromRel_adj _ _ _

/-- Adjacency in the raw fiber graph is constructively decidable. -/
instance fiberGraphAdjDecidable (P : FiniteComparisonPresentation)
    (A : Finset P.CoarseTarget) (coarseChart : P.CoarseChartIn A) :
    DecidableRel (P.fiberGraph A coarseChart).Adj := by
  change DecidableRel
    (SimpleGraph.fromRel (P.rawFiberAdjacent A coarseChart)).Adj
  infer_instance

/-- Raw fiber adjacency is symmetric. -/
theorem rawFiberAdjacent_symm (P : FiniteComparisonPresentation)
    (A : Finset P.CoarseTarget) (coarseChart : P.CoarseChartIn A)
    {left right : P.FineChartIn A}
    (hadjacent : P.rawFiberAdjacent A coarseChart left right) :
    P.rawFiberAdjacent A coarseChart right left := by
  obtain ⟨fineEdge, hfiber, hendpoints⟩ := hadjacent
  exact ⟨fineEdge, hfiber, hendpoints.elim Or.inr Or.inl⟩

/-- The raw selected chart map commutes with the canonical cell
equivalences and the actual A-subnerve chart map. -/
theorem chartMapIn_equiv_aSubnerveChartMap
    (P : FiniteComparisonPresentation) (A : Finset P.CoarseTarget)
    (fineChart : P.FineChartIn A) :
    P.coarseChartEquiv A (P.chartMapIn A fineChart) =
      P.toGeometry.aSubnerveChartMap (A : Set P.CoarseTarget)
        (P.fineChartEquiv A fineChart) := by
  apply Subtype.ext
  rfl

/-- Raw endpoint-fiber membership is exactly actual A-subnerve endpoint-fiber
membership under the canonical raw/semantic cell equivalences. -/
theorem rawFiberEdge_iff_targetSubsetFiberEdge
    (P : FiniteComparisonPresentation) (A : Finset P.CoarseTarget)
    (coarseChart : P.CoarseChartIn A) (fineEdge : P.FineEdgeIn A) :
    P.rawFiberEdge A coarseChart fineEdge ↔
      P.toGeometry.TargetSubsetFiberEdge (A : Set P.CoarseTarget)
        (P.coarseChartEquiv A coarseChart) (P.fineEdgeEquiv A fineEdge) := by
  rw [P.toGeometry.targetSubsetFiberEdge_iff_endpoint_cells]
  constructor
  · rintro ⟨hleft, hright⟩
    have hleftVal := congrArg Subtype.val hleft
    have hrightVal := congrArg Subtype.val hright
    change P.chartMap (P.fineEdgeLeft fineEdge.1) = coarseChart.1 at hleftVal
    change P.chartMap (P.fineEdgeRight fineEdge.1) = coarseChart.1 at hrightVal
    exact ⟨hleftVal, hrightVal⟩
  · rintro ⟨hleft, hright⟩
    constructor
    · apply Subtype.ext
      exact hleft
    · apply Subtype.ext
      exact hright

/-- Raw fiber adjacency is exactly actual A-subnerve fiber adjacency under
the canonical raw/semantic cell equivalences. -/
theorem rawFiberAdjacent_iff_targetSubsetFiberAdjacent
    (P : FiniteComparisonPresentation) (A : Finset P.CoarseTarget)
    (coarseChart : P.CoarseChartIn A) (left right : P.FineChartIn A) :
    P.rawFiberAdjacent A coarseChart left right ↔
      P.toGeometry.TargetSubsetFiberAdjacent (A : Set P.CoarseTarget)
        (P.coarseChartEquiv A coarseChart)
        (P.fineChartEquiv A left) (P.fineChartEquiv A right) := by
  constructor
  · rintro ⟨fineEdge, hfiber, hendpoints⟩
    refine ⟨P.fineEdgeEquiv A fineEdge,
      (P.rawFiberEdge_iff_targetSubsetFiberEdge A coarseChart fineEdge).1
        hfiber, ?_⟩
    rcases hendpoints with hforward | hbackward
    · left
      constructor
      · rw [← P.fineEquiv_edgeLeft A fineEdge]
        exact congrArg (P.fineChartEquiv A) hforward.1
      · rw [← P.fineEquiv_edgeRight A fineEdge]
        exact congrArg (P.fineChartEquiv A) hforward.2
    · right
      constructor
      · rw [← P.fineEquiv_edgeLeft A fineEdge]
        exact congrArg (P.fineChartEquiv A) hbackward.1
      · rw [← P.fineEquiv_edgeRight A fineEdge]
        exact congrArg (P.fineChartEquiv A) hbackward.2
  · rintro ⟨semanticEdge, hfiber, hendpoints⟩
    let fineEdge := (P.fineEdgeEquiv A).symm semanticEdge
    refine ⟨fineEdge,
      (P.rawFiberEdge_iff_targetSubsetFiberEdge A coarseChart fineEdge).2
        (by simpa [fineEdge] using hfiber), ?_⟩
    rcases hendpoints with hforward | hbackward
    · left
      constructor
      · apply (P.fineChartEquiv A).injective
        rw [P.fineEquiv_edgeLeft A fineEdge]
        simpa [fineEdge] using hforward.1
      · apply (P.fineChartEquiv A).injective
        rw [P.fineEquiv_edgeRight A fineEdge]
        simpa [fineEdge] using hforward.2
    · right
      constructor
      · apply (P.fineChartEquiv A).injective
        rw [P.fineEquiv_edgeLeft A fineEdge]
        simpa [fineEdge] using hbackward.1
      · apply (P.fineChartEquiv A).injective
        rw [P.fineEquiv_edgeRight A fineEdge]
        simpa [fineEdge] using hbackward.2

/-- Bounded reachability in the raw fiber graph is exactly the semantic
reflexive-transitive A-subnerve fiber adjacency relation. -/
theorem fiberGraph_reachable_iff_targetSubsetFiberAdjacent_reflTransGen
    (P : FiniteComparisonPresentation) (A : Finset P.CoarseTarget)
    (coarseChart : P.CoarseChartIn A) (left right : P.FineChartIn A) :
    (P.fiberGraph A coarseChart).Reachable left right ↔
      Relation.ReflTransGen
        (P.toGeometry.TargetSubsetFiberAdjacent (A : Set P.CoarseTarget)
          (P.coarseChartEquiv A coarseChart))
        (P.fineChartEquiv A left) (P.fineChartEquiv A right) := by
  rw [SimpleGraph.reachable_iff_reflTransGen]
  constructor
  · intro hpath
    apply Relation.ReflTransGen.lift (P.fineChartEquiv A) _ hpath
    intro rawLeft rawRight hadjacent
    have hraw : P.rawFiberAdjacent A coarseChart rawLeft rawRight :=
      hadjacent.2.elim id (P.rawFiberAdjacent_symm A coarseChart)
    exact (P.rawFiberAdjacent_iff_targetSubsetFiberAdjacent
      A coarseChart rawLeft rawRight).1 hraw
  · intro hpath
    apply Relation.ReflTransGen.lift' (P.fineChartEquiv A).symm _ hpath
    intro semanticLeft semanticRight hadjacent
    have hraw : P.rawFiberAdjacent A coarseChart
        ((P.fineChartEquiv A).symm semanticLeft)
        ((P.fineChartEquiv A).symm semanticRight) := by
      apply (P.rawFiberAdjacent_iff_targetSubsetFiberAdjacent A coarseChart
        ((P.fineChartEquiv A).symm semanticLeft)
        ((P.fineChartEquiv A).symm semanticRight)).2
      simpa using hadjacent
    by_cases hequal :
        (P.fineChartEquiv A).symm semanticLeft =
          (P.fineChartEquiv A).symm semanticRight
    · rw [hequal]
    · exact Relation.ReflTransGen.single ⟨hequal, Or.inl hraw⟩

/-- Raw C1 on one finite target subset, using bounded finite-graph
reachability rather than a nonconstructive transitive-closure decision. -/
def RawConditionC1At (P : FiniteComparisonPresentation)
    (A : Finset P.CoarseTarget) : Prop :=
  ∀ coarseChart : P.CoarseChartIn A,
    (∃ fineChart : P.FineChartIn A,
      P.chartMapIn A fineChart = coarseChart) ∧
    ∀ left right : P.FineChartIn A,
      P.chartMapIn A left = coarseChart →
      P.chartMapIn A right = coarseChart →
      (P.fiberGraph A coarseChart).Reachable left right

/-- Raw finite C1 is constructively decidable by finite quantification and
the bounded-walk reachability instance of `fiberGraph`. -/
instance rawConditionC1AtDecidable (P : FiniteComparisonPresentation)
    (A : Finset P.CoarseTarget) : Decidable (P.RawConditionC1At A) := by
  unfold RawConditionC1At
  infer_instance

/-- Executable raw C1 check on one target subset. -/
def conditionC1AtTargetSubsetCheck (P : FiniteComparisonPresentation)
    (A : Finset P.CoarseTarget) : Bool :=
  decide (P.RawConditionC1At A)

/-- Raw bounded C1 is equivalent to C1 on the actual canonical A-subnerve. -/
theorem rawConditionC1At_iff_conditionC1AtTargetSubset
    (P : FiniteComparisonPresentation) (A : Finset P.CoarseTarget) :
    P.RawConditionC1At A ↔
      P.toGeometry.ConditionC1AtTargetSubset (A : Set P.CoarseTarget) := by
  constructor
  · intro hraw semanticCoarseChart
    let coarseChart := (P.coarseChartEquiv A).symm semanticCoarseChart
    obtain ⟨⟨rawFineChart, hrawMap⟩, hrawConnected⟩ := hraw coarseChart
    constructor
    · refine ⟨P.fineChartEquiv A rawFineChart, ?_⟩
      rw [← P.chartMapIn_equiv_aSubnerveChartMap A rawFineChart]
      simpa [coarseChart] using congrArg (P.coarseChartEquiv A) hrawMap
    · intro semanticLeft semanticRight hleftMap hrightMap
      let rawLeft := (P.fineChartEquiv A).symm semanticLeft
      let rawRight := (P.fineChartEquiv A).symm semanticRight
      have hrawLeft : P.chartMapIn A rawLeft = coarseChart := by
        apply (P.coarseChartEquiv A).injective
        rw [P.chartMapIn_equiv_aSubnerveChartMap A rawLeft]
        simpa [rawLeft, coarseChart] using hleftMap
      have hrawRight : P.chartMapIn A rawRight = coarseChart := by
        apply (P.coarseChartEquiv A).injective
        rw [P.chartMapIn_equiv_aSubnerveChartMap A rawRight]
        simpa [rawRight, coarseChart] using hrightMap
      have hreachable := hrawConnected rawLeft rawRight hrawLeft hrawRight
      simpa [rawLeft, rawRight, coarseChart] using
        (P.fiberGraph_reachable_iff_targetSubsetFiberAdjacent_reflTransGen
          A coarseChart rawLeft rawRight).1 hreachable
  · intro hsemantic coarseChart
    obtain ⟨⟨semanticFineChart, hsemanticMap⟩, hsemanticConnected⟩ :=
      hsemantic (P.coarseChartEquiv A coarseChart)
    let fineChart := (P.fineChartEquiv A).symm semanticFineChart
    constructor
    · refine ⟨fineChart, ?_⟩
      apply (P.coarseChartEquiv A).injective
      rw [P.chartMapIn_equiv_aSubnerveChartMap A fineChart]
      simpa [fineChart] using hsemanticMap
    · intro rawLeft rawRight hleftMap hrightMap
      have hsemanticLeft :
          P.toGeometry.aSubnerveChartMap (A : Set P.CoarseTarget)
              (P.fineChartEquiv A rawLeft) =
            P.coarseChartEquiv A coarseChart := by
        rw [← P.chartMapIn_equiv_aSubnerveChartMap A rawLeft]
        exact congrArg (P.coarseChartEquiv A) hleftMap
      have hsemanticRight :
          P.toGeometry.aSubnerveChartMap (A : Set P.CoarseTarget)
              (P.fineChartEquiv A rawRight) =
            P.coarseChartEquiv A coarseChart := by
        rw [← P.chartMapIn_equiv_aSubnerveChartMap A rawRight]
        exact congrArg (P.coarseChartEquiv A) hrightMap
      apply (P.fiberGraph_reachable_iff_targetSubsetFiberAdjacent_reflTransGen
        A coarseChart rawLeft rawRight).2
      exact hsemanticConnected _ _ hsemanticLeft hsemanticRight

/-- The executable finite C1 check is sound and complete for actual
A-subnerve C1. -/
theorem conditionC1AtTargetSubsetCheck_eq_true_iff
    (P : FiniteComparisonPresentation) (A : Finset P.CoarseTarget) :
    P.conditionC1AtTargetSubsetCheck A = true ↔
      P.toGeometry.ConditionC1AtTargetSubset (A : Set P.CoarseTarget) := by
  rw [conditionC1AtTargetSubsetCheck, decide_eq_true_iff]
  exact P.rawConditionC1At_iff_conditionC1AtTargetSubset A

/-! ## Direct finite checks for C0, C2, C4, C5, and C6 -/

/-- Raw finite C0, stated only with the support tables, raw chart map, and
executable comparison factor. -/
def RawConditionC0 (P : FiniteComparisonPresentation) : Prop :=
  ∀ coarseChart coarseTarget,
    coarseTarget ∈ P.coarseChartSupport coarseChart ↔
      ∃ fineChart fineTarget,
        P.chartMap fineChart = coarseChart ∧
        fineTarget ∈ P.fineChartSupport fineChart ∧
        P.computedFactor fineTarget = coarseTarget

/-- Raw finite C2 on one selected target subset. -/
def RawConditionC2At (P : FiniteComparisonPresentation)
    (A : Finset P.CoarseTarget) : Prop :=
  ∀ coarseEdge : P.CoarseEdgeIn A,
    ∃ fineEdge : P.FineEdgeIn A,
      P.edgeMap fineEdge.1 = some coarseEdge.1

/-- Raw finite C4 on one selected target subset. -/
def RawConditionC4At (P : FiniteComparisonPresentation)
    (A : Finset P.CoarseTarget) : Prop :=
  ∀ coarseFace : P.CoarseFaceIn A,
    ∃ fineFace : P.FineFaceIn A,
      P.faceMap fineFace.1 = some coarseFace.1

/-- Raw finite C5, requiring uniqueness of every declared edge lift. -/
def RawConditionC5 (P : FiniteComparisonPresentation) : Prop :=
  ∀ coarseEdge fineLeft fineRight,
    P.edgeMap fineLeft = some coarseEdge →
    P.edgeMap fineRight = some coarseEdge →
    fineLeft = fineRight

/-- Raw finite C6, reflecting every mapped coarse self-loop to a fine
self-loop. -/
def RawConditionC6 (P : FiniteComparisonPresentation) : Prop :=
  ∀ fineEdge coarseEdge,
    P.edgeMap fineEdge = some coarseEdge →
    P.coarseEdgeLeft coarseEdge = P.coarseEdgeRight coarseEdge →
    P.fineEdgeLeft fineEdge = P.fineEdgeRight fineEdge

/-- Raw finite C0 is constructively decidable. -/
instance rawConditionC0Decidable (P : FiniteComparisonPresentation) :
    Decidable P.RawConditionC0 := by
  unfold RawConditionC0
  infer_instance

/-- Raw finite C2 is constructively decidable. -/
instance rawConditionC2AtDecidable (P : FiniteComparisonPresentation)
    (A : Finset P.CoarseTarget) : Decidable (P.RawConditionC2At A) := by
  unfold RawConditionC2At
  infer_instance

/-- Raw finite C4 is constructively decidable. -/
instance rawConditionC4AtDecidable (P : FiniteComparisonPresentation)
    (A : Finset P.CoarseTarget) : Decidable (P.RawConditionC4At A) := by
  unfold RawConditionC4At
  infer_instance

/-- Raw finite C5 is constructively decidable. -/
instance rawConditionC5Decidable (P : FiniteComparisonPresentation) :
    Decidable P.RawConditionC5 := by
  unfold RawConditionC5
  infer_instance

/-- Raw finite C6 is constructively decidable. -/
instance rawConditionC6Decidable (P : FiniteComparisonPresentation) :
    Decidable P.RawConditionC6 := by
  unfold RawConditionC6
  infer_instance

/-- Executable whole-nerve C0 check. -/
def conditionC0Check (P : FiniteComparisonPresentation) : Bool :=
  decide P.RawConditionC0

/-- Executable C2 check on one selected target subset. -/
def conditionC2AtTargetSubsetCheck (P : FiniteComparisonPresentation)
    (A : Finset P.CoarseTarget) : Bool :=
  decide (P.RawConditionC2At A)

/-- Executable C4 check on one selected target subset. -/
def conditionC4AtTargetSubsetCheck (P : FiniteComparisonPresentation)
    (A : Finset P.CoarseTarget) : Bool :=
  decide (P.RawConditionC4At A)

/-- Executable whole-nerve C5 check. -/
def conditionC5Check (P : FiniteComparisonPresentation) : Bool :=
  decide P.RawConditionC5

/-- Executable whole-nerve C6 check. -/
def conditionC6Check (P : FiniteComparisonPresentation) : Bool :=
  decide P.RawConditionC6

/-- Raw finite C0 is exactly semantic whole-nerve C0 on the generated
comparison geometry. -/
theorem rawConditionC0_iff_conditionC0 (P : FiniteComparisonPresentation) :
    P.RawConditionC0 ↔ P.toGeometry.ConditionC0 := by
  unfold RawConditionC0 TargetSupportedNerveMorphism.ConditionC0
  rw [← P.computedFactor_eq_comparisonFactor]
  rfl

/-- Raw finite C2 is exactly semantic C2 on the actual canonical
A-subnerve. -/
theorem rawConditionC2At_iff_conditionC2AtTargetSubset
    (P : FiniteComparisonPresentation) (A : Finset P.CoarseTarget) :
    P.RawConditionC2At A ↔
      P.toGeometry.ConditionC2AtTargetSubset (A : Set P.CoarseTarget) := by
  constructor
  · intro hraw semanticCoarseEdge
    let coarseEdge := (P.coarseEdgeEquiv A).symm semanticCoarseEdge
    obtain ⟨fineEdge, hmap⟩ := hraw coarseEdge
    refine ⟨P.fineEdgeEquiv A fineEdge, ?_⟩
    apply (P.toGeometry.aSubnerveEdgeMapOption_eq_some_iff
      (A : Set P.CoarseTarget) _ _).2
    simpa [coarseEdge] using hmap
  · intro hsemantic coarseEdge
    obtain ⟨semanticFineEdge, hmap⟩ :=
      hsemantic (P.coarseEdgeEquiv A coarseEdge)
    let fineEdge := (P.fineEdgeEquiv A).symm semanticFineEdge
    refine ⟨fineEdge, ?_⟩
    have hwhole := (P.toGeometry.aSubnerveEdgeMapOption_eq_some_iff
      (A : Set P.CoarseTarget) semanticFineEdge
      (P.coarseEdgeEquiv A coarseEdge)).1 hmap
    simpa [fineEdge] using hwhole

/-- Raw finite C4 is exactly semantic C4 on the actual canonical
A-subnerve. -/
theorem rawConditionC4At_iff_conditionC4AtTargetSubset
    (P : FiniteComparisonPresentation) (A : Finset P.CoarseTarget) :
    P.RawConditionC4At A ↔
      P.toGeometry.ConditionC4AtTargetSubset (A : Set P.CoarseTarget) := by
  constructor
  · intro hraw semanticCoarseFace
    let coarseFace := (P.coarseFaceEquiv A).symm semanticCoarseFace
    obtain ⟨fineFace, hmap⟩ := hraw coarseFace
    refine ⟨P.fineFaceEquiv A fineFace, ?_⟩
    apply (P.toGeometry.aSubnerveFaceMapOption_eq_some_iff
      (A : Set P.CoarseTarget) _ _).2
    simpa [coarseFace] using hmap
  · intro hsemantic coarseFace
    obtain ⟨semanticFineFace, hmap⟩ :=
      hsemantic (P.coarseFaceEquiv A coarseFace)
    let fineFace := (P.fineFaceEquiv A).symm semanticFineFace
    refine ⟨fineFace, ?_⟩
    have hwhole := (P.toGeometry.aSubnerveFaceMapOption_eq_some_iff
      (A : Set P.CoarseTarget) semanticFineFace
      (P.coarseFaceEquiv A coarseFace)).1 hmap
    simpa [fineFace] using hwhole

/-- Raw finite C5 is exactly semantic whole-nerve C5. -/
theorem rawConditionC5_iff_conditionC5 (P : FiniteComparisonPresentation) :
    P.RawConditionC5 ↔ P.toGeometry.ConditionC5 := by
  rfl

/-- Raw finite C6 is exactly semantic whole-nerve C6. -/
theorem rawConditionC6_iff_conditionC6 (P : FiniteComparisonPresentation) :
    P.RawConditionC6 ↔ P.toGeometry.ConditionC6 := by
  rfl

/-- The executable C0 check is sound and complete. -/
