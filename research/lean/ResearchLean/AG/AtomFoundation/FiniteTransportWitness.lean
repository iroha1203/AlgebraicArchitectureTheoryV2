import ResearchLean.AG.AtomFoundation.EquationCorrespondence
import Formal.AG.Examples.FiniteModel

/-!
# Nonidentity finite firing of canonical Atom transport

The exact doctrine morphism below exchanges the source-excluded Atom
`componentC` with `dependsAB`, which occurs in the concrete cycle detector.
The one canonical `transportAlong` construction therefore changes the family,
transports a nonzero equation residual on an inhabited index, and changes the
detector syntax on that same mapped index.
-/

namespace AAT.AG.AtomFoundation

open CategoryTheory

/-- Exchange the excluded Atom with an Atom occurring in the cycle detector. -/
noncomputable def finiteTransportAtomEquiv :
    FiniteModel.carrier.Atom ≃ FiniteModel.carrier.Atom := by
  classical
  exact Equiv.swap FiniteModel.FiniteAtom.componentC
    FiniteModel.FiniteAtom.dependsAB

/-- The finite transport sends the excluded component to the selected dependency. -/
@[simp]
theorem finiteTransportAtomEquiv_componentC :
    finiteTransportAtomEquiv FiniteModel.FiniteAtom.componentC =
      FiniteModel.FiniteAtom.dependsAB := by
  classical
  simp [finiteTransportAtomEquiv]

/-- The finite transport sends the selected dependency to the excluded component. -/
@[simp]
theorem finiteTransportAtomEquiv_dependsAB :
    finiteTransportAtomEquiv FiniteModel.FiniteAtom.dependsAB =
      FiniteModel.FiniteAtom.componentC := by
  classical
  simp [finiteTransportAtomEquiv]

/-- The finite transport fixes the second dependency Atom. -/
@[simp]
theorem finiteTransportAtomEquiv_dependsBC :
    finiteTransportAtomEquiv FiniteModel.FiniteAtom.dependsBC =
      FiniteModel.FiniteAtom.dependsBC := by
  classical
  exact Equiv.swap_apply_of_ne_of_ne
    (by exact FiniteModel.FiniteAtom.noConfusion)
    (by exact FiniteModel.FiniteAtom.noConfusion)

/-- The finite transport fixes the third dependency Atom. -/
@[simp]
theorem finiteTransportAtomEquiv_dependsCA :
    finiteTransportAtomEquiv FiniteModel.FiniteAtom.dependsCA =
      FiniteModel.FiniteAtom.dependsCA := by
  classical
  exact Equiv.swap_apply_of_ne_of_ne
    (by exact FiniteModel.FiniteAtom.noConfusion)
    (by exact FiniteModel.FiniteAtom.noConfusion)

/-- The finite exact transport is genuinely nonidentity on primitive Atoms. -/
theorem finiteTransportAtomEquiv_nonidentity :
    finiteTransportAtomEquiv ≠ Equiv.refl FiniteModel.carrier.Atom := by
  intro h
  have hC := congrArg
    (fun e : FiniteModel.carrier.Atom ≃ FiniteModel.carrier.Atom =>
      e FiniteModel.FiniteAtom.componentC) h
  simp at hC

/-- The target doctrine is the source extraction predicate conjugated by the swap. -/
noncomputable def finiteTransportTargetDoctrine :
    ExtractionDoctrine FiniteModel.carrier where
  Source := FiniteModel.ExtractionSource
  Vocabulary := PUnit
  SemanticReading := PUnit
  Resolution := PUnit
  vocabulary := PUnit.unit
  semanticReading := PUnit.unit
  resolution := PUnit.unit
  vocabularyAllows := fun _ _ => True
  semanticAllows := fun _ source atom =>
    source = FiniteModel.ExtractionSource.all ∨
      finiteTransportAtomEquiv.symm atom ≠
        FiniteModel.FiniteAtom.componentC
  resolutionAllows := fun _ _ _ => True
  sourceSemantics := fun _ _ => True
  normalize := id

/-- Exact doctrine morphism whose target extraction is generated by conjugation. -/
noncomputable def finiteTransportExactDoctrineHom :
    ExactDoctrineHom FiniteModel.extractionDoctrine
      finiteTransportTargetDoctrine where
  sourceMap := id
  atomEquiv := finiteTransportAtomEquiv
  normalize_eq _ := rfl
  extraction_iff := by
    intro source atom
    cases source <;>
      simp [ExtractionDoctrine.extracts, FiniteModel.extractionDoctrine,
        finiteTransportTargetDoctrine]

/-- The exact doctrine morphism has a nonidentity Atom equivalence. -/
theorem finiteTransportExactDoctrineHom_nonidentity :
    finiteTransportExactDoctrineHom.atomEquiv ≠
      Equiv.refl FiniteModel.carrier.Atom :=
  finiteTransportAtomEquiv_nonidentity

/-- Target package generated by the canonical construction, not supplied separately. -/
noncomputable abbrev finiteTransportTargetPackage :
    AATCorePackage FiniteModel.carrier :=
  transportAlong FiniteModel.corePackage finiteTransportExactDoctrineHom

/-- The canonical equation-system transport of the same generated package. -/
noncomputable abbrev finiteTransportEquationTransport :=
  transportAlongEquationSystemExact FiniteModel.corePackage
    finiteTransportExactDoctrineHom

/-- The source family contains the dependency exchanged by finite transport. -/
theorem finiteTransport_source_dependsAB_mem :
    FiniteModel.corePackage.family.mem FiniteModel.FiniteAtom.dependsAB :=
  FiniteModel.corePackage_family_mem _
    (by exact FiniteModel.FiniteAtom.noConfusion)

/-- The source family excludes the component introduced by finite transport. -/
theorem finiteTransport_source_componentC_not_mem :
    ¬ FiniteModel.corePackage.family.mem FiniteModel.FiniteAtom.componentC :=
  FiniteModel.corePackage_componentC_not_mem

/-- The transported family contains a concrete Atom absent from the source. -/
theorem finiteTransport_target_componentC_mem :
    finiteTransportTargetPackage.family.mem
      FiniteModel.FiniteAtom.componentC := by
  rw [transportAlong_family_eq]
  exact ⟨FiniteModel.FiniteAtom.dependsAB,
    finiteTransport_source_dependsAB_mem,
    finiteTransportAtomEquiv_dependsAB⟩

/-- Canonical transport genuinely changes the finite extracted family. -/
theorem finiteTransport_family_ne :
    finiteTransportTargetPackage.family ≠ FiniteModel.corePackage.family := by
  intro hfamily
  apply finiteTransport_source_componentC_not_mem
  rw [← hfamily]
  exact finiteTransport_target_componentC_mem

/-- Concrete inhabited source equation index used throughout the witness. -/
def finiteTransportEquationIndex :
    FiniteModel.corePackage.algebra.equationSystem.Index :=
  PUnit.unit

/-- The canonical equation equivalence maps the concrete index without a new choice. -/
theorem finiteTransportEquationIndex_mapped :
    HEq
      (finiteTransportEquationTransport.equationMap
        finiteTransportEquationIndex)
      PUnit.unit :=
  transportAlongEquationSystemExact_equationMap_heq
    FiniteModel.corePackage finiteTransportExactDoctrineHom
    finiteTransportEquationIndex

/-- The inhabited equation retains its concrete required role. -/
theorem finiteTransport_equationRole_required :
    finiteTransportTargetPackage.algebra.equationSystem.role
        (finiteTransportEquationTransport.equationMap
          finiteTransportEquationIndex) =
      EquationRole.required := by
  rw [transportAlong_equationRole_eq]
  rfl

/-- Concrete readable context at which the finite residual is evaluated. -/
noncomputable def finiteTransportProbeContext :
    Site.ContextCategoryObject FiniteModel.corePackage.contextPreorder :=
  Site.ContextCategoryObject.of FiniteModel.corePackage.contextPreorder
    FiniteModel.equationProbeContext

/-- The source equation residual actually fires on the cyclic finite object. -/
theorem finiteTransport_sourceResidual_nonzero :
    FiniteModel.corePackage.algebra.equationSystem.equationResidual
        finiteTransportProbeContext FiniteModel.corePackage.object
        finiteTransportEquationIndex FiniteModel.FiniteAtom.dependsAB ≠ 0 := by
  have hcycle : FiniteModel.hasDependencyCycle FiniteModel.object := by
    simpa [FiniteModel.hasCycleWitness] using
      FiniteModel.object_hasCycleWitness
  change FiniteModel.noCycleResidual FiniteModel.object ≠ 0
  simp [FiniteModel.noCycleResidual, hcycle]

/-- The nonzero residual is transported along the same canonical equation map. -/
theorem finiteTransport_equationResidual_fires :
    finiteTransportEquationTransport.observableEquiv
        finiteTransportProbeContext
        (FiniteModel.corePackage.algebra.equationSystem.equationResidual
          finiteTransportProbeContext FiniteModel.corePackage.object
          finiteTransportEquationIndex FiniteModel.FiniteAtom.dependsAB) =
      finiteTransportTargetPackage.algebra.equationSystem.equationResidual
        (finiteTransportEquationTransport.contextFunctor.obj
          finiteTransportProbeContext)
        (transportArchitectureObject finiteTransportAtomEquiv
          FiniteModel.corePackage.object)
        (finiteTransportEquationTransport.equationMap
          finiteTransportEquationIndex)
        FiniteModel.FiniteAtom.componentC := by
  simpa only [finiteTransportExactDoctrineHom,
    finiteTransportAtomEquiv_dependsAB] using
    transportAlong_equationResidual_eq
    FiniteModel.corePackage finiteTransportExactDoctrineHom
    finiteTransportProbeContext FiniteModel.corePackage.object
    finiteTransportEquationIndex FiniteModel.FiniteAtom.dependsAB

/-- The target residual remains nonzero after the canonical observable equivalence. -/
theorem finiteTransport_targetResidual_nonzero :
    finiteTransportTargetPackage.algebra.equationSystem.equationResidual
        (finiteTransportEquationTransport.contextFunctor.obj
          finiteTransportProbeContext)
        (transportArchitectureObject finiteTransportAtomEquiv
          FiniteModel.corePackage.object)
        (finiteTransportEquationTransport.equationMap
          finiteTransportEquationIndex)
        FiniteModel.FiniteAtom.componentC ≠ 0 := by
  rw [← finiteTransport_equationResidual_fires]
  intro hzero
  apply finiteTransport_sourceResidual_nonzero
  apply (finiteTransportEquationTransport.observableEquiv
    finiteTransportProbeContext).injective
  simpa using hzero

/-- The concrete detector datum visibly replaces both occurrences of `dependsAB`. -/
@[simp]
theorem finiteTransport_cycleQueryDatum_queries :
    (FiniteModel.cycleQueryDatum.transport finiteTransportAtomEquiv).queries =
      [
        (.relationPresent FiniteModel.FiniteAtom.componentC
          FiniteModel.FiniteAtom.dependsBC, true),
        (.relationPresent FiniteModel.FiniteAtom.dependsBC
          FiniteModel.FiniteAtom.dependsCA, true),
        (.relationPresent FiniteModel.FiniteAtom.dependsCA
          FiniteModel.FiniteAtom.componentC, true)
      ] := by
  simp [FiniteModel.cycleQueryDatum, FiniteCircuitDatum.transport,
    CircuitQuery.transport]

/-- Transport changes the concrete cycle detector datum. -/
theorem finiteTransport_cycleQueryDatum_ne :
    FiniteModel.cycleQueryDatum.transport finiteTransportAtomEquiv ≠
      FiniteModel.cycleQueryDatum := by
  intro h
  have hqueries := congrArg FiniteCircuitDatum.queries h
  simp [FiniteModel.cycleQueryDatum, FiniteCircuitDatum.transport,
    CircuitQuery.transport] at hqueries

/-- Source detector code at the inhabited index is the concrete cycle template. -/
theorem finiteTransport_sourceDetector_eq :
    FiniteModel.corePackage.algebra.circuits.code
        finiteTransportEquationIndex =
      .exact FiniteModel.cycleQueryDatum := by
  simpa [finiteTransportEquationIndex] using
    FiniteModel.coreReading_circuit_code PUnit.unit

/-- Target detector code transports the concrete template on the mapped index. -/
theorem finiteTransport_targetDetector_eq :
    finiteTransportTargetPackage.algebra.circuits.code
        (finiteTransportEquationTransport.equationMap
          finiteTransportEquationIndex) =
      .exact (FiniteModel.cycleQueryDatum.transport
        finiteTransportAtomEquiv) := by
  calc
    _ = (FiniteModel.corePackage.algebra.circuits.code
          finiteTransportEquationIndex).transport finiteTransportAtomEquiv :=
      transportAlongEquationSystemExact_detectorCode_eq
        FiniteModel.corePackage finiteTransportExactDoctrineHom
        finiteTransportEquationIndex
    _ = _ := by
      rw [finiteTransport_sourceDetector_eq]
      rfl

/-- Detector syntax differs from the source on that same concrete equation index. -/
theorem finiteTransport_targetDetector_ne_source :
    finiteTransportTargetPackage.algebra.circuits.code
        (finiteTransportEquationTransport.equationMap
          finiteTransportEquationIndex) ≠
      FiniteModel.corePackage.algebra.circuits.code
        finiteTransportEquationIndex := by
  rw [finiteTransport_targetDetector_eq, finiteTransport_sourceDetector_eq]
  intro h
  injection h with hdatum
  exact finiteTransport_cycleQueryDatum_ne hdatum

end AAT.AG.AtomFoundation

#assert_standard_axioms_only AAT.AG.AtomFoundation
