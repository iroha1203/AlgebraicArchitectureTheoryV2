import ResearchLean.AG.DiagnosticConservativity.EndpointExactness
import ResearchLean.AG.DoctrineFiberProduct.IndexedDiagnosticReselection

/-!
# G-113 revision 2 diagnostic reselection exactness

The endpoint equivalence acts independently at every indexed edge coordinate.
Its dependent product is therefore an explicit equivalence between source and
transported reselections.  The forward function is exactly the reviewed G-111
`transportedReselection`; the inverse and both round trips come from the same
equivalence.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open AtomFoundation
open CrossStageCoherence
open TransportCoherence

namespace IndexedBaseDiagramHom

/-- The pointwise endpoint equivalences assemble to a reselection equivalence. -/
noncomputable def indexedDiagnosticReselectionEquivalence
    {G : IndexedBaseTwoShape.{u}} {U : AtomCarrier.{u}}
    {D E : IndexedBaseDiagram G U} (hom : IndexedBaseDiagramHom D E)
    (source : IndexedDiagnosticInterpretation D) :
    IndexedEdgeReselection source ≃*
      IndexedEdgeReselection (hom.transportedInterpretation source) :=
  MulEquiv.piCongrRight fun _i =>
    MulEquiv.piCongrRight fun j =>
      MulEquiv.piCongrRight fun _edge =>
        indexedDiagnosticEndpointEquivalence hom source j

/-- The reselection-equivalence forward map is the revision-1 transport. -/
theorem indexedDiagnosticReselectionEquivalence_apply
    {G : IndexedBaseTwoShape.{u}} {U : AtomCarrier.{u}}
    {D E : IndexedBaseDiagram G U} (hom : IndexedBaseDiagramHom D E)
    (source : IndexedDiagnosticInterpretation D)
    (reselection : IndexedEdgeReselection source) :
    indexedDiagnosticReselectionEquivalence hom source reselection =
      hom.transportedReselection source reselection := by
  rfl

/-- Inverse reselection transport generated by the endpoint equivalences. -/
noncomputable def inverseTransportedReselection
    {G : IndexedBaseTwoShape.{u}} {U : AtomCarrier.{u}}
    {D E : IndexedBaseDiagram G U} (hom : IndexedBaseDiagramHom D E)
    (source : IndexedDiagnosticInterpretation D)
    (targetReselection : IndexedEdgeReselection
      (hom.transportedInterpretation source)) :
    IndexedEdgeReselection source :=
  (indexedDiagnosticReselectionEquivalence hom source).symm targetReselection

/-- Inverse transport acts pointwise by the inverse endpoint equivalence. -/
theorem inverseTransportedReselection_apply
    {G : IndexedBaseTwoShape.{u}} {U : AtomCarrier.{u}}
    {D E : IndexedBaseDiagram G U} (hom : IndexedBaseDiagramHom D E)
    (source : IndexedDiagnosticInterpretation D)
    (targetReselection : IndexedEdgeReselection
      (hom.transportedInterpretation source))
    (i j : G.Vertex) (edge : G.Edge i j) :
    hom.inverseTransportedReselection source targetReselection i j edge =
      (indexedDiagnosticEndpointEquivalence hom source j).symm
        (targetReselection i j edge) := by
  rfl

/-- Forward transport followed by inverse transport recovers the source reselection. -/
theorem inverseTransportedReselection_transportedReselection
    {G : IndexedBaseTwoShape.{u}} {U : AtomCarrier.{u}}
    {D E : IndexedBaseDiagram G U} (hom : IndexedBaseDiagramHom D E)
    (source : IndexedDiagnosticInterpretation D)
    (reselection : IndexedEdgeReselection source) :
    hom.inverseTransportedReselection source
        (hom.transportedReselection source reselection) = reselection := by
  rw [← indexedDiagnosticReselectionEquivalence_apply]
  exact (indexedDiagnosticReselectionEquivalence hom source).symm_apply_apply
    reselection

/-- Inverse transport followed by forward transport recovers the target reselection. -/
theorem transportedReselection_inverseTransportedReselection
    {G : IndexedBaseTwoShape.{u}} {U : AtomCarrier.{u}}
    {D E : IndexedBaseDiagram G U} (hom : IndexedBaseDiagramHom D E)
    (source : IndexedDiagnosticInterpretation D)
    (targetReselection : IndexedEdgeReselection
      (hom.transportedInterpretation source)) :
    hom.transportedReselection source
        (hom.inverseTransportedReselection source targetReselection) =
      targetReselection := by
  rw [← indexedDiagnosticReselectionEquivalence_apply]
  exact (indexedDiagnosticReselectionEquivalence hom source).apply_symm_apply
    targetReselection

/-- The explicit reselection equivalence preserves the base reselection. -/
@[simp]
theorem indexedDiagnosticReselectionEquivalence_one
    {G : IndexedBaseTwoShape.{u}} {U : AtomCarrier.{u}}
    {D E : IndexedBaseDiagram G U} (hom : IndexedBaseDiagramHom D E)
    (source : IndexedDiagnosticInterpretation D) :
    indexedDiagnosticReselectionEquivalence hom source
        (1 : IndexedEdgeReselection source) = 1 :=
  map_one (indexedDiagnosticReselectionEquivalence hom source)

/-- Inverse transport also preserves the base reselection. -/
@[simp]
theorem inverseTransportedReselection_one
    {G : IndexedBaseTwoShape.{u}} {U : AtomCarrier.{u}}
    {D E : IndexedBaseDiagram G U} (hom : IndexedBaseDiagramHom D E)
    (source : IndexedDiagnosticInterpretation D) :
    hom.inverseTransportedReselection source
        (1 : IndexedEdgeReselection (hom.transportedInterpretation source)) = 1 :=
  map_one (indexedDiagnosticReselectionEquivalence hom source).symm

end IndexedBaseDiagramHom

end AAT.AG.DoctrineFiberProduct

#assert_standard_axioms_only AAT.AG.DoctrineFiberProduct
