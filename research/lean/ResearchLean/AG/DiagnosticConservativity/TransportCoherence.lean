import ResearchLean.AG.DiagnosticConservativity.TransportEquivalence
import ResearchLean.AG.DoctrineFiberProduct.ExactBottomGlobalLiftCoherence
import Mathlib.CategoryTheory.Adjunction.Mates

/-!
# G-113 revision 2 transport coherence

The G-113 equivalence is generated by the same cocartesian/cartesian
transposition that supplies the G-111 covariant action and the G-112
contravariant action.  Consequently the canonical covariant unitor and
compositor have exactly the G-112 semantic-global unitor and compositor as
their conjugate mates.  This module records that compatibility for arbitrary
semantic arrows and then at every vertex of an indexed diagram.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open CategoryTheory
open AtomFoundation
open CrossStageCoherence

set_option maxHeartbeats 3000000

/-- The G-112 identity unitor is the conjugate mate of the G-111 canonical
transport unitor under the generated G-113 identity equivalence. -/
theorem semanticGlobalTransportEquivalence_unitor_conjugate
    {U : AtomCarrier.{u}} (object : ExtractionInstance U) :
    conjugateIsoEquiv
        (Adjunction.id (C := CoreFiber object))
        (semanticGlobalTransportReindexAdjunction (𝟙 object))
        (coreFiberUnitor object) =
      exact_bottom_semantic_global_unitor object := by
  ext targetPackage
  let selectedLift := exact_bottom_semantic_global_selected_lift
    (𝟙 object) targetPackage
  letI : (packageProjection U).IsStronglyCartesian (𝟙 object)
      selectedLift.hom := selectedLift.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U) (𝟙 object) selectedLift.hom (𝟙 object)
  change ((conjugateIsoEquiv
      (Adjunction.id (C := CoreFiber object))
      (semanticGlobalTransportReindexAdjunction (𝟙 object))
      (coreFiberUnitor object)).hom.app targetPackage).1 ≫ selectedLift.hom =
    ((exact_bottom_semantic_global_unitor object).hom.app targetPackage).1 ≫
      selectedLift.hom
  change _ =
    (exact_bottom_semantic_global_unitor_app object targetPackage).hom.1 ≫
      selectedLift.hom
  rw [exact_bottom_semantic_global_unitor_app_hom_fac]
  simp [conjugateIsoEquiv, conjugateEquiv, mateEquiv,
    semanticGlobalTransportReindexAdjunction,
    semanticGlobalTransportReindexCoreHomEquiv,
    semanticGlobalTransportReindexHomEquiv]
  change
    ((semanticGlobalTransportReindexUnit (𝟙 object)).app targetPackage).1 ≫
        ((exact_bottom_semantic_global_reindex_functor (𝟙 object)).map
          ((coreFiberUnitor object).hom.app targetPackage)).1 ≫
        selectedLift.hom = 𝟙 targetPackage.1
  dsimp only [selectedLift]
  have hmap := by
    simpa only [Functor.id_obj] using
      exact_bottom_semantic_global_reindex_map_fac
        (𝟙 object) ((coreFiberUnitor object).hom.app targetPackage)
  rw [hmap]
  rw [← Category.assoc,
    semanticGlobalTransportReindexUnit_app_fac]
  exact coreFiberUnitorApp_hom_fac object targetPackage

/-- The G-112 vertical compositor is the conjugate mate of the G-111
canonical transport compositor under the composite and direct generated
G-113 equivalences. -/
theorem semanticGlobalTransportEquivalence_compositor_conjugate
    {U : AtomCarrier.{u}}
    {source middle target : ExtractionInstance U}
    (first : source ⟶ middle) (second : middle ⟶ target) :
    conjugateIsoEquiv
        ((semanticGlobalTransportReindexAdjunction first).comp
          (semanticGlobalTransportReindexAdjunction second))
        (semanticGlobalTransportReindexAdjunction (first ≫ second))
        (coreFiberCompositor first second) =
      exact_bottom_semantic_global_compositor first second := by
  ext targetPackage
  let selectedLift := exact_bottom_semantic_global_selected_lift
    (first ≫ second) targetPackage
  letI : (packageProjection U).IsStronglyCartesian (first ≫ second)
      selectedLift.hom := selectedLift.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U) (first ≫ second) selectedLift.hom (𝟙 source)
  change ((conjugateIsoEquiv
      ((semanticGlobalTransportReindexAdjunction first).comp
        (semanticGlobalTransportReindexAdjunction second))
      (semanticGlobalTransportReindexAdjunction (first ≫ second))
      (coreFiberCompositor first second)).hom.app targetPackage).1 ≫
        selectedLift.hom =
    ((exact_bottom_semantic_global_compositor first second).hom.app
      targetPackage).1 ≫ selectedLift.hom
  change _ =
    (exact_bottom_semantic_global_compositor_app first second
      targetPackage).hom.1 ≫ selectedLift.hom
  rw [exact_bottom_semantic_global_compositor_app_hom_fac]
  simp [conjugateIsoEquiv, conjugateEquiv, mateEquiv,
    semanticGlobalTransportReindexAdjunction,
    semanticGlobalTransportReindexCoreHomEquiv,
    semanticGlobalTransportReindexHomEquiv]
  rw [← Functor.map_comp, ← Functor.map_comp]
  let iteratedPackage :=
    (exact_bottom_semantic_global_reindex_functor first).obj
      ((exact_bottom_semantic_global_reindex_functor second).obj targetPackage)
  let firstCounit := (semanticGlobalTransportReindexCounit first).app
    ((exact_bottom_semantic_global_reindex_functor second).obj targetPackage)
  let secondCounit :=
    (semanticGlobalTransportReindexCounit second).app targetPackage
  let vertical :
      (coreFiberTransportFunctor (first ≫ second)).obj iteratedPackage ⟶
        targetPackage :=
    (coreFiberCompositor first second).hom.app iteratedPackage ≫
      (coreFiberTransportFunctor second).map firstCounit ≫ secondCounit
  change
    ((semanticGlobalTransportReindexUnit (first ≫ second)).app
        iteratedPackage).1 ≫
      ((exact_bottom_semantic_global_reindex_functor
        (first ≫ second)).map vertical).1 ≫ selectedLift.hom =
    (exact_bottom_semantic_global_iterated_lift first second
      targetPackage).hom
  dsimp only [selectedLift]
  have hmap := exact_bottom_semantic_global_reindex_map_fac
    (first ≫ second) vertical
  rw [hmap]
  rw [← Category.assoc,
    semanticGlobalTransportReindexUnit_app_fac]
  dsimp only [vertical]
  change
    coreFiberLift (first ≫ second) iteratedPackage ≫
        ((coreFiberCompositor first second).hom.app iteratedPackage).1 ≫
        ((coreFiberTransportFunctor second).map firstCounit).1 ≫
        secondCounit.1 =
      (exact_bottom_semantic_global_iterated_lift first second
        targetPackage).hom
  have hcomp :
      coreFiberLift (first ≫ second) iteratedPackage ≫
          ((coreFiberCompositor first second).hom.app iteratedPackage).1 =
        coreFiberIteratedLift first second iteratedPackage := by
    simpa only [coreFiberCompositor] using
      coreFiberCompositorApp_hom_fac first second iteratedPackage
  rw [← Category.assoc, hcomp]
  dsimp only [coreFiberIteratedLift]
  rw [Category.assoc]
  have htransport :
      coreFiberLift second
          ((coreFiberTransportFunctor first).obj iteratedPackage) ≫
        ((coreFiberTransportFunctor second).map firstCounit).1 =
      firstCounit.1 ≫
        coreFiberLift second
          ((exact_bottom_semantic_global_reindex_functor second).obj
            targetPackage) := by
    simpa only [coreFiberTransportFunctor] using
      coreFiberTransportMap_fac second firstCounit
  rw [← Category.assoc
    (coreFiberLift second
      ((coreFiberTransportFunctor first).obj iteratedPackage))
    ((coreFiberTransportFunctor second).map firstCounit).1
    secondCounit.1]
  rw [htransport]
  rw [Category.assoc firstCounit.1
    (coreFiberLift second
      ((exact_bottom_semantic_global_reindex_functor second).obj
        targetPackage)) secondCounit.1]
  rw [← Category.assoc (coreFiberLift first iteratedPackage) firstCounit.1]
  dsimp only [firstCounit]
  rw [semanticGlobalTransportReindexCounit_app_fac]
  dsimp only [secondCounit]
  rw [semanticGlobalTransportReindexCounit_app_fac]
  rfl

/-! ## Indexed identity and vertical composition -/

/-- At every indexed vertex, the identity equivalence carries the canonical
covariant unitor to the semantic-global contravariant unitor. -/
theorem indexedDiagnosticTransportEquivalence_id_conjugate
    {G : IndexedBaseTwoShape.{u}} {U : AtomCarrier.{u}}
    (D : IndexedBaseDiagram G U) (vertex : G.Vertex) :
    conjugateIsoEquiv
        (Adjunction.id (C := CoreFiber (D.vertex vertex)))
        (indexedDiagnosticTransportAdjunction
          (IndexedBaseDiagramHom.id D) vertex)
        (coreFiberUnitor (D.vertex vertex)) =
      exact_bottom_semantic_global_unitor (D.vertex vertex) := by
  simpa only [indexedDiagnosticTransportAdjunction,
    IndexedBaseDiagramHom.id_app] using
    semanticGlobalTransportEquivalence_unitor_conjugate (D.vertex vertex)

/-- At every indexed vertex, vertical composition of G-113 equivalences has
the G-112 compositor as the conjugate mate of the G-111 compositor. -/
theorem indexedDiagnosticTransportEquivalence_comp_conjugate
    {G : IndexedBaseTwoShape.{u}} {U : AtomCarrier.{u}}
    {D E F : IndexedBaseDiagram G U}
    (first : IndexedBaseDiagramHom D E)
    (second : IndexedBaseDiagramHom E F) (vertex : G.Vertex) :
    conjugateIsoEquiv
        ((indexedDiagnosticTransportAdjunction first vertex).comp
          (indexedDiagnosticTransportAdjunction second vertex))
        (indexedDiagnosticTransportAdjunction (first.comp second) vertex)
        (coreFiberCompositor (first.app vertex) (second.app vertex)) =
      exact_bottom_semantic_global_compositor
        (first.app vertex) (second.app vertex) := by
  simpa only [indexedDiagnosticTransportAdjunction,
    IndexedBaseDiagramHom.comp_app] using
    semanticGlobalTransportEquivalence_compositor_conjugate
      (first.app vertex) (second.app vertex)

/-! ## Triangle and pentagon routes -/

/-- Both unit triangles are the G-112 routes selected by conjugating the
G-111 unitors through the generated G-113 equivalences. -/
theorem semanticGlobalTransportEquivalence_triangle_compatibility
    {U : AtomCarrier.{u}} {source target : ExtractionInstance U}
    (hom : source ⟶ target) (targetPackage : CoreFiber target) :
    conjugateIsoEquiv
        (Adjunction.id (C := CoreFiber source))
        (semanticGlobalTransportReindexAdjunction (𝟙 source))
        (coreFiberUnitor source) =
          exact_bottom_semantic_global_unitor source ∧
      conjugateIsoEquiv
        (Adjunction.id (C := CoreFiber target))
        (semanticGlobalTransportReindexAdjunction (𝟙 target))
        (coreFiberUnitor target) =
          exact_bottom_semantic_global_unitor target ∧
      exact_bottom_semantic_global_left_unit_route hom targetPackage =
          exact_bottom_semantic_global_left_unit_cast hom targetPackage ∧
      exact_bottom_semantic_global_right_unit_route hom targetPackage =
          exact_bottom_semantic_global_right_unit_cast hom targetPackage :=
  ⟨semanticGlobalTransportEquivalence_unitor_conjugate source,
    semanticGlobalTransportEquivalence_unitor_conjugate target,
    exact_bottom_semantic_global_left_unit_triangle hom targetPackage,
    exact_bottom_semantic_global_right_unit_triangle hom targetPackage⟩

/-- Every compositor in the two three-arrow routes is the conjugate mate of
its G-111 compositor, and the resulting G-112 routes satisfy the pentagon. -/
theorem semanticGlobalTransportEquivalence_pentagon_compatibility
    {U : AtomCarrier.{u}}
    {firstObject secondObject thirdObject fourthObject : ExtractionInstance U}
    (first : firstObject ⟶ secondObject)
    (second : secondObject ⟶ thirdObject)
    (third : thirdObject ⟶ fourthObject)
    (targetPackage : CoreFiber fourthObject) :
    conjugateIsoEquiv
        ((semanticGlobalTransportReindexAdjunction first).comp
          (semanticGlobalTransportReindexAdjunction second))
        (semanticGlobalTransportReindexAdjunction (first ≫ second))
        (coreFiberCompositor first second) =
          exact_bottom_semantic_global_compositor first second ∧
      conjugateIsoEquiv
        ((semanticGlobalTransportReindexAdjunction (first ≫ second)).comp
          (semanticGlobalTransportReindexAdjunction third))
        (semanticGlobalTransportReindexAdjunction
          ((first ≫ second) ≫ third))
        (coreFiberCompositor (first ≫ second) third) =
          exact_bottom_semantic_global_compositor (first ≫ second) third ∧
      conjugateIsoEquiv
        ((semanticGlobalTransportReindexAdjunction second).comp
          (semanticGlobalTransportReindexAdjunction third))
        (semanticGlobalTransportReindexAdjunction (second ≫ third))
        (coreFiberCompositor second third) =
          exact_bottom_semantic_global_compositor second third ∧
      conjugateIsoEquiv
        ((semanticGlobalTransportReindexAdjunction first).comp
          (semanticGlobalTransportReindexAdjunction (second ≫ third)))
        (semanticGlobalTransportReindexAdjunction
          (first ≫ (second ≫ third)))
        (coreFiberCompositor first (second ≫ third)) =
          exact_bottom_semantic_global_compositor first (second ≫ third) ∧
      exact_bottom_semantic_global_pentagon_left_route first second third
          targetPackage =
        exact_bottom_semantic_global_pentagon_right_route first second third
          targetPackage :=
  ⟨semanticGlobalTransportEquivalence_compositor_conjugate first second,
    semanticGlobalTransportEquivalence_compositor_conjugate
      (first ≫ second) third,
    semanticGlobalTransportEquivalence_compositor_conjugate second third,
    semanticGlobalTransportEquivalence_compositor_conjugate
      first (second ≫ third),
    exact_bottom_semantic_global_pentagon first second third targetPackage⟩

end AAT.AG.DoctrineFiberProduct

#assert_standard_axioms_only AAT.AG.DoctrineFiberProduct
