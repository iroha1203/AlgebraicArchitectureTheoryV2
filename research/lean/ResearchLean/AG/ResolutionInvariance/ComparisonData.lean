import ResearchLean.AG.CanonicalResolution.Reading
import Formal.Util.AssertStandardAxioms

/-!
# Canonical comparison and law descent for resolution invariance

This module discharges the first comparison-data obligation of
`G-104-aat-resolution-invariance`.  A comparison factor is generated from the
coarse-reading order, and every law descent is generated from adequacy.  Their
commutation is therefore a theorem about the input readings and evaluations,
not an additional field of selected comparison data.
-/

noncomputable section

namespace AAT.AG.ResolutionInvariance

open CanonicalResolution

universe u

variable {Source : Type u}

/--
The canonical factor from the fine target to the coarse target, generated by
the coarse-reading relation.
-/
def comparisonFactor (coarse fine : Reading Source)
    (hcoarser : coarse.CoarserThan fine) :
    fine.Target → coarse.Target :=
  Classical.choose
    ((coarse.factorsThrough_iff_coarserThan fine).2 hcoarser)

/-- The generated comparison factor commutes with the two source readings. -/
theorem comparisonFactor_commutes (coarse fine : Reading Source)
    (hcoarser : coarse.CoarserThan fine) (source : Source) :
    comparisonFactor coarse fine hcoarser (fine.read source) =
      coarse.read source :=
  Classical.choose_spec
    ((coarse.factorsThrough_iff_coarserThan fine).2 hcoarser) source

/-- Every commuting factor between the reading targets is the generated one. -/
theorem comparisonFactor_unique (coarse fine : Reading Source)
    (hcoarser : coarse.CoarserThan fine)
    (factor : fine.Target → coarse.Target)
    (hfactor : ∀ source,
      factor (fine.read source) = coarse.read source) :
    factor = comparisonFactor coarse fine hcoarser := by
  funext target
  obtain ⟨source, rfl⟩ := fine.surjective target
  exact (hfactor source).trans
    (comparisonFactor_commutes coarse fine hcoarser source).symm

/-- The generated comparison factor is surjective. -/
theorem comparisonFactor_surjective (coarse fine : Reading Source)
    (hcoarser : coarse.CoarserThan fine) :
    Function.Surjective (comparisonFactor coarse fine hcoarser) := by
  intro target
  obtain ⟨source, hsource⟩ := coarse.surjective target
  refine ⟨fine.read source, ?_⟩
  exact (comparisonFactor_commutes coarse fine hcoarser source).trans hsource

/--
The canonical descent of one declared law evaluation through an adequate
reading.
-/
def lawDescend (laws : FiniteLawFamily Source) (q : Reading Source)
    (hadequate : laws.Adequate q) (law : laws.Law) :
    q.Target → laws.Value law :=
  Classical.choose (hadequate law)

/-- The generated law descent recovers the original evaluation on every source. -/
theorem lawDescend_commutes (laws : FiniteLawFamily Source)
    (q : Reading Source) (hadequate : laws.Adequate q)
    (law : laws.Law) (source : Source) :
    lawDescend laws q hadequate law (q.read source) =
      laws.eval law source :=
  Classical.choose_spec (hadequate law) source

/-- A descent with the required source-level values is uniquely determined. -/
theorem lawDescend_unique (laws : FiniteLawFamily Source)
    (q : Reading Source) (hadequate : laws.Adequate q)
    (law : laws.Law) (descend : q.Target → laws.Value law)
    (hdescend : ∀ source,
      descend (q.read source) = laws.eval law source) :
    descend = lawDescend laws q hadequate law := by
  funext target
  obtain ⟨source, rfl⟩ := q.surjective target
  exact (hdescend source).trans
    (lawDescend_commutes laws q hadequate law source).symm

/--
Coarse and fine law descents commute pointwise with the canonical comparison
factor.
-/
theorem lawDescend_comparisonFactor (laws : FiniteLawFamily Source)
    (coarse fine : Reading Source)
    (hcoarse : laws.Adequate coarse) (hfine : laws.Adequate fine)
    (hcoarser : coarse.CoarserThan fine) (law : laws.Law)
    (target : fine.Target) :
    lawDescend laws coarse hcoarse law
        (comparisonFactor coarse fine hcoarser target) =
      lawDescend laws fine hfine law target := by
  obtain ⟨source, rfl⟩ := fine.surjective target
  rw [comparisonFactor_commutes, lawDescend_commutes, lawDescend_commutes]

/-- Function-level form of law descent compatibility with the comparison factor. -/
theorem lawDescend_comp_comparisonFactor (laws : FiniteLawFamily Source)
    (coarse fine : Reading Source)
    (hcoarse : laws.Adequate coarse) (hfine : laws.Adequate fine)
    (hcoarser : coarse.CoarserThan fine) (law : laws.Law) :
    lawDescend laws coarse hcoarse law ∘
        comparisonFactor coarse fine hcoarser =
      lawDescend laws fine hfine law := by
  funext target
  exact lawDescend_comparisonFactor laws coarse fine hcoarse hfine
    hcoarser law target

end AAT.AG.ResolutionInvariance

#assert_standard_axioms_only AAT.AG.ResolutionInvariance
