import ResearchLean.AG.ResolutionInvariance.LawGeneratedComplex
import ResearchLean.AG.TwoPhase.CohomologyComparison
import Formal.Util.AssertStandardAxioms

/-!
# Canonical diagnostics for inadequate readings

For an arbitrary reading, the laws that can be evaluated on its target are
exactly the original laws whose evaluations satisfy G-103 `Reading.Factors`.
This module uses that predicate itself as the index of a finite subfamily, so
there is no selected list of laws or extra factorization certificate.

The subtype property makes the resulting family adequate for the reading.
The existing K0/K1 construction can therefore build its actual coefficient
complex, and the G-102 quotient of that complex is the diagnostic `H¹` used
for an inadequate reading in G-104 claim (iv).
-/

noncomputable section

namespace AAT.AG.CanonicalResolution

universe u

variable {Source : Type u}

namespace FiniteLawFamily

/-- A law retained by a reading exactly when its evaluation factors through
that reading. -/
abbrev DescendableLaw (laws : FiniteLawFamily Source) (q : Reading Source) :=
  {law : laws.Law // q.Factors (laws.eval law)}

/-- The canonical inclusion criterion for a law in the descendable subtype is
exactly the G-103 `Factors` predicate. -/
theorem exists_descendableLaw_iff_factors (laws : FiniteLawFamily Source)
    (q : Reading Source) (law : laws.Law) :
    (∃ retained : laws.DescendableLaw q, retained.1 = law) ↔
      q.Factors (laws.eval law) := by
  constructor
  · rintro ⟨retained, rfl⟩
    exact retained.2
  · intro hfactors
    exact ⟨⟨law, hfactors⟩, rfl⟩

/-- The finite law family obtained by retaining precisely the laws that factor
through the reading. -/
def descendableSubfamily (laws : FiniteLawFamily Source) (q : Reading Source) :
    FiniteLawFamily Source where
  Law := laws.DescendableLaw q
  lawFintype := Fintype.ofFinite _
  Value := fun law => laws.Value law.1
  valueDecidableEq := fun law => laws.valueDecidableEq law.1
  eval := fun law => laws.eval law.1

/-- A retained law is evaluated by the unchanged evaluation from the original
law family. -/
@[simp]
theorem descendableSubfamily_eval (laws : FiniteLawFamily Source)
    (q : Reading Source) (law : (laws.descendableSubfamily q).Law) :
    (laws.descendableSubfamily q).eval law = laws.eval law.1 :=
  rfl

/-- The canonical descendable subfamily is adequate for the reading by the
factorization property carried by each retained law. -/
theorem descendableSubfamily_adequate (laws : FiniteLawFamily Source)
    (q : Reading Source) : (laws.descendableSubfamily q).Adequate q := by
  intro law
  exact law.2

end FiniteLawFamily

end AAT.AG.CanonicalResolution

namespace AAT.AG.ResolutionInvariance

open CanonicalResolution Cohomology TwoPhase

universe u

variable {Source : Type u}
variable {q : Reading Source}

namespace TargetSupportedNerve

/-- The existing K0/K1 coefficient complex generated by exactly the laws that
factor through the reading. -/
def factorsDiagnosticComplex [Fintype Source] (D : TargetSupportedNerve q)
    (laws : FiniteLawFamily Source) : ThreeCochainComplex ℚ :=
  D.lawGeneratedComplex (laws.descendableSubfamily q)
    (laws.descendableSubfamily_adequate q)

/-- The actual G-102 `H¹` diagnostic of the canonical Factors-selected law
subfamily. -/
abbrev FactorsDiagnosticH1 [Fintype Source] (D : TargetSupportedNerve q)
    (laws : FiniteLawFamily Source) :=
  (D.factorsDiagnosticComplex laws).H1

end TargetSupportedNerve

end AAT.AG.ResolutionInvariance

#assert_standard_axioms_only AAT.AG.CanonicalResolution.FiniteLawFamily
#assert_standard_axioms_only AAT.AG.ResolutionInvariance.TargetSupportedNerve
