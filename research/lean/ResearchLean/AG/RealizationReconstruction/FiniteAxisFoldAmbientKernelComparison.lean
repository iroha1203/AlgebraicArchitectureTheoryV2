import ResearchLean.AG.RealizationReconstruction.FiniteAxisFoldAmbientKernelPresentation
import ResearchLean.AG.FullGeometryNormalization.AmbientKernelComparisonWitness
import Formal.Util.AssertStandardAxioms

/-!
# The displayed fixed ambient kernel does not preserve barAlpha

Cycle 56 constructed the source endpoint ambient-kernel involution from a
two-tag finite recipe.  This file connects that exact constructed value to
G-122's original complete-geometry comparison groups for the mandated finite
axis-fold input.  Pairing the displayed source involution with the target
identity is erased by normalization and therefore preserves the normalized
five-factor comparison, but it does not preserve the original `barAlpha`.

This is the required distinction between the ambient normalization kernel and
the kernel internal to comparison-preserving changes.  The argument reuses the
accepted general G-122 theorem only after proving that its witness is exactly
the value generated by the Cycle 56 recipe.  It does not claim that the two
element recipe enumerates either comparison group or any lift fiber.

## Implementation notes

The displayed pair has no data fields and accepts no automorphism or group
element.  Its source component is `FiniteAxisFoldAmbientKernelCode.direct`
evaluated in the admissible-geometry category; its target component is the
categorical identity.  All endpoint types, the actual five-factor comparison,
and endpoint admissibility proofs are instantiated from the fixed original
input.
-/

namespace AAT.AG.RealizationReconstruction

open CategoryTheory AtomFoundation DoctrineFiberProduct GeometryTransport
open TransportCoherence
open FullGeometryNormalization

local instance finiteAxisFoldAmbientComparisonAtomDecidableEq :
    DecidableEq FiniteModel.carrier.Atom := by
  change DecidableEq FiniteModel.FiniteAtom
  infer_instance

/-- The fixed direct endpoint used by the original G-122 comparison group is
definitionally the admissible endpoint selected by the direct recipe. -/
theorem finiteAxisFoldDirectAdmissibleEndpoint_eq :
    FiniteAxisFoldAmbientKernelCode.direct.admissibleEndpoint =
      authoredExactDirectAdmissibleGeometryAt
        finiteAxisFoldBCDatumSquare
        (Discrete.mk DoubleDiamondTwoCell.second)
        Int
        (finiteAxisFoldFixedCoefficientGeometryFamily
          (Discrete.mk DoubleDiamondTwoCell.second))
        finiteCanonicalObjectNormalization_admissible :=
  rfl

/-- The fixed via-base endpoint used by the original G-122 comparison group
is the endpoint selected by the via-base recipe. -/
theorem finiteAxisFoldViaBaseAdmissibleEndpoint_eq :
    FiniteAxisFoldAmbientKernelCode.viaBase.admissibleEndpoint =
      authoredExactViaBaseAdmissibleGeometryAt
        finiteAxisFoldBCDatumSquare
        (Discrete.mk DoubleDiamondTwoCell.second)
        Int
        (finiteAxisFoldFixedCoefficientGeometryFamily
          (Discrete.mk DoubleDiamondTwoCell.second))
        finiteCanonicalObjectNormalization_admissible :=
  rfl

/-- The endpoint pair obtained from the finite source recipe: the displayed
ambient involution at the direct endpoint and identity at the via-base
endpoint. -/
noncomputable def finiteAxisFoldDisplayedAmbientKernelComparisonPair :
    Aut (authoredExactDirectAdmissibleGeometryAt
      finiteAxisFoldBCDatumSquare
      (Discrete.mk DoubleDiamondTwoCell.second)
      Int
      (finiteAxisFoldFixedCoefficientGeometryFamily
        (Discrete.mk DoubleDiamondTwoCell.second))
      finiteCanonicalObjectNormalization_admissible) ×
    Aut (authoredExactViaBaseAdmissibleGeometryAt
      finiteAxisFoldBCDatumSquare
      (Discrete.mk DoubleDiamondTwoCell.second)
      Int
      (finiteAxisFoldFixedCoefficientGeometryFamily
        (Discrete.mk DoubleDiamondTwoCell.second))
      finiteCanonicalObjectNormalization_admissible) :=
  (FiniteAxisFoldAmbientKernelCode.direct.admissibleEvaluateAut, 1)

/-- The displayed recipe evaluates to exactly G-122's accepted ambient-kernel
comparison witness, rather than a new simplified replacement. -/
theorem finiteAxisFoldDisplayedAmbientKernelComparisonPair_eq_authored :
    finiteAxisFoldDisplayedAmbientKernelComparisonPair =
      authoredExactAmbientKernelComparisonPair
        finiteAxisFoldBCDatumSquare
        (Discrete.mk DoubleDiamondTwoCell.second)
        Int
        (finiteAxisFoldFixedCoefficientGeometryFamily
          (Discrete.mk DoubleDiamondTwoCell.second))
        finiteCanonicalObjectNormalization_admissible :=
  rfl

/-- The source component is visibly the nontrivial automorphism evaluated
from the direct endpoint recipe. -/
@[simp] theorem finiteAxisFoldDisplayedAmbientKernelComparisonPair_fst :
    finiteAxisFoldDisplayedAmbientKernelComparisonPair.1 =
      FiniteAxisFoldAmbientKernelCode.direct.admissibleEvaluateAut :=
  rfl

/-- Consequently the displayed source component is nonidentity before
normalization. -/
theorem finiteAxisFoldDisplayedAmbientKernelComparisonPair_fst_ne_one :
    finiteAxisFoldDisplayedAmbientKernelComparisonPair.1 ≠ 1 :=
  FiniteAxisFoldAmbientKernelCode.direct.admissibleEvaluateAut_ne_one

/-- Normalization sends the entire displayed endpoint pair to identity. -/
theorem finiteAxisFoldDisplayedAmbientKernelComparisonPair_normalization :
    geometryNormalizationEndpointAutomorphismHom
        (authoredExactDirectAdmissibleGeometryAt
          finiteAxisFoldBCDatumSquare
          (Discrete.mk DoubleDiamondTwoCell.second)
          Int
          (finiteAxisFoldFixedCoefficientGeometryFamily
            (Discrete.mk DoubleDiamondTwoCell.second))
          finiteCanonicalObjectNormalization_admissible)
        (authoredExactViaBaseAdmissibleGeometryAt
          finiteAxisFoldBCDatumSquare
          (Discrete.mk DoubleDiamondTwoCell.second)
          Int
          (finiteAxisFoldFixedCoefficientGeometryFamily
            (Discrete.mk DoubleDiamondTwoCell.second))
          finiteCanonicalObjectNormalization_admissible)
        finiteAxisFoldDisplayedAmbientKernelComparisonPair = 1 := by
  rw [finiteAxisFoldDisplayedAmbientKernelComparisonPair_eq_authored]
  exact authoredExactAmbientKernelComparisonPair_normalization
    finiteAxisFoldBCDatumSquare
    (Discrete.mk DoubleDiamondTwoCell.second)
    Int
    (finiteAxisFoldFixedCoefficientGeometryFamily
      (Discrete.mk DoubleDiamondTwoCell.second))
    finiteCanonicalObjectNormalization_admissible

/-- The normalized image of the displayed pair preserves the actual
normalized five-factor comparison. -/
theorem finiteAxisFoldDisplayedAmbientKernelComparisonPair_normalized_mem :
    geometryNormalizationEndpointAutomorphismHom
        (authoredExactDirectAdmissibleGeometryAt
          finiteAxisFoldBCDatumSquare
          (Discrete.mk DoubleDiamondTwoCell.second)
          Int
          (finiteAxisFoldFixedCoefficientGeometryFamily
            (Discrete.mk DoubleDiamondTwoCell.second))
          finiteCanonicalObjectNormalization_admissible)
        (authoredExactViaBaseAdmissibleGeometryAt
          finiteAxisFoldBCDatumSquare
          (Discrete.mk DoubleDiamondTwoCell.second)
          Int
          (finiteAxisFoldFixedCoefficientGeometryFamily
            (Discrete.mk DoubleDiamondTwoCell.second))
          finiteCanonicalObjectNormalization_admissible)
        finiteAxisFoldDisplayedAmbientKernelComparisonPair ∈
      normalizedGeometryComparisonSubgroup
        (authoredExactBarAlphaAdmissibleIsoAt
          finiteAxisFoldBCDatumSquare
          (Discrete.mk DoubleDiamondTwoCell.second)
          Int
          (finiteAxisFoldFixedCoefficientGeometryFamily
            (Discrete.mk DoubleDiamondTwoCell.second))
          finiteCanonicalObjectNormalization_admissible).hom := by
  rw [finiteAxisFoldDisplayedAmbientKernelComparisonPair_eq_authored]
  exact authoredExactAmbientKernelComparisonPair_normalized_mem
    finiteAxisFoldBCDatumSquare
    (Discrete.mk DoubleDiamondTwoCell.second)
    Int
    (finiteAxisFoldFixedCoefficientGeometryFamily
      (Discrete.mk DoubleDiamondTwoCell.second))
    finiteCanonicalObjectNormalization_admissible

/-- The same displayed pair does not preserve the original five-factor
`barAlpha`.  Thus ambient information loss is not the restriction kernel of
comparison-preserving changes. -/
theorem finiteAxisFoldDisplayedAmbientKernelComparisonPair_not_raw_mem :
    finiteAxisFoldDisplayedAmbientKernelComparisonPair ∉
      rawGeometryNormalizationComparisonSubgroup
        (authoredExactBarAlphaAdmissibleIsoAt
          finiteAxisFoldBCDatumSquare
          (Discrete.mk DoubleDiamondTwoCell.second)
          Int
          (finiteAxisFoldFixedCoefficientGeometryFamily
            (Discrete.mk DoubleDiamondTwoCell.second))
          finiteCanonicalObjectNormalization_admissible).hom := by
  rw [finiteAxisFoldDisplayedAmbientKernelComparisonPair_eq_authored]
  exact authoredExactAmbientKernelComparisonPair_not_raw_mem
    finiteAxisFoldBCDatumSquare
    (Discrete.mk DoubleDiamondTwoCell.second)
    Int
    (finiteAxisFoldFixedCoefficientGeometryFamily
      (Discrete.mk DoubleDiamondTwoCell.second))
    finiteCanonicalObjectNormalization_admissible

/-- The source and target components of the displayed pair both fix the
pointed-doctrine base and coefficient ring, while raw comparison preservation
still fails. -/
theorem finiteAxisFoldDisplayedAmbientKernelComparisonPair_component_packet :
    finiteAxisFoldDisplayedAmbientKernelComparisonPair.1.hom.hom.base.base =
        ExtInstHom.id (packagePoint
          (authoredExactDirectAdmissibleGeometryAt
            finiteAxisFoldBCDatumSquare
            (Discrete.mk DoubleDiamondTwoCell.second)
            Int
            (finiteAxisFoldFixedCoefficientGeometryFamily
              (Discrete.mk DoubleDiamondTwoCell.second))
            finiteCanonicalObjectNormalization_admissible).obj.core) ∧
      finiteAxisFoldDisplayedAmbientKernelComparisonPair.1.hom.hom.geometry.coefficientHom =
        RingHom.id Int ∧
      finiteAxisFoldDisplayedAmbientKernelComparisonPair.2.hom.hom.base.base =
        ExtInstHom.id (packagePoint
          (authoredExactViaBaseAdmissibleGeometryAt
            finiteAxisFoldBCDatumSquare
            (Discrete.mk DoubleDiamondTwoCell.second)
            Int
            (finiteAxisFoldFixedCoefficientGeometryFamily
              (Discrete.mk DoubleDiamondTwoCell.second))
            finiteCanonicalObjectNormalization_admissible).obj.core) ∧
      finiteAxisFoldDisplayedAmbientKernelComparisonPair.2.hom.hom.geometry.coefficientHom =
        RingHom.id Int := by
  rw [finiteAxisFoldDisplayedAmbientKernelComparisonPair_eq_authored]
  exact ⟨authoredExactAmbientKernelComparisonPair_fst_hom_base_base _ _ _ _ _,
    authoredExactAmbientKernelComparisonPair_fst_hom_coefficientHom _ _ _ _ _,
    authoredExactAmbientKernelComparisonPair_snd_hom_base_base _ _ _ _ _,
    authoredExactAmbientKernelComparisonPair_snd_hom_coefficientHom _ _ _ _ _⟩

end AAT.AG.RealizationReconstruction

#assert_standard_axioms_only AAT.AG.RealizationReconstruction
