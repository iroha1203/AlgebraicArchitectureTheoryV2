import ResearchLean.AG.RealizationReconstruction.MandatoryCFreeWordPresentationObstruction
import Mathlib.Algebra.PresentedMonoid.Basic
import Mathlib.CategoryTheory.SingleObj
import Formal.Util.AssertStandardAxioms

/-!
# The relation-quotient presentation over the tagged primitive alphabet

Cycle 15 treated the free monoid of all finite words over the complete
existing mandatory-C tagged primitive alphabet.  This module allows an
arbitrary binary family of generating relations between those words and
constructs the corresponding presented monoid and one-object category.
The canonical quotient map is still surjective, so the Cycle 14 cardinal
obstruction rules out fullness together with retract generation for every
such word-relation presentation.

This covers syntactic congruences generated by finite-word equations on the
existing alphabet.  It does not cover a proper endpoint-typed sublanguage,
additional legally source-provenanced parameter roles, binders or higher-order
syntax.  In particular, it neither identifies the independent admissible-
package category with final `R_Theta` nor proves the fixed target false.

## Implementation notes

`PresentedMonoid relations` is used rather than accepting an arbitrary
quotient type and a surjectivity certificate: Mathlib constructs its
multiplicative congruence from `relations`, and its canonical word map is
surjective by quotient induction.  `SingleObj` then supplies the category
laws.  The relation is deliberately kept syntactic and independent of a
semantic functor; choosing it to be equality after a completed decoder would
violate the fixed target even though the theorem below would still typecheck.
-/

namespace AAT.AG.RealizationReconstruction

open CategoryTheory
open RealizationComparisonIdempotents

/-- The monoid presented by the complete existing tagged primitive alphabet
and a supplied family of word relations. -/
abbrev TaggedPrimitivePresentedMonoid
    (relations : FreeMonoid TaggedPrimitiveReference →
      FreeMonoid TaggedPrimitiveReference → Prop) :=
  PresentedMonoid (α := TaggedPrimitiveReference) relations

/-- The actual one-object relation-quotient presentation category, constructed
before and independently of any semantic decoder. -/
abbrev TaggedPrimitiveRelationPresentation
    (relations : FreeMonoid TaggedPrimitiveReference →
      FreeMonoid TaggedPrimitiveReference → Prop) :=
  SingleObj (TaggedPrimitivePresentedMonoid relations)

/-- The sole object of a tagged word-relation presentation. -/
abbrev taggedPrimitiveRelationObject
    (relations : FreeMonoid TaggedPrimitiveReference →
      FreeMonoid TaggedPrimitiveReference → Prop) :
    TaggedPrimitiveRelationPresentation relations :=
  SingleObj.star (TaggedPrimitivePresentedMonoid relations)

/-- Send a finite tagged primitive word to its congruence class, regarded as
an endomorphism of any object of the presented one-object category. -/
def taggedPrimitiveRelationEndomorphismDecoder
    (relations : FreeMonoid TaggedPrimitiveReference →
      FreeMonoid TaggedPrimitiveReference → Prop)
    (p : TaggedPrimitiveRelationPresentation relations) :
    TaggedPrimitiveWord → (p ⟶ p) :=
  PresentedMonoid.mk (α := TaggedPrimitiveReference) relations

/-- Every endomorphism of the actual relation-quotient presentation has a
finite tagged primitive word representative.  No generation certificate is
received as an input. -/
theorem taggedPrimitiveRelationEndomorphismDecoder_surjective
    (relations : FreeMonoid TaggedPrimitiveReference →
      FreeMonoid TaggedPrimitiveReference → Prop)
    (p : TaggedPrimitiveRelationPresentation relations) :
    Function.Surjective
      (taggedPrimitiveRelationEndomorphismDecoder relations p) :=
  PresentedMonoid.surjective_mk

/-- The empty word represents the categorical identity after quotienting. -/
@[simp] theorem taggedPrimitiveRelationPresentation_id
    (relations : FreeMonoid TaggedPrimitiveReference →
      FreeMonoid TaggedPrimitiveReference → Prop)
    (p : TaggedPrimitiveRelationPresentation relations) :
    (𝟙 p : p ⟶ p) =
      taggedPrimitiveRelationEndomorphismDecoder relations p
        ([] : TaggedPrimitiveWord) :=
  rfl

/-- Evaluation of word concatenation agrees with categorical composition in
the fixed `gf = g o f` order. -/
@[simp] theorem taggedPrimitiveRelationPresentation_comp
    (relations : FreeMonoid TaggedPrimitiveReference →
      FreeMonoid TaggedPrimitiveReference → Prop)
    (first second : TaggedPrimitiveWord) :
    SingleObj.toEnd (TaggedPrimitivePresentedMonoid relations)
        (PresentedMonoid.mk (α := TaggedPrimitiveReference) relations first) ≫
      SingleObj.toEnd (TaggedPrimitivePresentedMonoid relations)
        (PresentedMonoid.mk (α := TaggedPrimitiveReference) relations second) =
      SingleObj.toEnd (TaggedPrimitivePresentedMonoid relations)
        (PresentedMonoid.mk (α := TaggedPrimitiveReference) relations
          (second * first)) :=
  rfl

/-- No relation-quotient of all finite words over the complete existing tagged
primitive alphabet admits a functor into the independent mandatory-C category
that is both full and retract-generating.  The word-generation premise of the
Cycle 14 theorem is constructed from the canonical quotient map. -/
theorem taggedPrimitiveRelationPresentation_not_full_and_retractGenerated
    (relations : FreeMonoid TaggedPrimitiveReference →
      FreeMonoid TaggedPrimitiveReference → Prop)
    (F : TaggedPrimitiveRelationPresentation relations ⥤
      CanonicalNormalizationAdmissiblePackage FiniteModel.carrier) :
    ¬ (F.Full ∧ RetractGeneratedBy F) :=
  not_full_and_retractGenerated_of_listPrimitiveGeneratedEndomorphisms F
    (fun p => ⟨taggedPrimitiveRelationEndomorphismDecoder relations p,
      taggedPrimitiveRelationEndomorphismDecoder_surjective relations p⟩)

#assert_standard_axioms_only AAT.AG.RealizationReconstruction

end AAT.AG.RealizationReconstruction
