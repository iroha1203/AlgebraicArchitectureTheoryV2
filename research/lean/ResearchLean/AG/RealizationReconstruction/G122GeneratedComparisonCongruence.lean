import ResearchLean.AG.RealizationReconstruction.G122GeneratedComparisonSyntax
import Formal.Util.AssertStandardAxioms

/-!
# Source-law congruence for generated G-122 comparisons

This module equips the Cycle 51 typed comparison grammar with a congruence
generated only by category laws and the actual G-122 factorization,
idempotence, and absorption laws.  It is not defined by equality after
semantic evaluation.  Soundness is proved afterwards by induction over the
source-law derivation.

The fixed finite-axis-fold generated-cochain input supplies both sides of the
nonvacuity check.  Its `barBeta` factorization is a positive congruence
instance, while its nonidentity target projector gives a concrete negative
instance against the identity term.

## Implementation notes

Congruence is closed under typed composition but has no constructor for an
arbitrary semantic equality.  The negative instance first derives semantic
nonidentity of the actual target projector from the accepted noninvertibility
of generated `barBeta` and the isomorphism of `barAlpha`, then uses soundness
to exclude a syntactic derivation.  Completeness or decidability of this
congruence is not asserted.
-/

namespace AAT.AG.RealizationReconstruction

universe u v

namespace G122GeneratedComparisonSyntax

/-- The typed congruence generated by category laws and the five established
G-122 comparison laws, independently of semantic decoder equality. -/
inductive Congruent {Θ : G122FamilyInput.{u, v}} :
    {X Y : G122GeneratedGeometryObject Θ} →
      G122GeneratedComparisonSyntax Θ X Y →
      G122GeneratedComparisonSyntax Θ X Y → Prop
  | refl {X Y} (term : G122GeneratedComparisonSyntax Θ X Y) :
      Congruent term term
  | symm {X Y} {first second : G122GeneratedComparisonSyntax Θ X Y}
      (relation : Congruent first second) : Congruent second first
  | trans {X Y} {first second third : G122GeneratedComparisonSyntax Θ X Y}
      (firstRelation : Congruent first second)
      (secondRelation : Congruent second third) : Congruent first third
  | comp {W X Y}
      {first first' : G122GeneratedComparisonSyntax Θ W X}
      {second second' : G122GeneratedComparisonSyntax Θ X Y}
      (firstRelation : Congruent first first')
      (secondRelation : Congruent second second') :
      Congruent (.compose first second) (.compose first' second')
  | id_comp {X Y} (term : G122GeneratedComparisonSyntax Θ X Y) :
      Congruent (.compose (.identity X) term) term
  | comp_id {X Y} (term : G122GeneratedComparisonSyntax Θ X Y) :
      Congruent (.compose term (.identity Y)) term
  | assoc {W X Y Z}
      (first : G122GeneratedComparisonSyntax Θ W X)
      (second : G122GeneratedComparisonSyntax Θ X Y)
      (third : G122GeneratedComparisonSyntax Θ Y Z) :
      Congruent (.compose (.compose first second) third)
        (.compose first (.compose second third))
  | barBeta_factor (input : G122CellInput Θ) :
      Congruent (.barBeta input) (.compose (.barAlpha input) (.barD input))
  | barE_idem (input : G122CellInput Θ) :
      Congruent (.compose (.barE input) (.barE input)) (.barE input)
  | barD_idem (input : G122CellInput Θ) :
      Congruent (.compose (.barD input) (.barD input)) (.barD input)
  | barBeta_source (input : G122CellInput Θ) :
      Congruent (.compose (.barE input) (.barBeta input)) (.barBeta input)
  | barBeta_target (input : G122CellInput Θ) :
      Congruent (.compose (.barBeta input) (.barD input)) (.barBeta input)

/-- Every source-law congruence derivation is respected by semantic
evaluation. -/
theorem evaluate_eq_of_congruent {Θ : G122FamilyInput.{u, v}}
    {X Y : G122GeneratedGeometryObject Θ}
    {first second : G122GeneratedComparisonSyntax Θ X Y}
    (relation : Congruent first second) : first.evaluate = second.evaluate := by
  induction relation with
  | refl => rfl
  | symm relation ih => exact ih.symm
  | trans firstRelation secondRelation firstIH secondIH =>
      exact firstIH.trans secondIH
  | comp firstRelation secondRelation firstIH secondIH =>
      exact congrArg₂ (G122GeneratedGeometryObject.comp Θ) firstIH secondIH
  | id_comp term => exact G122GeneratedGeometryObject.id_comp Θ term.evaluate
  | comp_id term => exact G122GeneratedGeometryObject.comp_id Θ term.evaluate
  | assoc first second third =>
      exact G122GeneratedGeometryObject.comp_assoc Θ first.evaluate
        second.evaluate third.evaluate
  | barBeta_factor input =>
      exact G122GeneratedGeometryObject.barBeta_factor Θ input
  | barE_idem input => exact G122GeneratedGeometryObject.barE_idem Θ input
  | barD_idem input => exact G122GeneratedGeometryObject.barD_idem Θ input
  | barBeta_source input =>
      exact G122GeneratedGeometryObject.barBeta_source_factorization Θ input
  | barBeta_target input =>
      exact G122GeneratedGeometryObject.barBeta_target_factorization Θ input

/-- The fixed generated-cochain target projector is not the semantic identity
on the fixed via-base endpoint. -/
theorem finiteAxisFold_barD_ne_identity :
    evaluate (.barD finiteAxisFoldG122CellInput) ≠
      evaluate (.identity
        (.viaBase finiteAxisFoldG122CellInput)) := by
  change G122GeneratedGeometryObject.barD finiteAxisFoldG122FamilyInput
      finiteAxisFoldG122CellInput ≠
    G122GeneratedGeometryObject.id finiteAxisFoldG122FamilyInput
      (.viaBase finiteAxisFoldG122CellInput)
  intro targetProjectorIdentity
  apply finiteAxisFold_generatedGeometry_barBeta_not_isIso
  rw [G122GeneratedGeometryObject.barBeta_factor,
    targetProjectorIdentity, G122GeneratedGeometryObject.comp_id]
  exact (G122GeneratedGeometryObject.barAlphaIso
    finiteAxisFoldG122FamilyInput finiteAxisFoldG122CellInput).isIso_hom

/-- The fixed generated comparison and its source-derived factorization are a
concrete positive instance of the congruence. -/
theorem finiteAxisFold_barBeta_factor_congruent :
    Congruent (.barBeta finiteAxisFoldG122CellInput)
      (.compose (.barAlpha finiteAxisFoldG122CellInput)
        (.barD finiteAxisFoldG122CellInput)) :=
  Congruent.barBeta_factor finiteAxisFoldG122CellInput

/-- The fixed generated-cochain target projector and identity term are a
concrete negative congruence instance. -/
theorem finiteAxisFold_barD_not_congruent_identity :
    ¬ Congruent (.barD finiteAxisFoldG122CellInput)
      (.identity (.viaBase finiteAxisFoldG122CellInput)) := by
  intro relation
  exact finiteAxisFold_barD_ne_identity (evaluate_eq_of_congruent relation)

end G122GeneratedComparisonSyntax

end AAT.AG.RealizationReconstruction

#assert_standard_axioms_only AAT.AG.RealizationReconstruction
