import ResearchLean.AG.RealizationReconstruction.FiniteAxisFoldFiniteCarrierUnionObstruction
import Mathlib.GroupTheory.Perm.ClosureSwap
import Mathlib.GroupTheory.FreeGroup.Basic
import Formal.Util.AssertStandardAxioms

/-!
# Finite swap-word image on arbitrary Extension carriers

The fixed-finite-carrier tables of Cycle 98 do not cover the source-owned
`Nat` direction isolated in Cycle 99.  This file enlarges the independent
syntax without accepting a completed all-domain permutation as one payload.
For any primitive carrier `E`, a generator contains only two distinct values
of `E`; a term is a finite word in those swaps.

The primitive evaluation image is characterized independently as the subgroup
of permutations with finite support.  Transporting that subgroup through the
same fixed source-to-actual action gives an intrinsic actual subgroup.  The
finite-word decoder lands in it and is surjective onto it.  No injectivity of
the free-word syntax is claimed: different words may express the same source
permutation, and no decoder-equality quotient is introduced here.

The Cycle 99 `Nat` zero/one swap is the evaluation of one explicit generator,
so the enlarged syntax genuinely repairs that finite-carrier omission.  Full
coverage of the actual local-fiber kernel remains a separate obligation.
-/

namespace AAT.AG.RealizationReconstruction

open CategoryTheory AtomFoundation DoctrineFiberProduct GeometryTransport
open CrossStageCoherence TransportCoherence FullGeometryNormalization
open MulAction Set Subgroup

noncomputable section

set_option synthInstance.maxHeartbeats 200000
set_option maxHeartbeats 1200000

/-- One finite source recipe: exchange two explicitly named distinct values
of the primitive carrier. -/
structure FiniteAxisFoldExtensionSwapGenerator (E : Type) where
  left : E
  right : E
  ne : left ≠ right

namespace FiniteAxisFoldExtensionSwapGenerator

variable {E : Type} [DecidableEq E]

/-- Evaluate one primitive generator as a transposition of the carrier. -/
def toPerm (generator : FiniteAxisFoldExtensionSwapGenerator E) :
    Equiv.Perm E :=
  Equiv.swap generator.left generator.right

/-- The primitive generators are exactly the transpositions, independently
of the later complete-geometry decoder. -/
theorem range_toPerm :
    Set.range (toPerm (E := E)) =
      {permutation : Equiv.Perm E | permutation.IsSwap} := by
  ext permutation
  constructor
  · rintro ⟨generator, rfl⟩
    exact Equiv.Perm.swap_isSwap_iff.mpr generator.ne
  · rintro ⟨left, right, ne, rfl⟩
    exact ⟨⟨left, right, ne⟩, rfl⟩

end FiniteAxisFoldExtensionSwapGenerator

/-- Independent finite source words generated by explicit swaps. -/
abbrev FiniteAxisFoldExtensionSwapWord (E : Type) :=
  FreeGroup (FiniteAxisFoldExtensionSwapGenerator E)

/-- Evaluate a finite source word on its primitive carrier. -/
noncomputable def finiteAxisFoldExtensionSwapWordPermutation
    (E : Type) [DecidableEq E] :
    FiniteAxisFoldExtensionSwapWord E →* Equiv.Perm E :=
  FreeGroup.lift FiniteAxisFoldExtensionSwapGenerator.toPerm

/-- Intrinsic primitive-carrier subgroup: precisely the finite products of
transpositions. -/
def finiteAxisFoldFiniteSupportPermutationSubgroup
    (E : Type) [DecidableEq E] : Subgroup (Equiv.Perm E) :=
  Subgroup.closure
    {permutation : Equiv.Perm E | permutation.IsSwap}

/-- The independent finite-word evaluator has exactly the intrinsic
finite-support permutation subgroup as its range. -/
theorem finiteAxisFoldExtensionSwapWordPermutation_range
    (E : Type) [DecidableEq E] :
    (finiteAxisFoldExtensionSwapWordPermutation E).range =
      finiteAxisFoldFiniteSupportPermutationSubgroup E := by
  rw [finiteAxisFoldExtensionSwapWordPermutation,
    FreeGroup.range_lift_eq_closure,
    FiniteAxisFoldExtensionSwapGenerator.range_toPerm]
  rfl

/-- Mathlib's support characterization makes the primitive condition
independent of the word evaluator: all but finitely many values are fixed. -/
theorem finiteAxisFoldFiniteSupportPermutationSubgroup_mem_iff
    {E : Type} [DecidableEq E] (permutation : Equiv.Perm E) :
    permutation ∈ finiteAxisFoldFiniteSupportPermutationSubgroup E ↔
      (fixedBy E permutation)ᶜ.Finite :=
  mem_closure_isSwap'

/-- Expected actual backward action for an arbitrary primitive carrier,
defined before any finite-word decoder. -/
noncomputable def finiteAxisFoldArbitraryCarrierBackwardAction
    (E : Type) :
    Equiv.Perm E →*
      (Equiv.Perm FiniteAxisFoldResidualContextObject)ᵐᵒᵖ where
  toFun permutation := MulOpposite.op
    (finiteAxisFoldTransportedSourceContextPermutationHom E permutation⁻¹)
  map_one' := by
    rw [inv_one, map_one]
    rfl
  map_mul' first second := by
    apply MulOpposite.unop_injective
    rw [mul_inv_rev, map_mul]
    rfl

/-- Actual subgroup whose complete backward action is induced by some
finite-support permutation of the fixed primitive carrier `E`. -/
noncomputable def FiniteAxisFoldFiniteSwapWordIntrinsicImage
    (E : Type) [DecidableEq E] :
    Subgroup FiniteAxisFoldResidualLocalFiberKernel :=
  (Subgroup.map (finiteAxisFoldArbitraryCarrierBackwardAction E)
      (finiteAxisFoldFiniteSupportPermutationSubgroup E)).comap
    finiteAxisFoldResidualLocalFiberKernelBackwardProjection

/-- Intrinsic membership is a finite-support primitive action condition, not a
decoder-range condition. -/
theorem finiteAxisFoldFiniteSwapWordIntrinsicImage_mem_iff
    {E : Type} [DecidableEq E]
    (remainder : FiniteAxisFoldResidualLocalFiberKernel) :
    remainder ∈ FiniteAxisFoldFiniteSwapWordIntrinsicImage E ↔
      ∃ permutation : Equiv.Perm E,
        (fixedBy E permutation)ᶜ.Finite ∧
        finiteAxisFoldResidualLocalFiberKernelBackwardProjection remainder =
          finiteAxisFoldArbitraryCarrierBackwardAction E permutation := by
  rw [FiniteAxisFoldFiniteSwapWordIntrinsicImage, Subgroup.mem_comap,
    Subgroup.mem_map]
  constructor
  · rintro ⟨permutation, finiteSupport, actionEquality⟩
    exact ⟨permutation,
      (finiteAxisFoldFiniteSupportPermutationSubgroup_mem_iff permutation).mp
        finiteSupport,
      actionEquality.symm⟩
  · rintro ⟨permutation, finiteSupport, actionEquality⟩
    exact ⟨permutation,
      (finiteAxisFoldFiniteSupportPermutationSubgroup_mem_iff permutation).mpr
        finiteSupport,
      actionEquality.symm⟩

/-- Evaluate the independent finite swap word through the same actual
local-fiber-kernel section used by Cycles 92--99. -/
noncomputable def finiteAxisFoldFiniteSwapWordDecoder
    (E : Type) [DecidableEq E] :
    FiniteAxisFoldExtensionSwapWord E →*
      FiniteAxisFoldResidualLocalFiberKernel :=
  (finiteAxisFoldNormalizedPermutationLocalFiberKernelSectionHom E).comp
    (finiteAxisFoldExtensionSwapWordPermutation E)

/-- The actual projection of the word decoder equals the expected action
defined independently from that decoder. -/
theorem finiteAxisFoldFiniteSwapWordDecoder_backwardProjection
    {E : Type} [DecidableEq E]
    (word : FiniteAxisFoldExtensionSwapWord E) :
    finiteAxisFoldResidualLocalFiberKernelBackwardProjection
        (finiteAxisFoldFiniteSwapWordDecoder E word) =
      finiteAxisFoldArbitraryCarrierBackwardAction E
        (finiteAxisFoldExtensionSwapWordPermutation E word) := by
  exact
    finiteAxisFoldNormalizedPermutationLocalFiberKernelSectionHom_backwardProjection
      (finiteAxisFoldExtensionSwapWordPermutation E word)

/-- The finite-word decoder lands in the independently characterized actual
subgroup. -/
noncomputable def finiteAxisFoldFiniteSwapWordIntrinsicDecoder
    (E : Type) [DecidableEq E] :
    FiniteAxisFoldExtensionSwapWord E →*
      FiniteAxisFoldFiniteSwapWordIntrinsicImage E :=
  (finiteAxisFoldFiniteSwapWordDecoder E).codRestrict
    (FiniteAxisFoldFiniteSwapWordIntrinsicImage E)
    (fun word => by
      rw [finiteAxisFoldFiniteSwapWordIntrinsicImage_mem_iff]
      refine ⟨finiteAxisFoldExtensionSwapWordPermutation E word, ?_, ?_⟩
      · apply
          (finiteAxisFoldFiniteSupportPermutationSubgroup_mem_iff _).mp
        rw [← finiteAxisFoldExtensionSwapWordPermutation_range E]
        exact ⟨word, rfl⟩
      · exact finiteAxisFoldFiniteSwapWordDecoder_backwardProjection word)

/-- Every actual element satisfying the intrinsic finite-support action
condition has an independent finite-word preimage. -/
theorem finiteAxisFoldFiniteSwapWordIntrinsicDecoder_surjective
    (E : Type) [DecidableEq E] :
    Function.Surjective
      (finiteAxisFoldFiniteSwapWordIntrinsicDecoder E) := by
  intro remainder
  obtain ⟨permutation, finiteSupport, actionEquality⟩ :=
    (finiteAxisFoldFiniteSwapWordIntrinsicImage_mem_iff remainder.1).mp
      remainder.2
  have permutationInSubgroup :
      permutation ∈ finiteAxisFoldFiniteSupportPermutationSubgroup E :=
    (finiteAxisFoldFiniteSupportPermutationSubgroup_mem_iff permutation).mpr
      finiteSupport
  rw [← finiteAxisFoldExtensionSwapWordPermutation_range E] at permutationInSubgroup
  obtain ⟨word, wordEquality⟩ := permutationInSubgroup
  refine ⟨word, ?_⟩
  apply Subtype.ext
  apply finiteAxisFoldResidualLocalFiberKernelBackwardProjection_injective
  change finiteAxisFoldResidualLocalFiberKernelBackwardProjection
      (finiteAxisFoldFiniteSwapWordDecoder E word) =
    finiteAxisFoldResidualLocalFiberKernelBackwardProjection remainder.1
  rw [finiteAxisFoldFiniteSwapWordDecoder_backwardProjection, wordEquality]
  exact actionEquality.symm

/-- Exact actual-image theorem, derived from the independent finite-support
condition and the surjectivity proof rather than used to define the syntax. -/
theorem finiteAxisFoldFiniteSwapWordIntrinsicImage_mem_iff_decoder
    {E : Type} [DecidableEq E]
    (remainder : FiniteAxisFoldResidualLocalFiberKernel) :
    remainder ∈ FiniteAxisFoldFiniteSwapWordIntrinsicImage E ↔
      ∃ word : FiniteAxisFoldExtensionSwapWord E,
        finiteAxisFoldFiniteSwapWordDecoder E word = remainder := by
  constructor
  · intro membership
    let intrinsic : FiniteAxisFoldFiniteSwapWordIntrinsicImage E :=
      ⟨remainder, membership⟩
    obtain ⟨word, equality⟩ :=
      finiteAxisFoldFiniteSwapWordIntrinsicDecoder_surjective E intrinsic
    exact ⟨word, congrArg Subtype.val equality⟩
  · rintro ⟨word, rfl⟩
    exact (finiteAxisFoldFiniteSwapWordIntrinsicDecoder E word).2

/-- The Cycle 99 source-owned Nat swap is one primitive word of the enlarged
syntax, not a newly supplied semantic witness. -/
def finiteAxisFoldNatZeroOneSwapGenerator :
    FiniteAxisFoldExtensionSwapGenerator Nat where
  left := 0
  right := 1
  ne := by omega

/-- Exact recovery of the Cycle 99 outside element by the enlarged syntax. -/
theorem finiteAxisFoldNatZeroOneSwap_has_finiteSwapWordPreimage :
    finiteAxisFoldFiniteSwapWordDecoder Nat
        (FreeGroup.of finiteAxisFoldNatZeroOneSwapGenerator) =
      finiteAxisFoldNatZeroOneSwapLocalFiberKernel := by
  change finiteAxisFoldNormalizedPermutationLocalFiberKernelSectionHom Nat
      (finiteAxisFoldExtensionSwapWordPermutation Nat
        (FreeGroup.of finiteAxisFoldNatZeroOneSwapGenerator)) =
    finiteAxisFoldNormalizedPermutationLocalFiberKernelSectionHom Nat
      finiteAxisFoldNatZeroOneSwap
  simp [finiteAxisFoldExtensionSwapWordPermutation,
    FiniteAxisFoldExtensionSwapGenerator.toPerm,
    finiteAxisFoldNatZeroOneSwapGenerator,
    finiteAxisFoldNatZeroOneSwap]

#assert_standard_axioms_only AAT.AG.RealizationReconstruction

end

end AAT.AG.RealizationReconstruction
