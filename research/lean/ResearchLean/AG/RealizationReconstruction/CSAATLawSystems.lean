import ResearchLean.AG.RealizationReconstruction.CSAATArchitectureObjects
import Formal.AG.Equation.Basic
import Formal.Util.AssertStandardAxioms

/-!
# CS laws as actual AAT architectural equation systems

This module constructs equation systems from the raw laws of the two independent
CS models in G-123(E).  The residuals are defined from the authored lens
equations and from the protocol relation/observation equations; lawfulness is
then proved equivalent to those equations.  Thus the AAT law conclusion is not
accepted as a structure field or certificate.

The construction is deliberately prior to a complete AAT core or geometry.
It does not claim an AAT-to-CS readback or the final A--F equivalence.
-/

namespace AAT.AG.RealizationReconstruction

open CategoryTheory

universe u

/-! ## A common residual encoding -/

/-- Encode a proposition as an integer residual without requiring decidable
equality on any semantic carrier. -/
noncomputable def propositionResidual (P : Prop) : Int :=
  by
    classical
    exact if P then 0 else 1

/-- The constructed residual vanishes exactly when its source proposition holds. -/
@[simp] theorem propositionResidual_eq_zero_iff (P : Prop) :
    propositionResidual P = 0 ↔ P := by
  classical
  simp [propositionResidual]

/-- A concrete context used only to read a residual at one actual context.
Its support reads the complete family already constructed in Cycle 125. -/
def fullFamilyUnitContext {U : AtomCarrier.{u}} (A : ArchitectureObject U)
    (all_mem : ∀ atom, A.configuration.family.mem atom) :
    Site.ArchitectureContext A where
  minimal := {
    Support := PUnit
    Axis := PUnit
    Observable := PUnit
    supportReads := fun _ _ => True
    supportReads_objectFamily := fun {_ _} _ => all_mem _
    axisReads := fun _ => True
    observableReads := fun _ => True }
  Extension := PUnit
  extension := PUnit.unit

/-! ## Lens equations -/

/-- The three authored n1015 (L1) equation instances for raw lens data. -/
inductive LensLawIndex {V : Type u} (L : LensData V) : Type u
  | putGet (state : L.Carrier)
  | getPut (state : L.Carrier) (view : V)
  | putPut (state : L.Carrier) (first second : V)

/-- Direct, independent meaning of each raw lens-law instance. -/
def LensLawIndex.Holds {V : Type u} {L : LensData V} :
    LensLawIndex L → Prop
  | .putGet state => L.put state (L.get state) = state
  | .getPut state view => L.get (L.put state view) = view
  | .putPut state first second =>
      L.put (L.put state first) second = L.put state second

/-- An AAT object carrying raw lens data, before assuming the lens laws. -/
def lensRawLawObject (input : LensFamilyInput.{u}) (L : LensData input.View) :
    ArchitectureObject (lensAATCarrier input) where
  configuration := typedRoleConfiguration (.point : LensAATAtom input)
  StructureMaps := LensData input.View
  SelectedQuantities := ULift.{u + 1, u} input.View
  structureMaps := L
  selectedQuantities := ULift.up input.reference

/-- The canonical AAT context preorder for the raw lens-law object. -/
noncomputable abbrev lensLawContext (input : LensFamilyInput.{u})
    (L : LensData input.View) :=
  Site.contextMorphismPreorderCategory (lensRawLawObject input L)

/-- The actual AAT equation system generated by the three raw lens laws.
Every equation instance is required, and its residual is computed from the
corresponding raw equality rather than supplied as a vanishing certificate. -/
noncomputable def lensLawEquationSystem (input : LensFamilyInput.{u})
    (L : LensData input.View) : ArchitecturalEquationSystem (lensLawContext input L) where
  Index := ULift.{u + 1, u} (LensLawIndex L)
  role _ := .required
  Observable _ := ULift.{u + 1, 0} Int
  observableCommRing _ := inferInstance
  restrict _ := RingHom.id _
  restrict_id _ _ := rfl
  restrict_comp _ _ _ := rfl
  violationCoordinate _ _ _ := 1
  violationCoordinate_restrict _ _ _ := rfl
  equationResidual _ _ index _ := ULift.up (propositionResidual index.down.Holds)
  equationResidual_restrict _ _ _ _ := rfl

/-- A raw lens equation holds in the AAT system exactly when the authored
source equality holds. -/
theorem lensLawEquationHolds_iff (input : LensFamilyInput.{u})
    (L : LensData input.View) (index : LensLawIndex L) :
    (lensLawEquationSystem input L).EquationHolds (ULift.up index)
        (lensRawLawObject input L) ↔
      index.Holds := by
  constructor
  · intro h
    have hresidual := h
      ⟨fullFamilyUnitContext (lensRawLawObject input L) (fun _ => trivial)⟩
      (.point : LensAATAtom input)
    have hdown := congrArg ULift.down hresidual
    change propositionResidual index.Holds = 0 at hdown
    exact (propositionResidual_eq_zero_iff index.Holds).mp hdown
  · intro h _ _
    apply ULift.ext
    change propositionResidual index.Holds = 0
    exact (propositionResidual_eq_zero_iff index.Holds).mpr h

/-- AAT lawfulness of the raw lens object is equivalent to all three L1 laws,
with their full original quantification. -/
theorem lensEquationLawful_iff (input : LensFamilyInput.{u})
    (L : LensData input.View) :
    (lensLawEquationSystem input L).EquationLawful (lensRawLawObject input L) ↔
      (∀ state, L.put state (L.get state) = state) ∧
      (∀ state view, L.get (L.put state view) = view) ∧
      (∀ state first second,
        L.put (L.put state first) second = L.put state second) := by
  constructor
  · intro lawful
    refine ⟨?_, ?_, ?_⟩
    · intro state
      exact (lensLawEquationHolds_iff input L (.putGet state)).mp
        (lawful (ULift.up (.putGet state)) rfl)
    · intro state view
      exact (lensLawEquationHolds_iff input L (.getPut state view)).mp
        (lawful (ULift.up (.getPut state view)) rfl)
    · intro state first second
      exact (lensLawEquationHolds_iff input L (.putPut state first second)).mp
        (lawful (ULift.up (.putPut state first second)) rfl)
  · rintro ⟨putGet, getPut, putPut⟩ index _
    apply (lensLawEquationHolds_iff input L index.down).mpr
    cases index.down with
    | putGet state => exact putGet state
    | getPut state view => exact getPut state view
    | putPut state first second => exact putPut state first second

/-- Every independently supplied lens realization constructs an AAT-lawful
raw object by discharging all residuals from its original L1 condition. -/
theorem lensRealization_equationLawful {input : LensFamilyInput.{u}}
    (X : LensRealization input.View input.reference) :
    (lensLawEquationSystem input X.toLensData).EquationLawful
      (lensRawLawObject input X.toLensData) :=
  (lensEquationLawful_iff input X.toLensData).mpr
    ⟨X.condition.put_get, X.condition.get_put, X.condition.put_put⟩

/-- Along every arbitrary n1015 (L2) morphism, the constructed AAT lawfulness
condition is preserved and reflected.  No injectivity or inverse for the state
map is used: both directions are discharged from the independently required
L1 object conditions at the two endpoints. -/
theorem lensHom_equationLawful_iff {input : LensFamilyInput.{u}}
    {X Y : LensRealization input.View input.reference} (_f : X ⟶ Y) :
    (lensLawEquationSystem input X.toLensData).EquationLawful
        (lensRawLawObject input X.toLensData) ↔
      (lensLawEquationSystem input Y.toLensData).EquationLawful
        (lensRawLawObject input Y.toLensData) :=
  ⟨fun _ => lensRealization_equationLawful Y,
    fun _ => lensRealization_equationLawful X⟩

/-! ## Protocol equations -/

/-- Raw protocol carriers, named-edge actions, and observations before any
path-relation or observation-naturality law is assumed. -/
structure ProtocolLawData (input : ProtocolFamilyInput.{u}) where
  State : input.schema.Vertex → Type u
  edgeAction : ∀ {source target}, input.schema.Edge source target →
    State source → State target
  observe : ∀ vertex, State vertex →
    input.observation.obj (input.schema.vertexObject vertex)

/-- The fixed protocol relation instances and named-edge observation squares. -/
inductive ProtocolLawIndex {input : ProtocolFamilyInput.{u}}
    (X : ProtocolLawData input) : Type u
  | relation (r : input.schema.RelationIndex)
      (state : X.State (input.schema.relationSource r))
  | observation {source target : input.schema.Vertex}
      (edge : input.schema.Edge source target) (state : X.State source)

/-- Direct meaning of a raw protocol relation or observation equation. -/
def ProtocolLawIndex.Holds {input : ProtocolFamilyInput.{u}}
    {X : ProtocolLawData input} : ProtocolLawIndex X → Prop
  | .relation r state =>
      input.schema.evaluatePath X.edgeAction (input.schema.relationLeft r) state =
        input.schema.evaluatePath X.edgeAction (input.schema.relationRight r) state
  | .observation edge state =>
      input.observation.map (input.schema.edgeMorphism edge) (X.observe _ state) =
        X.observe _ (X.edgeAction edge state)

/-- An AAT object carrying raw protocol law data without assuming its laws. -/
def protocolRawLawObject (input : ProtocolFamilyInput.{u}) (X : ProtocolLawData input) :
    ArchitectureObject (protocolAATCarrier input) where
  configuration := typedRoleConfiguration (.point : ProtocolAATAtom input)
  StructureMaps := ProtocolLawData input
  SelectedQuantities := PUnit
  structureMaps := X
  selectedQuantities := PUnit.unit

/-- The canonical AAT context preorder for the raw protocol-law object. -/
noncomputable abbrev protocolLawContext (input : ProtocolFamilyInput.{u})
    (X : ProtocolLawData input) :=
  Site.contextMorphismPreorderCategory (protocolRawLawObject input X)

/-- The actual AAT equation system generated from every fixed relation and
every named-edge observation square. -/
noncomputable def protocolLawEquationSystem (input : ProtocolFamilyInput.{u})
    (X : ProtocolLawData input) :
    ArchitecturalEquationSystem (protocolLawContext input X) where
  Index := ULift.{u + 1, u} (ProtocolLawIndex X)
  role _ := .required
  Observable _ := ULift.{u + 1, 0} Int
  observableCommRing _ := inferInstance
  restrict _ := RingHom.id _
  restrict_id _ _ := rfl
  restrict_comp _ _ _ := rfl
  violationCoordinate _ _ _ := 1
  violationCoordinate_restrict _ _ _ := rfl
  equationResidual _ _ index _ := ULift.up (propositionResidual index.down.Holds)
  equationResidual_restrict _ _ _ _ := rfl

/-- A raw protocol equation holds in the AAT system exactly when its original
relation or observation equality holds. -/
theorem protocolLawEquationHolds_iff (input : ProtocolFamilyInput.{u})
    (X : ProtocolLawData input) (index : ProtocolLawIndex X) :
    (protocolLawEquationSystem input X).EquationHolds (ULift.up index)
        (protocolRawLawObject input X) ↔ index.Holds := by
  constructor
  · intro h
    have hresidual := h
      ⟨fullFamilyUnitContext (protocolRawLawObject input X) (fun _ => trivial)⟩
      (.point : ProtocolAATAtom input)
    have hdown := congrArg ULift.down hresidual
    change propositionResidual index.Holds = 0 at hdown
    exact (propositionResidual_eq_zero_iff index.Holds).mp hdown
  · intro h _ _
    apply ULift.ext
    change propositionResidual index.Holds = 0
    exact (propositionResidual_eq_zero_iff index.Holds).mpr h

/-- AAT lawfulness is exactly the full raw protocol relation family together
with every original named-edge observation square. -/
theorem protocolEquationLawful_iff (input : ProtocolFamilyInput.{u})
    (X : ProtocolLawData input) :
    (protocolLawEquationSystem input X).EquationLawful (protocolRawLawObject input X) ↔
      (∀ (r : input.schema.RelationIndex)
        (state : X.State (input.schema.relationSource r)),
        input.schema.evaluatePath X.edgeAction (input.schema.relationLeft r) state =
          input.schema.evaluatePath X.edgeAction (input.schema.relationRight r) state) ∧
      (∀ {source target : input.schema.Vertex}
        (edge : input.schema.Edge source target) (state : X.State source),
        input.observation.map (input.schema.edgeMorphism edge) (X.observe source state) =
          X.observe target (X.edgeAction edge state)) := by
  constructor
  · intro lawful
    constructor
    · intro r state
      exact (protocolLawEquationHolds_iff input X (.relation r state)).mp
        (lawful (ULift.up (.relation r state)) rfl)
    · intro source target edge state
      exact (protocolLawEquationHolds_iff input X (.observation edge state)).mp
        (lawful (ULift.up (.observation edge state)) rfl)
  · rintro ⟨relations, observations⟩ index _
    apply (protocolLawEquationHolds_iff input X index.down).mpr
    cases index.down with
    | relation r state => exact relations r state
    | observation edge state => exact observations edge state

/-- Extract only raw protocol data from an independently supplied realization. -/
def ProtocolRealization.toLawData {input : ProtocolFamilyInput.{u}}
    (X : ProtocolRealization input.schema input.observation) : ProtocolLawData input where
  State := X.State
  edgeAction := X.edgeAction
  observe := X.observe

/-- Evaluation generated only from named edges agrees with the original
realization on every finite path. -/
theorem protocolEvaluatePath_eq_pathAction {input : ProtocolFamilyInput.{u}}
    (X : ProtocolRealization input.schema input.observation)
    {source target : input.schema.Vertex} (path : Quiver.Path source target) :
    input.schema.evaluatePath X.edgeAction path = X.pathAction path := by
  induction path with
  | nil =>
      change (𝟙 (X.State source)) =
        X.toFunctor.map
          ((CategoryTheory.Quotient.functor input.schema.pathRelation).map
            (Quiver.Path.nil : Quiver.Path source source))
      have hquotient :
          (CategoryTheory.Quotient.functor input.schema.pathRelation).map
              (Quiver.Path.nil : Quiver.Path source source) =
            𝟙 (input.schema.vertexObject source) :=
        (CategoryTheory.Quotient.functor input.schema.pathRelation).map_id source
      rw [hquotient]
      exact (X.toFunctor.map_id _).symm
  | cons path edge ih =>
      change
        input.schema.evaluatePath X.edgeAction path ≫ X.edgeAction edge =
          X.toFunctor.map
            ((CategoryTheory.Quotient.functor input.schema.pathRelation).map
              (path.cons edge))
      rw [ih]
      have hquotient :
          (CategoryTheory.Quotient.functor input.schema.pathRelation).map
              (path.cons edge) =
            (CategoryTheory.Quotient.functor input.schema.pathRelation).map path ≫
              (CategoryTheory.Quotient.functor input.schema.pathRelation).map
                (Quiver.Hom.toPath edge) := by
        exact (CategoryTheory.Quotient.functor input.schema.pathRelation).map_comp
          path (Quiver.Hom.toPath edge)
      rw [hquotient, X.toFunctor.map_comp]
      rfl

/-- Every independently supplied protocol realization discharges the full AAT
relation/observation equation system from quotient soundness and naturality. -/
theorem protocolRealization_equationLawful {input : ProtocolFamilyInput.{u}}
    (X : ProtocolRealization input.schema input.observation) :
    (protocolLawEquationSystem input X.toLawData).EquationLawful
      (protocolRawLawObject input X.toLawData) := by
  apply (protocolEquationLawful_iff input X.toLawData).mpr
  constructor
  · intro r state
    change input.schema.evaluatePath X.edgeAction (input.schema.relationLeft r) state =
      input.schema.evaluatePath X.edgeAction (input.schema.relationRight r) state
    rw [protocolEvaluatePath_eq_pathAction, protocolEvaluatePath_eq_pathAction]
    exact DFunLike.congr_fun
      (congrArg X.toFunctor.map (input.schema.relation_sound r)) state
  · intro source target edge state
    exact DFunLike.congr_fun
      (NatTrans.naturality X.observation (input.schema.edgeMorphism edge)).symm state

/-- Along every arbitrary observation-preserving protocol morphism, the
constructed AAT relation/observation lawfulness is preserved and reflected.
The morphism need not be invertible or lie in a decoder image. -/
theorem protocolHom_equationLawful_iff {input : ProtocolFamilyInput.{u}}
    {X Y : ProtocolRealization input.schema input.observation} (_f : X ⟶ Y) :
    (protocolLawEquationSystem input X.toLawData).EquationLawful
        (protocolRawLawObject input X.toLawData) ↔
      (protocolLawEquationSystem input Y.toLawData).EquationLawful
        (protocolRawLawObject input Y.toLawData) :=
  ⟨fun _ => protocolRealization_equationLawful Y,
    fun _ => protocolRealization_equationLawful X⟩

#assert_standard_axioms_only AAT.AG.RealizationReconstruction

end AAT.AG.RealizationReconstruction
