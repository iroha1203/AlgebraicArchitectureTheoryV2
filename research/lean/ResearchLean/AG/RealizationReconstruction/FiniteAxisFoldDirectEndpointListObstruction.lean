import ResearchLean.AG.RealizationReconstruction.FiniteAxisFoldArbitraryCarrierNormalForm
import ResearchLean.AG.RealizationReconstruction.MandatoryCFiniteReferenceObstruction
import Formal.Util.AssertStandardAxioms

/-!
# A list-code obstruction at the fixed actual direct endpoint

The fixed finite-axis-fold input contains a faithful actual direct-endpoint
action of `Equiv.Perm E` for every carrier `E`, without a finiteness assumption.
Taking small `E = List A × Bool` with `A : Type`, every Boolean predicate on finite `A`-reference
lists gives a distinct fiberwise toggle and hence a distinct actual endpoint
automorphism.  Cantor diagonalization then proves that no decoder whose whole
code type is `List A` can be surjective onto all actual direct automorphisms.

The same conclusion holds for any small code type generated by a surjective map from
`List A`.  This is a reusable obstruction for a proposed Type-0 finite-reference
grammar.  It is not by itself a refutation of G-123: applying it to every syntax
allowed by the parameter-relative target still requires an exhaustive theorem
that all legal primitive roles and finitary constructors, including any
higher-universe syntax data, are covered by such a small list-generated code,
without placing a completed semantic map in `A`.
-/

namespace AAT.AG.RealizationReconstruction

open CategoryTheory AtomFoundation DoctrineFiberProduct GeometryTransport
open CrossStageCoherence TransportCoherence FullGeometryNormalization

noncomputable section

universe u v

set_option synthInstance.maxHeartbeats 200000
set_option maxHeartbeats 1200000

local instance finiteAxisFoldDirectEndpointListObstructionAtomDecidableEq :
    DecidableEq FiniteModel.carrier.Atom := by
  change DecidableEq FiniteModel.FiniteAtom
  infer_instance

/-- The arbitrary-carrier section into the fixed normalized local-fiber kernel
is faithful without a `Fintype E` assumption. -/
theorem finiteAxisFoldNormalizedPermutationLocalFiberKernelSectionHom_injective_arbitrary
    (E : Type) :
    Function.Injective
      (finiteAxisFoldNormalizedPermutationLocalFiberKernelSectionHom E) := by
  intro first second equality
  apply finiteAxisFoldArbitraryCarrierBackwardAction_injective_forCarrier E
  change MulOpposite.op
      (finiteAxisFoldTransportedSourceContextPermutation first⁻¹) =
    MulOpposite.op
      (finiteAxisFoldTransportedSourceContextPermutation second⁻¹)
  rw [← finiteAxisFoldNormalizedPermutationLocalFiberKernelSectionHom_backwardProjection
      first,
    ← finiteAxisFoldNormalizedPermutationLocalFiberKernelSectionHom_backwardProjection
      second,
    equality]

/-- Consequently the source-generated permutation section is already faithful
at the actual direct endpoint, before normalization. -/
theorem finiteAxisFoldActualDirectPermutationGeometrySectionHom_injective_arbitrary
    (E : Type) :
    Function.Injective
      (finiteAxisFoldActualDirectPermutationGeometrySectionHom E) := by
  intro first second equality
  apply
    finiteAxisFoldNormalizedPermutationLocalFiberKernelSectionHom_injective_arbitrary
      E
  apply Subtype.ext
  apply Subtype.ext
  apply Subtype.ext
  apply Subtype.ext
  exact congrArg
    (fun actual =>
      (geometryNormalizationFunctor.{0, 0} FiniteModel.carrier).mapIso
        (finiteAxisFoldActualDirectAdmissibleAutomorphismHom actual))
    equality

/-- Package the arbitrary-carrier section in the independently fixed
admissible direct endpoint used by the comparison evaluator. -/
noncomputable def finiteAxisFoldActualDirectAdmissiblePermutationSectionHom
    (E : Type) :
    Equiv.Perm E →* Aut finiteAxisFoldActualDirectAdmissibleGeometry :=
  finiteAxisFoldActualDirectAdmissibleAutomorphismHom.comp
    (finiteAxisFoldActualDirectPermutationGeometrySectionHom E)

/-- Admissible packaging preserves the arbitrary-carrier faithfulness. -/
theorem finiteAxisFoldActualDirectAdmissiblePermutationSectionHom_injective
    (E : Type) :
    Function.Injective
      (finiteAxisFoldActualDirectAdmissiblePermutationSectionHom E) := by
  intro first second equality
  apply finiteAxisFoldActualDirectPermutationGeometrySectionHom_injective_arbitrary
    E
  apply Iso.ext
  apply CategoryTheory.Functor.Fiber.hom_ext
  exact congrArg
    (fun automorphism : Aut finiteAxisFoldActualDirectAdmissibleGeometry =>
      automorphism.hom.hom)
    equality

/-- A Boolean predicate on words toggles the Boolean fiber independently over
each word.  The formula is its own inverse and contains no semantic endpoint
automorphism. -/
def finiteAxisFoldListPredicateToggle {A : Type}
    (choice : List A → Bool) : Equiv.Perm (List A × Bool) where
  toFun value := (value.1, xor value.2 (choice value.1))
  invFun value := (value.1, xor value.2 (choice value.1))
  left_inv value := by
    rcases value with ⟨word, bit⟩
    simp
  right_inv value := by
    rcases value with ⟨word, bit⟩
    simp

/-- Distinct predicates give distinct primitive fiber toggles. -/
theorem finiteAxisFoldListPredicateToggle_injective {A : Type} :
    Function.Injective
      (finiteAxisFoldListPredicateToggle (A := A)) := by
  intro first second equality
  funext word
  have pointEquality := congrArg
    (fun permutation : Equiv.Perm (List A × Bool) =>
      (permutation (word, false)).2)
    equality
  simpa [finiteAxisFoldListPredicateToggle] using pointEquality

/-- Every predicate on finite `A`-reference lists therefore determines a
distinct automorphism of the fixed actual direct endpoint. -/
noncomputable def finiteAxisFoldListChoiceActualDirectAut {A : Type} :
    (List A → Bool) →
      Aut finiteAxisFoldActualDirectAdmissibleGeometry :=
  fun choice =>
    finiteAxisFoldActualDirectAdmissiblePermutationSectionHom (List A × Bool)
      (finiteAxisFoldListPredicateToggle choice)

/-- The actual direct-endpoint predicate family is faithful. -/
theorem finiteAxisFoldListChoiceActualDirectAut_injective {A : Type} :
    Function.Injective
      (finiteAxisFoldListChoiceActualDirectAut (A := A)) :=
  (finiteAxisFoldActualDirectAdmissiblePermutationSectionHom_injective
      (List A × Bool)).comp
    finiteAxisFoldListPredicateToggle_injective

/-- Generic diagonal transfer: if all Boolean choices on an index type embed
in a semantic target, that target cannot be enumerated by the same index. -/
theorem not_surjective_of_choice_embedding
    {Index : Type u} {Target : Type v}
    (embedding : (Index → Bool) → Target)
    (injective : Function.Injective embedding)
    (decode : Index → Target) :
    ¬ Function.Surjective decode := by
  intro surjective
  let readback : Target → (Index → Bool) := Function.invFun embedding
  let enumeration : Index → (Index → Bool) := readback ∘ decode
  apply objects_not_surjective_choices enumeration
  intro choice
  obtain ⟨index, equality⟩ := surjective (embedding choice)
  refine ⟨index, ?_⟩
  change Function.invFun embedding (decode index) = choice
  rw [equality]
  exact Function.leftInverse_invFun injective choice

/-- No decoder from finite lists over any small reference alphabet reaches every
automorphism of the fixed actual direct endpoint. -/
theorem finiteAxisFoldActualDirectAut_not_listEnumerable
    {A : Type}
    (decode : List A →
      Aut finiteAxisFoldActualDirectAdmissibleGeometry) :
    ¬ Function.Surjective decode :=
  not_surjective_of_choice_embedding
    finiteAxisFoldListChoiceActualDirectAut
    finiteAxisFoldListChoiceActualDirectAut_injective
    decode

/-- More generally, a small code type generated by finite `A`-reference lists cannot
decode surjectively onto the fixed actual direct automorphism group. -/
theorem finiteAxisFoldActualDirectAut_not_listGeneratedCodeEnumerable
    {A Code : Type}
    (ofList : List A → Code)
    (ofList_surjective : Function.Surjective ofList)
    (decode : Code →
      Aut finiteAxisFoldActualDirectAdmissibleGeometry) :
    ¬ Function.Surjective decode := by
  intro decode_surjective
  exact finiteAxisFoldActualDirectAut_not_listEnumerable (decode ∘ ofList)
    (decode_surjective.comp ofList_surjective)

end


#assert_standard_axioms_only AAT.AG.RealizationReconstruction

end AAT.AG.RealizationReconstruction
