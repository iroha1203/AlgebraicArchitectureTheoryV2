import ResearchLean.AG.RealizationReconstruction.FiniteAxisFoldFiniteSupportUnionObstruction
import Mathlib.GroupTheory.FreeGroup.Basic
import Formal.Util.AssertStandardAxioms

/-!
# Finite algorithm words on the primitive Nat carrier

Cycle 101 proved that finite words which name only finitely many primitive
values miss the fixed algorithm `n ↦ n xor 1`.  This file enlarges the source
grammar itself.  Its generators are explicit transpositions and one fixed
adjacent-pair algorithm; neither constructor accepts a completed arbitrary
permutation or an actual residual element.

The primitive evaluator image is characterized independently as the subgroup
generated by transpositions and the adjacent-pair algorithm.  Mapping that
subgroup through the already fixed expected backward action and pulling it
back along the faithful actual projection gives an intrinsic actual subgroup.
The word decoder lands in this subgroup and is surjective onto it.  In
particular, the Cycle 101 outside element has a one-generator preimage.

This repairs the explicit Cycle 101 witness but does not claim that the raw
free-word grammar is faithful or that this single Nat algorithm generates the
full actual local-fiber kernel.
-/

namespace AAT.AG.RealizationReconstruction

open CategoryTheory AtomFoundation DoctrineFiberProduct GeometryTransport
open CrossStageCoherence TransportCoherence FullGeometryNormalization
open Subgroup

noncomputable section

set_option synthInstance.maxHeartbeats 200000
set_option maxHeartbeats 1200000

/-- Primitive finite recipes on `Nat`: exchange two named distinct values, or
run the fixed adjacent-pair algorithm. -/
inductive FiniteAxisFoldNatAlgorithmGenerator where
  | swap (left right : Nat) (ne : left ≠ right)
  | adjacent

namespace FiniteAxisFoldNatAlgorithmGenerator

/-- Evaluate one primitive recipe before any actual-geometry decoder. -/
def toPerm : FiniteAxisFoldNatAlgorithmGenerator → Equiv.Perm Nat
  | .swap left right _ => Equiv.swap left right
  | .adjacent => finiteAxisFoldNatAdjacentSwap

/-- The generator range is characterized without reference to the actual
decoder: a primitive generator is either a transposition or the fixed
adjacent-pair algorithm. -/
theorem range_toPerm :
    Set.range toPerm =
      {permutation : Equiv.Perm Nat |
        permutation.IsSwap ∨ permutation = finiteAxisFoldNatAdjacentSwap} := by
  ext permutation
  constructor
  · rintro ⟨generator, rfl⟩
    cases generator with
    | swap left right ne =>
        exact Or.inl (Equiv.Perm.swap_isSwap_iff.mpr ne)
    | adjacent => exact Or.inr rfl
  · rintro (isSwap | rfl)
    · obtain ⟨left, right, ne, rfl⟩ := isSwap
      exact ⟨.swap left right ne, rfl⟩
    · exact ⟨.adjacent, rfl⟩

end FiniteAxisFoldNatAlgorithmGenerator

/-- Independent finite words in the explicit Nat recipes. -/
abbrev FiniteAxisFoldNatAlgorithmWord :=
  FreeGroup FiniteAxisFoldNatAlgorithmGenerator

/-- Primitive evaluation of a finite algorithm word. -/
noncomputable def finiteAxisFoldNatAlgorithmWordPermutation :
    FiniteAxisFoldNatAlgorithmWord →* Equiv.Perm Nat :=
  FreeGroup.lift FiniteAxisFoldNatAlgorithmGenerator.toPerm

/-- Decoder-independent primitive subgroup generated by transpositions and
the fixed adjacent-pair algorithm. -/
def finiteAxisFoldNatAlgorithmPermutationSubgroup :
    Subgroup (Equiv.Perm Nat) :=
  Subgroup.closure
    {permutation : Equiv.Perm Nat |
      permutation.IsSwap ∨ permutation = finiteAxisFoldNatAdjacentSwap}

/-- Exact primitive image of the independent finite algorithm words. -/
theorem finiteAxisFoldNatAlgorithmWordPermutation_range :
    finiteAxisFoldNatAlgorithmWordPermutation.range =
      finiteAxisFoldNatAlgorithmPermutationSubgroup := by
  rw [finiteAxisFoldNatAlgorithmWordPermutation,
    FreeGroup.range_lift_eq_closure,
    FiniteAxisFoldNatAlgorithmGenerator.range_toPerm]
  rfl

/-- Actual subgroup whose complete backward action is induced by the
independently generated primitive Nat subgroup. -/
noncomputable def FiniteAxisFoldNatAlgorithmWordIntrinsicImage :
    Subgroup FiniteAxisFoldResidualLocalFiberKernel :=
  (Subgroup.map (finiteAxisFoldArbitraryCarrierBackwardAction Nat)
      finiteAxisFoldNatAlgorithmPermutationSubgroup).comap
    finiteAxisFoldResidualLocalFiberKernelBackwardProjection

/-- Intrinsic membership refers to the primitive generated subgroup and the
independent expected action, not to decoder range. -/
theorem finiteAxisFoldNatAlgorithmWordIntrinsicImage_mem_iff
    (remainder : FiniteAxisFoldResidualLocalFiberKernel) :
    remainder ∈ FiniteAxisFoldNatAlgorithmWordIntrinsicImage ↔
      ∃ permutation : Equiv.Perm Nat,
        permutation ∈ finiteAxisFoldNatAlgorithmPermutationSubgroup ∧
        finiteAxisFoldResidualLocalFiberKernelBackwardProjection remainder =
          finiteAxisFoldArbitraryCarrierBackwardAction Nat permutation := by
  rw [FiniteAxisFoldNatAlgorithmWordIntrinsicImage, Subgroup.mem_comap,
    Subgroup.mem_map]
  constructor
  · rintro ⟨permutation, membership, actionEquality⟩
    exact ⟨permutation, membership, actionEquality.symm⟩
  · rintro ⟨permutation, membership, actionEquality⟩
    exact ⟨permutation, membership, actionEquality.symm⟩

/-- Decode an independent Nat algorithm word through the same fixed actual
local-fiber-kernel section. -/
noncomputable def finiteAxisFoldNatAlgorithmWordDecoder :
    FiniteAxisFoldNatAlgorithmWord →*
      FiniteAxisFoldResidualLocalFiberKernel :=
  (finiteAxisFoldNormalizedPermutationLocalFiberKernelSectionHom Nat).comp
    finiteAxisFoldNatAlgorithmWordPermutation

/-- Projection of the word decoder is the independently defined expected
backward action. -/
theorem finiteAxisFoldNatAlgorithmWordDecoder_backwardProjection
    (word : FiniteAxisFoldNatAlgorithmWord) :
    finiteAxisFoldResidualLocalFiberKernelBackwardProjection
        (finiteAxisFoldNatAlgorithmWordDecoder word) =
      finiteAxisFoldArbitraryCarrierBackwardAction Nat
        (finiteAxisFoldNatAlgorithmWordPermutation word) := by
  exact
    finiteAxisFoldNormalizedPermutationLocalFiberKernelSectionHom_backwardProjection
      (finiteAxisFoldNatAlgorithmWordPermutation word)

/-- The word decoder lands in the independently characterized actual image. -/
noncomputable def finiteAxisFoldNatAlgorithmWordIntrinsicDecoder :
    FiniteAxisFoldNatAlgorithmWord →*
      FiniteAxisFoldNatAlgorithmWordIntrinsicImage :=
  finiteAxisFoldNatAlgorithmWordDecoder.codRestrict
    FiniteAxisFoldNatAlgorithmWordIntrinsicImage
    (fun word => by
      rw [finiteAxisFoldNatAlgorithmWordIntrinsicImage_mem_iff]
      refine ⟨finiteAxisFoldNatAlgorithmWordPermutation word, ?_, ?_⟩
      · rw [← finiteAxisFoldNatAlgorithmWordPermutation_range]
        exact ⟨word, rfl⟩
      · exact finiteAxisFoldNatAlgorithmWordDecoder_backwardProjection word)

/-- Every actual element satisfying the intrinsic generated-action condition
has an independent finite algorithm-word preimage. -/
theorem finiteAxisFoldNatAlgorithmWordIntrinsicDecoder_surjective :
    Function.Surjective finiteAxisFoldNatAlgorithmWordIntrinsicDecoder := by
  intro remainder
  obtain ⟨permutation, membership, actionEquality⟩ :=
    (finiteAxisFoldNatAlgorithmWordIntrinsicImage_mem_iff remainder.1).mp
      remainder.2
  rw [← finiteAxisFoldNatAlgorithmWordPermutation_range] at membership
  obtain ⟨word, wordEquality⟩ := membership
  refine ⟨word, ?_⟩
  apply Subtype.ext
  apply finiteAxisFoldResidualLocalFiberKernelBackwardProjection_injective
  change finiteAxisFoldResidualLocalFiberKernelBackwardProjection
      (finiteAxisFoldNatAlgorithmWordDecoder word) =
    finiteAxisFoldResidualLocalFiberKernelBackwardProjection remainder.1
  rw [finiteAxisFoldNatAlgorithmWordDecoder_backwardProjection, wordEquality]
  exact actionEquality.symm

/-- Exact decoder-range theorem, derived after the intrinsic image and
surjectivity proof. -/
theorem finiteAxisFoldNatAlgorithmWordIntrinsicImage_mem_iff_decoder
    (remainder : FiniteAxisFoldResidualLocalFiberKernel) :
    remainder ∈ FiniteAxisFoldNatAlgorithmWordIntrinsicImage ↔
      ∃ word : FiniteAxisFoldNatAlgorithmWord,
        finiteAxisFoldNatAlgorithmWordDecoder word = remainder := by
  constructor
  · intro membership
    let intrinsic : FiniteAxisFoldNatAlgorithmWordIntrinsicImage :=
      ⟨remainder, membership⟩
    obtain ⟨word, equality⟩ :=
      finiteAxisFoldNatAlgorithmWordIntrinsicDecoder_surjective intrinsic
    exact ⟨word, congrArg Subtype.val equality⟩
  · rintro ⟨word, rfl⟩
    exact (finiteAxisFoldNatAlgorithmWordIntrinsicDecoder word).2

/-- The Cycle 101 outside element is repaired by the new source grammar: it
is the decoding of the single explicit `adjacent` generator. -/
theorem finiteAxisFoldNatAdjacentSwap_has_algorithmWordPreimage :
    finiteAxisFoldNatAlgorithmWordDecoder
        (FreeGroup.of FiniteAxisFoldNatAlgorithmGenerator.adjacent) =
      finiteAxisFoldNatAdjacentSwapLocalFiberKernel := by
  change finiteAxisFoldNormalizedPermutationLocalFiberKernelSectionHom Nat
      (finiteAxisFoldNatAlgorithmWordPermutation
        (FreeGroup.of FiniteAxisFoldNatAlgorithmGenerator.adjacent)) =
    finiteAxisFoldNormalizedPermutationLocalFiberKernelSectionHom Nat
      finiteAxisFoldNatAdjacentSwap
  simp [finiteAxisFoldNatAlgorithmWordPermutation,
    FiniteAxisFoldNatAlgorithmGenerator.toPerm]

#assert_standard_axioms_only AAT.AG.RealizationReconstruction

end

end AAT.AG.RealizationReconstruction
