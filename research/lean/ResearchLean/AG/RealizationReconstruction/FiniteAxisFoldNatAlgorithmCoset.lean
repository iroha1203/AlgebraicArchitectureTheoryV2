import ResearchLean.AG.RealizationReconstruction.FiniteAxisFoldNatAlgorithmWordImage
import Formal.Util.AssertStandardAxioms

/-!
# Two-coset structure of the Nat algorithm image

Cycle 102 described the primitive image as the subgroup generated by all
transpositions and the fixed adjacent-pair algorithm.  This file removes that
opaque closure description.  The finite-support subgroup is normalized by the
adjacent algorithm, and the generated subgroup consists exactly of a
finite-support permutation or the adjacent algorithm followed by one.

This two-coset theorem is source-side structure, proved before the actual
decoder.  It supplies the algebraic input needed for a later faithful quotient
or canonical normal form; it is not itself such a quotient.
-/

namespace AAT.AG.RealizationReconstruction

open CategoryTheory AtomFoundation DoctrineFiberProduct GeometryTransport
open CrossStageCoherence TransportCoherence FullGeometryNormalization
open MulAction Set Subgroup

noncomputable section

set_option synthInstance.maxHeartbeats 200000
set_option maxHeartbeats 1200000

private abbrev FiniteAxisFoldNatFiniteSupportSubgroup :=
  finiteAxisFoldFiniteSupportPermutationSubgroup Nat

private abbrev finiteAxisFoldNatAdjacent := finiteAxisFoldNatAdjacentSwap

@[simp] theorem finiteAxisFoldNatAdjacent_apply_twice (atom : Nat) :
    finiteAxisFoldNatAdjacentSwap
        (finiteAxisFoldNatAdjacentSwap atom) = atom := by
  exact Nat.xor_xor_cancel_right atom 1

@[simp] theorem finiteAxisFoldNatAdjacent_mul_self :
    finiteAxisFoldNatAdjacentSwap * finiteAxisFoldNatAdjacentSwap = 1 := by
  apply Equiv.ext
  intro atom
  exact finiteAxisFoldNatAdjacent_apply_twice atom

/-- Conjugation by the adjacent-pair algorithm preserves finite support.  The
proof sends every moved point of the conjugate into the adjacent image of the
original finite moved set. -/
theorem finiteAxisFoldNatAdjacent_conj_mem_finiteSupport
    {permutation : Equiv.Perm Nat}
    (membership : permutation ∈ FiniteAxisFoldNatFiniteSupportSubgroup) :
    finiteAxisFoldNatAdjacent * permutation * finiteAxisFoldNatAdjacent ∈
      FiniteAxisFoldNatFiniteSupportSubgroup := by
  rw [finiteAxisFoldFiniteSupportPermutationSubgroup_mem_iff] at membership ⊢
  apply (membership.image finiteAxisFoldNatAdjacent).subset
  intro atom moved
  refine ⟨finiteAxisFoldNatAdjacent atom, ?_, ?_⟩
  · simp only [Set.mem_compl_iff, mem_fixedBy] at moved ⊢
    intro fixed
    apply moved
    change finiteAxisFoldNatAdjacent
        (permutation (finiteAxisFoldNatAdjacent atom)) = atom
    change permutation (finiteAxisFoldNatAdjacent atom) =
      finiteAxisFoldNatAdjacent atom at fixed
    rw [fixed]
    exact finiteAxisFoldNatAdjacent_apply_twice atom
  · exact finiteAxisFoldNatAdjacent_apply_twice atom

/-- Candidate readable source subgroup: the finite-support subgroup together
with its adjacent left coset. -/
def finiteAxisFoldNatAlgorithmCosetSubgroup :
    Subgroup (Equiv.Perm Nat) where
  carrier := {permutation |
    permutation ∈ FiniteAxisFoldNatFiniteSupportSubgroup ∨
      finiteAxisFoldNatAdjacent * permutation ∈
        FiniteAxisFoldNatFiniteSupportSubgroup}
  one_mem' := Or.inl FiniteAxisFoldNatFiniteSupportSubgroup.one_mem
  mul_mem' := by
    intro first second firstMembership secondMembership
    rcases firstMembership with firstFinite | firstAdjacentFinite
    · rcases secondMembership with secondFinite | secondAdjacentFinite
      · exact Or.inl
          (FiniteAxisFoldNatFiniteSupportSubgroup.mul_mem
            firstFinite secondFinite)
      · apply Or.inr
        rw [show finiteAxisFoldNatAdjacent * (first * second) =
            (finiteAxisFoldNatAdjacent * first * finiteAxisFoldNatAdjacent) *
              (finiteAxisFoldNatAdjacent * second) by
          ext atom
          simp]
        exact FiniteAxisFoldNatFiniteSupportSubgroup.mul_mem
          (finiteAxisFoldNatAdjacent_conj_mem_finiteSupport firstFinite)
          secondAdjacentFinite
    · rcases secondMembership with secondFinite | secondAdjacentFinite
      · apply Or.inr
        rw [← mul_assoc]
        exact FiniteAxisFoldNatFiniteSupportSubgroup.mul_mem
          firstAdjacentFinite secondFinite
      · apply Or.inl
        rw [show first * second =
            (finiteAxisFoldNatAdjacent *
                (finiteAxisFoldNatAdjacent * first) *
                finiteAxisFoldNatAdjacent) *
              (finiteAxisFoldNatAdjacent * second) by
          ext atom
          simp]
        exact FiniteAxisFoldNatFiniteSupportSubgroup.mul_mem
          (finiteAxisFoldNatAdjacent_conj_mem_finiteSupport
            firstAdjacentFinite)
          secondAdjacentFinite
  inv_mem' := by
    intro permutation membership
    rcases membership with finite | adjacentFinite
    · exact Or.inl (FiniteAxisFoldNatFiniteSupportSubgroup.inv_mem finite)
    · apply Or.inr
      have conjugated := finiteAxisFoldNatAdjacent_conj_mem_finiteSupport
        (FiniteAxisFoldNatFiniteSupportSubgroup.inv_mem adjacentFinite)
      simpa [mul_assoc] using conjugated

/-- The independent algorithm-word primitive subgroup has exactly two
finite-support cosets. -/
theorem finiteAxisFoldNatAlgorithmPermutationSubgroup_eq_cosetSubgroup :
    finiteAxisFoldNatAlgorithmPermutationSubgroup =
      finiteAxisFoldNatAlgorithmCosetSubgroup := by
  apply le_antisymm
  · rw [finiteAxisFoldNatAlgorithmPermutationSubgroup, closure_le]
    intro permutation generator
    rcases generator with isSwap | rfl
    · exact Or.inl
        ((finiteAxisFoldFiniteSupportPermutationSubgroup_mem_iff permutation).2
          (mem_closure_isSwap'.1 (Subgroup.subset_closure isSwap)))
    · exact Or.inr (by simp)
  · intro permutation membership
    have finiteSupport_le_algorithm :
        FiniteAxisFoldNatFiniteSupportSubgroup ≤
          finiteAxisFoldNatAlgorithmPermutationSubgroup := by
      apply Subgroup.closure_mono
      intro swap isSwap
      exact Or.inl isSwap
    have adjacent_mem_algorithm :
        finiteAxisFoldNatAdjacent ∈
          finiteAxisFoldNatAlgorithmPermutationSubgroup :=
      Subgroup.subset_closure (Or.inr rfl)
    rcases membership with finite | adjacentFinite
    · exact finiteSupport_le_algorithm finite
    · have productMembership :=
        finiteAxisFoldNatAlgorithmPermutationSubgroup.mul_mem
          adjacent_mem_algorithm
          (finiteSupport_le_algorithm adjacentFinite)
      simpa [← mul_assoc] using productMembership

/-- Readable source membership: an algorithm-word permutation is either
finite-support, or becomes finite-support after left multiplication by the
fixed adjacent algorithm. -/
theorem finiteAxisFoldNatAlgorithmPermutationSubgroup_mem_iff_coset
    (permutation : Equiv.Perm Nat) :
    permutation ∈ finiteAxisFoldNatAlgorithmPermutationSubgroup ↔
      (fixedBy Nat permutation)ᶜ.Finite ∨
      (fixedBy Nat (finiteAxisFoldNatAdjacentSwap * permutation))ᶜ.Finite := by
  rw [finiteAxisFoldNatAlgorithmPermutationSubgroup_eq_cosetSubgroup]
  change
    (permutation ∈ FiniteAxisFoldNatFiniteSupportSubgroup ∨
      finiteAxisFoldNatAdjacent * permutation ∈
        FiniteAxisFoldNatFiniteSupportSubgroup) ↔ _
  rw [finiteAxisFoldFiniteSupportPermutationSubgroup_mem_iff,
    finiteAxisFoldFiniteSupportPermutationSubgroup_mem_iff]

/-- Actual intrinsic membership now has the same readable two-coset source
classification rather than only a closure-generated witness. -/
theorem finiteAxisFoldNatAlgorithmWordIntrinsicImage_mem_iff_coset
    (remainder : FiniteAxisFoldResidualLocalFiberKernel) :
    remainder ∈ FiniteAxisFoldNatAlgorithmWordIntrinsicImage ↔
      ∃ permutation : Equiv.Perm Nat,
        ((fixedBy Nat permutation)ᶜ.Finite ∨
          (fixedBy Nat
            (finiteAxisFoldNatAdjacentSwap * permutation))ᶜ.Finite) ∧
        finiteAxisFoldResidualLocalFiberKernelBackwardProjection remainder =
          finiteAxisFoldArbitraryCarrierBackwardAction Nat permutation := by
  rw [finiteAxisFoldNatAlgorithmWordIntrinsicImage_mem_iff]
  constructor
  · rintro ⟨permutation, membership, actionEquality⟩
    exact ⟨permutation,
      (finiteAxisFoldNatAlgorithmPermutationSubgroup_mem_iff_coset
        permutation).1 membership,
      actionEquality⟩
  · rintro ⟨permutation, membership, actionEquality⟩
    exact ⟨permutation,
      (finiteAxisFoldNatAlgorithmPermutationSubgroup_mem_iff_coset
        permutation).2 membership,
      actionEquality⟩

#assert_standard_axioms_only AAT.AG.RealizationReconstruction

end

end AAT.AG.RealizationReconstruction
