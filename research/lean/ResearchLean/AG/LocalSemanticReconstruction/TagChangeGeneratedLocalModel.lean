import ResearchLean.AG.LocalSemanticReconstruction.TagChangeGeneratedNormalForm
import Formal.Util.AssertStandardAxioms

/-!
# Finite-local model of the tagged generated endomorphism monoid

Cycle 36 classified the actual endomorphisms generated by arbitrary tagged
source choices and canonical normalization.  This module replaces each global
choice in that normal form by its coherent family of finite Bool tables.  A
local section contains only a finite normalization flag and one finite table
at every finite index, with primitive restriction equations between tables.

Canonical restriction of a choice is implemented directly on finite tables:
the table on `S` is read from the old table on the finite image of `S` under
object normalization.  The resulting componentwise multiplication is proved
equivalent to the actual generated endomorphism monoid.  No global choice or
completed ambient morphism is stored in an individual local value.
-/

namespace AAT.AG.LocalSemanticReconstruction

open CategoryTheory AtomFoundation DoctrineFiberProduct
open AAT.AG.RealizationReconstruction

namespace TagChangeGeneratedLocalModel

noncomputable section

open TagChangeKaroubiReconstruction
open TagChangeNormalizedChoiceKernel
open TagChangeGeneratedNormalForm

abbrev Index := TagChange.TaggedArchitectureIndex

/-- At one finite index, the local value is a normalization bit and a finite
Bool table. -/
abbrev LocalValue (S : Finset Index) := Bool × TagChange.LocalTagTable S

/-- Every local value is finite. -/
theorem localValue_finite (S : Finset Index) : Finite (LocalValue S) := by
  letI := TagChange.LocalTagTable.finite_value_type S
  infer_instance

/-- Restrict a local value along inclusion of finite indices. -/
def restrict {S T : Finset Index} (h : S ⊆ T) : LocalValue T → LocalValue S
  | (normalized, table) =>
      (normalized, TagChange.LocalTagTable.restrict h table)

/-- A local section contains a finite flag and an independently defined
coherent family of finite Bool tables. -/
structure LocalSection where
  /-- Whether the represented word contains canonical normalization. -/
  normalized : Bool
  /-- Compatible finite tables, without a stored global choice. -/
  family : TagChange.CoherentFamily Index

/-- Read one finite component of a local section. -/
def value (localSection : LocalSection) (S : Finset Index) : LocalValue S :=
  (localSection.normalized, localSection.family.value S)

/-- Section values obey primitive restriction. -/
theorem value_restrict (localSection : LocalSection) {S T : Finset Index}
    (h : S ⊆ T) :
    restrict h (value localSection T) = value localSection S := by
  apply Prod.ext
  · rfl
  · exact localSection.family.coherent S T h

/-- Local sections are determined by all finite local values. -/
@[ext]
theorem LocalSection.ext {first second : LocalSection}
    (equality : ∀ S, value first S = value second S) : first = second := by
  cases first with
  | mk firstNormalized firstFamily =>
      cases second with
      | mk secondNormalized secondFamily =>
          have atEmpty := equality ∅
          have normalizedEquality : firstNormalized = secondNormalized :=
            congrArg Prod.fst atEmpty
          subst secondNormalized
          have familyEquality : firstFamily = secondFamily := by
            apply TagChange.CoherentFamily.ext
            intro S
            exact congrArg Prod.snd (equality S)
          subst secondFamily
          rfl

/-- Canonical restriction computed only from finite image tables. -/
noncomputable def normalizeFamily
    (family : TagChange.CoherentFamily Index) :
    TagChange.CoherentFamily Index := by
  classical
  exact
    { value := fun S source =>
        family.value
          (S.image (canonicalObjectNormalization taggedOperationPackage))
          ⟨canonicalObjectNormalization taggedOperationPackage source.1,
            Finset.mem_image.mpr ⟨source.1, source.2, rfl⟩⟩
      coherent := by
        intro S T h
        funext source
        let normalization := canonicalObjectNormalization taggedOperationPackage
        have imageInclusion : S.image normalization ⊆ T.image normalization :=
          Finset.image_mono normalization h
        have tableEquality := congrFun
          (family.coherent (S.image normalization) (T.image normalization)
            imageInclusion)
          ⟨normalization source.1,
            Finset.mem_image.mpr ⟨source.1, source.2, rfl⟩⟩
        exact tableEquality }

/-- Finite-image normalization agrees with reading the globally normalized
choice; this theorem verifies the local formula rather than defining it. -/
theorem normalizeFamily_read (choice : Choice) :
    normalizeFamily (TagChange.read choice) =
      TagChange.read (normalizeChoice choice) := by
  apply TagChange.CoherentFamily.ext
  intro S
  funext source
  simp only [normalizeFamily, TagChange.read, TagChange.LocalTagTable.read,
    normalizeChoice]

/-- Read a Cycle 36 normal form into finite-local data. -/
def read : NormalForm → LocalSection
  | .raw choice => ⟨false, TagChange.read choice⟩
  | .normalized choice => ⟨true, TagChange.read choice⟩

/-- Assemble a Cycle 36 normal form from the normalization flag and singleton
assembly of the compatible finite tables. -/
noncomputable def assemble (localSection : LocalSection) : NormalForm :=
  if localSection.normalized then
    .normalized (TagChange.assemble localSection.family)
  else
    .raw (TagChange.assemble localSection.family)

/-- Reading after assembly recovers every finite value. -/
@[simp]
theorem read_assemble (localSection : LocalSection) :
    read (assemble localSection) = localSection := by
  cases localSection with
  | mk normalized family =>
      cases normalized <;> simp [assemble, read]

/-- Assembly after reading recovers the original normal form. -/
@[simp]
theorem assemble_read (form : NormalForm) : assemble (read form) = form := by
  cases form <;> simp [assemble, read]

/-- Cycle 36 normal forms are exactly the finite-local sections. -/
noncomputable def normalFormEquivLocalSection : NormalForm ≃ LocalSection where
  toFun := read
  invFun := assemble
  left_inv := assemble_read
  right_inv := read_assemble

/-- Componentwise categorical-order multiplication of local sections.  Once
the left word contains normalization, the right family is first restricted
through finite normalization images. -/
def multiply (first second : LocalSection) : LocalSection where
  normalized := first.normalized || second.normalized
  family := first.family +
    if first.normalized then normalizeFamily second.family else second.family

/-- Reading preserves the four-case categorical composition table. -/
theorem read_multiply (first second : NormalForm) :
    read (TagChangeGeneratedNormalForm.multiply first second) =
      multiply (read first) (read second) := by
  cases first with
  | raw first =>
      cases second with
      | raw second => rfl
      | normalized second => rfl
  | normalized first =>
      cases second with
      | raw second =>
          apply LocalSection.ext
          intro S
          apply Prod.ext
          · rfl
          · change
              (TagChange.read first +
                TagChange.read (normalizeChoice second)).value S =
              (TagChange.read first +
                normalizeFamily (TagChange.read second)).value S
            exact congrArg
              (fun family => (TagChange.read first + family).value S)
              (normalizeFamily_read second).symm
      | normalized second =>
          apply LocalSection.ext
          intro S
          apply Prod.ext
          · rfl
          · change
              (TagChange.read first +
                TagChange.read (normalizeChoice second)).value S =
              (TagChange.read first +
                normalizeFamily (TagChange.read second)).value S
            exact congrArg
              (fun family => (TagChange.read first + family).value S)
              (normalizeFamily_read second).symm

/-- Assembly preserves componentwise categorical-order multiplication. -/
theorem assemble_multiply (first second : LocalSection) :
    assemble (multiply first second) =
      TagChangeGeneratedNormalForm.multiply (assemble first) (assemble second) := by
  apply normalFormEquivLocalSection.injective
  change read (assemble (multiply first second)) =
    read (TagChangeGeneratedNormalForm.multiply (assemble first) (assemble second))
  rw [read_assemble, read_multiply, read_assemble, read_assemble]

/-- The local identity has a false flag and false at every finite source. -/
def identity : LocalSection := ⟨false, 0⟩

/-- The local sections form the monoid transported from actual normal forms.
As for Cycle 36, multiplication reverses `multiply` to match `End`'s monoid
convention. -/
noncomputable instance : Monoid LocalSection where
  mul first second := multiply second first
  one := identity
  mul_assoc first second third := by
    apply normalFormEquivLocalSection.symm.injective
    change assemble (multiply third (multiply second first)) =
      assemble (multiply (multiply third second) first)
    rw [assemble_multiply, assemble_multiply, assemble_multiply,
      assemble_multiply]
    exact mul_assoc _ _ _
  one_mul localSection := by
    apply normalFormEquivLocalSection.symm.injective
    change assemble (multiply localSection identity) = assemble localSection
    rw [assemble_multiply]
    change TagChangeGeneratedNormalForm.multiply (assemble localSection)
      TagChangeGeneratedNormalForm.identity = assemble localSection
    exact one_mul (assemble localSection)
  mul_one localSection := by
    apply normalFormEquivLocalSection.symm.injective
    change assemble (multiply identity localSection) = assemble localSection
    rw [assemble_multiply]
    change TagChangeGeneratedNormalForm.multiply
      TagChangeGeneratedNormalForm.identity (assemble localSection) = assemble localSection
    exact mul_one (assemble localSection)

/-- Finite-local reading is a monoid equivalence. -/
noncomputable def normalFormMulEquivLocalSection :
    NormalForm ≃* LocalSection where
  toEquiv := normalFormEquivLocalSection
  map_mul' first second := by
    change read (TagChangeGeneratedNormalForm.multiply second first) =
      multiply (read second) (read first)
    exact read_multiply second first

/-- The actual generated tagged endomorphism submonoid is the finite-local
section monoid. -/
noncomputable def actualGeneratedMulEquivLocalSection :
    actualGeneratedSubmonoid ≃* LocalSection :=
  normalFormMulEquivGenerated.symm.trans normalFormMulEquivLocalSection

/-- The Cycle 36 equivalence evaluates a normal form as its actual ambient
endomorphism. -/
@[simp]
theorem normalFormMulEquivGenerated_coe (form : NormalForm) :
    ((normalFormMulEquivGenerated form : actualGeneratedSubmonoid) :
      End TagChangeAmbientCategory.TaggedPackage) =
        evaluate form := by
  rfl

/-- Primitive source-choice readback of an actual generated endomorphism. -/
noncomputable def readActualChoice
    (morphism : actualGeneratedSubmonoid) : Choice :=
  readTaggedSourceChoice morphism.1.hom

/-- Every finite table in the local equivalence is the primitive finite
restriction of actual package readback. -/
theorem actualGeneratedMulEquivLocalSection_value
    (morphism : actualGeneratedSubmonoid) (S : Finset Index) :
    (actualGeneratedMulEquivLocalSection morphism).family.value S =
      TagChange.LocalTagTable.read (readActualChoice morphism) S := by
  let form := normalFormMulEquivGenerated.symm morphism
  have formEquality : normalFormMulEquivGenerated form = morphism :=
    normalFormMulEquivGenerated.apply_symm_apply morphism
  rw [← formEquality]
  change
    (normalFormMulEquivLocalSection
      (normalFormMulEquivGenerated.symm
        (normalFormMulEquivGenerated form))).family.value S = _
  rw [normalFormMulEquivGenerated.symm_apply_apply]
  cases form with
  | raw choice =>
      change (TagChange.read choice).value S =
        TagChange.LocalTagTable.read
          (readTaggedSourceChoice
            (normalFormMulEquivGenerated (.raw choice)).1.hom) S
      rw [normalFormMulEquivGenerated_coe]
      exact congrArg (fun globalChoice =>
        TagChange.LocalTagTable.read globalChoice S)
          (readTaggedSourceChoice_taggedSourceChoiceTotal choice).symm
  | normalized choice =>
      change (TagChange.read choice).value S =
        TagChange.LocalTagTable.read
          (readTaggedSourceChoice
            (normalFormMulEquivGenerated (.normalized choice)).1.hom) S
      rw [normalFormMulEquivGenerated_coe]
      funext source
      exact (congrFun (read_sourceChoice_comp_normalization choice) source.1).symm

/-- All-finite local reading separates actual generated endomorphisms. -/
theorem separates : Function.Injective actualGeneratedMulEquivLocalSection :=
  actualGeneratedMulEquivLocalSection.injective

/-- Every compatible finite-local section assembles to an actual generated
endomorphism. -/
theorem assembles : Function.Surjective actualGeneratedMulEquivLocalSection :=
  actualGeneratedMulEquivLocalSection.surjective

/-- Local multiplication is componentwise: its flag is disjunction and its
finite table is xor after finite-image normalization when required. -/
theorem multiply_value (first second : LocalSection) (S : Finset Index) :
    value (multiply first second) S =
      (first.normalized || second.normalized,
        first.family.value S +
          (if first.normalized then
            (normalizeFamily second.family).value S
          else second.family.value S)) :=
  by
    cases normalized : first.normalized <;>
      simp [value, multiply, normalized]

#assert_standard_axioms_only AAT.AG.LocalSemanticReconstruction.TagChangeGeneratedLocalModel

end

end TagChangeGeneratedLocalModel

end AAT.AG.LocalSemanticReconstruction
