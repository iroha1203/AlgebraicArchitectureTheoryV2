import ResearchLean.AG.LocalSemanticReconstruction.G122DisplayedLiftOrbitLocalModel
import ResearchLean.AG.RealizationReconstruction.FiniteAxisFoldGeneratedLiftFibers
import ResearchLean.AG.RealizationReconstruction.FiniteAxisFoldNormalizedAxisProjection
import Formal.Util.AssertStandardAxioms

/-!
# Six-element local model for normalized G-122 axis comparisons

The primitive permutations of the three signature axes form a six-element
group.  This file maps that finite table group into the actual normalized
comparison group and reconstructs its image by reading the source endpoint's
axis table.  The maps are inverse as a multiplicative equivalence, so the
semantic image has exactly six elements.

For every comparison in this image, the actual canonical section has a unique
primitive axis code whose generated source term evaluates to it.  The same
source-generated canonical lift then serves as the base point for the full
actual restriction-kernel torsor theorem on its lift fiber.

The result concerns only the six-element axis image.  It does not classify
normalized comparisons outside that image, the full comparison group, or the
restriction kernel itself.

## Implementation notes

The semantic codomain is the range of the accepted section hom, while the
local code remains the independent finite table `Equiv.Perm (Fin 3)`.
Reading deliberately projects the actual source endpoint's axis map instead
of unpacking the range-membership witness.  We reject using an actual
normalized comparison as the local value because that would store the
completed semantic morphism that the local model is meant to reconstruct.
The multiplicative equivalence packages the two inverse laws only after this
independent readback has been proved.
-/

namespace AAT.AG.LocalSemanticReconstruction

open CategoryTheory AtomFoundation DoctrineFiberProduct GeometryTransport
open TransportCoherence FullGeometryNormalization
open AAT.AG.RealizationReconstruction
open AAT.AG.RealizationReconstruction.FiniteAxisFoldAxisSwapPresentation
open AAT.AG.RealizationReconstruction.FiniteAxisFoldComparisonRestrictionKernel

namespace G122AxisComparisonLocalModel

noncomputable section

set_option synthInstance.maxHeartbeats 100000
set_option maxHeartbeats 500000

/-- Decidable atom equality for the fixed finite-axis-fold input. -/
local instance axisComparisonAtomDecidableEq :
    DecidableEq FiniteModel.carrier.Atom := by
  change DecidableEq FiniteModel.FiniteAtom
  infer_instance

/-- Assemble a primitive three-axis table into the actual normalized
comparison group. -/
noncomputable def axisComparisonSectionHom :
    Equiv.Perm (Fin 3) →* NormalizedComparison :=
  (generatedArrowComparisonSectionHom
      finiteAxisFoldNormalizedBarAlphaIso).comp
    finiteAxisFoldNormalizedAxisSectionHom

/-- Axis assembly is the accepted normalized comparison constructed from the
same primitive table. -/
theorem axisComparisonSectionHom_apply (permutation : Equiv.Perm (Fin 3)) :
    axisComparisonSectionHom permutation =
      finiteAxisFoldNormalizedComparisonPermutation permutation := by
  apply Subtype.ext
  apply Prod.ext
  · exact finiteAxisFoldNormalizedAxisSectionHom_apply permutation
  · apply Iso.ext
    change finiteAxisFoldNormalizedBarAlphaIso.inv ≫
        (finiteAxisFoldNormalizedAxisSectionHom permutation).hom ≫
        finiteAxisFoldNormalizedBarAlphaIso.hom =
      finiteAxisFoldNormalizedBarAlphaIso.inv ≫
        (finiteAxisFoldNormalizedDirectPermutationAut permutation).hom ≫
        finiteAxisFoldNormalizedBarAlphaIso.hom
    rw [finiteAxisFoldNormalizedAxisSectionHom_apply]

/-- The actual normalized comparison subgroup generated by primitive axis
tables. -/
noncomputable abbrev AxisComparisonImage :=
  MonoidHom.range axisComparisonSectionHom

/-- Assemble a primitive axis table into the six-element semantic image. -/
noncomputable def assembleAxis (permutation : Equiv.Perm (Fin 3)) :
  AxisComparisonImage :=
  ⟨axisComparisonSectionHom permutation,
    ⟨permutation, rfl⟩⟩

/-- Read only the source endpoint's primitive axis table. -/
noncomputable def readAxis (comparison : AxisComparisonImage) :
    Equiv.Perm (Fin 3) :=
  finiteAxisFoldNormalizedAxisProjection
    (generatedArrowComparisonSourceHom
      finiteAxisFoldNormalizedBarAlphaIso.hom comparison.1)

/-- Primitive reading after axis assembly is the identity. -/
@[simp] theorem readAxis_assembleAxis (permutation : Equiv.Perm (Fin 3)) :
    readAxis (assembleAxis permutation) = permutation := by
  change finiteAxisFoldNormalizedAxisProjection
      (finiteAxisFoldNormalizedAxisSectionHom permutation) = permutation
  exact finiteAxisFoldNormalizedAxisProjection_section permutation

/-- Axis assembly after primitive reading recovers every semantic image
element. -/
@[simp] theorem assembleAxis_readAxis (comparison : AxisComparisonImage) :
    assembleAxis (readAxis comparison) = comparison := by
  rcases comparison with ⟨comparison, permutation, equality⟩
  subst comparison
  apply Subtype.ext
  change axisComparisonSectionHom
      (readAxis (assembleAxis permutation)) =
    axisComparisonSectionHom permutation
  rw [readAxis_assembleAxis]

/-- Multiplicative equivalence between primitive three-axis tables and their
actual normalized comparison image. -/
noncomputable def axisComparisonMulEquiv :
    Equiv.Perm (Fin 3) ≃* AxisComparisonImage where
  toFun := assembleAxis
  invFun := readAxis
  left_inv := readAxis_assembleAxis
  right_inv := assembleAxis_readAxis
  map_mul' first second := by
    apply Subtype.ext
    exact map_mul axisComparisonSectionHom first second

/-- The six-element semantic image inherits finiteness from its primitive
axis-table model. -/
noncomputable instance axisComparisonImageFintype :
    Fintype AxisComparisonImage :=
  Fintype.ofEquiv (Equiv.Perm (Fin 3)) axisComparisonMulEquiv.toEquiv

/-- The semantic axis-comparison image has all six primitive permutations. -/
theorem axisComparisonImage_card : Fintype.card AxisComparisonImage = 6 := by
  rw [Fintype.card_congr axisComparisonMulEquiv.toEquiv.symm]
  decide

/-- The actual canonical lift over one represented normalized comparison. -/
noncomputable def canonicalLift (comparison : AxisComparisonImage) :
    AuthoredExactCanonicalComparisonLiftFiber
      finiteAxisFoldBCDatumSquare
      (Discrete.mk DoubleDiamondTwoCell.second)
      Int
      (finiteAxisFoldFixedCoefficientGeometryFamily
        (Discrete.mk DoubleDiamondTwoCell.second))
      finiteCanonicalObjectNormalization_admissible comparison.1 :=
  ⟨authoredExactCanonicalComparisonSectionHom
      finiteAxisFoldBCDatumSquare
      (Discrete.mk DoubleDiamondTwoCell.second)
      Int
      (finiteAxisFoldFixedCoefficientGeometryFamily
        (Discrete.mk DoubleDiamondTwoCell.second))
      finiteCanonicalObjectNormalization_admissible comparison.1,
    authoredExactCanonicalComparisonSection_rightInverse
      finiteAxisFoldBCDatumSquare
      (Discrete.mk DoubleDiamondTwoCell.second)
      Int
      (finiteAxisFoldFixedCoefficientGeometryFamily
        (Discrete.mk DoubleDiamondTwoCell.second))
      finiteCanonicalObjectNormalization_admissible comparison.1⟩

/-- Every represented canonical section is evaluated by one and only one
primitive axis code. -/
theorem canonicalSection_unique_axisCode (comparison : AxisComparisonImage) :
    ∃! permutation : Equiv.Perm (Fin 3),
      FiniteAxisFoldAxisSwapPresentation.comparisonEvaluationHom
          (sectionedAxisPermutationComparisonElement permutation) =
        (canonicalLift comparison).1 := by
  refine ⟨readAxis comparison, ?_, ?_⟩
  · change FiniteAxisFoldAxisSwapPresentation.comparisonEvaluationHom
        (sectionedAxisPermutationComparisonElement (readAxis comparison)) =
      authoredExactCanonicalComparisonSectionHom
        finiteAxisFoldBCDatumSquare
        (Discrete.mk DoubleDiamondTwoCell.second)
        Int
        (finiteAxisFoldFixedCoefficientGeometryFamily
          (Discrete.mk DoubleDiamondTwoCell.second))
        finiteCanonicalObjectNormalization_admissible comparison.1
    rw [sectionedAxisPermutationComparisonElement_evaluation]
    exact congrArg
      (authoredExactCanonicalComparisonSectionHom
        finiteAxisFoldBCDatumSquare
        (Discrete.mk DoubleDiamondTwoCell.second)
        Int
        (finiteAxisFoldFixedCoefficientGeometryFamily
          (Discrete.mk DoubleDiamondTwoCell.second))
        finiteCanonicalObjectNormalization_admissible)
      (congrArg Subtype.val (assembleAxis_readAxis comparison))
  · intro candidate candidateEquality
    change authoredExactCanonicalComparisonSectionHom
        finiteAxisFoldBCDatumSquare
        (Discrete.mk DoubleDiamondTwoCell.second)
        Int
        (finiteAxisFoldFixedCoefficientGeometryFamily
          (Discrete.mk DoubleDiamondTwoCell.second))
        finiteCanonicalObjectNormalization_admissible
          (finiteAxisFoldNormalizedComparisonPermutation candidate) =
      authoredExactCanonicalComparisonSectionHom
        finiteAxisFoldBCDatumSquare
        (Discrete.mk DoubleDiamondTwoCell.second)
        Int
        (finiteAxisFoldFixedCoefficientGeometryFamily
          (Discrete.mk DoubleDiamondTwoCell.second))
        finiteCanonicalObjectNormalization_admissible comparison.1 at candidateEquality
    have normalized := congrArg
      (fun raw : RawComparison => restrictionHom raw) candidateEquality
    change restrictionHom
        (authoredExactCanonicalComparisonSectionHom
          finiteAxisFoldBCDatumSquare
          (Discrete.mk DoubleDiamondTwoCell.second)
          Int
          (finiteAxisFoldFixedCoefficientGeometryFamily
            (Discrete.mk DoubleDiamondTwoCell.second))
          finiteCanonicalObjectNormalization_admissible
          (finiteAxisFoldNormalizedComparisonPermutation candidate)) =
      restrictionHom
        (authoredExactCanonicalComparisonSectionHom
          finiteAxisFoldBCDatumSquare
          (Discrete.mk DoubleDiamondTwoCell.second)
          Int
          (finiteAxisFoldFixedCoefficientGeometryFamily
            (Discrete.mk DoubleDiamondTwoCell.second))
          finiteCanonicalObjectNormalization_admissible comparison.1) at normalized
    rw [authoredExactCanonicalComparisonSection_rightInverse,
      authoredExactCanonicalComparisonSection_rightInverse] at normalized
    have imageEquality : assembleAxis candidate = comparison := by
      apply Subtype.ext
      change axisComparisonSectionHom candidate = comparison.1
      rw [axisComparisonSectionHom_apply]
      exact normalized
    exact axisComparisonMulEquiv.injective
      (imageEquality.trans (assembleAxis_readAxis comparison).symm)

/-- From the source-generated canonical lift, every actual lift in the same
fiber is reached by a unique element of the full actual restriction kernel. -/
theorem everyLift_unique_kernel_displacement
    (comparison : AxisComparisonImage)
    (lift : AuthoredExactCanonicalComparisonLiftFiber
      finiteAxisFoldBCDatumSquare
      (Discrete.mk DoubleDiamondTwoCell.second)
      Int
      (finiteAxisFoldFixedCoefficientGeometryFamily
        (Discrete.mk DoubleDiamondTwoCell.second))
      finiteCanonicalObjectNormalization_admissible comparison.1) :
    ∃! kernelValue : restrictionHom.kerᵐᵒᵖ,
      kernelValue • canonicalLift comparison = lift :=
  authoredExactCanonicalComparisonLiftFiber_existsUnique_smul_eq
    finiteAxisFoldBCDatumSquare
    (Discrete.mk DoubleDiamondTwoCell.second)
    Int
    (finiteAxisFoldFixedCoefficientGeometryFamily
      (Discrete.mk DoubleDiamondTwoCell.second))
    finiteCanonicalObjectNormalization_admissible comparison.1
    (canonicalLift comparison) lift

/-- The unique source code for the canonical lift and the unique full-kernel
displacement to an arbitrary lift hold together on every represented fiber. -/
theorem sourceGenerated_fullKernel_reconstruction
    (comparison : AxisComparisonImage)
    (lift : AuthoredExactCanonicalComparisonLiftFiber
      finiteAxisFoldBCDatumSquare
      (Discrete.mk DoubleDiamondTwoCell.second)
      Int
      (finiteAxisFoldFixedCoefficientGeometryFamily
        (Discrete.mk DoubleDiamondTwoCell.second))
      finiteCanonicalObjectNormalization_admissible comparison.1) :
    (∃! permutation : Equiv.Perm (Fin 3),
      FiniteAxisFoldAxisSwapPresentation.comparisonEvaluationHom
          (sectionedAxisPermutationComparisonElement permutation) =
        (canonicalLift comparison).1) ∧
    (∃! kernelValue : restrictionHom.kerᵐᵒᵖ,
      kernelValue • canonicalLift comparison = lift) :=
  ⟨canonicalSection_unique_axisCode comparison,
    everyLift_unique_kernel_displacement comparison lift⟩

end
end G122AxisComparisonLocalModel
end AAT.AG.LocalSemanticReconstruction

#assert_standard_axioms_only AAT.AG.LocalSemanticReconstruction.G122AxisComparisonLocalModel
