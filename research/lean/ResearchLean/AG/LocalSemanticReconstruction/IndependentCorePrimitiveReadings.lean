import Formal.AG.Atom.AATCore
import Formal.Util.AssertStandardAxioms

/-!
# Primitive readings for the independent G-124 core verification

Extraction is read by selected carrier references, admission predicates, and
normalization points. Composition is read by relation and identification
predicates. Object formation is read by two selected primitive values and
their carrier references. Operations are read by endpoint-indexed carriers
and individual atom actions. Query arguments retain the native reading domains.

This file is part of the independent first-checkpoint verification, not a
research cycle. The complete core and geometry construction continues after
these primitive reading equivalences. Their composition already recovers the
architecture object generated by every native core reading.
-/

namespace AAT.AG.LocalSemanticReconstruction.IndependentCorePrimitive

universe u

/-- One selected primitive value together with its native carrier reference. -/
abbrev SelectedValue := (T : Type u) × T

namespace Composition

/-- Point queries for the two configuration relations generated by composition. -/
inductive Query (U : AtomCarrier.{u}) where
  /-- Read the relation on one pair of atoms in a finite family. -/
  | relation (F : AtomFamily U) (hf : F.ListFinite) (a b : U.Atom)
  /-- Read identification on one pair of atoms in a finite family. -/
  | identification (F : AtomFamily U) (hf : F.ListFinite) (a b : U.Atom)

/-- The native predicates are read one application at a time. -/
abbrev Table (U : AtomCarrier.{u}) := Query U → Prop

variable {U : AtomCarrier.{u}}

/-- Local support conditions for the two primitive relations. -/
structure IsLawful (t : Table U) : Prop where
  /-- A related pair belongs to the supplied family. -/
  relation : ∀ F hf a b, t (.relation F hf a b) → F.mem a ∧ F.mem b
  /-- An identified pair belongs to the supplied family. -/
  identification : ∀ F hf a b, t (.identification F hf a b) → F.mem a ∧ F.mem b

/-- Assemble a configuration on the supplied family from its two point predicates. -/
def configuration (t : Table U) (F : AtomFamily U) (hf : F.ListFinite) :
    AtomConfiguration U where
  family := F
  relation a b := t (.relation F hf a b)
  identification a b := t (.identification F hf a b)

/-- Construct a native composition rule using only pointwise support. -/
def assemble (t : Table U) (ht : IsLawful t) : CompositionReading U where
  compose := configuration t
  family_eq _ _ := rfl
  family_supported F hf := ⟨ht.relation F hf _ _, ht.identification F hf _ _⟩

/-- Read the native composition rule at one declared predicate query. -/
def read (R : CompositionReading U) : Table U
  | .relation F hf a b => (R.compose F hf).relation a b
  | .identification F hf a b => (R.compose F hf).identification a b

/-- Native family support generates both local implications. -/
theorem read_isLawful (R : CompositionReading U) : IsLawful (read R) where
  relation F hf a b hab := by
    have h := (R.family_supported F hf).1 hab
    rwa [R.family_eq F hf] at h
  identification F hf a b hab := by
    have h := (R.family_supported F hf).2 hab
    rwa [R.family_eq F hf] at h

/-- Every composition output is recovered on the whole supplied finite family. -/
theorem assemble_read (R : CompositionReading U) :
    assemble (read R) (read_isLawful R) = R := by
  apply CompositionReading.ext
  funext F hf
  apply AtomConfiguration.ext
  · exact (R.family_eq F hf).symm
  · intro a b
    rfl
  · intro a b
    rfl

/-- All primitive composition readings are recovered without choosing finite witnesses. -/
theorem read_assemble (t : Table U) (ht : IsLawful t) :
    read (assemble t ht) = t := by
  funext q
  cases q <;> rfl

/-- The full native composition type is equivalent to its independent lawful point table. -/
def readingEquiv : CompositionReading U ≃ {t : Table U // IsLawful t} where
  toFun R := ⟨read R, read_isLawful R⟩
  invFun t := assemble t.val t.property
  left_inv := assemble_read
  right_inv t := Subtype.ext (read_assemble t.val t.property)

/-- A configuration with no selected relations satisfies both support conditions. -/
theorem emptyTable_isLawful : IsLawful (U := U) (fun _ => False) where
  relation _ _ _ _ h := h.elim
  identification _ _ _ _ h := h.elim

/-- A relation on an atom outside an empty family is rejected by local support. -/
theorem trueTable_not_lawful (a : U.Atom) :
    ¬ IsLawful (U := U) (fun _ => True) := by
  intro h
  let F : AtomFamily U := ⟨fun _ => False⟩
  have hf : F.ListFinite := ⟨[], fun _ ha => ha.elim⟩
  exact (h.relation F hf a a trivial).1

end Composition

namespace ObjectFormation

/-- The two native selected-value roles in object formation. -/
inductive Query (U : AtomCarrier.{u}) where
  /-- Read a selected structure-map value and its carrier. -/
  | structureMaps (C : AtomConfiguration U)
  /-- Read a selected-quantity value and its carrier. -/
  | selectedQuantities (C : AtomConfiguration U)

/-- Each query returns one selected native value, never the formed object. -/
abbrev Table (U : AtomCarrier.{u}) := Query U → SelectedValue.{u}

variable {U : AtomCarrier.{u}}

/-- Form an architecture object on the original configuration from two primitive values. -/
def object (t : Table U) (C : AtomConfiguration U) : ArchitectureObject U where
  configuration := C
  StructureMaps := (t (.structureMaps C)).1
  SelectedQuantities := (t (.selectedQuantities C)).1
  structureMaps := (t (.structureMaps C)).2
  selectedQuantities := (t (.selectedQuantities C)).2

/-- Construct the whole object-formation rule, preserving its supplied configuration. -/
def assemble (t : Table U) : ObjectReading U where
  object := object t
  configuration_eq _ := rfl

/-- Read the selected values at each input configuration. -/
def read (R : ObjectReading U) : Table U
  | .structureMaps C => ⟨(R.object C).StructureMaps, (R.object C).structureMaps⟩
  | .selectedQuantities C =>
      ⟨(R.object C).SelectedQuantities, (R.object C).selectedQuantities⟩

/-- The native object law recovers the configuration; primitive reads recover all remaining data. -/
theorem assemble_read (R : ObjectReading U) : assemble (read R) = R := by
  apply ObjectReading.ext
  funext C
  have hc := R.configuration_eq C
  change
    (⟨C, (R.object C).StructureMaps, (R.object C).SelectedQuantities,
      (R.object C).structureMaps, (R.object C).selectedQuantities⟩ : ArchitectureObject U) =
      R.object C
  exact congrArg
    (fun D => (⟨D, (R.object C).StructureMaps, (R.object C).SelectedQuantities,
      (R.object C).structureMaps, (R.object C).selectedQuantities⟩ : ArchitectureObject U))
    hc.symm

/-- Reading the formed object recovers both carrier-and-value pairs. -/
theorem read_assemble (t : Table U) : read (assemble t) = t := by
  funext q
  cases q <;> rfl

/-- All native object-formation rules are represented, with both inverse laws. -/
def readingEquiv : ObjectReading U ≃ Table U where
  toFun := read
  invFun := assemble
  left_inv := assemble_read
  right_inv := read_assemble

end ObjectFormation

namespace Extraction

/-- The four selected carrier roles of a pointed extraction doctrine. -/
inductive Role where
  /-- The selected source and its carrier. -/
  | source
  /-- The selected vocabulary and its carrier. -/
  | vocabulary
  /-- The selected semantic reading and its carrier. -/
  | semantic
  /-- The selected resolution and its carrier. -/
  | resolution

/-- Primitive extraction evaluations, indexed independently of the chosen doctrine. -/
inductive Query (U : AtomCarrier.{u}) where
  /-- Read a selected value with its carrier reference. -/
  | selected (r : Role)
  /-- Read vocabulary admission at one atom. -/
  | vocabulary (V : Type u) (v : V) (a : U.Atom)
  /-- Read semantic admission at one source and atom. -/
  | semantic (M S : Type u) (m : M) (s : S) (a : U.Atom)
  /-- Read resolution admission at one source and atom. -/
  | resolution (R S : Type u) (r : R) (s : S) (a : U.Atom)
  /-- Read source semantics at one source and atom. -/
  | source (S : Type u) (s : S) (a : U.Atom)
  /-- Read the normalized value of one source. -/
  | normalize (S : Type u) (s : S)

/-- Extraction responses retain their native roles and evaluate only one application. -/
def Query.Value {U : AtomCarrier.{u}} : Query U → Type (u + 1)
  | .selected _ => SelectedValue.{u}
  | .vocabulary _ _ _ => ULift.{u + 1} Prop
  | .semantic _ _ _ _ _ => ULift.{u + 1} Prop
  | .resolution _ _ _ _ _ => ULift.{u + 1} Prop
  | .source _ _ _ => ULift.{u + 1} Prop
  | .normalize S _ => ULift.{u + 1} (Option S)

/-- A dependent table of extraction evaluations. -/
abbrev Table (U : AtomCarrier.{u}) := (q : Query U) → q.Value

variable {U : AtomCarrier.{u}}

/-- The chosen type at a declared extraction role. -/
abbrev carrier (t : Table U) (r : Role) : Type u := (t (.selected r)).1

/-- The chosen point at a declared extraction role. -/
abbrev point (t : Table U) (r : Role) : carrier t r := (t (.selected r)).2

/-- Candidate types activate normalization and exclude irrelevant predicate responses. -/
structure IsTyped (t : Table U) : Prop where
  /-- Normalization returns a point precisely on the selected source carrier. -/
  normalize : ∀ S s, (t (.normalize S s)).down.isSome ↔ S = carrier t .source
  /-- Vocabulary readings at any other carrier are false. -/
  vocabulary : ∀ V v a, V ≠ carrier t .vocabulary → ¬ (t (.vocabulary V v a)).down
  /-- Semantic readings at any other carrier pair are false. -/
  semantic : ∀ M S m s a,
    ¬ (M = carrier t .semantic ∧ S = carrier t .source) →
      ¬ (t (.semantic M S m s a)).down
  /-- Resolution readings at any other carrier pair are false. -/
  resolution : ∀ R S r s a,
    ¬ (R = carrier t .resolution ∧ S = carrier t .source) →
      ¬ (t (.resolution R S r s a)).down
  /-- Source semantics at any other carrier is false. -/
  source : ∀ S s a, S ≠ carrier t .source → ¬ (t (.source S s a)).down

/-- Construct all native extraction functions by collecting their primitive evaluations. -/
def doctrine (t : Table U) (ht : IsTyped t) : ExtractionDoctrine U where
  Source := carrier t .source
  Vocabulary := carrier t .vocabulary
  SemanticReading := carrier t .semantic
  Resolution := carrier t .resolution
  vocabulary := point t .vocabulary
  semanticReading := point t .semantic
  resolution := point t .resolution
  vocabularyAllows v a := (t (.vocabulary _ v a)).down
  semanticAllows m s a := (t (.semantic _ _ m s a)).down
  resolutionAllows r s a := (t (.resolution _ _ r s a)).down
  sourceSemantics s a := (t (.source _ s a)).down
  normalize s := (t (.normalize _ s)).down.get ((ht.normalize _ _).2 rfl)

/-- A native doctrine together with the source from which its core is generated. -/
abbrev PointedDoctrine (U : AtomCarrier.{u}) := (D : ExtractionDoctrine U) × D.Source

/-- Assemble a pointed native doctrine from the independent extraction table. -/
def assemble (t : Table U) (ht : IsTyped t) : PointedDoctrine U :=
  ⟨doctrine t ht, point t .source⟩

/-- Read a native doctrine using carrier equality only to activate the named query. -/
noncomputable def read (P : PointedDoctrine U) : Table U := by
  classical
  intro q
  let D := P.1
  cases q with
  | selected r =>
    cases r with
    | source => exact ⟨D.Source, P.2⟩
    | vocabulary => exact ⟨D.Vocabulary, D.vocabulary⟩
    | semantic => exact ⟨D.SemanticReading, D.semanticReading⟩
    | resolution => exact ⟨D.Resolution, D.resolution⟩
  | vocabulary V v a =>
    exact ⟨if h : V = D.Vocabulary then D.vocabularyAllows (h ▸ v) a else False⟩
  | semantic M S m s a =>
    exact ⟨if hM : M = D.SemanticReading then
      if hS : S = D.Source then D.semanticAllows (hM ▸ m) (hS ▸ s) a else False
      else False⟩
  | resolution R S r s a =>
    exact ⟨if hR : R = D.Resolution then
      if hS : S = D.Source then D.resolutionAllows (hR ▸ r) (hS ▸ s) a else False
      else False⟩
  | source S s a =>
    exact ⟨if h : S = D.Source then D.sourceSemantics (h ▸ s) a else False⟩
  | normalize S s =>
    exact ⟨if h : S = D.Source then some (h.symm ▸ D.normalize (h ▸ s)) else none⟩

/-- A native reading satisfies every activation and inactivity rule. -/
theorem read_isTyped (P : PointedDoctrine U) : IsTyped (read P) where
  normalize S s := by
    classical
    by_cases h : S = P.1.Source <;> simp [read, carrier, h]
  vocabulary V v a h := by
    have hn : V ≠ P.1.Vocabulary := h
    simp [read, hn]
  semantic M S m s a h := by
    classical
    by_cases hM : M = P.1.SemanticReading
    · have hS : S ≠ P.1.Source := fun hs => h ⟨hM, hs⟩
      simp [read, hM, hS]
    · simp [read, hM]
  resolution R S r s a h := by
    classical
    by_cases hR : R = P.1.Resolution
    · have hS : S ≠ P.1.Source := fun hs => h ⟨hR, hs⟩
      simp [read, hR, hS]
    · simp [read, hR]
  source S s a h := by
    have hn : S ≠ P.1.Source := h
    simp [read, hn]

/-- Native extraction data and the selected source are recovered exactly. -/
theorem assemble_read (P : PointedDoctrine U) :
    assemble (read P) (read_isTyped P) = P := by
  classical
  rcases P with ⟨D, s⟩
  cases D
  simp [assemble, doctrine, point, carrier, read]

/-- Active extraction values and inactive candidate responses are all recovered. -/
theorem read_assemble (t : Table U) (ht : IsTyped t) : read (assemble t ht) = t := by
  classical
  funext q
  cases q with
  | selected r => cases r <;> rfl
  | vocabulary V v a =>
    apply ULift.ext
    by_cases hV : V = carrier t .vocabulary
    · subst V
      simp [read, assemble, doctrine]
    · simp [read, assemble, doctrine, hV, ht.vocabulary V v a hV]
  | semantic M S m s a =>
    apply ULift.ext
    by_cases hM : M = carrier t .semantic
    · subst M
      by_cases hS : S = carrier t .source
      · subst S
        simp [read, assemble, doctrine]
      · simp [read, assemble, doctrine, hS,
          ht.semantic _ S m s a (fun h => hS h.2)]
    · simp [read, assemble, doctrine, hM,
        ht.semantic M S m s a (fun h => hM h.1)]
  | resolution R S r s a =>
    apply ULift.ext
    by_cases hR : R = carrier t .resolution
    · subst R
      by_cases hS : S = carrier t .source
      · subst S
        simp [read, assemble, doctrine]
      · simp [read, assemble, doctrine, hS,
          ht.resolution _ S r s a (fun h => hS h.2)]
    · simp [read, assemble, doctrine, hR,
        ht.resolution R S r s a (fun h => hR h.1)]
  | source S s a =>
    apply ULift.ext
    by_cases hS : S = carrier t .source
    · subst S
      simp [read, assemble, doctrine]
    · simp [read, assemble, doctrine, hS, ht.source S s a hS]
  | normalize S s =>
    apply ULift.ext
    by_cases hS : S = carrier t .source
    · subst S
      simp [read, assemble, doctrine, Option.some_get]
    · have hn : (t (.normalize S s)).down = none := by
        cases ho : (t (.normalize S s)).down with
        | none => rfl
        | some x => exact False.elim (hS ((ht.normalize S s).1 (by simp [ho])))
      simp [read, assemble, doctrine, hS, hn]

/-- All pointed doctrines are represented by their primitive typed tables. -/
noncomputable def readingEquiv : PointedDoctrine U ≃ {t : Table U // IsTyped t} where
  toFun P := ⟨read P, read_isTyped P⟩
  invFun t := assemble t.val t.property
  left_inv := assemble_read
  right_inv t := Subtype.ext (read_assemble t.val t.property)

/-- Canonical extraction is derived from all four primitive admission evaluations. -/
theorem atomize_mem_iff (t : Table U) (ht : IsTyped t) (a : U.Atom) :
    ((doctrine t ht).atomize (point t .source)).mem a ↔
      (t (.vocabulary _ (point t .vocabulary) a)).down ∧
      (t (.semantic _ _ (point t .semantic)
        ((doctrine t ht).normalize (point t .source)) a)).down ∧
      (t (.resolution _ _ (point t .resolution)
        ((doctrine t ht).normalize (point t .source)) a)).down ∧
      (t (.source _ ((doctrine t ht).normalize (point t .source)) a)).down := Iff.rfl

/-- Remove normalization responses while preserving the selected source and all admissions. -/
def eraseNormalization (t : Table U) : Table U
  | .normalize _ _ => ⟨none⟩
  | q => t q

/-- Missing normalization at the selected source is rejected even if all admissions are present. -/
theorem eraseNormalization_not_typed (t : Table U) : ¬ IsTyped (eraseNormalization t) := by
  intro h
  have hn := (h.normalize (carrier t .source) (point t .source)).2 rfl
  simp [eraseNormalization] at hn

end Extraction

namespace Operations

/-- Queries retain both operation endpoints and read one atom action. -/
inductive Query (U : AtomCarrier.{u}) where
  /-- Select the operation carrier at an ordered pair of architecture objects. -/
  | carrier (A B : ArchitectureObject U)
  /-- Read the action of a candidate operation on one atom. -/
  | action (A B : ArchitectureObject U) (T : Type u) (op : T) (a : U.Atom)

/-- An operation response is a carrier reference or one optional output atom. -/
def Query.Value {U : AtomCarrier.{u}} : Query U → Type (u + 1)
  | .carrier _ _ => Type u
  | .action _ _ _ _ _ => ULift.{u + 1} (Option U.Atom)

/-- Independent primitive operation data. -/
abbrev Table (U : AtomCarrier.{u}) := (q : Query U) → q.Value

variable {U : AtomCarrier.{u}}

/-- The carrier selected for the specified operation endpoints. -/
abbrev carrier (t : Table U) (A B : ArchitectureObject U) : Type u := t (.carrier A B)

/-- Exactly the selected operation carrier is active at each pair of endpoints. -/
def IsTyped (t : Table U) : Prop :=
  ∀ A B T op a, (t (.action A B T op a)).down.isSome ↔ T = carrier t A B

/-- Construct an atom map by collecting its active point responses. -/
def action (t : Table U) (ht : IsTyped t) {A B : ArchitectureObject U}
    (op : carrier t A B) (a : U.Atom) : U.Atom :=
  (t (.action A B _ op a)).down.get ((ht A B _ op a).2 rfl)

/-- The three native configuration preservation clauses are imposed pointwise. -/
structure IsLawful (t : Table U) (ht : IsTyped t) : Prop where
  /-- Operation actions preserve the source family at each atom. -/
  family : ∀ (A B : ArchitectureObject U) (op : carrier t A B) a,
    A.configuration.family.mem a →
      B.configuration.family.mem (action t ht (A := A) (B := B) op a)
  /-- Operation actions preserve the source relation at each pair. -/
  relation : ∀ (A B : ArchitectureObject U) (op : carrier t A B) a b,
    A.configuration.relation a b →
      B.configuration.relation (action t ht (A := A) (B := B) op a)
        (action t ht (A := A) (B := B) op b)
  /-- Operation actions preserve source identifications at each pair. -/
  identification : ∀ (A B : ArchitectureObject U) (op : carrier t A B) a b,
    A.configuration.identification a b →
      B.configuration.identification (action t ht (A := A) (B := B) op a)
        (action t ht (A := A) (B := B) op b)

/-- Assemble every selected operation as its native configuration homomorphism. -/
def assemble (t : Table U) (ht : IsTyped t) (hl : IsLawful t ht) : OperationReading U where
  Op := carrier t
  configurationMap {A B} op :=
    ⟨action t ht (A := A) (B := B) op, hl.family A B op _, hl.relation A B op _ _,
      hl.identification A B op _ _⟩

/-- Read a native operation family without placing an entire operation map in a response. -/
noncomputable def read (R : OperationReading U) : Table U := by
  classical
  intro q
  cases q with
  | carrier A B => exact R.Op A B
  | action A B T op a =>
    exact ⟨if h : T = R.Op A B then some ((R.configurationMap (h ▸ op)).atomMap a)
      else none⟩

/-- Native operation readings activate precisely their own endpoint-indexed carriers. -/
theorem read_isTyped (R : OperationReading U) : IsTyped (read R) := by
  classical
  intro A B T op a
  by_cases h : T = R.Op A B <;> simp [read, carrier, h]

/-- Reading and collecting an operation action preserves its point evaluation. -/
theorem action_read (R : OperationReading U) {A B : ArchitectureObject U}
    (op : R.Op A B) (a : U.Atom) :
    action (read R) (read_isTyped R) (A := A) (B := B) op a =
      (R.configurationMap op).atomMap a := by
  simp [action, read, carrier]

/-- Native preservation laws produce all pointwise operation conditions. -/
theorem read_isLawful (R : OperationReading U) : IsLawful (read R) (read_isTyped R) where
  family A B op a h := by
    simpa [action_read] using (R.configurationMap op).maps_family h
  relation A B op a b h := by
    simpa [action_read] using (R.configurationMap op).maps_relation h
  identification A B op a b h := by
    simpa [action_read] using (R.configurationMap op).maps_identification h

/-- Native operation readings are recovered on every endpoint and every operation. -/
theorem assemble_read (R : OperationReading U) :
    assemble (read R) (read_isTyped R) (read_isLawful R) = R := by
  cases R with
  | mk Op cm =>
    apply congrArg (OperationReading.mk Op)
    funext A B op
    apply ConfigurationHom.ext
    funext a
    exact action_read ⟨Op, cm⟩ op a

/-- All active and inactive operation responses survive assembly followed by reading. -/
theorem read_assemble (t : Table U) (ht : IsTyped t) (hl : IsLawful t ht) :
    read (assemble t ht hl) = t := by
  classical
  funext q
  cases q with
  | carrier A B => rfl
  | action A B T op a =>
    apply ULift.ext
    by_cases hT : T = carrier t A B
    · subst T
      simp [read, assemble, action, Option.some_get]
    · have hn : (t (.action A B T op a)).down = none := by
        cases ho : (t (.action A B T op a)).down with
        | none => rfl
        | some x => exact False.elim (hT ((ht A B T op a).1 (by simp [ho])))
      simp [read, assemble, hT, hn]

/-- All native operation readings correspond to independent typed lawful point tables. -/
noncomputable def readingEquiv :
    OperationReading U ≃ {t : Table U // ∃ ht : IsTyped t, IsLawful t ht} where
  toFun R := ⟨read R, read_isTyped R, read_isLawful R⟩
  invFun t := assemble t.val t.property.choose t.property.choose_spec
  left_inv := assemble_read
  right_inv t := Subtype.ext (read_assemble t.val t.property.choose t.property.choose_spec)

end Operations

namespace Generation

variable {U : AtomCarrier.{u}}

/-- Derive the canonical Atom family from the selected source and primitive admissions. -/
def family (t : Extraction.Table U) (ht : Extraction.IsTyped t) : AtomFamily U :=
  let P := Extraction.assemble t ht
  P.1.atomize P.2

/-- Pointwise extraction recovers the canonical family of a native pointed doctrine. -/
theorem family_read (P : Extraction.PointedDoctrine U) :
    family (Extraction.read P) (Extraction.read_isTyped P) = P.1.atomize P.2 :=
  congrArg (fun Q : Extraction.PointedDoctrine U => Q.1.atomize Q.2)
    (Extraction.assemble_read P)

/-- The native finite-family condition is transported to the reconstructed extraction. -/
theorem family_read_listFinite (P : Extraction.PointedDoctrine U)
    (hf : (P.1.atomize P.2).ListFinite) :
    (family (Extraction.read P) (Extraction.read_isTyped P)).ListFinite := by
  rwa [family_read]

/-- Build the generated configuration using the exact extracted family. -/
def configuration (te : Extraction.Table U) (he : Extraction.IsTyped te)
    (tc : Composition.Table U) (hc : Composition.IsLawful tc)
    (hf : (family te he).ListFinite) : AtomConfiguration U :=
  (Composition.assemble tc hc).compose (family te he) hf

/-- Build the generated architecture object from extraction, composition, and formation points. -/
def object (te : Extraction.Table U) (he : Extraction.IsTyped te)
    (tc : Composition.Table U) (hc : Composition.IsLawful tc)
    (tf : ObjectFormation.Table U) (hf : (family te he).ListFinite) :
    ArchitectureObject U :=
  (ObjectFormation.assemble tf).object (configuration te he tc hc hf)

/-- Family membership in the assembled object is the conjunction of native admission readings. -/
theorem object_family_mem_iff
    (te : Extraction.Table U) (he : Extraction.IsTyped te)
    (tc : Composition.Table U) (hc : Composition.IsLawful tc)
    (tf : ObjectFormation.Table U) (hf : (family te he).ListFinite) (a : U.Atom) :
    (object te he tc hc tf hf).configuration.family.mem a ↔
      (Extraction.doctrine te he).extracts (Extraction.point te .source) a := Iff.rfl

/-- Generated objects preserve both pointwise composition relations on the extracted family. -/
theorem object_relation_iff
    (te : Extraction.Table U) (he : Extraction.IsTyped te)
    (tc : Composition.Table U) (hc : Composition.IsLawful tc)
    (tf : ObjectFormation.Table U) (hf : (family te he).ListFinite) (a b : U.Atom) :
    (object te he tc hc tf hf).configuration.relation a b ↔
      tc (.relation (family te he) hf a b) := Iff.rfl

/-- Generated identifications are exactly their primitive pair evaluations. -/
theorem object_identification_iff
    (te : Extraction.Table U) (he : Extraction.IsTyped te)
    (tc : Composition.Table U) (hc : Composition.IsLawful tc)
    (tf : ObjectFormation.Table U) (hf : (family te he).ListFinite) (a b : U.Atom) :
    (object te he tc hc tf hf).configuration.identification a b ↔
      tc (.identification (family te he) hf a b) := Iff.rfl

/-- Reading the native lower core and rebuilding it recovers its generated object. -/
theorem object_read (R : CoreReading U) :
    object (Extraction.read ⟨R.doctrine, R.source⟩) (Extraction.read_isTyped _)
      (Composition.read R.composition) (Composition.read_isLawful _)
      (ObjectFormation.read R.objectReading)
      (family_read_listFinite _ R.family_listFinite) =
        R.objectReading.object (R.composition.compose (R.doctrine.atomize R.source)
          R.family_listFinite) := by
  unfold object configuration
  rw [ObjectFormation.assemble_read, Composition.assemble_read]
  congr 2
  exact family_read _

end Generation

end AAT.AG.LocalSemanticReconstruction.IndependentCorePrimitive

