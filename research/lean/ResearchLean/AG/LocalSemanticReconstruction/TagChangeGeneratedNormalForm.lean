import ResearchLean.AG.LocalSemanticReconstruction.TagChangeNormalizedChoiceKernel
import Formal.Util.AssertStandardAxioms

/-!
# Normal forms for the tagged generated endomorphism monoid

The actual tagged-package endomorphisms generated by arbitrary source choices
and canonical normalization have two forms.  A raw form is a source-choice
automorphism.  A normalized form is a source-choice automorphism followed by
canonical normalization.  Multiplication restricts the right-hand choice
along normalization exactly when the left-hand word already contains the
normalization generator.

This module proves the composition table, separation of the two constructors,
and equality between the represented image and the submonoid generated by the
actual ambient morphisms.  Thus the normal form is faithful; no certificate or
conclusion-equivalent premise is stored in it.

## Implementation notes

The normalized constructor retains a global source choice.  Later finite-local
reconstruction must read and assemble that choice through finite restrictions;
this module does not place a global map inside one local value.  Mathlib's
monoid structure on categorical endomorphisms reverses categorical composition,
so the `NormalForm` monoid instance reverses `multiply`; the theorem
`evaluate_multiply` records the stated left-to-right categorical order.
-/

namespace AAT.AG.LocalSemanticReconstruction

open CategoryTheory AtomFoundation DoctrineFiberProduct
open AAT.AG.RealizationComparisonIdempotents
open AAT.AG.RealizationReconstruction

namespace TagChangeGeneratedNormalForm

noncomputable section

open TagChangeAmbientCategory
open TagChangeKaroubiReconstruction
open TagChangeNormalizedChoiceKernel

/-- The two canonical shapes of a word generated by source choices and
canonical normalization. -/
inductive NormalForm where
  | raw (choice : Choice)
  | normalized (choice : Choice)

/-- Interpret a normal form as an actual endomorphism of the accepted tagged
admissible package. -/
noncomputable def evaluate : NormalForm → (TaggedPackage ⟶ TaggedPackage)
  | .raw choice => sourceChoiceMorphism choice
  | .normalized choice => sourceChoiceMorphism choice ≫ normalization

/-- Every source-choice morphism is an involution. -/
theorem sourceChoiceMorphism_self (choice : Choice) :
    sourceChoiceMorphism choice ≫ sourceChoiceMorphism choice =
      𝟙 TaggedPackage := by
  calc
    _ = sourceChoiceMorphism
        (fun source => Bool.xor (choice source) (choice source)) :=
      (sourceChoiceMorphism_comp choice choice).symm
    _ = sourceChoiceMorphism (fun _ => false) := by
      congr 1
      funext source
      exact Bool.xor_self (choice source)
    _ = 𝟙 TaggedPackage := sourceChoiceMorphism_false

/-- Canonical normalization is idempotent in the accepted ambient category. -/
theorem normalization_idempotent :
    normalization ≫ normalization = normalization := by
  exact canonicalPackageNormalization_idem TaggedPackage

/-- Ambient normalization is not the identity endomorphism. -/
theorem normalization_ne_identity : normalization ≠ 𝟙 TaggedPackage := by
  obtain ⟨choice, notCommuting⟩ :=
    TagChangeKaroubiReconstruction.exists_sourceChoice_not_commuting_normalization
  intro equality
  apply notCommuting
  have ambientEquality :
      normalization ≫ sourceChoiceMorphism choice =
        sourceChoiceMorphism choice ≫ normalization := by
    rw [equality, Category.id_comp, Category.comp_id]
  exact congrArg (fun morphism => morphism.hom) ambientEquality

/-- Canonical normalization is not any raw source-choice automorphism. -/
theorem normalization_ne_sourceChoiceMorphism (choice : Choice) :
    normalization ≠ sourceChoiceMorphism choice := by
  intro equality
  apply normalization_ne_identity
  calc
    normalization = sourceChoiceMorphism choice := equality
    _ = sourceChoiceMorphism choice ≫ sourceChoiceMorphism choice := by
      rw [← equality]
      exact normalization_idempotent.symm
    _ = 𝟙 TaggedPackage := sourceChoiceMorphism_self choice

/-- Reading a source choice before normalization recovers the entire choice. -/
theorem read_sourceChoice_comp_normalization (choice : Choice) :
    readTaggedSourceChoice
        ((sourceChoiceMorphism choice ≫ normalization).hom) = choice := by
  funext source
  dsimp only [sourceChoiceMorphism, normalization,
    canonicalPackageNormalization, CategoryStruct.comp,
    ObjectProperty.homMk, readTaggedSourceChoice, PackageTotalHom.comp,
    taggedSourceChoiceTotal, taggedSourceChoiceUpper,
    canonicalObjectNormalizationTotal, canonicalObjectNormalizationUpper,
    SignedExactCoreReadingHom.comp]
  let sourceEquality :=
    finiteCanonicalObjectNormalization_admissible.operation_type_eq source source
  have admissibleEquality :
      taggedOperationPackage_admissible.operation_type_eq source source =
        congrArg (fun operationType => operationType × Bool) sourceEquality :=
    Subsingleton.elim _ _
  rw [admissibleEquality]
  have castTag := cast_operation_snd sourceEquality
    ((taggedIdentityOperation source).1,
      if choice source then !(taggedIdentityOperation source).2
      else (taggedIdentityOperation source).2)
  rw [castTag]
  cases value : choice source <;> simp [taggedIdentityOperation]

/-- Source-choice morphisms are faithful before normalization. -/
theorem raw_injective :
    Function.Injective (fun choice : Choice => evaluate (.raw choice)) := by
  intro first second equality
  apply taggedSourceChoiceTotal_injective
  exact congrArg (fun morphism => morphism.hom) equality

/-- Source-choice morphisms followed by normalization are also faithful. -/
theorem normalized_injective :
    Function.Injective (fun choice : Choice => evaluate (.normalized choice)) := by
  intro first second equality
  have underlying := congrArg (fun morphism => morphism.hom) equality
  have readEquality := congrArg readTaggedSourceChoice underlying
  simpa only [evaluate, read_sourceChoice_comp_normalization] using readEquality

/-- A raw form cannot equal a normalized form. -/
theorem raw_ne_normalized (first second : Choice) :
    evaluate (.raw first) ≠ evaluate (.normalized second) := by
  intro equality
  have precomposed :=
    congrArg (fun morphism => sourceChoiceMorphism second ≫ morphism) equality
  have normalizationEqualsChoice :
      normalization = sourceChoiceMorphism
        (fun source => Bool.xor (second source) (first source)) := by
    symm
    calc
      sourceChoiceMorphism
          (fun source => Bool.xor (second source) (first source)) =
          sourceChoiceMorphism second ≫ sourceChoiceMorphism first :=
        sourceChoiceMorphism_comp second first
      _ = sourceChoiceMorphism second ≫
          (sourceChoiceMorphism second ≫ normalization) := precomposed
      _ = (sourceChoiceMorphism second ≫ sourceChoiceMorphism second) ≫
          normalization := Category.assoc _ _ _ |>.symm
      _ = normalization := by rw [sourceChoiceMorphism_self, Category.id_comp]
  exact normalization_ne_sourceChoiceMorphism _ normalizationEqualsChoice

/-- The actual interpretation separates all normal forms. -/
theorem evaluate_injective : Function.Injective evaluate := by
  intro first second equality
  cases first with
  | raw first =>
      cases second with
      | raw second =>
          exact congrArg NormalForm.raw (raw_injective equality)
      | normalized second =>
          exact False.elim (raw_ne_normalized first second equality)
  | normalized first =>
      cases second with
      | raw second =>
          exact False.elim (raw_ne_normalized second first equality.symm)
      | normalized second =>
          exact congrArg NormalForm.normalized (normalized_injective equality)

/-- Move normalization past an arbitrary source choice, restricting the
choice to the normalization image. -/
theorem normalization_comp_sourceChoice_rewrite (choice : Choice) :
    normalization ≫ sourceChoiceMorphism choice =
      sourceChoiceMorphism (normalizeChoice choice) ≫ normalization := by
  calc
    normalization ≫ sourceChoiceMorphism choice =
        normalization ≫ sourceChoiceMorphism (normalizeChoice choice) := by
      apply ObjectProperty.hom_ext
      exact normalization_comp_sourceChoice_eq_normalized choice
    _ = sourceChoiceMorphism (normalizeChoice choice) ≫ normalization := by
      apply ObjectProperty.hom_ext
      exact taggedSourceChoiceTotal_commutes_normalization
        (normalizeChoice choice) (normalizeChoice_invariant choice)

/-- Multiplication table for generated normal forms. -/
def multiply : NormalForm → NormalForm → NormalForm
  | .raw first, .raw second =>
      .raw (fun source => Bool.xor (first source) (second source))
  | .raw first, .normalized second =>
      .normalized (fun source => Bool.xor (first source) (second source))
  | .normalized first, .raw second =>
      .normalized
        (fun source => Bool.xor (first source) (normalizeChoice second source))
  | .normalized first, .normalized second =>
      .normalized
        (fun source => Bool.xor (first source) (normalizeChoice second source))

/-- The multiplication table agrees with composition of actual ambient
endomorphisms. -/
theorem evaluate_multiply (first second : NormalForm) :
    evaluate (multiply first second) = evaluate first ≫ evaluate second := by
  cases first with
  | raw first =>
      cases second with
      | raw second =>
          exact sourceChoiceMorphism_comp first second
      | normalized second =>
          change sourceChoiceMorphism _ ≫ normalization =
            sourceChoiceMorphism first ≫
              (sourceChoiceMorphism second ≫ normalization)
          rw [← Category.assoc, ← sourceChoiceMorphism_comp]
  | normalized first =>
      cases second with
      | raw second =>
          change sourceChoiceMorphism _ ≫ normalization =
            (sourceChoiceMorphism first ≫ normalization) ≫
              sourceChoiceMorphism second
          rw [Category.assoc, normalization_comp_sourceChoice_rewrite,
            ← Category.assoc, ← sourceChoiceMorphism_comp]
      | normalized second =>
          change sourceChoiceMorphism _ ≫ normalization =
            (sourceChoiceMorphism first ≫ normalization) ≫
              (sourceChoiceMorphism second ≫ normalization)
          symm
          calc
            (sourceChoiceMorphism first ≫ normalization) ≫
                (sourceChoiceMorphism second ≫ normalization) =
              ((sourceChoiceMorphism first ≫ normalization) ≫
                sourceChoiceMorphism second) ≫ normalization :=
                (Category.assoc _ _ _).symm
            _ = (sourceChoiceMorphism first ≫
                (normalization ≫ sourceChoiceMorphism second)) ≫
                  normalization := by
                    exact congrArg (fun morphism => morphism ≫ normalization)
                      (Category.assoc _ _ _)
            _ = (sourceChoiceMorphism first ≫
                (sourceChoiceMorphism (normalizeChoice second) ≫
                  normalization)) ≫ normalization := by
                    rw [normalization_comp_sourceChoice_rewrite]
            _ = ((sourceChoiceMorphism first ≫
                sourceChoiceMorphism (normalizeChoice second)) ≫
                  normalization) ≫ normalization := by rw [← Category.assoc]
            _ = (sourceChoiceMorphism first ≫
                sourceChoiceMorphism (normalizeChoice second)) ≫
                  (normalization ≫ normalization) := by rw [Category.assoc]
            _ = (sourceChoiceMorphism first ≫
                sourceChoiceMorphism (normalizeChoice second)) ≫
                  normalization := by rw [normalization_idempotent]
            _ = sourceChoiceMorphism _ ≫ normalization := by
              rw [← sourceChoiceMorphism_comp]

/-- The raw false choice is the normal-form identity. -/
def identity : NormalForm := .raw (fun _ => false)

/-- Generated normal forms form a monoid whose multiplication is the proven
composition table. -/
noncomputable instance : Monoid NormalForm where
  mul first second := multiply second first
  one := identity
  mul_assoc first second third := by
    apply evaluate_injective
    change evaluate (multiply third (multiply second first)) =
      evaluate (multiply (multiply third second) first)
    rw [evaluate_multiply, evaluate_multiply, evaluate_multiply,
      evaluate_multiply, ← Category.assoc]
  one_mul form := by
    apply evaluate_injective
    change evaluate (multiply form identity) = evaluate form
    rw [evaluate_multiply]
    change evaluate form ≫ sourceChoiceMorphism (fun _ => false) = evaluate form
    rw [sourceChoiceMorphism_false, Category.comp_id]
  mul_one form := by
    apply evaluate_injective
    change evaluate (multiply identity form) = evaluate form
    rw [evaluate_multiply]
    change sourceChoiceMorphism (fun _ => false) ≫ evaluate form = evaluate form
    rw [sourceChoiceMorphism_false, Category.id_comp]

/-- Evaluation is a faithful monoid homomorphism into the actual tagged
endomorphism monoid. -/
noncomputable def evaluationHom : NormalForm →* End TaggedPackage where
  toFun := evaluate
  map_one' := sourceChoiceMorphism_false
  map_mul' first second := by
    change evaluate (multiply second first) = evaluate second ≫ evaluate first
    exact evaluate_multiply second first

/-- The actual image represented by normal forms. -/
noncomputable def representedSubmonoid : Submonoid (End TaggedPackage) :=
  MonoidHom.mrange evaluationHom

/-- The submonoid generated directly by the actual source-choice family and
canonical normalization. -/
noncomputable def actualGeneratedSubmonoid : Submonoid (End TaggedPackage) :=
  Submonoid.closure
    (Set.range sourceChoiceMorphism ∪ ({normalization} : Set (End TaggedPackage)))

/-- The represented image is exactly the submonoid generated by the actual
ambient morphisms. -/
theorem representedSubmonoid_eq_actualGenerated :
    representedSubmonoid = actualGeneratedSubmonoid := by
  apply le_antisymm
  · intro morphism membership
    rw [representedSubmonoid, MonoidHom.mem_mrange] at membership
    obtain ⟨form, rfl⟩ := membership
    cases form with
    | raw choice =>
        exact Submonoid.subset_closure (Set.mem_union_left _ ⟨choice, rfl⟩)
    | normalized choice =>
        apply Submonoid.mul_mem
        · exact Submonoid.subset_closure (Set.mem_union_right _ (Set.mem_singleton _))
        · exact Submonoid.subset_closure (Set.mem_union_left _ ⟨choice, rfl⟩)
  · apply Submonoid.closure_le.2
    intro morphism membership
    rcases membership with ⟨choice, rfl⟩ | rfl
    · change ∃ form : NormalForm,
        evaluationHom form = sourceChoiceMorphism choice
      exact ⟨.raw choice, rfl⟩
    · change ∃ form : NormalForm, evaluationHom form = normalization
      refine ⟨.normalized (fun _ => false), ?_⟩
      change sourceChoiceMorphism (fun _ => false) ≫ normalization = normalization
      rw [sourceChoiceMorphism_false, Category.id_comp]

/-- The faithful normal-form monoid is the actual generated submonoid. -/
noncomputable def normalFormMulEquivGenerated :
    NormalForm ≃* actualGeneratedSubmonoid :=
  (MulEquiv.ofBijective evaluationHom.mrangeRestrict
    ⟨by
      intro first second equality
      apply evaluate_injective
      exact congrArg Subtype.val equality,
    evaluationHom.mrangeRestrict_surjective⟩).trans
      (MulEquiv.submonoidCongr (by
        simpa only [representedSubmonoid] using
          representedSubmonoid_eq_actualGenerated))

#assert_standard_axioms_only AAT.AG.LocalSemanticReconstruction.TagChangeGeneratedNormalForm

end

end TagChangeGeneratedNormalForm

