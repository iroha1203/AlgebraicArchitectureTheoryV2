import ResearchLean.AG.RealizationReconstruction.FixedFComponentClassification
import ResearchLean.AG.LocalSemanticReconstruction.ComponentRestrictionCriteria
import Formal.Util.AssertStandardAxioms

/-!
# Components retained by a vertex subset

For a vertex predicate `S`, this file forms the fixed directed multigraph
induced by the vertices satisfying `S`: its named edges are exactly the full
graph edges whose two endpoints satisfy `S`.  The resulting component map to
the full graph is surjective exactly when `S` meets every full component, and
injective exactly when full-component connectivity between retained vertices
is already generated inside the induced graph.

These statements do not require finiteness.  In G-124(D) they apply in
particular to the finite reading-index subsets used there.
-/

namespace AAT.AG.LocalSemanticReconstruction

open RealizationReconstruction

namespace InducedComponent

/-- The named directed subgraph induced by a vertex predicate. -/
def graph (F : FixedFDirectedMultigraph) (S : F.Vertex → Prop) :
    FixedFDirectedMultigraph where
  Vertex := { vertex : F.Vertex // S vertex }
  Edge := { namedEdge : F.Edge //
    S (F.source namedEdge) ∧ S (F.target namedEdge) }
  source namedEdge := ⟨F.source namedEdge.1, namedEdge.2.1⟩
  target namedEdge := ⟨F.target namedEdge.1, namedEdge.2.2⟩

/-- Undirected reachability generated by edges retained in the induced graph. -/
abbrev Reachable (F : FixedFDirectedMultigraph) (S : F.Vertex → Prop) :=
  FixedFUndirectedReachable (graph F S)

/-- Connected components of the graph induced by `S`. -/
abbrev Component (F : FixedFDirectedMultigraph) (S : F.Vertex → Prop) :=
  FixedFComponent (graph F S)

/-- Induced reachability implies reachability in the full graph. -/
theorem reachable_full {F : FixedFDirectedMultigraph} {S : F.Vertex → Prop}
    {first second : (graph F S).Vertex}
    (reachable : Reachable F S first second) :
    FixedFUndirectedReachable F first.1 second.1 := by
  induction reachable with
  | rel first second step =>
      obtain ⟨namedEdge, sourceEquality, targetEquality⟩ := step
      apply Relation.EqvGen.rel
      exact ⟨namedEdge.1, congrArg Subtype.val sourceEquality,
        congrArg Subtype.val targetEquality⟩
  | refl vertex =>
      exact Relation.EqvGen.refl _
  | symm first second relation inductionHypothesis =>
      exact Relation.EqvGen.symm _ _ inductionHypothesis
  | trans first second third firstRelation secondRelation
      firstInduction secondInduction =>
      exact Relation.EqvGen.trans _ _ _ firstInduction secondInduction

/-- The canonical map from induced-graph components to full components. -/
def toFull (F : FixedFDirectedMultigraph) (S : F.Vertex → Prop) :
    Component F S → FixedFComponent F :=
  Quotient.lift
    (fun vertex => fixedFComponentMk F vertex.1)
    (fun _ _ reachable =>
      (fixedFComponentMk_eq_iff F _ _).mpr (reachable_full reachable))

@[simp]
theorem toFull_mk (F : FixedFDirectedMultigraph) (S : F.Vertex → Prop)
    (vertex : (graph F S).Vertex) :
    toFull F S (fixedFComponentMk (graph F S) vertex) =
      fixedFComponentMk F vertex.1 :=
  rfl

/-- `S` meets every full component. -/
def MeetsEveryFullComponent (F : FixedFDirectedMultigraph)
    (S : F.Vertex → Prop) : Prop :=
  ∀ vertex : F.Vertex, ∃ retained : (graph F S).Vertex,
    FixedFUndirectedReachable F retained.1 vertex

/-- Full connectivity between retained vertices is already generated inside
the induced graph. -/
def RetainsFullConnectivity (F : FixedFDirectedMultigraph)
    (S : F.Vertex → Prop) : Prop :=
  ∀ first second : (graph F S).Vertex,
    FixedFUndirectedReachable F first.1 second.1 → Reachable F S first second

/-- The induced component map is onto exactly when the retained vertices meet
every full component. -/
theorem toFull_surjective_iff_meetsEveryFullComponent
    (F : FixedFDirectedMultigraph) (S : F.Vertex → Prop) :
    Function.Surjective (toFull F S) ↔ MeetsEveryFullComponent F S := by
  constructor
  · intro hsurjective vertex
    obtain ⟨component, hcomponent⟩ :=
      hsurjective (fixedFComponentMk F vertex)
    refine Quotient.inductionOn component ?_ hcomponent
    intro retained hretained
    refine ⟨retained, ?_⟩
    exact (fixedFComponentMk_eq_iff F retained.1 vertex).mp hretained
  · intro hmeets component
    refine Quotient.inductionOn component ?_
    intro vertex
    obtain ⟨retained, hreachable⟩ := hmeets vertex
    refine ⟨fixedFComponentMk (graph F S) retained, ?_⟩
    exact (fixedFComponentMk_eq_iff F retained.1 vertex).mpr hreachable

/-- The induced component map is one-to-one exactly when no full component is
split into multiple induced-graph components. -/
theorem toFull_injective_iff_retainsFullConnectivity
    (F : FixedFDirectedMultigraph) (S : F.Vertex → Prop) :
    Function.Injective (toFull F S) ↔ RetainsFullConnectivity F S := by
  constructor
  · intro hinjective first second hreachable
    apply (fixedFComponentMk_eq_iff (graph F S) first second).mp
    apply hinjective
    exact (fixedFComponentMk_eq_iff F first.1 second.1).mpr hreachable
  · intro hretains firstComponent secondComponent hsame
    induction firstComponent using Quotient.inductionOn with
    | _ first =>
      induction secondComponent using Quotient.inductionOn with
      | _ second =>
        apply (fixedFComponentMk_eq_iff (graph F S) first second).mpr
        apply hretains
        apply (fixedFComponentMk_eq_iff F first.1 second.1).mp
        exact hsame

/-- For a nontrivial value type, restriction of full-component families to
induced components separates exactly when `S` meets every full component. -/
theorem precompose_toFull_injective_iff_meetsEveryFullComponent
    {Value : Type*} [Nontrivial Value]
    (F : FixedFDirectedMultigraph) (S : F.Vertex → Prop) :
    Function.Injective
        (ComponentRestriction.precompose (Value := Value) (toFull F S)) ↔
      MeetsEveryFullComponent F S := by
  rw [ComponentRestriction.precompose_injective_iff_surjective,
    toFull_surjective_iff_meetsEveryFullComponent]

/-- For a nontrivial value type, every induced-component family extends to a
full-component family exactly when `S` retains full connectivity. -/
theorem precompose_toFull_surjective_iff_retainsFullConnectivity
    {Value : Type*} [Nontrivial Value]
    (F : FixedFDirectedMultigraph) (S : F.Vertex → Prop) :
    Function.Surjective
        (ComponentRestriction.precompose (Value := Value) (toFull F S)) ↔
      RetainsFullConnectivity F S := by
  rw [ComponentRestriction.precompose_surjective_iff_injective,
    toFull_injective_iff_retainsFullConnectivity]

#assert_standard_axioms_only AAT.AG.LocalSemanticReconstruction.InducedComponent

end InducedComponent

end AAT.AG.LocalSemanticReconstruction
