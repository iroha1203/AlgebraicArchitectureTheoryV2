import ResearchLean.AG.OperationRepair.FiniteSequential

/-!
# Fully recursive finite repair trees

Every node constructs both child quotient systems. The right child contributes
its constructed kernel as the request for the next quotient of the left child.
-/
namespace AAT.AG.OperationRepair
universe u v w
variable {S : Type u} {E : Type v} (T : OperationSystem S E)

/-- A stable congruence is generated by its own underlying relation. -/
theorem generated_congruence (c : OperationCongruence T) :
    generated T c.setoid.r = c := by
  apply le_antisymm
  · exact (generated_le_iff T c).mpr (fun _ _ h => h)
  · intro x y h
    exact generated_contains T h

/-- The relation defining a constructed stage's kernel generates exactly
its accumulated congruence. -/
theorem generated_stageKernel {requests : List (S → S → Prop)}
    (st : SequentialStage T requests) :
    generated T (Setoid.ker st.read).r = generated T (listRequest requests) := by
  rw [st.kernel_eq, generated_congruence]

/-- Generated congruences turn finite-list union into a join. -/
theorem generated_listRequest_append (left right : List (S → S → Prop)) :
    generated T (listRequest (left ++ right)) =
      generated T (listRequest left) ⊔ generated T (listRequest right) := by
  apply le_antisymm
  · apply (generated_le_iff T _).mpr
    intro x y h
    rcases (listRequest_append left right x y).mp h with hl | hr
    · exact (show generated T (listRequest left) ≤ _ from le_sup_left)
        (generated_contains T hl)
    · exact (show generated T (listRequest right) ≤ _ from le_sup_right)
        (generated_contains T hr)
  · apply sup_le
    · apply (generated_le_iff T _).mpr
      intro x y h
      exact generated_contains T
        ((listRequest_append left right x y).mpr (Or.inl h))
    · apply (generated_le_iff T _).mpr
      intro x y h
      exact generated_contains T
        ((listRequest_append left right x y).mpr (Or.inr h))

/-- If two source requests generate the same operation congruence, their
images under any operation-preserving source map also generate the same
congruence. This identifies a constructed right-child kernel request with
the image of its raw leaf union at the current left-child stage. -/
theorem generated_mappedRequest_congr {Q : Type u}
    (U : OperationSystem Q E) (q : S → Q)
    (hstep : ∀ e x, q (T.step e x) = U.step e (q x))
    (R R' : S → S → Prop) (hgen : generated T R = generated T R') :
    generated U (mappedRequest q R) =
      generated U (mappedRequest q R') := by
  have hle (A B : S → S → Prop) (hAB : generated T A ≤ generated T B) :
      generated U (mappedRequest q A) ≤ generated U (mappedRequest q B) := by
    let k := generated U (mappedRequest q B)
    let pull : OperationCongruence T := {
      setoid := Setoid.comap q k.setoid
      stable := by
        intro e x y hxy
        change k.setoid.r (q (T.step e x)) (q (T.step e y))
        rw [hstep, hstep]
        exact k.stable e (q x) (q y) hxy }
    have hB : generated T B ≤ pull := by
      apply (generated_le_iff T pull).mpr
      intro x y hxy
      change k.setoid.r (q x) (q y)
      exact generated_contains U
        (show mappedRequest q B (q x) (q y) from
          ⟨x, y, hxy, rfl, rfl⟩)
    apply (generated_le_iff U _).mpr
    intro a b hab
    obtain ⟨x, y, hxy, rfl, rfl⟩ := hab
    exact (hAB.trans hB) (generated_contains T hxy)
  apply le_antisymm
  · exact hle R R' (le_of_eq hgen)
  · exact hle R' R (le_of_eq hgen.symm)

/-- Fully recursive evaluation of every binary request tree. Both child
quotients are constructed. The right child's kernel is the next request on
the left child's quotient, so its internal brackets affect the construction. -/
def fullTreeStage : RequestTree S →
    Σ requests : List (S → S → Prop), SequentialStage T requests
  | .empty => ⟨[], sequentialBase T⟩
  | .leaf R => ⟨[R], sequentialExtend T (sequentialBase T) R⟩
  | .branch left right =>
      let a := fullTreeStage left
      let b := fullTreeStage right
      ⟨(Setoid.ker b.2.read).r :: a.1,
        sequentialExtend T a.2 (Setoid.ker b.2.read).r⟩

/-- The fully recursive tree's final kernel is the congruence generated by
exactly its leaves, independent of their bracketing. -/
theorem fullTreeStage_generated (tree : RequestTree S) :
    generated T (listRequest (fullTreeStage T tree).1) =
      generated T (listRequest tree.leaves) := by
  induction tree with
  | empty => rfl
  | leaf R => rfl
  | branch left right ihl ihr =>
      change generated T
        (listRequest ((Setoid.ker (fullTreeStage T right).2.read).r ::
          (fullTreeStage T left).1)) =
        generated T (listRequest (left.leaves ++ right.leaves))
      rw [generated_listRequest_cons, generated_stageKernel,
        ihl, ihr, generated_listRequest_append]

/-- The constructed kernel of a repairable stage is itself a repairable
request. -/
theorem generated_repairableStageKernel {O : Type w} (observe : S → O)
    {requests : List (S → S → Prop)}
    (st : RepairableSequentialStage T observe requests) :
    generated T (Setoid.ker st.stage.read).r ≤ behavior T observe := by
  rw [generated_stageKernel]
  exact st.repairable

/-- Fully recursive repair tree. Both child repair systems are constructed;
the right child's actual kernel becomes the next request on the left child.
Every node has its own descended observation and every image request is
repairable by `repairableSequentialExtend_image`. -/
def fullRepairTreeStage {O : Type w} (observe : S → O) :
    (tree : RequestTree S) →
    (∀ R ∈ tree.leaves, generated T R ≤ behavior T observe) →
      Σ requests : List (S → S → Prop),
        RepairableSequentialStage T observe requests
  | .empty, _ => ⟨[], repairableSequentialBase T observe⟩
  | .leaf R, heach =>
      ⟨[R], repairableSequentialExtend T observe
        (repairableSequentialBase T observe) R
        (heach R (by simp [RequestTree.leaves]))⟩
  | .branch left right, heach =>
      let hleft : ∀ R ∈ left.leaves, generated T R ≤ behavior T observe :=
        fun R hR => heach R (by simp [RequestTree.leaves, hR])
      let hright : ∀ R ∈ right.leaves, generated T R ≤ behavior T observe :=
        fun R hR => heach R (by simp [RequestTree.leaves, hR])
      let a := fullRepairTreeStage observe left hleft
      let b := fullRepairTreeStage observe right hright
      let hkernel := generated_repairableStageKernel T observe b.2
      ⟨(Setoid.ker b.2.stage.read).r :: a.1,
        repairableSequentialExtend T observe a.2
          (Setoid.ker b.2.stage.read).r hkernel⟩

/-- Every recursively constructed repair tree has the generated congruence
of its leaves as its final kernel. -/
theorem fullRepairTreeStage_generated {O : Type w} (observe : S → O)
    (tree : RequestTree S)
    (heach : ∀ R ∈ tree.leaves, generated T R ≤ behavior T observe) :
    generated T (listRequest (fullRepairTreeStage T observe tree heach).1) =
      generated T (listRequest tree.leaves) := by
  induction tree with
  | empty => rfl
  | leaf R => rfl
  | branch left right ihl ihr =>
      let hleft : ∀ R ∈ left.leaves, generated T R ≤ behavior T observe :=
        fun R hR => heach R (by simp [RequestTree.leaves, hR])
      let hright : ∀ R ∈ right.leaves, generated T R ≤ behavior T observe :=
        fun R hR => heach R (by simp [RequestTree.leaves, hR])
      change generated T
        (listRequest ((Setoid.ker
          (fullRepairTreeStage T observe right hright).2.stage.read).r ::
          (fullRepairTreeStage T observe left hleft).1)) =
        generated T (listRequest (left.leaves ++ right.leaves))
      rw [generated_listRequest_cons, generated_stageKernel,
        ihl hleft, ihr hright, generated_listRequest_append]

/-- Every recursive bracketing of the same finite family is canonically
isomorphic over the original states. -/
noncomputable def fullRepairTreeCompare {O : Type w} (observe : S → O)
    (left right : RequestTree S) (h : left.leaves.Perm right.leaves)
    (heach : ∀ R ∈ left.leaves, generated T R ≤ behavior T observe) :
    (fullRepairTreeStage T observe left heach).2.stage.Carrier ≃
      (fullRepairTreeStage T observe right
        (fun R hR => heach R (h.mem_iff.mpr hR))).2.stage.Carrier :=
  stageCompare T
    (fullRepairTreeStage T observe left heach).2.stage
    (fullRepairTreeStage T observe right
      (fun R hR => heach R (h.mem_iff.mpr hR))).2.stage
    ((fullRepairTreeStage_generated T observe left heach).trans
      ((congrArg (generated T) (listRequest_perm h)).trans
        (fullRepairTreeStage_generated T observe right
          (fun R hR => heach R (h.mem_iff.mpr hR))).symm))

@[simp] theorem fullRepairTreeCompare_read {O : Type w} (observe : S → O)
    (left right : RequestTree S) (h : left.leaves.Perm right.leaves)
    (heach : ∀ R ∈ left.leaves, generated T R ≤ behavior T observe)
    (x : S) :
    fullRepairTreeCompare T observe left right h heach
      ((fullRepairTreeStage T observe left heach).2.stage.read x) =
    (fullRepairTreeStage T observe right
      (fun R hR => heach R (h.mem_iff.mpr hR))).2.stage.read x :=
  stageCompare_read T _ _ _ x

/-- Recursive-bracketing comparisons preserve every descended operation. -/
theorem fullRepairTreeCompare_step {O : Type w} (observe : S → O)
    (left right : RequestTree S) (h : left.leaves.Perm right.leaves)
    (heach : ∀ R ∈ left.leaves, generated T R ≤ behavior T observe)
    (e : E) (z : (fullRepairTreeStage T observe left heach).2.stage.Carrier) :
    fullRepairTreeCompare T observe left right h heach
      ((fullRepairTreeStage T observe left heach).2.stage.system.step e z) =
    (fullRepairTreeStage T observe right
      (fun R hR => heach R (h.mem_iff.mpr hR))).2.stage.system.step e
      (fullRepairTreeCompare T observe left right h heach z) :=
  stageCompare_step T _ _ _ e z

/-- Recursive-bracketing comparisons preserve the observations carried at
each node's repair quotient. -/
theorem fullRepairTreeCompare_observation {O : Type w} (observe : S → O)
    (left right : RequestTree S) (h : left.leaves.Perm right.leaves)
    (heach : ∀ R ∈ left.leaves, generated T R ≤ behavior T observe)
    (z : (fullRepairTreeStage T observe left heach).2.stage.Carrier) :
    SequentialStage.observation T observe
      (fullRepairTreeStage T observe right
        (fun R hR => heach R (h.mem_iff.mpr hR))).2.stage
      (fullRepairTreeStage T observe right
        (fun R hR => heach R (h.mem_iff.mpr hR))).2.repairable
      (fullRepairTreeCompare T observe left right h heach z) =
    SequentialStage.observation T observe
      (fullRepairTreeStage T observe left heach).2.stage
      (fullRepairTreeStage T observe left heach).2.repairable z :=
  stageCompare_observation T observe _ _ _ _ _ z

/-- The source square uniquely determines the comparison between full
recursive-bracketing quotient systems. -/
theorem fullRepairTreeCompare_unique {O : Type w} (observe : S → O)
    (left right : RequestTree S) (h : left.leaves.Perm right.leaves)
    (heach : ∀ R ∈ left.leaves, generated T R ≤ behavior T observe)
    (f : (fullRepairTreeStage T observe left heach).2.stage.Carrier →
      (fullRepairTreeStage T observe right
        (fun R hR => heach R (h.mem_iff.mpr hR))).2.stage.Carrier)
    (hf : ∀ x, f ((fullRepairTreeStage T observe left heach).2.stage.read x) =
      (fullRepairTreeStage T observe right
        (fun R hR => heach R (h.mem_iff.mpr hR))).2.stage.read x) :
    f = fullRepairTreeCompare T observe left right h heach :=
  stageCompare_unique T _ _ _ f hf

/-- Composing comparisons among any three fully evaluated bracketings is
the direct comparison. -/
theorem fullRepairTreeCompare_coherent {O : Type w} (observe : S → O)
    (a b c : RequestTree S)
    (hab : a.leaves.Perm b.leaves) (hbc : b.leaves.Perm c.leaves)
    (heach : ∀ R ∈ a.leaves, generated T R ≤ behavior T observe) :
    (fullRepairTreeCompare T observe a b hab heach).trans
      (fullRepairTreeCompare T observe b c hbc
        (fun R hR => heach R (hab.mem_iff.mpr hR))) =
    fullRepairTreeCompare T observe a c (hab.trans hbc) heach := by
  apply Equiv.ext
  intro z
  obtain ⟨x, rfl⟩ :=
    (fullRepairTreeStage T observe a heach).2.stage.surjective z
  simp only [Equiv.trans_apply, fullRepairTreeCompare_read]

/-- A repairable finite indexed family supplies exactly the per-leaf
premises required by its fully recursive tree. -/
theorem indexedFamily_each {I : Type w} [Fintype I]
    {O : Type*} (observe : S → O) (Rs : I → S → S → Prop)
    (h : generated T (requestUnion Rs) ≤ behavior T observe) :
    ∀ R ∈ (indexedFamilyTree Rs).leaves,
      generated T R ≤ behavior T observe := by
  intro R hR
  rw [indexedFamilyTree, requestTreeOfList_leaves] at hR
  obtain ⟨i, _, rfl⟩ := List.mem_map.mp hR
  apply (generated_le_iff T _).mpr
  intro x y hxy
  exact h (generated_contains T (show requestUnion Rs x y from ⟨i, hxy⟩))

/-- The fully recursive repair tree for a finite indexed family. -/
noncomputable def fullIndexedFamilyStage {I : Type w} [Fintype I]
    {O : Type*} (observe : S → O) (Rs : I → S → S → Prop)
    (h : generated T (requestUnion Rs) ≤ behavior T observe) :
    Σ requests : List (S → S → Prop),
      RepairableSequentialStage T observe requests :=
  fullRepairTreeStage T observe (indexedFamilyTree Rs)
    (indexedFamily_each T observe Rs h)

/-- The fully recursive indexed-family construction has exactly the direct
union quotient's kernel, even for an empty index type. -/
theorem fullIndexedFamilyStage_kernel {I : Type w} [Fintype I]
    {O : Type*} (observe : S → O) (Rs : I → S → S → Prop)
    (h : generated T (requestUnion Rs) ≤ behavior T observe) :
    Setoid.ker (fullIndexedFamilyStage T observe Rs h).2.stage.read =
      (generated T (requestUnion Rs)).setoid := by
  have hreq : listRequest (indexedFamilyTree Rs).leaves = requestUnion Rs := by
    funext x y
    exact propext (indexedFamilyTree_request_iff Rs x y)
  calc
    _ = (generated T (listRequest (fullIndexedFamilyStage T observe Rs h).1)).setoid :=
      (fullIndexedFamilyStage T observe Rs h).2.stage.kernel_eq
    _ = (generated T (listRequest (indexedFamilyTree Rs).leaves)).setoid := by
      exact congrArg OperationCongruence.setoid
        (fullRepairTreeStage_generated T observe (indexedFamilyTree Rs)
          (indexedFamily_each T observe Rs h))
    _ = (generated T (requestUnion Rs)).setoid := by rw [hreq]

/-- Direct comparison of the fully recursive finite-family repair quotient
with the quotient generated by the union request. -/
noncomputable def fullIndexedFamilyEquiv {I : Type w} [Fintype I]
    {O : Type*} (observe : S → O) (Rs : I → S → S → Prop)
    (h : generated T (requestUnion Rs) ≤ behavior T observe) :
    (fullIndexedFamilyStage T observe Rs h).2.stage.Carrier ≃
      Quotient (generated T (requestUnion Rs)).setoid :=
  (Setoid.quotientKerEquivOfSurjective
    (fullIndexedFamilyStage T observe Rs h).2.stage.read
    (fullIndexedFamilyStage T observe Rs h).2.stage.surjective).symm.trans
    (Quotient.congr (Equiv.refl _) (fun x y => by
      simp only [fullIndexedFamilyStage_kernel, Equiv.refl_apply]))

@[simp] theorem fullIndexedFamilyEquiv_read {I : Type w} [Fintype I]
    {O : Type*} (observe : S → O) (Rs : I → S → S → Prop)
    (h : generated T (requestUnion Rs) ≤ behavior T observe) (x : S) :
    fullIndexedFamilyEquiv T observe Rs h
      ((fullIndexedFamilyStage T observe Rs h).2.stage.read x) =
      Quotient.mk (generated T (requestUnion Rs)).setoid x := by
  simp [fullIndexedFamilyEquiv, Setoid.quotientKerEquivOfSurjective]
  apply Quotient.sound
  have hs := Function.rightInverse_surjInv
    (fullIndexedFamilyStage T observe Rs h).2.stage.surjective
    ((fullIndexedFamilyStage T observe Rs h).2.stage.read x)
  exact (fullIndexedFamilyStage_kernel T observe Rs h).symm ▸ hs

/-- The direct full-tree comparison preserves all named operations. -/
theorem fullIndexedFamilyEquiv_step {I : Type w} [Fintype I]
    {O : Type*} (observe : S → O) (Rs : I → S → S → Prop)
    (h : generated T (requestUnion Rs) ≤ behavior T observe)
    (e : E) (z : (fullIndexedFamilyStage T observe Rs h).2.stage.Carrier) :
    fullIndexedFamilyEquiv T observe Rs h
      ((fullIndexedFamilyStage T observe Rs h).2.stage.system.step e z) =
    (quotientSystem T (generated T (requestUnion Rs))).step e
      (fullIndexedFamilyEquiv T observe Rs h z) := by
  obtain ⟨x, rfl⟩ := (fullIndexedFamilyStage T observe Rs h).2.stage.surjective z
  rw [← (fullIndexedFamilyStage T observe Rs h).2.stage.step_comm,
    fullIndexedFamilyEquiv_read, fullIndexedFamilyEquiv_read,
    quotientSystem_step_mk]

/-- The direct full-tree comparison preserves the observation descended
through every recursive repair node. -/
theorem fullIndexedFamilyEquiv_observation {I : Type w} [Fintype I]
    {O : Type*} (observe : S → O) (Rs : I → S → S → Prop)
    (h : generated T (requestUnion Rs) ≤ behavior T observe)
    (z : (fullIndexedFamilyStage T observe Rs h).2.stage.Carrier) :
    quotientObservation T observe (generated T (requestUnion Rs)) h
      (fullIndexedFamilyEquiv T observe Rs h z) =
    SequentialStage.observation T observe
      (fullIndexedFamilyStage T observe Rs h).2.stage
      (fullIndexedFamilyStage T observe Rs h).2.repairable z := by
  obtain ⟨x, rfl⟩ := (fullIndexedFamilyStage T observe Rs h).2.stage.surjective z
  simp only [fullIndexedFamilyEquiv_read, quotientObservation_mk,
    SequentialStage.observation_read]

/-- The source square uniquely determines the direct full-tree comparison. -/
theorem fullIndexedFamilyEquiv_unique {I : Type w} [Fintype I]
    {O : Type*} (observe : S → O) (Rs : I → S → S → Prop)
    (h : generated T (requestUnion Rs) ≤ behavior T observe)
    (f : (fullIndexedFamilyStage T observe Rs h).2.stage.Carrier →
      Quotient (generated T (requestUnion Rs)).setoid)
    (hf : ∀ x, f ((fullIndexedFamilyStage T observe Rs h).2.stage.read x) =
      Quotient.mk (generated T (requestUnion Rs)).setoid x) :
    f = fullIndexedFamilyEquiv T observe Rs h := by
  funext z
  obtain ⟨x, rfl⟩ := (fullIndexedFamilyStage T observe Rs h).2.stage.surjective z
  exact (hf x).trans (fullIndexedFamilyEquiv_read T observe Rs h x).symm

/-- At a recursive node, the quotient generated by the right child's
constructed kernel is exactly the quotient generated by the image of that
subtree's raw requests under the current left source map. -/
theorem fullTree_branch_image (left right : RequestTree S) :
    generated (fullTreeStage T left).2.system
      (mappedRequest (fullTreeStage T left).2.read
        (Setoid.ker (fullTreeStage T right).2.read).r) =
    generated (fullTreeStage T left).2.system
      (mappedRequest (fullTreeStage T left).2.read
        (listRequest right.leaves)) := by
  apply generated_mappedRequest_congr T
    (fullTreeStage T left).2.system (fullTreeStage T left).2.read
    (fullTreeStage T left).2.step_comm
  exact (generated_stageKernel T (fullTreeStage T right).2).trans
    (fullTreeStage_generated T right)

/-- The same raw-image identification holds at each repair-carrying node. -/
theorem fullRepairTree_branch_image {O : Type w} (observe : S → O)
    (left right : RequestTree S)
    (hleft : ∀ R ∈ left.leaves, generated T R ≤ behavior T observe)
    (hright : ∀ R ∈ right.leaves, generated T R ≤ behavior T observe) :
    generated (fullRepairTreeStage T observe left hleft).2.stage.system
      (mappedRequest (fullRepairTreeStage T observe left hleft).2.stage.read
        (Setoid.ker (fullRepairTreeStage T observe right hright).2.stage.read).r) =
    generated (fullRepairTreeStage T observe left hleft).2.stage.system
      (mappedRequest (fullRepairTreeStage T observe left hleft).2.stage.read
        (listRequest right.leaves)) := by
  apply generated_mappedRequest_congr T
    (fullRepairTreeStage T observe left hleft).2.stage.system
    (fullRepairTreeStage T observe left hleft).2.stage.read
    (fullRepairTreeStage T observe left hleft).2.stage.step_comm
  exact (generated_stageKernel T
    (fullRepairTreeStage T observe right hright).2.stage).trans
    (fullRepairTreeStage_generated T observe right hright)

#assert_standard_axioms_only AAT.AG.OperationRepair
end AAT.AG.OperationRepair
