import ResearchLean.AG.AtlasCoefficientFiber.PushforwardCoefficient
import Mathlib.Combinatorics.SimpleGraph.Connectivity.WalkCounting
import Mathlib.LinearAlgebra.Pi

/-!
# Bounded component computation for the original incidence categories

Position: G-135 E, original category and comma components. The finite graph
below computes only the original category's Zigzag relation. It never replaces
the original incidence category used for Kan extension, its morphisms, or
its multiple incidence occurrences.

## Implementation notes

A path of length strictly less than the finite object count suffices. The
executable decision uses the original finite morphism-presence table; proofs
identify both directions with original Zigzag and original component equality.
Native Set-selected object/morphism enumeration is noncomputable transport;
the bounded finite table algorithm is computable. The original Kan cell
coordinate map and its inverse use the accepted component-value isomorphism.
-/
namespace AAT.AG.AtlasCoefficientFiber
open CategoryTheory CanonicalResolution ResolutionInvariance FaceRelationSubdivision
universe u
variable (J : Type u) [Category.{u} J]

/-- E finite graph reads original morphism existence in both directions.
Self edges are removed only for path computation, not from the original category. -/
def categoryComponentGraph : SimpleGraph J where
  Adj x y := x ≠ y ∧ Zag x y
  symm := fun _ _ h => ⟨h.1.symm, h.2.symm⟩
  loopless := ⟨fun _ h => h.1 rfl⟩

/-- Owner adjacency API retains the actual original morphism-presence relation. -/
theorem categoryComponentGraph_adj (x y : J) :
    (categoryComponentGraph J).Adj x y ↔ x ≠ y ∧ Zag x y := Iff.rfl

/-- E graph paths and original category zigzags agree in both directions. -/
theorem categoryComponentGraph_reachable_iff (x y : J) :
    (categoryComponentGraph J).Reachable x y ↔ Zigzag x y := by
  rw [SimpleGraph.reachable_iff_reflTransGen]
  constructor
  · intro h
    exact h.mono (fun _ _ hh => hh.2)
  · intro h
    induction h with
    | refl => exact Relation.ReflTransGen.refl
    | @tail b c hbc hzc ih =>
      by_cases h : b = c
      · simpa only [← h] using ih
      · exact ih.tail ⟨h, hzc⟩

/-- E decidable original morphism presence is generated by finite Hom counts,
not an oracle for the original component relation. -/
def finiteZagDecidable [∀ x y : J, Fintype (x ⟶ y)] : DecidableRel (@Zag J _) :=
  fun x y => decidable_of_iff
    ((0 < Fintype.card (x ⟶ y)) ∨ (0 < Fintype.card (y ⟶ x)))
    (or_congr Fintype.card_pos_iff Fintype.card_pos_iff)

variable [Fintype J] [DecidableEq J] [DecidableRel (@Zag J _)]

/-- E original decidable morphism-presence table supplies graph adjacency decisions. -/
instance categoryComponentGraph_decidableAdj : DecidableRel (categoryComponentGraph J).Adj :=
  fun x y => inferInstanceAs (Decidable (x ≠ y ∧ Zag x y))

/-- E bounded finite path search uses only the generated adjacency table. -/
def categoryComponentDecision (x y : J) : Bool :=
  decide (∃ n : Fin (Fintype.card J),
    ((categoryComponentGraph J).finsetWalkLength n x y).Nonempty)

/-- E bounded finite search is necessary and sufficient for the original zigzag. -/
theorem categoryComponentDecision_eq_true_iff (x y : J) :
    categoryComponentDecision J x y = true ↔ Zigzag x y := by
  rw [categoryComponentDecision, decide_eq_true_eq,
    ← SimpleGraph.reachable_iff_exists_finsetWalkLength_nonempty,
    categoryComponentGraph_reachable_iff]

/-- E bounded search tests equality in the original category's components. -/
theorem categoryComponentDecision_eq_true_iff_components (x y : J) :
    categoryComponentDecision J x y = true ↔
      CategoryTheory.ConnectedComponents.mk x = CategoryTheory.ConnectedComponents.mk y := by
  rw [categoryComponentDecision_eq_true_iff]
  exact ⟨fun h => Quotient.sound h, fun h => Quotient.exact h⟩

omit [Fintype J] [DecidableEq J] [DecidableRel (@Zag J _)] in
/-- E every generated graph component is exactly one original category component. -/
def categoryComponentEquiv : (categoryComponentGraph J).ConnectedComponent ≃
    CategoryTheory.ConnectedComponents J where
  toFun := Quot.lift (CategoryTheory.ConnectedComponents.mk)
    (fun x y h => Quotient.sound ((categoryComponentGraph_reachable_iff J x y).mp h))
  invFun := Quotient.lift (categoryComponentGraph J).connectedComponentMk
    (fun x y h => Quot.sound ((categoryComponentGraph_reachable_iff J x y).mpr h))
  left_inv x := Quot.inductionOn x (fun _ => rfl)
  right_inv x := Quotient.inductionOn x (fun _ => rfl)

omit [Fintype J] [DecidableEq J] [DecidableRel (@Zag J _)] in
/-- Owner map is identity on each original object representative. -/
theorem categoryComponentEquiv_mk (x : J) :
    categoryComponentEquiv J ((categoryComponentGraph J).connectedComponentMk x) =
      CategoryTheory.ConnectedComponents.mk x := rfl

/-- E component count is computed by finite graph path classes and equals the
original category count, including empty categories. -/
def categoryComponentCount : ℕ := Fintype.card (categoryComponentGraph J).ConnectedComponent

/-- E no replacement category count: the same original component cardinality is returned. -/
theorem categoryComponentCount_eq : categoryComponentCount J =
    Nat.card (CategoryTheory.ConnectedComponents J) := by
  rw [categoryComponentCount, ← Nat.card_eq_fintype_card]
  exact Nat.card_congr (categoryComponentEquiv J)

noncomputable section
variable {Source : Type u} {qc qf : Reading Source} {h : qc.CoarserThan qf}
variable {Nc : TargetSupportedNerve.{u,u} qc} {Nf : TargetSupportedNerve.{u,u} qf}
variable (M : IncidenceSupportedComparison qc qf h Nc Nf) (A : Set qc.Target)

/-- E original incidence objects and original incidence positions generate
the finite input table. Arbitrary Set selection is noncomputable enumeration. -/
def incidenceComponentDecision (x y : Inc Nc A) : Bool := by
  classical
  letI := Fintype.ofFinite (Inc Nc A)
  letI : ∀ x y : Inc Nc A, Fintype (x ⟶ y) := fun x y => Fintype.ofFinite _
  letI := finiteZagDecidable (Inc Nc A)
  exact categoryComponentDecision (Inc Nc A) x y

/-- E actual original incidence components are tested by the bounded kernel. -/
theorem incidenceComponentDecision_eq_true_iff (x y : Inc Nc A) :
    incidenceComponentDecision A x y = true ↔
      CategoryTheory.ConnectedComponents.mk x = CategoryTheory.ConnectedComponents.mk y := by
  classical
  letI := Fintype.ofFinite (Inc Nc A)
  letI : ∀ x y : Inc Nc A, Fintype (x ⟶ y) := fun x y => Fintype.ofFinite _
  letI := finiteZagDecidable (Inc Nc A)
  exact categoryComponentDecision_eq_true_iff_components _ x y

/-- E actual comma morphisms are finite by their faithful original right arrow. -/
instance originalCommaHomFinite (σ : Inc Nc A)
    (x y : StructuredArrow σ (Carrier.preimageFunctor M A)) : Finite (x ⟶ y) :=
  Finite.of_injective (fun f : x ⟶ y => f.right) (fun _ _ h => StructuredArrow.hom_ext _ _ h)

/-- E original finite carrier comma supplies the finite object/morphism table. -/
def commaComponentDecision (σ : Inc Nc A)
    (x y : StructuredArrow σ (Carrier.preimageFunctor M A)) : Bool := by
  classical
  letI := Fintype.ofFinite (StructuredArrow σ (Carrier.preimageFunctor M A))
  letI : ∀ x y : StructuredArrow σ (Carrier.preimageFunctor M A), Fintype (x ⟶ y) :=
    fun x y => Fintype.ofFinite _
  letI := finiteZagDecidable (StructuredArrow σ (Carrier.preimageFunctor M A))
  exact categoryComponentDecision _ x y

/-- E bounded original comma search returns exactly its original component equality. -/
theorem commaComponentDecision_eq_true_iff (σ : Inc Nc A)
    (x y : StructuredArrow σ (Carrier.preimageFunctor M A)) :
    commaComponentDecision M A σ x y = true ↔
      CategoryTheory.ConnectedComponents.mk x = CategoryTheory.ConnectedComponents.mk y := by
  classical
  letI := Fintype.ofFinite (StructuredArrow σ (Carrier.preimageFunctor M A))
  letI : ∀ x y : StructuredArrow σ (Carrier.preimageFunctor M A), Fintype (x ⟶ y) :=
    fun x y => Fintype.ofFinite _
  letI := finiteZagDecidable (StructuredArrow σ (Carrier.preimageFunctor M A))
  exact categoryComponentDecision_eq_true_iff_components _ x y

/-- E the original Kan coefficient cell in computed comma component coordinates. -/
def coefficientComponentCoordinateEquiv (σ : Inc Nc A) :
    (pushforwardCoefficients M A).obj σ ≃ₗ[ℚ]
      ((categoryComponentGraph (StructuredArrow σ (Carrier.preimageFunctor M A))).ConnectedComponent →
        ULift.{u} ℚ) :=
  (coefficientCellIso (Carrier.preimageFunctor M A) σ).toLinearEquiv.trans
    (LinearEquiv.funCongrLeft ℚ (ULift.{u} ℚ) (categoryComponentEquiv _))

/-- Owner every original coefficient is evaluated at the same original component. -/
theorem coefficientComponentCoordinateEquiv_apply (σ : Inc Nc A)
    (z : (pushforwardCoefficients M A).obj σ)
    (c : (categoryComponentGraph (StructuredArrow σ (Carrier.preimageFunctor M A))).ConnectedComponent) :
    coefficientComponentCoordinateEquiv M A σ z c =
      (coefficientCellIso (Carrier.preimageFunctor M A) σ).hom z (categoryComponentEquiv _ c) := rfl

/-- E original incidence-arrow actions in computed component coordinates still
come from the same original Kan map and actual comma precomposition. -/
theorem coefficientComponentCoordinateEquiv_map {σ τ : Inc Nc A} (f : σ ⟶ τ)
    (z : (pushforwardCoefficients M A).obj σ)
    (c : (categoryComponentGraph (StructuredArrow τ (Carrier.preimageFunctor M A))).ConnectedComponent) :
    coefficientComponentCoordinateEquiv M A τ ((pushforwardCoefficients M A).map f z) c =
      coefficientComponentCoordinateEquiv M A σ z
        ((categoryComponentEquiv _).symm
          ((StructuredArrow.map f).mapConnectedComponents (categoryComponentEquiv _ c))) := by
  rw [coefficientComponentCoordinateEquiv_apply, coefficientComponentCoordinateEquiv_apply,
    Equiv.apply_symm_apply]
  exact pushforwardCoefficients_map_component_eval M A f z (categoryComponentEquiv _ c)

/-- E comma component counts are obtained from the same bounded kernel. -/
def commaComponentCount (σ : Inc Nc A) : ℕ := by
  classical
  letI := Fintype.ofFinite (StructuredArrow σ (Carrier.preimageFunctor M A))
  letI : ∀ x y : StructuredArrow σ (Carrier.preimageFunctor M A), Fintype (x ⟶ y) :=
    fun x y => Fintype.ofFinite _
  letI := finiteZagDecidable (StructuredArrow σ (Carrier.preimageFunctor M A))
  exact categoryComponentCount (StructuredArrow σ (Carrier.preimageFunctor M A))

/-- E computed comma count is the original component cardinality used by Kan coefficients. -/
theorem commaComponentCount_eq (σ : Inc Nc A) : commaComponentCount M A σ =
    Nat.card (CategoryTheory.ConnectedComponents (StructuredArrow σ (Carrier.preimageFunctor M A))) := by
  classical
  letI := Fintype.ofFinite (StructuredArrow σ (Carrier.preimageFunctor M A))
  letI : ∀ x y : StructuredArrow σ (Carrier.preimageFunctor M A), Fintype (x ⟶ y) :=
    fun x y => Fintype.ofFinite _
  letI := finiteZagDecidable (StructuredArrow σ (Carrier.preimageFunctor M A))
  exact categoryComponentCount_eq _

end
end AAT.AG.AtlasCoefficientFiber

