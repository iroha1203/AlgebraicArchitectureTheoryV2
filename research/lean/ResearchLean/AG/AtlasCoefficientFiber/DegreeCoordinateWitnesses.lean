import ResearchLean.AG.AtlasCoefficientFiber.NativeDegreeCoordinates
import ResearchLean.AG.AtlasCoefficientFiber.WitnessThreeNonzero

/-!
# W3 original degree-two coordinates through the same rational producer

Position: G-135 E/W degree connection only. The unique none face is derived
from the specified original Option table, with all three original face names
retained. Its single-column L2 table is evaluated by the same C17 producer.

## Implementation notes

Explicit original-cell equivalences enumerate the three selected faces and
one actual none face. They supply only primitive finite enumeration, not P/Q
bases or expected ranks. The table entry equality is proved against original
primitiveL2Matrix; computed projection ranks are then transported to the
original Kan P and dual-L Q through the general native coordinate theorems.
The kernel evaluates the same producer with `decide +kernel`. This degree
calculation is a connection witness and does not claim the remaining complete
W3 homology, transgression, Law, or cone computations.
-/

noncomputable section
namespace AAT.AG.AtlasCoefficientFiber.WitnessThree
open CanonicalResolution ResolutionInvariance FaceRelationSubdivision WitnessCommon Matrix
open RationalCoordinates AAT.AG.ResolutionInvariance.ExecutableRationalLinearAlgebra

/-- Owner enumeration retains the three original W3 selected face names,
with both inverse equations proved using the original selected-face API. -/
def degreeFaceEquiv : Fin 3 ≃ Nf.FaceInTargetSubset
    (comparisonFactor qc qf coarser ⁻¹' (Set.univ : Set Bool)) where
  toFun := selectedFace
  invFun := Subtype.val
  left_inv := selectedFace_val
  right_inv x := Subtype.ext (selectedFace_val x.1)

/-- Owner enumeration value is the same original face name. -/
theorem degreeFaceEquiv_val (i : Fin 3) : (degreeFaceEquiv i).1 = i := selectedFace_val i

/-- Owner original none-face name is derived from the actual Option table,
not supplied as a dimension or a homology basis. -/
theorem degreeNoneFace_name (f : DegenerateFace M Set.univ) : f.1.1 = 2 :=
  (faceMap_none_iff f.1.1).mp f.2

/-- Owner enumeration contains exactly the original none face m, with both
inverses proved from its primitive table name. -/
def degreeNoneFaceEquiv : Fin 1 ≃ DegenerateFace M Set.univ where
  toFun _ := ⟨selectedFace 2, (faceMap_none_iff 2).mpr rfl⟩
  invFun _ := 0
  left_inv i := Subsingleton.elim _ i
  right_inv f := by
    apply Subtype.ext
    apply Subtype.ext
    rw [selectedFace_val]
    exact (degreeNoneFace_name f).symm

/-- Owner none-face enumeration retains the original selected m cell. -/
theorem degreeNoneFaceEquiv_val (i : Fin 1) : (degreeNoneFaceEquiv i).1 = selectedFace 2 := rfl

/-- W3 original finite face enumeration is generated by its cell equivalence. -/
local instance degreeFaceFintype : Fintype (Nf.FaceInTargetSubset
    (comparisonFactor qc qf coarser ⁻¹' (Set.univ : Set Bool))) :=
  Fintype.ofEquiv (Fin 3) degreeFaceEquiv

/-- W3 original none-face finite enumeration is derived from the Option table. -/
local instance degreeNoneFaceFintype : Fintype (DegenerateFace M Set.univ) :=
  Fintype.ofEquiv (Fin 1) degreeNoneFaceEquiv

/-- W3 original face equality is its underlying finite cell equality. -/
local instance degreeFaceDecidableEq : DecidableEq (Nf.FaceInTargetSubset
    (comparisonFactor qc qf coarser ⁻¹' (Set.univ : Set Bool))) := inferInstance

/-- W3 original none-face equality uses the same named finite cells. -/
local instance degreeNoneFaceDecidableEq : DecidableEq (DegenerateFace M Set.univ) := inferInstance

/-- W3 computational L2 table is the original none-face single column;
it has three original face rows and the actual none-face column. -/
def degreeL2Table : Matrix (Nf.FaceInTargetSubset
    (comparisonFactor qc qf coarser ⁻¹' (Set.univ : Set Bool))) (DegenerateFace M Set.univ) ℚ :=
  fun f _ => if f.1 = 2 then 1 else 0

/-- Owner table entry gives the original none-face coefficient. -/
theorem degreeL2Table_entry (f : Nf.FaceInTargetSubset
    (comparisonFactor qc qf coarser ⁻¹' (Set.univ : Set Bool))) (m : DegenerateFace M Set.univ) :
    degreeL2Table f m = if f.1 = 2 then 1 else 0 := rfl

/-- E/W3 the computational table equals the original primitive L2 matrix on
all rows and columns; no supplied quotient or replacement complex is used. -/
theorem primitiveL2Matrix_eq_degreeL2Table : primitiveL2Matrix M Set.univ = degreeL2Table := by
  ext f m
  rw [primitiveL2Matrix_entry, degreeL2Table_entry]
  simp only [Finsupp.single_apply, Subtype.ext_iff, degreeNoneFace_name]
  simp only [eq_comm]

/-- E/W3 the same image producer computes the none-face coordinate projector
from the original primitive table, with all original face names retained. -/
theorem degreeL2Table_image : imageProjection degreeL2Table =
    fun i j => if i.1 = 2 ∧ j.1 = 2 then 1 else 0 := by
  decide +kernel

/-- E/W3 the same transpose-kernel producer computes both original mapped
face coordinates; no desired P dimension is supplied to the algorithm. -/
theorem degreeL2Table_annihilator : kernelProjection degreeL2Tableᵀ =
    fun i j => if i.1 = j.1 ∧ i.1 ≠ 2 then 1 else 0 := by
  decide +kernel

/-- E/W3 kernel evaluation of the same producer reads both computed ranks
from the original none-face column, instead of an expected-rank certificate. -/
theorem degreeL2Table_projection_ranks :
    (rationalMatrixRank (kernelProjection degreeL2Tableᵀ),
      rationalMatrixRank (imageProjection degreeL2Table)) = (2, 1) := by
  decide +kernel

/-- E/W3 actual native P projection is the same producer on the proved
original primitive none-face table. -/
theorem nativeP2Projection_eq_degreeProducer : nativeP2Projection M Set.univ =
    kernelProjection degreeL2Tableᵀ := by
  rw [nativeP2Projection_eq, primitiveL2Matrix_eq_degreeL2Table]

/-- E/W3 actual native Q projection uses that same original table producer. -/
theorem nativeQ2Projection_eq_degreeProducer : nativeQ2Projection M Set.univ =
    imageProjection degreeL2Table := by
  rw [nativeQ2Projection_eq, primitiveL2Matrix_eq_degreeL2Table]

/-- E/W3 original P degree-two dimension follows from the general native
coordinate theorem and actual kernel-evaluated rank of its primitive table. -/
theorem pushforward_degree2_finrank : Module.finrank ℚ (pushforwardComplex M Set.univ).C2 = 2 := by
  rw [← nativeP2Projection_rank, nativeP2Projection_eq_degreeProducer]
  exact congrArg Prod.fst degreeL2Table_projection_ranks

/-- E/W3 actual dual-L Q degree-two dimension uses the same computed rank,
with the general restriction coordinate equivalence proving the connection. -/
theorem restriction_degree2_finrank : Module.finrank ℚ (restrictionComplex M Set.univ).C2 = 1 := by
  rw [← nativeQ2Projection_rank, nativeQ2Projection_eq_degreeProducer]
  exact congrArg Prod.snd degreeL2Table_projection_ranks

end AAT.AG.AtlasCoefficientFiber.WitnessThree

