import ResearchLean.AG.DoctrineFiberProduct.CartesianRegimeReindexingCleavageCoherence

/-!
# Presentation replacement for selected cartesian reindexing

This module places finite-presentation provenance over one literal semantic
input.  Every such provenance value produces the accepted selected reindexing
functor, and cartesian uniqueness supplies its canonical comparison with every
other provenance value in the same fiber.

For typed presentations with exact finite-code endpoints, equality of decoded
semantic arrows retags only the strong-cartesianness proposition of a selected
lift.  No complete functor is transported.  The resulting component
comparisons, triangles, naturality, and whole-comparison coherence are therefore
generated internally from the selected lifts.

## Implementation notes

A selected reindexing functor is dependently indexed by the semantic source and
target of its `RealizableHom`.  Equality of decoded arrows alone therefore does
not type a direct natural isomorphism between presentations with different
endpoint codes.  This module first places authored provenance over one literal
`CartSemanticInput`; the exact-endpoint specialization then reuses the second
selected lift while rewriting only its strong-cartesianness proposition.  It
deliberately rejects transporting a complete `RealizableHom` or functor as the
answer.  Quotient-level packaging is supplied separately from these generated
representative comparisons.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open CategoryTheory
open AtomFoundation
open CrossStageCoherence

set_option maxHeartbeats 2000000

/-! ## Finite provenance over one literal semantic input -/

/--
A finite cartesian presentation whose decoder is one fixed literal semantic
input.  The structure records realization provenance only; it contains no
lift, cleavage, comparison, or coherence certificate.
-/
structure CartRealizationProvenance
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : CartSemanticInput U) where
  /-- The finite validated presentation supplying the provenance. -/
  presentation : CartPresentation U
  /-- The fixed semantic input is exactly the presentation's decoder output. -/
  realization_eq : input = toSemanticCart presentation

namespace CartRealizationProvenance

/-- Package fixed-input provenance as the existing realization-image input. -/
def toRealizableHom
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {input : CartSemanticInput U}
    (provenance : CartRealizationProvenance input) : RealizableHom U where
  semantic := input
  presentation := provenance.presentation
  realization_eq := provenance.realization_eq

end CartRealizationProvenance

namespace RealizableHom

/-- Forget a realization package down to provenance over its literal semantic input. -/
def provenance
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U) : CartRealizationProvenance input.semantic where
  presentation := input.presentation
  realization_eq := input.realization_eq

end RealizableHom

/-! ## The arbitrary selected-cleavage bridge -/

/--
The object generated by the selected cleavage is canonically the object of the
accepted selected reindexing functor for an arbitrary realization package.
-/
noncomputable def selectedCoreFiberCleavageBridgeApp
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    (targetPackage : CoreFiber input.semantic.target) :
    (selectedCoreFiberCartesianCleavage input).reindexFunctor.obj
        targetPackage ≅
      (selectedCoreFiberReindexFunctor input).obj targetPackage where
  hom := ⟨𝟙 (selectedCoreFiberCartesianLift input targetPackage).domain, by
    let lift := selectedCoreFiberCartesianLift input targetPackage
    letI := lift.isStronglyCartesian
    exact CategoryTheory.IsHomLift.id lift.domainObject.2⟩
  inv := ⟨𝟙 (selectedCoreFiberCartesianLift input targetPackage).domain, by
    let lift := selectedCoreFiberCartesianLift input targetPackage
    letI := lift.isStronglyCartesian
    exact CategoryTheory.IsHomLift.id lift.domainObject.2⟩
  hom_inv_id := by
    apply CategoryTheory.Functor.Fiber.hom_ext
    change
      (𝟙 (selectedCoreFiberCartesianLift input targetPackage).domain) ≫
          𝟙 (selectedCoreFiberCartesianLift input targetPackage).domain =
        𝟙 (selectedCoreFiberCartesianLift input targetPackage).domain
    simp
  inv_hom_id := by
    apply CategoryTheory.Functor.Fiber.hom_ext
    change
      (𝟙 (selectedCoreFiberCartesianLift input targetPackage).domain) ≫
          𝟙 (selectedCoreFiberCartesianLift input targetPackage).domain =
        𝟙 (selectedCoreFiberCartesianLift input targetPackage).domain
    simp

/-- The arbitrary selected bridge fixes the generated lift triangle. -/
theorem selectedCoreFiberCleavageBridgeApp_hom_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    (targetPackage : CoreFiber input.semantic.target) :
    (selectedCoreFiberCleavageBridgeApp input targetPackage).hom.1 ≫
        (selectedCoreFiberCartesianLift input targetPackage).hom =
      (selectedCoreFiberCartesianLift input targetPackage).hom := by
  change
    𝟙 (selectedCoreFiberCartesianLift input targetPackage).domain ≫
        (selectedCoreFiberCartesianLift input targetPackage).hom =
      (selectedCoreFiberCartesianLift input targetPackage).hom
  simp

/-- The arbitrary selected bridge is natural on every vertical target map. -/
theorem selectedCoreFiberCleavageBridge_naturality
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    {sourcePackage targetPackage : CoreFiber input.semantic.target}
    (hom : sourcePackage ⟶ targetPackage) :
    (selectedCoreFiberCartesianCleavage input).reindexFunctor.map hom ≫
        (selectedCoreFiberCleavageBridgeApp input targetPackage).hom =
      (selectedCoreFiberCleavageBridgeApp input sourcePackage).hom ≫
        (selectedCoreFiberReindexFunctor input).map hom := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let targetLift := selectedCoreFiberCartesianLift input targetPackage
  letI := targetLift.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U) input.semantic.hom targetLift.hom
    (𝟙 input.semantic.source)
  change
    (((selectedCoreFiberCartesianCleavage input).reindexFunctor.map hom).1 ≫
      (selectedCoreFiberCleavageBridgeApp input targetPackage).hom.1) ≫
        targetLift.hom =
      ((selectedCoreFiberCleavageBridgeApp input sourcePackage).hom.1 ≫
        ((selectedCoreFiberReindexFunctor input).map hom).1) ≫
          targetLift.hom
  calc
    _ = ((selectedCoreFiberCartesianCleavage input).reindexFunctor.map hom).1 ≫
        ((selectedCoreFiberCleavageBridgeApp input targetPackage).hom.1 ≫
          targetLift.hom) := Category.assoc _ _ _
    _ = ((selectedCoreFiberCartesianCleavage input).reindexFunctor.map hom).1 ≫
        targetLift.hom := by
      rw [selectedCoreFiberCleavageBridgeApp_hom_fac]
    _ = (selectedCoreFiberCartesianLift input sourcePackage).hom ≫ hom.1 :=
      (selectedCoreFiberCartesianCleavage input).reindexFunctor_map_fac hom
    _ = ((selectedCoreFiberCleavageBridgeApp input sourcePackage).hom.1 ≫
        (selectedCoreFiberCartesianLift input sourcePackage).hom) ≫ hom.1 := by
      rw [selectedCoreFiberCleavageBridgeApp_hom_fac]
    _ = (selectedCoreFiberCleavageBridgeApp input sourcePackage).hom.1 ≫
        ((selectedCoreFiberCartesianLift input sourcePackage).hom ≫ hom.1) :=
      Category.assoc _ _ _
    _ = (selectedCoreFiberCleavageBridgeApp input sourcePackage).hom.1 ≫
        (((selectedCoreFiberReindexFunctor input).map hom).1 ≫
          targetLift.hom) := by
      rw [selectedCoreFiberReindexFunctor_map_fac]
    _ = _ := (Category.assoc _ _ _).symm

/--
The selected-cleavage functor is canonically identified with the accepted
selected reindexing functor for every realization package.
-/
noncomputable def selectedCoreFiberCleavageBridge
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U) :
    (selectedCoreFiberCartesianCleavage input).reindexFunctor ≅
      selectedCoreFiberReindexFunctor input :=
  NatIso.ofComponents (selectedCoreFiberCleavageBridgeApp input)
    (fun hom => selectedCoreFiberCleavageBridge_naturality input hom)

/-! ## Canonical comparison over one literal semantic input -/

/--
The canonical component comparing the selected functors generated from two
finite provenances over the same literal semantic input.
-/
noncomputable def cartRealizationProvenanceComparisonApp
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {input : CartSemanticInput U}
    (first second : CartRealizationProvenance input)
    (targetPackage : CoreFiber input.target) :
    (selectedCoreFiberReindexFunctor first.toRealizableHom).obj targetPackage ≅
      (selectedCoreFiberReindexFunctor second.toRealizableHom).obj
        targetPackage where
  hom := ⟨(StrongCartesianLift.domainIso
      (selectedCoreFiberCartesianLift second.toRealizableHom targetPackage)
      (selectedCoreFiberCartesianLift first.toRealizableHom targetPackage)).hom,
    StrongCartesianLift.domainIso_hom_isHomLift
      (selectedCoreFiberCartesianLift second.toRealizableHom targetPackage)
      (selectedCoreFiberCartesianLift first.toRealizableHom targetPackage)⟩
  inv := ⟨(StrongCartesianLift.domainIso
      (selectedCoreFiberCartesianLift second.toRealizableHom targetPackage)
      (selectedCoreFiberCartesianLift first.toRealizableHom targetPackage)).inv,
    StrongCartesianLift.domainIso_inv_isHomLift
      (selectedCoreFiberCartesianLift second.toRealizableHom targetPackage)
      (selectedCoreFiberCartesianLift first.toRealizableHom targetPackage)⟩
  hom_inv_id := by
    apply CategoryTheory.Functor.Fiber.hom_ext
    exact (StrongCartesianLift.domainIso
      (selectedCoreFiberCartesianLift second.toRealizableHom targetPackage)
      (selectedCoreFiberCartesianLift first.toRealizableHom
        targetPackage)).hom_inv_id
  inv_hom_id := by
    apply CategoryTheory.Functor.Fiber.hom_ext
    exact (StrongCartesianLift.domainIso
      (selectedCoreFiberCartesianLift second.toRealizableHom targetPackage)
      (selectedCoreFiberCartesianLift first.toRealizableHom
        targetPackage)).inv_hom_id

/-- The forward provenance comparison followed by the second lift is the first lift. -/
theorem cartRealizationProvenanceComparisonApp_hom_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {input : CartSemanticInput U}
    (first second : CartRealizationProvenance input)
    (targetPackage : CoreFiber input.target) :
    (cartRealizationProvenanceComparisonApp first second
      targetPackage).hom.1 ≫
        (selectedCoreFiberCartesianLift second.toRealizableHom
          targetPackage).hom =
      (selectedCoreFiberCartesianLift first.toRealizableHom
        targetPackage).hom :=
  StrongCartesianLift.domainIso_hom_fac _ _

/-- The inverse provenance comparison followed by the first lift is the second lift. -/
theorem cartRealizationProvenanceComparisonApp_inv_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {input : CartSemanticInput U}
    (first second : CartRealizationProvenance input)
    (targetPackage : CoreFiber input.target) :
    (cartRealizationProvenanceComparisonApp first second
      targetPackage).inv.1 ≫
        (selectedCoreFiberCartesianLift first.toRealizableHom
          targetPackage).hom =
      (selectedCoreFiberCartesianLift second.toRealizableHom
        targetPackage).hom :=
  StrongCartesianLift.domainIso_inv_fac _ _

/-- The selected provenance comparison is natural on every vertical target map. -/
theorem cartRealizationProvenanceComparison_naturality
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {input : CartSemanticInput U}
    (first second : CartRealizationProvenance input)
    {sourcePackage targetPackage : CoreFiber input.target}
    (hom : sourcePackage ⟶ targetPackage) :
    (selectedCoreFiberReindexFunctor first.toRealizableHom).map hom ≫
        (cartRealizationProvenanceComparisonApp first second
          targetPackage).hom =
      (cartRealizationProvenanceComparisonApp first second
        sourcePackage).hom ≫
        (selectedCoreFiberReindexFunctor second.toRealizableHom).map hom := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let secondTarget := selectedCoreFiberCartesianLift
    second.toRealizableHom targetPackage
  letI : (packageProjection U).IsStronglyCartesian input.hom
      secondTarget.hom := secondTarget.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U) input.hom secondTarget.hom (𝟙 input.source)
  change
    ((selectedCoreFiberReindexFunctor first.toRealizableHom).map hom).1 ≫
        (cartRealizationProvenanceComparisonApp first second
          targetPackage).hom.1 ≫ secondTarget.hom =
      (cartRealizationProvenanceComparisonApp first second
        sourcePackage).hom.1 ≫
        ((selectedCoreFiberReindexFunctor second.toRealizableHom).map hom).1 ≫
          secondTarget.hom
  calc
    _ = ((selectedCoreFiberReindexFunctor first.toRealizableHom).map hom).1 ≫
        ((cartRealizationProvenanceComparisonApp first second
          targetPackage).hom.1 ≫ secondTarget.hom) := Category.assoc _ _ _
    _ = ((selectedCoreFiberReindexFunctor first.toRealizableHom).map hom).1 ≫
        (selectedCoreFiberCartesianLift first.toRealizableHom
          targetPackage).hom := by
      rw [cartRealizationProvenanceComparisonApp_hom_fac]
    _ = (selectedCoreFiberCartesianLift first.toRealizableHom
        sourcePackage).hom ≫ hom.1 :=
      selectedCoreFiberReindexFunctor_map_fac first.toRealizableHom hom
    _ = ((cartRealizationProvenanceComparisonApp first second
        sourcePackage).hom.1 ≫
          (selectedCoreFiberCartesianLift second.toRealizableHom
            sourcePackage).hom) ≫ hom.1 := by
      rw [cartRealizationProvenanceComparisonApp_hom_fac]
    _ = (cartRealizationProvenanceComparisonApp first second
        sourcePackage).hom.1 ≫
          ((selectedCoreFiberCartesianLift second.toRealizableHom
            sourcePackage).hom ≫ hom.1) := Category.assoc _ _ _
    _ = (cartRealizationProvenanceComparisonApp first second
        sourcePackage).hom.1 ≫
          (((selectedCoreFiberReindexFunctor second.toRealizableHom).map hom).1 ≫
            secondTarget.hom) := by
      rw [selectedCoreFiberReindexFunctor_map_fac]
    _ = _ := (Category.assoc _ _ _).symm

/-- The canonical natural isomorphism comparing two fixed-input provenances. -/
noncomputable def cartRealizationProvenanceComparison
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {input : CartSemanticInput U}
    (first second : CartRealizationProvenance input) :
    selectedCoreFiberReindexFunctor first.toRealizableHom ≅
      selectedCoreFiberReindexFunctor second.toRealizableHom :=
  NatIso.ofComponents (cartRealizationProvenanceComparisonApp first second)
    (fun hom => cartRealizationProvenanceComparison_naturality first second hom)

/-- The whole selected comparison of one provenance with itself is reflexive. -/
theorem cartRealizationProvenanceComparison_refl
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {input : CartSemanticInput U}
    (provenance : CartRealizationProvenance input) :
    cartRealizationProvenanceComparison provenance provenance =
      Iso.refl (selectedCoreFiberReindexFunctor provenance.toRealizableHom) := by
  apply Iso.ext
  apply NatTrans.ext
  funext targetPackage
  apply CategoryTheory.Functor.Fiber.hom_ext
  let targetLift := selectedCoreFiberCartesianLift
    provenance.toRealizableHom targetPackage
  letI : (packageProjection U).IsStronglyCartesian input.hom
      targetLift.hom := targetLift.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U) input.hom targetLift.hom (𝟙 input.source)
  change
    (cartRealizationProvenanceComparisonApp provenance provenance
      targetPackage).hom.1 ≫ targetLift.hom =
      𝟙 targetLift.domain ≫ targetLift.hom
  rw [cartRealizationProvenanceComparisonApp_hom_fac]
  simp
  rfl

/-- Reversing a provenance comparison gives the comparison in the opposite direction. -/
theorem cartRealizationProvenanceComparison_symm
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {input : CartSemanticInput U}
    (first second : CartRealizationProvenance input) :
    (cartRealizationProvenanceComparison first second).symm =
      cartRealizationProvenanceComparison second first := by
  apply Iso.ext
  apply NatTrans.ext
  funext targetPackage
  apply CategoryTheory.Functor.Fiber.hom_ext
  let firstTarget := selectedCoreFiberCartesianLift
    first.toRealizableHom targetPackage
  letI : (packageProjection U).IsStronglyCartesian input.hom
      firstTarget.hom := firstTarget.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U) input.hom firstTarget.hom (𝟙 input.source)
  change
    (cartRealizationProvenanceComparisonApp first second
      targetPackage).inv.1 ≫ firstTarget.hom =
      (cartRealizationProvenanceComparisonApp second first
        targetPackage).hom.1 ≫ firstTarget.hom
  rw [cartRealizationProvenanceComparisonApp_inv_fac,
    cartRealizationProvenanceComparisonApp_hom_fac]

/-- Whole selected provenance comparisons satisfy the three-presentation cocycle. -/
theorem cartRealizationProvenanceComparison_cocycle
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {input : CartSemanticInput U}
    (first second third : CartRealizationProvenance input) :
    (cartRealizationProvenanceComparison first second).trans
        (cartRealizationProvenanceComparison second third) =
      cartRealizationProvenanceComparison first third := by
  apply Iso.ext
  apply NatTrans.ext
  funext targetPackage
  apply CategoryTheory.Functor.Fiber.hom_ext
  let thirdTarget := selectedCoreFiberCartesianLift
    third.toRealizableHom targetPackage
  letI : (packageProjection U).IsStronglyCartesian input.hom
      thirdTarget.hom := thirdTarget.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U) input.hom thirdTarget.hom (𝟙 input.source)
  change
    ((cartRealizationProvenanceComparisonApp first second
      targetPackage).hom.1 ≫
        (cartRealizationProvenanceComparisonApp second third
          targetPackage).hom.1) ≫ thirdTarget.hom =
      (cartRealizationProvenanceComparisonApp first third
        targetPackage).hom.1 ≫ thirdTarget.hom
  rw [Category.assoc, cartRealizationProvenanceComparisonApp_hom_fac,
    cartRealizationProvenanceComparisonApp_hom_fac,
    cartRealizationProvenanceComparisonApp_hom_fac]

/-! ## Exact-endpoint typed presentation replacement -/

/--
Equality of decoded arrows with fixed finite-code endpoints gives equality of
the corresponding semantic-input structures.
-/
theorem typedCartSemanticInput_eq_of_hom_eq
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (first second : CartPresentationBetween source target)
    (semantic_eq : typedPresentationToSemantic first =
      typedPresentationToSemantic second) :
    typedCartSemanticInput first = typedCartSemanticInput second := by
  change
    ({ source := source.toSemantic
       target := target.toSemantic
       hom := typedPresentationToSemantic first } : CartSemanticInput U) =
      { source := source.toSemantic
        target := target.toSemantic
        hom := typedPresentationToSemantic second }
  rw [semantic_eq]

/-- A typed presentation supplies provenance over its own literal semantic input. -/
def typedCartRealizationProvenance
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target) :
    CartRealizationProvenance (typedCartSemanticInput presentation) :=
  (typedRealizableHom presentation).provenance

/--
Rebase a second exact-endpoint presentation to the first presentation's literal
semantic input using only their decoded-arrow equality.
-/
def typedCartRealizationProvenanceOfSemanticEq
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (first second : CartPresentationBetween source target)
    (semantic_eq : typedPresentationToSemantic first =
      typedPresentationToSemantic second) :
    CartRealizationProvenance (typedCartSemanticInput first) where
  presentation := second.toPresentation
  realization_eq :=
    (typedCartSemanticInput_eq_of_hom_eq first second semantic_eq).trans
      (typedRealizableHom second).realization_eq

/--
The second selected typed lift, with only its strong-cartesianness proposition
retagged to the first presentation's equal semantic input.
-/
private noncomputable def selectedTypedCoreFiberCartesianLiftRebased
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (first second : CartPresentationBetween source target)
    (semantic_eq : typedPresentationToSemantic first =
      typedPresentationToSemantic second)
    (targetPackage : CoreFiber target.toSemantic) :
    StrongCartesianLift (typedCartSemanticInput first) targetPackage := by
  let lift := selectedTypedCoreFiberCartesianLift second targetPackage
  exact
    { domain := lift.domain
      hom := lift.hom
      isStronglyCartesian := by
        change (packageProjection U).IsStronglyCartesian
          (typedPresentationToSemantic first) lift.hom
        rw [semantic_eq]
        exact lift.isStronglyCartesian }

/--
The canonical component comparing selected reindexing for two exact-endpoint
presentations with equal decoded semantic arrows.
-/
noncomputable def selectedTypedCoreFiberPresentationComparisonApp
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (first second : CartPresentationBetween source target)
    (semantic_eq : typedPresentationToSemantic first =
      typedPresentationToSemantic second)
    (targetPackage : CoreFiber target.toSemantic) :
    (selectedTypedCoreFiberReindexFunctor first).obj targetPackage ≅
      (selectedTypedCoreFiberReindexFunctor second).obj targetPackage where
  hom := ⟨(StrongCartesianLift.domainIso
      (selectedTypedCoreFiberCartesianLiftRebased first second semantic_eq
        targetPackage)
      (selectedTypedCoreFiberCartesianLift first targetPackage)).hom,
    StrongCartesianLift.domainIso_hom_isHomLift
      (selectedTypedCoreFiberCartesianLiftRebased first second semantic_eq
        targetPackage)
      (selectedTypedCoreFiberCartesianLift first targetPackage)⟩
  inv := ⟨(StrongCartesianLift.domainIso
      (selectedTypedCoreFiberCartesianLiftRebased first second semantic_eq
        targetPackage)
      (selectedTypedCoreFiberCartesianLift first targetPackage)).inv,
    StrongCartesianLift.domainIso_inv_isHomLift
      (selectedTypedCoreFiberCartesianLiftRebased first second semantic_eq
        targetPackage)
      (selectedTypedCoreFiberCartesianLift first targetPackage)⟩
  hom_inv_id := by
    apply CategoryTheory.Functor.Fiber.hom_ext
    exact (StrongCartesianLift.domainIso
      (selectedTypedCoreFiberCartesianLiftRebased first second semantic_eq
        targetPackage)
      (selectedTypedCoreFiberCartesianLift first targetPackage)).hom_inv_id
  inv_hom_id := by
    apply CategoryTheory.Functor.Fiber.hom_ext
    exact (StrongCartesianLift.domainIso
      (selectedTypedCoreFiberCartesianLiftRebased first second semantic_eq
        targetPackage)
      (selectedTypedCoreFiberCartesianLift first targetPackage)).inv_hom_id

/-- The forward typed comparison followed by the second lift is the first lift. -/
theorem selectedTypedCoreFiberPresentationComparisonApp_hom_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (first second : CartPresentationBetween source target)
    (semantic_eq : typedPresentationToSemantic first =
      typedPresentationToSemantic second)
    (targetPackage : CoreFiber target.toSemantic) :
    (selectedTypedCoreFiberPresentationComparisonApp first second semantic_eq
      targetPackage).hom.1 ≫
        (selectedTypedCoreFiberCartesianLift second targetPackage).hom =
      (selectedTypedCoreFiberCartesianLift first targetPackage).hom := by
  change
    (StrongCartesianLift.domainIso
      (selectedTypedCoreFiberCartesianLiftRebased first second semantic_eq
        targetPackage)
      (selectedTypedCoreFiberCartesianLift first targetPackage)).hom ≫
        (selectedTypedCoreFiberCartesianLiftRebased first second semantic_eq
          targetPackage).hom =
      (selectedTypedCoreFiberCartesianLift first targetPackage).hom
  exact StrongCartesianLift.domainIso_hom_fac _ _

/-- The inverse typed comparison followed by the first lift is the second lift. -/
theorem selectedTypedCoreFiberPresentationComparisonApp_inv_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (first second : CartPresentationBetween source target)
    (semantic_eq : typedPresentationToSemantic first =
      typedPresentationToSemantic second)
    (targetPackage : CoreFiber target.toSemantic) :
    (selectedTypedCoreFiberPresentationComparisonApp first second semantic_eq
      targetPackage).inv.1 ≫
        (selectedTypedCoreFiberCartesianLift first targetPackage).hom =
      (selectedTypedCoreFiberCartesianLift second targetPackage).hom := by
  change
    (StrongCartesianLift.domainIso
      (selectedTypedCoreFiberCartesianLiftRebased first second semantic_eq
        targetPackage)
      (selectedTypedCoreFiberCartesianLift first targetPackage)).inv ≫
        (selectedTypedCoreFiberCartesianLift first targetPackage).hom =
      (selectedTypedCoreFiberCartesianLiftRebased first second semantic_eq
        targetPackage).hom
  exact StrongCartesianLift.domainIso_inv_fac _ _

/-- The exact-endpoint typed comparison is natural on every vertical target map. -/
theorem selectedTypedCoreFiberPresentationComparison_naturality
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (first second : CartPresentationBetween source target)
    (semantic_eq : typedPresentationToSemantic first =
      typedPresentationToSemantic second)
    {sourcePackage targetPackage : CoreFiber target.toSemantic}
    (hom : sourcePackage ⟶ targetPackage) :
    (selectedTypedCoreFiberReindexFunctor first).map hom ≫
        (selectedTypedCoreFiberPresentationComparisonApp first second
          semantic_eq targetPackage).hom =
      (selectedTypedCoreFiberPresentationComparisonApp first second
        semantic_eq sourcePackage).hom ≫
        (selectedTypedCoreFiberReindexFunctor second).map hom := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let secondTarget := selectedTypedCoreFiberCartesianLift second targetPackage
  letI := secondTarget.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U) (typedCartSemanticInput second).hom
    secondTarget.hom (𝟙 source.toSemantic)
  change
    ((selectedTypedCoreFiberReindexFunctor first).map hom).1 ≫
        (selectedTypedCoreFiberPresentationComparisonApp first second
          semantic_eq targetPackage).hom.1 ≫ secondTarget.hom =
      (selectedTypedCoreFiberPresentationComparisonApp first second
        semantic_eq sourcePackage).hom.1 ≫
        ((selectedTypedCoreFiberReindexFunctor second).map hom).1 ≫
          secondTarget.hom
  calc
    _ = ((selectedTypedCoreFiberReindexFunctor first).map hom).1 ≫
        ((selectedTypedCoreFiberPresentationComparisonApp first second
          semantic_eq targetPackage).hom.1 ≫ secondTarget.hom) :=
      Category.assoc _ _ _
    _ = ((selectedTypedCoreFiberReindexFunctor first).map hom).1 ≫
        (selectedTypedCoreFiberCartesianLift first targetPackage).hom := by
      rw [selectedTypedCoreFiberPresentationComparisonApp_hom_fac]
    _ = (selectedTypedCoreFiberCartesianLift first sourcePackage).hom ≫ hom.1 :=
      selectedTypedCoreFiberReindexFunctor_map_fac first hom
    _ = ((selectedTypedCoreFiberPresentationComparisonApp first second
        semantic_eq sourcePackage).hom.1 ≫
          (selectedTypedCoreFiberCartesianLift second sourcePackage).hom) ≫
            hom.1 := by
      rw [selectedTypedCoreFiberPresentationComparisonApp_hom_fac]
    _ = (selectedTypedCoreFiberPresentationComparisonApp first second
        semantic_eq sourcePackage).hom.1 ≫
          ((selectedTypedCoreFiberCartesianLift second sourcePackage).hom ≫
            hom.1) := Category.assoc _ _ _
    _ = (selectedTypedCoreFiberPresentationComparisonApp first second
        semantic_eq sourcePackage).hom.1 ≫
          (((selectedTypedCoreFiberReindexFunctor second).map hom).1 ≫
            secondTarget.hom) := by
      rw [selectedTypedCoreFiberReindexFunctor_map_fac]
    _ = _ := (Category.assoc _ _ _).symm

/--
The canonical natural isomorphism comparing selected reindexing for two
exact-endpoint presentations with equal semantic decode.
-/
noncomputable def selectedTypedCoreFiberPresentationComparison
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (first second : CartPresentationBetween source target)
    (semantic_eq : typedPresentationToSemantic first =
      typedPresentationToSemantic second) :
    selectedTypedCoreFiberReindexFunctor first ≅
      selectedTypedCoreFiberReindexFunctor second :=
  NatIso.ofComponents
    (selectedTypedCoreFiberPresentationComparisonApp first second semantic_eq)
    (fun hom => selectedTypedCoreFiberPresentationComparison_naturality
      first second semantic_eq hom)

/-- The whole exact-endpoint comparison is reflexive. -/
theorem selectedTypedCoreFiberPresentationComparison_refl
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target) :
    selectedTypedCoreFiberPresentationComparison presentation presentation rfl =
      Iso.refl (selectedTypedCoreFiberReindexFunctor presentation) := by
  apply Iso.ext
  apply NatTrans.ext
  funext targetPackage
  apply CategoryTheory.Functor.Fiber.hom_ext
  let targetLift := selectedTypedCoreFiberCartesianLift presentation targetPackage
  letI := targetLift.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U) (typedCartSemanticInput presentation).hom
    targetLift.hom (𝟙 source.toSemantic)
  change
    (selectedTypedCoreFiberPresentationComparisonApp presentation presentation
      rfl targetPackage).hom.1 ≫ targetLift.hom =
      𝟙 targetLift.domain ≫ targetLift.hom
  rw [selectedTypedCoreFiberPresentationComparisonApp_hom_fac]
  simp
  rfl

/-- Reversing an exact-endpoint comparison gives the reverse semantic comparison. -/
theorem selectedTypedCoreFiberPresentationComparison_symm
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (first second : CartPresentationBetween source target)
    (semantic_eq : typedPresentationToSemantic first =
      typedPresentationToSemantic second) :
    (selectedTypedCoreFiberPresentationComparison first second
      semantic_eq).symm =
      selectedTypedCoreFiberPresentationComparison second first
        semantic_eq.symm := by
  apply Iso.ext
  apply NatTrans.ext
  funext targetPackage
  apply CategoryTheory.Functor.Fiber.hom_ext
  let firstTarget := selectedTypedCoreFiberCartesianLift first targetPackage
  letI := firstTarget.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U) (typedCartSemanticInput first).hom
    firstTarget.hom (𝟙 source.toSemantic)
  change
    (selectedTypedCoreFiberPresentationComparisonApp first second semantic_eq
      targetPackage).inv.1 ≫ firstTarget.hom =
      (selectedTypedCoreFiberPresentationComparisonApp second first
        semantic_eq.symm targetPackage).hom.1 ≫ firstTarget.hom
  rw [selectedTypedCoreFiberPresentationComparisonApp_inv_fac,
    selectedTypedCoreFiberPresentationComparisonApp_hom_fac]

/-- Exact-endpoint selected comparisons satisfy the three-presentation cocycle. -/
theorem selectedTypedCoreFiberPresentationComparison_cocycle
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (first second third : CartPresentationBetween source target)
    (first_second_eq : typedPresentationToSemantic first =
      typedPresentationToSemantic second)
    (second_third_eq : typedPresentationToSemantic second =
      typedPresentationToSemantic third) :
    (selectedTypedCoreFiberPresentationComparison first second
      first_second_eq).trans
        (selectedTypedCoreFiberPresentationComparison second third
          second_third_eq) =
      selectedTypedCoreFiberPresentationComparison first third
        (first_second_eq.trans second_third_eq) := by
  apply Iso.ext
  apply NatTrans.ext
  funext targetPackage
  apply CategoryTheory.Functor.Fiber.hom_ext
  let thirdTarget := selectedTypedCoreFiberCartesianLift third targetPackage
  letI := thirdTarget.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U) (typedCartSemanticInput third).hom
    thirdTarget.hom (𝟙 source.toSemantic)
  change
    ((selectedTypedCoreFiberPresentationComparisonApp first second
      first_second_eq targetPackage).hom.1 ≫
        (selectedTypedCoreFiberPresentationComparisonApp second third
          second_third_eq targetPackage).hom.1) ≫ thirdTarget.hom =
      (selectedTypedCoreFiberPresentationComparisonApp first third
        (first_second_eq.trans second_third_eq) targetPackage).hom.1 ≫
          thirdTarget.hom
  rw [Category.assoc,
    selectedTypedCoreFiberPresentationComparisonApp_hom_fac,
    selectedTypedCoreFiberPresentationComparisonApp_hom_fac,
    selectedTypedCoreFiberPresentationComparisonApp_hom_fac]

end AAT.AG.DoctrineFiberProduct

