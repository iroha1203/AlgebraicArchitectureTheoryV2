import ResearchLean.AG.DoctrineFiberProduct.IndexedBaseChangeRaw

/-!
# Diagnostic-free indexed base diagrams

This module supplies the G-111 F0 diagram surface.  A finite shape contains
vertices, generating edges, and declared parallel-path 2-cells.  An
`IndexedBaseDiagram` interprets only that base geometry in extraction
instances.  An `IndexedBaseDiagramHom` consists only of vertex indices and the
commutative squares on generating edges; naturality for every finite path and
declared 2-cell is generated from those squares.

## Implementation notes

The presentation skeleton is kept in this module instead of importing the
G-106 transport-coherence presentation, because the latter also carries
package-level diagnostic data downstream.  The rejected alternative was to
store path naturality, target path equalities, or diagnostic certificates in a
diagram hom.  Here path naturality is a theorem obtained by induction, while a
diagram's declared base relation remains authored base geometry.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open CategoryTheory
open AtomFoundation

/-- A finite directed 0/1/2-cell shape for an indexed base diagram. -/
structure IndexedBaseShape where
  /-- Finite vertex labels. -/
  Vertex : Type u
  /-- Finiteness of the vertex family. -/
  vertexFintype : Fintype Vertex
  /-- Finite generating edges between vertices. -/
  Edge : Vertex → Vertex → Type u
  /-- Finiteness of each generating-edge family. -/
  edgeFintype : ∀ i j, Fintype (Edge i j)
  /-- Finite declared parallel-path 2-cells. -/
  TwoCell : Type u
  /-- Finiteness of the 2-cell family. -/
  twoCellFintype : Fintype TwoCell
  /-- Source vertex of a declared 2-cell. -/
  twoSource : TwoCell → Vertex
  /-- Target vertex of a declared 2-cell. -/
  twoTarget : TwoCell → Vertex

/-- The vertex finiteness stored by an indexed base shape. -/
instance (G : IndexedBaseShape.{u}) : Fintype G.Vertex := G.vertexFintype

/-- The generating-edge finiteness stored by an indexed base shape. -/
instance (G : IndexedBaseShape.{u}) (i j : G.Vertex) : Fintype (G.Edge i j) :=
  G.edgeFintype i j

/-- The declared-cell finiteness stored by an indexed base shape. -/
instance (G : IndexedBaseShape.{u}) : Fintype G.TwoCell := G.twoCellFintype

/-- Finite paths in an indexed base shape. -/
inductive IndexedBasePath (G : IndexedBaseShape.{u}) : G.Vertex → G.Vertex → Type u
  /-- The empty path at one vertex. -/
  | nil (vertex : G.Vertex) : IndexedBasePath G vertex vertex
  /-- A generating edge followed by a finite path. -/
  | cons {i j k : G.Vertex} (edge : G.Edge i j)
      (tail : IndexedBasePath G j k) : IndexedBasePath G i k

namespace IndexedBasePath

/-- Horizontal-pasting provenance generated by one finite path. -/
def squareRoute {G : IndexedBaseShape.{u}} {i j : G.Vertex} :
    IndexedBasePath G i j → IndexedSquareRoute
  | .nil _ => .identity
  | .cons _ tail => .pasteHorizontal .leaf tail.squareRoute

/-- Concatenate two indexed base paths. -/
def append {G : IndexedBaseShape.{u}} {i j k : G.Vertex}
    (first : IndexedBasePath G i j) (second : IndexedBasePath G j k) :
    IndexedBasePath G i k :=
  match first with
  | .nil _ => second
  | .cons edge tail => .cons edge (tail.append second)

/-- Appending an empty path on the right leaves a path unchanged. -/
@[simp]
theorem append_nil {G : IndexedBaseShape.{u}} {i j : G.Vertex}
    (path : IndexedBasePath G i j) : path.append (.nil j) = path := by
  induction path with
  | nil vertex => rfl
  | cons edge tail ih => simp [append, ih]

/-- Path concatenation is associative. -/
@[simp]
theorem append_assoc {G : IndexedBaseShape.{u}} {i j k l : G.Vertex}
    (first : IndexedBasePath G i j) (second : IndexedBasePath G j k)
    (third : IndexedBasePath G k l) :
    (first.append second).append third = first.append (second.append third) := by
  induction first with
  | nil vertex => rfl
  | cons edge tail ih => simp [append, ih]

/-- Evaluate a path using an object assignment and its generating-edge arrows. -/
def eval {G : IndexedBaseShape.{u}} {U : AtomCarrier.{u}}
    (object : G.Vertex → ExtractionInstance U)
    (edgeMap : {i j : G.Vertex} → G.Edge i j → (object i ⟶ object j)) :
    {i j : G.Vertex} → IndexedBasePath G i j → (object i ⟶ object j)
  | _, _, .nil vertex => 𝟙 (object vertex)
  | _, _, .cons edge tail => edgeMap edge ≫ eval object edgeMap tail

/-- Evaluation sends path concatenation to categorical composition. -/
theorem eval_append {G : IndexedBaseShape.{u}} {U : AtomCarrier.{u}}
    (object : G.Vertex → ExtractionInstance U)
    (edgeMap : {i j : G.Vertex} → G.Edge i j → (object i ⟶ object j))
    {i j k : G.Vertex} (first : IndexedBasePath G i j)
    (second : IndexedBasePath G j k) :
    eval object edgeMap (first.append second) =
      eval object edgeMap first ≫ eval object edgeMap second := by
  induction first with
  | nil vertex => simp [append, eval]
  | cons edge tail ih => simp [append, eval, ih, Category.assoc]

end IndexedBasePath

/-- Complete the declared 2-cell paths of a finite indexed base shape. -/
structure IndexedBaseTwoShape extends IndexedBaseShape.{u} where
  /-- First path of each declared parallel-path relation. -/
  twoLeft : (cell : TwoCell) →
    IndexedBasePath toIndexedBaseShape (twoSource cell) (twoTarget cell)
  /-- Second path of each declared parallel-path relation. -/
  twoRight : (cell : TwoCell) →
    IndexedBasePath toIndexedBaseShape (twoSource cell) (twoTarget cell)

/-- A diagnostic-free interpretation of one finite base-diagram shape. -/
structure IndexedBaseDiagram (G : IndexedBaseTwoShape.{u}) (U : AtomCarrier.{u}) where
  /-- Extraction instance assigned to every vertex. -/
  vertex : G.Vertex → ExtractionInstance U
  /-- Base arrow assigned to every generating edge. -/
  edge : {i j : G.Vertex} → G.Edge i j → (vertex i ⟶ vertex j)
  /-- Authored base equality assigned to every declared parallel-path 2-cell. -/
  relation : ∀ cell : G.TwoCell,
    IndexedBasePath.eval vertex edge (G.twoLeft cell) =
      IndexedBasePath.eval vertex edge (G.twoRight cell)

namespace IndexedBaseDiagram

/-- Evaluate a finite path in a diagnostic-free indexed base diagram. -/
def path {G : IndexedBaseTwoShape.{u}} {U : AtomCarrier.{u}}
    (D : IndexedBaseDiagram G U) {i j : G.Vertex}
    (p : IndexedBasePath G.toIndexedBaseShape i j) : D.vertex i ⟶ D.vertex j :=
  IndexedBasePath.eval D.vertex D.edge p

/-- Diagram path evaluation sends concatenation to composition. -/
theorem path_append {G : IndexedBaseTwoShape.{u}} {U : AtomCarrier.{u}}
    (D : IndexedBaseDiagram G U) {i j k : G.Vertex}
    (first : IndexedBasePath G.toIndexedBaseShape i j)
    (second : IndexedBasePath G.toIndexedBaseShape j k) :
    D.path (first.append second) = D.path first ≫ D.path second :=
  IndexedBasePath.eval_append D.vertex D.edge first second

/-- The two paths of each declared cell evaluate to the authored base relation. -/
theorem relation_path {G : IndexedBaseTwoShape.{u}} {U : AtomCarrier.{u}}
    (D : IndexedBaseDiagram G U) (cell : G.TwoCell) :
    D.path (G.twoLeft cell) = D.path (G.twoRight cell) :=
  D.relation cell

end IndexedBaseDiagram

/-- A diagnostic-free morphism of indexed base diagrams on one finite shape. -/
structure IndexedBaseDiagramHom {G : IndexedBaseTwoShape.{u}} {U : AtomCarrier.{u}}
    (D E : IndexedBaseDiagram G U) where
  /-- Vertexwise transport index. -/
  app : ∀ vertex : G.Vertex, D.vertex vertex ⟶ E.vertex vertex
  /-- Every generating edge gives a commutative base square. -/
  naturality : ∀ {i j : G.Vertex} (edge : G.Edge i j),
    app i ≫ E.edge edge = D.edge edge ≫ app j

namespace IndexedBaseDiagramHom

/-- The generated commutative square on one diagram edge. -/
def edgeSquare {G : IndexedBaseTwoShape.{u}} {U : AtomCarrier.{u}}
    {D E : IndexedBaseDiagram G U} (hom : IndexedBaseDiagramHom D E)
    {i j : G.Vertex} (edge : G.Edge i j) :
    IndexedBaseSquare U (D.vertex i) (D.vertex j) (E.vertex i) (E.vertex j) where
  top := D.edge edge
  left := hom.app i
  right := hom.app j
  bottom := E.edge edge
  commutes := hom.naturality edge
  route := .leaf

/-- Generating-edge naturality extends to every finite path. -/
theorem path_naturality {G : IndexedBaseTwoShape.{u}} {U : AtomCarrier.{u}}
    {D E : IndexedBaseDiagram G U} (hom : IndexedBaseDiagramHom D E)
    {i j : G.Vertex} (path : IndexedBasePath G.toIndexedBaseShape i j) :
    hom.app i ≫ E.path path = D.path path ≫ hom.app j := by
  induction path with
  | nil vertex => simp [IndexedBaseDiagram.path, IndexedBasePath.eval]
  | cons edge tail ih =>
      calc
        hom.app _ ≫ E.path (.cons edge tail) =
            (hom.app _ ≫ E.edge edge) ≫ E.path tail := by
          simp [IndexedBaseDiagram.path, IndexedBasePath.eval, Category.assoc]
        _ = (D.edge edge ≫ hom.app _) ≫ E.path tail := by
          rw [hom.naturality edge]
        _ = D.edge edge ≫ (hom.app _ ≫ E.path tail) := by
          rw [Category.assoc]
        _ = D.edge edge ≫ (D.path tail ≫ hom.app _) := by rw [ih]
        _ = (D.edge edge ≫ D.path tail) ≫ hom.app _ := by
          rw [Category.assoc]
        _ = D.path (.cons edge tail) ≫ hom.app _ := by
          rfl

/-- The generated square on a path records horizontal edge-square pasting. -/
def pathSquare {G : IndexedBaseTwoShape.{u}} {U : AtomCarrier.{u}}
    {D E : IndexedBaseDiagram G U} (hom : IndexedBaseDiagramHom D E)
    {i j : G.Vertex} (path : IndexedBasePath G.toIndexedBaseShape i j) :
    IndexedBaseSquare U (D.vertex i) (D.vertex j) (E.vertex i) (E.vertex j) where
  top := D.path path
  left := hom.app i
  right := hom.app j
  bottom := E.path path
  commutes := hom.path_naturality path
  route := path.squareRoute

/-- A diagram hom sends the left path of a declared cell to its target path. -/
theorem twoCell_left_naturality {G : IndexedBaseTwoShape.{u}}
    {U : AtomCarrier.{u}} {D E : IndexedBaseDiagram G U}
    (hom : IndexedBaseDiagramHom D E) (cell : G.TwoCell) :
    hom.app (G.twoSource cell) ≫ E.path (G.twoLeft cell) =
      D.path (G.twoLeft cell) ≫ hom.app (G.twoTarget cell) :=
  hom.path_naturality (G.twoLeft cell)

/-- A diagram hom sends the right path of a declared cell to its target path. -/
theorem twoCell_right_naturality {G : IndexedBaseTwoShape.{u}}
    {U : AtomCarrier.{u}} {D E : IndexedBaseDiagram G U}
    (hom : IndexedBaseDiagramHom D E) (cell : G.TwoCell) :
    hom.app (G.twoSource cell) ≫ E.path (G.twoRight cell) =
      D.path (G.twoRight cell) ≫ hom.app (G.twoTarget cell) :=
  hom.path_naturality (G.twoRight cell)

/-- The two path-naturality routes of a declared cell have one common value. -/
theorem twoCell_naturality {G : IndexedBaseTwoShape.{u}} {U : AtomCarrier.{u}}
    {D E : IndexedBaseDiagram G U} (hom : IndexedBaseDiagramHom D E)
    (cell : G.TwoCell) :
    hom.app (G.twoSource cell) ≫ E.path (G.twoLeft cell) =
      D.path (G.twoRight cell) ≫ hom.app (G.twoTarget cell) := by
  rw [hom.twoCell_left_naturality cell, D.relation_path cell]

/-- Identity morphism of a diagnostic-free indexed base diagram. -/
def id {G : IndexedBaseTwoShape.{u}} {U : AtomCarrier.{u}}
    (D : IndexedBaseDiagram G U) : IndexedBaseDiagramHom D D where
  app := fun vertex => 𝟙 (D.vertex vertex)
  naturality := by simp

/-- Vertical composition of diagnostic-free indexed base-diagram morphisms. -/
def comp {G : IndexedBaseTwoShape.{u}} {U : AtomCarrier.{u}}
    {D E F : IndexedBaseDiagram G U} (first : IndexedBaseDiagramHom D E)
    (second : IndexedBaseDiagramHom E F) : IndexedBaseDiagramHom D F where
  app := fun vertex => first.app vertex ≫ second.app vertex
  naturality := by
    intro i j edge
    rw [Category.assoc, second.naturality edge, ← Category.assoc,
      first.naturality edge, Category.assoc]

/-- Vertically paste the generated path squares of two composable diagram homs. -/
def verticalPathSquare {G : IndexedBaseTwoShape.{u}} {U : AtomCarrier.{u}}
    {D E F : IndexedBaseDiagram G U} (first : IndexedBaseDiagramHom D E)
    (second : IndexedBaseDiagramHom E F) {i j : G.Vertex}
    (path : IndexedBasePath G.toIndexedBaseShape i j) :
    IndexedBaseSquare U (D.vertex i) (D.vertex j) (F.vertex i) (F.vertex j) :=
  IndexedBaseSquare.verticalComp (first.pathSquare path) (second.pathSquare path) rfl

/-- Diagram homs are determined by their vertex indices. -/
@[ext]
theorem ext {G : IndexedBaseTwoShape.{u}} {U : AtomCarrier.{u}}
    {D E : IndexedBaseDiagram G U} {first second : IndexedBaseDiagramHom D E}
    (components : ∀ vertex, first.app vertex = second.app vertex) :
    first = second := by
  cases first with
  | mk firstApp firstNaturality =>
      cases second with
      | mk secondApp secondNaturality =>
          have appEquality : firstApp = secondApp := funext components
          subst secondApp
          rfl

end IndexedBaseDiagramHom

/-- Diagnostic-free indexed base diagrams on one shape form a category. -/
instance indexedBaseDiagramCategory (G : IndexedBaseTwoShape.{u})
    (U : AtomCarrier.{u}) : Category (IndexedBaseDiagram G U) where
  Hom := IndexedBaseDiagramHom
  id := IndexedBaseDiagramHom.id
  comp := IndexedBaseDiagramHom.comp
  id_comp := by
    intro D E hom
    ext vertex
    simp [IndexedBaseDiagramHom.comp, IndexedBaseDiagramHom.id]
  comp_id := by
    intro D E hom
    ext vertex
    simp [IndexedBaseDiagramHom.comp, IndexedBaseDiagramHom.id]
  assoc := by
    intro A B C D first second third
    ext vertex
    simp [IndexedBaseDiagramHom.comp, Category.assoc]

end AAT.AG.DoctrineFiberProduct

#assert_standard_axioms_only AAT.AG.DoctrineFiberProduct
