import Mathlib.CategoryTheory.FiberedCategory.Cartesian
import ResearchLean.AG.AtomFoundation.Deconjugation

/-!
# Cartesian universal property of canonical package transport

The G-101 package transport was originally exposed with its strongly
cocartesian universal property.  This module proves the opposite factorization
property for the same canonical arrow.  The reason both directions are
available is not an inverse lower source map: the complete upper transport is
an equivalence because its Atom component is an equivalence.

This result concerns a canonical codomain `transportAlong P f`.  It does not
yet construct a strongly cartesian lift ending at an arbitrary package over the
target pointed doctrine; that separate object-level reindexing remains the next
G-110 obligation.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open CategoryTheory
open AtomFoundation

/-! ## The inverse of the canonical upper transport -/

/--
The canonical inverse upper hom, generated by removing canonical transport
from the identity upper hom.  No inverse lower doctrine morphism is used.
-/
noncomputable def transportAlongUpperInverse {U : AtomCarrier.{u}}
    (P : AATCorePackage U) {E : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine E) :
    SignedExactCoreReadingHom (transportAlong P f) P :=
  canonicalDeconjugateTransportUpper P P f
    (SignedExactCoreReadingHom.refl P)

/-- The inverse upper hom uses the inverse of the canonical Atom equivalence. -/
@[simp]
theorem transportAlongUpperInverse_atomEquiv {U : AtomCarrier.{u}}
    (P : AATCorePackage U) {E : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine E) :
    (transportAlongUpperInverse P f).atomEquiv = f.atomEquiv.symm := by
  change canonicalTailAtomEquiv P P f
      (SignedExactCoreReadingHom.refl P) = f.atomEquiv.symm
  apply Equiv.ext
  intro atom
  simp [canonicalTailAtomEquiv, SignedExactCoreReadingHom.refl]

/-- Canonical upper transport followed by its generated inverse is the identity. -/
theorem transportAlongUpper_comp_inverse {U : AtomCarrier.{u}}
    (P : AATCorePackage U) {E : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine E) :
    (transportAlongUpper P f).comp (transportAlongUpperInverse P f) =
      SignedExactCoreReadingHom.refl P := by
  unfold transportAlongUpperInverse canonicalDeconjugateTransportUpper
  exact transportAlongUpper_comp_deconjugate P P f
    (canonicalTailAtomEquiv P P f (SignedExactCoreReadingHom.refl P))
    (SignedExactCoreReadingHom.refl P)
    (canonicalTailAtomEquiv_factor P P f
      (SignedExactCoreReadingHom.refl P))

/-- The generated inverse followed by canonical upper transport is the identity. -/
theorem transportAlongUpperInverse_comp {U : AtomCarrier.{u}}
    (P : AATCorePackage U) {E : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine E) :
    (transportAlongUpperInverse P f).comp (transportAlongUpper P f) =
      SignedExactCoreReadingHom.refl (transportAlong P f) := by
  apply transportAlongUpper_comp_injective P (transportAlong P f) f
  change
    (transportAlongUpper P f).comp
        ((transportAlongUpperInverse P f).comp (transportAlongUpper P f)) =
      (transportAlongUpper P f).comp
        (SignedExactCoreReadingHom.refl (transportAlong P f))
  rw [← PackageTotalHom.upper_comp_assoc,
    transportAlongUpper_comp_inverse,
    PackageTotalHom.upper_id_comp,
    PackageTotalHom.upper_comp_id]

/-! ## Suffix factorization in the package total category -/

/--
The total-package factor of a hom whose base factors through canonical
transport.  Its upper component is computed by postcomposing with the generated
upper inverse.
-/
noncomputable def packageCartesianFactor {U : AtomCarrier.{u}}
    (P R : AATCorePackage U) {E : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine E)
    (g : ExtInstHom (packagePoint R) (packagePoint P))
    (h : PackageTotalHom R (transportAlong P f))
    (hbase : h.base = g.comp (transportAlongHom P f).base) :
    PackageTotalHom R P where
  base := g
  upper := h.upper.comp (transportAlongUpperInverse P f)
  atomEquiv_eq := by
    apply Equiv.ext
    intro atom
    have hbaseAtomApply := congrArg
      (fun base => base.doctrineHom.atomEquiv atom) hbase
    change h.base.doctrineHom.atomEquiv atom =
      (g.comp (transportAlongHom P f).base).doctrineHom.atomEquiv atom
        at hbaseAtomApply
    change (transportAlongUpperInverse P f).atomEquiv
        (h.upper.atomEquiv atom) = g.doctrineHom.atomEquiv atom
    rw [h.atomEquiv_eq, transportAlongUpperInverse_atomEquiv,
      hbaseAtomApply]
    simp [ExtInstHom.comp, ExactDoctrineHom.comp, transportAlongHom]

/-- The generated cartesian factor lies over the supplied prefix base map. -/
@[simp]
theorem packageCartesianFactor_base {U : AtomCarrier.{u}}
    (P R : AATCorePackage U) {E : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine E)
    (g : ExtInstHom (packagePoint R) (packagePoint P))
    (h : PackageTotalHom R (transportAlong P f))
    (hbase : h.base = g.comp (transportAlongHom P f).base) :
    (packageCartesianFactor P R f g h hbase).base = g :=
  rfl

/-- The generated factor followed by canonical transport is the original hom. -/
theorem packageCartesianFactor_fac {U : AtomCarrier.{u}}
    (P R : AATCorePackage U) {E : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine E)
    (g : ExtInstHom (packagePoint R) (packagePoint P))
    (h : PackageTotalHom R (transportAlong P f))
    (hbase : h.base = g.comp (transportAlongHom P f).base) :
    (packageCartesianFactor P R f g h hbase).comp
        (transportAlongHom P f) = h := by
  apply PackageTotalHom.ext
  · exact hbase.symm
  · change
      (h.upper.comp (transportAlongUpperInverse P f)).comp
          (transportAlongUpper P f) = h.upper
    rw [PackageTotalHom.upper_comp_assoc,
      transportAlongUpperInverse_comp,
      PackageTotalHom.upper_comp_id]

/-- Every total factor over the supplied prefix is the generated one. -/
theorem packageCartesianFactor_unique {U : AtomCarrier.{u}}
    (P R : AATCorePackage U) {E : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine E)
    (g : ExtInstHom (packagePoint R) (packagePoint P))
    (h : PackageTotalHom R (transportAlong P f))
    (hbase : h.base = g.comp (transportAlongHom P f).base)
    (k : PackageTotalHom R P)
    (hkbase : k.base = g)
    (hkfac : k.comp (transportAlongHom P f) = h) :
    k = packageCartesianFactor P R f g h hbase := by
  apply PackageTotalHom.ext
  · exact hkbase
  · have hupper :
        k.upper.comp (transportAlongUpper P f) = h.upper := by
      simpa [PackageTotalHom.comp] using
        congrArg PackageTotalHom.upper hkfac
    change k.upper = h.upper.comp (transportAlongUpperInverse P f)
    calc
      k.upper = k.upper.comp (SignedExactCoreReadingHom.refl P) :=
        (PackageTotalHom.upper_comp_id k.upper).symm
      _ = k.upper.comp
          ((transportAlongUpper P f).comp
            (transportAlongUpperInverse P f)) := by
        rw [transportAlongUpper_comp_inverse]
      _ = (k.upper.comp (transportAlongUpper P f)).comp
          (transportAlongUpperInverse P f) := by
        rw [PackageTotalHom.upper_comp_assoc]
      _ = h.upper.comp (transportAlongUpperInverse P f) := by
        rw [hupper]

/-- Explicit unique-factor form of the canonical cartesian universal property. -/
theorem transportAlongHom_cartesianFactor_existsUnique {U : AtomCarrier.{u}}
    (P R : AATCorePackage U) {E : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine E)
    (g : ExtInstHom (packagePoint R) (packagePoint P))
    (h : PackageTotalHom R (transportAlong P f))
    (hbase : h.base = g.comp (transportAlongHom P f).base) :
    ∃! k : PackageTotalHom R P,
      k.base = g ∧ k.comp (transportAlongHom P f) = h := by
  refine ⟨packageCartesianFactor P R f g h hbase, ⟨rfl, ?_⟩, ?_⟩
  · exact packageCartesianFactor_fac P R f g h hbase
  · intro k hk
    exact packageCartesianFactor_unique P R f g h hbase k hk.1 hk.2

/-! ## Strong cartesianness -/

/--
Canonical package transport is strongly cartesian over `packageProjection`.

The theorem quantifies over arbitrary prefix base maps and arbitrary competing
total homs.  It does not assume that the lower source map is invertible.
-/
theorem transportAlongHom_isStronglyCartesian {U : AtomCarrier.{u}}
    (P : AATCorePackage U) {E : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine E) :
    (packageProjection U).IsStronglyCartesian
      (transportAlongHom P f).base (transportAlongHom P f) := by
  letI : (packageProjection U).IsHomLift
      (transportAlongHom P f).base (transportAlongHom P f) := by
    change (packageProjection U).IsHomLift
      ((packageProjection U).map (transportAlongHom P f))
      (transportAlongHom P f)
    infer_instance
  apply CategoryTheory.Functor.IsStronglyCartesian.mk
  intro R g h hLift
  have hbase : h.base = g.comp (transportAlongHom P f).base := by
    exact (CategoryTheory.IsHomLift.eq_of_isHomLift
      (packageProjection U)
      (g.comp (transportAlongHom P f).base) h).symm
  rcases transportAlongHom_cartesianFactor_existsUnique P R f g h hbase with
    ⟨k, hk, hunique⟩
  refine ⟨k, ?_, ?_⟩
  · constructor
    · rw [← hk.1]
      change (packageProjection U).IsHomLift
        ((packageProjection U).map k) k
      infer_instance
    · exact hk.2
  · intro k' hk'
    apply hunique k'
    constructor
    · letI : (packageProjection U).IsHomLift g k' := hk'.1
      exact (CategoryTheory.IsHomLift.eq_of_isHomLift
        (packageProjection U) g k').symm
    · exact hk'.2

end AAT.AG.DoctrineFiberProduct

#assert_standard_axioms_only AAT.AG.DoctrineFiberProduct
