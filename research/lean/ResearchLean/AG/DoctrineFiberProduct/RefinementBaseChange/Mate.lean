import ResearchLean.AG.DoctrineFiberProduct.RefinementBaseChange.LegacyBridge
import ResearchLean.AG.DoctrineFiberProduct.RefinementBaseChange.Regime

/-!
# Canonical refinement base-change mate

The revision-3 condition supplies the two universal relative cleavages.  The
mate is then generated by the already verified factorization construction:
its exact sides are the G-112 reindexing functors and its refinement sides are
the reverse functors determined by the universal lifts.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open AtomFoundation
open CrossStageCoherence

/-- The relative universal-property regime generated at a compatible source. -/
noncomputable def legacyRefinementBCRegimeOfConditionAt
    {U : AtomCarrier.{u}} (C : RefinementBCConfiguration U)
    (p : C.CompatibleSource)
    (condition : RealizedLocusExtractionReflecting (C.baseRefinementAt p)) :
    LegacyRefinementBCRegime (C.pointedConfigurationAt p) where
  baseCleavage := legacyRefinementCleavageOfRealizedReflection
    (C.baseRefinementAt p) condition
  pulledCleavage := legacyRefinementCleavageOfRealizedReflection
    (C.pulledRefinementAt p) (pulledRealizedReflection C p condition)

/--
The canonical base-change mate at one compatible source.

No functor, component, or naturality witness is input data.  Both reverse
functors come from universal refinement lifts, both exact reindexing functors
come from G-112, and the natural transformation is the unique pulled factor.
-/
noncomputable def refinementBCMateAt
    {U : AtomCarrier.{u}} (C : RefinementBCConfiguration U)
    (p : C.CompatibleSource)
    (condition : RealizedLocusExtractionReflecting (C.baseRefinementAt p)) :=
  (legacyRefinementBCRegimeOfConditionAt C p condition).mate

/-- The base-side component type of the canonical mate. -/
theorem refinementBCMateAt_app_type
    {U : AtomCarrier.{u}} (C : RefinementBCConfiguration U)
    (p : C.CompatibleSource)
    (condition : RealizedLocusExtractionReflecting (C.baseRefinementAt p))
    (target : CoreFiber (C.targetPointAt p)) :
    (refinementBCMateAt C p condition).app target =
      (legacyRefinementBCRegimeOfConditionAt C p condition).pulledHomEquiv _ _
        ((legacyRefinementBCRegimeOfConditionAt C p condition).mateRoute target) :=
  rfl

end AAT.AG.DoctrineFiberProduct

#assert_standard_axioms_only AAT.AG.DoctrineFiberProduct
