import ResearchLean.AG.DoctrineFiberProduct.BCAuthoredComparisonNoGoWitnesses

/-!
# Fixed-target quotient and return-map barriers

A coequalizing quotient generated by a diagnostic endomorphism has codomain a
quotient object.  Turning it into an endomorphism of the original fixed target
requires a return map, which is additional data.  This module records two
precise consequences: a return composite coequalizing a nonidentity action is
necessarily noninvertible, and a nonidentity idempotent fixed-target collapse
cannot itself satisfy the coequalizer universal property.

The results delimit a proposed G-110 route.  They neither supply a return map
nor refute noninvertible, nonidempotent authored constructions globally.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u v

open CategoryTheory
open AtomFoundation CrossStageCoherence TransportCoherence

/-- A morphism coequalizes one endomorphism with identity. -/
def CoequalizesEndomorphism
    {C : Type u} [Category.{v} C] {Y Z : C}
    (action : Y ⟶ Y) (quotient : Y ⟶ Z) : Prop :=
  action ≫ quotient = quotient

/--
The fixed-target form of the coequalizer universal property.  The codomain is
literally the source object; no unidentified quotient object is hidden here.
-/
def IsFixedTargetEndomorphismCoequalizer
    {C : Type u} [Category.{v} C] {Y : C}
    (action quotient : Y ⟶ Y) : Prop :=
  CoequalizesEndomorphism action quotient ∧
    ∀ {Z : C} (hom : Y ⟶ Z), CoequalizesEndomorphism action hom →
      ∃! factor : Y ⟶ Z, quotient ≫ factor = hom

/--
If a quotient map coequalizes a nonidentity action, composing it with any
return map cannot produce an invertible endomorphism of the original object.
The return map is deliberately an explicit argument rather than generated
data.
-/
theorem coequalizingReturn_not_isIso_of_ne
    {C : Type u} [Category.{v} C] {Y Q : C}
    (action : Y ⟶ Y) (quotient : Y ⟶ Q) (returnMap : Q ⟶ Y)
    (coequalizes : CoequalizesEndomorphism action quotient)
    (action_ne : action ≠ 𝟙 Y) :
    ¬ IsIso (quotient ≫ returnMap) := by
  intro composite_isIso
  letI : IsIso (quotient ≫ returnMap) := composite_isIso
  apply action_ne
  apply (cancel_mono (quotient ≫ returnMap)).1
  change action ≫ (quotient ≫ returnMap) = 𝟙 Y ≫ (quotient ≫ returnMap)
  rw [← Category.assoc, coequalizes]
  simp

/--
An idempotent endomorphism satisfying the fixed-target coequalizer universal
property is identity.  Indeed, identity and the idempotent are two factors of
the quotient through itself, so uniqueness identifies them.
-/
theorem idempotent_eq_id_of_isFixedTargetEndomorphismCoequalizer
    {C : Type u} [Category.{v} C] {Y : C}
    (action quotient : Y ⟶ Y)
    (universal : IsFixedTargetEndomorphismCoequalizer action quotient)
    (idempotent : quotient ≫ quotient = quotient) :
    quotient = 𝟙 Y := by
  rcases universal.2 quotient universal.1 with
    ⟨factor, factor_fac, factor_unique⟩
  exact (factor_unique quotient idempotent).trans
    (factor_unique (𝟙 Y) (Category.comp_id quotient)).symm

/-- Hence a nonidentity idempotent fixed-target collapse is not a coequalizer. -/
theorem not_isFixedTargetEndomorphismCoequalizer_of_idempotent_ne
    {C : Type u} [Category.{v} C] {Y : C}
    (action quotient : Y ⟶ Y)
    (idempotent : quotient ≫ quotient = quotient)
    (quotient_ne : quotient ≠ 𝟙 Y) :
    ¬ IsFixedTargetEndomorphismCoequalizer action quotient := by
  intro universal
  exact quotient_ne
    (idempotent_eq_id_of_isFixedTargetEndomorphismCoequalizer
      action quotient universal idempotent)

/-! ## Finite lax firing -/

local instance finiteAuthoredQuotientNoGoAtomDecidableEq :
    DecidableEq FiniteModel.carrier.Atom := by
  change DecidableEq FiniteModel.FiniteAtom
  infer_instance

/--
On the fixed lax witness, every coequalizing quotient followed by an arbitrary
return map is noninvertible.  The theorem does not choose either map and hence
cannot be misread as the public K2 producer.
-/
theorem finiteAxisFold_viaBase_coequalizingReturn_not_isIso
    {Q : CoreFiber finiteAuthoredSupportInstance.toSemantic}
    (quotient :
      (authoredSupportViaBaseRoute finiteAxisFoldBCDatumSquare.context).obj
          (Discrete.mk DoubleDiamondTwoCell.second) ⟶ Q)
    (returnMap : Q ⟶
      (authoredSupportViaBaseRoute finiteAxisFoldBCDatumSquare.context).obj
        (Discrete.mk DoubleDiamondTwoCell.second))
    (coequalizes : CoequalizesEndomorphism
      (authoredViaBaseRawDefectComponent finiteAxisFoldBCDatumSquare
        (Discrete.mk DoubleDiamondTwoCell.second)) quotient) :
    ¬ IsIso (quotient ≫ returnMap) :=
  coequalizingReturn_not_isIso_of_ne
    (authoredViaBaseRawDefectComponent finiteAxisFoldBCDatumSquare
      (Discrete.mk DoubleDiamondTwoCell.second))
    quotient returnMap coequalizes
    finiteAxisFold_viaBaseRawDefect_second_ne_id

end AAT.AG.DoctrineFiberProduct

