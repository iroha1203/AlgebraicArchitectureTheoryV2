        ).reindexFunctor.map
          (selectedTypedCoreFiberCleavageBridgeApp secondPresentation
            targetPackage).hom).1 ≫
      (selectedTypedCoreFiberCleavageBridgeApp firstPresentation
        ((selectedTypedCoreFiberReindexFunctor secondPresentation).obj
          targetPackage)).hom.1) ≫
      ((selectedCoreFiberReindexCompositorApp firstPresentation
        secondPresentation targetPackage).hom.1 ≫ directTarget.hom) := by
      rw [selectedCoreFiberReindexCompositorApp_hom_fac]
    _ = _ := (Category.assoc _ _ _).symm

/-- The generic selected compositor is directly compatible with Cycle 32. -/
theorem selectedTypedCoreFiberCleavageCompositor_bridge
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (firstPresentation : CartPresentationBetween source middle)
    (secondPresentation : CartPresentationBetween middle target) :
