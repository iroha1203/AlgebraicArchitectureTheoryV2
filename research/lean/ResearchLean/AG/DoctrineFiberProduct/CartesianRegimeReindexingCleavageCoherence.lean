    ((coreFiberCleavageReindexCompositorApp firstPresentation
      secondPresentation
      (selectedTypedCoreFiberCartesianCleavage firstPresentation)
      (selectedTypedCoreFiberCartesianCleavage secondPresentation)
      (selectedTypedCoreFiberCartesianCleavage
        (compPresentation firstPresentation secondPresentation))
      targetPackage).hom.1 ≫
      (selectedTypedCoreFiberCleavageBridgeApp
        (compPresentation firstPresentation secondPresentation)
        targetPackage).hom.1) ≫ directTarget.hom =
      ((((selectedTypedCoreFiberCartesianCleavage firstPresentation
        ).reindexFunctor.map
          (selectedTypedCoreFiberCleavageBridgeApp secondPresentation
            targetPackage).hom).1 ≫
        (selectedTypedCoreFiberCleavageBridgeApp firstPresentation
          ((selectedTypedCoreFiberReindexFunctor secondPresentation).obj
            targetPackage)).hom.1) ≫
        (selectedCoreFiberReindexCompositorApp firstPresentation
          secondPresentation targetPackage).hom.1) ≫ directTarget.hom
  calc
    _ = (coreFiberCleavageReindexCompositorApp firstPresentation
        secondPresentation
        (selectedTypedCoreFiberCartesianCleavage firstPresentation)
        (selectedTypedCoreFiberCartesianCleavage secondPresentation)
        (selectedTypedCoreFiberCartesianCleavage
          (compPresentation firstPresentation secondPresentation))
        targetPackage).hom.1 ≫
      ((selectedTypedCoreFiberCleavageBridgeApp
        (compPresentation firstPresentation secondPresentation)
        targetPackage).hom.1 ≫ directTarget.hom) := Category.assoc _ _ _
    _ = (coreFiberCleavageReindexCompositorApp firstPresentation
        secondPresentation
        (selectedTypedCoreFiberCartesianCleavage firstPresentation)
        (selectedTypedCoreFiberCartesianCleavage secondPresentation)
        (selectedTypedCoreFiberCartesianCleavage
          (compPresentation firstPresentation secondPresentation))
        targetPackage).hom.1 ≫ directTarget.hom := by
      rw [selectedTypedCoreFiberCleavageBridgeApp_hom_fac]
    _ = (coreFiberCleavageIteratedCartesianLift firstPresentation
        secondPresentation
        (selectedTypedCoreFiberCartesianCleavage firstPresentation)
        (selectedTypedCoreFiberCartesianCleavage secondPresentation)
        targetPackage).hom :=
      coreFiberCleavageReindexCompositorApp_hom_fac firstPresentation
        secondPresentation
        (selectedTypedCoreFiberCartesianCleavage firstPresentation)
        (selectedTypedCoreFiberCartesianCleavage secondPresentation)
        (selectedTypedCoreFiberCartesianCleavage
          (compPresentation firstPresentation secondPresentation))
        targetPackage
    _ = (selectedTypedCoreFiberCartesianLift firstPresentation
        ((selectedTypedCoreFiberCartesianCleavage secondPresentation
          ).reindexFunctor.obj targetPackage)).hom ≫
      (selectedTypedCoreFiberCartesianLift secondPresentation
        targetPackage).hom := rfl
    _ = (selectedTypedCoreFiberCartesianLift firstPresentation
        ((selectedTypedCoreFiberCartesianCleavage secondPresentation
          ).reindexFunctor.obj targetPackage)).hom ≫
      ((selectedTypedCoreFiberCleavageBridgeApp secondPresentation
        targetPackage).hom.1 ≫
        (selectedTypedCoreFiberCartesianLift secondPresentation
          targetPackage).hom) := by
      rw [selectedTypedCoreFiberCleavageBridgeApp_hom_fac]
    _ = ((selectedTypedCoreFiberCartesianLift firstPresentation
        ((selectedTypedCoreFiberCartesianCleavage secondPresentation
          ).reindexFunctor.obj targetPackage)).hom ≫
      (selectedTypedCoreFiberCleavageBridgeApp secondPresentation
        targetPackage).hom.1) ≫
        (selectedTypedCoreFiberCartesianLift secondPresentation
          targetPackage).hom := (Category.assoc _ _ _).symm
    _ = (((selectedTypedCoreFiberCartesianCleavage firstPresentation
        ).reindexFunctor.map
          (selectedTypedCoreFiberCleavageBridgeApp secondPresentation
