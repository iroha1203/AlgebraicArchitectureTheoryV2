import ResearchLean.AG.DoctrineFiberProduct.CartesianRegimeReindexingCleavage
import Mathlib.CategoryTheory.Whiskering

/-!
# Coherence under cartesian-cleavage replacement

This module generates the contravariant compositor and identity unitor for
arbitrary cartesian cleavage choices, then proves that both constructions are
compatible with the canonical comparison natural isomorphisms of the choices.
All components and laws are consequences of the same strong-cartesian
universal property; no comparison or coherence certificate is an input.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open CategoryTheory
open AtomFoundation
open CrossStageCoherence

set_option maxHeartbeats 3000000

/-! ## Choice-relative compositor -/

/-- The literal two-step lift generated by two cleavage choices. -/
noncomputable def coreFiberCleavageIteratedCartesianLift
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (firstPresentation : CartPresentationBetween source middle)
    (secondPresentation : CartPresentationBetween middle target)
    (firstCleavage :
      CoreFiberCartesianCleavage (typedCartSemanticInput firstPresentation))
    (secondCleavage :
      CoreFiberCartesianCleavage (typedCartSemanticInput secondPresentation))
    (targetPackage : CoreFiber target.toSemantic) :
    StrongCartesianLift
      (typedCartSemanticInput
        (compPresentation firstPresentation secondPresentation))
      targetPackage where
  domain := (firstCleavage.lift
    (secondCleavage.reindexFunctor.obj targetPackage)).domain
  hom := (firstCleavage.lift
      (secondCleavage.reindexFunctor.obj targetPackage)).hom ≫
    (secondCleavage.lift targetPackage).hom
  isStronglyCartesian := by
    letI := (firstCleavage.lift
      (secondCleavage.reindexFunctor.obj targetPackage)).isStronglyCartesian
    letI := (secondCleavage.lift targetPackage).isStronglyCartesian
    have hcomp :
        (typedCartSemanticInput
          (compPresentation firstPresentation secondPresentation)).hom =
          (typedCartSemanticInput firstPresentation).hom ≫
            (typedCartSemanticInput secondPresentation).hom :=
      typedRealizableHom_comp_hom firstPresentation secondPresentation
    rw [hcomp]
    exact CategoryTheory.Functor.IsStronglyCartesian.comp
      (packageProjection U)

/-- The choice-relative iterated lift has the literal composite hom. -/
theorem coreFiberCleavageIteratedCartesianLift_hom
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (firstPresentation : CartPresentationBetween source middle)
    (secondPresentation : CartPresentationBetween middle target)
    (firstCleavage :
      CoreFiberCartesianCleavage (typedCartSemanticInput firstPresentation))
    (secondCleavage :
      CoreFiberCartesianCleavage (typedCartSemanticInput secondPresentation))
    (targetPackage : CoreFiber target.toSemantic) :
    (coreFiberCleavageIteratedCartesianLift firstPresentation secondPresentation
      firstCleavage secondCleavage targetPackage).hom =
      (firstCleavage.lift
        (secondCleavage.reindexFunctor.obj targetPackage)).hom ≫
        (secondCleavage.lift targetPackage).hom :=
  rfl

/-- The cleavage whose lift family is the actual two-step composite. -/
noncomputable def coreFiberCleavageIteratedCleavage
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (firstPresentation : CartPresentationBetween source middle)
    (secondPresentation : CartPresentationBetween middle target)
    (firstCleavage :
      CoreFiberCartesianCleavage (typedCartSemanticInput firstPresentation))
    (secondCleavage :
      CoreFiberCartesianCleavage (typedCartSemanticInput secondPresentation)) :
    CoreFiberCartesianCleavage
      (typedCartSemanticInput
        (compPresentation firstPresentation secondPresentation)) where
  lift := coreFiberCleavageIteratedCartesianLift firstPresentation
    secondPresentation firstCleavage secondCleavage

/-- The compositor component from the iterated domain to the direct domain. -/
noncomputable def coreFiberCleavageReindexCompositorApp
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (firstPresentation : CartPresentationBetween source middle)
    (secondPresentation : CartPresentationBetween middle target)
    (firstCleavage :
      CoreFiberCartesianCleavage (typedCartSemanticInput firstPresentation))
    (secondCleavage :
      CoreFiberCartesianCleavage (typedCartSemanticInput secondPresentation))
    (compositeCleavage : CoreFiberCartesianCleavage
      (typedCartSemanticInput
        (compPresentation firstPresentation secondPresentation)))
    (targetPackage : CoreFiber target.toSemantic) :
    (secondCleavage.reindexFunctor ⋙ firstCleavage.reindexFunctor).obj
        targetPackage ≅
      compositeCleavage.reindexFunctor.obj targetPackage := by
  simpa only [CoreFiberCartesianCleavage.reindexFunctor_obj,
    coreFiberCleavageIteratedCleavage,
    coreFiberCleavageIteratedCartesianLift] using
      CoreFiberCartesianCleavage.comparisonApp
        (coreFiberCleavageIteratedCleavage firstPresentation
          secondPresentation firstCleavage secondCleavage)
        compositeCleavage targetPackage

/-- The compositor component has the actual two-step factor triangle. -/
theorem coreFiberCleavageReindexCompositorApp_hom_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (firstPresentation : CartPresentationBetween source middle)
    (secondPresentation : CartPresentationBetween middle target)
    (firstCleavage :
      CoreFiberCartesianCleavage (typedCartSemanticInput firstPresentation))
    (secondCleavage :
      CoreFiberCartesianCleavage (typedCartSemanticInput secondPresentation))
    (compositeCleavage : CoreFiberCartesianCleavage
      (typedCartSemanticInput
        (compPresentation firstPresentation secondPresentation)))
    (targetPackage : CoreFiber target.toSemantic) :
    (coreFiberCleavageReindexCompositorApp firstPresentation
      secondPresentation firstCleavage secondCleavage compositeCleavage
      targetPackage).hom.1 ≫
        (compositeCleavage.lift targetPackage).hom =
      (coreFiberCleavageIteratedCartesianLift firstPresentation
        secondPresentation firstCleavage secondCleavage targetPackage).hom := by
  simpa only [coreFiberCleavageReindexCompositorApp,
    coreFiberCleavageIteratedCleavage] using
      CoreFiberCartesianCleavage.comparisonApp_hom_fac
        (coreFiberCleavageIteratedCleavage firstPresentation
          secondPresentation firstCleavage secondCleavage)
        compositeCleavage targetPackage

/-- The iterated functor map has the two-step factor graph. -/
theorem coreFiberCleavageIteratedMap_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (firstPresentation : CartPresentationBetween source middle)
    (secondPresentation : CartPresentationBetween middle target)
    (firstCleavage :
      CoreFiberCartesianCleavage (typedCartSemanticInput firstPresentation))
    (secondCleavage :
      CoreFiberCartesianCleavage (typedCartSemanticInput secondPresentation))
    {sourcePackage targetPackage : CoreFiber target.toSemantic}
    (hom : sourcePackage ⟶ targetPackage) :
    ((secondCleavage.reindexFunctor ⋙ firstCleavage.reindexFunctor).map hom).1 ≫
        (coreFiberCleavageIteratedCartesianLift firstPresentation
          secondPresentation firstCleavage secondCleavage targetPackage).hom =
      (coreFiberCleavageIteratedCartesianLift firstPresentation
        secondPresentation firstCleavage secondCleavage sourcePackage).hom ≫
        hom.1 := by
  change
    (firstCleavage.reindexFunctor.map
      (secondCleavage.reindexFunctor.map hom)).1 ≫
        ((firstCleavage.lift
          (secondCleavage.reindexFunctor.obj targetPackage)).hom ≫
          (secondCleavage.lift targetPackage).hom) =
      ((firstCleavage.lift
          (secondCleavage.reindexFunctor.obj sourcePackage)).hom ≫
        (secondCleavage.lift sourcePackage).hom) ≫ hom.1
  calc
    _ = ((firstCleavage.reindexFunctor.map
          (secondCleavage.reindexFunctor.map hom)).1 ≫
        (firstCleavage.lift
          (secondCleavage.reindexFunctor.obj targetPackage)).hom) ≫
        (secondCleavage.lift targetPackage).hom :=
      (Category.assoc _ _ _).symm
    _ = ((firstCleavage.lift
          (secondCleavage.reindexFunctor.obj sourcePackage)).hom ≫
        (secondCleavage.reindexFunctor.map hom).1) ≫
        (secondCleavage.lift targetPackage).hom := by
      rw [firstCleavage.reindexFunctor_map_fac]
    _ = (firstCleavage.lift
          (secondCleavage.reindexFunctor.obj sourcePackage)).hom ≫
        ((secondCleavage.reindexFunctor.map hom).1 ≫
          (secondCleavage.lift targetPackage).hom) :=
      Category.assoc _ _ _
    _ = (firstCleavage.lift
          (secondCleavage.reindexFunctor.obj sourcePackage)).hom ≫
        ((secondCleavage.lift sourcePackage).hom ≫ hom.1) := by
      rw [secondCleavage.reindexFunctor_map_fac]
    _ = _ := (Category.assoc _ _ _).symm

/-- The choice-relative compositor is natural on every vertical map. -/
theorem coreFiberCleavageReindexCompositor_naturality
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (firstPresentation : CartPresentationBetween source middle)
    (secondPresentation : CartPresentationBetween middle target)
    (firstCleavage :
      CoreFiberCartesianCleavage (typedCartSemanticInput firstPresentation))
    (secondCleavage :
      CoreFiberCartesianCleavage (typedCartSemanticInput secondPresentation))
    (compositeCleavage : CoreFiberCartesianCleavage
      (typedCartSemanticInput
        (compPresentation firstPresentation secondPresentation)))
    {sourcePackage targetPackage : CoreFiber target.toSemantic}
    (hom : sourcePackage ⟶ targetPackage) :
    (secondCleavage.reindexFunctor ⋙ firstCleavage.reindexFunctor).map hom ≫
        (coreFiberCleavageReindexCompositorApp firstPresentation
          secondPresentation firstCleavage secondCleavage compositeCleavage
          targetPackage).hom =
      (coreFiberCleavageReindexCompositorApp firstPresentation
        secondPresentation firstCleavage secondCleavage compositeCleavage
        sourcePackage).hom ≫
        compositeCleavage.reindexFunctor.map hom := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let directTarget := compositeCleavage.lift targetPackage
  letI := directTarget.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U)
    (typedCartSemanticInput
      (compPresentation firstPresentation secondPresentation)).hom
    directTarget.hom (𝟙 source.toSemantic)
  change
    (((secondCleavage.reindexFunctor ⋙ firstCleavage.reindexFunctor).map hom).1 ≫
      (coreFiberCleavageReindexCompositorApp firstPresentation
        secondPresentation firstCleavage secondCleavage compositeCleavage
        targetPackage).hom.1) ≫ directTarget.hom =
      ((coreFiberCleavageReindexCompositorApp firstPresentation
        secondPresentation firstCleavage secondCleavage compositeCleavage
        sourcePackage).hom.1 ≫
        (compositeCleavage.reindexFunctor.map hom).1) ≫ directTarget.hom
  calc
    _ = ((secondCleavage.reindexFunctor ⋙ firstCleavage.reindexFunctor).map
          hom).1 ≫
        ((coreFiberCleavageReindexCompositorApp firstPresentation
          secondPresentation firstCleavage secondCleavage compositeCleavage
          targetPackage).hom.1 ≫ directTarget.hom) :=
      Category.assoc _ _ _
    _ = ((secondCleavage.reindexFunctor ⋙ firstCleavage.reindexFunctor).map
          hom).1 ≫
        (coreFiberCleavageIteratedCartesianLift firstPresentation
          secondPresentation firstCleavage secondCleavage targetPackage).hom := by
      rw [coreFiberCleavageReindexCompositorApp_hom_fac]
    _ = (coreFiberCleavageIteratedCartesianLift firstPresentation
        secondPresentation firstCleavage secondCleavage sourcePackage).hom ≫
        hom.1 := coreFiberCleavageIteratedMap_fac firstPresentation
          secondPresentation firstCleavage secondCleavage hom
    _ = ((coreFiberCleavageReindexCompositorApp firstPresentation
          secondPresentation firstCleavage secondCleavage compositeCleavage
          sourcePackage).hom.1 ≫
        (compositeCleavage.lift sourcePackage).hom) ≫ hom.1 := by
      rw [coreFiberCleavageReindexCompositorApp_hom_fac]
    _ = (coreFiberCleavageReindexCompositorApp firstPresentation
          secondPresentation firstCleavage secondCleavage compositeCleavage
          sourcePackage).hom.1 ≫
        ((compositeCleavage.lift sourcePackage).hom ≫ hom.1) :=
      Category.assoc _ _ _
    _ = (coreFiberCleavageReindexCompositorApp firstPresentation
          secondPresentation firstCleavage secondCleavage compositeCleavage
          sourcePackage).hom.1 ≫
        ((compositeCleavage.reindexFunctor.map hom).1 ≫ directTarget.hom) := by
      rw [compositeCleavage.reindexFunctor_map_fac]
    _ = _ := (Category.assoc _ _ _).symm

/-- The natural contravariant compositor generated by three choices. -/
noncomputable def coreFiberCleavageReindexCompositor
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (firstPresentation : CartPresentationBetween source middle)
    (secondPresentation : CartPresentationBetween middle target)
    (firstCleavage :
      CoreFiberCartesianCleavage (typedCartSemanticInput firstPresentation))
    (secondCleavage :
      CoreFiberCartesianCleavage (typedCartSemanticInput secondPresentation))
    (compositeCleavage : CoreFiberCartesianCleavage
      (typedCartSemanticInput
        (compPresentation firstPresentation secondPresentation))) :
    secondCleavage.reindexFunctor ⋙ firstCleavage.reindexFunctor ≅
      compositeCleavage.reindexFunctor :=
  NatIso.ofComponents
    (coreFiberCleavageReindexCompositorApp firstPresentation
      secondPresentation firstCleavage secondCleavage compositeCleavage)
    (fun hom => coreFiberCleavageReindexCompositor_naturality
      firstPresentation secondPresentation firstCleavage secondCleavage
      compositeCleavage hom)

/-! ## Choice-relative identity unitor -/

/-- The literal identity lift, independent of a cleavage choice. -/
noncomputable def coreFiberCleavageIdentityCartesianLift
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U)
    (targetPackage : CoreFiber instanceCode.toSemantic) :
    StrongCartesianLift
      (typedCartSemanticInput (idTypedPresentation instanceCode))
      targetPackage where
  domain := targetPackage.1
  hom := 𝟙 targetPackage.1
  isStronglyCartesian := by
    letI : (packageProjection U).IsHomLift
        (𝟙 instanceCode.toSemantic) (𝟙 targetPackage.1) :=
      CategoryTheory.IsHomLift.id targetPackage.2
    letI : IsIso (𝟙 targetPackage.1) := by infer_instance
    have hid :
        (typedCartSemanticInput (idTypedPresentation instanceCode)).hom =
          𝟙 instanceCode.toSemantic :=
      typedRealizableHom_id_hom instanceCode
    rw [hid]
    exact CategoryTheory.Functor.IsStronglyCartesian.of_isIso
      (packageProjection U) (𝟙 instanceCode.toSemantic) (𝟙 targetPackage.1)

/-- The literal identity lift family as a cleavage. -/
noncomputable def coreFiberCleavageIdentityCleavage
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U) :
    CoreFiberCartesianCleavage
      (typedCartSemanticInput (idTypedPresentation instanceCode)) where
  lift := coreFiberCleavageIdentityCartesianLift instanceCode

/-- The unitor component from the literal object to the chosen identity lift. -/
noncomputable def coreFiberCleavageReindexUnitorApp
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U)
    (identityCleavage : CoreFiberCartesianCleavage
      (typedCartSemanticInput (idTypedPresentation instanceCode)))
    (targetPackage : CoreFiber instanceCode.toSemantic) :
    targetPackage ≅ identityCleavage.reindexFunctor.obj targetPackage := by
  simpa only [CoreFiberCartesianCleavage.reindexFunctor_obj,
    coreFiberCleavageIdentityCleavage,
    coreFiberCleavageIdentityCartesianLift] using
      CoreFiberCartesianCleavage.comparisonApp
        (coreFiberCleavageIdentityCleavage instanceCode)
        identityCleavage targetPackage

/-- The unitor component followed by the chosen lift is literal identity. -/
theorem coreFiberCleavageReindexUnitorApp_hom_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U)
    (identityCleavage : CoreFiberCartesianCleavage
      (typedCartSemanticInput (idTypedPresentation instanceCode)))
    (targetPackage : CoreFiber instanceCode.toSemantic) :
    (coreFiberCleavageReindexUnitorApp instanceCode identityCleavage
      targetPackage).hom.1 ≫ (identityCleavage.lift targetPackage).hom =
      𝟙 targetPackage.1 := by
  simpa only [coreFiberCleavageReindexUnitorApp,
    coreFiberCleavageIdentityCleavage,
    coreFiberCleavageIdentityCartesianLift] using
      CoreFiberCartesianCleavage.comparisonApp_hom_fac
        (coreFiberCleavageIdentityCleavage instanceCode)
        identityCleavage targetPackage

/-- The choice-relative unitor is natural on every vertical map. -/
theorem coreFiberCleavageReindexUnitor_naturality
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U)
    (identityCleavage : CoreFiberCartesianCleavage
      (typedCartSemanticInput (idTypedPresentation instanceCode)))
    {sourcePackage targetPackage : CoreFiber instanceCode.toSemantic}
    (hom : sourcePackage ⟶ targetPackage) :
    hom ≫ (coreFiberCleavageReindexUnitorApp instanceCode identityCleavage
      targetPackage).hom =
      (coreFiberCleavageReindexUnitorApp instanceCode identityCleavage
        sourcePackage).hom ≫ identityCleavage.reindexFunctor.map hom := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let targetLift := identityCleavage.lift targetPackage
  letI := targetLift.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U)
    (typedCartSemanticInput (idTypedPresentation instanceCode)).hom
    targetLift.hom (𝟙 instanceCode.toSemantic)
  change
    (hom.1 ≫ (coreFiberCleavageReindexUnitorApp instanceCode
      identityCleavage targetPackage).hom.1) ≫ targetLift.hom =
      ((coreFiberCleavageReindexUnitorApp instanceCode identityCleavage
        sourcePackage).hom.1 ≫
        (identityCleavage.reindexFunctor.map hom).1) ≫ targetLift.hom
  calc
    _ = hom.1 ≫ ((coreFiberCleavageReindexUnitorApp instanceCode
        identityCleavage targetPackage).hom.1 ≫ targetLift.hom) :=
      Category.assoc _ _ _
    _ = hom.1 ≫ 𝟙 targetPackage.1 := by
      rw [coreFiberCleavageReindexUnitorApp_hom_fac]
    _ = hom.1 := Category.comp_id _
    _ = 𝟙 sourcePackage.1 ≫ hom.1 := (Category.id_comp _).symm
    _ = ((coreFiberCleavageReindexUnitorApp instanceCode identityCleavage
        sourcePackage).hom.1 ≫
        (identityCleavage.lift sourcePackage).hom) ≫ hom.1 := by
      rw [coreFiberCleavageReindexUnitorApp_hom_fac]
    _ = (coreFiberCleavageReindexUnitorApp instanceCode identityCleavage
        sourcePackage).hom.1 ≫
        ((identityCleavage.lift sourcePackage).hom ≫ hom.1) :=
      Category.assoc _ _ _
    _ = (coreFiberCleavageReindexUnitorApp instanceCode identityCleavage
        sourcePackage).hom.1 ≫
        ((identityCleavage.reindexFunctor.map hom).1 ≫ targetLift.hom) := by
      rw [identityCleavage.reindexFunctor_map_fac]
    _ = _ := (Category.assoc _ _ _).symm

/-- The natural identity unitor generated by one identity-arrow choice. -/
noncomputable def coreFiberCleavageReindexUnitor
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U)
    (identityCleavage : CoreFiberCartesianCleavage
      (typedCartSemanticInput (idTypedPresentation instanceCode))) :
    𝟭 (CoreFiber instanceCode.toSemantic) ≅
      identityCleavage.reindexFunctor :=
  NatIso.ofComponents
    (coreFiberCleavageReindexUnitorApp instanceCode identityCleavage)
    (fun hom => coreFiberCleavageReindexUnitor_naturality
      instanceCode identityCleavage hom)

/-! ## Compatibility with canonical choice comparison -/

/-- Componentwise compositor compatibility for three simultaneous choices. -/
theorem coreFiberCleavageReindexCompositor_compatibility_app
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (firstPresentation : CartPresentationBetween source middle)
    (secondPresentation : CartPresentationBetween middle target)
    (first₀ first₁ :
      CoreFiberCartesianCleavage (typedCartSemanticInput firstPresentation))
    (second₀ second₁ :
      CoreFiberCartesianCleavage (typedCartSemanticInput secondPresentation))
    (composite₀ composite₁ : CoreFiberCartesianCleavage
      (typedCartSemanticInput
        (compPresentation firstPresentation secondPresentation)))
    (targetPackage : CoreFiber target.toSemantic) :
    (coreFiberCleavageReindexCompositorApp firstPresentation secondPresentation
      first₀ second₀ composite₀ targetPackage).hom ≫
        (CoreFiberCartesianCleavage.comparisonApp composite₀ composite₁
          targetPackage).hom =
      first₀.reindexFunctor.map
          (CoreFiberCartesianCleavage.comparisonApp second₀ second₁
            targetPackage).hom ≫
        (CoreFiberCartesianCleavage.comparisonApp first₀ first₁
          (second₁.reindexFunctor.obj targetPackage)).hom ≫
        (coreFiberCleavageReindexCompositorApp firstPresentation
          secondPresentation first₁ second₁ composite₁ targetPackage).hom := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let directTarget := composite₁.lift targetPackage
  letI := directTarget.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U)
    (typedCartSemanticInput
      (compPresentation firstPresentation secondPresentation)).hom
    directTarget.hom (𝟙 source.toSemantic)
  change
    ((coreFiberCleavageReindexCompositorApp firstPresentation
      secondPresentation first₀ second₀ composite₀ targetPackage).hom.1 ≫
      (CoreFiberCartesianCleavage.comparisonApp composite₀ composite₁
        targetPackage).hom.1) ≫ directTarget.hom =
      (((first₀.reindexFunctor.map
        (CoreFiberCartesianCleavage.comparisonApp second₀ second₁
          targetPackage).hom).1 ≫
        (CoreFiberCartesianCleavage.comparisonApp first₀ first₁
          (second₁.reindexFunctor.obj targetPackage)).hom.1) ≫
        (coreFiberCleavageReindexCompositorApp firstPresentation
          secondPresentation first₁ second₁ composite₁ targetPackage).hom.1) ≫
        directTarget.hom
  calc
    _ = (coreFiberCleavageReindexCompositorApp firstPresentation
        secondPresentation first₀ second₀ composite₀ targetPackage).hom.1 ≫
      ((CoreFiberCartesianCleavage.comparisonApp composite₀ composite₁
        targetPackage).hom.1 ≫ directTarget.hom) := Category.assoc _ _ _
    _ = (coreFiberCleavageReindexCompositorApp firstPresentation
        secondPresentation first₀ second₀ composite₀ targetPackage).hom.1 ≫
      (composite₀.lift targetPackage).hom := by
      rw [CoreFiberCartesianCleavage.comparisonApp_hom_fac]
    _ = (coreFiberCleavageIteratedCartesianLift firstPresentation
        secondPresentation first₀ second₀ targetPackage).hom :=
      coreFiberCleavageReindexCompositorApp_hom_fac firstPresentation
        secondPresentation first₀ second₀ composite₀ targetPackage
    _ = (first₀.lift (second₀.reindexFunctor.obj targetPackage)).hom ≫
        (second₀.lift targetPackage).hom := rfl
    _ = (first₀.lift (second₀.reindexFunctor.obj targetPackage)).hom ≫
        ((CoreFiberCartesianCleavage.comparisonApp second₀ second₁
          targetPackage).hom.1 ≫ (second₁.lift targetPackage).hom) := by
      rw [CoreFiberCartesianCleavage.comparisonApp_hom_fac]
    _ = ((first₀.lift (second₀.reindexFunctor.obj targetPackage)).hom ≫
        (CoreFiberCartesianCleavage.comparisonApp second₀ second₁
          targetPackage).hom.1) ≫ (second₁.lift targetPackage).hom :=
      (Category.assoc _ _ _).symm
    _ = ((first₀.reindexFunctor.map
        (CoreFiberCartesianCleavage.comparisonApp second₀ second₁
          targetPackage).hom).1 ≫
        (first₀.lift (second₁.reindexFunctor.obj targetPackage)).hom) ≫
        (second₁.lift targetPackage).hom := by
      rw [first₀.reindexFunctor_map_fac]
    _ = (first₀.reindexFunctor.map
        (CoreFiberCartesianCleavage.comparisonApp second₀ second₁
          targetPackage).hom).1 ≫
        ((first₀.lift (second₁.reindexFunctor.obj targetPackage)).hom ≫
          (second₁.lift targetPackage).hom) := Category.assoc _ _ _
    _ = (first₀.reindexFunctor.map
        (CoreFiberCartesianCleavage.comparisonApp second₀ second₁
          targetPackage).hom).1 ≫
        (((CoreFiberCartesianCleavage.comparisonApp first₀ first₁
          (second₁.reindexFunctor.obj targetPackage)).hom.1 ≫
          (first₁.lift (second₁.reindexFunctor.obj targetPackage)).hom) ≫
          (second₁.lift targetPackage).hom) := by
      rw [CoreFiberCartesianCleavage.comparisonApp_hom_fac]
    _ = ((first₀.reindexFunctor.map
        (CoreFiberCartesianCleavage.comparisonApp second₀ second₁
          targetPackage).hom).1 ≫
        (CoreFiberCartesianCleavage.comparisonApp first₀ first₁
          (second₁.reindexFunctor.obj targetPackage)).hom.1) ≫
        ((first₁.lift (second₁.reindexFunctor.obj targetPackage)).hom ≫
          (second₁.lift targetPackage).hom) := by
      simp only [Category.assoc]
    _ = ((first₀.reindexFunctor.map
        (CoreFiberCartesianCleavage.comparisonApp second₀ second₁
          targetPackage).hom).1 ≫
        (CoreFiberCartesianCleavage.comparisonApp first₀ first₁
          (second₁.reindexFunctor.obj targetPackage)).hom.1) ≫
        (coreFiberCleavageIteratedCartesianLift firstPresentation
          secondPresentation first₁ second₁ targetPackage).hom := rfl
    _ = ((first₀.reindexFunctor.map
        (CoreFiberCartesianCleavage.comparisonApp second₀ second₁
          targetPackage).hom).1 ≫
        (CoreFiberCartesianCleavage.comparisonApp first₀ first₁
          (second₁.reindexFunctor.obj targetPackage)).hom.1) ≫
        ((coreFiberCleavageReindexCompositorApp firstPresentation
          secondPresentation first₁ second₁ composite₁ targetPackage).hom.1 ≫
          directTarget.hom) := by
      rw [coreFiberCleavageReindexCompositorApp_hom_fac]
    _ = _ := (Category.assoc _ _ _).symm

/-- The comparison whiskered across two contravariant reindex functors. -/
noncomputable def coreFiberCleavageHorizontalComparison
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (firstPresentation : CartPresentationBetween source middle)
    (secondPresentation : CartPresentationBetween middle target)
    (first₀ first₁ :
      CoreFiberCartesianCleavage (typedCartSemanticInput firstPresentation))
    (second₀ second₁ :
      CoreFiberCartesianCleavage (typedCartSemanticInput secondPresentation)) :
    second₀.reindexFunctor ⋙ first₀.reindexFunctor ≅
      second₁.reindexFunctor ⋙ first₁.reindexFunctor :=
  (Functor.isoWhiskerRight
    (CoreFiberCartesianCleavage.comparison second₀ second₁)
    first₀.reindexFunctor).trans
  (Functor.isoWhiskerLeft second₁.reindexFunctor
    (CoreFiberCartesianCleavage.comparison first₀ first₁))

/-- Whole compositor compatibility under three simultaneous choice changes. -/
theorem coreFiberCleavageReindexCompositor_compatibility
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (firstPresentation : CartPresentationBetween source middle)
    (secondPresentation : CartPresentationBetween middle target)
    (first₀ first₁ :
      CoreFiberCartesianCleavage (typedCartSemanticInput firstPresentation))
    (second₀ second₁ :
      CoreFiberCartesianCleavage (typedCartSemanticInput secondPresentation))
    (composite₀ composite₁ : CoreFiberCartesianCleavage
      (typedCartSemanticInput
        (compPresentation firstPresentation secondPresentation))) :
    (coreFiberCleavageReindexCompositor firstPresentation secondPresentation
      first₀ second₀ composite₀).trans
        (CoreFiberCartesianCleavage.comparison composite₀ composite₁) =
      (coreFiberCleavageHorizontalComparison firstPresentation
        secondPresentation first₀ first₁ second₀ second₁).trans
        (coreFiberCleavageReindexCompositor firstPresentation secondPresentation
          first₁ second₁ composite₁) := by
  apply Iso.ext
  apply NatTrans.ext
  funext targetPackage
  change
    (coreFiberCleavageReindexCompositorApp firstPresentation secondPresentation
      first₀ second₀ composite₀ targetPackage).hom ≫
        (CoreFiberCartesianCleavage.comparisonApp composite₀ composite₁
          targetPackage).hom =
      first₀.reindexFunctor.map
          (CoreFiberCartesianCleavage.comparisonApp second₀ second₁
            targetPackage).hom ≫
        (CoreFiberCartesianCleavage.comparisonApp first₀ first₁
          (second₁.reindexFunctor.obj targetPackage)).hom ≫
        (coreFiberCleavageReindexCompositorApp firstPresentation
          secondPresentation first₁ second₁ composite₁ targetPackage).hom
  exact coreFiberCleavageReindexCompositor_compatibility_app
    firstPresentation secondPresentation first₀ first₁ second₀ second₁
    composite₀ composite₁ targetPackage

/-- Componentwise unitor compatibility under identity-cleavage replacement. -/
theorem coreFiberCleavageReindexUnitor_compatibility_app
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U)
    (first second : CoreFiberCartesianCleavage
      (typedCartSemanticInput (idTypedPresentation instanceCode)))
    (targetPackage : CoreFiber instanceCode.toSemantic) :
    (coreFiberCleavageReindexUnitorApp instanceCode first targetPackage).hom ≫
        (CoreFiberCartesianCleavage.comparisonApp first second
          targetPackage).hom =
      (coreFiberCleavageReindexUnitorApp instanceCode second
        targetPackage).hom := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let secondTarget := second.lift targetPackage
  letI := secondTarget.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U)
    (typedCartSemanticInput (idTypedPresentation instanceCode)).hom
    secondTarget.hom (𝟙 instanceCode.toSemantic)
  change
    ((coreFiberCleavageReindexUnitorApp instanceCode first targetPackage).hom.1 ≫
      (CoreFiberCartesianCleavage.comparisonApp first second
        targetPackage).hom.1) ≫ secondTarget.hom =
      (coreFiberCleavageReindexUnitorApp instanceCode second
        targetPackage).hom.1 ≫ secondTarget.hom
  calc
    _ = (coreFiberCleavageReindexUnitorApp instanceCode first
        targetPackage).hom.1 ≫
      ((CoreFiberCartesianCleavage.comparisonApp first second
        targetPackage).hom.1 ≫ secondTarget.hom) := Category.assoc _ _ _
    _ = (coreFiberCleavageReindexUnitorApp instanceCode first
        targetPackage).hom.1 ≫ (first.lift targetPackage).hom := by
      rw [CoreFiberCartesianCleavage.comparisonApp_hom_fac]
    _ = 𝟙 targetPackage.1 :=
      coreFiberCleavageReindexUnitorApp_hom_fac instanceCode first targetPackage
    _ = (coreFiberCleavageReindexUnitorApp instanceCode second
        targetPackage).hom.1 ≫ secondTarget.hom :=
      (coreFiberCleavageReindexUnitorApp_hom_fac instanceCode second
        targetPackage).symm

/-- Whole unitor compatibility under identity-cleavage replacement. -/
theorem coreFiberCleavageReindexUnitor_compatibility
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U)
    (first second : CoreFiberCartesianCleavage
      (typedCartSemanticInput (idTypedPresentation instanceCode))) :
    (coreFiberCleavageReindexUnitor instanceCode first).trans
        (CoreFiberCartesianCleavage.comparison first second) =
      coreFiberCleavageReindexUnitor instanceCode second := by
  apply Iso.ext
  apply NatTrans.ext
  funext targetPackage
  exact coreFiberCleavageReindexUnitor_compatibility_app instanceCode
    first second targetPackage

/-! ## Direct bridge to the accepted selected Cycle 32 surface -/

/-- The generic selected object is canonically the existing selected object. -/
noncomputable def selectedTypedCoreFiberCleavageBridgeApp
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target)
    (targetPackage : CoreFiber target.toSemantic) :
    (selectedTypedCoreFiberCartesianCleavage presentation).reindexFunctor.obj
        targetPackage ≅
      (selectedTypedCoreFiberReindexFunctor presentation).obj targetPackage where
  hom := ⟨𝟙 (selectedTypedCoreFiberCartesianLift presentation
      targetPackage).domain, by
    let lift := selectedTypedCoreFiberCartesianLift presentation targetPackage
    letI := lift.isStronglyCartesian
    exact CategoryTheory.IsHomLift.id lift.domainObject.2⟩
  inv := ⟨𝟙 (selectedTypedCoreFiberCartesianLift presentation
      targetPackage).domain, by
    let lift := selectedTypedCoreFiberCartesianLift presentation targetPackage
    letI := lift.isStronglyCartesian
    exact CategoryTheory.IsHomLift.id lift.domainObject.2⟩
  hom_inv_id := by
    apply CategoryTheory.Functor.Fiber.hom_ext
    change
      (𝟙 (selectedTypedCoreFiberCartesianLift presentation
        targetPackage).domain) ≫
        𝟙 (selectedTypedCoreFiberCartesianLift presentation
          targetPackage).domain =
      𝟙 (selectedTypedCoreFiberCartesianLift presentation
        targetPackage).domain
    simp
  inv_hom_id := by
    apply CategoryTheory.Functor.Fiber.hom_ext
    change
      (𝟙 (selectedTypedCoreFiberCartesianLift presentation
        targetPackage).domain) ≫
        𝟙 (selectedTypedCoreFiberCartesianLift presentation
          targetPackage).domain =
      𝟙 (selectedTypedCoreFiberCartesianLift presentation
        targetPackage).domain
    simp

/-- The selected bridge is vertical and leaves the accepted lift triangle fixed. -/
theorem selectedTypedCoreFiberCleavageBridgeApp_hom_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target)
    (targetPackage : CoreFiber target.toSemantic) :
    (selectedTypedCoreFiberCleavageBridgeApp presentation targetPackage).hom.1 ≫
      (selectedTypedCoreFiberCartesianLift presentation targetPackage).hom =
      (selectedTypedCoreFiberCartesianLift presentation targetPackage).hom := by
  change
    𝟙 (selectedTypedCoreFiberCartesianLift presentation targetPackage).domain ≫
        (selectedTypedCoreFiberCartesianLift presentation targetPackage).hom =
      (selectedTypedCoreFiberCartesianLift presentation targetPackage).hom
  simp

/-- The selected bridge is natural on every vertical target map. -/
theorem selectedTypedCoreFiberCleavageBridge_naturality
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target)
    {sourcePackage targetPackage : CoreFiber target.toSemantic}
    (hom : sourcePackage ⟶ targetPackage) :
    (selectedTypedCoreFiberCartesianCleavage presentation).reindexFunctor.map hom ≫
        (selectedTypedCoreFiberCleavageBridgeApp presentation
          targetPackage).hom =
      (selectedTypedCoreFiberCleavageBridgeApp presentation sourcePackage).hom ≫
        (selectedTypedCoreFiberReindexFunctor presentation).map hom := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let targetLift := selectedTypedCoreFiberCartesianLift
    presentation targetPackage
  letI := targetLift.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U) (typedCartSemanticInput presentation).hom
    targetLift.hom (𝟙 source.toSemantic)
  change
    (((selectedTypedCoreFiberCartesianCleavage presentation).reindexFunctor.map
      hom).1 ≫
      (selectedTypedCoreFiberCleavageBridgeApp presentation
        targetPackage).hom.1) ≫ targetLift.hom =
      ((selectedTypedCoreFiberCleavageBridgeApp presentation
        sourcePackage).hom.1 ≫
        ((selectedTypedCoreFiberReindexFunctor presentation).map hom).1) ≫
        targetLift.hom
  calc
    _ = ((selectedTypedCoreFiberCartesianCleavage presentation).reindexFunctor.map
        hom).1 ≫
      ((selectedTypedCoreFiberCleavageBridgeApp presentation
        targetPackage).hom.1 ≫ targetLift.hom) := Category.assoc _ _ _
    _ = ((selectedTypedCoreFiberCartesianCleavage presentation).reindexFunctor.map
        hom).1 ≫ targetLift.hom := by
      rw [selectedTypedCoreFiberCleavageBridgeApp_hom_fac]
    _ = (selectedTypedCoreFiberCartesianLift presentation sourcePackage).hom ≫
        hom.1 :=
      (selectedTypedCoreFiberCartesianCleavage presentation
        ).reindexFunctor_map_fac hom
    _ = ((selectedTypedCoreFiberCleavageBridgeApp presentation
        sourcePackage).hom.1 ≫
      (selectedTypedCoreFiberCartesianLift presentation sourcePackage).hom) ≫
        hom.1 := by
      rw [selectedTypedCoreFiberCleavageBridgeApp_hom_fac]
    _ = (selectedTypedCoreFiberCleavageBridgeApp presentation
        sourcePackage).hom.1 ≫
      ((selectedTypedCoreFiberCartesianLift presentation sourcePackage).hom ≫
        hom.1) := Category.assoc _ _ _
    _ = (selectedTypedCoreFiberCleavageBridgeApp presentation
        sourcePackage).hom.1 ≫
      (((selectedTypedCoreFiberReindexFunctor presentation).map hom).1 ≫
        targetLift.hom) := by
      rw [selectedTypedCoreFiberReindexFunctor_map_fac]
    _ = _ := (Category.assoc _ _ _).symm

/-- The generic selected functor is canonically identified with Cycle 32's functor. -/
noncomputable def selectedTypedCoreFiberCleavageBridge
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target) :
    (selectedTypedCoreFiberCartesianCleavage presentation).reindexFunctor ≅
      selectedTypedCoreFiberReindexFunctor presentation :=
  NatIso.ofComponents (selectedTypedCoreFiberCleavageBridgeApp presentation)
    (fun hom => selectedTypedCoreFiberCleavageBridge_naturality
      presentation hom)

/-- The two selected bridges whiskered across a typed composable pair. -/
noncomputable def selectedTypedCoreFiberCleavageHorizontalBridge
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (firstPresentation : CartPresentationBetween source middle)
    (secondPresentation : CartPresentationBetween middle target) :
    (selectedTypedCoreFiberCartesianCleavage secondPresentation
        ).reindexFunctor ⋙
      (selectedTypedCoreFiberCartesianCleavage firstPresentation
        ).reindexFunctor ≅
      selectedTypedCoreFiberReindexFunctor secondPresentation ⋙
        selectedTypedCoreFiberReindexFunctor firstPresentation :=
  (Functor.isoWhiskerRight
    (selectedTypedCoreFiberCleavageBridge secondPresentation)
    (selectedTypedCoreFiberCartesianCleavage firstPresentation
      ).reindexFunctor).trans
  (Functor.isoWhiskerLeft
    (selectedTypedCoreFiberReindexFunctor secondPresentation)
    (selectedTypedCoreFiberCleavageBridge firstPresentation))

/--
The generic selected compositor and the accepted Cycle 32 compositor have the
same component after the producer-derived bridge.
-/
theorem selectedTypedCoreFiberCleavageCompositor_bridge_app
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (firstPresentation : CartPresentationBetween source middle)
    (secondPresentation : CartPresentationBetween middle target)
    (targetPackage : CoreFiber target.toSemantic) :
    (coreFiberCleavageReindexCompositorApp firstPresentation secondPresentation
      (selectedTypedCoreFiberCartesianCleavage firstPresentation)
      (selectedTypedCoreFiberCartesianCleavage secondPresentation)
      (selectedTypedCoreFiberCartesianCleavage
        (compPresentation firstPresentation secondPresentation))
      targetPackage).hom ≫
        (selectedTypedCoreFiberCleavageBridgeApp
          (compPresentation firstPresentation secondPresentation)
          targetPackage).hom =
      (selectedTypedCoreFiberCartesianCleavage firstPresentation
        ).reindexFunctor.map
          (selectedTypedCoreFiberCleavageBridgeApp secondPresentation
            targetPackage).hom ≫
        (selectedTypedCoreFiberCleavageBridgeApp firstPresentation
          ((selectedTypedCoreFiberReindexFunctor secondPresentation).obj
            targetPackage)).hom ≫
        (selectedCoreFiberReindexCompositorApp firstPresentation
          secondPresentation targetPackage).hom := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let directTarget := selectedTypedCoreFiberCartesianLift
    (compPresentation firstPresentation secondPresentation) targetPackage
  letI := directTarget.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U)
    (typedCartSemanticInput
      (compPresentation firstPresentation secondPresentation)).hom
    directTarget.hom (𝟙 source.toSemantic)
  have hfirstMap :=
    (selectedTypedCoreFiberCartesianCleavage firstPresentation
      ).reindexFunctor_map_fac
        (selectedTypedCoreFiberCleavageBridgeApp secondPresentation
