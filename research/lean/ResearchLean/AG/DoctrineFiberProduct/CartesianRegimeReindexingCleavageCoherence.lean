        (compPresentation firstPresentation secondPresentation))).trans
      (selectedTypedCoreFiberCleavageBridge
        (compPresentation firstPresentation secondPresentation)) =
      (selectedTypedCoreFiberCleavageHorizontalBridge firstPresentation
        secondPresentation).trans
        (selectedCoreFiberReindexCompositor firstPresentation
          secondPresentation) := by
  apply Iso.ext
