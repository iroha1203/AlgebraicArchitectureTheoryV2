import ResearchLean.AG.DoctrineFiberProduct.UpperGeometryCompatiblePseudofunctorCoherence

/-!
# Global canonical upper-mate equation on compatible routes

The canonical geometry mate generated by the G-115 cleavage intertwines the
two route comparators generated from the single authored source comparator.
The equation is proved after the pulled route leg from the two comparator
factor laws and the mate triangle, then reflected first through the package
and finally through the complete geometry Cartesian universal properties.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u v

open CategoryTheory AtomFoundation GeometryTransport CrossStageCoherence
open TransportCoherence

set_option maxHeartbeats 3000000

namespace UpperGeometryCompatibleProblemInputData

/-- The two generated route comparators intertwine the canonical compatible
upper mate at every presented two-cell. -/
theorem generatedCompatibleUpperGeometryMateAt_comparator_intertwining
    {U : AtomCarrier.{u}} {ctx : ActiveRefinementBCContext U}
    {P : FiniteTransportPresentation.{u}} {k : CommRingCat.{v}}
    (input : UpperGeometryCompatibleProblemInputData ctx P k)
    (cell : P.TwoCell) :
    (CompositeFiberAut.hom
        (input.generatedBaseRouteComparator cell)).comp
          (input.generatedCompatibleUpperGeometryMateAt (P.twoTarget cell)) =
      (input.generatedCompatibleUpperGeometryMateAt (P.twoTarget cell)).comp
        (CompositeFiberAut.hom
          (input.generatedPulledRouteComparator cell)) := by
  apply (exactGeometryToRefinementGeometry U).map_injective
  let target := P.twoTarget cell
  let mate := input.generatedCompatibleUpperGeometryMateAt target
  let baseComparator := CompositeFiberAut.hom
    (input.generatedBaseRouteComparator cell)
  let pulledComparator := CompositeFiberAut.hom
    (input.generatedPulledRouteComparator cell)
  let pulledLeg := input.generatedPulledRouteLegAt target
  have hafterLeg :
      (((exactGeometryToRefinementGeometry U).map baseComparator) ≫
          ((exactGeometryToRefinementGeometry U).map mate)) ≫ pulledLeg =
        (((exactGeometryToRefinementGeometry U).map mate) ≫
          ((exactGeometryToRefinementGeometry U).map pulledComparator)) ≫
            pulledLeg := by
    have hbaseFac := input.generatedBaseRouteComparator_fac cell
    have hpulledFac := input.generatedPulledRouteComparator_fac cell
    have htriangle := input.generatedCompatibleUpperGeometryMateAt_triangle target
    calc
      _ = ((exactGeometryToRefinementGeometry U).map baseComparator) ≫
          (((exactGeometryToRefinementGeometry U).map mate) ≫ pulledLeg) :=
        Category.assoc _ _ _
      _ = ((exactGeometryToRefinementGeometry U).map baseComparator) ≫
          input.generatedBaseRouteLegAt target := congrArg _ htriangle
      _ = input.generatedBaseRouteLegAt target ≫
          (exactGeometryToRefinementGeometry U).map
            (CompositeFiberAut.hom (input.sourceTransport.comparator cell)) :=
        hbaseFac
      _ = (((exactGeometryToRefinementGeometry U).map mate) ≫ pulledLeg) ≫
          (exactGeometryToRefinementGeometry U).map
            (CompositeFiberAut.hom (input.sourceTransport.comparator cell)) :=
        congrArg
          (fun hom => hom ≫ (exactGeometryToRefinementGeometry U).map
            (CompositeFiberAut.hom (input.sourceTransport.comparator cell)))
          htriangle.symm
      _ = ((exactGeometryToRefinementGeometry U).map mate) ≫
          (pulledLeg ≫ (exactGeometryToRefinementGeometry U).map
            (CompositeFiberAut.hom (input.sourceTransport.comparator cell))) :=
        Category.assoc _ _ _
      _ = ((exactGeometryToRefinementGeometry U).map mate) ≫
          (((exactGeometryToRefinementGeometry U).map pulledComparator) ≫
            pulledLeg) := congrArg _ hpulledFac.symm
      _ = _ := (Category.assoc _ _ _).symm
  let left := (exactGeometryToRefinementGeometry U).map
    (baseComparator.comp mate)
  let right := (exactGeometryToRefinementGeometry U).map
    (mate.comp pulledComparator)
  have hafterLeg' : left.comp pulledLeg = right.comp pulledLeg := by
    exact hafterLeg
  have hleftBase : left.base = right.base := by
    let packageLeft := left.base
    let packageRight := right.base
    have hpackageBase : packageLeft.base = packageRight.base := by
      change (exactPointedToRefinement U).map
          ((baseComparator.comp mate).base.base) =
        (exactPointedToRefinement U).map
          ((mate.comp pulledComparator).base.base)
      apply congrArg (exactPointedToRefinement U).map
      change baseComparator.base.base.comp mate.base.base =
        mate.base.base.comp pulledComparator.base.base
      rw [CompositeFiberAut.hom_base_base_eq,
        CompositeFiberAut.hom_base_base_eq]
      apply ExtInstHom.ext
      apply ExactDoctrineHom.ext
      · rfl
      · apply Equiv.ext
        intro atom
        rfl
    letI hpackageLeftLift :=
      UpperGeometryCleavage.refinementPackageHom_isHomLift_of_base_eq
        packageRight.base packageLeft hpackageBase
    letI hpackageRightLift :=
      UpperGeometryCleavage.refinementPackageHom_isHomLift_of_base_eq
        packageRight.base packageRight rfl
    letI : (refinementPackageProjection U).IsStronglyCartesian
        pulledLeg.base.base pulledLeg.base :=
      UpperGeometryCleavage.pulledRouteGeometryBase_isStronglyCartesian
        (ctx.retarget (input.sourceFiberDiagram.obj ⟨target⟩))
        (input.sourceTargetGeometryAt target)
    apply CategoryTheory.Functor.IsStronglyCartesian.ext
      (refinementPackageProjection U)
      pulledLeg.base.base pulledLeg.base packageRight.base
    exact congrArg RefinementGeometryHom.base hafterLeg'
  letI hleftLift :=
    UpperGeometryCleavage.refinementGeometryHom_isHomLift_of_base_eq
      right.base left hleftBase
  letI hrightLift :=
    UpperGeometryCleavage.refinementGeometryHom_isHomLift_of_base_eq
      right.base right rfl
  letI := input.generatedPulledRouteLegAt_isStronglyCartesian target
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (refinementGeometryProjection U)
    pulledLeg.base pulledLeg right.base
  exact hafterLeg'

end UpperGeometryCompatibleProblemInputData

end AAT.AG.DoctrineFiberProduct

#assert_standard_axioms_only AAT.AG.DoctrineFiberProduct
