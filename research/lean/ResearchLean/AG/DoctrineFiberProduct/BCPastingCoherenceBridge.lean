import ResearchLean.AG.CrossStageCoherence.CorePseudofunctor
import ResearchLean.AG.TransportCoherence.CanonicalCoherence

/-!
# Package-to-fiber compositor coherence bridge

This module starts the G-106/G-109 bridge required by G-110(E) at its binary
component.  It identifies each G-109 core-fiber compositor component with the
corresponding G-106 comparison generated by G-101 uniqueness, after retaining
the necessary source-object cast explicitly.

The three-arrow whiskering and associator compatibility needed to consume
`transportAlong_comp_coherence` remain separate obligations.  In particular,
this binary checkpoint does not claim the full G-110(E) bridge.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open CategoryTheory
open AtomFoundation
open TransportCoherence
open CrossStageCoherence

set_option maxHeartbeats 2000000

/-- A core-fiber canonical lift is definitionally the underlying G-106 package lift. -/
theorem coreFiberLift_as_transportAlongHom {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (sigma : X ⟶ Y) (G : CoreFiber X) :
    coreFiberLift sigma G =
      transportAlongHom G.1 (coreFiberBaseHom sigma G).doctrineHom := rfl

/--
The pointed base arrow of a composite is the projected first canonical lift
followed by the second pointed arrow.  This is the base-level cast needed to
compare the G-109 compositor with the G-106 binary comparison.
-/
theorem coreFiberBaseHom_comp {U : AtomCarrier.{u}}
    {X Y Z : ExtractionInstance U}
    (sigma : X ⟶ Y) (tau : Y ⟶ Z) (G : CoreFiber X) :
    coreFiberBaseHom (sigma ≫ tau) G =
      (packageProjection U).map (coreFiberLift sigma G) ≫
        coreFiberBaseHom tau ((coreFiberTransportFunctor sigma).obj G) := by
  calc
    _ = (eqToHom G.2 ≫ sigma) ≫ tau :=
      (Category.assoc _ _ _).symm
    _ = ((packageProjection U).map (coreFiberLift sigma G) ≫
          eqToHom ((coreFiberTransportFunctor sigma).obj G).2) ≫ tau := by
      rw [coreFiberLift_projection]
    _ = (packageProjection U).map (coreFiberLift sigma G) ≫
          (eqToHom ((coreFiberTransportFunctor sigma).obj G).2 ≫ tau) :=
      Category.assoc _ _ _
    _ = _ := rfl

/-- The doctrine-hom form of `coreFiberBaseHom_comp`. -/
theorem coreFiberBaseHom_comp_doctrineHom {U : AtomCarrier.{u}}
    {X Y Z : ExtractionInstance U}
    (sigma : X ⟶ Y) (tau : Y ⟶ Z) (G : CoreFiber X) :
    (coreFiberBaseHom (sigma ≫ tau) G).doctrineHom =
      (coreFiberBaseHom sigma G).doctrineHom.comp
        (coreFiberBaseHom tau
          ((coreFiberTransportFunctor sigma).obj G)).doctrineHom := by
  calc
    _ = (((packageProjection U).map (coreFiberLift sigma G)) ≫
          coreFiberBaseHom tau ((coreFiberTransportFunctor sigma).obj G)).doctrineHom :=
      congrArg ExtInstHom.doctrineHom (coreFiberBaseHom_comp sigma tau G)
    _ = _ := rfl

/-- The explicit source-object cast from G-109 direct transport to G-106 direct transport. -/
noncomputable def coreFiberDirectPackageEq {U : AtomCarrier.{u}}
    {X Y Z : ExtractionInstance U}
    (sigma : X ⟶ Y) (tau : Y ⟶ Z) (G : CoreFiber X) :
    coreFiberTransportObject (sigma ≫ tau) G =
      transportAlong G.1
        ((coreFiberBaseHom sigma G).doctrineHom.comp
          (coreFiberBaseHom tau
            ((coreFiberTransportFunctor sigma).obj G)).doctrineHom) :=
  congrArg (transportAlong G.1)
    (coreFiberBaseHom_comp_doctrineHom sigma tau G)

/-- Transport along equal doctrine morphisms commutes with the induced object cast. -/
theorem transportAlongHom_eqToHom_congrArg {U : AtomCarrier.{u}}
    (P : AATCorePackage U) {E : ExtractionDoctrine U}
    (f g : ExactDoctrineHom P.reading.doctrine E) (h : f = g) :
    transportAlongHom P f ≫ eqToHom (congrArg (transportAlong P) h) =
      transportAlongHom P g := by
  subst h
  simp

/-- Composition of equality transports is independent of the chosen equality proofs. -/
theorem eqToHom_comp3 {C : Type u} [Category C]
    {A B C' D : C} (hAB : A = B) (hBC : B = C') (hCD : C' = D)
    (hAD : A = D) :
    ((eqToHom hAB : A ⟶ B) ≫ eqToHom hBC) ≫ eqToHom hCD =
      eqToHom hAD := by
  subst hAB
  subst hBC
  subst hCD
  simp

/-- The G-109 direct lift becomes the G-106 direct lift after the explicit cast. -/
theorem coreFiberDirectLift_cast_fac {U : AtomCarrier.{u}}
    {X Y Z : ExtractionInstance U}
    (sigma : X ⟶ Y) (tau : Y ⟶ Z) (G : CoreFiber X) :
    coreFiberLift (sigma ≫ tau) G ≫
        eqToHom (coreFiberDirectPackageEq sigma tau G) =
      transportAlongHom G.1
        ((coreFiberBaseHom sigma G).doctrineHom.comp
          (coreFiberBaseHom tau
            ((coreFiberTransportFunctor sigma).obj G)).doctrineHom) :=
  transportAlongHom_eqToHom_congrArg G.1 _ _
    (coreFiberBaseHom_comp_doctrineHom sigma tau G)

/--
Direct binary bridge: after the required source cast, the G-109 compositor
component has exactly the G-106 generated binary comparison factorization.
-/
theorem coreFiberCompositorApp_binary_bridge {U : AtomCarrier.{u}}
    {X Y Z : ExtractionInstance U}
    (sigma : X ⟶ Y) (tau : Y ⟶ Z) (G : CoreFiber X) :
    coreFiberLift (sigma ≫ tau) G ≫
        (coreFiberCompositorApp sigma tau G).hom.1 =
      coreFiberLift (sigma ≫ tau) G ≫
        (eqToHom (coreFiberDirectPackageEq sigma tau G) ≫
          (transportAlong_compFiberIso G.1
            (coreFiberBaseHom sigma G).doctrineHom
            (coreFiberBaseHom tau
              ((coreFiberTransportFunctor sigma).obj G)).doctrineHom).iso.hom) := by
  rw [coreFiberCompositorApp_hom_fac, ← Category.assoc,
    coreFiberDirectLift_cast_fac]
  change coreFiberIteratedLift sigma tau G =
    (transportAlongHom G.1
      ((coreFiberBaseHom sigma G).doctrineHom.comp
        (coreFiberBaseHom tau
          ((coreFiberTransportFunctor sigma).obj G)).doctrineHom)).comp
      (transportAlong_compFiberIso G.1
        (coreFiberBaseHom sigma G).doctrineHom
        (coreFiberBaseHom tau
          ((coreFiberTransportFunctor sigma).obj G)).doctrineHom).iso.hom
  rw [transportAlong_compFiberIso_hom_fac]
  rfl

/--
Component-level binary bridge.  The equality includes the source-object cast,
so the G-109 component cannot be identified with an unrelated G-106 factor.
-/
theorem coreFiberCompositorApp_hom_eq_transportAlong_compFiberIso
    {U : AtomCarrier.{u}}
    {X Y Z : ExtractionInstance U}
    (sigma : X ⟶ Y) (tau : Y ⟶ Z) (G : CoreFiber X) :
    (coreFiberCompositorApp sigma tau G).hom.1 =
      eqToHom (coreFiberDirectPackageEq sigma tau G) ≫
        (transportAlong_compFiberIso G.1
          (coreFiberBaseHom sigma G).doctrineHom
          (coreFiberBaseHom tau
            ((coreFiberTransportFunctor sigma).obj G)).doctrineHom).iso.hom := by
  let rhs := eqToHom (coreFiberDirectPackageEq sigma tau G) ≫
    (transportAlong_compFiberIso G.1
      (coreFiberBaseHom sigma G).doctrineHom
      (coreFiberBaseHom tau
        ((coreFiberTransportFunctor sigma).obj G)).doctrineHom).iso.hom
  letI : (packageProjection U).IsStronglyCocartesian (sigma ≫ tau)
      (coreFiberLift (sigma ≫ tau) G) :=
    coreFiberLift_isStronglyCocartesian (sigma ≫ tau) G
  letI : (packageProjection U).IsHomLift
      (𝟙 Z) (coreFiberCompositorApp sigma tau G).hom.1 :=
    (coreFiberCompositorApp sigma tau G).hom.2
  letI : (packageProjection U).IsHomLift (𝟙 Z) rhs := by
    apply CategoryTheory.IsHomLift.of_commsq
      (packageProjection U) (𝟙 Z) rhs
      ((coreFiberTransportFunctor (sigma ≫ tau)).obj G).2
      ((coreFiberTransportFunctor tau).obj
        ((coreFiberTransportFunctor sigma).obj G)).2
    change (packageProjection U).map
        (eqToHom (coreFiberDirectPackageEq sigma tau G) ≫
          (transportAlong_compFiberIso G.1
            (coreFiberBaseHom sigma G).doctrineHom
            (coreFiberBaseHom tau
              ((coreFiberTransportFunctor sigma).obj G)).doctrineHom).iso.hom) ≫
      eqToHom ((coreFiberTransportFunctor tau).obj
        ((coreFiberTransportFunctor sigma).obj G)).2 =
      eqToHom ((coreFiberTransportFunctor (sigma ≫ tau)).obj G).2 ≫ 𝟙 Z
    rw [Functor.map_comp, eqToHom_map, packageProjection_map]
    rw [(transportAlong_compFiberIso G.1
      (coreFiberBaseHom sigma G).doctrineHom
      (coreFiberBaseHom tau
        ((coreFiberTransportFunctor sigma).obj G)).doctrineHom).hom_base_eq]
    simp only [Category.comp_id]
    exact eqToHom_comp3
      (congrArg (packageProjection U).obj
        (coreFiberDirectPackageEq sigma tau G))
      (transportAlong_comp_point G.1
        (coreFiberBaseHom sigma G).doctrineHom
        (coreFiberBaseHom tau
          ((coreFiberTransportFunctor sigma).obj G)).doctrineHom)
      ((coreFiberTransportFunctor tau).obj
        ((coreFiberTransportFunctor sigma).obj G)).2
      ((coreFiberTransportFunctor (sigma ≫ tau)).obj G).2
  apply CategoryTheory.Functor.IsStronglyCocartesian.ext
    (packageProjection U) (sigma ≫ tau)
    (coreFiberLift (sigma ≫ tau) G) (𝟙 Z)
  exact coreFiberCompositorApp_binary_bridge sigma tau G

/-- The casted G-106 binary comparison as an actual target-fiber morphism. -/
noncomputable def coreFiberG106CompositorHom {U : AtomCarrier.{u}}
    {X Y Z : ExtractionInstance U}
    (sigma : X ⟶ Y) (tau : Y ⟶ Z) (G : CoreFiber X) :
    (coreFiberTransportFunctor (sigma ≫ tau)).obj G ⟶
      (coreFiberTransportFunctor tau).obj
        ((coreFiberTransportFunctor sigma).obj G) := by
  refine ⟨eqToHom (coreFiberDirectPackageEq sigma tau G) ≫
      (transportAlong_compFiberIso G.1
        (coreFiberBaseHom sigma G).doctrineHom
        (coreFiberBaseHom tau
          ((coreFiberTransportFunctor sigma).obj G)).doctrineHom).iso.hom, ?_⟩
  rw [← coreFiberCompositorApp_hom_eq_transportAlong_compFiberIso]
  exact (coreFiberCompositorApp sigma tau G).hom.2

/-- The G-109 compositor component is the casted G-106 component in the fiber. -/
theorem coreFiberCompositorApp_hom_eq_g106 {U : AtomCarrier.{u}}
    {X Y Z : ExtractionInstance U}
    (sigma : X ⟶ Y) (tau : Y ⟶ Z) (G : CoreFiber X) :
    (coreFiberCompositorApp sigma tau G).hom =
      coreFiberG106CompositorHom sigma tau G := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  exact coreFiberCompositorApp_hom_eq_transportAlong_compFiberIso sigma tau G

end AAT.AG.DoctrineFiberProduct

#assert_standard_axioms_only AAT.AG.DoctrineFiberProduct
