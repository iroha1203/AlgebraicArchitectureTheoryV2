import ResearchLean.AG.DoctrineFiberProduct.UpperGeometryFiniteGeometryExactification

/-!
# G-115-local Cartesian geometry cleavage

This module proves the Cartesian universal properties of the explicit exact
and realized-refinement geometry lifts generated by G-115.  Completed
predecessor GOALs are used only through their reviewed public interfaces.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u v

open CategoryTheory AtomFoundation GeometryTransport CrossStageCoherence

namespace UpperGeometryCleavage

set_option maxHeartbeats 3000000

private theorem contextObjectExt
    {U : AtomCarrier.{u}} {A : ArchitectureObject U}
    {C : Site.ContextPreorderCategory A}
    {W V : Site.ContextCategoryObject C} (h : W.ctx = V.ctx) : W = V := by
  cases W
  cases V
  cases h
  rfl

private def refinementGeomReadHomCastBase
    {U : AtomCarrier.{u}} {G H : GeometryPackage.{u, v} U}
    {f g : RefinementGeometryBaseHom G H} (hfg : f = g)
    (F : RefinementGeomReadHom G H f) : RefinementGeomReadHom G H g := by
  cases hfg
  exact F

private theorem refinementGeomReadHomCastBase_heq
    {U : AtomCarrier.{u}} {G H : GeometryPackage.{u, v} U}
    {f g : RefinementGeometryBaseHom G H} (hfg : f = g)
    (F : RefinementGeomReadHom G H f) :
    HEq (refinementGeomReadHomCastBase hfg F) F := by
  cases hfg
  rfl

private theorem refinementGeomReadHomComp_castBase_heq
    {U : AtomCarrier.{u}} {G H K : GeometryPackage.{u, v} U}
    {f f' : RefinementGeometryBaseHom G H}
    {g : RefinementGeometryBaseHom H K} (hff' : f = f')
    (F : RefinementGeomReadHom G H f)
    (T : RefinementGeomReadHom H K g) :
    HEq (RefinementGeomReadHom.comp
      (refinementGeomReadHomCastBase hff' F) T)
      (RefinementGeomReadHom.comp F T) := by
  cases hff'
  rfl

/-! ## Exact generated leg -/

/-- The exact context inverse cancels the generated exact forward context. -/
theorem generatedExactContextBackward_forward_ctx
    {U : AtomCarrier.{u}} {X : ExtractionInstance U}
    (G : GeometryPackage.{u, v} U) (f : X ⟶ packagePoint G.core)
    (W : (exactSourceGeometry G f).site.category) :
    (refinementGeometryContextBackward
      ((exactPackageToRefinement U).map (exactBaseHom G f))
      (refinementGeometryContextForward
        ((exactPackageToRefinement U).map (exactBaseHom G f)) W)).ctx = W.ctx := by
  change
    ((inverseCorePackageForwardUpper G.core f).equationTransport.contextBackward
      ((inverseCorePackageForwardUpper G.core f).equationTransport.contextForward
        W)).ctx = W.ctx
  rw [inverseCorePackageForwardUpper_contextInverse_obj_eq,
    inverseCorePackageForwardUpper_contextFunctor_obj_eq]
  simp

/-- Backward transport of a composite through the generated exact forward
context recovers the preceding context. -/
theorem generatedExactCompositeContextBackward_forward_ctx
    {U : AtomCarrier.{u}} {X : ExtractionInstance U}
    (G : GeometryPackage.{u, v} U) (f : X ⟶ packagePoint G.core)
    {K : GeometryPackage.{u, v} U}
    (g : RefinementPackageHom ⟨K.core⟩ ⟨(exactSourceGeometry G f).core⟩)
    (W : (exactSourceGeometry G f).site.category) :
    refinementGeometryContextBackwardMap
        (g.comp ((exactPackageToRefinement U).map (exactBaseHom G f)))
        (refinementGeometryContextForward
          ((exactPackageToRefinement U).map (exactBaseHom G f)) W).ctx =
      (refinementGeometryContextBackward g W).ctx := by
  change
    (refinementGeometryContextBackward g
      (refinementGeometryContextBackward
        ((exactPackageToRefinement U).map (exactBaseHom G f))
        (refinementGeometryContextForward
          ((exactPackageToRefinement U).map (exactBaseHom G f)) W))).ctx = _
  rw [contextObjectExt (generatedExactContextBackward_forward_ctx G f W)]

/-- Componentwise exact Cartesian factor generated from a compatible composite
geometry hom. -/
noncomputable def generatedExactCartesianFactorGeomCore
    {U : AtomCarrier.{u}} {X : ExtractionInstance U}
    (G : GeometryPackage.{u, v} U) (f : X ⟶ packagePoint G.core)
    {K : GeometryPackage.{u, v} U}
    (g : RefinementPackageHom ⟨K.core⟩ ⟨(exactSourceGeometry G f).core⟩)
    (H : RefinementGeomReadHom K G
      (g.comp ((exactPackageToRefinement U).map (exactBaseHom G f)))) :
    RefinementGeomReadHom K (exactSourceGeometry G f) g where
  coverage := by
    refine {
      requiredSupport := H.coverage.requiredSupport
      requiredEquationCoordinate := H.coverage.requiredEquationCoordinate
      selectedViolationWitness := H.coverage.selectedViolationWitness
      requiredAxis := H.coverage.requiredAxis
      supportVisibleOn := H.coverage.supportVisibleOn
      equationCoordinateVisibleOn := H.coverage.equationCoordinateVisibleOn
      violationWitnessVisibleOn := H.coverage.violationWitnessVisibleOn
      axisReadableOn := H.coverage.axisReadableOn
      boundaryVisibleOn := H.coverage.boundaryVisibleOn
    }
  overlap := {
    overlapIso := fun base left right => by
      let exactMap := (exactPackageToRefinement U).map (exactBaseHom G f)
      let baseW := refinementGeometryContextForward exactMap
        (⟨base⟩ : (exactSourceGeometry G f).site.category)
      let leftW := refinementGeometryContextForward exactMap
        (⟨left⟩ : (exactSourceGeometry G f).site.category)
      let rightW := refinementGeometryContextForward exactMap
        (⟨right⟩ : (exactSourceGeometry G f).site.category)
      let mapped := (refinementGeometryContextInverse exactMap).mapIso
        (H.overlap.overlapIso baseW.ctx leftW.ctx rightW.ctx)
      refine (eqToIso ?_).trans (mapped.trans (eqToIso ?_))
      · apply contextObjectExt
        dsimp [mapped, baseW, leftW, rightW, exactMap]
        rw [generatedExactCompositeContextBackward_forward_ctx G f g
          (⟨base⟩ : (exactSourceGeometry G f).site.category)]
        rw [generatedExactCompositeContextBackward_forward_ctx G f g
          (⟨left⟩ : (exactSourceGeometry G f).site.category)]
        rw [generatedExactCompositeContextBackward_forward_ctx G f g
          (⟨right⟩ : (exactSourceGeometry G f).site.category)]
        change _ = (refinementGeometryContextBackward exactMap
          (refinementGeometryContextForward exactMap _)).ctx
        rw [generatedExactContextBackward_forward_ctx G f]
        rfl
      · apply contextObjectExt
        rfl
  }
  coefficientHom := H.coefficientHom
  raw_eq := by
    rw [exactSourceGeometry_raw_backward]
    unfold exactSourceCoefficientBackwardHom
    rw [LawAlgebra.RawAmbientRestrictionSystem.baseChange_id]
    unfold refinementRawTransport
    rw [H.raw_eq]
    change
      rawReindexUpper G.geometry (exactSourceGeometry G f).geometry
        (inverseCorePackageBackwardUpper G.core f)
        (rawReindexUpper K.geometry G.geometry
          (g.upper.comp (inverseCorePackageForwardUpper G.core f))
          (K.raw.baseChange H.coefficientHom)) =
      rawReindexUpper K.geometry (exactSourceGeometry G f).geometry
        g.upper (K.raw.baseChange H.coefficientHom)
    rw [rawReindexUpper_comp K.geometry
      (exactSourceGeometry G f).geometry G.geometry]
    rw [← rawReindexUpper_comp
      (exactSourceGeometry G f).geometry G.geometry
      (exactSourceGeometry G f).geometry]
    rw [inverseCorePackageForward_comp_backward]
    simpa using rawReindexUpper_id (exactSourceGeometry G f).geometry
      (rawReindexUpper K.geometry (exactSourceGeometry G f).geometry
        g.upper (K.raw.baseChange H.coefficientHom))
  supportComp := fun W support =>
    cast (inverseCorePackageForwardUpper_contextFunctor_obj_support_type
      G.core f (refinementGeometryContextForward g W))
      (H.supportComp W support)
  axisComp := fun W axis =>
    cast (inverseCorePackageForwardUpper_contextFunctor_obj_axis_type
      G.core f (refinementGeometryContextForward g W))
      (H.axisComp W axis)
  observableComp := fun W observable =>
    cast (inverseCorePackageForwardUpper_contextFunctor_obj_observable_type
      G.core f (refinementGeometryContextForward g W))
      (H.observableComp W observable)
  supportReads := by
    intro W support atom hs
    apply (generatedExactSupportComp_reads_iff G f
      (refinementGeometryContextForward g W)
      (cast (inverseCorePackageForwardUpper_contextFunctor_obj_support_type
        G.core f (refinementGeometryContextForward g W))
        (H.supportComp W support))
      (g.upper.atomEquiv atom)).mp
    simpa [RefinementPackageHom.comp, SignedExactCoreReadingHom.comp,
      EquationSystemExactTransport.comp, generatedExactSupportComp_inverse] using
      H.supportReads W support atom hs
  axisReads := by
    intro W axis ha
    apply (generatedExactAxisComp_reads_iff G f
      (refinementGeometryContextForward g W)
      (cast (inverseCorePackageForwardUpper_contextFunctor_obj_axis_type
        G.core f (refinementGeometryContextForward g W))
        (H.axisComp W axis))).mp
    simpa [RefinementPackageHom.comp, SignedExactCoreReadingHom.comp,
      EquationSystemExactTransport.comp, generatedExactAxisComp_inverse] using
      H.axisReads W axis ha
  observableReads := by
    intro W observable ho
    apply (generatedExactObservableComp_reads_iff G f
      (refinementGeometryContextForward g W)
      (cast (inverseCorePackageForwardUpper_contextFunctor_obj_observable_type
        G.core f (refinementGeometryContextForward g W))
        (H.observableComp W observable))).mp
    simpa [RefinementPackageHom.comp, SignedExactCoreReadingHom.comp,
      EquationSystemExactTransport.comp, generatedExactObservableComp_inverse] using
      H.observableReads W observable ho
  support_naturality := by
    intro W V w support
    apply generatedExactSupportComp_injective G f
      (refinementGeometryContextForward g V)
    rw [← generatedExactSupportComp_naturality G f
      ((refinementGeometryContextFunctor g).map w)
      (cast (inverseCorePackageForwardUpper_contextFunctor_obj_support_type
        G.core f (refinementGeometryContextForward g W))
        (H.supportComp W support))]
    rw [generatedExactSupportComp_inverse]
    simpa [RefinementPackageHom.comp, SignedExactCoreReadingHom.comp,
      EquationSystemExactTransport.comp, generatedExactSupportComp_inverse] using
      H.support_naturality w support
  axis_naturality := by
    intro W V w axis
    apply generatedExactAxisComp_injective G f
      (refinementGeometryContextForward g V)
    rw [← generatedExactAxisComp_naturality G f
      ((refinementGeometryContextFunctor g).map w)
      (cast (inverseCorePackageForwardUpper_contextFunctor_obj_axis_type
        G.core f (refinementGeometryContextForward g W))
        (H.axisComp W axis))]
    rw [generatedExactAxisComp_inverse]
    simpa [RefinementPackageHom.comp, SignedExactCoreReadingHom.comp,
      EquationSystemExactTransport.comp, generatedExactAxisComp_inverse] using
      H.axis_naturality w axis
  observable_naturality := by
    intro W V w observable
    apply generatedExactObservableComp_injective G f
      (refinementGeometryContextForward g W)
    rw [← generatedExactObservableComp_naturality G f
      ((refinementGeometryContextFunctor g).map w)
      (cast (inverseCorePackageForwardUpper_contextFunctor_obj_observable_type
        G.core f (refinementGeometryContextForward g V))
        (H.observableComp V observable))]
    rw [generatedExactObservableComp_inverse]
    simpa [RefinementPackageHom.comp, SignedExactCoreReadingHom.comp,
      EquationSystemExactTransport.comp, generatedExactObservableComp_inverse] using
      H.observable_naturality w observable

/-- Exact Cartesian factor for a total compatible geometry hom. -/
noncomputable def generatedExactCartesianFactor
    {U : AtomCarrier.{u}} {X : ExtractionInstance U}
    (G : GeometryPackage.{u, v} U) (f : X ⟶ packagePoint G.core)
    {K : GeometryPackage.{u, v} U}
    (g : RefinementPackageHom ⟨K.core⟩ ⟨(exactSourceGeometry G f).core⟩)
    (h : RefinementGeometryHom K G)
    (hbase : h.base = g.comp
      ((exactPackageToRefinement U).map (exactBaseHom G f))) :
    RefinementGeometryHom K (exactSourceGeometry G f) where
  base := g
  geometry := generatedExactCartesianFactorGeomCore G f g (hbase ▸ h.geometry)

/-- The exact Cartesian factor composes to the supplied total geometry hom. -/
theorem generatedExactCartesianFactor_fac
    {U : AtomCarrier.{u}} {X : ExtractionInstance U}
    (G : GeometryPackage.{u, v} U) (f : X ⟶ packagePoint G.core)
    {K : GeometryPackage.{u, v} U}
    (g : RefinementPackageHom ⟨K.core⟩ ⟨(exactSourceGeometry G f).core⟩)
    (h : RefinementGeometryHom K G)
    (hbase : h.base = g.comp
      ((exactPackageToRefinement U).map (exactBaseHom G f))) :
    RefinementGeometryHom.comp
        (generatedExactCartesianFactor G f g h hbase)
        ((exactGeometryToRefinementGeometry U).map
          (generatedExactGeometryHom G f)) = h := by
  apply RefinementGeometryHom.ext
  · exact hbase.symm
  · let H : RefinementGeomReadHom K G
        (g.comp ((exactPackageToRefinement U).map (exactBaseHom G f))) :=
      hbase ▸ h.geometry
    have hgeom :
        (RefinementGeometryHom.comp
          (generatedExactCartesianFactor G f g h hbase)
          ((exactGeometryToRefinementGeometry U).map
            (generatedExactGeometryHom G f))).geometry = H := by
      apply RefinementGeomReadHom.ext
      · rfl
      · apply heq_of_eq
        funext W support
        exact generatedExactSupportComp_inverse G f
          (refinementGeometryContextForward g W) _
      · apply heq_of_eq
        funext W axis
        exact generatedExactAxisComp_inverse G f
          (refinementGeometryContextForward g W) _
      · apply heq_of_eq
        funext W observable
        exact generatedExactObservableComp_inverse G f
          (refinementGeometryContextForward g W) _
    exact (heq_of_eq hgeom).trans (by
      dsimp [H]
      exact eqRec_heq hbase h.geometry)

/-- Factoring a composite through the exact generated leg recovers its first
geometry contract. -/
theorem generatedExactCartesianFactorGeomCore_of_composite
    {U : AtomCarrier.{u}} {X : ExtractionInstance U}
    (G : GeometryPackage.{u, v} U) (f : X ⟶ packagePoint G.core)
    {K : GeometryPackage.{u, v} U}
    (g : RefinementPackageHom ⟨K.core⟩ ⟨(exactSourceGeometry G f).core⟩)
    (T : RefinementGeomReadHom K (exactSourceGeometry G f) g) :
    generatedExactCartesianFactorGeomCore G f g
        (RefinementGeomReadHom.comp T
          (((exactGeometryToRefinementGeometry U).map
            (generatedExactGeometryHom G f)).geometry)) = T := by
  apply RefinementGeomReadHom.ext
  · rfl
  · apply heq_of_eq
    funext W support
    apply eq_of_heq
    exact (cast_heq _ _).trans
      (generatedExactSupportComp_heq G f
        (refinementGeometryContextForward g W) (T.supportComp W support))
  · apply heq_of_eq
    funext W axis
    apply eq_of_heq
    exact (cast_heq _ _).trans
      (generatedExactAxisComp_heq G f
        (refinementGeometryContextForward g W) (T.axisComp W axis))
  · apply heq_of_eq
    funext W observable
    apply eq_of_heq
    exact (cast_heq _ _).trans
      (generatedExactObservableComp_heq G f
        (refinementGeometryContextForward g W) (T.observableComp W observable))

/-- The exact generated factor is the unique total factor with the specified
lower package map. -/
theorem generatedExactCartesianFactor_unique
    {U : AtomCarrier.{u}} {X : ExtractionInstance U}
    (G : GeometryPackage.{u, v} U) (f : X ⟶ packagePoint G.core)
    {K : GeometryPackage.{u, v} U}
    (g : RefinementPackageHom ⟨K.core⟩ ⟨(exactSourceGeometry G f).core⟩)
    (h : RefinementGeometryHom K G)
    (hbase : h.base = g.comp
      ((exactPackageToRefinement U).map (exactBaseHom G f)))
    (k : RefinementGeometryHom K (exactSourceGeometry G f))
    (hkbase : k.base = g)
    (hkfac : RefinementGeometryHom.comp k
      ((exactGeometryToRefinementGeometry U).map
        (generatedExactGeometryHom G f)) = h) :
    k = generatedExactCartesianFactor G f g h hbase := by
  let kGeometry := refinementGeomReadHomCastBase hkbase k.geometry
  let H : RefinementGeomReadHom K G
      (g.comp ((exactPackageToRefinement U).map (exactBaseHom G f))) :=
    hbase ▸ h.geometry
  have hnormalized : RefinementGeomReadHom.comp kGeometry
      (((exactGeometryToRefinementGeometry U).map
        (generatedExactGeometryHom G f)).geometry) = H := by
    apply eq_of_heq
    have hH : HEq h.geometry H := by
      dsimp [H]
      exact (eqRec_heq hbase h.geometry).symm
    exact ((refinementGeomReadHomComp_castBase_heq hkbase k.geometry
      (((exactGeometryToRefinementGeometry U).map
        (generatedExactGeometryHom G f)).geometry)).trans
      (RefinementGeometryHom.geometry_heq hkfac)).trans hH
  have hkGeometry : kGeometry =
      generatedExactCartesianFactorGeomCore G f g H := by
    calc
      kGeometry = generatedExactCartesianFactorGeomCore G f g
          (RefinementGeomReadHom.comp kGeometry
            (((exactGeometryToRefinementGeometry U).map
              (generatedExactGeometryHom G f)).geometry)) :=
        (generatedExactCartesianFactorGeomCore_of_composite
          G f g kGeometry).symm
      _ = generatedExactCartesianFactorGeomCore G f g H :=
        congrArg (generatedExactCartesianFactorGeomCore G f g) hnormalized
  apply RefinementGeometryHom.ext
  · exact hkbase
  · exact (refinementGeomReadHomCastBase_heq hkbase k.geometry).symm.trans
      (heq_of_eq hkGeometry)

/-- The explicit exact G-115 geometry lift is strongly Cartesian over the
refinement-geometry projection. -/
theorem generatedExactGeometryHom_isStronglyCartesian
    {U : AtomCarrier.{u}} {X : ExtractionInstance U}
    (G : GeometryPackage.{u, v} U) (f : X ⟶ packagePoint G.core) :
    (refinementGeometryProjection U).IsStronglyCartesian
      ((exactPackageToRefinement U).map (exactBaseHom G f))
      ((exactGeometryToRefinementGeometry U).map
        (generatedExactGeometryHom G f)) := by
  let exactLift := (exactGeometryToRefinementGeometry U).map
    (generatedExactGeometryHom G f)
  letI : (refinementGeometryProjection U).IsHomLift
      ((exactPackageToRefinement U).map (exactBaseHom G f)) exactLift := by
    apply CategoryTheory.IsHomLift.of_fac'
      (refinementGeometryProjection U) _ exactLift rfl rfl
    rfl
  apply CategoryTheory.Functor.IsStronglyCartesian.mk
  intro K g h hLift
  have hbase : h.base = g.comp
      ((exactPackageToRefinement U).map (exactBaseHom G f)) := by
    exact (CategoryTheory.IsHomLift.eq_of_isHomLift
      (refinementGeometryProjection U)
      (g.comp ((exactPackageToRefinement U).map (exactBaseHom G f))) h).symm
  let factor := generatedExactCartesianFactor G f g h hbase
  refine ⟨factor, ?_, ?_⟩
  · constructor
    · rw [← show factor.base = g from rfl]
      change (refinementGeometryProjection U).IsHomLift
        ((refinementGeometryProjection U).map factor) factor
      infer_instance
    · exact generatedExactCartesianFactor_fac G f g h hbase
  · intro factor' hfactor'
    apply generatedExactCartesianFactor_unique G f g h hbase factor'
    · letI : (refinementGeometryProjection U).IsHomLift g factor' :=
        hfactor'.1
      exact (CategoryTheory.IsHomLift.eq_of_isHomLift
        (p := refinementGeometryProjection U) g factor').symm
    · exact hfactor'.2

/-! ## Realized-refinement generated leg -/

/-- The realized-refinement context inverse cancels its generated forward
context. -/
theorem generatedRefinementContextBackward_forward_ctx
    {U : AtomCarrier.{u}} {X Y : ExtractionInstance U}
    (G : GeometryPackage.{u, v} U) (r : PointedRefinementHom X Y)
    (condition : RealizedLocusExtractionReflecting r)
    (hG : packagePoint G.core = Y)
    (W : (refinementSourceGeometry G r condition hG).site.category) :
    (refinementGeometryContextBackward (refinementBaseHom G r condition hG)
      (refinementGeometryContextForward (refinementBaseHom G r condition hG)
        W)).ctx = W.ctx := by
  subst Y
  let data := selectedTransportDataOfRealizedReflection r condition
    ⟨G.core, rfl⟩
  change
    ((SelectedRefinementTransport.inverseCorePackageForwardUpper
      G.core data).equationTransport.contextBackward
      ((SelectedRefinementTransport.inverseCorePackageForwardUpper
        G.core data).equationTransport.contextForward W)).ctx = W.ctx
  rw [SelectedRefinementTransport.inverseCorePackageForwardUpper_contextInverse_obj_eq,
    SelectedRefinementTransport.inverseCorePackageForwardUpper_contextFunctor_obj_eq]
  simp

/-- Backward transport of a composite through the generated refinement
forward context recovers the preceding context. -/
theorem generatedRefinementCompositeContextBackward_forward_ctx
    {U : AtomCarrier.{u}} {X Y : ExtractionInstance U}
    (G : GeometryPackage.{u, v} U) (r : PointedRefinementHom X Y)
    (condition : RealizedLocusExtractionReflecting r)
    (hG : packagePoint G.core = Y)
    {K : GeometryPackage.{u, v} U}
    (g : RefinementPackageHom ⟨K.core⟩
      ⟨(refinementSourceGeometry G r condition hG).core⟩)
    (W : (refinementSourceGeometry G r condition hG).site.category) :
    refinementGeometryContextBackwardMap
        (g.comp (refinementBaseHom G r condition hG))
        (refinementGeometryContextForward
          (refinementBaseHom G r condition hG) W).ctx =
      (refinementGeometryContextBackward g W).ctx := by
  change
    (refinementGeometryContextBackward g
      (refinementGeometryContextBackward (refinementBaseHom G r condition hG)
        (refinementGeometryContextForward (refinementBaseHom G r condition hG)
          W))).ctx = _
  rw [contextObjectExt
    (generatedRefinementContextBackward_forward_ctx G r condition hG W)]

/-- Componentwise realized-refinement Cartesian factor generated from a
compatible composite geometry hom. -/
noncomputable def generatedRefinementCartesianFactorGeomCore
    {U : AtomCarrier.{u}} {X Y : ExtractionInstance U}
    (G : GeometryPackage.{u, v} U) (r : PointedRefinementHom X Y)
    (condition : RealizedLocusExtractionReflecting r)
    (hG : packagePoint G.core = Y)
    {K : GeometryPackage.{u, v} U}
    (g : RefinementPackageHom ⟨K.core⟩
      ⟨(refinementSourceGeometry G r condition hG).core⟩)
    (H : RefinementGeomReadHom K G
      (g.comp (refinementBaseHom G r condition hG))) :
    RefinementGeomReadHom K (refinementSourceGeometry G r condition hG) g := by
  cases hG
  let data := selectedTransportDataOfRealizedReflection r condition
    ⟨G.core, rfl⟩
  exact {
    coverage := by
      refine {
        requiredSupport := H.coverage.requiredSupport
        requiredEquationCoordinate := H.coverage.requiredEquationCoordinate
        selectedViolationWitness := H.coverage.selectedViolationWitness
        requiredAxis := H.coverage.requiredAxis
        supportVisibleOn := H.coverage.supportVisibleOn
        equationCoordinateVisibleOn := H.coverage.equationCoordinateVisibleOn
        violationWitnessVisibleOn := H.coverage.violationWitnessVisibleOn
        axisReadableOn := H.coverage.axisReadableOn
        boundaryVisibleOn := H.coverage.boundaryVisibleOn
      }
    overlap := {
      overlapIso := fun base left right => by
        let refinementMap := refinementBaseHom G r condition rfl
        let baseW := refinementGeometryContextForward refinementMap
          (⟨base⟩ : (refinementSourceGeometry G r condition rfl).site.category)
        let leftW := refinementGeometryContextForward refinementMap
          (⟨left⟩ : (refinementSourceGeometry G r condition rfl).site.category)
        let rightW := refinementGeometryContextForward refinementMap
          (⟨right⟩ : (refinementSourceGeometry G r condition rfl).site.category)
        let mapped := (refinementGeometryContextInverse refinementMap).mapIso
          (H.overlap.overlapIso baseW.ctx leftW.ctx rightW.ctx)
        refine (eqToIso ?_).trans (mapped.trans (eqToIso ?_))
        · apply contextObjectExt
          dsimp [mapped, baseW, leftW, rightW, refinementMap]
          rw [generatedRefinementCompositeContextBackward_forward_ctx
            G r condition rfl g
            (⟨base⟩ : (refinementSourceGeometry G r condition rfl).site.category)]
          rw [generatedRefinementCompositeContextBackward_forward_ctx
            G r condition rfl g
            (⟨left⟩ : (refinementSourceGeometry G r condition rfl).site.category)]
          rw [generatedRefinementCompositeContextBackward_forward_ctx
            G r condition rfl g
            (⟨right⟩ : (refinementSourceGeometry G r condition rfl).site.category)]
          change _ = (refinementGeometryContextBackward refinementMap
            (refinementGeometryContextForward refinementMap _)).ctx
          rw [generatedRefinementContextBackward_forward_ctx G r condition rfl]
          rfl
        · apply contextObjectExt
          rfl
    }
    coefficientHom := H.coefficientHom
    raw_eq := by
      rw [refinementSourceGeometry_raw_backward]
      unfold refinementSourceCoefficientBackwardHom
      rw [LawAlgebra.RawAmbientRestrictionSystem.baseChange_id]
      unfold refinementRawTransport
      rw [H.raw_eq]
      change
        rawReindexUpper G.geometry
          (refinementSourceGeometry G r condition rfl).geometry
          (SelectedRefinementTransport.inverseCorePackageBackwardUpper
            G.core data)
          (rawReindexUpper K.geometry G.geometry
            (g.upper.comp
              (SelectedRefinementTransport.inverseCorePackageForwardUpper
                G.core data))
            (K.raw.baseChange H.coefficientHom)) =
        rawReindexUpper K.geometry
          (refinementSourceGeometry G r condition rfl).geometry
          g.upper (K.raw.baseChange H.coefficientHom)
      rw [rawReindexUpper_comp K.geometry
        (refinementSourceGeometry G r condition rfl).geometry G.geometry]
      rw [← rawReindexUpper_comp
        (refinementSourceGeometry G r condition rfl).geometry G.geometry
        (refinementSourceGeometry G r condition rfl).geometry]
      rw [SelectedRefinementTransport.inverseCorePackageForward_comp_backward]
      apply LawAlgebra.RawAmbientRestrictionSystem.ext <;> rfl
    supportComp := fun W support =>
      cast (SelectedRefinementTransport.inverseCorePackageForwardUpper_contextFunctor_obj_support_type
          G.core data (refinementGeometryContextForward g W))
        (H.supportComp W support)
    axisComp := fun W axis =>
      cast (SelectedRefinementTransport.inverseCorePackageForwardUpper_contextFunctor_obj_axis_type
          G.core data (refinementGeometryContextForward g W))
        (H.axisComp W axis)
    observableComp := fun W observable =>
      cast (SelectedRefinementTransport.inverseCorePackageForwardUpper_contextFunctor_obj_observable_type
          G.core data (refinementGeometryContextForward g W))
        (H.observableComp W observable)
    supportReads := by
      intro W support atom hs
      apply (generatedRefinementSupportComp_reads_iff G r condition rfl
        (refinementGeometryContextForward g W)
        (cast (SelectedRefinementTransport.inverseCorePackageForwardUpper_contextFunctor_obj_support_type
            G.core data (refinementGeometryContextForward g W))
          (H.supportComp W support))
        (g.upper.atomEquiv atom)).mp
      have hcarrier :
          generatedRefinementSupportComp G r condition rfl
              (refinementGeometryContextForward g W)
              (cast
                (SelectedRefinementTransport.inverseCorePackageForwardUpper_contextFunctor_obj_support_type
                  G.core data (refinementGeometryContextForward g W))
                (H.supportComp W support)) = H.supportComp W support := by
        apply eq_of_heq
        exact (generatedRefinementSupportComp_heq G r condition rfl
          (refinementGeometryContextForward g W) _).trans (cast_heq _ _)
      rw [hcarrier]
      change
        (refinementGeometryContextForward
          (g.comp (refinementBaseHom G r condition rfl)) W).ctx.minimal.supportReads
          (H.supportComp W support)
          ((g.comp (refinementBaseHom G r condition rfl)).upper.atomEquiv atom)
      exact H.supportReads W support atom hs
    axisReads := by
      intro W axis ha
      apply (generatedRefinementAxisComp_reads_iff G r condition rfl
        (refinementGeometryContextForward g W)
        (cast (SelectedRefinementTransport.inverseCorePackageForwardUpper_contextFunctor_obj_axis_type
            G.core data (refinementGeometryContextForward g W))
          (H.axisComp W axis))).mp
      have hcarrier :
          generatedRefinementAxisComp G r condition rfl
              (refinementGeometryContextForward g W)
              (cast
                (SelectedRefinementTransport.inverseCorePackageForwardUpper_contextFunctor_obj_axis_type
                  G.core data (refinementGeometryContextForward g W))
                (H.axisComp W axis)) = H.axisComp W axis := by
        apply eq_of_heq
        exact (generatedRefinementAxisComp_heq G r condition rfl
          (refinementGeometryContextForward g W) _).trans (cast_heq _ _)
      rw [hcarrier]
      change
        (refinementGeometryContextForward
          (g.comp (refinementBaseHom G r condition rfl)) W).ctx.minimal.axisReads
          (H.axisComp W axis)
      exact H.axisReads W axis ha
    observableReads := by
      intro W observable ho
      apply (generatedRefinementObservableComp_reads_iff G r condition rfl
        (refinementGeometryContextForward g W)
        (cast (SelectedRefinementTransport.inverseCorePackageForwardUpper_contextFunctor_obj_observable_type
            G.core data (refinementGeometryContextForward g W))
          (H.observableComp W observable))).mp
      have hcarrier :
          generatedRefinementObservableComp G r condition rfl
              (refinementGeometryContextForward g W)
              (cast
                (SelectedRefinementTransport.inverseCorePackageForwardUpper_contextFunctor_obj_observable_type
                  G.core data (refinementGeometryContextForward g W))
                (H.observableComp W observable)) = H.observableComp W observable := by
        apply eq_of_heq
        exact (generatedRefinementObservableComp_heq G r condition rfl
          (refinementGeometryContextForward g W) _).trans (cast_heq _ _)
      rw [hcarrier]
      change
        (refinementGeometryContextForward
          (g.comp (refinementBaseHom G r condition rfl)) W).ctx.minimal.observableReads
          (H.observableComp W observable)
      exact H.observableReads W observable ho
    support_naturality := by
      intro W V w support
      apply generatedRefinementSupportComp_injective G r condition rfl
        (refinementGeometryContextForward g V)
      rw [← generatedRefinementSupportComp_naturality G r condition rfl
        ((refinementGeometryContextFunctor g).map w)
        (cast (SelectedRefinementTransport.inverseCorePackageForwardUpper_contextFunctor_obj_support_type
            G.core data (refinementGeometryContextForward g W))
          (H.supportComp W support))]
      rw [generatedRefinementSupportComp_inverse]
      have hcarrier :
          generatedRefinementSupportComp G r condition rfl
              (refinementGeometryContextForward g V)
              (cast
                (SelectedRefinementTransport.inverseCorePackageForwardUpper_contextFunctor_obj_support_type
                  G.core data (refinementGeometryContextForward g V))
                (H.supportComp V
                  ((refinementSourceContextMorphism w).supportMap support))) =
            H.supportComp V
              ((refinementSourceContextMorphism w).supportMap support) := by
        apply eq_of_heq
        exact (generatedRefinementSupportComp_heq G r condition rfl
          (refinementGeometryContextForward g V) _).trans (cast_heq _ _)
      rw [hcarrier]
      change
        (refinementTargetContextMorphism
          (f := g.comp (refinementBaseHom G r condition rfl)) w).supportMap
            (H.supportComp W support) =
          H.supportComp V
            ((refinementSourceContextMorphism w).supportMap support)
      exact H.support_naturality w support
    axis_naturality := by
      intro W V w axis
      apply generatedRefinementAxisComp_injective G r condition rfl
        (refinementGeometryContextForward g V)
      rw [← generatedRefinementAxisComp_naturality G r condition rfl
        ((refinementGeometryContextFunctor g).map w)
        (cast (SelectedRefinementTransport.inverseCorePackageForwardUpper_contextFunctor_obj_axis_type
            G.core data (refinementGeometryContextForward g W))
          (H.axisComp W axis))]
      rw [generatedRefinementAxisComp_inverse]
      have hcarrier :
          generatedRefinementAxisComp G r condition rfl
              (refinementGeometryContextForward g V)
              (cast
                (SelectedRefinementTransport.inverseCorePackageForwardUpper_contextFunctor_obj_axis_type
                  G.core data (refinementGeometryContextForward g V))
                (H.axisComp V
                  ((refinementSourceContextMorphism w).axisMap axis))) =
            H.axisComp V ((refinementSourceContextMorphism w).axisMap axis) := by
        apply eq_of_heq
        exact (generatedRefinementAxisComp_heq G r condition rfl
          (refinementGeometryContextForward g V) _).trans (cast_heq _ _)
      rw [hcarrier]
      change
        (refinementTargetContextMorphism
          (f := g.comp (refinementBaseHom G r condition rfl)) w).axisMap
            (H.axisComp W axis) =
          H.axisComp V ((refinementSourceContextMorphism w).axisMap axis)
      exact H.axis_naturality w axis
    observable_naturality := by
      intro W V w observable
      apply generatedRefinementObservableComp_injective G r condition rfl
        (refinementGeometryContextForward g W)
      rw [← generatedRefinementObservableComp_naturality G r condition rfl
        ((refinementGeometryContextFunctor g).map w)
        (cast (SelectedRefinementTransport.inverseCorePackageForwardUpper_contextFunctor_obj_observable_type
            G.core data (refinementGeometryContextForward g V))
          (H.observableComp V observable))]
      rw [generatedRefinementObservableComp_inverse]
      have hcarrier :
          generatedRefinementObservableComp G r condition rfl
              (refinementGeometryContextForward g W)
              (cast
                (SelectedRefinementTransport.inverseCorePackageForwardUpper_contextFunctor_obj_observable_type
                  G.core data (refinementGeometryContextForward g W))
                (H.observableComp W
                  ((refinementSourceContextMorphism w).observableRestrict observable))) =
            H.observableComp W
              ((refinementSourceContextMorphism w).observableRestrict observable) := by
        apply eq_of_heq
        exact (generatedRefinementObservableComp_heq G r condition rfl
          (refinementGeometryContextForward g W) _).trans (cast_heq _ _)
      rw [hcarrier]
      change
        (refinementTargetContextMorphism
          (f := g.comp (refinementBaseHom G r condition rfl)) w).observableRestrict
            (H.observableComp V observable) =
          H.observableComp W
            ((refinementSourceContextMorphism w).observableRestrict observable)
      exact H.observable_naturality w observable
  }

/-- Realized-refinement Cartesian factor for a total compatible geometry hom. -/
noncomputable def generatedRefinementCartesianFactor
    {U : AtomCarrier.{u}} {X Y : ExtractionInstance U}
    (G : GeometryPackage.{u, v} U) (r : PointedRefinementHom X Y)
    (condition : RealizedLocusExtractionReflecting r)
    (hG : packagePoint G.core = Y)
    {K : GeometryPackage.{u, v} U}
    (g : RefinementPackageHom ⟨K.core⟩
      ⟨(refinementSourceGeometry G r condition hG).core⟩)
    (h : RefinementGeometryHom K G)
    (hbase : h.base = g.comp (refinementBaseHom G r condition hG)) :
    RefinementGeometryHom K (refinementSourceGeometry G r condition hG) where
  base := g
  geometry := generatedRefinementCartesianFactorGeomCore G r condition hG g
    (hbase ▸ h.geometry)

/-- The realized-refinement Cartesian factor composes to the supplied total
geometry hom. -/
theorem generatedRefinementCartesianFactor_fac
    {U : AtomCarrier.{u}} {X Y : ExtractionInstance U}
    (G : GeometryPackage.{u, v} U) (r : PointedRefinementHom X Y)
    (condition : RealizedLocusExtractionReflecting r)
    (hG : packagePoint G.core = Y)
    {K : GeometryPackage.{u, v} U}
    (g : RefinementPackageHom ⟨K.core⟩
      ⟨(refinementSourceGeometry G r condition hG).core⟩)
    (h : RefinementGeometryHom K G)
    (hbase : h.base = g.comp (refinementBaseHom G r condition hG)) :
    RefinementGeometryHom.comp
        (generatedRefinementCartesianFactor G r condition hG g h hbase)
        (generatedRefinementGeometryHom G r condition hG) = h := by
  cases hG
  apply RefinementGeometryHom.ext
  · exact hbase.symm
  · let H : RefinementGeomReadHom K G
        (g.comp (refinementBaseHom G r condition rfl)) := hbase ▸ h.geometry
    have hgeom :
        (RefinementGeometryHom.comp
          (generatedRefinementCartesianFactor G r condition rfl g h hbase)
          (generatedRefinementGeometryHom G r condition rfl)).geometry = H := by
      apply RefinementGeomReadHom.ext
      · rfl
      · apply heq_of_eq
        funext W support
        exact generatedRefinementSupportComp_inverse G r condition rfl
          (refinementGeometryContextForward g W) _
      · apply heq_of_eq
        funext W axis
        exact generatedRefinementAxisComp_inverse G r condition rfl
          (refinementGeometryContextForward g W) _
      · apply heq_of_eq
        funext W observable
        exact generatedRefinementObservableComp_inverse G r condition rfl
          (refinementGeometryContextForward g W) _
    exact (heq_of_eq hgeom).trans (by
      dsimp [H]
      exact eqRec_heq hbase h.geometry)

/-- Factoring a composite through the realized-refinement generated leg
recovers its first geometry contract. -/
theorem generatedRefinementCartesianFactorGeomCore_of_composite
    {U : AtomCarrier.{u}} {X Y : ExtractionInstance U}
    (G : GeometryPackage.{u, v} U) (r : PointedRefinementHom X Y)
    (condition : RealizedLocusExtractionReflecting r)
    (hG : packagePoint G.core = Y)
    {K : GeometryPackage.{u, v} U}
    (g : RefinementPackageHom ⟨K.core⟩
      ⟨(refinementSourceGeometry G r condition hG).core⟩)
    (T : RefinementGeomReadHom K
      (refinementSourceGeometry G r condition hG) g) :
    generatedRefinementCartesianFactorGeomCore G r condition hG g
        (RefinementGeomReadHom.comp T
          (generatedRefinementGeometryHom G r condition hG).geometry) = T := by
  cases hG
  apply RefinementGeomReadHom.ext
  · rfl
  · apply heq_of_eq
    funext W support
    apply eq_of_heq
    exact (cast_heq _ _).trans
      (generatedRefinementSupportComp_heq G r condition rfl
        (refinementGeometryContextForward g W) (T.supportComp W support))
  · apply heq_of_eq
    funext W axis
    apply eq_of_heq
    exact (cast_heq _ _).trans
      (generatedRefinementAxisComp_heq G r condition rfl
        (refinementGeometryContextForward g W) (T.axisComp W axis))
  · apply heq_of_eq
    funext W observable
    apply eq_of_heq
    exact (cast_heq _ _).trans
      (generatedRefinementObservableComp_heq G r condition rfl
        (refinementGeometryContextForward g W) (T.observableComp W observable))

/-- The realized-refinement generated factor is the unique total factor with
the specified lower package map. -/
theorem generatedRefinementCartesianFactor_unique
    {U : AtomCarrier.{u}} {X Y : ExtractionInstance U}
    (G : GeometryPackage.{u, v} U) (r : PointedRefinementHom X Y)
    (condition : RealizedLocusExtractionReflecting r)
    (hG : packagePoint G.core = Y)
    {K : GeometryPackage.{u, v} U}
    (g : RefinementPackageHom ⟨K.core⟩
      ⟨(refinementSourceGeometry G r condition hG).core⟩)
    (h : RefinementGeometryHom K G)
    (hbase : h.base = g.comp (refinementBaseHom G r condition hG))
    (k : RefinementGeometryHom K
      (refinementSourceGeometry G r condition hG))
    (hkbase : k.base = g)
    (hkfac : RefinementGeometryHom.comp k
      (generatedRefinementGeometryHom G r condition hG) = h) :
    k = generatedRefinementCartesianFactor G r condition hG g h hbase := by
  let kGeometry := refinementGeomReadHomCastBase hkbase k.geometry
  let H : RefinementGeomReadHom K G
      (g.comp (refinementBaseHom G r condition hG)) := hbase ▸ h.geometry
  have hnormalized : RefinementGeomReadHom.comp kGeometry
      (generatedRefinementGeometryHom G r condition hG).geometry = H := by
    apply eq_of_heq
    have hH : HEq h.geometry H := by
      dsimp [H]
      exact (eqRec_heq hbase h.geometry).symm
    exact ((refinementGeomReadHomComp_castBase_heq hkbase k.geometry
      (generatedRefinementGeometryHom G r condition hG).geometry).trans
      (RefinementGeometryHom.geometry_heq hkfac)).trans hH
  have hkGeometry : kGeometry =
      generatedRefinementCartesianFactorGeomCore G r condition hG g H := by
    calc
      kGeometry = generatedRefinementCartesianFactorGeomCore G r condition hG g
          (RefinementGeomReadHom.comp kGeometry
            (generatedRefinementGeometryHom G r condition hG).geometry) :=
        (generatedRefinementCartesianFactorGeomCore_of_composite
          G r condition hG g kGeometry).symm
      _ = generatedRefinementCartesianFactorGeomCore G r condition hG g H :=
        congrArg (generatedRefinementCartesianFactorGeomCore
          G r condition hG g) hnormalized
  apply RefinementGeometryHom.ext
  · exact hkbase
  · exact (refinementGeomReadHomCastBase_heq hkbase k.geometry).symm.trans
      (heq_of_eq hkGeometry)

/-- The explicit realized-refinement G-115 geometry lift is strongly Cartesian
over the refinement-geometry projection. -/
theorem generatedRefinementGeometryHom_isStronglyCartesian
    {U : AtomCarrier.{u}} {X Y : ExtractionInstance U}
    (G : GeometryPackage.{u, v} U) (r : PointedRefinementHom X Y)
    (condition : RealizedLocusExtractionReflecting r)
    (hG : packagePoint G.core = Y) :
    (refinementGeometryProjection U).IsStronglyCartesian
      (refinementBaseHom G r condition hG)
      (generatedRefinementGeometryHom G r condition hG) := by
  let refinementLift := generatedRefinementGeometryHom G r condition hG
  letI : (refinementGeometryProjection U).IsHomLift
      (refinementBaseHom G r condition hG) refinementLift := by
    apply CategoryTheory.IsHomLift.of_fac'
      (refinementGeometryProjection U) _ refinementLift rfl rfl
    rfl
  apply CategoryTheory.Functor.IsStronglyCartesian.mk
  intro K g h hLift
  have hbase : h.base = g.comp (refinementBaseHom G r condition hG) := by
    exact (CategoryTheory.IsHomLift.eq_of_isHomLift
      (refinementGeometryProjection U)
      (g.comp (refinementBaseHom G r condition hG)) h).symm
  let factor := generatedRefinementCartesianFactor G r condition hG g h hbase
  refine ⟨factor, ?_, ?_⟩
  · constructor
    · rw [← show factor.base = g from rfl]
      change (refinementGeometryProjection U).IsHomLift
        ((refinementGeometryProjection U).map factor) factor
      infer_instance
    · exact generatedRefinementCartesianFactor_fac
        G r condition hG g h hbase
  · intro factor' hfactor'
    apply generatedRefinementCartesianFactor_unique
      G r condition hG g h hbase factor'
    · letI : (refinementGeometryProjection U).IsHomLift g factor' :=
        hfactor'.1
      exact (CategoryTheory.IsHomLift.eq_of_isHomLift
        (p := refinementGeometryProjection U) g factor').symm
    · exact hfactor'.2

