import ResearchLean.AG.DoctrineFiberProduct.SemanticCoreBeckChevalleyMate

/-! Cartesian choice comparison for the semantic-global core mate. -/

namespace AAT.AG.DoctrineFiberProduct

universe u

open CategoryTheory
open AtomFoundation CrossStageCoherence

set_option maxHeartbeats 3000000

/-- The adjunction for any cartesian cleavage over a semantic exact arrow. -/
noncomputable def semanticCoreCleavageAdjunction
    {U : AtomCarrier.{u}} (input : CartSemanticInput U)
    (cleavage : CoreFiberCartesianCleavage input) :
    coreFiberTransportFunctor input.hom ⊣ cleavage.reindexFunctor :=
  (semanticCoreTransportReindexAdjunction input).ofNatIsoRight
    (CoreFiberCartesianCleavage.comparison
      (exact_bottom_semantic_global_cartesian_cleavage input.hom)
      cleavage)

theorem semanticCoreCleavageAdjunction_conjugate_id
    {U : AtomCarrier.{u}} (input : CartSemanticInput U)
    (cleavage : CoreFiberCartesianCleavage input) :
    conjugateEquiv
        (semanticCoreTransportReindexAdjunction input)
        (semanticCoreCleavageAdjunction input cleavage)
        (𝟙 (coreFiberTransportFunctor input.hom)) =
      (CoreFiberCartesianCleavage.comparison
        (exact_bottom_semantic_global_cartesian_cleavage input.hom)
        cleavage).hom := by
  apply NatTrans.ext
  funext targetPackage
  simp [semanticCoreCleavageAdjunction, conjugateEquiv,
    Adjunction.ofNatIsoRight, mateEquiv_apply]
  have hnat := (CoreFiberCartesianCleavage.comparison
    (exact_bottom_semantic_global_cartesian_cleavage input.hom)
    cleavage).hom.naturality
      ((semanticCoreTransportReindexAdjunction input).counit.app targetPackage)
  dsimp only [Functor.comp_obj] at hnat
  rw [← hnat]
  rw [Adjunction.homEquiv_unit]
  simp
  rw [← hnat]
  rw [← Category.assoc,
    show (exact_bottom_semantic_global_cartesian_cleavage input.hom).reindexFunctor.map
        ((semanticCoreTransportReindexAdjunction input).counit.app targetPackage) =
      (exact_bottom_semantic_global_reindex_functor input.hom).map
        ((semanticCoreTransportReindexAdjunction input).counit.app targetPackage) from rfl,
    (semanticCoreTransportReindexAdjunction input).right_triangle_components,
    Category.id_comp]
  rfl

/-- The mate generated by arbitrary cartesian choices on the two backward legs. -/
noncomputable def semanticCoreBeckChevalleyCleavageMate
    {U : AtomCarrier.{u}} (square : ExtInstSquare U)
    (leftCleavage : CoreFiberCartesianCleavage
      ⟨square.northwest, square.southwest, square.left⟩)
    (rightCleavage : CoreFiberCartesianCleavage
      ⟨square.northeast, square.southeast, square.right⟩) :
    leftCleavage.reindexFunctor ⋙ coreFiberTransportFunctor square.top ⟶
      coreFiberTransportFunctor square.bottom ⋙
        rightCleavage.reindexFunctor :=
  (mateEquiv
    (semanticCoreCleavageAdjunction
      ⟨square.northwest, square.southwest, square.left⟩ leftCleavage)
    (semanticCoreCleavageAdjunction
      ⟨square.northeast, square.southeast, square.right⟩ rightCleavage)
    (semanticCoreTransportSquareIso square).hom).natTrans

/-- Changing the cartesian lifts on both backward legs preserves the mate
after the unique lift comparisons are inserted. -/
theorem semanticCoreBeckChevalleyCleavageMate_comparison
    {U : AtomCarrier.{u}} (square : ExtInstSquare U)
    (leftCleavage : CoreFiberCartesianCleavage
      ⟨square.northwest, square.southwest, square.left⟩)
    (rightCleavage : CoreFiberCartesianCleavage
      ⟨square.northeast, square.southeast, square.right⟩) :
    Functor.whiskerRight
        (CoreFiberCartesianCleavage.comparison
          (exact_bottom_semantic_global_cartesian_cleavage square.left)
          leftCleavage).hom
        (coreFiberTransportFunctor square.top) ≫
      semanticCoreBeckChevalleyCleavageMate square leftCleavage rightCleavage =
    semanticCoreBeckChevalleyMate square ≫
      Functor.whiskerLeft (coreFiberTransportFunctor square.bottom)
        (CoreFiberCartesianCleavage.comparison
          (exact_bottom_semantic_global_cartesian_cleavage square.right)
          rightCleavage).hom := by
  let leftSelected := semanticCoreTransportReindexAdjunction
    (⟨square.northwest, square.southwest, square.left⟩ : CartSemanticInput U)
  let leftOther := semanticCoreCleavageAdjunction
    (⟨square.northwest, square.southwest, square.left⟩ : CartSemanticInput U)
    leftCleavage
  let rightSelected := semanticCoreTransportReindexAdjunction
    (⟨square.northeast, square.southeast, square.right⟩ : CartSemanticInput U)
  let rightOther := semanticCoreCleavageAdjunction
    (⟨square.northeast, square.southeast, square.right⟩ : CartSemanticInput U)
    rightCleavage
  let alpha := (semanticCoreTransportSquareIso square).hom
  have rightChange := mateEquiv_conjugateEquiv_vcomp
    leftSelected rightSelected rightOther alpha
      (𝟙 (coreFiberTransportFunctor square.right))
  have leftChange := conjugateEquiv_mateEquiv_vcomp
    leftSelected leftOther rightOther
      (𝟙 (coreFiberTransportFunctor square.left)) alpha
  simp only [TwoSquare.whiskerRight, TwoSquare.whiskerLeft,
    Functor.whiskerLeft_id', Functor.whiskerRight_id',
    Category.id_comp, Category.comp_id] at rightChange leftChange
  rw [semanticCoreCleavageAdjunction_conjugate_id] at rightChange leftChange
  exact leftChange.symm.trans rightChange

end AAT.AG.DoctrineFiberProduct

#assert_standard_axioms_only AAT.AG.DoctrineFiberProduct
