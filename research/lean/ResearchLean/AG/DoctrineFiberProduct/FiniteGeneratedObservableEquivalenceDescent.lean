import ResearchLean.AG.DoctrineFiberProduct.FiniteGeneratedReflectedContextEquivalence

/-!
# Generated equation-observable equivalence descent

This module reflects the observable-ring equivalence carried by the actual
normalized high prefix factor.  The observable here is the coefficient ring
of an `ArchitecturalEquationSystem`, not the `Observable` carrier of an
`ArchitectureContext`.

Each generated low observable ring is lifted canonically from `Int` to
`ULift Int`.  The reflected equivalence is obtained by conjugating the actual
high `equationTransport.observableEquiv` with those canonical lifts and with
the context-endpoint equality generated by the reflected forward object.
No ring equivalence, context equality, or low transport is caller supplied.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open CategoryTheory
open AtomFoundation

/-! ## The proof-used observable-conjugation primitive -/

/--
Conjugate an actual observable-ring equivalence through generated source and
target image equivalences.  The actual reflected producer below uses this
transparent primitive directly; callers do not supply any of its three legs.
-/
def generatedEquationObservableRingEquivConjugation
    {L₀ H₀ H₁ L₁ : Type*}
    [CommRing L₀] [CommRing H₀] [CommRing H₁] [CommRing L₁]
    (sourceImage : L₀ ≃+* H₀)
    (actual : H₀ ≃+* H₁)
    (targetImage : L₁ ≃+* H₁) : L₀ ≃+* L₁ :=
  sourceImage.trans (actual.trans targetImage.symm)

/--
For fixed generated images, observable conjugation is injective in the actual
middle ring equivalence.
-/
theorem generatedEquationObservableRingEquivConjugation_actual_injective
    {L₀ H₀ H₁ L₁ : Type*}
    [CommRing L₀] [CommRing H₀] [CommRing H₁] [CommRing L₁]
    (sourceImage : L₀ ≃+* H₀)
    (targetImage : L₁ ≃+* H₁) :
    Function.Injective (fun actual : H₀ ≃+* H₁ =>
      generatedEquationObservableRingEquivConjugation
        sourceImage actual targetImage) := by
  intro first second equality
  apply RingEquiv.ext
  intro value
  have pointEquality := congrArg
    (fun output : L₀ ≃+* L₁ =>
      targetImage (output (sourceImage.symm value))) equality
  simpa [generatedEquationObservableRingEquivConjugation] using pointEquality

/-! ## Canonical generated-domain observable lift -/

/--
The selected finite-model equation-observable ring is canonically equivalent
to its lifted counterpart, independently of the two context indices.
-/
def finiteModelTargetEquationObservableEquiv
    (W : Site.ContextCategoryObject
      FiniteModel.corePackage.algebra.contextPreorder)
    (V : Site.ContextCategoryObject
      finiteModelLiftCorePackage.{u}.algebra.contextPreorder) :
    FiniteModel.corePackage.algebra.equationSystem.Observable W ≃+*
      finiteModelLiftCorePackage.{u}.algebra.equationSystem.Observable V := by
  change Int ≃+* ULift.{u} Int
  exact ULift.ringEquiv.symm

/-- The selected target observable equivalence sends every value by `ULift.up`. -/
@[simp]
theorem finiteModelTargetEquationObservableEquiv_apply
    (W : Site.ContextCategoryObject
      FiniteModel.corePackage.algebra.contextPreorder)
    (V : Site.ContextCategoryObject
      finiteModelLiftCorePackage.{u}.algebra.contextPreorder)
    (value : FiniteModel.corePackage.algebra.equationSystem.Observable W) :
    finiteModelTargetEquationObservableEquiv.{u} W V value = ULift.up value :=
  rfl

/--
The canonical generated-domain observable equivalence is obtained by mapping
to the selected low target, applying the finite-model `ULift` equivalence, and
mapping back through the inverse selected high target equivalence.
-/
noncomputable def finiteGeneratedEquationObservableEquiv
    (input : FiniteGeneratedLiftInput)
    (W : Site.ContextCategoryObject
      input.lowGeneratedLift.domain.algebra.contextPreorder) :
    input.lowGeneratedLift.domain.algebra.equationSystem.Observable W ≃+*
      input.highGeneratedLift.domain.algebra.equationSystem.Observable
        ((finiteGeneratedContextImageFunctor.{u} input).obj W) :=
  (inverseCorePackageForwardUpper FiniteModel.corePackage input.hom).equationTransport.observableEquiv W |>.trans
    ((finiteModelTargetEquationObservableEquiv.{u}
      ((inverseCorePackageForwardUpper FiniteModel.corePackage input.hom).equationTransport.contextForward W)
      (input.highPackageHomFromLowData.upper.equationTransport.contextForward
        ((finiteGeneratedContextImageFunctor.{u} input).obj W))).trans
      (input.highPackageHomFromLowData.upper.equationTransport.observableEquiv
        ((finiteGeneratedContextImageFunctor.{u} input).obj W)).symm)

/-- The named inverse of the canonical generated equation-observable lift. -/
noncomputable def finiteGeneratedEquationObservableInverseEquiv
    (input : FiniteGeneratedLiftInput)
    (W : Site.ContextCategoryObject
      input.lowGeneratedLift.domain.algebra.contextPreorder) :
    input.highGeneratedLift.domain.algebra.equationSystem.Observable
        ((finiteGeneratedContextImageFunctor.{u} input).obj W) ≃+*
      input.lowGeneratedLift.domain.algebra.equationSystem.Observable W :=
  (finiteGeneratedEquationObservableEquiv.{u} input W).symm

/--
The high target image of the generated forward map is the lifted low target
image for every observable value.
-/
theorem finiteGeneratedEquationObservableEquiv_forward_image
    (input : FiniteGeneratedLiftInput)
    (W : Site.ContextCategoryObject
      input.lowGeneratedLift.domain.algebra.contextPreorder)
    (value : input.lowGeneratedLift.domain.algebra.equationSystem.Observable W) :
    input.highPackageHomFromLowData.upper.equationTransport.observableEquiv
        ((finiteGeneratedContextImageFunctor.{u} input).obj W)
        (finiteGeneratedEquationObservableEquiv.{u} input W value) =
      finiteModelTargetEquationObservableEquiv.{u}
        ((inverseCorePackageForwardUpper FiniteModel.corePackage input.hom).equationTransport.contextForward W)
        (input.highPackageHomFromLowData.upper.equationTransport.contextForward
          ((finiteGeneratedContextImageFunctor.{u} input).obj W))
        ((inverseCorePackageForwardUpper FiniteModel.corePackage input.hom).equationTransport.observableEquiv W value) := by
  let high := input.highPackageHomFromLowData.upper.equationTransport.observableEquiv
    ((finiteGeneratedContextImageFunctor.{u} input).obj W)
  change high (high.symm _) = _
  exact high.apply_symm_apply _

/--
The low target image of the generated inverse map is the reflected high target
image for every observable value.
-/
theorem finiteGeneratedEquationObservableEquiv_inverse_image
    (input : FiniteGeneratedLiftInput)
    (W : Site.ContextCategoryObject
      input.lowGeneratedLift.domain.algebra.contextPreorder)
    (value : input.highGeneratedLift.domain.algebra.equationSystem.Observable
      ((finiteGeneratedContextImageFunctor.{u} input).obj W)) :
    (inverseCorePackageForwardUpper FiniteModel.corePackage input.hom).equationTransport.observableEquiv W
        ((finiteGeneratedEquationObservableEquiv.{u} input W).symm value) =
      (finiteModelTargetEquationObservableEquiv.{u}
        ((inverseCorePackageForwardUpper FiniteModel.corePackage input.hom).equationTransport.contextForward W)
        (input.highPackageHomFromLowData.upper.equationTransport.contextForward
          ((finiteGeneratedContextImageFunctor.{u} input).obj W))).symm
        (input.highPackageHomFromLowData.upper.equationTransport.observableEquiv
          ((finiteGeneratedContextImageFunctor.{u} input).obj W) value) := by
  let low := (inverseCorePackageForwardUpper FiniteModel.corePackage
    input.hom).equationTransport.observableEquiv W
  let target := finiteModelTargetEquationObservableEquiv.{u}
    ((inverseCorePackageForwardUpper FiniteModel.corePackage
      input.hom).equationTransport.contextForward W)
    (input.highPackageHomFromLowData.upper.equationTransport.contextForward
      ((finiteGeneratedContextImageFunctor.{u} input).obj W))
  let high := input.highPackageHomFromLowData.upper.equationTransport.observableEquiv
    ((finiteGeneratedContextImageFunctor.{u} input).obj W)
  change low (low.symm (target.symm (high value))) = target.symm (high value)
  exact low.apply_symm_apply _

/-- Lifting and then lowering any generated low observable recovers it exactly. -/
@[simp]
theorem finiteGeneratedEquationObservableEquiv_symm_apply_apply
    (input : FiniteGeneratedLiftInput)
    (W : Site.ContextCategoryObject
      input.lowGeneratedLift.domain.algebra.contextPreorder)
    (value : input.lowGeneratedLift.domain.algebra.equationSystem.Observable W) :
    (finiteGeneratedEquationObservableEquiv.{u} input W).symm
        (finiteGeneratedEquationObservableEquiv.{u} input W value) = value :=
  (finiteGeneratedEquationObservableEquiv.{u} input W).symm_apply_apply value

/-- Lowering and then lifting any generated high observable recovers it exactly. -/
@[simp]
theorem finiteGeneratedEquationObservableEquiv_apply_symm_apply
    (input : FiniteGeneratedLiftInput)
    (W : Site.ContextCategoryObject
      input.lowGeneratedLift.domain.algebra.contextPreorder)
    (value : input.highGeneratedLift.domain.algebra.equationSystem.Observable
      ((finiteGeneratedContextImageFunctor.{u} input).obj W)) :
    finiteGeneratedEquationObservableEquiv.{u} input W
        ((finiteGeneratedEquationObservableEquiv.{u} input W).symm value) = value :=
  (finiteGeneratedEquationObservableEquiv.{u} input W).apply_symm_apply value

/-! ## Actual high observable projection and endpoint alignment -/

/--
The observable-ring equivalence projected transparently from the actual
normalized high factor.  This is the high transport field itself, without
replacement by the named canonical factor or by a known low transport.
-/
noncomputable def finiteGeneratedActualHighEquationObservableEquiv
    (input : FiniteGeneratedLiftInput)
    (lift : StrongCartesianLift
      (FiniteGeneratedLiftInput.highInput.{u} input)
      (FiniteGeneratedLiftInput.highTarget.{u} input))
    {package : AATCorePackage FiniteModel.carrier}
    (base : packagePoint package ⟶ input.source)
    (W : Site.ContextCategoryObject
      ((finiteGeneratedOuterInput input base).highGeneratedLift.domain.algebra.contextPreorder)) :
    (finiteGeneratedOuterInput input base).highGeneratedLift.domain.algebra.equationSystem.Observable W ≃+*
      input.highGeneratedLift.domain.algebra.equationSystem.Observable
        ((finiteGeneratedActualHighContextEquivalence input lift base).functor.obj W) :=
  (finiteGeneratedNormalizedHighFactor input lift base).upper.equationTransport.observableEquiv W

/--
Cast the actual high observable target to the canonical generated image of the
reflected forward object.  The cast direction is actual-to-canonical because
the Cycle 20 landing theorem states canonical-image equals actual-image.
-/
noncomputable def finiteGeneratedReflectedEquationObservableTargetCast
    (input : FiniteGeneratedLiftInput)
    (lift : StrongCartesianLift
      (FiniteGeneratedLiftInput.highInput.{u} input)
      (FiniteGeneratedLiftInput.highTarget.{u} input))
    {package : AATCorePackage FiniteModel.carrier}
    (base : packagePoint package ⟶ input.source)
    (W : Site.ContextCategoryObject
      ((finiteGeneratedOuterInput input base).lowGeneratedLift.domain.algebra.contextPreorder)) :
    input.highGeneratedLift.domain.algebra.equationSystem.Observable
        ((finiteGeneratedActualHighContextEquivalence input lift base).functor.obj
          ((finiteGeneratedContextImageFunctor.{u}
            (finiteGeneratedOuterInput input base)).obj W)) ≃+*
      input.highGeneratedLift.domain.algebra.equationSystem.Observable
        ((finiteGeneratedContextImageFunctor.{u} input).obj
          (finiteGeneratedReflectedForwardObject input lift base W)) :=
  RingEquiv.cast
    (R := fun X : Site.ContextCategoryObject
      (input.highGeneratedLift.domain.algebra.contextPreorder) =>
        input.highGeneratedLift.domain.algebra.equationSystem.Observable X)
    (finiteGeneratedReflectedForwardObject_image_eq input lift base W).symm

/-! ## Reflected low observable equivalence -/

/--
Reflect the actual normalized high observable equivalence to the generated low
domains.  The construction is the canonical source lift, the actual high
projection, the generated context cast, and the inverse canonical target lift.
-/
noncomputable def finiteGeneratedReflectedEquationObservableEquiv
    (input : FiniteGeneratedLiftInput)
    (lift : StrongCartesianLift
      (FiniteGeneratedLiftInput.highInput.{u} input)
      (FiniteGeneratedLiftInput.highTarget.{u} input))
    {package : AATCorePackage FiniteModel.carrier}
    (base : packagePoint package ⟶ input.source)
    (W : Site.ContextCategoryObject
      ((finiteGeneratedOuterInput input base).lowGeneratedLift.domain.algebra.contextPreorder)) :
    (finiteGeneratedOuterInput input base).lowGeneratedLift.domain.algebra.equationSystem.Observable W ≃+*
      input.lowGeneratedLift.domain.algebra.equationSystem.Observable
        (finiteGeneratedReflectedForwardObject input lift base W) :=
  generatedEquationObservableRingEquivConjugation
    (finiteGeneratedEquationObservableEquiv.{u}
      (finiteGeneratedOuterInput input base) W)
    (finiteGeneratedActualHighEquationObservableEquiv input lift base
      ((finiteGeneratedContextImageFunctor.{u}
        (finiteGeneratedOuterInput input base)).obj W))
    ((finiteGeneratedEquationObservableEquiv.{u} input
      (finiteGeneratedReflectedForwardObject input lift base W)).trans
      (finiteGeneratedReflectedEquationObservableTargetCast input lift base W).symm)

/--
The high image of every reflected forward observable is the actual normalized
high observable image, aligned only by the generated target-context cast.
-/
theorem finiteGeneratedReflectedEquationObservableEquiv_apply_high_image
    (input : FiniteGeneratedLiftInput)
    (lift : StrongCartesianLift
      (FiniteGeneratedLiftInput.highInput.{u} input)
      (FiniteGeneratedLiftInput.highTarget.{u} input))
    {package : AATCorePackage FiniteModel.carrier}
    (base : packagePoint package ⟶ input.source)
    (W : Site.ContextCategoryObject
      ((finiteGeneratedOuterInput input base).lowGeneratedLift.domain.algebra.contextPreorder))
    (value : (finiteGeneratedOuterInput input base).lowGeneratedLift.domain.algebra.equationSystem.Observable W) :
    finiteGeneratedEquationObservableEquiv.{u} input
        (finiteGeneratedReflectedForwardObject input lift base W)
        (finiteGeneratedReflectedEquationObservableEquiv input lift base W value) =
      finiteGeneratedReflectedEquationObservableTargetCast input lift base W
        (finiteGeneratedActualHighEquationObservableEquiv input lift base
          ((finiteGeneratedContextImageFunctor.{u}
            (finiteGeneratedOuterInput input base)).obj W)
          (finiteGeneratedEquationObservableEquiv.{u}
            (finiteGeneratedOuterInput input base) W value)) := by
  let sourceLift := finiteGeneratedEquationObservableEquiv.{u}
    (finiteGeneratedOuterInput input base) W
  let actual := finiteGeneratedActualHighEquationObservableEquiv input lift base
    ((finiteGeneratedContextImageFunctor.{u}
      (finiteGeneratedOuterInput input base)).obj W)
  let targetCast := finiteGeneratedReflectedEquationObservableTargetCast
    input lift base W
  let targetLift := finiteGeneratedEquationObservableEquiv.{u} input
    (finiteGeneratedReflectedForwardObject input lift base W)
  change targetLift (targetLift.symm (targetCast (actual (sourceLift value)))) =
    targetCast (actual (sourceLift value))
  exact targetLift.apply_symm_apply _

/--
The high image of every reflected inverse observable is obtained by undoing
the generated context cast and then applying the inverse actual high
observable equivalence.
-/
theorem finiteGeneratedReflectedEquationObservableEquiv_symm_apply_high_image
    (input : FiniteGeneratedLiftInput)
    (lift : StrongCartesianLift
      (FiniteGeneratedLiftInput.highInput.{u} input)
      (FiniteGeneratedLiftInput.highTarget.{u} input))
    {package : AATCorePackage FiniteModel.carrier}
    (base : packagePoint package ⟶ input.source)
    (W : Site.ContextCategoryObject
      ((finiteGeneratedOuterInput input base).lowGeneratedLift.domain.algebra.contextPreorder))
    (value : input.lowGeneratedLift.domain.algebra.equationSystem.Observable
      (finiteGeneratedReflectedForwardObject input lift base W)) :
    finiteGeneratedEquationObservableEquiv.{u}
        (finiteGeneratedOuterInput input base) W
        ((finiteGeneratedReflectedEquationObservableEquiv input lift base W).symm value) =
      (finiteGeneratedActualHighEquationObservableEquiv input lift base
        ((finiteGeneratedContextImageFunctor.{u}
          (finiteGeneratedOuterInput input base)).obj W)).symm
        ((finiteGeneratedReflectedEquationObservableTargetCast input lift base W).symm
          (finiteGeneratedEquationObservableEquiv.{u} input
            (finiteGeneratedReflectedForwardObject input lift base W) value)) := by
  let sourceLift := finiteGeneratedEquationObservableEquiv.{u}
    (finiteGeneratedOuterInput input base) W
  change sourceLift (sourceLift.symm _) = _
  exact sourceLift.apply_symm_apply _

end AAT.AG.DoctrineFiberProduct

#assert_standard_axioms_only AAT.AG.DoctrineFiberProduct
