import ResearchLean.AG.DoctrineFiberProduct.CartesianRegimeReindexingCleavageCoherence
import ResearchLean.AG.DoctrineFiberProduct.CartesianRegimeReindexingCoherenceWitnesses

/-!
# Finite witnesses for cartesian-cleavage independence

Two genuinely different lift families are compared over the typed support
identity.  The first uses the literal identity lift everywhere.  The second
uses a visible nonidentity four-axis automorphism at one named target and the
literal lift elsewhere.  The canonical comparison component is therefore
nonidentity, while its triangle, naturality, refl/cocycle, compositor and
unitor compatibility all remain generated by cartesian uniqueness.

The compositor control also contains the existing noninvertible selective-two
leg.  The selected bridges connect the same fixture directly to Cycle 32.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open CategoryTheory
open AtomFoundation
open CrossStageCoherence

/-- Executable Atom equality for the concrete finite carrier. -/
local instance finiteCartesianCleavageAtomDecidableEq :
    DecidableEq FiniteModel.carrier.Atom := by
  change DecidableEq FiniteModel.FiniteAtom
  infer_instance

/-! ## An actual invertible four-axis vertical map -/

/-- A four-axis permutation on the transported finite core. -/
noncomputable def finiteCleavageAxisPermutationTotal
    (permutation : Equiv.Perm (Fin 4)) :
    PackageTotalHom finiteReindexFourAxisCore finiteReindexFourAxisCore where
  base := ExtInstHom.id (packagePoint finiteReindexFourAxisCore)
  upper :=
    { SignedExactCoreReadingHom.refl finiteReindexFourAxisCore with
      axisMap := permutation
      coordinateEquiv := fun _ => permutation
      axis_selected_iff := fun _ => Iff.rfl
      coordinate_eq := by intro object axis; rfl }
  atomEquiv_eq := rfl

/-- Composition of the concrete total maps follows permutation composition. -/
theorem finiteCleavageAxisPermutationTotal_comp
    (first second : Equiv.Perm (Fin 4)) :
    (finiteCleavageAxisPermutationTotal first).comp
        (finiteCleavageAxisPermutationTotal second) =
      finiteCleavageAxisPermutationTotal (first.trans second) := by
  apply PackageTotalHom.ext
  · apply ExtInstHom.ext
    apply ExactDoctrineHom.ext
    · rfl
    · apply Equiv.ext
      intro atom
      rfl
  · apply SignedExactCoreReadingHom.ext
    · apply Equiv.ext
      intro atom
      rfl
    · rfl
    · rfl
    · rfl
    · rfl
    · rfl
    · rfl

/-- The reflexive permutation is the total identity. -/
theorem finiteCleavageAxisPermutationTotal_refl :
    finiteCleavageAxisPermutationTotal (Equiv.refl (Fin 4)) =
      PackageTotalHom.id finiteReindexFourAxisCore := by
  apply PackageTotalHom.ext
  · apply ExtInstHom.ext
    apply ExactDoctrineHom.ext
    · rfl
    · apply Equiv.ext
      intro atom
      rfl
  · apply SignedExactCoreReadingHom.ext
    · apply Equiv.ext
      intro atom
      rfl
    · rfl
    · rfl
    · rfl
    · rfl
    · rfl
    · rfl

/-- Every four-axis permutation gives an actual total-category automorphism. -/
noncomputable def finiteCleavageAxisPermutationIso
    (permutation : Equiv.Perm (Fin 4)) : Aut finiteReindexFourAxisCore where
  hom := finiteCleavageAxisPermutationTotal permutation
  inv := finiteCleavageAxisPermutationTotal permutation.symm
  hom_inv_id := by
    change (finiteCleavageAxisPermutationTotal permutation).comp
      (finiteCleavageAxisPermutationTotal permutation.symm) =
        PackageTotalHom.id finiteReindexFourAxisCore
    rw [finiteCleavageAxisPermutationTotal_comp]
    rw [show permutation.trans permutation.symm = Equiv.refl (Fin 4) by
      apply Equiv.ext
      intro axis
      exact permutation.symm_apply_apply axis]
    exact finiteCleavageAxisPermutationTotal_refl
  inv_hom_id := by
    change (finiteCleavageAxisPermutationTotal permutation.symm).comp
      (finiteCleavageAxisPermutationTotal permutation) =
        PackageTotalHom.id finiteReindexFourAxisCore
    rw [finiteCleavageAxisPermutationTotal_comp]
    rw [show permutation.symm.trans permutation = Equiv.refl (Fin 4) by
      apply Equiv.ext
      intro axis
      exact permutation.apply_symm_apply axis]
    exact finiteCleavageAxisPermutationTotal_refl

/-- The named four-axis package over the exact typed support endpoint. -/
noncomputable def finiteCleavageFourAxisTarget :
    CoreFiber finitePortfolioSupportInstance.toSemantic :=
  ⟨finiteReindexFourAxisCore, by rfl⟩

/-- The visible swap as a vertical automorphism of the named target. -/
noncomputable def finiteCleavageAxisSwapHom :
    finiteCleavageFourAxisTarget ⟶ finiteCleavageFourAxisTarget := by
  refine ⟨(finiteCleavageAxisPermutationIso finiteReindexAxisSwap).hom, ?_⟩
  change (packageProjection FiniteModel.carrier).IsHomLift
    ((packageProjection FiniteModel.carrier).map
      (finiteCleavageAxisPermutationIso finiteReindexAxisSwap).hom)
    (finiteCleavageAxisPermutationIso finiteReindexAxisSwap).hom
  infer_instance

/-- The typed target swap is genuinely nonidentity. -/
theorem finiteCleavageAxisSwapHom_ne_id :
    finiteCleavageAxisSwapHom ≠ 𝟙 finiteCleavageFourAxisTarget := by
  intro equality
  have haxis := congrArg
    (fun hom : finiteCleavageFourAxisTarget ⟶ finiteCleavageFourAxisTarget =>
      hom.1.upper.axisMap finiteReindexAxisZero) equality
  have hswap : finiteReindexAxisOne = finiteReindexAxisZero := by
    change finiteReindexAxisSwap (0 : Fin 4) = (0 : Fin 4) at haxis
    simpa only [finiteReindexAxisSwapHom_axis_zero] using haxis
  exact finiteReindexAxisZero_ne_one hswap.symm

/-! ## Literal and twisted identity cleavages -/

/-- The actual swap lift over the typed identity arrow. -/
noncomputable def finiteCleavageAxisSwapCartesianLift :
    StrongCartesianLift
      (typedCartSemanticInput
        (idTypedPresentation finitePortfolioSupportInstance))
      finiteCleavageFourAxisTarget where
  domain := finiteReindexFourAxisCore
  hom := (finiteCleavageAxisPermutationIso finiteReindexAxisSwap).hom
  isStronglyCartesian := by
    letI : IsIso
        (finiteCleavageAxisPermutationIso finiteReindexAxisSwap).hom :=
      (finiteCleavageAxisPermutationIso finiteReindexAxisSwap).isIso_hom
    letI : (packageProjection FiniteModel.carrier).IsHomLift
        (𝟙 finitePortfolioSupportInstance.toSemantic)
        (finiteCleavageAxisPermutationIso finiteReindexAxisSwap).hom := by
      change (packageProjection FiniteModel.carrier).IsHomLift
        ((packageProjection FiniteModel.carrier).map
          (finiteCleavageAxisPermutationIso finiteReindexAxisSwap).hom)
        (finiteCleavageAxisPermutationIso finiteReindexAxisSwap).hom
      infer_instance
    have hid :
        (typedCartSemanticInput
          (idTypedPresentation finitePortfolioSupportInstance)).hom =
          𝟙 finitePortfolioSupportInstance.toSemantic :=
      typedRealizableHom_id_hom finitePortfolioSupportInstance
    rw [hid]
    exact CategoryTheory.Functor.IsStronglyCartesian.of_isIso
      (packageProjection FiniteModel.carrier)
      (𝟙 finitePortfolioSupportInstance.toSemantic)
      (finiteCleavageAxisPermutationIso finiteReindexAxisSwap).hom

/-- The literal identity choice at every target package. -/
noncomputable def finiteCleavageLiteralIdentityChoice :
    CoreFiberCartesianCleavage
      (typedCartSemanticInput
        (idTypedPresentation finitePortfolioSupportInstance)) :=
  coreFiberCleavageIdentityCleavage finitePortfolioSupportInstance

/--
An alternate choice: use the visible swap lift at the named four-axis target
and the literal identity lift everywhere else.
-/
noncomputable def finiteCleavageTwistedIdentityChoice :
    CoreFiberCartesianCleavage
      (typedCartSemanticInput
        (idTypedPresentation finitePortfolioSupportInstance)) where
  lift targetPackage := by
    classical
    exact if h : targetPackage = finiteCleavageFourAxisTarget then
        h ▸ finiteCleavageAxisSwapCartesianLift
      else
        coreFiberCleavageIdentityCartesianLift
          finitePortfolioSupportInstance targetPackage

/-- The twisted choice really selects the swap lift at the named target. -/
theorem finiteCleavageTwistedIdentityChoice_lift :
    finiteCleavageTwistedIdentityChoice.lift finiteCleavageFourAxisTarget =
      finiteCleavageAxisSwapCartesianLift := by
  classical
  simp [finiteCleavageTwistedIdentityChoice]

/-- The literal choice really selects the identity lift at the named target. -/
theorem finiteCleavageLiteralIdentityChoice_lift :
    finiteCleavageLiteralIdentityChoice.lift finiteCleavageFourAxisTarget =
      coreFiberCleavageIdentityCartesianLift
        finitePortfolioSupportInstance finiteCleavageFourAxisTarget :=
  rfl

/-! ## Nonidentity comparison, triangles, naturality, and cocycle -/

/-- The canonical component between the two actual choices. -/
noncomputable def finiteCleavageComparisonApp :=
  CoreFiberCartesianCleavage.comparisonApp
    finiteCleavageLiteralIdentityChoice finiteCleavageTwistedIdentityChoice
    finiteCleavageFourAxisTarget

/-- The named twisted domain has the same concrete package as the swap lift. -/
theorem finiteCleavageTwistedDomain_eq :
    (finiteCleavageTwistedIdentityChoice.reindexFunctor.obj
      finiteCleavageFourAxisTarget).1 = finiteReindexFourAxisCore := by
  change
    (finiteCleavageTwistedIdentityChoice.lift
      finiteCleavageFourAxisTarget).domain =
        finiteCleavageAxisSwapCartesianLift.domain
  exact congrArg StrongCartesianLift.domain
    finiteCleavageTwistedIdentityChoice_lift

/-- Read the dependent twisted-domain axis back in the concrete four-axis type. -/
noncomputable def finiteCleavageTwistedAxisReflect
    (axis : (finiteCleavageTwistedIdentityChoice.reindexFunctor.obj
      finiteCleavageFourAxisTarget).1.reading.signatureReading.Axis) : Fin 4 :=
  cast (congrArg
    (fun package : AATCorePackage FiniteModel.carrier =>
      package.reading.signatureReading.Axis)
    finiteCleavageTwistedDomain_eq) axis

private theorem strongCartesianLift_axisMap_cast
    {U : AtomCarrier.{u}} {input : CartSemanticInput U}
    {targetPackage : CoreFiber input.target}
    {first second : StrongCartesianLift input targetPackage}
    (equality : first = second)
    (axis : first.domain.reading.signatureReading.Axis) :
    first.hom.upper.axisMap axis =
      second.hom.upper.axisMap
        (cast (congrArg
          (fun package : AATCorePackage U =>
            package.reading.signatureReading.Axis)
          (congrArg StrongCartesianLift.domain equality)) axis) := by
  cases equality
  rfl

/-- The selected twisted lift acts by the visible swap after carrier reflection. -/
theorem finiteCleavageTwistedAxisMap_graph
    (axis : (finiteCleavageTwistedIdentityChoice.reindexFunctor.obj
      finiteCleavageFourAxisTarget).1.reading.signatureReading.Axis) :
    (finiteCleavageTwistedIdentityChoice.lift
      finiteCleavageFourAxisTarget).hom.upper.axisMap axis =
      finiteReindexAxisSwap (finiteCleavageTwistedAxisReflect axis) := by
  simpa only [finiteCleavageTwistedAxisReflect,
    finiteCleavageAxisSwapCartesianLift,
    finiteCleavageAxisPermutationIso,
    finiteCleavageAxisPermutationTotal] using
      strongCartesianLift_axisMap_cast
        finiteCleavageTwistedIdentityChoice_lift axis

/-- The canonical comparison visibly moves the zero axis to the one axis. -/
theorem finiteCleavageComparisonApp_axis_zero :
    finiteCleavageTwistedAxisReflect
        (finiteCleavageComparisonApp.hom.1.upper.axisMap
          finiteReindexAxisZero) = finiteReindexAxisOne := by
  have hfac := CoreFiberCartesianCleavage.comparisonApp_hom_fac
    finiteCleavageLiteralIdentityChoice finiteCleavageTwistedIdentityChoice
    finiteCleavageFourAxisTarget
  have haxis := congrArg
    (fun hom => hom.upper.axisMap finiteReindexAxisZero) hfac
  change
    (finiteCleavageTwistedIdentityChoice.lift
      finiteCleavageFourAxisTarget).hom.upper.axisMap
        (finiteCleavageComparisonApp.hom.1.upper.axisMap
          finiteReindexAxisZero) = finiteReindexAxisZero at haxis
  rw [finiteCleavageTwistedAxisMap_graph] at haxis
  have hcanceled := congrArg finiteReindexAxisSwap.symm haxis
  simpa [finiteReindexAxisSwap] using hcanceled

/-- The forward comparison triangle fires on the nonidentity alternate lift. -/
theorem finiteCleavageComparisonApp_hom_fac :
    finiteCleavageComparisonApp.hom.1 ≫
        (finiteCleavageTwistedIdentityChoice.lift
          finiteCleavageFourAxisTarget).hom =
      (finiteCleavageLiteralIdentityChoice.lift
        finiteCleavageFourAxisTarget).hom :=
  CoreFiberCartesianCleavage.comparisonApp_hom_fac
    finiteCleavageLiteralIdentityChoice finiteCleavageTwistedIdentityChoice
    finiteCleavageFourAxisTarget

/-- The inverse comparison triangle fires on the same alternate lift. -/
theorem finiteCleavageComparisonApp_inv_fac :
    finiteCleavageComparisonApp.inv.1 ≫
        (finiteCleavageLiteralIdentityChoice.lift
          finiteCleavageFourAxisTarget).hom =
      (finiteCleavageTwistedIdentityChoice.lift
        finiteCleavageFourAxisTarget).hom :=
  CoreFiberCartesianCleavage.comparisonApp_inv_fac
    finiteCleavageLiteralIdentityChoice finiteCleavageTwistedIdentityChoice
    finiteCleavageFourAxisTarget

/-- Comparison naturality fires on the genuine target-axis swap. -/
theorem finiteCleavageComparison_naturality :
    finiteCleavageLiteralIdentityChoice.reindexFunctor.map
        finiteCleavageAxisSwapHom ≫ finiteCleavageComparisonApp.hom =
      finiteCleavageComparisonApp.hom ≫
        finiteCleavageTwistedIdentityChoice.reindexFunctor.map
          finiteCleavageAxisSwapHom :=
  CoreFiberCartesianCleavage.comparison_naturality
    finiteCleavageLiteralIdentityChoice finiteCleavageTwistedIdentityChoice
    finiteCleavageAxisSwapHom

/-- Whole reflexivity fires for the literal choice. -/
theorem finiteCleavageComparison_refl :
    CoreFiberCartesianCleavage.comparison
        finiteCleavageLiteralIdentityChoice finiteCleavageLiteralIdentityChoice =
      Iso.refl finiteCleavageLiteralIdentityChoice.reindexFunctor :=
  CoreFiberCartesianCleavage.comparison_refl
    finiteCleavageLiteralIdentityChoice

/-- Three-choice cocycle fires through the producer-derived selected choice. -/
theorem finiteCleavageComparison_cocycle :
    (CoreFiberCartesianCleavage.comparison
      finiteCleavageLiteralIdentityChoice finiteCleavageTwistedIdentityChoice
      ).trans
      (CoreFiberCartesianCleavage.comparison
        finiteCleavageTwistedIdentityChoice
        (selectedTypedCoreFiberCartesianCleavage
          (idTypedPresentation finitePortfolioSupportInstance))) =
      CoreFiberCartesianCleavage.comparison
        finiteCleavageLiteralIdentityChoice
        (selectedTypedCoreFiberCartesianCleavage
          (idTypedPresentation finitePortfolioSupportInstance)) :=
  CoreFiberCartesianCleavage.comparison_cocycle
    finiteCleavageLiteralIdentityChoice finiteCleavageTwistedIdentityChoice
    (selectedTypedCoreFiberCartesianCleavage
      (idTypedPresentation finitePortfolioSupportInstance))

/-! ## Unitor, compositor, and selected-surface compatibility -/

/-- Unitor compatibility fires on the two genuinely different identity choices. -/
theorem finiteCleavageUnitor_compatibility :
    (coreFiberCleavageReindexUnitor finitePortfolioSupportInstance
      finiteCleavageLiteralIdentityChoice).trans
        (CoreFiberCartesianCleavage.comparison
          finiteCleavageLiteralIdentityChoice
          finiteCleavageTwistedIdentityChoice) =
      coreFiberCleavageReindexUnitor finitePortfolioSupportInstance
        finiteCleavageTwistedIdentityChoice :=
  coreFiberCleavageReindexUnitor_compatibility
    finitePortfolioSupportInstance finiteCleavageLiteralIdentityChoice
    finiteCleavageTwistedIdentityChoice

/-- The noninvertible selective leg used by the compositor control. -/
theorem finiteCleavageSelectiveLeg_not_isIso :
    ¬ IsIso
      (typedRealizableHom finiteSelectiveTwoToSupportPresentation).semantic.hom :=
  finiteSelectiveTwoToSupportInput_not_isIso

/--
Compositor compatibility fires with the noninvertible selective leg and the
twisted identity choice on its right.
-/
theorem finiteCleavageCompositor_compatibility :
    (coreFiberCleavageReindexCompositor
      finiteSelectiveTwoToSupportPresentation
      (idTypedPresentation finitePortfolioSupportInstance)
      (selectedTypedCoreFiberCartesianCleavage
        finiteSelectiveTwoToSupportPresentation)
      finiteCleavageLiteralIdentityChoice
      (selectedTypedCoreFiberCartesianCleavage
        (compPresentation finiteSelectiveTwoToSupportPresentation
          (idTypedPresentation finitePortfolioSupportInstance)))).trans
      (CoreFiberCartesianCleavage.comparison
        (selectedTypedCoreFiberCartesianCleavage
          (compPresentation finiteSelectiveTwoToSupportPresentation
            (idTypedPresentation finitePortfolioSupportInstance)))
        (selectedTypedCoreFiberCartesianCleavage
          (compPresentation finiteSelectiveTwoToSupportPresentation
            (idTypedPresentation finitePortfolioSupportInstance)))) =
    (coreFiberCleavageHorizontalComparison
      finiteSelectiveTwoToSupportPresentation
      (idTypedPresentation finitePortfolioSupportInstance)
      (selectedTypedCoreFiberCartesianCleavage
        finiteSelectiveTwoToSupportPresentation)
      (selectedTypedCoreFiberCartesianCleavage
        finiteSelectiveTwoToSupportPresentation)
      finiteCleavageLiteralIdentityChoice finiteCleavageTwistedIdentityChoice
      ).trans
      (coreFiberCleavageReindexCompositor
        finiteSelectiveTwoToSupportPresentation
        (idTypedPresentation finitePortfolioSupportInstance)
        (selectedTypedCoreFiberCartesianCleavage
          finiteSelectiveTwoToSupportPresentation)
        finiteCleavageTwistedIdentityChoice
        (selectedTypedCoreFiberCartesianCleavage
          (compPresentation finiteSelectiveTwoToSupportPresentation
            (idTypedPresentation finitePortfolioSupportInstance)))) :=
  coreFiberCleavageReindexCompositor_compatibility
    finiteSelectiveTwoToSupportPresentation
    (idTypedPresentation finitePortfolioSupportInstance)
    (selectedTypedCoreFiberCartesianCleavage
      finiteSelectiveTwoToSupportPresentation)
    (selectedTypedCoreFiberCartesianCleavage
      finiteSelectiveTwoToSupportPresentation)
    finiteCleavageLiteralIdentityChoice finiteCleavageTwistedIdentityChoice
    (selectedTypedCoreFiberCartesianCleavage
      (compPresentation finiteSelectiveTwoToSupportPresentation
        (idTypedPresentation finitePortfolioSupportInstance)))
    (selectedTypedCoreFiberCartesianCleavage
      (compPresentation finiteSelectiveTwoToSupportPresentation
        (idTypedPresentation finitePortfolioSupportInstance)))

/-- The generic selected compositor bridge fires on the selective chain. -/
theorem finiteCleavageSelectedCompositor_bridge :
    (coreFiberCleavageReindexCompositor
      finiteSelectiveTwoToOnePresentation finiteSelectiveOneToSupportPresentation
      (selectedTypedCoreFiberCartesianCleavage
        finiteSelectiveTwoToOnePresentation)
      (selectedTypedCoreFiberCartesianCleavage
        finiteSelectiveOneToSupportPresentation)
      (selectedTypedCoreFiberCartesianCleavage
        finiteSelectiveTwoToSupportPresentation)).trans
      (selectedTypedCoreFiberCleavageBridge
        finiteSelectiveTwoToSupportPresentation) =
    (selectedTypedCoreFiberCleavageHorizontalBridge
      finiteSelectiveTwoToOnePresentation finiteSelectiveOneToSupportPresentation
      ).trans
      (selectedCoreFiberReindexCompositor finiteSelectiveTwoToOnePresentation
        finiteSelectiveOneToSupportPresentation) :=
  selectedTypedCoreFiberCleavageCompositor_bridge
    finiteSelectiveTwoToOnePresentation finiteSelectiveOneToSupportPresentation

/-- The generic selected unitor bridge fires at the support endpoint. -/
theorem finiteCleavageSelectedUnitor_bridge :
    (coreFiberCleavageReindexUnitor finitePortfolioSupportInstance
      (selectedTypedCoreFiberCartesianCleavage
        (idTypedPresentation finitePortfolioSupportInstance))).trans
      (selectedTypedCoreFiberCleavageBridge
        (idTypedPresentation finitePortfolioSupportInstance)) =
      selectedCoreFiberReindexUnitor finitePortfolioSupportInstance :=
  selectedTypedCoreFiberCleavageUnitor_bridge
    finitePortfolioSupportInstance

end AAT.AG.DoctrineFiberProduct

