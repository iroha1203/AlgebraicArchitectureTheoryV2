import ResearchLean.AG.DoctrineFiberProduct.CartesianRegimeReindexing

/-!
# Constructor-relative coherence for cartesian reindexing

This module equips the producer-derived contravariant reindexing functors with
the unitor, compositor, and constructor-relative coherence generated by their
strong cartesian universal properties.  Typed presentations are kept in the
types throughout: semantic associativity and unit equalities transport only
the strong-cartesianness of explicitly composed lifts, never one
`RealizableHom` or selected functor into another.

The result is coherence for the existing typed identity and composition
constructors.  It is not yet independence of arbitrary presentation or
cartesian-lift choices.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open CategoryTheory
open AtomFoundation
open CrossStageCoherence

set_option maxHeartbeats 2000000

/-! ## Exact-endpoint typed realization -/

/-- The semantic input decoded from a typed presentation with literal endpoints. -/
def typedCartSemanticInput
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target) :
    CartSemanticInput U where
  source := source.toSemantic
  target := target.toSemantic
  hom := typedPresentationToSemantic presentation

/-- The realization witness generated by one typed cartesian presentation. -/
def typedRealizableHom
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target) : RealizableHom U where
  semantic := typedCartSemanticInput presentation
  presentation := presentation.toPresentation
  realization_eq := by
    cases presentation
    rfl

/-- The typed realization has the authored semantic source endpoint. -/
theorem typedRealizableHom_source
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target) :
    (typedRealizableHom presentation).semantic.source = source.toSemantic :=
  rfl

/-- The typed realization has the authored semantic target endpoint. -/
theorem typedRealizableHom_target
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target) :
    (typedRealizableHom presentation).semantic.target = target.toSemantic :=
  rfl

/-- The typed realization decodes to the exact typed semantic arrow. -/
theorem typedRealizableHom_hom
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target) :
    (typedRealizableHom presentation).semantic.hom =
      typedPresentationToSemantic presentation :=
  rfl

/-- The selected contravariant functor with its code endpoints exposed. -/
noncomputable def selectedTypedCoreFiberReindexFunctor
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target) :
    CoreFiber target.toSemantic ⥤ CoreFiber source.toSemantic := by
  simpa only [typedRealizableHom, typedCartSemanticInput] using
    selectedCoreFiberReindexFunctor (typedRealizableHom presentation)

/-- The selected strong cartesian lift with literal typed endpoints. -/
noncomputable def selectedTypedCoreFiberCartesianLift
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target)
    (targetPackage : CoreFiber target.toSemantic) :
    StrongCartesianLift (typedCartSemanticInput presentation) targetPackage := by
  simpa only [typedRealizableHom] using
    selectedCoreFiberCartesianLift (typedRealizableHom presentation)
      targetPackage

/-- The typed functor object is the domain of its selected generated lift. -/
theorem selectedTypedCoreFiberReindexFunctor_obj
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target)
    (targetPackage : CoreFiber target.toSemantic) :
    (selectedTypedCoreFiberReindexFunctor presentation).obj targetPackage =
      (selectedTypedCoreFiberCartesianLift presentation targetPackage).domainObject := by
  simpa only [selectedTypedCoreFiberReindexFunctor,
    selectedTypedCoreFiberCartesianLift] using
      selectedCoreFiberReindexFunctor_obj
        (typedRealizableHom presentation) targetPackage

/-- The typed selected map satisfies its actual cartesian factor graph. -/
theorem selectedTypedCoreFiberReindexFunctor_map_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target)
    {first second : CoreFiber target.toSemantic}
    (hom : first ⟶ second) :
    ((selectedTypedCoreFiberReindexFunctor presentation).map hom).1 ≫
        (selectedTypedCoreFiberCartesianLift presentation second).hom =
      (selectedTypedCoreFiberCartesianLift presentation first).hom ≫ hom.1 := by
  simpa only [selectedTypedCoreFiberReindexFunctor,
    selectedTypedCoreFiberCartesianLift] using
      selectedCoreFiberReindexFunctor_map_fac
        (typedRealizableHom presentation) hom

/-- Typed identity decoding is the categorical identity. -/
theorem typedRealizableHom_id_hom
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U) :
    (typedRealizableHom (idTypedPresentation instanceCode)).semantic.hom =
      𝟙 instanceCode.toSemantic := by
  change typedPresentationToSemantic (idTypedPresentation instanceCode) =
    𝟙 instanceCode.toSemantic
  apply ExtInstHom.ext
  apply ExactDoctrineHom.ext
  · rfl
  · exact AtomPermutationCode.toEquiv_refl

/-- Typed presentation composition decodes to semantic composition. -/
theorem typedRealizableHom_comp_hom
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (first : CartPresentationBetween source middle)
    (second : CartPresentationBetween middle target) :
    (typedRealizableHom (compPresentation first second)).semantic.hom =
      (typedRealizableHom first).semantic.hom ≫
        (typedRealizableHom second).semantic.hom := by
  exact toSemanticCart_compPresentation_hom first second

/-! ## Comparison of two generated cartesian lifts -/

/--
The unique vertical comparison from the domain of `second` to the domain of
`first`.  Its direction is contravariant: it factors the second lift through
the first lift.
-/
private noncomputable def strongCartesianLiftDomainComparisonHom
    {U : AtomCarrier.{u}}
    {input : CartSemanticInput U} {targetPackage : CoreFiber input.target}
    (first second : StrongCartesianLift input targetPackage) :
    second.domainObject ⟶ first.domainObject := by
  letI := first.isStronglyCartesian
  letI := second.isStronglyCartesian
  refine ⟨CategoryTheory.Functor.IsStronglyCartesian.map
      (packageProjection U) input.hom first.hom
      (g := 𝟙 input.source) (f' := input.hom)
      (Category.id_comp input.hom).symm second.hom, ?_⟩
  infer_instance

/-- The cartesian comparison followed by the first lift is the second lift. -/
private theorem strongCartesianLiftDomainComparisonHom_fac
    {U : AtomCarrier.{u}}
    {input : CartSemanticInput U} {targetPackage : CoreFiber input.target}
    (first second : StrongCartesianLift input targetPackage) :
    (strongCartesianLiftDomainComparisonHom first second).1 ≫ first.hom =
      second.hom := by
  letI := first.isStronglyCartesian
  letI := second.isStronglyCartesian
  exact CategoryTheory.Functor.IsStronglyCartesian.fac
    (packageProjection U) input.hom first.hom
    (Category.id_comp input.hom).symm second.hom

/-- Two strong cartesian lifts of one arrow have canonically isomorphic domains. -/
private noncomputable def strongCartesianLiftDomainComparisonIso
    {U : AtomCarrier.{u}}
    {input : CartSemanticInput U} {targetPackage : CoreFiber input.target}
    (first second : StrongCartesianLift input targetPackage) :
    second.domainObject ≅ first.domainObject where
  hom := strongCartesianLiftDomainComparisonHom first second
  inv := strongCartesianLiftDomainComparisonHom second first
  hom_inv_id := by
    apply CategoryTheory.Functor.Fiber.hom_ext
    letI := first.isStronglyCartesian
    letI := second.isStronglyCartesian
    apply CategoryTheory.Functor.IsStronglyCartesian.ext
      (packageProjection U) input.hom second.hom (𝟙 input.source)
    change
      ((strongCartesianLiftDomainComparisonHom first second).1 ≫
        (strongCartesianLiftDomainComparisonHom second first).1) ≫
          second.hom = 𝟙 second.domain ≫ second.hom
    rw [Category.assoc, strongCartesianLiftDomainComparisonHom_fac,
      strongCartesianLiftDomainComparisonHom_fac]
    simp
  inv_hom_id := by
    apply CategoryTheory.Functor.Fiber.hom_ext
    letI := first.isStronglyCartesian
    letI := second.isStronglyCartesian
    apply CategoryTheory.Functor.IsStronglyCartesian.ext
      (packageProjection U) input.hom first.hom (𝟙 input.source)
    change
      ((strongCartesianLiftDomainComparisonHom second first).1 ≫
        (strongCartesianLiftDomainComparisonHom first second).1) ≫
          first.hom = 𝟙 first.domain ≫ first.hom
    rw [Category.assoc, strongCartesianLiftDomainComparisonHom_fac,
      strongCartesianLiftDomainComparisonHom_fac]
    simp

/-! ## Two-step selected lift and compositor -/

/--
The actual two-step lift obtained by first reindexing along `second` and then
along `first`.  Only the strong-cartesianness proposition is transported from
the decoded composite arrow to the typed composite constructor.
-/
noncomputable def selectedCoreFiberIteratedCartesianLift
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (first : CartPresentationBetween source middle)
    (second : CartPresentationBetween middle target)
    (targetPackage : CoreFiber target.toSemantic) :
    StrongCartesianLift
      (typedCartSemanticInput (compPresentation first second)) targetPackage where
  domain :=
    (selectedTypedCoreFiberCartesianLift first
      ((selectedTypedCoreFiberReindexFunctor second).obj targetPackage)).domain
  hom :=
    (selectedTypedCoreFiberCartesianLift first
      ((selectedTypedCoreFiberReindexFunctor second).obj targetPackage)).hom ≫
      (selectedTypedCoreFiberCartesianLift second targetPackage).hom
  isStronglyCartesian := by
    letI := (selectedTypedCoreFiberCartesianLift first
      ((selectedTypedCoreFiberReindexFunctor second).obj targetPackage)
      ).isStronglyCartesian
    letI := (selectedTypedCoreFiberCartesianLift second targetPackage
      ).isStronglyCartesian
    have hcomp :
        (typedCartSemanticInput (compPresentation first second)).hom =
          (typedCartSemanticInput first).hom ≫
            (typedCartSemanticInput second).hom :=
      typedRealizableHom_comp_hom first second
    rw [hcomp]
    exact CategoryTheory.Functor.IsStronglyCartesian.comp
      (packageProjection U)

/-- The iterated lift is the literal composite of the two selected lift homs. -/
theorem selectedCoreFiberIteratedCartesianLift_hom
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (first : CartPresentationBetween source middle)
    (second : CartPresentationBetween middle target)
    (targetPackage : CoreFiber target.toSemantic) :
    (selectedCoreFiberIteratedCartesianLift first second targetPackage).hom =
      (selectedTypedCoreFiberCartesianLift first
        ((selectedTypedCoreFiberReindexFunctor second).obj targetPackage)).hom ≫
        (selectedTypedCoreFiberCartesianLift second targetPackage).hom :=
  rfl

/--
The contravariant compositor component from the iterated selected domain to the
domain selected directly for the typed composite.
-/
noncomputable def selectedCoreFiberReindexCompositorApp
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (first : CartPresentationBetween source middle)
    (second : CartPresentationBetween middle target)
    (targetPackage : CoreFiber target.toSemantic) :
    (selectedTypedCoreFiberReindexFunctor second ⋙
        selectedTypedCoreFiberReindexFunctor first).obj targetPackage ≅
      (selectedTypedCoreFiberReindexFunctor
        (compPresentation first second)).obj targetPackage := by
  simpa only [selectedTypedCoreFiberReindexFunctor_obj,
    selectedCoreFiberIteratedCartesianLift] using
      strongCartesianLiftDomainComparisonIso
        (selectedTypedCoreFiberCartesianLift
          (compPresentation first second) targetPackage)
        (selectedCoreFiberIteratedCartesianLift first second targetPackage)

/-- The compositor component factors the iterated lift through the direct lift. -/
theorem selectedCoreFiberReindexCompositorApp_hom_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (first : CartPresentationBetween source middle)
    (second : CartPresentationBetween middle target)
    (targetPackage : CoreFiber target.toSemantic) :
    (selectedCoreFiberReindexCompositorApp first second targetPackage).hom.1 ≫
        (selectedTypedCoreFiberCartesianLift
          (compPresentation first second) targetPackage).hom =
      (selectedCoreFiberIteratedCartesianLift first second targetPackage).hom := by
  simpa only [selectedCoreFiberReindexCompositorApp] using
    strongCartesianLiftDomainComparisonHom_fac
      (selectedTypedCoreFiberCartesianLift
        (compPresentation first second) targetPackage)
      (selectedCoreFiberIteratedCartesianLift first second targetPackage)

/-- The iterated selected lift carries every vertical map to its source map. -/
theorem selectedCoreFiberIteratedMap_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (first : CartPresentationBetween source middle)
    (second : CartPresentationBetween middle target)
    {sourcePackage targetPackage : CoreFiber target.toSemantic}
    (hom : sourcePackage ⟶ targetPackage) :
    ((selectedTypedCoreFiberReindexFunctor second ⋙
        selectedTypedCoreFiberReindexFunctor first).map hom).1 ≫
        (selectedCoreFiberIteratedCartesianLift first second targetPackage).hom =
      (selectedCoreFiberIteratedCartesianLift first second sourcePackage).hom ≫
        hom.1 := by
  change
    ((selectedTypedCoreFiberReindexFunctor first).map
      ((selectedTypedCoreFiberReindexFunctor second).map hom)).1 ≫
        ((selectedTypedCoreFiberCartesianLift first
          ((selectedTypedCoreFiberReindexFunctor second).obj targetPackage)).hom ≫
          (selectedTypedCoreFiberCartesianLift second targetPackage).hom) =
      ((selectedTypedCoreFiberCartesianLift first
          ((selectedTypedCoreFiberReindexFunctor second).obj sourcePackage)).hom ≫
        (selectedTypedCoreFiberCartesianLift second sourcePackage).hom) ≫ hom.1
  calc
    _ = (((selectedTypedCoreFiberReindexFunctor first).map
          ((selectedTypedCoreFiberReindexFunctor second).map hom)).1 ≫
        (selectedTypedCoreFiberCartesianLift first
          ((selectedTypedCoreFiberReindexFunctor second).obj targetPackage)).hom) ≫
        (selectedTypedCoreFiberCartesianLift second targetPackage).hom :=
      (Category.assoc _ _ _).symm
    _ = ((selectedTypedCoreFiberCartesianLift first
          ((selectedTypedCoreFiberReindexFunctor second).obj sourcePackage)).hom ≫
        ((selectedTypedCoreFiberReindexFunctor second).map hom).1) ≫
        (selectedTypedCoreFiberCartesianLift second targetPackage).hom := by
      rw [selectedTypedCoreFiberReindexFunctor_map_fac]
    _ = (selectedTypedCoreFiberCartesianLift first
          ((selectedTypedCoreFiberReindexFunctor second).obj sourcePackage)).hom ≫
        (((selectedTypedCoreFiberReindexFunctor second).map hom).1 ≫
          (selectedTypedCoreFiberCartesianLift second targetPackage).hom) :=
      Category.assoc _ _ _
    _ = (selectedTypedCoreFiberCartesianLift first
          ((selectedTypedCoreFiberReindexFunctor second).obj sourcePackage)).hom ≫
        ((selectedTypedCoreFiberCartesianLift second sourcePackage).hom ≫ hom.1) := by
      rw [selectedTypedCoreFiberReindexFunctor_map_fac]
    _ = _ := (Category.assoc _ _ _).symm

/-- The selected contravariant compositor is natural on every vertical map. -/
theorem selectedCoreFiberReindexCompositor_naturality
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (first : CartPresentationBetween source middle)
    (second : CartPresentationBetween middle target)
    {sourcePackage targetPackage : CoreFiber target.toSemantic}
    (hom : sourcePackage ⟶ targetPackage) :
    (selectedTypedCoreFiberReindexFunctor second ⋙
        selectedTypedCoreFiberReindexFunctor first).map hom ≫
        (selectedCoreFiberReindexCompositorApp
          first second targetPackage).hom =
      (selectedCoreFiberReindexCompositorApp first second sourcePackage).hom ≫
        (selectedTypedCoreFiberReindexFunctor
          (compPresentation first second)).map hom := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let directTarget := selectedTypedCoreFiberCartesianLift
    (compPresentation first second) targetPackage
  letI := directTarget.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U)
    (typedCartSemanticInput (compPresentation first second)).hom
    directTarget.hom (𝟙 source.toSemantic)
  change
    (((selectedTypedCoreFiberReindexFunctor second ⋙
      selectedTypedCoreFiberReindexFunctor first).map hom).1 ≫
        (selectedCoreFiberReindexCompositorApp first second targetPackage).hom.1) ≫
          directTarget.hom =
      ((selectedCoreFiberReindexCompositorApp first second sourcePackage).hom.1 ≫
        ((selectedTypedCoreFiberReindexFunctor
          (compPresentation first second)).map hom).1) ≫ directTarget.hom
  calc
    _ = ((selectedTypedCoreFiberReindexFunctor second ⋙
          selectedTypedCoreFiberReindexFunctor first).map hom).1 ≫
        ((selectedCoreFiberReindexCompositorApp
          first second targetPackage).hom.1 ≫ directTarget.hom) :=
      Category.assoc _ _ _
    _ = ((selectedTypedCoreFiberReindexFunctor second ⋙
          selectedTypedCoreFiberReindexFunctor first).map hom).1 ≫
        (selectedCoreFiberIteratedCartesianLift first second targetPackage).hom := by
      rw [selectedCoreFiberReindexCompositorApp_hom_fac]
    _ = (selectedCoreFiberIteratedCartesianLift first second sourcePackage).hom ≫
        hom.1 := selectedCoreFiberIteratedMap_fac first second hom
    _ = ((selectedCoreFiberReindexCompositorApp
          first second sourcePackage).hom.1 ≫
        (selectedTypedCoreFiberCartesianLift
          (compPresentation first second) sourcePackage).hom) ≫ hom.1 := by
      rw [selectedCoreFiberReindexCompositorApp_hom_fac]
    _ = (selectedCoreFiberReindexCompositorApp
          first second sourcePackage).hom.1 ≫
        ((selectedTypedCoreFiberCartesianLift
          (compPresentation first second) sourcePackage).hom ≫ hom.1) :=
      Category.assoc _ _ _
    _ = (selectedCoreFiberReindexCompositorApp
          first second sourcePackage).hom.1 ≫
        (((selectedTypedCoreFiberReindexFunctor
          (compPresentation first second)).map hom).1 ≫ directTarget.hom) := by
      rw [selectedTypedCoreFiberReindexFunctor_map_fac]
    _ = _ := (Category.assoc _ _ _).symm

/-- The natural contravariant compositor for typed presentation composition. -/
noncomputable def selectedCoreFiberReindexCompositor
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (first : CartPresentationBetween source middle)
    (second : CartPresentationBetween middle target) :
    selectedTypedCoreFiberReindexFunctor second ⋙
        selectedTypedCoreFiberReindexFunctor first ≅
      selectedTypedCoreFiberReindexFunctor (compPresentation first second) :=
  NatIso.ofComponents (selectedCoreFiberReindexCompositorApp first second)
    (fun hom => selectedCoreFiberReindexCompositor_naturality first second hom)

/-! ## Selected identity lift and unitor -/

/-- The literal identity package hom, viewed over the typed identity decoder. -/
noncomputable def selectedCoreFiberIdentityCartesianLift
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U)
    (targetPackage : CoreFiber instanceCode.toSemantic) :
    StrongCartesianLift
      (typedCartSemanticInput (idTypedPresentation instanceCode)) targetPackage where
  domain := targetPackage.1
  hom := 𝟙 targetPackage.1
  isStronglyCartesian := by
    letI : (packageProjection U).IsHomLift
        (𝟙 instanceCode.toSemantic) (𝟙 targetPackage.1) :=
      CategoryTheory.IsHomLift.id targetPackage.2
    letI : IsIso (𝟙 targetPackage.1) := by infer_instance
    have hid :
        (typedCartSemanticInput (idTypedPresentation instanceCode)).hom =
          𝟙 instanceCode.toSemantic :=
      typedRealizableHom_id_hom instanceCode
    rw [hid]
    exact CategoryTheory.Functor.IsStronglyCartesian.of_isIso
      (packageProjection U) (𝟙 instanceCode.toSemantic) (𝟙 targetPackage.1)

/-- The contravariant unitor component from a literal object to its selected pullback. -/
noncomputable def selectedCoreFiberReindexUnitorApp
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U)
    (targetPackage : CoreFiber instanceCode.toSemantic) :
    targetPackage ≅
      (selectedTypedCoreFiberReindexFunctor
        (idTypedPresentation instanceCode)).obj targetPackage := by
  simpa only [selectedTypedCoreFiberReindexFunctor_obj,
    selectedCoreFiberIdentityCartesianLift] using
      strongCartesianLiftDomainComparisonIso
        (selectedTypedCoreFiberCartesianLift
          (idTypedPresentation instanceCode) targetPackage)
        (selectedCoreFiberIdentityCartesianLift instanceCode targetPackage)

/-- The unitor component followed by the selected identity lift is literal identity. -/
theorem selectedCoreFiberReindexUnitorApp_hom_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U)
    (targetPackage : CoreFiber instanceCode.toSemantic) :
    (selectedCoreFiberReindexUnitorApp instanceCode targetPackage).hom.1 ≫
        (selectedTypedCoreFiberCartesianLift
          (idTypedPresentation instanceCode) targetPackage).hom =
      𝟙 targetPackage.1 := by
  simpa only [selectedCoreFiberReindexUnitorApp,
    selectedCoreFiberIdentityCartesianLift] using
      strongCartesianLiftDomainComparisonHom_fac
        (selectedTypedCoreFiberCartesianLift
          (idTypedPresentation instanceCode) targetPackage)
        (selectedCoreFiberIdentityCartesianLift instanceCode targetPackage)

/-- The selected contravariant unitor is natural on every vertical map. -/
theorem selectedCoreFiberReindexUnitor_naturality
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U)
    {sourcePackage targetPackage : CoreFiber instanceCode.toSemantic}
    (hom : sourcePackage ⟶ targetPackage) :
    hom ≫ (selectedCoreFiberReindexUnitorApp
        instanceCode targetPackage).hom =
      (selectedCoreFiberReindexUnitorApp instanceCode sourcePackage).hom ≫
        (selectedTypedCoreFiberReindexFunctor
          (idTypedPresentation instanceCode)).map hom := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let targetLift := selectedTypedCoreFiberCartesianLift
    (idTypedPresentation instanceCode) targetPackage
  letI := targetLift.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U)
    (typedCartSemanticInput (idTypedPresentation instanceCode)).hom
    targetLift.hom (𝟙 instanceCode.toSemantic)
  change
    (hom.1 ≫
      (selectedCoreFiberReindexUnitorApp instanceCode targetPackage).hom.1) ≫
        targetLift.hom =
      ((selectedCoreFiberReindexUnitorApp instanceCode sourcePackage).hom.1 ≫
        ((selectedTypedCoreFiberReindexFunctor
          (idTypedPresentation instanceCode)).map hom).1) ≫ targetLift.hom
  calc
    _ = hom.1 ≫
        ((selectedCoreFiberReindexUnitorApp
          instanceCode targetPackage).hom.1 ≫ targetLift.hom) :=
      Category.assoc _ _ _
    _ = hom.1 ≫ 𝟙 targetPackage.1 := by
      rw [selectedCoreFiberReindexUnitorApp_hom_fac]
    _ = hom.1 := Category.comp_id _
    _ = 𝟙 sourcePackage.1 ≫ hom.1 := (Category.id_comp _).symm
    _ = ((selectedCoreFiberReindexUnitorApp
          instanceCode sourcePackage).hom.1 ≫
        (selectedTypedCoreFiberCartesianLift
          (idTypedPresentation instanceCode) sourcePackage).hom) ≫ hom.1 := by
      rw [selectedCoreFiberReindexUnitorApp_hom_fac]
    _ = (selectedCoreFiberReindexUnitorApp
          instanceCode sourcePackage).hom.1 ≫
        ((selectedTypedCoreFiberCartesianLift
          (idTypedPresentation instanceCode) sourcePackage).hom ≫ hom.1) :=
      Category.assoc _ _ _
    _ = (selectedCoreFiberReindexUnitorApp
          instanceCode sourcePackage).hom.1 ≫
        (((selectedTypedCoreFiberReindexFunctor
          (idTypedPresentation instanceCode)).map hom).1 ≫ targetLift.hom) := by
      rw [selectedTypedCoreFiberReindexFunctor_map_fac]
    _ = _ := (Category.assoc _ _ _).symm

/-- The natural contravariant unitor for the typed identity constructor. -/
noncomputable def selectedCoreFiberReindexUnitor
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U) :
    CategoryTheory.Functor.id (CoreFiber instanceCode.toSemantic) ≅
      selectedTypedCoreFiberReindexFunctor
        (idTypedPresentation instanceCode) :=
  NatIso.ofComponents (selectedCoreFiberReindexUnitorApp instanceCode)
    (fun hom => selectedCoreFiberReindexUnitor_naturality instanceCode hom)

/-! ## Relative comparison without presentation casts -/

/--
Compose two selected lifts and regard their strong property over an explicitly
fixed direct presentation.  The equality argument changes only the base arrow
of the strong-cartesianness proposition.
-/
private noncomputable def selectedCoreFiberRelativeIteratedCartesianLift
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (direct : CartPresentationBetween source target)
    (first : CartPresentationBetween source middle)
    (second : CartPresentationBetween middle target)
    (base_eq : (typedCartSemanticInput direct).hom =
      (typedCartSemanticInput first).hom ≫
        (typedCartSemanticInput second).hom)
    (targetPackage : CoreFiber target.toSemantic) :
    StrongCartesianLift (typedCartSemanticInput direct) targetPackage where
  domain :=
    (selectedTypedCoreFiberCartesianLift first
      ((selectedTypedCoreFiberReindexFunctor second).obj targetPackage)).domain
  hom :=
    (selectedTypedCoreFiberCartesianLift first
      ((selectedTypedCoreFiberReindexFunctor second).obj targetPackage)).hom ≫
      (selectedTypedCoreFiberCartesianLift second targetPackage).hom
  isStronglyCartesian := by
    letI := (selectedTypedCoreFiberCartesianLift first
      ((selectedTypedCoreFiberReindexFunctor second).obj targetPackage)
      ).isStronglyCartesian
    letI := (selectedTypedCoreFiberCartesianLift second targetPackage
      ).isStronglyCartesian
    rw [base_eq]
    exact CategoryTheory.Functor.IsStronglyCartesian.comp
      (packageProjection U)

/-- The relative comparison from an iterated domain to the fixed direct domain. -/
private noncomputable def selectedCoreFiberRelativeCompositorApp
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (direct : CartPresentationBetween source target)
    (first : CartPresentationBetween source middle)
    (second : CartPresentationBetween middle target)
    (base_eq : (typedCartSemanticInput direct).hom =
      (typedCartSemanticInput first).hom ≫
        (typedCartSemanticInput second).hom)
    (targetPackage : CoreFiber target.toSemantic) :
    (selectedTypedCoreFiberReindexFunctor second ⋙
        selectedTypedCoreFiberReindexFunctor first).obj targetPackage ≅
      (selectedTypedCoreFiberReindexFunctor direct).obj targetPackage := by
  simpa only [selectedTypedCoreFiberReindexFunctor_obj,
    selectedCoreFiberRelativeIteratedCartesianLift] using
      strongCartesianLiftDomainComparisonIso
        (selectedTypedCoreFiberCartesianLift direct targetPackage)
        (selectedCoreFiberRelativeIteratedCartesianLift
          direct first second base_eq targetPackage)

/-- The relative comparison has the same cartesian triangle as the compositor. -/
private theorem selectedCoreFiberRelativeCompositorApp_hom_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (direct : CartPresentationBetween source target)
    (first : CartPresentationBetween source middle)
    (second : CartPresentationBetween middle target)
    (base_eq : (typedCartSemanticInput direct).hom =
      (typedCartSemanticInput first).hom ≫
        (typedCartSemanticInput second).hom)
    (targetPackage : CoreFiber target.toSemantic) :
    (selectedCoreFiberRelativeCompositorApp
        direct first second base_eq targetPackage).hom.1 ≫
        (selectedTypedCoreFiberCartesianLift direct targetPackage).hom =
      (selectedCoreFiberRelativeIteratedCartesianLift
        direct first second base_eq targetPackage).hom := by
  simpa only [selectedCoreFiberRelativeCompositorApp] using
    strongCartesianLiftDomainComparisonHom_fac
      (selectedTypedCoreFiberCartesianLift direct targetPackage)
      (selectedCoreFiberRelativeIteratedCartesianLift
        direct first second base_eq targetPackage)

/-! ## Constructor-relative associativity -/

/-- The semantic equality used to compare right association with one fixed left direct code. -/
private theorem selectedCoreFiberReindex_assoc_base_eq
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {firstObject secondObject thirdObject fourthObject : FiniteInstanceCode U}
    (first : CartPresentationBetween firstObject secondObject)
    (second : CartPresentationBetween secondObject thirdObject)
    (third : CartPresentationBetween thirdObject fourthObject) :
    (typedCartSemanticInput
      (compPresentation (compPresentation first second) third)).hom =
      (typedCartSemanticInput first).hom ≫
        (typedCartSemanticInput (compPresentation second third)).hom := by
  calc
    _ = (typedCartSemanticInput (compPresentation first second)).hom ≫
        (typedCartSemanticInput third).hom :=
      typedRealizableHom_comp_hom (compPresentation first second) third
    _ = ((typedCartSemanticInput first).hom ≫
        (typedCartSemanticInput second).hom) ≫
          (typedCartSemanticInput third).hom := by
      have hpq :
          (typedCartSemanticInput (compPresentation first second)).hom =
            (typedCartSemanticInput first).hom ≫
              (typedCartSemanticInput second).hom :=
        typedRealizableHom_comp_hom first second
      exact congrArg (fun hom => hom ≫
        (typedCartSemanticInput third).hom) hpq
    _ = (typedCartSemanticInput first).hom ≫
        ((typedCartSemanticInput second).hom ≫
          (typedCartSemanticInput third).hom) :=
      Category.assoc _ _ _
    _ = _ := by
      have hqr :
          (typedCartSemanticInput (compPresentation second third)).hom =
            (typedCartSemanticInput second).hom ≫
              (typedCartSemanticInput third).hom :=
        typedRealizableHom_comp_hom second third
      exact congrArg (fun hom =>
        (typedCartSemanticInput first).hom ≫ hom) hqr.symm

/-- The fully iterated three-step selected cartesian lift hom. -/
noncomputable def selectedCoreFiberTripleIteratedLift
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {firstObject secondObject thirdObject fourthObject : FiniteInstanceCode U}
    (first : CartPresentationBetween firstObject secondObject)
    (second : CartPresentationBetween secondObject thirdObject)
    (third : CartPresentationBetween thirdObject fourthObject)
    (targetPackage : CoreFiber fourthObject.toSemantic) :
    ((selectedTypedCoreFiberReindexFunctor first).obj
      ((selectedTypedCoreFiberReindexFunctor second).obj
        ((selectedTypedCoreFiberReindexFunctor third).obj targetPackage))).1 ⟶
      targetPackage.1 :=
  (selectedTypedCoreFiberCartesianLift first
    ((selectedTypedCoreFiberReindexFunctor second).obj
      ((selectedTypedCoreFiberReindexFunctor third).obj targetPackage))).hom ≫
    ((selectedTypedCoreFiberCartesianLift second
      ((selectedTypedCoreFiberReindexFunctor third).obj targetPackage)).hom ≫
      (selectedTypedCoreFiberCartesianLift third targetPackage).hom)

/-- The left-associated actual compositor route to the fixed direct presentation. -/
noncomputable def selectedCoreFiberReindexAssocLeftRoute
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {firstObject secondObject thirdObject fourthObject : FiniteInstanceCode U}
    (first : CartPresentationBetween firstObject secondObject)
    (second : CartPresentationBetween secondObject thirdObject)
    (third : CartPresentationBetween thirdObject fourthObject)
    (targetPackage : CoreFiber fourthObject.toSemantic) :
    (selectedTypedCoreFiberReindexFunctor first).obj
        ((selectedTypedCoreFiberReindexFunctor second).obj
          ((selectedTypedCoreFiberReindexFunctor third).obj targetPackage)) ⟶
      (selectedTypedCoreFiberReindexFunctor
        (compPresentation (compPresentation first second) third)).obj
          targetPackage :=
  (selectedCoreFiberReindexCompositorApp first second
      ((selectedTypedCoreFiberReindexFunctor third).obj targetPackage)).hom ≫
    (selectedCoreFiberReindexCompositorApp
      (compPresentation first second) third targetPackage).hom

/-- The right-associated actual compositor route to the same fixed direct presentation. -/
noncomputable def selectedCoreFiberReindexAssocRightRoute
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {firstObject secondObject thirdObject fourthObject : FiniteInstanceCode U}
    (first : CartPresentationBetween firstObject secondObject)
    (second : CartPresentationBetween secondObject thirdObject)
    (third : CartPresentationBetween thirdObject fourthObject)
    (targetPackage : CoreFiber fourthObject.toSemantic) :
    (selectedTypedCoreFiberReindexFunctor first).obj
        ((selectedTypedCoreFiberReindexFunctor second).obj
          ((selectedTypedCoreFiberReindexFunctor third).obj targetPackage)) ⟶
      (selectedTypedCoreFiberReindexFunctor
        (compPresentation (compPresentation first second) third)).obj
          targetPackage :=
  (selectedTypedCoreFiberReindexFunctor first).map
      (selectedCoreFiberReindexCompositorApp
        second third targetPackage).hom ≫
    (selectedCoreFiberRelativeCompositorApp
      (compPresentation (compPresentation first second) third)
      first (compPresentation second third)
      (selectedCoreFiberReindex_assoc_base_eq first second third)
      targetPackage).hom

/-- The left compositor route factors the fixed direct lift as the triple lift. -/
theorem selectedCoreFiberReindexAssocLeftRoute_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {firstObject secondObject thirdObject fourthObject : FiniteInstanceCode U}
    (first : CartPresentationBetween firstObject secondObject)
    (second : CartPresentationBetween secondObject thirdObject)
    (third : CartPresentationBetween thirdObject fourthObject)
    (targetPackage : CoreFiber fourthObject.toSemantic) :
    (selectedCoreFiberReindexAssocLeftRoute
        first second third targetPackage).1 ≫
        (selectedTypedCoreFiberCartesianLift
          (compPresentation (compPresentation first second) third)
          targetPackage).hom =
      selectedCoreFiberTripleIteratedLift first second third targetPackage := by
  change
    ((selectedCoreFiberReindexCompositorApp first second
        ((selectedTypedCoreFiberReindexFunctor third).obj targetPackage)).hom.1 ≫
      (selectedCoreFiberReindexCompositorApp
        (compPresentation first second) third targetPackage).hom.1) ≫
        (selectedTypedCoreFiberCartesianLift
          (compPresentation (compPresentation first second) third)
          targetPackage).hom =
      (selectedTypedCoreFiberCartesianLift first
        ((selectedTypedCoreFiberReindexFunctor second).obj
          ((selectedTypedCoreFiberReindexFunctor third).obj targetPackage))).hom ≫
        ((selectedTypedCoreFiberCartesianLift second
          ((selectedTypedCoreFiberReindexFunctor third).obj targetPackage)).hom ≫
          (selectedTypedCoreFiberCartesianLift third targetPackage).hom)
  calc
    _ = (selectedCoreFiberReindexCompositorApp first second
          ((selectedTypedCoreFiberReindexFunctor third).obj targetPackage)).hom.1 ≫
        ((selectedCoreFiberReindexCompositorApp
          (compPresentation first second) third targetPackage).hom.1 ≫
          (selectedTypedCoreFiberCartesianLift
            (compPresentation (compPresentation first second) third)
            targetPackage).hom) :=
      Category.assoc _ _ _
    _ = (selectedCoreFiberReindexCompositorApp first second
          ((selectedTypedCoreFiberReindexFunctor third).obj targetPackage)).hom.1 ≫
        (selectedCoreFiberIteratedCartesianLift
          (compPresentation first second) third targetPackage).hom := by
      rw [selectedCoreFiberReindexCompositorApp_hom_fac]
    _ = (selectedCoreFiberReindexCompositorApp first second
          ((selectedTypedCoreFiberReindexFunctor third).obj targetPackage)).hom.1 ≫
        ((selectedTypedCoreFiberCartesianLift
          (compPresentation first second)
          ((selectedTypedCoreFiberReindexFunctor third).obj targetPackage)).hom ≫
          (selectedTypedCoreFiberCartesianLift third targetPackage).hom) := rfl
    _ = ((selectedCoreFiberReindexCompositorApp first second
          ((selectedTypedCoreFiberReindexFunctor third).obj targetPackage)).hom.1 ≫
        (selectedTypedCoreFiberCartesianLift
          (compPresentation first second)
          ((selectedTypedCoreFiberReindexFunctor third).obj targetPackage)).hom) ≫
          (selectedTypedCoreFiberCartesianLift third targetPackage).hom :=
      (Category.assoc _ _ _).symm
    _ = (selectedCoreFiberIteratedCartesianLift first second
          ((selectedTypedCoreFiberReindexFunctor third).obj targetPackage)).hom ≫
        (selectedTypedCoreFiberCartesianLift third targetPackage).hom := by
      rw [selectedCoreFiberReindexCompositorApp_hom_fac]
    _ = ((selectedTypedCoreFiberCartesianLift first
          ((selectedTypedCoreFiberReindexFunctor second).obj
            ((selectedTypedCoreFiberReindexFunctor third).obj targetPackage))).hom ≫
        (selectedTypedCoreFiberCartesianLift second
          ((selectedTypedCoreFiberReindexFunctor third).obj targetPackage)).hom) ≫
          (selectedTypedCoreFiberCartesianLift third targetPackage).hom := rfl
    _ = _ := Category.assoc _ _ _

/-- The right compositor route factors the same fixed direct lift as the triple lift. -/
theorem selectedCoreFiberReindexAssocRightRoute_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {firstObject secondObject thirdObject fourthObject : FiniteInstanceCode U}
    (first : CartPresentationBetween firstObject secondObject)
    (second : CartPresentationBetween secondObject thirdObject)
    (third : CartPresentationBetween thirdObject fourthObject)
    (targetPackage : CoreFiber fourthObject.toSemantic) :
    (selectedCoreFiberReindexAssocRightRoute
        first second third targetPackage).1 ≫
        (selectedTypedCoreFiberCartesianLift
          (compPresentation (compPresentation first second) third)
          targetPackage).hom =
      selectedCoreFiberTripleIteratedLift first second third targetPackage := by
  let assocEq := selectedCoreFiberReindex_assoc_base_eq first second third
  change
    (((selectedTypedCoreFiberReindexFunctor first).map
        (selectedCoreFiberReindexCompositorApp
          second third targetPackage).hom).1 ≫
      (selectedCoreFiberRelativeCompositorApp
        (compPresentation (compPresentation first second) third)
        first (compPresentation second third) assocEq targetPackage).hom.1) ≫
        (selectedTypedCoreFiberCartesianLift
          (compPresentation (compPresentation first second) third)
          targetPackage).hom =
      (selectedTypedCoreFiberCartesianLift first
        ((selectedTypedCoreFiberReindexFunctor second).obj
          ((selectedTypedCoreFiberReindexFunctor third).obj targetPackage))).hom ≫
        ((selectedTypedCoreFiberCartesianLift second
          ((selectedTypedCoreFiberReindexFunctor third).obj targetPackage)).hom ≫
          (selectedTypedCoreFiberCartesianLift third targetPackage).hom)
  calc
    _ = ((selectedTypedCoreFiberReindexFunctor first).map
          (selectedCoreFiberReindexCompositorApp
            second third targetPackage).hom).1 ≫
        ((selectedCoreFiberRelativeCompositorApp
          (compPresentation (compPresentation first second) third)
          first (compPresentation second third) assocEq targetPackage).hom.1 ≫
          (selectedTypedCoreFiberCartesianLift
            (compPresentation (compPresentation first second) third)
            targetPackage).hom) :=
      Category.assoc _ _ _
    _ = ((selectedTypedCoreFiberReindexFunctor first).map
          (selectedCoreFiberReindexCompositorApp
            second third targetPackage).hom).1 ≫
        (selectedCoreFiberRelativeIteratedCartesianLift
          (compPresentation (compPresentation first second) third)
          first (compPresentation second third) assocEq targetPackage).hom := by
      rw [selectedCoreFiberRelativeCompositorApp_hom_fac]
    _ = ((selectedTypedCoreFiberReindexFunctor first).map
          (selectedCoreFiberReindexCompositorApp
            second third targetPackage).hom).1 ≫
        ((selectedTypedCoreFiberCartesianLift first
          ((selectedTypedCoreFiberReindexFunctor
            (compPresentation second third)).obj targetPackage)).hom ≫
          (selectedTypedCoreFiberCartesianLift
            (compPresentation second third) targetPackage).hom) := rfl
    _ = (((selectedTypedCoreFiberReindexFunctor first).map
          (selectedCoreFiberReindexCompositorApp
            second third targetPackage).hom).1 ≫
        (selectedTypedCoreFiberCartesianLift first
          ((selectedTypedCoreFiberReindexFunctor
            (compPresentation second third)).obj targetPackage)).hom) ≫
          (selectedTypedCoreFiberCartesianLift
            (compPresentation second third) targetPackage).hom :=
      (Category.assoc _ _ _).symm
    _ = ((selectedTypedCoreFiberCartesianLift first
          ((selectedTypedCoreFiberReindexFunctor third ⋙
            selectedTypedCoreFiberReindexFunctor second).obj
              targetPackage)).hom ≫
        (selectedCoreFiberReindexCompositorApp
          second third targetPackage).hom.1) ≫
          (selectedTypedCoreFiberCartesianLift
            (compPresentation second third) targetPackage).hom := by
      rw [selectedTypedCoreFiberReindexFunctor_map_fac]
    _ = (selectedTypedCoreFiberCartesianLift first
          ((selectedTypedCoreFiberReindexFunctor second).obj
            ((selectedTypedCoreFiberReindexFunctor third).obj targetPackage))).hom ≫
        ((selectedCoreFiberReindexCompositorApp
          second third targetPackage).hom.1 ≫
          (selectedTypedCoreFiberCartesianLift
            (compPresentation second third) targetPackage).hom) :=
      Category.assoc _ _ _
    _ = (selectedTypedCoreFiberCartesianLift first
          ((selectedTypedCoreFiberReindexFunctor second).obj
            ((selectedTypedCoreFiberReindexFunctor third).obj targetPackage))).hom ≫
        (selectedCoreFiberIteratedCartesianLift
          second third targetPackage).hom := by
      rw [selectedCoreFiberReindexCompositorApp_hom_fac]
    _ = _ := rfl

/-- Constructor-relative associativity of the two actual contravariant routes. -/
theorem selectedCoreFiberReindexCompositor_assoc
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {firstObject secondObject thirdObject fourthObject : FiniteInstanceCode U}
    (first : CartPresentationBetween firstObject secondObject)
    (second : CartPresentationBetween secondObject thirdObject)
    (third : CartPresentationBetween thirdObject fourthObject)
    (targetPackage : CoreFiber fourthObject.toSemantic) :
    selectedCoreFiberReindexAssocLeftRoute first second third targetPackage =
      selectedCoreFiberReindexAssocRightRoute first second third targetPackage := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let directLift := selectedTypedCoreFiberCartesianLift
    (compPresentation (compPresentation first second) third) targetPackage
  letI := directLift.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U)
    (typedCartSemanticInput
      (compPresentation (compPresentation first second) third)).hom
    directLift.hom (𝟙 firstObject.toSemantic)
  change
    (selectedCoreFiberReindexAssocLeftRoute
      first second third targetPackage).1 ≫ directLift.hom =
      (selectedCoreFiberReindexAssocRightRoute
        first second third targetPackage).1 ≫ directLift.hom
  rw [selectedCoreFiberReindexAssocLeftRoute_fac,
    selectedCoreFiberReindexAssocRightRoute_fac]

/-! ## Constructor-relative unit coherence -/

/-- The semantic left-unit equality used by the relative comparison. -/
private theorem selectedCoreFiberReindex_left_unit_base_eq
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target) :
    (typedCartSemanticInput presentation).hom =
      (typedCartSemanticInput (idTypedPresentation source)).hom ≫
        (typedCartSemanticInput presentation).hom := by
  calc
    _ = 𝟙 source.toSemantic ≫
        (typedCartSemanticInput presentation).hom :=
      (Category.id_comp _).symm
    _ = _ := by
      have hid :
          (typedCartSemanticInput (idTypedPresentation source)).hom =
            𝟙 source.toSemantic :=
        typedRealizableHom_id_hom source
      rw [hid]

/-- The semantic right-unit equality used by the relative comparison. -/
private theorem selectedCoreFiberReindex_right_unit_base_eq
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target) :
    (typedCartSemanticInput presentation).hom =
      (typedCartSemanticInput presentation).hom ≫
        (typedCartSemanticInput (idTypedPresentation target)).hom := by
  calc
    _ = (typedCartSemanticInput presentation).hom ≫
        𝟙 target.toSemantic := (Category.comp_id _).symm
    _ = _ := by
      have hid :
          (typedCartSemanticInput (idTypedPresentation target)).hom =
            𝟙 target.toSemantic :=
        typedRealizableHom_id_hom target
      rw [hid]

/-- Source-identity unitor followed by the relative compositor. -/
noncomputable def selectedCoreFiberReindexLeftUnitRoute
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target)
    (targetPackage : CoreFiber target.toSemantic) :
    (selectedTypedCoreFiberReindexFunctor presentation).obj targetPackage ⟶
      (selectedTypedCoreFiberReindexFunctor presentation).obj targetPackage :=
  (selectedCoreFiberReindexUnitorApp source
    ((selectedTypedCoreFiberReindexFunctor presentation).obj targetPackage)).hom ≫
    (selectedCoreFiberRelativeCompositorApp presentation
      (idTypedPresentation source) presentation
      (selectedCoreFiberReindex_left_unit_base_eq presentation)
      targetPackage).hom

/-- Target-identity unitor transported by reindexing, then the relative compositor. -/
noncomputable def selectedCoreFiberReindexRightUnitRoute
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target)
    (targetPackage : CoreFiber target.toSemantic) :
    (selectedTypedCoreFiberReindexFunctor presentation).obj targetPackage ⟶
      (selectedTypedCoreFiberReindexFunctor presentation).obj targetPackage :=
  (selectedTypedCoreFiberReindexFunctor presentation).map
      (selectedCoreFiberReindexUnitorApp target targetPackage).hom ≫
    (selectedCoreFiberRelativeCompositorApp presentation presentation
      (idTypedPresentation target)
      (selectedCoreFiberReindex_right_unit_base_eq presentation)
      targetPackage).hom

/-- The left unit route factors to the original selected lift. -/
theorem selectedCoreFiberReindexLeftUnitRoute_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target)
    (targetPackage : CoreFiber target.toSemantic) :
    (selectedCoreFiberReindexLeftUnitRoute presentation targetPackage).1 ≫
        (selectedTypedCoreFiberCartesianLift presentation targetPackage).hom =
      (selectedTypedCoreFiberCartesianLift presentation targetPackage).hom := by
  let unitEq := selectedCoreFiberReindex_left_unit_base_eq presentation
  change
    ((selectedCoreFiberReindexUnitorApp source
        ((selectedTypedCoreFiberReindexFunctor presentation).obj
          targetPackage)).hom.1 ≫
      (selectedCoreFiberRelativeCompositorApp presentation
        (idTypedPresentation source) presentation unitEq
        targetPackage).hom.1) ≫
        (selectedTypedCoreFiberCartesianLift presentation targetPackage).hom =
      (selectedTypedCoreFiberCartesianLift presentation targetPackage).hom
  calc
    _ = (selectedCoreFiberReindexUnitorApp source
          ((selectedTypedCoreFiberReindexFunctor presentation).obj
            targetPackage)).hom.1 ≫
        ((selectedCoreFiberRelativeCompositorApp presentation
          (idTypedPresentation source) presentation unitEq
          targetPackage).hom.1 ≫
          (selectedTypedCoreFiberCartesianLift presentation
            targetPackage).hom) :=
      Category.assoc _ _ _
    _ = (selectedCoreFiberReindexUnitorApp source
          ((selectedTypedCoreFiberReindexFunctor presentation).obj
            targetPackage)).hom.1 ≫
        (selectedCoreFiberRelativeIteratedCartesianLift presentation
          (idTypedPresentation source) presentation unitEq
          targetPackage).hom := by
      rw [selectedCoreFiberRelativeCompositorApp_hom_fac]
    _ = (selectedCoreFiberReindexUnitorApp source
          ((selectedTypedCoreFiberReindexFunctor presentation).obj
            targetPackage)).hom.1 ≫
        ((selectedTypedCoreFiberCartesianLift (idTypedPresentation source)
          ((selectedTypedCoreFiberReindexFunctor presentation).obj
            targetPackage)).hom ≫
          (selectedTypedCoreFiberCartesianLift presentation
            targetPackage).hom) := rfl
    _ = ((selectedCoreFiberReindexUnitorApp source
          ((selectedTypedCoreFiberReindexFunctor presentation).obj
            targetPackage)).hom.1 ≫
        (selectedTypedCoreFiberCartesianLift (idTypedPresentation source)
          ((selectedTypedCoreFiberReindexFunctor presentation).obj
            targetPackage)).hom) ≫
          (selectedTypedCoreFiberCartesianLift presentation
            targetPackage).hom := (Category.assoc _ _ _).symm
    _ = 𝟙 ((selectedTypedCoreFiberReindexFunctor presentation).obj
          targetPackage).1 ≫
        (selectedTypedCoreFiberCartesianLift presentation
          targetPackage).hom := by
      rw [selectedCoreFiberReindexUnitorApp_hom_fac]
    _ = _ := Category.id_comp _

/-- The right unit route factors to the original selected lift. -/
theorem selectedCoreFiberReindexRightUnitRoute_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target)
    (targetPackage : CoreFiber target.toSemantic) :
    (selectedCoreFiberReindexRightUnitRoute presentation targetPackage).1 ≫
        (selectedTypedCoreFiberCartesianLift presentation targetPackage).hom =
