  calc
    _ = ((selectedTypedCoreFiberReindexFunctor presentation).map
          (selectedCoreFiberReindexUnitorApp target targetPackage).hom).1 ≫
        ((selectedCoreFiberRelativeCompositorApp presentation presentation
          (idTypedPresentation target) unitEq targetPackage).hom.1 ≫
          (selectedTypedCoreFiberCartesianLift presentation
            targetPackage).hom) := Category.assoc _ _ _
    _ = ((selectedTypedCoreFiberReindexFunctor presentation).map
          (selectedCoreFiberReindexUnitorApp target targetPackage).hom).1 ≫
        (selectedCoreFiberRelativeIteratedCartesianLift presentation
          presentation (idTypedPresentation target) unitEq
          targetPackage).hom := by
      rw [selectedCoreFiberRelativeCompositorApp_hom_fac]
    _ = ((selectedTypedCoreFiberReindexFunctor presentation).map
          (selectedCoreFiberReindexUnitorApp target targetPackage).hom).1 ≫
        ((selectedTypedCoreFiberCartesianLift presentation
          ((selectedTypedCoreFiberReindexFunctor
            (idTypedPresentation target)).obj targetPackage)).hom ≫
          (selectedTypedCoreFiberCartesianLift
            (idTypedPresentation target) targetPackage).hom) := rfl
    _ = (((selectedTypedCoreFiberReindexFunctor presentation).map
          (selectedCoreFiberReindexUnitorApp target targetPackage).hom).1 ≫
        (selectedTypedCoreFiberCartesianLift presentation
          ((selectedTypedCoreFiberReindexFunctor
            (idTypedPresentation target)).obj targetPackage)).hom) ≫
          (selectedTypedCoreFiberCartesianLift
            (idTypedPresentation target) targetPackage).hom :=
      (Category.assoc _ _ _).symm
    _ = ((selectedTypedCoreFiberCartesianLift presentation targetPackage).hom ≫
        (selectedCoreFiberReindexUnitorApp target targetPackage).hom.1) ≫
          (selectedTypedCoreFiberCartesianLift
            (idTypedPresentation target) targetPackage).hom := by
      rw [selectedTypedCoreFiberReindexFunctor_map_fac]
    _ = (selectedTypedCoreFiberCartesianLift presentation targetPackage).hom ≫
        ((selectedCoreFiberReindexUnitorApp target targetPackage).hom.1 ≫
          (selectedTypedCoreFiberCartesianLift
