import ResearchLean.AG.DoctrineFiberProduct.ExactBottomGlobalLift
import ResearchLean.AG.DoctrineFiberProduct.ExactBottomCoverageSchema
import ResearchLean.AG.DoctrineFiberProduct.CartesianRegimeReindexingCleavage

/-!
# G-112 semantic-global cartesian coherence

This module derives contravariant core-fiber reindexing and its coherence from
the unrestricted semantic-global lift fixed in G-112(c).  The cleavage has no
realization, finiteness, coverage, or presentation premise.  Its maps, unitor,
compositor, and coherence equations are generated by the strong-cartesian
universal property.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open CategoryTheory
open AtomFoundation
open CrossStageCoherence

set_option maxHeartbeats 3000000

/-! ## Semantic-global cleavage and reindexing -/

/-- The caller-free cleavage selected from the G-112(c) semantic-global witness. -/
noncomputable def exact_bottom_semantic_global_cartesian_cleavage
    {U : AtomCarrier.{u}} {source target : ExtractionInstance U}
    (hom : source ⟶ target) :
    CoreFiberCartesianCleavage (cartSemanticInputOfHom hom) where
  lift := fun targetPackage =>
    Classical.choice
      (exact_bottom_semantic_global_strong_cartesian_lift
        (cartSemanticInputOfHom hom) targetPackage)

/-- The contravariant reindexing functor generated by the semantic-global cleavage. -/
noncomputable def exact_bottom_semantic_global_reindex_functor
    {U : AtomCarrier.{u}} {source target : ExtractionInstance U}
    (hom : source ⟶ target) : CoreFiber target ⥤ CoreFiber source :=
  (exact_bottom_semantic_global_cartesian_cleavage hom).reindexFunctor

/-- The selected lift used by semantic-global reindexing. -/
noncomputable def exact_bottom_semantic_global_selected_lift
    {U : AtomCarrier.{u}} {source target : ExtractionInstance U}
    (hom : source ⟶ target) (targetPackage : CoreFiber target) :
    StrongCartesianLift (cartSemanticInputOfHom hom) targetPackage :=
  (exact_bottom_semantic_global_cartesian_cleavage hom).lift targetPackage

/-- The selected reindexing map satisfies its cartesian factor graph. -/
theorem exact_bottom_semantic_global_reindex_map_fac
    {U : AtomCarrier.{u}} {source target : ExtractionInstance U}
    (hom : source ⟶ target) {first second : CoreFiber target}
    (vertical : first ⟶ second) :
    ((exact_bottom_semantic_global_reindex_functor hom).map vertical).1 ≫
        (exact_bottom_semantic_global_selected_lift hom second).hom =
      (exact_bottom_semantic_global_selected_lift hom first).hom ≫ vertical.1 :=
  (exact_bottom_semantic_global_cartesian_cleavage hom).reindexFunctor_map_fac
    vertical

/-! ## Composition compositor -/

/-- The literal two-step semantic-global cartesian lift. -/
noncomputable def exact_bottom_semantic_global_iterated_lift
    {U : AtomCarrier.{u}}
    {source middle target : ExtractionInstance U}
    (first : source ⟶ middle) (second : middle ⟶ target)
    (targetPackage : CoreFiber target) :
    StrongCartesianLift (cartSemanticInputOfHom (first ≫ second))
      targetPackage where
  domain := (exact_bottom_semantic_global_selected_lift first
    ((exact_bottom_semantic_global_reindex_functor second).obj
      targetPackage)).domain
  hom := (exact_bottom_semantic_global_selected_lift first
      ((exact_bottom_semantic_global_reindex_functor second).obj
        targetPackage)).hom ≫
    (exact_bottom_semantic_global_selected_lift second targetPackage).hom
  isStronglyCartesian := by
    letI : (packageProjection U).IsStronglyCartesian first
        (exact_bottom_semantic_global_selected_lift first
      ((exact_bottom_semantic_global_reindex_functor second).obj
        targetPackage)).hom :=
      (exact_bottom_semantic_global_selected_lift first
        ((exact_bottom_semantic_global_reindex_functor second).obj
          targetPackage)).isStronglyCartesian
    letI : (packageProjection U).IsStronglyCartesian second
        (exact_bottom_semantic_global_selected_lift second targetPackage).hom :=
      (exact_bottom_semantic_global_selected_lift second
        targetPackage).isStronglyCartesian
    exact CategoryTheory.Functor.IsStronglyCartesian.comp
      (packageProjection U)

/-- The cleavage whose lift is the actual two-step composite. -/
noncomputable def exact_bottom_semantic_global_iterated_cleavage
    {U : AtomCarrier.{u}}
    {source middle target : ExtractionInstance U}
    (first : source ⟶ middle) (second : middle ⟶ target) :
    CoreFiberCartesianCleavage
      (cartSemanticInputOfHom (first ≫ second)) where
  lift := exact_bottom_semantic_global_iterated_lift first second

/-- The compositor component from iterated reindexing to direct reindexing. -/
noncomputable def exact_bottom_semantic_global_compositor_app
    {U : AtomCarrier.{u}}
    {source middle target : ExtractionInstance U}
    (first : source ⟶ middle) (second : middle ⟶ target)
    (targetPackage : CoreFiber target) :
    (exact_bottom_semantic_global_reindex_functor second ⋙
      exact_bottom_semantic_global_reindex_functor first).obj targetPackage ≅
      (exact_bottom_semantic_global_reindex_functor
        (first ≫ second)).obj targetPackage := by
  simpa only [exact_bottom_semantic_global_reindex_functor,
    CoreFiberCartesianCleavage.reindexFunctor_obj,
    exact_bottom_semantic_global_iterated_cleavage,
    exact_bottom_semantic_global_iterated_lift,
    exact_bottom_semantic_global_selected_lift] using
    CoreFiberCartesianCleavage.comparisonApp
      (exact_bottom_semantic_global_iterated_cleavage first second)
      (exact_bottom_semantic_global_cartesian_cleavage (first ≫ second))
      targetPackage

/-- The compositor component has the literal two-step factor triangle. -/
theorem exact_bottom_semantic_global_compositor_app_hom_fac
    {U : AtomCarrier.{u}}
    {source middle target : ExtractionInstance U}
    (first : source ⟶ middle) (second : middle ⟶ target)
    (targetPackage : CoreFiber target) :
    (exact_bottom_semantic_global_compositor_app first second
      targetPackage).hom.1 ≫
        (exact_bottom_semantic_global_selected_lift
          (first ≫ second) targetPackage).hom =
      (exact_bottom_semantic_global_iterated_lift first second
        targetPackage).hom := by
  simpa only [exact_bottom_semantic_global_compositor_app,
    exact_bottom_semantic_global_iterated_cleavage,
    exact_bottom_semantic_global_selected_lift] using
    CoreFiberCartesianCleavage.comparisonApp_hom_fac
      (exact_bottom_semantic_global_iterated_cleavage first second)
      (exact_bottom_semantic_global_cartesian_cleavage (first ≫ second))
      targetPackage

/-- The iterated reindexing map has the literal two-step factor graph. -/
theorem exact_bottom_semantic_global_iterated_map_fac
    {U : AtomCarrier.{u}}
    {source middle target : ExtractionInstance U}
    (first : source ⟶ middle) (second : middle ⟶ target)
    {sourcePackage targetPackage : CoreFiber target}
    (vertical : sourcePackage ⟶ targetPackage) :
    ((exact_bottom_semantic_global_reindex_functor second ⋙
      exact_bottom_semantic_global_reindex_functor first).map vertical).1 ≫
        (exact_bottom_semantic_global_iterated_lift first second
          targetPackage).hom =
      (exact_bottom_semantic_global_iterated_lift first second
        sourcePackage).hom ≫ vertical.1 := by
  change
    ((exact_bottom_semantic_global_reindex_functor first).map
      ((exact_bottom_semantic_global_reindex_functor second).map vertical)).1 ≫
      ((exact_bottom_semantic_global_selected_lift first
        ((exact_bottom_semantic_global_reindex_functor second).obj
          targetPackage)).hom ≫
        (exact_bottom_semantic_global_selected_lift second targetPackage).hom) =
    ((exact_bottom_semantic_global_selected_lift first
      ((exact_bottom_semantic_global_reindex_functor second).obj
        sourcePackage)).hom ≫
      (exact_bottom_semantic_global_selected_lift second sourcePackage).hom) ≫
      vertical.1
  calc
    _ = (((exact_bottom_semantic_global_reindex_functor first).map
          ((exact_bottom_semantic_global_reindex_functor second).map
            vertical)).1 ≫
        (exact_bottom_semantic_global_selected_lift first
          ((exact_bottom_semantic_global_reindex_functor second).obj
            targetPackage)).hom) ≫
        (exact_bottom_semantic_global_selected_lift second targetPackage).hom :=
      (Category.assoc _ _ _).symm
    _ = ((exact_bottom_semantic_global_selected_lift first
          ((exact_bottom_semantic_global_reindex_functor second).obj
            sourcePackage)).hom ≫
        ((exact_bottom_semantic_global_reindex_functor second).map
          vertical).1) ≫
        (exact_bottom_semantic_global_selected_lift second targetPackage).hom := by
      rw [exact_bottom_semantic_global_reindex_map_fac]
    _ = (exact_bottom_semantic_global_selected_lift first
          ((exact_bottom_semantic_global_reindex_functor second).obj
            sourcePackage)).hom ≫
        (((exact_bottom_semantic_global_reindex_functor second).map
          vertical).1 ≫
          (exact_bottom_semantic_global_selected_lift second
            targetPackage).hom) := Category.assoc _ _ _
    _ = (exact_bottom_semantic_global_selected_lift first
          ((exact_bottom_semantic_global_reindex_functor second).obj
            sourcePackage)).hom ≫
        ((exact_bottom_semantic_global_selected_lift second
          sourcePackage).hom ≫ vertical.1) := by
      rw [exact_bottom_semantic_global_reindex_map_fac]
    _ = _ := (Category.assoc _ _ _).symm

/-- The compositor components are natural on every vertical map. -/
theorem exact_bottom_semantic_global_compositor_naturality
    {U : AtomCarrier.{u}}
    {source middle target : ExtractionInstance U}
    (first : source ⟶ middle) (second : middle ⟶ target)
    {sourcePackage targetPackage : CoreFiber target}
    (vertical : sourcePackage ⟶ targetPackage) :
    (exact_bottom_semantic_global_reindex_functor second ⋙
        exact_bottom_semantic_global_reindex_functor first).map vertical ≫
      (exact_bottom_semantic_global_compositor_app first second
        targetPackage).hom =
      (exact_bottom_semantic_global_compositor_app first second
        sourcePackage).hom ≫
      (exact_bottom_semantic_global_reindex_functor
        (first ≫ second)).map vertical := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let directTarget := exact_bottom_semantic_global_selected_lift
    (first ≫ second) targetPackage
  letI : (packageProjection U).IsStronglyCartesian (first ≫ second)
      directTarget.hom := directTarget.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U) (first ≫ second) directTarget.hom (𝟙 source)
  change
    (((exact_bottom_semantic_global_reindex_functor second ⋙
      exact_bottom_semantic_global_reindex_functor first).map vertical).1 ≫
      (exact_bottom_semantic_global_compositor_app first second
        targetPackage).hom.1) ≫ directTarget.hom =
    ((exact_bottom_semantic_global_compositor_app first second
      sourcePackage).hom.1 ≫
      ((exact_bottom_semantic_global_reindex_functor
        (first ≫ second)).map vertical).1) ≫ directTarget.hom
  calc
    _ = ((exact_bottom_semantic_global_reindex_functor second ⋙
          exact_bottom_semantic_global_reindex_functor first).map vertical).1 ≫
        ((exact_bottom_semantic_global_compositor_app first second
          targetPackage).hom.1 ≫ directTarget.hom) := Category.assoc _ _ _
    _ = ((exact_bottom_semantic_global_reindex_functor second ⋙
          exact_bottom_semantic_global_reindex_functor first).map vertical).1 ≫
        (exact_bottom_semantic_global_iterated_lift first second
          targetPackage).hom := by
      rw [exact_bottom_semantic_global_compositor_app_hom_fac]
    _ = (exact_bottom_semantic_global_iterated_lift first second
          sourcePackage).hom ≫ vertical.1 :=
      exact_bottom_semantic_global_iterated_map_fac first second vertical
    _ = ((exact_bottom_semantic_global_compositor_app first second
          sourcePackage).hom.1 ≫
        (exact_bottom_semantic_global_selected_lift
          (first ≫ second) sourcePackage).hom) ≫ vertical.1 := by
      rw [exact_bottom_semantic_global_compositor_app_hom_fac]
    _ = (exact_bottom_semantic_global_compositor_app first second
          sourcePackage).hom.1 ≫
        ((exact_bottom_semantic_global_selected_lift
          (first ≫ second) sourcePackage).hom ≫ vertical.1) :=
      Category.assoc _ _ _
    _ = (exact_bottom_semantic_global_compositor_app first second
          sourcePackage).hom.1 ≫
        (((exact_bottom_semantic_global_reindex_functor
          (first ≫ second)).map vertical).1 ≫ directTarget.hom) := by
      rw [exact_bottom_semantic_global_reindex_map_fac]
    _ = _ := (Category.assoc _ _ _).symm

/-- The natural semantic-global contravariant compositor. -/
noncomputable def exact_bottom_semantic_global_compositor
    {U : AtomCarrier.{u}}
    {source middle target : ExtractionInstance U}
    (first : source ⟶ middle) (second : middle ⟶ target) :
    exact_bottom_semantic_global_reindex_functor second ⋙
        exact_bottom_semantic_global_reindex_functor first ≅
      exact_bottom_semantic_global_reindex_functor (first ≫ second) :=
  NatIso.ofComponents
    (exact_bottom_semantic_global_compositor_app first second)
    (fun vertical =>
      exact_bottom_semantic_global_compositor_naturality
        first second vertical)

/-! ## Identity unitor -/

/-- The literal identity cartesian lift. -/
noncomputable def exact_bottom_semantic_global_identity_lift
    {U : AtomCarrier.{u}} (object : ExtractionInstance U)
    (targetPackage : CoreFiber object) :
    StrongCartesianLift (cartSemanticInputOfHom (𝟙 object))
      targetPackage where
  domain := targetPackage.1
  hom := 𝟙 targetPackage.1
  isStronglyCartesian := by
    letI : (packageProjection U).IsHomLift
        (𝟙 object) (𝟙 targetPackage.1) :=
      CategoryTheory.IsHomLift.id targetPackage.2
    exact CategoryTheory.Functor.IsStronglyCartesian.of_isIso
      (packageProjection U) (𝟙 object) (𝟙 targetPackage.1)

/-- The literal identity lift family. -/
noncomputable def exact_bottom_semantic_global_identity_cleavage
    {U : AtomCarrier.{u}} (object : ExtractionInstance U) :
    CoreFiberCartesianCleavage (cartSemanticInputOfHom (𝟙 object)) where
  lift := exact_bottom_semantic_global_identity_lift object

/-- The unitor component from a fiber object to its selected identity reindexing. -/
noncomputable def exact_bottom_semantic_global_unitor_app
    {U : AtomCarrier.{u}} (object : ExtractionInstance U)
    (targetPackage : CoreFiber object) :
    targetPackage ≅
      (exact_bottom_semantic_global_reindex_functor
        (𝟙 object)).obj targetPackage := by
  simpa only [exact_bottom_semantic_global_reindex_functor,
    CoreFiberCartesianCleavage.reindexFunctor_obj,
    exact_bottom_semantic_global_identity_cleavage,
    exact_bottom_semantic_global_identity_lift,
    exact_bottom_semantic_global_selected_lift] using
    CoreFiberCartesianCleavage.comparisonApp
      (exact_bottom_semantic_global_identity_cleavage object)
      (exact_bottom_semantic_global_cartesian_cleavage (𝟙 object))
      targetPackage

/-- The unitor component followed by the selected identity lift is identity. -/
theorem exact_bottom_semantic_global_unitor_app_hom_fac
    {U : AtomCarrier.{u}} (object : ExtractionInstance U)
    (targetPackage : CoreFiber object) :
    (exact_bottom_semantic_global_unitor_app object targetPackage).hom.1 ≫
        (exact_bottom_semantic_global_selected_lift
          (𝟙 object) targetPackage).hom = 𝟙 targetPackage.1 := by
  simpa only [exact_bottom_semantic_global_unitor_app,
    exact_bottom_semantic_global_identity_cleavage,
    exact_bottom_semantic_global_identity_lift,
    exact_bottom_semantic_global_selected_lift] using
    CoreFiberCartesianCleavage.comparisonApp_hom_fac
      (exact_bottom_semantic_global_identity_cleavage object)
      (exact_bottom_semantic_global_cartesian_cleavage (𝟙 object))
      targetPackage

/-- The unitor components are natural on vertical maps. -/
theorem exact_bottom_semantic_global_unitor_naturality
    {U : AtomCarrier.{u}} (object : ExtractionInstance U)
    {sourcePackage targetPackage : CoreFiber object}
    (vertical : sourcePackage ⟶ targetPackage) :
    vertical ≫
        (exact_bottom_semantic_global_unitor_app object targetPackage).hom =
      (exact_bottom_semantic_global_unitor_app object sourcePackage).hom ≫
        (exact_bottom_semantic_global_reindex_functor
          (𝟙 object)).map vertical := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let targetLift := exact_bottom_semantic_global_selected_lift
    (𝟙 object) targetPackage
  letI : (packageProjection U).IsStronglyCartesian (𝟙 object)
      targetLift.hom := targetLift.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U) (𝟙 object) targetLift.hom (𝟙 object)
  change
    (vertical.1 ≫
      (exact_bottom_semantic_global_unitor_app object targetPackage).hom.1) ≫
        targetLift.hom =
    ((exact_bottom_semantic_global_unitor_app object sourcePackage).hom.1 ≫
      ((exact_bottom_semantic_global_reindex_functor
        (𝟙 object)).map vertical).1) ≫ targetLift.hom
  calc
    _ = vertical.1 ≫
        ((exact_bottom_semantic_global_unitor_app object
          targetPackage).hom.1 ≫ targetLift.hom) := Category.assoc _ _ _
    _ = vertical.1 ≫ 𝟙 targetPackage.1 := by
      rw [exact_bottom_semantic_global_unitor_app_hom_fac]
    _ = vertical.1 := Category.comp_id _
    _ = 𝟙 sourcePackage.1 ≫ vertical.1 := (Category.id_comp _).symm
    _ = ((exact_bottom_semantic_global_unitor_app object
          sourcePackage).hom.1 ≫
        (exact_bottom_semantic_global_selected_lift
          (𝟙 object) sourcePackage).hom) ≫ vertical.1 := by
      rw [exact_bottom_semantic_global_unitor_app_hom_fac]
    _ = (exact_bottom_semantic_global_unitor_app object
          sourcePackage).hom.1 ≫
        ((exact_bottom_semantic_global_selected_lift
          (𝟙 object) sourcePackage).hom ≫ vertical.1) :=
      Category.assoc _ _ _
    _ = (exact_bottom_semantic_global_unitor_app object
          sourcePackage).hom.1 ≫
        (((exact_bottom_semantic_global_reindex_functor
          (𝟙 object)).map vertical).1 ≫ targetLift.hom) := by
      rw [exact_bottom_semantic_global_reindex_map_fac]
    _ = _ := (Category.assoc _ _ _).symm

/-- The natural semantic-global identity unitor. -/
noncomputable def exact_bottom_semantic_global_unitor
    {U : AtomCarrier.{u}} (object : ExtractionInstance U) :
    𝟭 (CoreFiber object) ≅
      exact_bottom_semantic_global_reindex_functor (𝟙 object) :=
  NatIso.ofComponents (exact_bottom_semantic_global_unitor_app object)
    (fun vertical =>
      exact_bottom_semantic_global_unitor_naturality object vertical)

/-! ## Equality transport -/

/-- Object transport induced by equality of semantic base arrows. -/
noncomputable def exact_bottom_semantic_global_reindex_eq_cast
    {U : AtomCarrier.{u}} {source target : ExtractionInstance U}
    {first second : source ⟶ target} (equality : first = second)
    (targetPackage : CoreFiber target) :
    (exact_bottom_semantic_global_reindex_functor first).obj targetPackage ⟶
      (exact_bottom_semantic_global_reindex_functor second).obj targetPackage :=
  eqToHom (congrArg
    (fun hom =>
      (exact_bottom_semantic_global_reindex_functor hom).obj targetPackage)
    equality)

/-- Equality transport carries the second selected lift back to the first. -/
theorem exact_bottom_semantic_global_reindex_eq_cast_fac
    {U : AtomCarrier.{u}} {source target : ExtractionInstance U}
    {first second : source ⟶ target} (equality : first = second)
    (targetPackage : CoreFiber target) :
    (exact_bottom_semantic_global_reindex_eq_cast equality targetPackage).1 ≫
        (exact_bottom_semantic_global_selected_lift second targetPackage).hom =
      (exact_bottom_semantic_global_selected_lift first targetPackage).hom := by
  cases equality
  exact Category.id_comp _

/-! ## Pentagon coherence -/

/-- The literal three-step cartesian lift hom. -/
noncomputable def exact_bottom_semantic_global_triple_lift
    {U : AtomCarrier.{u}}
    {firstObject secondObject thirdObject fourthObject : ExtractionInstance U}
    (first : firstObject ⟶ secondObject)
    (second : secondObject ⟶ thirdObject)
    (third : thirdObject ⟶ fourthObject)
    (targetPackage : CoreFiber fourthObject) :
    ((exact_bottom_semantic_global_reindex_functor first).obj
      ((exact_bottom_semantic_global_reindex_functor second).obj
        ((exact_bottom_semantic_global_reindex_functor third).obj
          targetPackage))).1 ⟶ targetPackage.1 :=
  (exact_bottom_semantic_global_selected_lift first
      ((exact_bottom_semantic_global_reindex_functor second).obj
        ((exact_bottom_semantic_global_reindex_functor third).obj
          targetPackage))).hom ≫
    ((exact_bottom_semantic_global_selected_lift second
      ((exact_bottom_semantic_global_reindex_functor third).obj
        targetPackage)).hom ≫
      (exact_bottom_semantic_global_selected_lift third targetPackage).hom)

/-- The left-associated compositor route. -/
noncomputable def exact_bottom_semantic_global_pentagon_left_route
    {U : AtomCarrier.{u}}
    {firstObject secondObject thirdObject fourthObject : ExtractionInstance U}
    (first : firstObject ⟶ secondObject)
    (second : secondObject ⟶ thirdObject)
    (third : thirdObject ⟶ fourthObject)
    (targetPackage : CoreFiber fourthObject) :
    (exact_bottom_semantic_global_reindex_functor first).obj
      ((exact_bottom_semantic_global_reindex_functor second).obj
        ((exact_bottom_semantic_global_reindex_functor third).obj
          targetPackage)) ⟶
      (exact_bottom_semantic_global_reindex_functor
        ((first ≫ second) ≫ third)).obj targetPackage :=
  (exact_bottom_semantic_global_compositor_app first second
      ((exact_bottom_semantic_global_reindex_functor third).obj
        targetPackage)).hom ≫
    (exact_bottom_semantic_global_compositor_app
      (first ≫ second) third targetPackage).hom

/-- The right-associated compositor route, normalized to the left-associated base arrow. -/
noncomputable def exact_bottom_semantic_global_pentagon_right_route
    {U : AtomCarrier.{u}}
    {firstObject secondObject thirdObject fourthObject : ExtractionInstance U}
    (first : firstObject ⟶ secondObject)
    (second : secondObject ⟶ thirdObject)
    (third : thirdObject ⟶ fourthObject)
    (targetPackage : CoreFiber fourthObject) :
    (exact_bottom_semantic_global_reindex_functor first).obj
      ((exact_bottom_semantic_global_reindex_functor second).obj
        ((exact_bottom_semantic_global_reindex_functor third).obj
          targetPackage)) ⟶
      (exact_bottom_semantic_global_reindex_functor
        ((first ≫ second) ≫ third)).obj targetPackage :=
  (exact_bottom_semantic_global_reindex_functor first).map
      (exact_bottom_semantic_global_compositor_app second third
        targetPackage).hom ≫
    (exact_bottom_semantic_global_compositor_app first (second ≫ third)
      targetPackage).hom ≫
    exact_bottom_semantic_global_reindex_eq_cast
      (Category.assoc first second third).symm targetPackage

/-- The left pentagon route factors the direct lift as the triple lift. -/
theorem exact_bottom_semantic_global_pentagon_left_route_fac
    {U : AtomCarrier.{u}}
    {firstObject secondObject thirdObject fourthObject : ExtractionInstance U}
    (first : firstObject ⟶ secondObject)
    (second : secondObject ⟶ thirdObject)
    (third : thirdObject ⟶ fourthObject)
    (targetPackage : CoreFiber fourthObject) :
    (exact_bottom_semantic_global_pentagon_left_route first second third
      targetPackage).1 ≫
      (exact_bottom_semantic_global_selected_lift
        ((first ≫ second) ≫ third) targetPackage).hom =
      exact_bottom_semantic_global_triple_lift first second third
        targetPackage := by
  change
    ((exact_bottom_semantic_global_compositor_app first second
        ((exact_bottom_semantic_global_reindex_functor third).obj
          targetPackage)).hom.1 ≫
      (exact_bottom_semantic_global_compositor_app
        (first ≫ second) third targetPackage).hom.1) ≫
      (exact_bottom_semantic_global_selected_lift
        ((first ≫ second) ≫ third) targetPackage).hom = _
  calc
    _ = (exact_bottom_semantic_global_compositor_app first second
          ((exact_bottom_semantic_global_reindex_functor third).obj
            targetPackage)).hom.1 ≫
        ((exact_bottom_semantic_global_compositor_app
          (first ≫ second) third targetPackage).hom.1 ≫
          (exact_bottom_semantic_global_selected_lift
            ((first ≫ second) ≫ third) targetPackage).hom) :=
      Category.assoc _ _ _
    _ = (exact_bottom_semantic_global_compositor_app first second
          ((exact_bottom_semantic_global_reindex_functor third).obj
            targetPackage)).hom.1 ≫
        (exact_bottom_semantic_global_iterated_lift
          (first ≫ second) third targetPackage).hom := by
      rw [exact_bottom_semantic_global_compositor_app_hom_fac]
    _ = ((exact_bottom_semantic_global_compositor_app first second
          ((exact_bottom_semantic_global_reindex_functor third).obj
            targetPackage)).hom.1 ≫
        (exact_bottom_semantic_global_selected_lift (first ≫ second)
          ((exact_bottom_semantic_global_reindex_functor third).obj
            targetPackage)).hom) ≫
        (exact_bottom_semantic_global_selected_lift third
          targetPackage).hom := (Category.assoc _ _ _).symm
    _ = (exact_bottom_semantic_global_iterated_lift first second
          ((exact_bottom_semantic_global_reindex_functor third).obj
            targetPackage)).hom ≫
        (exact_bottom_semantic_global_selected_lift third
          targetPackage).hom := by
      rw [exact_bottom_semantic_global_compositor_app_hom_fac]
    _ = _ := by
      simp only [exact_bottom_semantic_global_iterated_lift,
        exact_bottom_semantic_global_triple_lift, Category.assoc]

/-- The right pentagon route factors the same direct lift as the triple lift. -/
theorem exact_bottom_semantic_global_pentagon_right_route_fac
    {U : AtomCarrier.{u}}
    {firstObject secondObject thirdObject fourthObject : ExtractionInstance U}
    (first : firstObject ⟶ secondObject)
    (second : secondObject ⟶ thirdObject)
    (third : thirdObject ⟶ fourthObject)
    (targetPackage : CoreFiber fourthObject) :
    (exact_bottom_semantic_global_pentagon_right_route first second third
      targetPackage).1 ≫
      (exact_bottom_semantic_global_selected_lift
        ((first ≫ second) ≫ third) targetPackage).hom =
      exact_bottom_semantic_global_triple_lift first second third
        targetPackage := by
  change
    ((((exact_bottom_semantic_global_reindex_functor first).map
        (exact_bottom_semantic_global_compositor_app second third
          targetPackage).hom).1 ≫
      (exact_bottom_semantic_global_compositor_app first (second ≫ third)
        targetPackage).hom.1) ≫
      (exact_bottom_semantic_global_reindex_eq_cast
        (Category.assoc first second third).symm targetPackage).1) ≫
      (exact_bottom_semantic_global_selected_lift
        ((first ≫ second) ≫ third) targetPackage).hom = _
  calc
    _ = (((exact_bottom_semantic_global_reindex_functor first).map
          (exact_bottom_semantic_global_compositor_app second third
            targetPackage).hom).1 ≫
        (exact_bottom_semantic_global_compositor_app first (second ≫ third)
          targetPackage).hom.1) ≫
        ((exact_bottom_semantic_global_reindex_eq_cast
          (Category.assoc first second third).symm targetPackage).1 ≫
          (exact_bottom_semantic_global_selected_lift
            ((first ≫ second) ≫ third) targetPackage).hom) :=
      Category.assoc _ _ _
    _ = (((exact_bottom_semantic_global_reindex_functor first).map
          (exact_bottom_semantic_global_compositor_app second third
            targetPackage).hom).1 ≫
        (exact_bottom_semantic_global_compositor_app first (second ≫ third)
          targetPackage).hom.1) ≫
        (exact_bottom_semantic_global_selected_lift
          (first ≫ (second ≫ third)) targetPackage).hom := by
      rw [exact_bottom_semantic_global_reindex_eq_cast_fac]
    _ = ((exact_bottom_semantic_global_reindex_functor first).map
          (exact_bottom_semantic_global_compositor_app second third
            targetPackage).hom).1 ≫
        ((exact_bottom_semantic_global_compositor_app first (second ≫ third)
          targetPackage).hom.1 ≫
          (exact_bottom_semantic_global_selected_lift
            (first ≫ (second ≫ third)) targetPackage).hom) :=
      Category.assoc _ _ _
    _ = ((exact_bottom_semantic_global_reindex_functor first).map
          (exact_bottom_semantic_global_compositor_app second third
            targetPackage).hom).1 ≫
        (exact_bottom_semantic_global_iterated_lift first (second ≫ third)
          targetPackage).hom := by
      rw [exact_bottom_semantic_global_compositor_app_hom_fac]
    _ = (((exact_bottom_semantic_global_reindex_functor first).map
          (exact_bottom_semantic_global_compositor_app second third
            targetPackage).hom).1 ≫
        (exact_bottom_semantic_global_selected_lift first
          ((exact_bottom_semantic_global_reindex_functor
            (second ≫ third)).obj targetPackage)).hom) ≫
        (exact_bottom_semantic_global_selected_lift (second ≫ third)
          targetPackage).hom := (Category.assoc _ _ _).symm
    _ = ((exact_bottom_semantic_global_selected_lift first
          ((exact_bottom_semantic_global_reindex_functor third ⋙
            exact_bottom_semantic_global_reindex_functor second).obj
            targetPackage)).hom ≫
        (exact_bottom_semantic_global_compositor_app second third
          targetPackage).hom.1) ≫
        (exact_bottom_semantic_global_selected_lift (second ≫ third)
          targetPackage).hom := by
      rw [exact_bottom_semantic_global_reindex_map_fac]
    _ = (exact_bottom_semantic_global_selected_lift first
          ((exact_bottom_semantic_global_reindex_functor second).obj
            ((exact_bottom_semantic_global_reindex_functor third).obj
              targetPackage))).hom ≫
        ((exact_bottom_semantic_global_compositor_app second third
          targetPackage).hom.1 ≫
          (exact_bottom_semantic_global_selected_lift (second ≫ third)
            targetPackage).hom) := Category.assoc _ _ _
    _ = (exact_bottom_semantic_global_selected_lift first
          ((exact_bottom_semantic_global_reindex_functor second).obj
            ((exact_bottom_semantic_global_reindex_functor third).obj
              targetPackage))).hom ≫
        (exact_bottom_semantic_global_iterated_lift second third
          targetPackage).hom := by
      rw [exact_bottom_semantic_global_compositor_app_hom_fac]
    _ = _ := by
      simp only [exact_bottom_semantic_global_iterated_lift,
        exact_bottom_semantic_global_triple_lift]

/-- Pentagon coherence: the two actual compositor routes agree componentwise. -/
theorem exact_bottom_semantic_global_pentagon
    {U : AtomCarrier.{u}}
    {firstObject secondObject thirdObject fourthObject : ExtractionInstance U}
    (first : firstObject ⟶ secondObject)
    (second : secondObject ⟶ thirdObject)
    (third : thirdObject ⟶ fourthObject)
    (targetPackage : CoreFiber fourthObject) :
    exact_bottom_semantic_global_pentagon_left_route first second third
        targetPackage =
      exact_bottom_semantic_global_pentagon_right_route first second third
        targetPackage := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let directLift := exact_bottom_semantic_global_selected_lift
    ((first ≫ second) ≫ third) targetPackage
  letI : (packageProjection U).IsStronglyCartesian
      ((first ≫ second) ≫ third) directLift.hom :=
    directLift.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U) ((first ≫ second) ≫ third)
    directLift.hom (𝟙 firstObject)
  change
    (exact_bottom_semantic_global_pentagon_left_route first second third
      targetPackage).1 ≫ directLift.hom =
    (exact_bottom_semantic_global_pentagon_right_route first second third
      targetPackage).1 ≫ directLift.hom
  rw [exact_bottom_semantic_global_pentagon_left_route_fac,
    exact_bottom_semantic_global_pentagon_right_route_fac]

/-! ## Unit triangle coherence -/

/-- The source-identity route through unitor and compositor. -/
noncomputable def exact_bottom_semantic_global_left_unit_route
    {U : AtomCarrier.{u}} {source target : ExtractionInstance U}
    (hom : source ⟶ target) (targetPackage : CoreFiber target) :
    (exact_bottom_semantic_global_reindex_functor hom).obj targetPackage ⟶
      (exact_bottom_semantic_global_reindex_functor
        (𝟙 source ≫ hom)).obj targetPackage :=
  (exact_bottom_semantic_global_unitor_app source
      ((exact_bottom_semantic_global_reindex_functor hom).obj
        targetPackage)).hom ≫
    (exact_bottom_semantic_global_compositor_app
      (𝟙 source) hom targetPackage).hom

/-- The source-unit equality cast. -/
noncomputable def exact_bottom_semantic_global_left_unit_cast
    {U : AtomCarrier.{u}} {source target : ExtractionInstance U}
    (hom : source ⟶ target) (targetPackage : CoreFiber target) :
    (exact_bottom_semantic_global_reindex_functor hom).obj targetPackage ⟶
      (exact_bottom_semantic_global_reindex_functor
        (𝟙 source ≫ hom)).obj targetPackage :=
  exact_bottom_semantic_global_reindex_eq_cast
    (Category.id_comp hom).symm targetPackage

/-- The target-identity route through mapped unitor and compositor. -/
noncomputable def exact_bottom_semantic_global_right_unit_route
    {U : AtomCarrier.{u}} {source target : ExtractionInstance U}
    (hom : source ⟶ target) (targetPackage : CoreFiber target) :
    (exact_bottom_semantic_global_reindex_functor hom).obj targetPackage ⟶
      (exact_bottom_semantic_global_reindex_functor
        (hom ≫ 𝟙 target)).obj targetPackage :=
  (exact_bottom_semantic_global_reindex_functor hom).map
      (exact_bottom_semantic_global_unitor_app target targetPackage).hom ≫
    (exact_bottom_semantic_global_compositor_app
      hom (𝟙 target) targetPackage).hom

/-- The target-unit equality cast. -/
noncomputable def exact_bottom_semantic_global_right_unit_cast
    {U : AtomCarrier.{u}} {source target : ExtractionInstance U}
    (hom : source ⟶ target) (targetPackage : CoreFiber target) :
    (exact_bottom_semantic_global_reindex_functor hom).obj targetPackage ⟶
      (exact_bottom_semantic_global_reindex_functor
        (hom ≫ 𝟙 target)).obj targetPackage :=
  exact_bottom_semantic_global_reindex_eq_cast
    (Category.comp_id hom).symm targetPackage

/-- The source-unit route factors the composite lift as the original lift. -/
theorem exact_bottom_semantic_global_left_unit_route_fac
    {U : AtomCarrier.{u}} {source target : ExtractionInstance U}
    (hom : source ⟶ target) (targetPackage : CoreFiber target) :
    (exact_bottom_semantic_global_left_unit_route hom targetPackage).1 ≫
        (exact_bottom_semantic_global_selected_lift
          (𝟙 source ≫ hom) targetPackage).hom =
      (exact_bottom_semantic_global_selected_lift hom targetPackage).hom := by
  change
    ((exact_bottom_semantic_global_unitor_app source
      ((exact_bottom_semantic_global_reindex_functor hom).obj
        targetPackage)).hom.1 ≫
      (exact_bottom_semantic_global_compositor_app
        (𝟙 source) hom targetPackage).hom.1) ≫
      (exact_bottom_semantic_global_selected_lift
        (𝟙 source ≫ hom) targetPackage).hom = _
  calc
    _ = (exact_bottom_semantic_global_unitor_app source
          ((exact_bottom_semantic_global_reindex_functor hom).obj
            targetPackage)).hom.1 ≫
        ((exact_bottom_semantic_global_compositor_app
          (𝟙 source) hom targetPackage).hom.1 ≫
          (exact_bottom_semantic_global_selected_lift
            (𝟙 source ≫ hom) targetPackage).hom) :=
      Category.assoc _ _ _
    _ = (exact_bottom_semantic_global_unitor_app source
          ((exact_bottom_semantic_global_reindex_functor hom).obj
            targetPackage)).hom.1 ≫
        (exact_bottom_semantic_global_iterated_lift
          (𝟙 source) hom targetPackage).hom := by
      rw [exact_bottom_semantic_global_compositor_app_hom_fac]
    _ = ((exact_bottom_semantic_global_unitor_app source
          ((exact_bottom_semantic_global_reindex_functor hom).obj
            targetPackage)).hom.1 ≫
        (exact_bottom_semantic_global_selected_lift (𝟙 source)
          ((exact_bottom_semantic_global_reindex_functor hom).obj
            targetPackage)).hom) ≫
        (exact_bottom_semantic_global_selected_lift hom targetPackage).hom :=
      (Category.assoc _ _ _).symm
    _ = (exact_bottom_semantic_global_selected_lift hom
          targetPackage).hom := by
      rw [exact_bottom_semantic_global_unitor_app_hom_fac]
      exact Category.id_comp _

/-- The target-unit route factors the composite lift as the original lift. -/
theorem exact_bottom_semantic_global_right_unit_route_fac
    {U : AtomCarrier.{u}} {source target : ExtractionInstance U}
    (hom : source ⟶ target) (targetPackage : CoreFiber target) :
    (exact_bottom_semantic_global_right_unit_route hom targetPackage).1 ≫
        (exact_bottom_semantic_global_selected_lift
          (hom ≫ 𝟙 target) targetPackage).hom =
      (exact_bottom_semantic_global_selected_lift hom targetPackage).hom := by
  change
    (((exact_bottom_semantic_global_reindex_functor hom).map
      (exact_bottom_semantic_global_unitor_app target
        targetPackage).hom).1 ≫
      (exact_bottom_semantic_global_compositor_app
        hom (𝟙 target) targetPackage).hom.1) ≫
      (exact_bottom_semantic_global_selected_lift
        (hom ≫ 𝟙 target) targetPackage).hom = _
  calc
    _ = ((exact_bottom_semantic_global_reindex_functor hom).map
          (exact_bottom_semantic_global_unitor_app target
            targetPackage).hom).1 ≫
        ((exact_bottom_semantic_global_compositor_app
          hom (𝟙 target) targetPackage).hom.1 ≫
          (exact_bottom_semantic_global_selected_lift
            (hom ≫ 𝟙 target) targetPackage).hom) :=
      Category.assoc _ _ _
    _ = ((exact_bottom_semantic_global_reindex_functor hom).map
          (exact_bottom_semantic_global_unitor_app target
            targetPackage).hom).1 ≫
        (exact_bottom_semantic_global_iterated_lift
          hom (𝟙 target) targetPackage).hom := by
      rw [exact_bottom_semantic_global_compositor_app_hom_fac]
    _ = (((exact_bottom_semantic_global_reindex_functor hom).map
          (exact_bottom_semantic_global_unitor_app target
            targetPackage).hom).1 ≫
        (exact_bottom_semantic_global_selected_lift hom
          ((exact_bottom_semantic_global_reindex_functor
            (𝟙 target)).obj targetPackage)).hom) ≫
        (exact_bottom_semantic_global_selected_lift
          (𝟙 target) targetPackage).hom := (Category.assoc _ _ _).symm
    _ = ((exact_bottom_semantic_global_selected_lift hom
          targetPackage).hom ≫
        (exact_bottom_semantic_global_unitor_app target
          targetPackage).hom.1) ≫
        (exact_bottom_semantic_global_selected_lift
          (𝟙 target) targetPackage).hom := by
      rw [exact_bottom_semantic_global_reindex_map_fac]
    _ = (exact_bottom_semantic_global_selected_lift hom
          targetPackage).hom ≫
        ((exact_bottom_semantic_global_unitor_app target
          targetPackage).hom.1 ≫
          (exact_bottom_semantic_global_selected_lift
            (𝟙 target) targetPackage).hom) := Category.assoc _ _ _
    _ = (exact_bottom_semantic_global_selected_lift hom
          targetPackage).hom ≫ 𝟙 targetPackage.1 := by
      rw [exact_bottom_semantic_global_unitor_app_hom_fac]
    _ = _ := Category.comp_id _

/-- Source-unit triangle coherence. -/
theorem exact_bottom_semantic_global_left_unit_triangle
    {U : AtomCarrier.{u}} {source target : ExtractionInstance U}
    (hom : source ⟶ target) (targetPackage : CoreFiber target) :
    exact_bottom_semantic_global_left_unit_route hom targetPackage =
      exact_bottom_semantic_global_left_unit_cast hom targetPackage := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let directLift := exact_bottom_semantic_global_selected_lift
    (𝟙 source ≫ hom) targetPackage
  letI : (packageProjection U).IsStronglyCartesian (𝟙 source ≫ hom)
      directLift.hom := directLift.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U) (𝟙 source ≫ hom)
    directLift.hom (𝟙 source)
  change
    (exact_bottom_semantic_global_left_unit_route hom targetPackage).1 ≫
      directLift.hom =
    (exact_bottom_semantic_global_left_unit_cast hom targetPackage).1 ≫
      directLift.hom
  rw [exact_bottom_semantic_global_left_unit_route_fac]
  exact (exact_bottom_semantic_global_reindex_eq_cast_fac
    (Category.id_comp hom).symm targetPackage).symm

/-- Target-unit triangle coherence. -/
theorem exact_bottom_semantic_global_right_unit_triangle
    {U : AtomCarrier.{u}} {source target : ExtractionInstance U}
    (hom : source ⟶ target) (targetPackage : CoreFiber target) :
    exact_bottom_semantic_global_right_unit_route hom targetPackage =
      exact_bottom_semantic_global_right_unit_cast hom targetPackage := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let directLift := exact_bottom_semantic_global_selected_lift
    (hom ≫ 𝟙 target) targetPackage
  letI : (packageProjection U).IsStronglyCartesian (hom ≫ 𝟙 target)
      directLift.hom := directLift.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U) (hom ≫ 𝟙 target)
    directLift.hom (𝟙 source)
  change
    (exact_bottom_semantic_global_right_unit_route hom targetPackage).1 ≫
      directLift.hom =
    (exact_bottom_semantic_global_right_unit_cast hom targetPackage).1 ≫
      directLift.hom
  rw [exact_bottom_semantic_global_right_unit_route_fac]
  exact (exact_bottom_semantic_global_reindex_eq_cast_fac
    (Category.comp_id hom).symm targetPackage).symm

/-- The two semantic-global unit triangles, packaged at one arbitrary arrow. -/
theorem exact_bottom_semantic_global_triangle
    {U : AtomCarrier.{u}} {source target : ExtractionInstance U}
    (hom : source ⟶ target) (targetPackage : CoreFiber target) :
    exact_bottom_semantic_global_left_unit_route hom targetPackage =
        exact_bottom_semantic_global_left_unit_cast hom targetPackage ∧
      exact_bottom_semantic_global_right_unit_route hom targetPackage =
        exact_bottom_semantic_global_right_unit_cast hom targetPackage :=
  ⟨exact_bottom_semantic_global_left_unit_triangle hom targetPackage,
    exact_bottom_semantic_global_right_unit_triangle hom targetPackage⟩

