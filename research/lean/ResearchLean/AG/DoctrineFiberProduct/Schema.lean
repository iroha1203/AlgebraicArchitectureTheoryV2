import ResearchLean.AG.AtomFoundation.Categories
import Mathlib.CategoryTheory.Limits.Shapes.Pullback.IsPullback.Basic
import Mathlib.GroupTheory.Perm.Support

/-!
# Finite-code schema for G-110 doctrine fiber products

This module fixes the F0 cartesian presentation spine required by G-110.  Each
doctrine code owns its finite `Source` type, so pullback sources may grow as
decidable subtypes instead of being forced back into a single fixture.  The
four authored fields of a raw arrow are its source instance code, target
instance code, finite source-map table, and finite-support Atom permutation
table.

## Implementation notes

`FiniteDoctrineCode` uses the first-order `Fin sourceCard` option explicitly
left to F0 by `(s4)` of the fixed GOAL.  This makes every source-map cell and
the named identity source table uniformly executable.  Pullback later
re-enumerates its finite compatible-pair subtype by `Fin (Fintype.card ...)`.
Atom predicates are finite or cofinite exception tables.  Atom permutations
are permutations of an authored finite support and are extended by the
identity outside that support using mathlib's `Equiv.Perm.ofSubtype`.

Semantic `ExtractionDoctrine`, `ExactDoctrineHom`, and `ExtInstHom` values are
generated by the decoder.  No semantic morphism, lift, condition bit, or
conclusion certificate occurs in the raw code.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open CategoryTheory CategoryTheory.Limits
open AtomFoundation

/-! ## Finite and cofinite Atom-predicate tables -/

/--
A finite table for an Atom predicate.  `exceptions` records exactly the cells
whose Boolean value differs from `defaultValue`, hence the table denotes a
finite predicate when the default is false and a cofinite predicate when it is
true.
-/
structure AtomPredicateCode (U : AtomCarrier.{u}) where
  /-- Value away from the finite exception support. -/
  defaultValue : Bool
  /-- Finite set on which the default value is flipped. -/
  exceptions : Finset U.Atom

/-- Equality of finite/cofinite predicate tables is executable. -/
instance atomPredicateCodeDecidableEq {U : AtomCarrier.{u}}
    [DecidableEq U.Atom] : DecidableEq (AtomPredicateCode U) := by
  intro first second
  cases first
  cases second
  simp only [AtomPredicateCode.mk.injEq]
  infer_instance

namespace AtomPredicateCode

/-- Evaluate a finite/cofinite Atom-predicate table. -/
def eval {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : AtomPredicateCode U) (atom : U.Atom) : Bool :=
  if atom ∈ code.exceptions then !code.defaultValue else code.defaultValue

/-- Read the Boolean table as a proposition. -/
def Holds {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : AtomPredicateCode U) (atom : U.Atom) : Prop :=
  code.eval atom = true

/-- Transport a finite/cofinite predicate along a finite-support permutation. -/
def transport {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : AtomPredicateCode U) (equiv : Equiv.Perm U.Atom) :
    AtomPredicateCode U where
  defaultValue := code.defaultValue
  exceptions := code.exceptions.map equiv.toEmbedding

/-- Transported predicate evaluation agrees at the transported Atom. -/
@[simp]
theorem eval_transport {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : AtomPredicateCode U) (equiv : Equiv.Perm U.Atom)
    (atom : U.Atom) :
    (code.transport equiv).eval (equiv atom) = code.eval atom := by
  simp [eval, transport]

/-- Transport by the identity permutation leaves a predicate code unchanged. -/
@[simp]
theorem transport_refl {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : AtomPredicateCode U) :
    code.transport (Equiv.refl U.Atom) = code := by
  cases code
  simp [transport]

/-- Successive transports compose in the same order as `Equiv.trans`. -/
theorem transport_trans {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : AtomPredicateCode U) (first second : Equiv.Perm U.Atom) :
    (code.transport first).transport second =
      code.transport (first.trans second) := by
  cases code
  simp [transport, Finset.map_map]

/-- Transport by a permutation and its inverse cancels at code level. -/
@[simp]
theorem transport_symm_cancel {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : AtomPredicateCode U) (equiv : Equiv.Perm U.Atom) :
    (code.transport equiv).transport equiv.symm = code := by
  rw [transport_trans]
  simp

end AtomPredicateCode

/-! ## Finite-support Atom permutation tables -/

/--
A finite-support permutation table.  `table` is a permutation of the authored
finite support; decoding extends it by the identity off that support.
-/
structure AtomPermutationCode (U : AtomCarrier.{u}) where
  /-- Authored finite support. -/
  support : Finset U.Atom
  /-- Complete permutation table on the finite support. -/
  table : Equiv.Perm {atom // atom ∈ support}

namespace AtomPermutationCode

/-- Decode the finite table to a permutation of all Atoms. -/
def toEquiv {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : AtomPermutationCode U) : Equiv.Perm U.Atom :=
  Equiv.Perm.ofSubtype code.table

/-- Decoding agrees with the authored table on its support. -/
@[simp]
theorem toEquiv_apply_mem {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : AtomPermutationCode U) (atom : U.Atom)
    (h : atom ∈ code.support) :
    code.toEquiv atom = code.table ⟨atom, h⟩ :=
  Equiv.Perm.ofSubtype_apply_of_mem code.table h

/-- Decoding is the identity outside the authored support. -/
@[simp]
theorem toEquiv_apply_not_mem {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : AtomPermutationCode U) (atom : U.Atom)
    (h : atom ∉ code.support) :
    code.toEquiv atom = atom :=
  Equiv.Perm.ofSubtype_apply_of_not_mem code.table h

/-- Package a permutation with an explicit finite invariant support. -/
def ofPerm {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (support : Finset U.Atom) (equiv : Equiv.Perm U.Atom)
    (hinvariant : ∀ atom, equiv atom ∈ support ↔ atom ∈ support)
    (_hfix : ∀ atom, atom ∉ support → equiv atom = atom) :
    AtomPermutationCode U where
  support := support
  table := equiv.subtypePerm hinvariant

/-- `ofPerm` decodes to the supplied permutation, not merely an extension. -/
@[simp]
theorem toEquiv_ofPerm {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (support : Finset U.Atom) (equiv : Equiv.Perm U.Atom)
    (hinvariant : ∀ atom, equiv atom ∈ support ↔ atom ∈ support)
    (hfix : ∀ atom, atom ∉ support → equiv atom = atom) :
    (ofPerm support equiv hinvariant hfix).toEquiv = equiv := by
  apply Equiv.Perm.ofSubtype_subtypePerm hinvariant
  intro atom hne
  by_contra hnot
  exact hne (hfix atom hnot)

/-- The empty table decodes to the identity permutation. -/
def refl {U : AtomCarrier.{u}} [DecidableEq U.Atom] :
    AtomPermutationCode U :=
  ofPerm ∅ (Equiv.refl U.Atom) (by simp) (by simp)

/-- The identity table decodes to the identity permutation. -/
@[simp]
theorem toEquiv_refl {U : AtomCarrier.{u}} [DecidableEq U.Atom] :
    (refl : AtomPermutationCode U).toEquiv = Equiv.refl U.Atom := by
  simp [refl]

/-- Invert a finite-support permutation table on the same finite support. -/
def symm {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : AtomPermutationCode U) : AtomPermutationCode U where
  support := code.support
  table := code.table.symm

/-- Decoding commutes with inversion of a finite-support table. -/
@[simp]
theorem toEquiv_symm {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : AtomPermutationCode U) :
    code.symm.toEquiv = code.toEquiv.symm := by
  apply Equiv.ext
  intro atom
  by_cases hmem : atom ∈ code.support
  · rw [toEquiv_apply_mem code.symm atom hmem,
      Equiv.eq_symm_apply]
    change code.toEquiv ↑(code.table.symm ⟨atom, hmem⟩) = atom
    rw [toEquiv_apply_mem code _
      (code.table.symm ⟨atom, hmem⟩).property]
    simp
  · rw [toEquiv_apply_not_mem code.symm atom hmem,
      Equiv.eq_symm_apply]
    exact code.toEquiv_apply_not_mem atom hmem

/-- Decoded finite-support permutations preserve every finite superset of their support. -/
theorem toEquiv_mem_superset_iff {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : AtomPermutationCode U) (larger : Finset U.Atom)
    (hsub : code.support ⊆ larger) (atom : U.Atom) :
    code.toEquiv atom ∈ larger ↔ atom ∈ larger := by
  by_cases hmem : atom ∈ code.support
  · constructor
    · intro _
      exact hsub hmem
    · intro _
      exact hsub ((Equiv.Perm.ofSubtype_apply_mem_iff_mem
        code.table atom).mpr hmem)
  · rw [code.toEquiv_apply_not_mem atom hmem]

/-- Compose two finite-support tables, using the union as an explicit support. -/
def trans {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (first second : AtomPermutationCode U) : AtomPermutationCode U :=
  let equiv := first.toEquiv.trans second.toEquiv
  ofPerm (first.support ∪ second.support) equiv
    (fun atom => by
      rw [Equiv.trans_apply,
        second.toEquiv_mem_superset_iff
          (first.support ∪ second.support) Finset.subset_union_right,
        first.toEquiv_mem_superset_iff
          (first.support ∪ second.support) Finset.subset_union_left])
    (fun atom hnot => by
      simp only [Finset.mem_union, not_or] at hnot
      rw [Equiv.trans_apply,
        first.toEquiv_apply_not_mem atom hnot.1,
        second.toEquiv_apply_not_mem atom hnot.2])

/-- Decoding finite-table composition gives ordinary equivalence composition. -/
@[simp]
theorem toEquiv_trans {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (first second : AtomPermutationCode U) :
    (first.trans second).toEquiv = first.toEquiv.trans second.toEquiv := by
  simp [trans]

end AtomPermutationCode

/-! ## Doctrine and pointed-instance codes -/

/-- A first-order finite source lifted into the carrier universe. -/
abbrev FiniteSource (card : ℕ) : Type u := ULift.{u} (Fin card)

/--
A finite-code extraction doctrine.  The source type varies with the code and is
finite with decidable equality; normalization and extraction are finite tables.
-/
structure FiniteDoctrineCode (U : AtomCarrier.{u}) where
  /-- Cardinality of the first-order finite source type. -/
  sourceCard : ℕ
  /-- Finite normalization table. -/
  normalize : FiniteSource.{u} sourceCard → FiniteSource.{u} sourceCard
  /-- Finite/cofinite Atom predicate attached to every source cell. -/
  extraction : FiniteSource.{u} sourceCard → AtomPredicateCode U

namespace FiniteDoctrineCode

/-- The finite source type decoded from a first-order cardinality. -/
abbrev Source {U : AtomCarrier.{u}} (code : FiniteDoctrineCode U) :=
  FiniteSource.{u} code.sourceCard

/-- Decode a finite doctrine code to the G-101 extraction-doctrine API. -/
def toDoctrine {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : FiniteDoctrineCode U) : ExtractionDoctrine U where
  Source := code.Source
  Vocabulary := PUnit
  SemanticReading := PUnit
  Resolution := PUnit
  vocabulary := PUnit.unit
  semanticReading := PUnit.unit
  resolution := PUnit.unit
  vocabularyAllows := fun _ _ => True
  semanticAllows := fun _ source atom => (code.extraction source).Holds atom
  resolutionAllows := fun _ _ _ => True
  sourceSemantics := fun _ _ => True
  normalize := code.normalize

/-- Extraction from the decoded doctrine is exactly evaluation of the normalized table. -/
@[simp]
theorem toDoctrine_extracts_iff {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : FiniteDoctrineCode U) (source : code.Source) (atom : U.Atom) :
    code.toDoctrine.extracts source atom ↔
      (code.extraction (code.normalize source)).Holds atom := by
  simp [ExtractionDoctrine.extracts, toDoctrine,
    AtomPredicateCode.Holds]

end FiniteDoctrineCode

/-- A finite doctrine code together with one selected source cell. -/
structure FiniteInstanceCode (U : AtomCarrier.{u}) where
  /-- Underlying finite doctrine code. -/
  doctrine : FiniteDoctrineCode U
  /-- Selected source cell. -/
  point : doctrine.Source

namespace FiniteInstanceCode

/-- Decode a finite pointed-instance code to `ExtInst_U`. -/
def toSemantic {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : FiniteInstanceCode U) : ExtractionInstance U where
  doctrine := code.doctrine.toDoctrine
  source := code.point

end FiniteInstanceCode

/-! ## Four-field cartesian raw codes and validated presentations -/

/--
The four authored fields of a finite-code bottom arrow.  The source map is an
arbitrary finite table and is deliberately not required to be invertible.
-/
structure CartRawCode (U : AtomCarrier.{u}) where
  /-- Source pointed-instance code. -/
  source : FiniteInstanceCode U
  /-- Target pointed-instance code. -/
  target : FiniteInstanceCode U
  /-- Arbitrary finite source-map table. -/
  sourceMap : source.doctrine.Source → target.doctrine.Source
  /-- Finite-support Atom permutation table. -/
  atomEquiv : AtomPermutationCode U

namespace CartRawCode

/--
Finite well-formedness conditions for decoding an actual pointed exact
morphism: normalization compatibility, code-level extraction exactness, and
preservation of the selected point.
-/
def WellFormed {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : CartRawCode U) : Prop :=
  (∀ source,
      code.target.doctrine.normalize (code.sourceMap source) =
        code.sourceMap (code.source.doctrine.normalize source)) ∧
  (∀ source,
      code.target.doctrine.extraction
          (code.target.doctrine.normalize (code.sourceMap source)) =
        (code.source.doctrine.extraction
          (code.source.doctrine.normalize source)).transport
            code.atomEquiv.toEquiv) ∧
  code.sourceMap code.source.point = code.target.point

/-- Well-formedness is decidable by finite table inspection. -/
instance wellFormedDecidable {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : CartRawCode U) : Decidable code.WellFormed := by
  unfold WellFormed
  infer_instance

/-- The executable finite well-formedness checker. -/
def checkWellFormed {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : CartRawCode U) : Bool :=
  decide code.WellFormed

/-- The finite checker is sound and complete for `WellFormed`. -/
theorem checkWellFormed_eq_true_iff {U : AtomCarrier.{u}}
    [DecidableEq U.Atom] (code : CartRawCode U) :
    code.checkWellFormed = true ↔ code.WellFormed := by
  simp [checkWellFormed]

end CartRawCode

/-- A raw four-field code together with its finite well-formedness proof. -/
abbrev ValidatedCartCode (U : AtomCarrier.{u}) [DecidableEq U.Atom] :=
  {code : CartRawCode U // code.WellFormed}

/-- The G-110 cartesian presentation layer. -/
abbrev CartPresentation (U : AtomCarrier.{u}) [DecidableEq U.Atom] :=
  ValidatedCartCode U

/-- Named semantic input type required by the fixed G-110 signature. -/
structure CartSemanticInput (U : AtomCarrier.{u}) where
  /-- Semantic source pointed doctrine. -/
  source : ExtractionInstance U
  /-- Semantic target pointed doctrine. -/
  target : ExtractionInstance U
  /-- Actual pointed exact morphism. -/
  hom : source ⟶ target

/-! ## Semantic decoder and provenance -/

/-- Decode a validated raw code to an actual exact doctrine morphism. -/
def decodeCartDoctrineHom {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : CartPresentation U) :
    ExactDoctrineHom presentation.1.source.doctrine.toDoctrine
      presentation.1.target.doctrine.toDoctrine where
  sourceMap := presentation.1.sourceMap
  atomEquiv := presentation.1.atomEquiv.toEquiv
  normalize_eq := presentation.2.1
  extraction_iff := by
    intro source atom
    rw [FiniteDoctrineCode.toDoctrine_extracts_iff,
      FiniteDoctrineCode.toDoctrine_extracts_iff]
    rw [presentation.2.2.1 source]
    simp [AtomPredicateCode.Holds]

/-- Decode a validated presentation to the named semantic input structure. -/
def toSemanticCart {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : CartPresentation U) : CartSemanticInput U where
  source := presentation.1.source.toSemantic
  target := presentation.1.target.toSemantic
  hom :=
    { doctrineHom := decodeCartDoctrineHom presentation
      source_eq := presentation.2.2.2 }

/--
The decoder output satisfies the actual G-101 normalization, extraction, and
selected-source laws.  This theorem exposes the semantic laws rather than
counting the validated subtype field itself as soundness.
-/
theorem toSemanticCart_sound {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : CartPresentation U) :
    (∀ source,
      (toSemanticCart presentation).target.doctrine.normalize
          ((toSemanticCart presentation).hom.doctrineHom.sourceMap source) =
        (toSemanticCart presentation).hom.doctrineHom.sourceMap
          ((toSemanticCart presentation).source.doctrine.normalize source)) ∧
    (∀ source atom,
      (toSemanticCart presentation).source.doctrine.extracts source atom ↔
        (toSemanticCart presentation).target.doctrine.extracts
          ((toSemanticCart presentation).hom.doctrineHom.sourceMap source)
          ((toSemanticCart presentation).hom.doctrineHom.atomEquiv atom)) ∧
    (toSemanticCart presentation).hom.doctrineHom.sourceMap
        (toSemanticCart presentation).source.source =
      (toSemanticCart presentation).target.source := by
  exact ⟨(toSemanticCart presentation).hom.doctrineHom.normalize_eq,
    (toSemanticCart presentation).hom.doctrineHom.extraction_iff,
    (toSemanticCart presentation).hom.source_eq⟩

/-- A semantic bottom arrow together with finite-presentation provenance. -/
structure RealizableHom (U : AtomCarrier.{u}) [DecidableEq U.Atom] where
  /-- Semantic arrow claimed to lie in the realization image. -/
  semantic : CartSemanticInput U
  /-- Finite presentation witness. -/
  presentation : CartPresentation U
  /-- The semantic arrow is exactly the decoder output. -/
  realization_eq : semantic = toSemanticCart presentation

/-- Canonical realization witness generated from a validated presentation. -/
def realizableHomOf {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : CartPresentation U) : RealizableHom U where
  semantic := toSemanticCart presentation
  presentation := presentation
  realization_eq := rfl

/-! ## Identity and composition closure -/

namespace CartRawCode

/-- The four-field raw identity code on a finite pointed instance. -/
def identity {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U) : CartRawCode U where
  source := instanceCode
  target := instanceCode
  sourceMap := id
  atomEquiv := AtomPermutationCode.refl

/-- The generated identity code satisfies all finite decoder laws. -/
theorem identity_wellFormed {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U) :
    (identity instanceCode).WellFormed := by
  refine ⟨?_, ?_, rfl⟩
  · intro source
    rfl
  · intro source
    simp [identity]

end CartRawCode

/--
A typed view of a validated four-field presentation.  Endpoint instance codes
are parameters, so identity and composition carry ordinary category-style
typing without eliminating equality between dependent structures.
-/
structure CartPresentationBetween {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (source target : FiniteInstanceCode U) where
  /-- Arbitrary finite source-map table. -/
  sourceMap : source.doctrine.Source → target.doctrine.Source
  /-- Finite-support Atom permutation table. -/
  atomEquiv : AtomPermutationCode U
  /-- Normalization compatibility checked on every source cell. -/
  normalize_eq : ∀ input,
    target.doctrine.normalize (sourceMap input) =
      sourceMap (source.doctrine.normalize input)
  /-- Code-level extraction exactness checked on every source cell. -/
  extraction_eq : ∀ input,
    target.doctrine.extraction
        (target.doctrine.normalize (sourceMap input)) =
      (source.doctrine.extraction
        (source.doctrine.normalize input)).transport atomEquiv.toEquiv
  /-- The selected source cell is preserved. -/
  source_eq : sourceMap source.point = target.point

namespace CartPresentationBetween

/-- Reassemble the four authored fields of a typed presentation. -/
def toRaw {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target) : CartRawCode U where
  source := source
  target := target
  sourceMap := presentation.sourceMap
  atomEquiv := presentation.atomEquiv

/-- The typed validation laws prove raw-code well-formedness. -/
theorem toRaw_wellFormed {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target) :
    presentation.toRaw.WellFormed :=
  ⟨presentation.normalize_eq, presentation.extraction_eq,
    presentation.source_eq⟩

/-- Forget endpoint indices and obtain the fixed raw/validated presentation type. -/
def toPresentation {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target) :
    CartPresentation U :=
  ⟨presentation.toRaw, presentation.toRaw_wellFormed⟩

/-- Every unindexed validated presentation has its canonical typed view. -/
def ofPresentation {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : CartPresentation U) :
    CartPresentationBetween presentation.1.source presentation.1.target where
  sourceMap := presentation.1.sourceMap
  atomEquiv := presentation.1.atomEquiv
  normalize_eq := presentation.2.1
  extraction_eq := presentation.2.2.1
  source_eq := presentation.2.2.2

end CartPresentationBetween

/-- The validated identity presentation constructor. -/
def idPresentation {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U) : CartPresentation U :=
  ⟨CartRawCode.identity instanceCode,
    CartRawCode.identity_wellFormed instanceCode⟩

/-- The identity presentation realizes the categorical identity in `ExtInst_U`. -/
@[simp]
theorem toSemanticCart_idPresentation_hom {U : AtomCarrier.{u}}
    [DecidableEq U.Atom] (instanceCode : FiniteInstanceCode U) :
    (toSemanticCart (idPresentation instanceCode)).hom =
      𝟙 instanceCode.toSemantic := by
  apply ExtInstHom.ext
  apply ExactDoctrineHom.ext
  · rfl
  · exact AtomPermutationCode.toEquiv_refl

/-- The typed identity presentation, used by closure chains. -/
def idTypedPresentation {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U) :
    CartPresentationBetween instanceCode instanceCode where
  sourceMap := id
  atomEquiv := AtomPermutationCode.refl
  normalize_eq _ := rfl
  extraction_eq input := by simp
  source_eq := rfl

/-- Compose two typed presentations by composing only their authored tables. -/
def compPresentation {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (first : CartPresentationBetween source middle)
    (second : CartPresentationBetween middle target) :
    CartPresentationBetween source target where
  sourceMap := second.sourceMap ∘ first.sourceMap
  atomEquiv := first.atomEquiv.trans second.atomEquiv
  normalize_eq input := by
    change target.doctrine.normalize
        (second.sourceMap (first.sourceMap input)) =
      second.sourceMap (first.sourceMap (source.doctrine.normalize input))
    rw [second.normalize_eq, first.normalize_eq]
  extraction_eq input := by
    change target.doctrine.extraction
        (target.doctrine.normalize
          (second.sourceMap (first.sourceMap input))) =
      (source.doctrine.extraction
        (source.doctrine.normalize input)).transport
          (first.atomEquiv.trans second.atomEquiv).toEquiv
    rw [second.extraction_eq (first.sourceMap input),
      first.extraction_eq input, AtomPermutationCode.toEquiv_trans,
      AtomPredicateCode.transport_trans]
  source_eq := by
    change second.sourceMap (first.sourceMap source.point) = target.point
    rw [first.source_eq, second.source_eq]

/-- Presentation composition realizes categorical composition in `ExtInst_U`. -/
theorem toSemanticCart_compPresentation_hom {U : AtomCarrier.{u}}
    [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (first : CartPresentationBetween source middle)
    (second : CartPresentationBetween middle target) :
    (toSemanticCart (compPresentation first second).toPresentation).hom =
      (toSemanticCart first.toPresentation).hom ≫
        (toSemanticCart second.toPresentation).hom := by
  apply ExtInstHom.ext
  apply ExactDoctrineHom.ext
  · rfl
  · exact AtomPermutationCode.toEquiv_trans first.atomEquiv second.atomEquiv

/-! ## The typed finite-code cartesian calculus -/

/--
Two typed presentations with the same code endpoints are identified exactly
when their decoded semantic arrows agree.  This quotient relation makes the
constructor-relative code calculus explicit without claiming that independently
chosen codes for equal semantic endpoints are definitionally interchangeable.
-/
def cartPresentationSetoid {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (source target : FiniteInstanceCode U) :
    Setoid (CartPresentationBetween source target) where
  r first second :=
    (toSemanticCart first.toPresentation).hom =
      (toSemanticCart second.toPresentation).hom
  iseqv := ⟨fun _ => rfl, fun h => h.symm, fun h₁ h₂ => h₁.trans h₂⟩

/-- A morphism of the finite-code calculus, modulo equality of its decoding. -/
abbrev FiniteCodeCartHom {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (source target : FiniteInstanceCode U) :=
  Quotient (cartPresentationSetoid source target)

namespace FiniteCodeCartHom

/-- Insert a typed presentation into the finite-code quotient calculus. -/
def ofPresentation {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target) :
    FiniteCodeCartHom source target :=
  Quotient.mk _ presentation

end FiniteCodeCartHom

/-- Decode a typed presentation with its code endpoints exposed in the type. -/
def typedPresentationToSemantic {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target) :
    source.toSemantic ⟶ target.toSemantic := by
  simpa [CartPresentationBetween.toPresentation,
    CartPresentationBetween.toRaw, toSemanticCart,
    FiniteInstanceCode.toSemantic] using
      (toSemanticCart presentation.toPresentation).hom

namespace FiniteCodeCartHom

/-- Decode a quotient morphism; the quotient relation is semantic equality. -/
def toSemantic {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (hom : FiniteCodeCartHom source target) :
    source.toSemantic ⟶ target.toSemantic :=
  Quotient.lift typedPresentationToSemantic (fun _ _ h => h) hom

/-- Composition in the quotient calculus is induced by the authored-table constructor. -/
def comp {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (first : FiniteCodeCartHom source middle)
    (second : FiniteCodeCartHom middle target) :
    FiniteCodeCartHom source target :=
  Quotient.map₂ compPresentation
    (fun first first' hfirst second second' hsecond => by
      change
        (toSemanticCart
          (compPresentation first second).toPresentation).hom =
        (toSemanticCart
          (compPresentation first' second').toPresentation).hom
      rw [toSemanticCart_compPresentation_hom,
        toSemanticCart_compPresentation_hom, hfirst, hsecond])
    first second

end FiniteCodeCartHom

/-- Object type of the typed finite-code cartesian calculus. -/
abbrev FiniteCodeCartCategory (U : AtomCarrier.{u}) [DecidableEq U.Atom] :=
  FiniteInstanceCode U

/--
Finite instance codes and decoded-equality classes of typed presentations form
a category.  Thus code-family composition is an actual typed calculus rather
than a claim about separately chosen presentations of equal semantic objects.
-/
instance finiteCodeCartCategory {U : AtomCarrier.{u}} [DecidableEq U.Atom] :
    Category (FiniteCodeCartCategory U) where
  Hom := FiniteCodeCartHom
  id object := FiniteCodeCartHom.ofPresentation (idTypedPresentation object)
  comp := FiniteCodeCartHom.comp
  id_comp := by
    intro source target hom
    refine Quotient.inductionOn hom ?_
    intro presentation
    apply Quotient.sound
    change
      (toSemanticCart
        (compPresentation (idTypedPresentation source)
          presentation).toPresentation).hom =
      (toSemanticCart presentation.toPresentation).hom
    rw [toSemanticCart_compPresentation_hom]
    have hid :
        (toSemanticCart (idTypedPresentation source).toPresentation).hom =
          𝟙 source.toSemantic := by
      apply ExtInstHom.ext
      apply ExactDoctrineHom.ext
      · rfl
      · exact AtomPermutationCode.toEquiv_refl
    rw [hid]
    change 𝟙 source.toSemantic ≫ typedPresentationToSemantic presentation =
      typedPresentationToSemantic presentation
    exact Category.id_comp _
  comp_id := by
    intro source target hom
    refine Quotient.inductionOn hom ?_
    intro presentation
    apply Quotient.sound
    change
      (toSemanticCart
        (compPresentation presentation
          (idTypedPresentation target)).toPresentation).hom =
      (toSemanticCart presentation.toPresentation).hom
    rw [toSemanticCart_compPresentation_hom]
    have hid :
        (toSemanticCart (idTypedPresentation target).toPresentation).hom =
          𝟙 target.toSemantic := by
      apply ExtInstHom.ext
      apply ExactDoctrineHom.ext
      · rfl
      · exact AtomPermutationCode.toEquiv_refl
    rw [hid]
    change typedPresentationToSemantic presentation ≫ 𝟙 target.toSemantic =
      typedPresentationToSemantic presentation
    exact Category.comp_id _
  assoc := by
    intro first second third fourth f g h
    refine Quotient.inductionOn₃ f g h ?_
    intro pf pg ph
    apply Quotient.sound
    change
      (toSemanticCart
        (compPresentation (compPresentation pf pg) ph).toPresentation).hom =
      (toSemanticCart
        (compPresentation pf (compPresentation pg ph)).toPresentation).hom
    simp only [toSemanticCart_compPresentation_hom, Category.assoc]

/--
Semantic realization of the typed finite-code calculus into `ExtInst_U`.
The functor laws are the decoder compatibility theorems, not stored fields.
-/
def finiteCodeCartRealization {U : AtomCarrier.{u}} [DecidableEq U.Atom] :
    FiniteCodeCartCategory U ⥤ ExtractionInstance U where
  obj object := object.toSemantic
  map hom := FiniteCodeCartHom.toSemantic hom
  map_id object := by
    change typedPresentationToSemantic (idTypedPresentation object) =
      𝟙 object.toSemantic
    apply ExtInstHom.ext
    apply ExactDoctrineHom.ext
    · rfl
    · exact AtomPermutationCode.toEquiv_refl
  map_comp first second := by
    refine Quotient.inductionOn₂ first second ?_
    intro p q
    change typedPresentationToSemantic (compPresentation p q) =
      typedPresentationToSemantic p ≫ typedPresentationToSemantic q
    exact toSemanticCart_compPresentation_hom p q

/-! ## Pullback closure of the finite-code realization image -/

/-- Cancel the same transported predicate on the right by its inverse. -/
theorem AtomPredicateCode.eq_transport_trans_symm_of_transport_eq
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (left right : AtomPredicateCode U) (first second : Equiv.Perm U.Atom)
    (htransport : left.transport first = right.transport second) :
    right = left.transport (first.trans second.symm) := by
  calc
    right = (right.transport second).transport second.symm :=
      (right.transport_symm_cancel second).symm
    _ = (left.transport first).transport second.symm := by rw [htransport]
    _ = left.transport (first.trans second.symm) :=
      left.transport_trans first second.symm

/-- Compatible source pairs for a typed finite cospan. -/
abbrev CompatibleSource {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {left right base : FiniteInstanceCode U}
    (first : CartPresentationBetween left base)
    (second : CartPresentationBetween right base) :=
  {pair : left.doctrine.Source × right.doctrine.Source //
    first.sourceMap pair.1 = second.sourceMap pair.2}

/--
Canonical F0 re-enumeration of the finite compatible-pair subtype by a
first-order `Fin` source code.
-/
noncomputable def compatibleSourceEquiv
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {left right base : FiniteInstanceCode U}
    (first : CartPresentationBetween left base)
    (second : CartPresentationBetween right base) :
    FiniteSource.{u} (Fintype.card (CompatibleSource first second)) ≃
      CompatibleSource first second :=
  Equiv.ulift.trans (Fintype.equivFin (CompatibleSource first second)).symm

/-- Finite-code doctrine on compatible source pairs of a cospan. -/
noncomputable def pullbackDoctrineCode
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {left right base : FiniteInstanceCode U}
    (first : CartPresentationBetween left base)
    (second : CartPresentationBetween right base) : FiniteDoctrineCode U where
  sourceCard := Fintype.card (CompatibleSource first second)
  normalize input :=
    let pair := compatibleSourceEquiv first second input
    (compatibleSourceEquiv first second).symm
      ⟨(left.doctrine.normalize pair.val.1,
        right.doctrine.normalize pair.val.2), by
        rw [← first.normalize_eq pair.val.1,
          ← second.normalize_eq pair.val.2,
          pair.property]⟩
  extraction input :=
    left.doctrine.extraction
      (compatibleSourceEquiv first second input).val.1

/-- Selected compatible point of the generated pullback doctrine code. -/
noncomputable def pullbackInstanceCode
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {left right base : FiniteInstanceCode U}
    (first : CartPresentationBetween left base)
    (second : CartPresentationBetween right base) : FiniteInstanceCode U where
  doctrine := pullbackDoctrineCode first second
  point := (compatibleSourceEquiv first second).symm
    ⟨(left.point, right.point), by rw [first.source_eq, second.source_eq]⟩

/-- The first component of generated pullback normalization is componentwise. -/
@[simp]
theorem pullbackDoctrineCode_normalize_fst
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {left right base : FiniteInstanceCode U}
    (first : CartPresentationBetween left base)
    (second : CartPresentationBetween right base)
    (input : (pullbackDoctrineCode first second).Source) :
    (compatibleSourceEquiv first second
      ((pullbackDoctrineCode first second).normalize input)).val.1 =
      left.doctrine.normalize
        (compatibleSourceEquiv first second input).val.1 := by
  simp [pullbackDoctrineCode]

/-- The second component of generated pullback normalization is componentwise. -/
@[simp]
theorem pullbackDoctrineCode_normalize_snd
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {left right base : FiniteInstanceCode U}
    (first : CartPresentationBetween left base)
    (second : CartPresentationBetween right base)
    (input : (pullbackDoctrineCode first second).Source) :
    (compatibleSourceEquiv first second
      ((pullbackDoctrineCode first second).normalize input)).val.2 =
      right.doctrine.normalize
        (compatibleSourceEquiv first second input).val.2 := by
  simp [pullbackDoctrineCode]

/-- Pullback extraction is the first component predicate after normalization. -/
theorem pullbackDoctrineCode_extracts_iff
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {left right base : FiniteInstanceCode U}
    (first : CartPresentationBetween left base)
    (second : CartPresentationBetween right base)
    (input : (pullbackDoctrineCode first second).Source) (atom : U.Atom) :
    (pullbackDoctrineCode first second).toDoctrine.extracts input atom ↔
      left.doctrine.toDoctrine.extracts
        (compatibleSourceEquiv first second input).val.1 atom := by
  rw [FiniteDoctrineCode.toDoctrine_extracts_iff,
    FiniteDoctrineCode.toDoctrine_extracts_iff]
  simp [pullbackDoctrineCode]

/-- The generated pullback point projects to the selected left point. -/
@[simp]
theorem pullbackInstanceCode_point_fst
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {left right base : FiniteInstanceCode U}
    (first : CartPresentationBetween left base)
    (second : CartPresentationBetween right base) :
    (compatibleSourceEquiv first second
      (pullbackInstanceCode first second).point).val.1 = left.point := by
  simp [pullbackInstanceCode]

/-- The generated pullback point projects to the selected right point. -/
@[simp]
theorem pullbackInstanceCode_point_snd
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {left right base : FiniteInstanceCode U}
    (first : CartPresentationBetween left base)
    (second : CartPresentationBetween right base) :
    (compatibleSourceEquiv first second
      (pullbackInstanceCode first second).point).val.2 = right.point := by
  simp [pullbackInstanceCode]

/-- First projection presentation generated from a finite cospan. -/
noncomputable def pullbackFstPresentation
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {left right base : FiniteInstanceCode U}
    (first : CartPresentationBetween left base)
    (second : CartPresentationBetween right base) :
    CartPresentationBetween (pullbackInstanceCode first second) left where
  sourceMap input := (compatibleSourceEquiv first second input).val.1
  atomEquiv := AtomPermutationCode.refl
  normalize_eq input := by
    simp [pullbackInstanceCode, pullbackDoctrineCode]
  extraction_eq input := by
    simp [pullbackInstanceCode, pullbackDoctrineCode]
  source_eq := by
    simp [pullbackInstanceCode]

/-- Second projection presentation generated from a finite cospan. -/
noncomputable def pullbackSndPresentation
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {left right base : FiniteInstanceCode U}
    (first : CartPresentationBetween left base)
    (second : CartPresentationBetween right base) :
    CartPresentationBetween (pullbackInstanceCode first second) right where
  sourceMap input := (compatibleSourceEquiv first second input).val.2
  atomEquiv := first.atomEquiv.trans second.atomEquiv.symm
  normalize_eq input := by
    simp [pullbackInstanceCode, pullbackDoctrineCode]
  extraction_eq input := by
    let pair := compatibleSourceEquiv first second input
    have htransport :
        (left.doctrine.extraction
            (left.doctrine.normalize pair.val.1)).transport
              first.atomEquiv.toEquiv =
          (right.doctrine.extraction
            (right.doctrine.normalize pair.val.2)).transport
              second.atomEquiv.toEquiv := by
      calc
        _ = base.doctrine.extraction
              (base.doctrine.normalize (first.sourceMap pair.val.1)) :=
            (first.extraction_eq pair.val.1).symm
        _ = base.doctrine.extraction
              (base.doctrine.normalize (second.sourceMap pair.val.2)) := by
            rw [pair.property]
        _ = _ := second.extraction_eq pair.val.2
    have hright :=
      AtomPredicateCode.eq_transport_trans_symm_of_transport_eq
        (left.doctrine.extraction (left.doctrine.normalize pair.val.1))
        (right.doctrine.extraction (right.doctrine.normalize pair.val.2))
        first.atomEquiv.toEquiv second.atomEquiv.toEquiv htransport
    simpa [pullbackInstanceCode, pullbackDoctrineCode, pair,
      AtomPermutationCode.toEquiv_trans,
      AtomPermutationCode.toEquiv_symm] using hright
  source_eq := by
    simp [pullbackInstanceCode]

/--
Producer output for the finite-code pullback object and its two projections.
No pullback proof or semantic equality is an authored field.
-/
structure PullbackPresentation
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {left right base : FiniteInstanceCode U}
    (first : CartPresentationBetween left base)
    (second : CartPresentationBetween right base) where
  /-- Generated compatible-pair object code. -/
  object : FiniteInstanceCode U
  /-- Generated first projection. -/
  fst : CartPresentationBetween object left
  /-- Generated second projection. -/
  snd : CartPresentationBetween object right

/-- Generate the pullback presentation entirely from a finite cospan. -/
noncomputable def pullbackPresentation
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {left right base : FiniteInstanceCode U}
    (first : CartPresentationBetween left base)
    (second : CartPresentationBetween right base) :
    PullbackPresentation first second where
  object := pullbackInstanceCode first second
  fst := pullbackFstPresentation first second
  snd := pullbackSndPresentation first second

/-- The generated semantic projection square commutes. -/
theorem pullbackPresentation_commutes
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {left right base : FiniteInstanceCode U}
    (first : CartPresentationBetween left base)
    (second : CartPresentationBetween right base) :
    (toSemanticCart (pullbackFstPresentation first second).toPresentation).hom ≫
        (toSemanticCart first.toPresentation).hom =
      (toSemanticCart (pullbackSndPresentation first second).toPresentation).hom ≫
        (toSemanticCart second.toPresentation).hom := by
  apply ExtInstHom.ext
  apply ExactDoctrineHom.ext
  · funext input
    exact (compatibleSourceEquiv first second input).property
  · change AtomPermutationCode.refl.toEquiv.trans first.atomEquiv.toEquiv =
      (first.atomEquiv.trans second.atomEquiv.symm).toEquiv.trans
        second.atomEquiv.toEquiv
    rw [AtomPermutationCode.toEquiv_refl,
      AtomPermutationCode.toEquiv_trans,
      AtomPermutationCode.toEquiv_symm]
    apply Equiv.ext
    intro atom
    simp

/-- Compatible source pair induced by an arbitrary semantic cone. -/
def compatibleSourceOfCone
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {left right base : FiniteInstanceCode U}
    (first : CartPresentationBetween left base)
    (second : CartPresentationBetween right base)
    (cone : PullbackCone
      (toSemanticCart first.toPresentation).hom
      (toSemanticCart second.toPresentation).hom)
    (input : cone.pt.doctrine.Source) : CompatibleSource first second :=
  ⟨(cone.fst.doctrineHom.sourceMap input,
    cone.snd.doctrineHom.sourceMap input), by
    have hmaps := congrArg
      (fun hom => hom.doctrineHom.sourceMap input) cone.condition
    change first.sourceMap (cone.fst.doctrineHom.sourceMap input) =
      second.sourceMap (cone.snd.doctrineHom.sourceMap input) at hmaps
    exact hmaps⟩

/--
Universal semantic lift into the generated compatible-pair object.  Both
source-table components come from the cone; the Atom component is forced by
the first leg and the cospan equation.
-/
noncomputable def pullbackSemanticLift
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {left right base : FiniteInstanceCode U}
    (first : CartPresentationBetween left base)
    (second : CartPresentationBetween right base)
    (cone : PullbackCone
      (toSemanticCart first.toPresentation).hom
      (toSemanticCart second.toPresentation).hom) :
    cone.pt ⟶ (pullbackInstanceCode first second).toSemantic where
  doctrineHom :=
    { sourceMap := fun input =>
        (compatibleSourceEquiv first second).symm
          (compatibleSourceOfCone first second cone input)
      atomEquiv := cone.fst.doctrineHom.atomEquiv
      normalize_eq := by
        intro input
        dsimp only [FiniteInstanceCode.toSemantic,
          FiniteDoctrineCode.toDoctrine, pullbackInstanceCode]
        apply (compatibleSourceEquiv first second).injective
        apply Subtype.ext
        apply Prod.ext
        · change
            (compatibleSourceEquiv first second
              ((pullbackDoctrineCode first second).normalize
                ((compatibleSourceEquiv first second).symm
                  (compatibleSourceOfCone first second cone input)))).val.1 =
              (compatibleSourceEquiv first second
                ((compatibleSourceEquiv first second).symm
                  (compatibleSourceOfCone first second cone
                    (cone.pt.doctrine.normalize input)))).val.1
          rw [pullbackDoctrineCode_normalize_fst]
          simp only [Equiv.apply_symm_apply]
          exact cone.fst.doctrineHom.normalize_eq input
        · change
            (compatibleSourceEquiv first second
              ((pullbackDoctrineCode first second).normalize
                ((compatibleSourceEquiv first second).symm
                  (compatibleSourceOfCone first second cone input)))).val.2 =
              (compatibleSourceEquiv first second
                ((compatibleSourceEquiv first second).symm
                  (compatibleSourceOfCone first second cone
                    (cone.pt.doctrine.normalize input)))).val.2
          rw [pullbackDoctrineCode_normalize_snd]
          simp only [Equiv.apply_symm_apply]
          exact cone.snd.doctrineHom.normalize_eq input
      extraction_iff := by
        intro input atom
        change cone.pt.doctrine.extracts input atom ↔
          (pullbackDoctrineCode first second).toDoctrine.extracts
            ((compatibleSourceEquiv first second).symm
              (compatibleSourceOfCone first second cone input))
            (cone.fst.doctrineHom.atomEquiv atom)
        rw [pullbackDoctrineCode_extracts_iff]
        simp only [Equiv.apply_symm_apply]
        exact cone.fst.doctrineHom.extraction_iff input atom }
  source_eq := by
    dsimp only [FiniteInstanceCode.toSemantic, pullbackInstanceCode]
    apply (compatibleSourceEquiv first second).injective
    apply Subtype.ext
    apply Prod.ext
    · simp only [Equiv.apply_symm_apply]
      exact cone.fst.source_eq
    · simp only [Equiv.apply_symm_apply]
      exact cone.snd.source_eq

/-- The universal semantic lift factors through the first generated projection. -/
theorem pullbackSemanticLift_fst
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {left right base : FiniteInstanceCode U}
    (first : CartPresentationBetween left base)
    (second : CartPresentationBetween right base)
    (cone : PullbackCone
      (toSemanticCart first.toPresentation).hom
      (toSemanticCart second.toPresentation).hom) :
    pullbackSemanticLift first second cone ≫
        (toSemanticCart
          (pullbackFstPresentation first second).toPresentation).hom =
      cone.fst := by
  apply ExtInstHom.ext
  apply ExactDoctrineHom.ext
  · funext input
    change
      (compatibleSourceEquiv first second
        ((compatibleSourceEquiv first second).symm
          (compatibleSourceOfCone first second cone input))).val.1 =
        cone.fst.doctrineHom.sourceMap input
    simp [compatibleSourceOfCone]
  · change cone.fst.doctrineHom.atomEquiv.trans
      AtomPermutationCode.refl.toEquiv = cone.fst.doctrineHom.atomEquiv
    rw [AtomPermutationCode.toEquiv_refl]
    apply Equiv.ext
    intro atom
    rfl

/-- The universal semantic lift factors through the second generated projection. -/
theorem pullbackSemanticLift_snd
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {left right base : FiniteInstanceCode U}
    (first : CartPresentationBetween left base)
    (second : CartPresentationBetween right base)
    (cone : PullbackCone
      (toSemanticCart first.toPresentation).hom
      (toSemanticCart second.toPresentation).hom) :
    pullbackSemanticLift first second cone ≫
        (toSemanticCart
          (pullbackSndPresentation first second).toPresentation).hom =
      cone.snd := by
  apply ExtInstHom.ext
  apply ExactDoctrineHom.ext
  · funext input
    change
      (compatibleSourceEquiv first second
        ((compatibleSourceEquiv first second).symm
          (compatibleSourceOfCone first second cone input))).val.2 =
        cone.snd.doctrineHom.sourceMap input
    simp [compatibleSourceOfCone]
  · have hatom := congrArg
      (fun hom => hom.doctrineHom.atomEquiv) cone.condition
    change cone.fst.doctrineHom.atomEquiv.trans first.atomEquiv.toEquiv =
      cone.snd.doctrineHom.atomEquiv.trans second.atomEquiv.toEquiv at hatom
    change cone.fst.doctrineHom.atomEquiv.trans
        (first.atomEquiv.trans second.atomEquiv.symm).toEquiv =
      cone.snd.doctrineHom.atomEquiv
    rw [AtomPermutationCode.toEquiv_trans,
      AtomPermutationCode.toEquiv_symm]
    apply Equiv.ext
    intro atom
    have hpoint := congrArg (fun equiv : Equiv.Perm U.Atom => equiv atom) hatom
    change first.atomEquiv.toEquiv
        (cone.fst.doctrineHom.atomEquiv atom) =
      second.atomEquiv.toEquiv
        (cone.snd.doctrineHom.atomEquiv atom) at hpoint
    change second.atomEquiv.toEquiv.symm
        (first.atomEquiv.toEquiv
          (cone.fst.doctrineHom.atomEquiv atom)) =
      cone.snd.doctrineHom.atomEquiv atom
    rw [hpoint, Equiv.symm_apply_apply]

/-- Any semantic map with the two required projection equations is the generated lift. -/
theorem pullbackSemanticLift_unique
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {left right base : FiniteInstanceCode U}
    (first : CartPresentationBetween left base)
    (second : CartPresentationBetween right base)
    (cone : PullbackCone
      (toSemanticCart first.toPresentation).hom
      (toSemanticCart second.toPresentation).hom)
    (candidate : cone.pt ⟶ (pullbackInstanceCode first second).toSemantic)
    (hfst : candidate ≫
      (toSemanticCart
        (pullbackFstPresentation first second).toPresentation).hom = cone.fst)
    (hsnd : candidate ≫
      (toSemanticCart
        (pullbackSndPresentation first second).toPresentation).hom = cone.snd) :
    candidate = pullbackSemanticLift first second cone := by
  apply ExtInstHom.ext
  apply ExactDoctrineHom.ext
  · funext input
    apply (compatibleSourceEquiv first second).injective
    apply Subtype.ext
    apply Prod.ext
    · have hmap := congrArg
        (fun hom => hom.doctrineHom.sourceMap input) hfst
      change
        (compatibleSourceEquiv first second
          (candidate.doctrineHom.sourceMap input)).val.1 =
          cone.fst.doctrineHom.sourceMap input at hmap
      simpa [pullbackSemanticLift, compatibleSourceOfCone] using hmap
    · have hmap := congrArg
        (fun hom => hom.doctrineHom.sourceMap input) hsnd
      change
        (compatibleSourceEquiv first second
          (candidate.doctrineHom.sourceMap input)).val.2 =
          cone.snd.doctrineHom.sourceMap input at hmap
      simpa [pullbackSemanticLift, compatibleSourceOfCone] using hmap
  · have hatom := congrArg
      (fun hom => hom.doctrineHom.atomEquiv) hfst
    change candidate.doctrineHom.atomEquiv.trans
        AtomPermutationCode.refl.toEquiv =
      cone.fst.doctrineHom.atomEquiv at hatom
    rw [AtomPermutationCode.toEquiv_refl] at hatom
    apply Equiv.ext
    intro atom
    exact congrArg (fun equiv : Equiv.Perm U.Atom => equiv atom) hatom

/--
The generated finite-code projection square is a categorical pullback in
`ExtInst_U`; the universal property is constructed from arbitrary semantic
cones, not only finite-code cones.
-/
theorem pullbackPresentation_isPullback
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {left right base : FiniteInstanceCode U}
    (first : CartPresentationBetween left base)
    (second : CartPresentationBetween right base) :
    IsPullback
      (toSemanticCart
        (pullbackFstPresentation first second).toPresentation).hom
      (toSemanticCart
        (pullbackSndPresentation first second).toPresentation).hom
      (toSemanticCart first.toPresentation).hom
      (toSemanticCart second.toPresentation).hom := by
  apply IsPullback.of_isLimit'
    ⟨pullbackPresentation_commutes first second⟩
  refine PullbackCone.IsLimit.mk _
    (fun cone => pullbackSemanticLift first second cone) ?_ ?_ ?_
  · intro cone
    exact pullbackSemanticLift_fst first second cone
  · intro cone
    exact pullbackSemanticLift_snd first second cone
  · intro cone candidate hfst hsnd
    exact pullbackSemanticLift_unique first second cone candidate hfst hsnd

/--
The projections produced inside the typed code calculus realize to the same
categorical pullback square.  This is the precise realization-image closure
statement: the input diagram shares authored code objects, while universality
is tested against every semantic cone after applying the realization functor.
-/
theorem finiteCodeCartRealization_pullback_isPullback
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {left right base : FiniteInstanceCode U}
    (first : CartPresentationBetween left base)
    (second : CartPresentationBetween right base) :
    IsPullback
      (finiteCodeCartRealization.map
        (FiniteCodeCartHom.ofPresentation
          (pullbackFstPresentation first second)))
      (finiteCodeCartRealization.map
        (FiniteCodeCartHom.ofPresentation
          (pullbackSndPresentation first second)))
      (finiteCodeCartRealization.map
        (FiniteCodeCartHom.ofPresentation first))
      (finiteCodeCartRealization.map
        (FiniteCodeCartHom.ofPresentation second)) :=
  pullbackPresentation_isPullback first second

/-! ## Fixed cartesian condition language -/

/-- A first-order table between finite source codes. -/
structure SourceTableValue where
  /-- Cardinality of the table domain. -/
  domainCard : ℕ
  /-- Cardinality of the table codomain. -/
  codomainCard : ℕ
  /-- Output indices in canonical domain order. -/
  values : List ℕ
deriving DecidableEq

/-- A finite-support Atom table in canonical support order. -/
structure AtomTableValue (U : AtomCarrier.{u}) where
  /-- Authored finite support. -/
  support : Finset U.Atom
  /-- Finite graph of input/output cells on the support. -/
  values : Finset (U.Atom × U.Atom)

/-- Equality of finite-support Atom table values is executable. -/
instance atomTableValueDecidableEq {U : AtomCarrier.{u}}
    [DecidableEq U.Atom] : DecidableEq (AtomTableValue U) := by
  intro first second
  cases first
  cases second
  simp only [AtomTableValue.mk.injEq]
  infer_instance

/-- Operand sorts of the completely enumerated cartesian field vocabulary. -/
inductive CartFieldKind
  | natural
  | sourceTable
  | boolTable
  | atomSetTable
  | atomSet
  | atomTable

/-- Value type of each fixed operand sort. -/
def CartFieldValue (U : AtomCarrier.{u}) : CartFieldKind → Type u
  | .natural => ULift ℕ
  | .sourceTable => ULift SourceTableValue
  | .boolTable => ULift (List Bool)
  | .atomSetTable => List (Finset U.Atom)
  | .atomSet => Finset U.Atom
  | .atomTable => AtomTableValue U

/-- Equality at every operand sort is executable from presentation instances. -/
instance cartFieldValueDecidableEq {U : AtomCarrier.{u}}
    [DecidableEq U.Atom] (kind : CartFieldKind) :
    DecidableEq (CartFieldValue U kind) := by
  cases kind <;> simp only [CartFieldValue] <;> infer_instance

/-- Enumerate a first-order finite source type in its canonical `Fin` order. -/
def finiteSourceCells (card : ℕ) : List (FiniteSource.{u} card) :=
  (List.finRange card).map ULift.up

/-- Encode an arbitrary source-map table as first-order natural-number cells. -/
def sourceTableValue (_U : AtomCarrier.{u}) (domainCard codomainCard : ℕ)
    (table : FiniteSource.{u} domainCard → FiniteSource.{u} codomainCard) :
    SourceTableValue where
  domainCard := domainCard
  codomainCard := codomainCard
  values := (finiteSourceCells domainCard).map
    (fun source => (table source).down.val)

/-- Source and target sides of the two authored instance-code fields. -/
inductive CartEndpoint
  | source
  | target

/--
Complete projection list for the four authored fields.  Endpoint projections
read every component of the two instance codes; the last three projections read
the complete source-map and Atom-permutation tables.
-/
inductive CartProjection (U : AtomCarrier.{u}) : CartFieldKind → Type u
  | sourceCard : CartProjection U .natural
  | targetCard : CartProjection U .natural
  | sourcePoint : CartProjection U .natural
  | targetPoint : CartProjection U .natural
  | sourceNormalize : CartProjection U .sourceTable
  | targetNormalize : CartProjection U .sourceTable
  | sourceExtractionDefaults : CartProjection U .boolTable
  | targetExtractionDefaults : CartProjection U .boolTable
  | sourceExtractionExceptions : CartProjection U .atomSetTable
  | targetExtractionExceptions : CartProjection U .atomSetTable
  | sourceMap : CartProjection U .sourceTable
  | atomSupport : CartProjection U .atomSet
  | atomMap : CartProjection U .atomTable

/-- The only named constants allowed by the fixed cartesian vocabulary. -/
inductive CartNamedConstant (U : AtomCarrier.{u}) : CartFieldKind → Type u
  | identitySourceMap : CartNamedConstant U .sourceTable
  | identityAtomMap : CartNamedConstant U .atomTable
  | emptyAtomSupport : CartNamedConstant U .atomSet

/-- Field projections and the three permitted named constants are the only terms. -/
inductive CartFieldTerm (U : AtomCarrier.{u}) : CartFieldKind → Type u
  | projection {kind : CartFieldKind}
      (field : CartProjection U kind) : CartFieldTerm U kind
  | constant {kind : CartFieldKind}
      (constant : CartNamedConstant U kind) : CartFieldTerm U kind

/-- Read one endpoint doctrine from a raw presentation. -/
def cartEndpointDoctrine {U : AtomCarrier.{u}}
    (endpoint : CartEndpoint) (code : CartRawCode U) : FiniteDoctrineCode U :=
  match endpoint with
  | .source => code.source.doctrine
  | .target => code.target.doctrine

/-- Read one endpoint's selected source as a first-order natural index. -/
def cartEndpointPoint {U : AtomCarrier.{u}}
    (endpoint : CartEndpoint) (code : CartRawCode U) : ℕ :=
  match endpoint with
  | .source => code.source.point.down.val
  | .target => code.target.point.down.val

/-- Encode a doctrine's normalization table. -/
def doctrineNormalizeTable {U : AtomCarrier.{u}}
    (code : FiniteDoctrineCode U) : SourceTableValue :=
  sourceTableValue U code.sourceCard code.sourceCard code.normalize

/-- Encode all default bits in a doctrine's extraction table. -/
def doctrineExtractionDefaults {U : AtomCarrier.{u}}
    (code : FiniteDoctrineCode U) : List Bool :=
  (finiteSourceCells code.sourceCard).map
    (fun source => (code.extraction source).defaultValue)

/-- Encode all finite exception supports in a doctrine's extraction table. -/
def doctrineExtractionExceptions {U : AtomCarrier.{u}}
    (code : FiniteDoctrineCode U) : List (Finset U.Atom) :=
  (finiteSourceCells code.sourceCard).map
    (fun source => (code.extraction source).exceptions)

/-- Encode the complete finite-support Atom permutation table. -/
def atomTableValue {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : AtomPermutationCode U) : AtomTableValue U where
  support := code.support
  values := code.support.image (fun atom => (atom, code.toEquiv atom))

/-- Evaluate any fixed projection on the four raw authored fields. -/
def readCartProjection {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {kind : CartFieldKind} (projection : CartProjection U kind)
    (presentation : CartPresentation U) : CartFieldValue U kind :=
  match projection with
  | .sourceCard => ULift.up presentation.1.source.doctrine.sourceCard
  | .targetCard => ULift.up presentation.1.target.doctrine.sourceCard
  | .sourcePoint => ULift.up presentation.1.source.point.down.val
  | .targetPoint => ULift.up presentation.1.target.point.down.val
  | .sourceNormalize =>
      ULift.up (doctrineNormalizeTable presentation.1.source.doctrine)
  | .targetNormalize =>
      ULift.up (doctrineNormalizeTable presentation.1.target.doctrine)
  | .sourceExtractionDefaults =>
      ULift.up (doctrineExtractionDefaults presentation.1.source.doctrine)
  | .targetExtractionDefaults =>
      ULift.up (doctrineExtractionDefaults presentation.1.target.doctrine)
  | .sourceExtractionExceptions =>
      doctrineExtractionExceptions presentation.1.source.doctrine
  | .targetExtractionExceptions =>
      doctrineExtractionExceptions presentation.1.target.doctrine
  | .sourceMap => ULift.up (sourceTableValue U
      presentation.1.source.doctrine.sourceCard
      presentation.1.target.doctrine.sourceCard presentation.1.sourceMap)
  | .atomSupport => presentation.1.atomEquiv.support
  | .atomMap => atomTableValue presentation.1.atomEquiv

/-- Interpret one of the three allowed named constants relative to a presentation. -/
def readCartNamedConstant {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {kind : CartFieldKind} (constant : CartNamedConstant U kind)
    (presentation : CartPresentation U) : CartFieldValue U kind :=
  match constant with
  | .identitySourceMap => ULift.up (sourceTableValue U
      presentation.1.source.doctrine.sourceCard
      presentation.1.source.doctrine.sourceCard id)
  | .identityAtomMap =>
      ({ support := ∅
         values := ∅ } : AtomTableValue U)
  | .emptyAtomSupport => (∅ : Finset U.Atom)

/-- Evaluate one field term without consulting a lift, mate, or checker result. -/
def evalCartFieldTerm {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {kind : CartFieldKind} (term : CartFieldTerm U kind)
    (presentation : CartPresentation U) : CartFieldValue U kind :=
  match term with
  | .projection projection => readCartProjection projection presentation
  | .constant constant => readCartNamedConstant constant presentation

/-- Presentation-derived finite sets available to membership atoms. -/
inductive CartDerivedSet
  | sourceCells
  | targetCells
  | sourceMapImage
  | selectedSource
  | selectedTarget

/-- Evaluate one presentation-derived finite set of first-order source indices. -/
def evalCartDerivedSet {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (set : CartDerivedSet) (presentation : CartPresentation U) : Finset ℕ :=
  match set with
  | .sourceCells => Finset.range presentation.1.source.doctrine.sourceCard
  | .targetCells => Finset.range presentation.1.target.doctrine.sourceCard
  | .sourceMapImage =>
      ((finiteSourceCells presentation.1.source.doctrine.sourceCard).map
        (fun source => (presentation.1.sourceMap source).down.val)).toFinset
  | .selectedSource => {presentation.1.source.point.down.val}
  | .selectedTarget => {presentation.1.target.point.down.val}

/-- The fully enumerated finite-universal equality atoms. -/
inductive CartUniversalEquality
  | sourceMapNormalize
  | sourceMapIdentity
  | atomMapIdentity
  | sourceNormalizeIdentity
  | targetNormalizeIdentity
  | extractionDefaultsPreserved
  | extractionExceptionsPreserved

/-- Evaluate a finite universal equality over actual presentation cells. -/
def evalCartUniversalEquality {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (equality : CartUniversalEquality)
    (presentation : CartPresentation U) : Bool :=
  match equality with
  | .sourceMapNormalize =>
      decide (∀ source : presentation.1.source.doctrine.Source,
          (presentation.1.target.doctrine.normalize
              (presentation.1.sourceMap source) =
            presentation.1.sourceMap
              (presentation.1.source.doctrine.normalize source)))
  | .sourceMapIdentity =>
      decide (presentation.1.source.doctrine.sourceCard =
        presentation.1.target.doctrine.sourceCard) &&
      decide (∀ source : presentation.1.source.doctrine.Source,
        (presentation.1.sourceMap source).down.val = source.down.val)
  | .atomMapIdentity =>
      decide (∀ atom ∈ presentation.1.atomEquiv.support,
        presentation.1.atomEquiv.toEquiv atom = atom)
  | .sourceNormalizeIdentity =>
      decide (∀ source : presentation.1.source.doctrine.Source,
        presentation.1.source.doctrine.normalize source = source)
  | .targetNormalizeIdentity =>
      decide (∀ source : presentation.1.target.doctrine.Source,
        presentation.1.target.doctrine.normalize source = source)
  | .extractionDefaultsPreserved =>
      decide (∀ source : presentation.1.source.doctrine.Source,
          ((presentation.1.target.doctrine.extraction
              (presentation.1.target.doctrine.normalize
                (presentation.1.sourceMap source))).defaultValue =
            (presentation.1.source.doctrine.extraction
              (presentation.1.source.doctrine.normalize source)).defaultValue))
  | .extractionExceptionsPreserved =>
      decide (∀ source : presentation.1.source.doctrine.Source,
          ((presentation.1.target.doctrine.extraction
              (presentation.1.target.doctrine.normalize
                (presentation.1.sourceMap source))).exceptions =
            ((presentation.1.source.doctrine.extraction
              (presentation.1.source.doctrine.normalize source)).transport
                presentation.1.atomEquiv.toEquiv).exceptions))

/--
The complete four-constructor condition syntax fixed by G-110.  It contains
only typed field equality, membership in a presentation-derived finite set,
finite universal equality, and conjunction.
-/
inductive CartConditionSyntax (U : AtomCarrier.{u})
  | fieldEq {kind : CartFieldKind}
      (left right : CartFieldTerm U kind)
  | fieldMem (field : CartFieldTerm U .natural) (set : CartDerivedSet)
  | allCells (equality : CartUniversalEquality)
  | conjunction (left right : CartConditionSyntax U)

/-- Evaluate the fixed syntax solely from finite authored fields. -/
def evalCartCondition {U : AtomCarrier.{u}} [DecidableEq U.Atom] :
    CartConditionSyntax U → CartPresentation U → Bool
  | .fieldEq left right, presentation =>
      decide (evalCartFieldTerm left presentation =
        evalCartFieldTerm right presentation)
  | .fieldMem field set, presentation =>
      decide ((evalCartFieldTerm field presentation).down ∈
        evalCartDerivedSet set presentation)
  | .allCells equality, presentation =>
      evalCartUniversalEquality equality presentation
  | .conjunction left right, presentation =>
      evalCartCondition left presentation &&
        evalCartCondition right presentation

/-- The finite Atom-identity universal has its exact semantic characterization. -/
theorem evalCartCondition_atomMapIdentity_eq_true_iff
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : CartPresentation U) :
    evalCartCondition (.allCells .atomMapIdentity) presentation = true ↔
      presentation.1.atomEquiv.toEquiv = Equiv.refl U.Atom := by
  simp only [evalCartCondition, evalCartUniversalEquality,
    decide_eq_true_eq]
  constructor
  · intro h
    apply Equiv.ext
    intro atom
    by_cases hmem : atom ∈ presentation.1.atomEquiv.support
    · simpa using h atom hmem
    · simpa using presentation.1.atomEquiv.toEquiv_apply_not_mem atom hmem
  · intro h atom hmem
    simp [h]

/-- Semantic identity of the Atom component, stated on realization witnesses. -/
def IdentityAtomComponent {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (hom : RealizableHom U) : Prop :=
  hom.semantic.hom.doctrineHom.atomEquiv = Equiv.refl U.Atom

/--
The finite identity-Atom check has a non-definitional bridge to its semantic
predicate; the right side reads the decoded exact morphism rather than the
checker result.
-/
theorem evalCartCondition_atomMapIdentity_bridge
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : CartPresentation U) :
    evalCartCondition (.allCells .atomMapIdentity) presentation = true ↔
      IdentityAtomComponent (realizableHomOf presentation) := by
  rw [evalCartCondition_atomMapIdentity_eq_true_iff]
  rfl

/-- The identity-Atom check is invariant under replacement by the same semantic input. -/
theorem evalCartCondition_atomMapIdentity_replacement_invariant
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (first second : CartPresentation U)
    (hsame : toSemanticCart first = toSemanticCart second) :
    evalCartCondition (.allCells .atomMapIdentity) first =
      evalCartCondition (.allCells .atomMapIdentity) second := by
  apply Bool.eq_iff_iff.mpr
  rw [evalCartCondition_atomMapIdentity_eq_true_iff,
    evalCartCondition_atomMapIdentity_eq_true_iff]
  have hatom := congrArg
    (fun input : CartSemanticInput U => input.hom.doctrineHom.atomEquiv) hsame
  change first.1.atomEquiv.toEquiv = second.1.atomEquiv.toEquiv at hatom
  rw [hatom]

end AAT.AG.DoctrineFiberProduct

#assert_standard_axioms_only AAT.AG.DoctrineFiberProduct
