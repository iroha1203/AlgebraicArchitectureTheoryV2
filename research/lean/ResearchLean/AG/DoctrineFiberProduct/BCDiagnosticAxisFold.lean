import ResearchLean.AG.DoctrineFiberProduct.BCAuthoredFactorizationComparison

/-!
# A noninvertible fold generated by a diagnostic fiber automorphism

An object-fixing package-fiber automorphism that moves a signature axis gives
more than a permutation: its coordinate equivalence and selected-status law
allow the moved axis to be folded onto its image while every other structural
field stays at identity.  The resulting exact package endomorphism is not an
automorphism, because the moved axis and its distinct image acquire the same
image.

No endomorphism, noninvertibility certificate, comparison, or expected
equality is accepted from a caller.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open CategoryTheory
open AtomFoundation TransportCoherence

namespace PackageFiberAut

/-- An isomorphism of total packages acts injectively on signature axes. -/
theorem packageTotalHom_axisMap_injective_of_isIso
    {U : AtomCarrier.{u}} {P Q : AATCorePackage U}
    (hom : P ⟶ Q) [IsIso hom] :
    Function.Injective hom.upper.axisMap := by
  intro first second equality
  have leftInverse (axis : P.reading.signatureReading.Axis) :
      (inv hom).upper.axisMap (hom.upper.axisMap axis) = axis := by
    have identity := congrArg
      (fun total : PackageTotalHom P P => total.upper.axisMap axis)
      (IsIso.hom_inv_id hom)
    exact identity
  calc
    first = (inv hom).upper.axisMap (hom.upper.axisMap first) :=
      (leftInverse first).symm
    _ = (inv hom).upper.axisMap (hom.upper.axisMap second) :=
      congrArg _ equality
    _ = second := leftInverse second

/-- Data internally observable on an automorphism that supports one axis fold. -/
structure AxisFoldWitness
    {U : AtomCarrier.{u}} {P : AATCorePackage U}
    (automorphism : PackageFiberAut P) where
  /-- An axis moved by the diagnostic automorphism. -/
  source : P.reading.signatureReading.Axis
  /-- Decidable axis equality used coherently by the generated dependent fold. -/
  axisDecidableEq : DecidableEq P.reading.signatureReading.Axis
  /-- The selected axis is genuinely moved. -/
  moved :
    (PackageFiberAut.hom automorphism).upper.axisMap source ≠ source
  /-- The diagnostic action fixes architecture objects. -/
  objectMap_eq :
    (PackageFiberAut.hom automorphism).upper.objectMap = _root_.id

namespace AxisFoldWitness

/-- Fold the moved source axis onto its image and fix every other axis. -/
@[reducible]
noncomputable def axisMap
    {U : AtomCarrier.{u}} {P : AATCorePackage U}
    {automorphism : PackageFiberAut P}
    (witness : AxisFoldWitness automorphism) :
    P.reading.signatureReading.Axis →
      P.reading.signatureReading.Axis := by
  exact fun axis =>
    match witness.axisDecidableEq axis witness.source with
    | isTrue _ =>
        (PackageFiberAut.hom automorphism).upper.axisMap witness.source
    | isFalse _ => axis

/-- Away from the moved source, the fold fixes the axis. -/
@[simp]
theorem axisMap_of_ne
    {U : AtomCarrier.{u}} {P : AATCorePackage U}
    {automorphism : PackageFiberAut P}
    (witness : AxisFoldWitness automorphism)
    (axis : P.reading.signatureReading.Axis)
    (equality : axis ≠ witness.source) :
    witness.axisMap axis = axis := by
  unfold axisMap
  split
  · contradiction
  · rfl

/-- The moved source is sent to the diagnostic image axis. -/
@[simp]
theorem axisMap_source
    {U : AtomCarrier.{u}} {P : AATCorePackage U}
    {automorphism : PackageFiberAut P}
    (witness : AxisFoldWitness automorphism) :
    witness.axisMap witness.source =
      (PackageFiberAut.hom automorphism).upper.axisMap witness.source := by
  unfold axisMap
  split
  · rfl
  · contradiction

/--
The fold's dependent coordinate equivalence is generated by the diagnostic
automorphism at the moved axis and is identity elsewhere.
-/
noncomputable def coordinateData
    {U : AtomCarrier.{u}} {P : AATCorePackage U}
    {automorphism : PackageFiberAut P}
    (witness : AxisFoldWitness automorphism)
    (axis : P.reading.signatureReading.Axis) :
    { equivalence :
        P.reading.signatureReading.Coordinate axis ≃
          P.reading.signatureReading.Coordinate (witness.axisMap axis) //
      ∀ object : ArchitectureObject U,
        equivalence (P.reading.signatureReading.coordinate object axis) =
          P.reading.signatureReading.coordinate object (witness.axisMap axis) } := by
  by_cases equality : axis = witness.source
  · subst axis
    rw [witness.axisMap_source]
    refine ⟨
      (PackageFiberAut.hom automorphism).upper.coordinateEquiv witness.source,
      ?_⟩
    intro object
    simpa [witness.objectMap_eq] using
      (PackageFiberAut.hom automorphism).upper.coordinate_eq
        object witness.source
  · rw [witness.axisMap_of_ne axis equality]
    exact ⟨Equiv.refl _, by simp⟩

/-- The coordinate equivalence carried by the generated fold. -/
@[reducible]
noncomputable def coordinateEquiv
    {U : AtomCarrier.{u}} {P : AATCorePackage U}
    {automorphism : PackageFiberAut P}
    (witness : AxisFoldWitness automorphism)
    (axis : P.reading.signatureReading.Axis) :
    P.reading.signatureReading.Coordinate axis ≃
      P.reading.signatureReading.Coordinate (witness.axisMap axis) :=
  (witness.coordinateData axis).1

/-- The fold preserves and reflects the selected-axis predicate. -/
theorem axis_selected_iff
    {U : AtomCarrier.{u}} {P : AATCorePackage U}
    {automorphism : PackageFiberAut P}
    (witness : AxisFoldWitness automorphism)
    (axis : P.reading.signatureReading.Axis) :
    P.reading.signatureReading.selected axis ↔
      P.reading.signatureReading.selected (witness.axisMap axis) := by
  match decision : witness.axisDecidableEq axis witness.source with
  | isTrue equality =>
      subst axis
      simpa [axisMap, decision] using
        (PackageFiberAut.hom automorphism).upper.axis_selected_iff
          witness.source
  | isFalse _ =>
      simp [axisMap, decision]

/-- The fold transports the distinguished coordinate on every object. -/
theorem coordinate_eq
    {U : AtomCarrier.{u}} {P : AATCorePackage U}
    {automorphism : PackageFiberAut P}
    (witness : AxisFoldWitness automorphism)
    (object : ArchitectureObject U)
    (axis : P.reading.signatureReading.Axis) :
    witness.coordinateEquiv axis
        (P.reading.signatureReading.coordinate object axis) =
      P.reading.signatureReading.coordinate object (witness.axisMap axis) :=
  (witness.coordinateData axis).2 object

/-- The complete exact upper endomorphism generated by the one-axis fold. -/
noncomputable def upper
    {U : AtomCarrier.{u}} {P : AATCorePackage U}
    {automorphism : PackageFiberAut P}
    (witness : AxisFoldWitness automorphism) :
    SignedExactCoreReadingHom P P :=
  { SignedExactCoreReadingHom.refl P with
    axisMap := witness.axisMap
    coordinateEquiv := witness.coordinateEquiv
    axis_selected_iff := witness.axis_selected_iff
    coordinate_eq := witness.coordinate_eq }

/-- The fold as a total package endomorphism over the identity base. -/
noncomputable def total
    {U : AtomCarrier.{u}} {P : AATCorePackage U}
    {automorphism : PackageFiberAut P}
    (witness : AxisFoldWitness automorphism) :
    PackageTotalHom P P where
  base := ExtInstHom.id (packagePoint P)
  upper := witness.upper
  atomEquiv_eq := rfl

/-- The diagnostic image axis is fixed by the fold. -/
theorem axisMap_image
    {U : AtomCarrier.{u}} {P : AATCorePackage U}
    {automorphism : PackageFiberAut P}
    (witness : AxisFoldWitness automorphism) :
    witness.axisMap
        ((PackageFiberAut.hom automorphism).upper.axisMap witness.source) =
      (PackageFiberAut.hom automorphism).upper.axisMap witness.source := by
  simp [axisMap, witness.moved]

/-- The generated fold is noninjective on signature axes. -/
theorem not_injective_axisMap
    {U : AtomCarrier.{u}} {P : AATCorePackage U}
    {automorphism : PackageFiberAut P}
    (witness : AxisFoldWitness automorphism) :
    ¬ Function.Injective witness.axisMap := by
  intro injective
  apply witness.moved
  apply injective
  rw [witness.axisMap_source, witness.axisMap_image]

/-- The generated fold is not an isomorphism of total packages. -/
theorem total_not_isIso
    {U : AtomCarrier.{u}} {P : AATCorePackage U}
    {automorphism : PackageFiberAut P}
    (witness : AxisFoldWitness automorphism) :
    ¬ IsIso (show P ⟶ P from witness.total) := by
  intro isIso
  letI : IsIso (show P ⟶ P from witness.total) := isIso
  exact witness.not_injective_axisMap
    (packageTotalHom_axisMap_injective_of_isIso witness.total)

end AxisFoldWitness

/-- Intrinsic availability of a moved, object-fixing axis in a diagnostic value. -/
abbrev AxisFoldAvailable
    {U : AtomCarrier.{u}} {P : AATCorePackage U}
    (automorphism : PackageFiberAut P) :=
  Nonempty (AxisFoldWitness automorphism)

/--
Generate a total endomorphism from the diagnostic value alone.  When a moved
object-fixing axis exists, choose such an axis and fold it; otherwise use the
identity.  No endomorphism or noninvertibility certificate is supplied by a
caller.
-/
noncomputable def generatedAxisFoldTotal
    {U : AtomCarrier.{u}} {P : AATCorePackage U}
    (automorphism : PackageFiberAut P) : PackageTotalHom P P := by
  classical
  exact if available : AxisFoldAvailable automorphism then
      (Classical.choice available).total
    else
      PackageTotalHom.id P

/-- The generated diagnostic fold always lies over the identity base. -/
theorem generatedAxisFoldTotal_base
    {U : AtomCarrier.{u}} {P : AATCorePackage U}
    (automorphism : PackageFiberAut P) :
    (generatedAxisFoldTotal automorphism).base = 𝟙 (packagePoint P) := by
  classical
  by_cases available : AxisFoldAvailable automorphism
  · rw [generatedAxisFoldTotal, dif_pos available]
    change ExtInstHom.id (packagePoint P) = ExtInstHom.id (packagePoint P)
    rfl
  · rw [generatedAxisFoldTotal, dif_neg available]
    change ExtInstHom.id (packagePoint P) = ExtInstHom.id (packagePoint P)
    rfl

/-- Availability forces the generated endomorphism to be noninvertible. -/
theorem generatedAxisFoldTotal_not_isIso
    {U : AtomCarrier.{u}} {P : AATCorePackage U}
    (automorphism : PackageFiberAut P)
    (available : AxisFoldAvailable automorphism) :
    ¬ IsIso (show P ⟶ P from generatedAxisFoldTotal automorphism) := by
  classical
  rw [generatedAxisFoldTotal, dif_pos available]
  exact (Classical.choice available).total_not_isIso

/-- The identity diagnostic has no moved axis supporting a fold. -/
theorem not_axisFoldAvailable_one
    {U : AtomCarrier.{u}} {P : AATCorePackage U} :
    ¬ AxisFoldAvailable (1 : PackageFiberAut P) := by
  rintro ⟨witness⟩
  apply witness.moved
  rfl

/-- Consequently the diagnostic fold specializes strictly to identity. -/
theorem generatedAxisFoldTotal_one
    {U : AtomCarrier.{u}} {P : AATCorePackage U} :
    generatedAxisFoldTotal (1 : PackageFiberAut P) =
      PackageTotalHom.id P := by
  classical
  simp [generatedAxisFoldTotal, not_axisFoldAvailable_one]

end PackageFiberAut

end AAT.AG.DoctrineFiberProduct

#assert_standard_axioms_only AAT.AG.DoctrineFiberProduct
