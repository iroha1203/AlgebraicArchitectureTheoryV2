import ResearchLean.AG.DoctrineFiberProduct.BCDiagnosticPastingCoherence
import ResearchLean.AG.DoctrineFiberProduct.BCPastingSchema

/-!
# Actual pasted-route diagnostic composition compatibility

This module packages the G-110(E) `(d2)`--`(d6)` composition laws and then
specializes them to both generated factors of the actual direct and via-base
Beck--Chevalley routes.  The final two declarations instantiate that package
on the horizontal and vertical outer pasted presentations, using exactly the
ordinary interpretation and southwest source-fiber incidence required by the
fixed G-110(D) domain.

No target comparator, mapped reselection, coherence proof, or vanishing
certificate is supplied: every target field and proof is generated by the
two core-fiber functors selected by the pasted Beck--Chevalley square.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open CategoryTheory
open AtomFoundation CrossStageCoherence TransportCoherence

/-- The first generated factor of the actual direct Beck--Chevalley route. -/
noncomputable def bcDiagnosticDirectFirstFunctor
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U) :=
  selectedCoreFiberReindexFunctor
    (typedRealizableHom (bcLeftPresentation presentation))

/-- The second generated factor of the actual direct Beck--Chevalley route. -/
noncomputable def bcDiagnosticDirectSecondFunctor
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U) :=
  coreFiberTransportFunctor
    (typedPresentationToSemantic (bcTopPresentation presentation))

/-- The first generated factor of the actual via-base Beck--Chevalley route. -/
noncomputable def bcDiagnosticViaBaseFirstFunctor
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U) :=
  coreFiberTransportFunctor
    (typedPresentationToSemantic (bcBottomPresentation presentation))

/-- The second generated factor of the actual via-base Beck--Chevalley route. -/
noncomputable def bcDiagnosticViaBaseSecondFunctor
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U) :=
  selectedCoreFiberReindexFunctor
    (typedRealizableHom (bcRightPresentation presentation))

/-- Public factorization equation for the actual direct diagnostic route. -/
theorem bcDiagnosticDirectFunctor_eq_factors
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U) :
    bcDiagnosticDirectFunctor presentation =
      bcDiagnosticDirectFirstFunctor presentation ⋙
        bcDiagnosticDirectSecondFunctor presentation := rfl

/-- Public factorization equation for the actual via-base diagnostic route. -/
theorem bcDiagnosticViaBaseFunctor_eq_factors
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U) :
    bcDiagnosticViaBaseFunctor presentation =
      bcDiagnosticViaBaseFirstFunctor presentation ⋙
        bcDiagnosticViaBaseSecondFunctor presentation := rfl

/-- A complete two-stage `(d2)`--`(d6)` compatibility certificate generated
from source fiberwise data and two composable core-fiber functors.  This is an
output proposition; none of its fields occurs in a source input structure. -/
structure BCDiagnosticCompositionCompatibility
    {G : FiniteTransportPresentation.{u}} {U : AtomCarrier.{u}}
    {X Y Z : ExtractionInstance U}
    (data : FiberwiseAdmissibleTransportData G U X)
    (F : CoreFiber X ⥤ CoreFiber Y)
    (H : CoreFiber Y ⥤ CoreFiber Z) : Prop where
  /-- `(d2)`: endpoint group action is compatible with composition. -/
  endpointAction_comp : ∀ P,
    coreFiberFunctorPackageAutHom (F ⋙ H) P =
      (coreFiberFunctorPackageAutHom H (F.obj P)).comp
        (coreFiberFunctorPackageAutHom F P)
  /-- `(d3)`: the full transported diagnostic datum is generated successively. -/
  transported_comp : data.transported (F ⋙ H) =
    (data.map F).transported H
  /-- `(d4)`: canonical mapped reselection is generated successively. -/
  mappedReselection_comp : ∀ reselection,
    mapEdgeReselection data (F ⋙ H) reselection =
      mapEdgeReselection (data.map F) H
        (mapEdgeReselection data F reselection)
  /-- `(d5)`: source coherence generates both successive target coherences. -/
  coherentAt_comp : ∀ reselection,
    CoherentAt data.toTransportData reselection →
      CoherentAt ((data.map F).transported H)
        (mapEdgeReselection (data.map F) H
          (mapEdgeReselection data F reselection))
  /-- `(d6)`: source obstruction vanishing generates successive vanishing. -/
  vanishing_comp : TransportObstructionVanishes data.toTransportData →
    TransportObstructionVanishes ((data.map F).transported H)

/-- Construct all `(d2)`--`(d6)` composition fields from the common generated
functorial action. -/
theorem diagnosticCompositionCompatibility
    {G : FiniteTransportPresentation.{u}} {U : AtomCarrier.{u}}
    {X Y Z : ExtractionInstance U}
    (data : FiberwiseAdmissibleTransportData G U X)
    (F : CoreFiber X ⥤ CoreFiber Y)
    (H : CoreFiber Y ⥤ CoreFiber Z) :
    BCDiagnosticCompositionCompatibility data F H where
  endpointAction_comp := coreFiberFunctorPackageAutHom_comp F H
  transported_comp := fiberwiseAdmissibleTransportData_transported_comp data F H
  mappedReselection_comp := mapEdgeReselection_comp data F H
  coherentAt_comp := coherentAt_map_comp data F H
  vanishing_comp := transportObstructionVanishes_map_comp data F H

/-- `(d2)`--`(d6)` composition compatibility for the two generated factors of
one actual direct Beck--Chevalley route. -/
theorem bcDiagnosticDirectCompositionCompatibility
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U)
    {G : FiniteTransportPresentation.{u}}
    (data : FiberwiseAdmissibleTransportData G U
      presentation.1.cospan.firstSource.toSemantic) :
    BCDiagnosticCompositionCompatibility data
      (bcDiagnosticDirectFirstFunctor presentation)
      (bcDiagnosticDirectSecondFunctor presentation) :=
  diagnosticCompositionCompatibility _ _ _

/-- `(d2)`--`(d6)` composition compatibility for the two generated factors of
one actual via-base Beck--Chevalley route. -/
theorem bcDiagnosticViaBaseCompositionCompatibility
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U)
    {G : FiniteTransportPresentation.{u}}
    (data : FiberwiseAdmissibleTransportData G U
      presentation.1.cospan.firstSource.toSemantic) :
    BCDiagnosticCompositionCompatibility data
      (bcDiagnosticViaBaseFirstFunctor presentation)
      (bcDiagnosticViaBaseSecondFunctor presentation) :=
  diagnosticCompositionCompatibility _ _ _

/-- G-110(E), horizontal case: the ordinary source-fiber-qualified diagnostic
on the generated outer horizontal pasted square has both actual direct and
via-base `(d2)`--`(d6)` composition packages. -/
theorem horizontalPastedBCDiagnosticCompositionCompatibility
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (pasting : HorizontalBCPastingData U)
    (interpretation : BCDiagnosticInterpretation U
      (toSemanticBC pasting.pastePresentation))
    (incidence : BCDiagnosticSourceFiberIncidence
      pasting.pastePresentation interpretation) :
    BCDiagnosticCompositionCompatibility incidence.toFiberwise
        (bcDiagnosticDirectFirstFunctor pasting.pastePresentation)
        (bcDiagnosticDirectSecondFunctor pasting.pastePresentation) ∧
      BCDiagnosticCompositionCompatibility incidence.toFiberwise
        (bcDiagnosticViaBaseFirstFunctor pasting.pastePresentation)
        (bcDiagnosticViaBaseSecondFunctor pasting.pastePresentation) :=
  ⟨bcDiagnosticDirectCompositionCompatibility _ incidence.toFiberwise,
    bcDiagnosticViaBaseCompositionCompatibility _ incidence.toFiberwise⟩

/-- G-110(E), vertical case: the ordinary source-fiber-qualified diagnostic
on the generated outer vertical pasted square has both actual direct and
via-base `(d2)`--`(d6)` composition packages. -/
theorem verticalPastedBCDiagnosticCompositionCompatibility
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (pasting : VerticalBCPastingData U)
    (interpretation : BCDiagnosticInterpretation U
      (toSemanticBC pasting.pastePresentation))
    (incidence : BCDiagnosticSourceFiberIncidence
      pasting.pastePresentation interpretation) :
    BCDiagnosticCompositionCompatibility incidence.toFiberwise
        (bcDiagnosticDirectFirstFunctor pasting.pastePresentation)
        (bcDiagnosticDirectSecondFunctor pasting.pastePresentation) ∧
      BCDiagnosticCompositionCompatibility incidence.toFiberwise
        (bcDiagnosticViaBaseFirstFunctor pasting.pastePresentation)
        (bcDiagnosticViaBaseSecondFunctor pasting.pastePresentation) :=
  ⟨bcDiagnosticDirectCompositionCompatibility _ incidence.toFiberwise,
    bcDiagnosticViaBaseCompositionCompatibility _ incidence.toFiberwise⟩

end AAT.AG.DoctrineFiberProduct

#assert_standard_axioms_only AAT.AG.DoctrineFiberProduct
