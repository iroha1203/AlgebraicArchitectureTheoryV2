import ResearchLean.AG.DoctrineFiberProduct.Schema
import ResearchLean.AG.TransportCoherence.FinitePresentation

/-!
# Finite-code Beck--Chevalley presentation schema

This module fixes the second half of the G-110 F0 input boundary.  A basic
Beck--Chevalley presentation contains a typed finite-code cospan, an authored
finite table of compatible selected points, and one pre-base-change G-106
diagnostic presentation with its semantic interpretation.  The pullback object,
its projections, the commuting square, and its categorical pullback proof are
generated by the F0a constructors; none is an authored field.

The G-106 package interpretation is intentionally semantic input.  Only its
finite combinatorial presentation is visible to the condition language.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open CategoryTheory
open CategoryTheory.Limits
open AtomFoundation
open TransportCoherence

/-! ## Pre-base-change diagnostic input -/

/--
A G-106 finite presentation equipped with equality decisions for every finite
cell family.  The extra fields are presentation capabilities, not coherence or
vanishing certificates.
-/
structure FiniteDiagnosticPresentation where
  /-- The reviewed G-106 finite 0/1/2/3-cell geometry. -/
  geometry : FiniteTransportPresentation.{u}
  /-- Executable equality for vertices. -/
  vertexDecidableEq : DecidableEq geometry.Vertex
  /-- Executable equality for every typed edge-generator family. -/
  edgeDecidableEq : ∀ source target, DecidableEq (geometry.Edge source target)
  /-- Executable equality for declared 2-cells. -/
  twoCellDecidableEq : DecidableEq geometry.TwoCell
  /-- Executable equality for declared 3-cells. -/
  threeCellDecidableEq : DecidableEq geometry.ThreeCell
  /-- Authored order enumerating every vertex exactly once. -/
  vertices : List geometry.Vertex
  /-- The vertex enumeration has no repetitions. -/
  vertices_nodup : vertices.Nodup
  /-- Every vertex occurs in the authored enumeration. -/
  vertices_complete : ∀ vertex, vertex ∈ vertices
  /-- Authored order enumerating every typed edge family exactly once. -/
  edges : ∀ source target, List (geometry.Edge source target)
  /-- Every typed edge enumeration has no repetitions. -/
  edges_nodup : ∀ source target, (edges source target).Nodup
  /-- Every edge generator occurs in its authored enumeration. -/
  edges_complete : ∀ source target edge, edge ∈ edges source target
  /-- Authored order enumerating every declared 2-cell exactly once. -/
  twoCells : List geometry.TwoCell
  /-- The 2-cell enumeration has no repetitions. -/
  twoCells_nodup : twoCells.Nodup
  /-- Every declared 2-cell occurs in the authored enumeration. -/
  twoCells_complete : ∀ cell, cell ∈ twoCells
  /-- Authored order enumerating every declared 3-cell exactly once. -/
  threeCells : List geometry.ThreeCell
  /-- The 3-cell enumeration has no repetitions. -/
  threeCells_nodup : threeCells.Nodup
  /-- Every declared 3-cell occurs in the authored enumeration. -/
  threeCells_complete : ∀ cell, cell ∈ threeCells

/-- Use the authored vertex equality procedure of a diagnostic presentation. -/
instance diagnosticVertexDecidableEq
    (presentation : FiniteDiagnosticPresentation.{u}) :
    DecidableEq presentation.geometry.Vertex :=
  presentation.vertexDecidableEq

/-- Use the authored edge equality procedures of a diagnostic presentation. -/
instance diagnosticEdgeDecidableEq
    (presentation : FiniteDiagnosticPresentation.{u})
    (source target : presentation.geometry.Vertex) :
    DecidableEq (presentation.geometry.Edge source target) :=
  presentation.edgeDecidableEq source target

/-- Use the authored 2-cell equality procedure of a diagnostic presentation. -/
instance diagnosticTwoCellDecidableEq
    (presentation : FiniteDiagnosticPresentation.{u}) :
    DecidableEq presentation.geometry.TwoCell :=
  presentation.twoCellDecidableEq

/-- Use the authored 3-cell equality procedure of a diagnostic presentation. -/
instance diagnosticThreeCellDecidableEq
    (presentation : FiniteDiagnosticPresentation.{u}) :
    DecidableEq presentation.geometry.ThreeCell :=
  presentation.threeCellDecidableEq

/--
The complete pre-base-change diagnostic datum.  `interpretation` is the
G-106-authorized semantic package layer; it contains no transported datum,
base-change comparison, or vanishing conclusion.
-/
structure PreBCDiagnosticInput (U : AtomCarrier.{u}) where
  /-- Finite combinatorial geometry visible to the BC condition language. -/
  presentation : FiniteDiagnosticPresentation.{u}
  /-- Base-change-before semantic interpretation of that fixed geometry. -/
  interpretation : AdmissibleTransportData presentation.geometry U

/-! ## Raw and validated BC presentations -/

/-- A typed pair of finite-code arrows with a definitionally shared target. -/
structure CartCospanPresentation (U : AtomCarrier.{u}) [DecidableEq U.Atom] where
  /-- Source code of the first cospan leg. -/
  firstSource : FiniteInstanceCode U
  /-- Source code of the second cospan leg. -/
  secondSource : FiniteInstanceCode U
  /-- Shared target code of both cospan legs. -/
  base : FiniteInstanceCode U
  /-- First validated finite-code cospan leg. -/
  first : CartPresentationBetween firstSource base
  /-- Second validated finite-code cospan leg. -/
  second : CartPresentationBetween secondSource base

/--
Authored first-order table of selected points and their two cospan-leg images.
Indices are natural numbers so malformed tables remain representable before
validation.
-/
structure CompatiblePointCode where
  /-- Selected source index for each of the two cospan legs. -/
  sourcePoints : Fin 2 → ℕ
  /-- Selected index in the shared target. -/
  basePoint : ℕ
  /-- Image index of each authored source point under its cospan leg. -/
  images : Fin 2 → ℕ
deriving DecidableEq

namespace CompatiblePointCode

/--
The compatible-point table denotes exactly the selected points already carried
by the two finite instances, and both images are the selected base point.
-/
def WellFormed {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : CompatiblePointCode) (cospan : CartCospanPresentation U) : Prop :=
  code.sourcePoints 0 = cospan.firstSource.point.down.val ∧
  code.sourcePoints 1 = cospan.secondSource.point.down.val ∧
  code.basePoint = cospan.base.point.down.val ∧
  code.images 0 = (cospan.first.sourceMap cospan.firstSource.point).down.val ∧
  code.images 1 = (cospan.second.sourceMap cospan.secondSource.point).down.val ∧
  code.images 0 = code.basePoint ∧
  code.images 1 = code.basePoint

/-- Compatible-point well-formedness is a finite equality decision. -/
instance wellFormedDecidable {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : CompatiblePointCode) (cospan : CartCospanPresentation U) :
    Decidable (code.WellFormed cospan) := by
  unfold WellFormed
  infer_instance

/-- Boolean validator for the authored compatible-point table. -/
def checkWellFormed {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : CompatiblePointCode) (cospan : CartCospanPresentation U) : Bool :=
  decide (code.WellFormed cospan)

/-- The finite Boolean validator is exact for compatible-point well-formedness. -/
theorem checkWellFormed_eq_true_iff
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : CompatiblePointCode) (cospan : CartCospanPresentation U) :
    code.checkWellFormed cospan = true ↔ code.WellFormed cospan := by
  simp [checkWellFormed]

end CompatiblePointCode

/--
The three authored groups of a basic BC presentation.  No pullback object,
projection, semantic equality, condition bit, regime, or comparison map is a
field.
-/
structure BCRawCode (U : AtomCarrier.{u}) [DecidableEq U.Atom] where
  /-- Pair of validated finite-code arrows forming the input cospan. -/
  cospan : CartCospanPresentation U
  /-- Finite compatible-point table. -/
  compatiblePoints : CompatiblePointCode
  /-- Base-change-before diagnostic geometry and semantic interpretation. -/
  diagnostic : PreBCDiagnosticInput U

namespace BCRawCode

/-- A raw BC code is valid exactly when its authored point table matches the cospan. -/
def WellFormed {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : BCRawCode U) : Prop :=
  code.compatiblePoints.WellFormed code.cospan

/-- Basic BC validation is decidable from its finite authored table. -/
instance wellFormedDecidable {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : BCRawCode U) : Decidable code.WellFormed := by
  unfold WellFormed
  infer_instance

/-- Boolean validator for a basic raw BC code. -/
def checkWellFormed {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (code : BCRawCode U) : Bool :=
  decide code.WellFormed

/-- The raw BC validator is sound and complete for the declared predicate. -/
theorem checkWellFormed_eq_true_iff
    {U : AtomCarrier.{u}} [DecidableEq U.Atom] (code : BCRawCode U) :
    code.checkWellFormed = true ↔ code.WellFormed := by
  simp [checkWellFormed]

end BCRawCode

/-- Validated basic BC code. -/
abbrev ValidatedBCCode (U : AtomCarrier.{u}) [DecidableEq U.Atom] :=
  {code : BCRawCode U // code.WellFormed}

/-- Presentation-layer input for one basic Beck--Chevalley square. -/
abbrev BCPresentation (U : AtomCarrier.{u}) [DecidableEq U.Atom] :=
  ValidatedBCCode U

/-! ## Named semantic square and realization -/

/-- A commutative square in the G-101 category of pointed extraction instances. -/
structure ExtInstSquare (U : AtomCarrier.{u}) where
  /-- Northwest object. -/
  northwest : ExtractionInstance U
  /-- Northeast object. -/
  northeast : ExtractionInstance U
  /-- Southwest object. -/
  southwest : ExtractionInstance U
  /-- Southeast object. -/
  southeast : ExtractionInstance U
  /-- Top arrow. -/
  top : northwest ⟶ northeast
  /-- Left arrow. -/
  left : northwest ⟶ southwest
  /-- Right arrow. -/
  right : northeast ⟶ southeast
  /-- Bottom arrow. -/
  bottom : southwest ⟶ southeast
  /-- Square commutativity in the orientation used by G-110. -/
  commutes : left ≫ bottom = top ≫ right

/--
Selected-point data of a semantic square.  All four compatibility equations
are generated from `ExtInstHom.source_eq`; they are never authored separately.
-/
structure CompatiblePointSemanticInput {U : AtomCarrier.{u}}
    (square : ExtInstSquare U) where
  /-- Selected northwest source. -/
  northwest : square.northwest.doctrine.Source
  /-- Selected northeast source. -/
  northeast : square.northeast.doctrine.Source
  /-- Selected southwest source. -/
  southwest : square.southwest.doctrine.Source
  /-- Selected southeast source. -/
  southeast : square.southeast.doctrine.Source
  /-- Compatibility along the top arrow. -/
  top_eq : square.top.doctrineHom.sourceMap northwest = northeast
  /-- Compatibility along the left arrow. -/
  left_eq : square.left.doctrineHom.sourceMap northwest = southwest
  /-- Compatibility along the right arrow. -/
  right_eq : square.right.doctrineHom.sourceMap northeast = southeast
  /-- Compatibility along the bottom arrow. -/
  bottom_eq : square.bottom.doctrineHom.sourceMap southwest = southeast

/-- Canonical selected-point data generated by the four semantic arrows. -/
def compatiblePointSemanticInputOfSquare {U : AtomCarrier.{u}}
    (square : ExtInstSquare U) : CompatiblePointSemanticInput square where
  northwest := square.northwest.source
  northeast := square.northeast.source
  southwest := square.southwest.source
  southeast := square.southeast.source
  top_eq := square.top.source_eq
  left_eq := square.left.source_eq
  right_eq := square.right.source_eq
  bottom_eq := square.bottom.source_eq

/--
Named semantic BC input.  Its only fields are the base-change-before square,
compatible selected-point data, and the base-change-before diagnostic datum.
In particular it has no regime, condition bit, mate, or transported diagnostic.
-/
structure BCSemanticInput (U : AtomCarrier.{u}) where
  /-- Generated pointed square. -/
  square : ExtInstSquare U
  /-- Generated compatible-point data for that square. -/
  compatiblePoints : CompatiblePointSemanticInput square
  /-- Pre-base-change G-106 diagnostic input. -/
  diagnostic : PreBCDiagnosticInput U

/-- Generate the pointed pullback square from the authored finite-code cospan. -/
noncomputable def decodeBCSquare {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U) : ExtInstSquare U :=
  let cospan := presentation.1.cospan
  { northwest := (pullbackInstanceCode cospan.first cospan.second).toSemantic
    northeast := cospan.secondSource.toSemantic
    southwest := cospan.firstSource.toSemantic
    southeast := cospan.base.toSemantic
    top := (toSemanticCart
      (pullbackSndPresentation cospan.first cospan.second).toPresentation).hom
    left := (toSemanticCart
      (pullbackFstPresentation cospan.first cospan.second).toPresentation).hom
    right := (toSemanticCart cospan.second.toPresentation).hom
    bottom := (toSemanticCart cospan.first.toPresentation).hom
    commutes := pullbackPresentation_commutes cospan.first cospan.second }

/-- Decode a validated basic BC presentation to its named semantic input. -/
noncomputable def toSemanticBC {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U) : BCSemanticInput U :=
  let square := decodeBCSquare presentation
  { square := square
    compatiblePoints := compatiblePointSemanticInputOfSquare square
    diagnostic := presentation.1.diagnostic }

/--
The authored finite point table is consumed by validation and agrees component
by component with the selected sources and images of the decoded square.
-/
theorem toSemanticBC_authored_point_table_sound
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U) :
    (toSemanticBC presentation).compatiblePoints.southwest.down.val =
        presentation.1.compatiblePoints.sourcePoints 0 ∧
      (toSemanticBC presentation).compatiblePoints.northeast.down.val =
        presentation.1.compatiblePoints.sourcePoints 1 ∧
      (toSemanticBC presentation).compatiblePoints.southeast.down.val =
        presentation.1.compatiblePoints.basePoint ∧
      ((toSemanticBC presentation).square.bottom.doctrineHom.sourceMap
          (toSemanticBC presentation).compatiblePoints.southwest).down.val =
        presentation.1.compatiblePoints.images 0 ∧
      ((toSemanticBC presentation).square.right.doctrineHom.sourceMap
          (toSemanticBC presentation).compatiblePoints.northeast).down.val =
        presentation.1.compatiblePoints.images 1 := by
  rcases presentation.2 with
    ⟨hfirst, hsecond, hbase, hfirstImage, hsecondImage, _, _⟩
  exact ⟨hfirst.symm, hsecond.symm, hbase.symm,
    hfirstImage.symm, hsecondImage.symm⟩

/--
Realization soundness: the generated square is a categorical pullback and all
four selected-point compatibility equations hold in the decoded arrows.
-/
theorem toSemanticBC_sound {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U) :
    IsPullback (toSemanticBC presentation).square.left
        (toSemanticBC presentation).square.top
        (toSemanticBC presentation).square.bottom
        (toSemanticBC presentation).square.right ∧
      (toSemanticBC presentation).square.top.doctrineHom.sourceMap
          (toSemanticBC presentation).compatiblePoints.northwest =
        (toSemanticBC presentation).compatiblePoints.northeast ∧
      (toSemanticBC presentation).square.left.doctrineHom.sourceMap
          (toSemanticBC presentation).compatiblePoints.northwest =
        (toSemanticBC presentation).compatiblePoints.southwest ∧
      (toSemanticBC presentation).square.right.doctrineHom.sourceMap
          (toSemanticBC presentation).compatiblePoints.northeast =
        (toSemanticBC presentation).compatiblePoints.southeast ∧
      (toSemanticBC presentation).square.bottom.doctrineHom.sourceMap
          (toSemanticBC presentation).compatiblePoints.southwest =
        (toSemanticBC presentation).compatiblePoints.southeast := by
  let cospan := presentation.1.cospan
  refine ⟨pullbackPresentation_isPullback cospan.first cospan.second, ?_⟩
  exact ⟨(toSemanticBC presentation).compatiblePoints.top_eq,
    (toSemanticBC presentation).compatiblePoints.left_eq,
    (toSemanticBC presentation).compatiblePoints.right_eq,
    (toSemanticBC presentation).compatiblePoints.bottom_eq⟩

/-- A semantic BC square together with finite presentation provenance. -/
structure RealizableSquare (U : AtomCarrier.{u}) [DecidableEq U.Atom] where
  /-- Semantic square, point data, and pre-base-change diagnostic. -/
  semantic : BCSemanticInput U
  /-- Finite presentation witnessing membership in the realization image. -/
  presentation : BCPresentation U
  /-- The semantic input is exactly the decoder output. -/
  realization_eq : toSemanticBC presentation = semantic

/-- Canonical realization witness generated by a validated BC presentation. -/
noncomputable def realizableSquareOf {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U) : RealizableSquare U where
  semantic := toSemanticBC presentation
  presentation := presentation
  realization_eq := rfl

/-! ## Complete finite BC condition vocabulary -/

/-- First-order serialization of one typed diagnostic edge generator. -/
structure DiagnosticEdgeValue where
  /-- Source-vertex index in the authored vertex order. -/
  source : ℕ
  /-- Target-vertex index in the authored vertex order. -/
  target : ℕ
  /-- Generator index in the corresponding typed edge family. -/
  generator : ℕ
deriving DecidableEq

/-- First-order serialization of one oriented whiskered diagnostic face. -/
structure DiagnosticWhiskeredFaceValue where
  /-- Declared 2-cell index. -/
  cell : ℕ
  /-- Serialized incoming whisker. -/
  incoming : List DiagnosticEdgeValue
  /-- Serialized outgoing whisker. -/
  outgoing : List DiagnosticEdgeValue
  /-- Orientation of the declared rewrite. -/
  orientation : FaceOrientation
deriving DecidableEq

/-- Index a finite value in its authored duplicate-free complete order. -/
def finiteListIndex {alpha : Type u} [DecidableEq alpha]
    (values : List alpha) (value : alpha) : ℕ :=
  values.idxOf value

/-- Serialize a typed G-106 path without exposing package semantics. -/
def diagnosticPathValue (presentation : FiniteDiagnosticPresentation.{u}) :
    {source target : presentation.geometry.Vertex} →
      presentation.geometry.Path source target → List DiagnosticEdgeValue
  | _, _, .nil _ => []
  | source, _, @PresentedPath.cons _ _ _ middle _ edge tail =>
      { source := finiteListIndex presentation.vertices source
        target := finiteListIndex presentation.vertices middle
        generator := finiteListIndex (presentation.edges source middle) edge } ::
      diagnosticPathValue presentation tail

/-- Serialize one typed whiskered face in the authored finite orders. -/
def diagnosticWhiskeredFaceValue
    (presentation : FiniteDiagnosticPresentation.{u})
    {source target : presentation.geometry.Vertex}
    (face : WhiskeredFace
      presentation.geometry.toFiniteTransportTwoPresentation source target) :
    DiagnosticWhiskeredFaceValue where
  cell := finiteListIndex presentation.twoCells face.cell
  incoming := diagnosticPathValue presentation face.incoming
  outgoing := diagnosticPathValue presentation face.outgoing
  orientation := face.orientation

/-- Serialize a typed vertical rewrite pasting as its finite face list. -/
def diagnosticPastingValue
    (presentation : FiniteDiagnosticPresentation.{u})
    {source target : presentation.geometry.Vertex}
    {before after : presentation.geometry.Path source target} :
    RewritePasting presentation.geometry.toFiniteTransportTwoPresentation
      before after → List DiagnosticWhiskeredFaceValue
  | .nil _ => []
  | .cons step tail =>
      diagnosticWhiskeredFaceValue presentation step.face ::
        diagnosticPastingValue presentation tail

/-- Serialize the edge-cardinality matrix in authored vertex order. -/
def diagnosticEdgeCardTable
    (presentation : FiniteDiagnosticPresentation.{u}) : List ℕ :=
  presentation.vertices.flatMap (fun source =>
    presentation.vertices.map (fun target =>
      (presentation.edges source target).length))

/-- Serialize the source vertex of every declared diagnostic 2-cell. -/
def diagnosticTwoSources
    (presentation : FiniteDiagnosticPresentation.{u}) : List ℕ :=
  presentation.twoCells.map (fun cell =>
    finiteListIndex presentation.vertices (presentation.geometry.twoSource cell))

/-- Serialize the target vertex of every declared diagnostic 2-cell. -/
def diagnosticTwoTargets
    (presentation : FiniteDiagnosticPresentation.{u}) : List ℕ :=
  presentation.twoCells.map (fun cell =>
    finiteListIndex presentation.vertices (presentation.geometry.twoTarget cell))

/-- Serialize the left path of every declared diagnostic 2-cell. -/
def diagnosticTwoLeftPaths
    (presentation : FiniteDiagnosticPresentation.{u}) :
    List (List DiagnosticEdgeValue) :=
  presentation.twoCells.map (fun cell =>
    diagnosticPathValue presentation (presentation.geometry.twoLeft cell))

/-- Serialize the right path of every declared diagnostic 2-cell. -/
def diagnosticTwoRightPaths
    (presentation : FiniteDiagnosticPresentation.{u}) :
    List (List DiagnosticEdgeValue) :=
  presentation.twoCells.map (fun cell =>
    diagnosticPathValue presentation (presentation.geometry.twoRight cell))

/-- Serialize the source vertex of every declared diagnostic 3-cell. -/
def diagnosticThreeSources
    (presentation : FiniteDiagnosticPresentation.{u}) : List ℕ :=
  presentation.threeCells.map (fun cell =>
    finiteListIndex presentation.vertices
      (presentation.geometry.threeSource cell))

/-- Serialize the target vertex of every declared diagnostic 3-cell. -/
def diagnosticThreeTargets
    (presentation : FiniteDiagnosticPresentation.{u}) : List ℕ :=
  presentation.threeCells.map (fun cell =>
    finiteListIndex presentation.vertices
      (presentation.geometry.threeTarget cell))

/-- Serialize the common starting path of every declared diagnostic 3-cell. -/
def diagnosticThreeStartPaths
    (presentation : FiniteDiagnosticPresentation.{u}) :
    List (List DiagnosticEdgeValue) :=
  presentation.threeCells.map (fun cell =>
    diagnosticPathValue presentation (presentation.geometry.threeStart cell))

/-- Serialize the common finishing path of every declared diagnostic 3-cell. -/
def diagnosticThreeFinishPaths
    (presentation : FiniteDiagnosticPresentation.{u}) :
    List (List DiagnosticEdgeValue) :=
  presentation.threeCells.map (fun cell =>
    diagnosticPathValue presentation (presentation.geometry.threeFinish cell))

/-- Serialize the first rewrite pasting of every declared diagnostic 3-cell. -/
def diagnosticThreeLeftPastings
    (presentation : FiniteDiagnosticPresentation.{u}) :
    List (List DiagnosticWhiskeredFaceValue) :=
  presentation.threeCells.map (fun cell =>
    diagnosticPastingValue presentation (presentation.geometry.threeLeft cell))

/-- Serialize the second rewrite pasting of every declared diagnostic 3-cell. -/
def diagnosticThreeRightPastings
    (presentation : FiniteDiagnosticPresentation.{u}) :
    List (List DiagnosticWhiskeredFaceValue) :=
  presentation.threeCells.map (fun cell =>
    diagnosticPastingValue presentation (presentation.geometry.threeRight cell))

/-- Operand sorts of the fully enumerated BC field vocabulary. -/
inductive BCFieldKind
  | cart (kind : CartFieldKind)
  | natural
  | naturals
  | paths
  | pastings

/-- Value type attached to every BC operand sort. -/
def BCFieldValue (U : AtomCarrier.{u}) : BCFieldKind → Type u
  | .cart kind => CartFieldValue U kind
  | .natural => ULift ℕ
  | .naturals => ULift (List ℕ)
  | .paths => ULift (List (List DiagnosticEdgeValue))
  | .pastings => ULift (List (List DiagnosticWhiskeredFaceValue))

/-- Equality is executable at every BC operand sort. -/
instance bcFieldValueDecidableEq {U : AtomCarrier.{u}}
    [DecidableEq U.Atom] (kind : BCFieldKind) :
    DecidableEq (BCFieldValue U kind) := by
  cases kind with
  | cart kind => exact cartFieldValueDecidableEq kind
  | natural => simp only [BCFieldValue]; infer_instance
  | naturals => simp only [BCFieldValue]; infer_instance
  | paths => simp only [BCFieldValue]; infer_instance
  | pastings => simp only [BCFieldValue]; infer_instance

/-- The two authored cospan legs visible to BC projections. -/
inductive BCSquareLeg
  | first
  | second
deriving DecidableEq

/--
Complete BC projection list.  The cartesian cases expose every F0a field of
both cospan legs; the remaining cases expose every compatible-point component
and every combinatorial field of the G-106 diagnostic presentation.
-/
inductive BCProjection (U : AtomCarrier.{u}) : BCFieldKind → Type u
  | cart {kind : CartFieldKind} (leg : BCSquareLeg)
      (field : CartProjection U kind) : BCProjection U (.cart kind)
  | compatibleFirstPoint : BCProjection U .natural
  | compatibleSecondPoint : BCProjection U .natural
  | compatibleBasePoint : BCProjection U .natural
  | compatibleFirstImage : BCProjection U .natural
  | compatibleSecondImage : BCProjection U .natural
  | diagnosticVertexCard : BCProjection U .natural
  | diagnosticEdgeCards : BCProjection U .naturals
  | diagnosticTwoSources : BCProjection U .naturals
  | diagnosticTwoTargets : BCProjection U .naturals
  | diagnosticTwoLeftPaths : BCProjection U .paths
  | diagnosticTwoRightPaths : BCProjection U .paths
  | diagnosticThreeSources : BCProjection U .naturals
  | diagnosticThreeTargets : BCProjection U .naturals
  | diagnosticThreeStartPaths : BCProjection U .paths
  | diagnosticThreeFinishPaths : BCProjection U .paths
  | diagnosticThreeLeftPastings : BCProjection U .pastings
  | diagnosticThreeRightPastings : BCProjection U .pastings

/-- Structural constants allowed by the fixed BC vocabulary. -/
inductive BCNamedConstant (U : AtomCarrier.{u}) : BCFieldKind → Type u
  | cart {kind : CartFieldKind} (leg : BCSquareLeg)
      (constant : CartNamedConstant U kind) : BCNamedConstant U (.cart kind)
  | zero : BCNamedConstant U .natural
  | emptyNaturals : BCNamedConstant U .naturals
  | emptyPaths : BCNamedConstant U .paths
  | emptyPastings : BCNamedConstant U .pastings

/-- A BC field term is either a listed projection or a listed structural constant. -/
inductive BCFieldTerm (U : AtomCarrier.{u}) : BCFieldKind → Type u
  | projection {kind : BCFieldKind}
      (field : BCProjection U kind) : BCFieldTerm U kind
  | constant {kind : BCFieldKind}
      (constant : BCNamedConstant U kind) : BCFieldTerm U kind

/-- Select one of the two authored cartesian cospan-leg presentations. -/
def bcCartPresentation {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (leg : BCSquareLeg) (presentation : BCPresentation U) : CartPresentation U :=
  match leg with
  | .first => presentation.1.cospan.first.toPresentation
  | .second => presentation.1.cospan.second.toPresentation

/-- Evaluate any listed projection from finite authored BC fields only. -/
def readBCProjection {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {kind : BCFieldKind} (projection : BCProjection U kind)
    (presentation : BCPresentation U) : BCFieldValue U kind :=
  match projection with
  | .cart leg field => readCartProjection field (bcCartPresentation leg presentation)
  | .compatibleFirstPoint =>
      ULift.up (presentation.1.compatiblePoints.sourcePoints 0)
  | .compatibleSecondPoint =>
      ULift.up (presentation.1.compatiblePoints.sourcePoints 1)
  | .compatibleBasePoint => ULift.up presentation.1.compatiblePoints.basePoint
  | .compatibleFirstImage => ULift.up (presentation.1.compatiblePoints.images 0)
  | .compatibleSecondImage => ULift.up (presentation.1.compatiblePoints.images 1)
  | .diagnosticVertexCard =>
      ULift.up presentation.1.diagnostic.presentation.vertices.length
  | .diagnosticEdgeCards =>
      ULift.up (diagnosticEdgeCardTable presentation.1.diagnostic.presentation)
  | .diagnosticTwoSources =>
      ULift.up (diagnosticTwoSources presentation.1.diagnostic.presentation)
  | .diagnosticTwoTargets =>
      ULift.up (diagnosticTwoTargets presentation.1.diagnostic.presentation)
  | .diagnosticTwoLeftPaths =>
      ULift.up (diagnosticTwoLeftPaths presentation.1.diagnostic.presentation)
  | .diagnosticTwoRightPaths =>
      ULift.up (diagnosticTwoRightPaths presentation.1.diagnostic.presentation)
  | .diagnosticThreeSources =>
      ULift.up (diagnosticThreeSources presentation.1.diagnostic.presentation)
  | .diagnosticThreeTargets =>
      ULift.up (diagnosticThreeTargets presentation.1.diagnostic.presentation)
  | .diagnosticThreeStartPaths =>
      ULift.up (diagnosticThreeStartPaths presentation.1.diagnostic.presentation)
  | .diagnosticThreeFinishPaths =>
      ULift.up (diagnosticThreeFinishPaths presentation.1.diagnostic.presentation)
  | .diagnosticThreeLeftPastings =>
      ULift.up (diagnosticThreeLeftPastings presentation.1.diagnostic.presentation)
  | .diagnosticThreeRightPastings =>
      ULift.up (diagnosticThreeRightPastings presentation.1.diagnostic.presentation)

/-- Interpret a listed BC constant relative only to presentation cardinalities. -/
def readBCNamedConstant {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {kind : BCFieldKind} (constant : BCNamedConstant U kind)
    (presentation : BCPresentation U) : BCFieldValue U kind :=
  match constant with
  | .cart leg cartConstant =>
      readCartNamedConstant cartConstant (bcCartPresentation leg presentation)
  | .zero => ULift.up 0
  | .emptyNaturals => ULift.up []
  | .emptyPaths => ULift.up []
  | .emptyPastings => ULift.up []

/-- Evaluate one BC field term without reading semantic package values. -/
def evalBCFieldTerm {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {kind : BCFieldKind} (term : BCFieldTerm U kind)
    (presentation : BCPresentation U) : BCFieldValue U kind :=
  match term with
  | .projection projection => readBCProjection projection presentation
  | .constant constant => readBCNamedConstant constant presentation

/-- Presentation-derived finite sets available to BC membership atoms. -/
inductive BCDerivedSet
  | firstSourceCells
  | secondSourceCells
  | baseCells
  | authoredSourcePoints
  | authoredImages
  | diagnosticVertices
  | diagnosticTwoCells
  | diagnosticThreeCells
deriving DecidableEq

/-- Evaluate one listed finite set from the authored BC presentation. -/
def evalBCDerivedSet {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (set : BCDerivedSet) (presentation : BCPresentation U) : Finset ℕ :=
  match set with
  | .firstSourceCells =>
      Finset.range presentation.1.cospan.firstSource.doctrine.sourceCard
  | .secondSourceCells =>
      Finset.range presentation.1.cospan.secondSource.doctrine.sourceCard
  | .baseCells => Finset.range presentation.1.cospan.base.doctrine.sourceCard
  | .authoredSourcePoints =>
      {presentation.1.compatiblePoints.sourcePoints 0,
        presentation.1.compatiblePoints.sourcePoints 1}
  | .authoredImages =>
      {presentation.1.compatiblePoints.images 0,
        presentation.1.compatiblePoints.images 1}
  | .diagnosticVertices =>
      Finset.range presentation.1.diagnostic.presentation.vertices.length
  | .diagnosticTwoCells =>
      Finset.range presentation.1.diagnostic.presentation.twoCells.length
  | .diagnosticThreeCells =>
      Finset.range presentation.1.diagnostic.presentation.threeCells.length

/-- Finite universal equalities available to the BC condition language. -/
inductive BCUniversalEquality
  | firstAtomMapIdentity
  | secondAtomMapIdentity
  | compatibleImagesAgree
  | diagnosticTwoCellEndpointsInRange
  | diagnosticThreeCellEndpointsInRange
  | diagnosticFaceReferencesInRange
deriving DecidableEq

/-- All serialized diagnostic faces appearing in declared 3-cell pastings. -/
def diagnosticFaces
    (presentation : FiniteDiagnosticPresentation.{u}) :
    List DiagnosticWhiskeredFaceValue :=
  (diagnosticThreeLeftPastings presentation).flatten ++
    (diagnosticThreeRightPastings presentation).flatten

/-- Evaluate one finite universal using only the authored finite fields. -/
def evalBCUniversalEquality {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (equality : BCUniversalEquality) (presentation : BCPresentation U) : Bool :=
  match equality with
  | .firstAtomMapIdentity =>
      evalCartUniversalEquality .atomMapIdentity
        (bcCartPresentation .first presentation)
  | .secondAtomMapIdentity =>
      evalCartUniversalEquality .atomMapIdentity
        (bcCartPresentation .second presentation)
  | .compatibleImagesAgree =>
      decide (∀ leg : Fin 2,
        presentation.1.compatiblePoints.images leg =
          presentation.1.compatiblePoints.basePoint)
  | .diagnosticTwoCellEndpointsInRange =>
      let diagnostic := presentation.1.diagnostic.presentation
      (List.zip (diagnosticTwoSources diagnostic)
        (diagnosticTwoTargets diagnostic)).all (fun endpoints =>
          decide (endpoints.1 < diagnostic.vertices.length) &&
            decide (endpoints.2 < diagnostic.vertices.length))
  | .diagnosticThreeCellEndpointsInRange =>
      let diagnostic := presentation.1.diagnostic.presentation
      (List.zip (diagnosticThreeSources diagnostic)
        (diagnosticThreeTargets diagnostic)).all (fun endpoints =>
          decide (endpoints.1 < diagnostic.vertices.length) &&
            decide (endpoints.2 < diagnostic.vertices.length))
  | .diagnosticFaceReferencesInRange =>
      let diagnostic := presentation.1.diagnostic.presentation
      (diagnosticFaces diagnostic).all (fun face =>
        decide (face.cell < diagnostic.twoCells.length))

/--
The complete four-constructor BC condition syntax.  It contains only typed
field equality, membership in a presentation-derived finite set, a listed
finite universal equality, and conjunction.
-/
inductive BCConditionSyntax (U : AtomCarrier.{u})
  | fieldEq {kind : BCFieldKind}
      (left right : BCFieldTerm U kind)
  | fieldMem (field : BCFieldTerm U .natural) (set : BCDerivedSet)
  | allCells (equality : BCUniversalEquality)
  | conjunction (left right : BCConditionSyntax U)

/-- Evaluate the fixed BC syntax without a regime, mate, or checker-result field. -/
def evalBCCondition {U : AtomCarrier.{u}} [DecidableEq U.Atom] :
    BCConditionSyntax U → BCPresentation U → Bool
  | .fieldEq left right, presentation =>
      decide (evalBCFieldTerm left presentation =
        evalBCFieldTerm right presentation)
  | .fieldMem field set, presentation =>
      decide ((evalBCFieldTerm field presentation).down ∈
        evalBCDerivedSet set presentation)
  | .allCells equality, presentation =>
      evalBCUniversalEquality equality presentation
  | .conjunction left right, presentation =>
      evalBCCondition left presentation && evalBCCondition right presentation

/-- The first-leg Atom universal has its exact finite-table characterization. -/
theorem evalBCCondition_firstAtomMapIdentity_eq_true_iff
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U) :
    evalBCCondition (.allCells .firstAtomMapIdentity) presentation = true ↔
      presentation.1.cospan.first.atomEquiv.toEquiv = Equiv.refl U.Atom := by
  simpa [evalBCCondition, evalBCUniversalEquality, bcCartPresentation] using
    (evalCartCondition_atomMapIdentity_eq_true_iff
      presentation.1.cospan.first.toPresentation)

/-- Semantic identity of the bottom Atom component on a realization witness. -/
def FirstLegIdentityAtomComponent
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (square : RealizableSquare U) : Prop :=
  square.semantic.square.bottom.doctrineHom.atomEquiv = Equiv.refl U.Atom

/--
The first-leg finite universal has a non-definitional bridge to the decoded
semantic bottom arrow.
-/
theorem evalBCCondition_firstAtomMapIdentity_bridge
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U) :
    evalBCCondition (.allCells .firstAtomMapIdentity) presentation = true ↔
      FirstLegIdentityAtomComponent (realizableSquareOf presentation) := by
  rw [evalBCCondition_firstAtomMapIdentity_eq_true_iff]
  rfl

/-- The selected BC check is invariant under replacement by the same semantic input. -/
theorem evalBCCondition_firstAtomMapIdentity_replacement_invariant
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (first second : BCPresentation U)
    (hsame : toSemanticBC first = toSemanticBC second) :
    evalBCCondition (.allCells .firstAtomMapIdentity) first =
      evalBCCondition (.allCells .firstAtomMapIdentity) second := by
  apply Bool.eq_iff_iff.mpr
  rw [evalBCCondition_firstAtomMapIdentity_eq_true_iff,
    evalBCCondition_firstAtomMapIdentity_eq_true_iff]
  have hatom := congrArg
    (fun input : BCSemanticInput U =>
      input.square.bottom.doctrineHom.atomEquiv) hsame
  change first.1.cospan.first.atomEquiv.toEquiv =
    second.1.cospan.first.atomEquiv.toEquiv at hatom
  rw [hatom]

end AAT.AG.DoctrineFiberProduct

#assert_standard_axioms_only AAT.AG.DoctrineFiberProduct
