import ResearchLean.AG.DoctrineFiberProduct.BCPastingTypedTwoSquareNormalForm

/-!
# Horizontal typed component-square alignment

This module isolates the component-only normalization inside the horizontal
typed two-square normal form.  The literal horizontal composite of the two
generated component squares has composite transport functors on its top and
bottom.  Generated core-fiber compositors place that square on the transport
functors of the composite semantic edges, where it agrees with the existing
horizontal component comparison.

## API position and assumptions

These declarations are a G-110(E) predecessor for identifying the full typed
outer normal form with the independently named outer comparison.  The only
authored input is finite horizontal pasting data.  Both component squares and
both external compositors are generated by existing APIs.

## Implementation notes

The comparison theorem first replaces each presentation-indexed component
square by its semantic comparison theorem.  Objectwise simplification then
exposes the same four natural-transformation factors on both sides; a final
definitional equality only identifies each selected presentation edge with
its semantic square edge.  Whole outer-comparison reduction remains a later
proof obligation.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open CategoryTheory
open AtomFoundation CrossStageCoherence
open CategoryTheory.NatTrans CategoryTheory.TwoSquare

set_option maxHeartbeats 2000000

/-- Literal horizontal composite of the two generated component squares. -/
noncomputable def horizontalTypedComponentSquare
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (data : HorizontalBCPastingData U) :
    TwoSquare
      (coreFiberTransportFunctor
          (typedPresentationToSemantic
            (bcTopPresentation data.leftPresentation)) ⋙
        coreFiberTransportFunctor
          (typedPresentationToSemantic
            (bcTopPresentation data.rightPresentation)))
      (coreFiberTransportFunctor
        (typedPresentationToSemantic
          (bcLeftPresentation data.leftPresentation)))
      (coreFiberTransportFunctor
        (typedPresentationToSemantic
          (bcRightPresentation data.rightPresentation)))
      (coreFiberTransportFunctor
          (typedPresentationToSemantic
            (bcBottomPresentation data.leftPresentation)) ⋙
        coreFiberTransportFunctor
          (typedPresentationToSemantic
            (bcBottomPresentation data.rightPresentation))) :=
  (bcCoreTransportSquareIso data.leftPresentation).hom ≫ₕ
    (bcCoreTransportSquareIso data.rightPresentation).hom

/-- No-unfold characterization of the literal horizontal component square. -/
theorem horizontalTypedComponentSquare_eq
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (data : HorizontalBCPastingData U) :
    horizontalTypedComponentSquare data =
      (bcCoreTransportSquareIso data.leftPresentation).hom ≫ₕ
        (bcCoreTransportSquareIso data.rightPresentation).hom := by
  rfl

/-- The generated horizontal component square on composite semantic top and
bottom transport functors. -/
noncomputable def horizontalCompositorAlignedComponentSquare
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (data : HorizontalBCPastingData U) :
    TwoSquare
      (coreFiberTransportFunctor
        ((toSemanticBC data.leftPresentation).square.top ≫
          (toSemanticBC data.rightPresentation).square.top))
      (coreFiberTransportFunctor
        (typedPresentationToSemantic
          (bcLeftPresentation data.leftPresentation)))
      (coreFiberTransportFunctor
        (typedPresentationToSemantic
          (bcRightPresentation data.rightPresentation)))
      (coreFiberTransportFunctor
        ((toSemanticBC data.leftPresentation).square.bottom ≫
          (toSemanticBC data.rightPresentation).square.bottom)) :=
  ((horizontalTypedComponentSquare data).whiskerTop
    (coreFiberCompositor
      (typedPresentationToSemantic
        (bcTopPresentation data.leftPresentation))
      (typedPresentationToSemantic
        (bcTopPresentation data.rightPresentation))).hom).whiskerBottom
    (coreFiberCompositor
      (typedPresentationToSemantic
        (bcBottomPresentation data.leftPresentation))
      (typedPresentationToSemantic
        (bcBottomPresentation data.rightPresentation))).inv

/-- No-unfold characterization of the compositor-aligned component square. -/
theorem horizontalCompositorAlignedComponentSquare_eq
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (data : HorizontalBCPastingData U) :
    horizontalCompositorAlignedComponentSquare data =
      ((horizontalTypedComponentSquare data).whiskerTop
        (coreFiberCompositor
          (typedPresentationToSemantic
            (bcTopPresentation data.leftPresentation))
          (typedPresentationToSemantic
            (bcTopPresentation data.rightPresentation))).hom).whiskerBottom
        (coreFiberCompositor
          (typedPresentationToSemantic
            (bcBottomPresentation data.leftPresentation))
          (typedPresentationToSemantic
            (bcBottomPresentation data.rightPresentation))).inv := by
  rfl

/-- The compositor-aligned generated component square is the hom of the
existing horizontal component comparison. -/
theorem horizontalCompositorAlignedComponentSquare_eq_componentComparison
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (data : HorizontalBCPastingData U) :
    horizontalCompositorAlignedComponentSquare data =
      TwoSquare.mk _ _ _ _
        (horizontalBCPastingComponentComparison data).hom := by
  have hleft :
      bcCoreTransportSquareIso data.leftPresentation =
        bcSemanticCoreTransportSquareIso
          (toSemanticBC data.leftPresentation) := by
    exact bcProvenanceCoreTransportSquareIso_eq_semantic
      (⟨data.leftPresentation, rfl⟩ :
        BCRealizationProvenance (toSemanticBC data.leftPresentation))
  have hright :
      bcCoreTransportSquareIso data.rightPresentation =
        bcSemanticCoreTransportSquareIso
          (toSemanticBC data.rightPresentation) := by
    exact bcProvenanceCoreTransportSquareIso_eq_semantic
      (⟨data.rightPresentation, rfl⟩ :
        BCRealizationProvenance (toSemanticBC data.rightPresentation))
  apply NatTrans.ext
  funext X
  simp [horizontalCompositorAlignedComponentSquare,
    horizontalTypedComponentSquare,
    horizontalBCPastingComponentComparison, hleft, hright,
    TwoSquare.hComp, TwoSquare.whiskerTop, TwoSquare.whiskerBottom]
  rfl

end AAT.AG.DoctrineFiberProduct

#assert_standard_axioms_only AAT.AG.DoctrineFiberProduct
