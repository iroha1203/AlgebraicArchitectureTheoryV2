/-! ## A raw-distinct identity presentation at the support endpoint -/

/--
The identity source table at the finite support endpoint, again carrying the
noncanonical padded identity Atom code.
-/
def finitePaddedSupportIdentityPresentation :
    CartPresentationBetween finitePortfolioSupportInstance
      finitePortfolioSupportInstance where
  sourceMap := id
  atomEquiv := finitePresentationPaddedIdentityAtomCode
  normalize_eq _ := rfl
  extraction_eq input := by
    change finiteModelDoctrineCode.extraction input =
      (finiteModelDoctrineCode.extraction input).transport
        finitePresentationPaddedIdentityAtomCode.toEquiv
    rw [finitePresentationPaddedIdentityAtomCode_toEquiv]
    simp
  source_eq := rfl

/-- The canonical typed identity uses the empty-support Atom code. -/
@[simp]
theorem finiteCanonicalSupportIdentityPresentation_atomSupport :
    (idTypedPresentation finitePortfolioSupportInstance).atomEquiv.support =
      ∅ :=
  rfl

/-- The canonical and padded support identity presentations are raw-distinct. -/
theorem finiteSupportIdentityPresentation_ne_padded :
    idTypedPresentation finitePortfolioSupportInstance ≠
      finitePaddedSupportIdentityPresentation := by
  intro equality
  have supportEquality := congrArg
    (fun presentation : CartPresentationBetween
        finitePortfolioSupportInstance finitePortfolioSupportInstance =>
      presentation.atomEquiv.support) equality
  have componentAMemPadded :
      FiniteModel.FiniteAtom.componentA ∈
        finitePaddedSupportIdentityPresentation.atomEquiv.support := by
    change FiniteModel.FiniteAtom.componentA ∈
      finitePresentationPaddedIdentityAtomCode.support
    rw [finitePresentationPaddedIdentityAtomCode_support]
    simp
  have componentAMem :
      FiniteModel.FiniteAtom.componentA ∈
        (idTypedPresentation
          finitePortfolioSupportInstance).atomEquiv.support :=
    Eq.mp
      (congrArg (fun support => FiniteModel.FiniteAtom.componentA ∈ support)
        supportEquality.symm)
      componentAMemPadded
  simp at componentAMem

/-- The padded identity presentation decodes to the categorical identity. -/
theorem finitePaddedSupportIdentityPresentation_hom :
    typedPresentationToSemantic finitePaddedSupportIdentityPresentation =
      𝟙 finitePortfolioSupportInstance.toSemantic := by
  apply ExtInstHom.ext
  apply ExactDoctrineHom.ext
  · rfl
  · change finitePresentationPaddedIdentityAtomCode.toEquiv =
      Equiv.refl FiniteModel.carrier.Atom
    exact finitePresentationPaddedIdentityAtomCode_toEquiv

/-- The canonical and padded identities have equal decoded semantic homs. -/
theorem finiteSupportIdentityPresentation_semanticHom_eq :
    typedPresentationToSemantic
        (idTypedPresentation finitePortfolioSupportInstance) =
      typedPresentationToSemantic
        finitePaddedSupportIdentityPresentation := by
  calc
    _ = 𝟙 finitePortfolioSupportInstance.toSemantic :=
      typedRealizableHom_id_hom finitePortfolioSupportInstance
    _ = _ := finitePaddedSupportIdentityPresentation_hom.symm

/-- The identity pair also has equal full semantic-input decodings. -/
theorem finiteSupportIdentityPresentation_semanticInput_eq :
    typedCartSemanticInput
        (idTypedPresentation finitePortfolioSupportInstance) =
      typedCartSemanticInput finitePaddedSupportIdentityPresentation := by
  exact typedCartSemanticInput_eq_of_hom_eq
    (idTypedPresentation finitePortfolioSupportInstance)
    finitePaddedSupportIdentityPresentation
    finiteSupportIdentityPresentation_semanticHom_eq

/-! ## Presentation-relative compositor on the selective chain -/

/--
The canonical selective composite decodes to the categorical composite of its
existing two-to-one and one-to-support presentation legs.
-/
theorem finiteCanonicalSelectivePresentationComposition_eq :
    typedPresentationToSemantic finiteSelectiveTwoToSupportPresentation =
      typedPresentationToSemantic finiteSelectiveTwoToOnePresentation ≫
        typedPresentationToSemantic
          finiteSelectiveOneToSupportPresentation := by
  simpa only [finiteSelectiveTwoToSupportPresentation,
    typedCartSemanticInput, typedRealizableHom_hom] using
      typedRealizableHom_comp_hom finiteSelectiveTwoToOnePresentation
        finiteSelectiveOneToSupportPresentation

/--
The raw-distinct padded direct presentation decodes to the same two-leg
semantic composite; this equation is derived from the finite decoder proofs.
-/
theorem finitePaddedSelectivePresentationComposition_eq :
    typedPresentationToSemantic
        finitePaddedSelectiveTwoToSupportPresentation =
      typedPresentationToSemantic finiteSelectiveTwoToOnePresentation ≫
        typedPresentationToSemantic
          finiteSelectiveOneToSupportPresentation := by
  calc
    _ = typedPresentationToSemantic
        finiteSelectiveTwoToSupportPresentation :=
      finiteSelectiveTwoToSupportPresentation_semanticHom_eq.symm
    _ = _ := finiteCanonicalSelectivePresentationComposition_eq

/--
The relative compositor for the padded direct presentation, evaluated at the
finite four-axis target.
-/
noncomputable def finitePaddedSelectivePresentationCompositorApp :=
  selectedTypedCoreFiberPresentationCompositorApp
