    finitePaddedSelectiveTwoToSupportPresentation
    finiteSelectiveTwoToSupportPresentation_semanticHom_eq

/-- The typed comparison API is reflexive on the canonical presentation. -/
theorem finiteSelectiveTypedPresentationComparison_refl :
    selectedTypedCoreFiberPresentationComparison
        finiteSelectiveTwoToSupportPresentation
        finiteSelectiveTwoToSupportPresentation rfl =
      Iso.refl (selectedTypedCoreFiberReindexFunctor
        finiteSelectiveTwoToSupportPresentation) :=
