import ResearchLean.AG.DoctrineFiberProduct.CartesianRegimeReindexingCleavageWitnesses
import ResearchLean.AG.DoctrineFiberProduct.CartesianRegimeReindexingPresentationCoherence
import ResearchLean.AG.DoctrineFiberProduct.CartesianRegimeReindexingPresentationReplacement

/-!
# Finite witnesses for cartesian-presentation descent

This module supplies raw-distinct finite presentations that decode to the same
semantic cartesian input.  The alternate code pads the identity Atom
permutation with a nonempty authored support; its decoder is still the literal
identity permutation.  Thus the distinction is genuine code data rather than
proof-field noise.  The existing infinite-source semantic identity supplies a
typed negative example showing that finite realization provenance is not
automatically inhabited.

## Implementation notes

The alternate presentation keeps the existing endpoint codes and source table
literal, changing only the authored finite support of an identity-decoding Atom
table.  A separate padded identity presentation is retained because relative
unitor descent requires an identity-decoding representative at the common
support endpoint.  Adding a comparison certificate to either presentation was
rejected: every comparison and coherence law below is generated by the generic
selected-lift APIs.

The comparison observations below reuse the existing selective two-to-support
arrow, whose source table is noninjective, and the existing nonidentity
four-axis vertical map.  Presentation inequality is not used to claim that an
opaque selected comparison component is itself nonidentity.
-/

namespace AAT.AG.DoctrineFiberProduct

open CategoryTheory
open AtomFoundation
open CrossStageCoherence

/-! ## A noncanonical code for the identity Atom permutation -/

/-- Executable Atom equality for the concrete finite presentation witness. -/
local instance finitePresentationDescentAtomDecidableEq :
    DecidableEq FiniteModel.carrier.Atom := by
  change DecidableEq FiniteModel.FiniteAtom
  infer_instance

/--
The identity Atom permutation encoded with a nonempty singleton support.  This
is raw-distinct from `AtomPermutationCode.refl`, whose authored support is
empty, although both codes decode to the same semantic permutation.
-/
def finitePresentationPaddedIdentityAtomCode :
    AtomPermutationCode FiniteModel.carrier :=
  AtomPermutationCode.ofPerm
    {FiniteModel.FiniteAtom.componentA}
    (Equiv.refl FiniteModel.carrier.Atom) (by simp) (by simp)

/-- The padded code retains its authored singleton support. -/
@[simp]
theorem finitePresentationPaddedIdentityAtomCode_support :
    finitePresentationPaddedIdentityAtomCode.support =
      {FiniteModel.FiniteAtom.componentA} :=
  rfl

/-- The noncanonical padded code still decodes to the identity permutation. -/
@[simp]
theorem finitePresentationPaddedIdentityAtomCode_toEquiv :
    finitePresentationPaddedIdentityAtomCode.toEquiv =
      Equiv.refl FiniteModel.carrier.Atom := by
  simp [finitePresentationPaddedIdentityAtomCode]

/-! ## Raw-distinct presentations of the selective two-to-support arrow -/

/--
The existing noninvertible selective two-to-support source table, presented
with the padded identity Atom code.  All validation laws are regenerated from
the actual finite tables.
-/
def finitePaddedSelectiveTwoToSupportPresentation :
    CartPresentationBetween finiteSelectiveTwoInstance
      finitePortfolioSupportInstance where
  sourceMap := fun _ => ULift.up (1 : Fin 2)
  atomEquiv := finitePresentationPaddedIdentityAtomCode
  normalize_eq _ := rfl
  extraction_eq _ := by
    change finiteWithoutComponentCAtomPredicate =
      finiteWithoutComponentCAtomPredicate.transport
        finitePresentationPaddedIdentityAtomCode.toEquiv
    rw [finitePresentationPaddedIdentityAtomCode_toEquiv]
    simp
  source_eq := rfl

/-- The canonical composite presentation has empty authored Atom support. -/
@[simp]
theorem finiteCanonicalSelectiveTwoToSupportPresentation_atomSupport :
    finiteSelectiveTwoToSupportPresentation.atomEquiv.support = ∅ := by
  simp [finiteSelectiveTwoToSupportPresentation,
    finiteSelectiveTwoToOnePresentation,
    finiteSelectiveOneToSupportPresentation, compPresentation,
    AtomPermutationCode.trans, AtomPermutationCode.refl,
    AtomPermutationCode.ofPerm]

/-- The canonical composite presentation decodes the identity Atom map. -/
@[simp]
theorem finiteCanonicalSelectiveTwoToSupportPresentation_atomEquiv :
    finiteSelectiveTwoToSupportPresentation.atomEquiv.toEquiv =
      Equiv.refl FiniteModel.carrier.Atom := by
  simp [finiteSelectiveTwoToSupportPresentation,
    finiteSelectiveTwoToOnePresentation,
    finiteSelectiveOneToSupportPresentation, compPresentation]

/-- The typed finite presentations are unequal as authored code values. -/
theorem finiteSelectiveTwoToSupportPresentation_ne_padded :
    finiteSelectiveTwoToSupportPresentation ≠
      finitePaddedSelectiveTwoToSupportPresentation := by
  intro equality
  have supportEquality := congrArg
    (fun presentation : CartPresentationBetween finiteSelectiveTwoInstance
        finitePortfolioSupportInstance => presentation.atomEquiv.support)
    equality
  have componentAMemPadded :
      FiniteModel.FiniteAtom.componentA ∈
        finitePaddedSelectiveTwoToSupportPresentation.atomEquiv.support := by
    change FiniteModel.FiniteAtom.componentA ∈
      finitePresentationPaddedIdentityAtomCode.support
    rw [finitePresentationPaddedIdentityAtomCode_support]
    simp
  have componentAMem :
      FiniteModel.FiniteAtom.componentA ∈
        finiteSelectiveTwoToSupportPresentation.atomEquiv.support :=
    Eq.mp
      (congrArg (fun support => FiniteModel.FiniteAtom.componentA ∈ support)
        supportEquality.symm)
      componentAMemPadded
  simp at componentAMem

/-- Forgetting endpoint indices preserves the genuine raw-code inequality. -/
theorem finiteSelectiveTwoToSupportRawPresentation_ne_padded :
    finiteSelectiveTwoToSupportPresentation.toPresentation ≠
      finitePaddedSelectiveTwoToSupportPresentation.toPresentation := by
  intro equality
  have supportEquality := congrArg
    (fun presentation : CartPresentation FiniteModel.carrier =>
      presentation.1.atomEquiv.support) equality
  have componentAMemPadded :
      FiniteModel.FiniteAtom.componentA ∈
        (CartPresentationBetween.toPresentation
          finitePaddedSelectiveTwoToSupportPresentation).1.atomEquiv.support := by
    change FiniteModel.FiniteAtom.componentA ∈
      finitePresentationPaddedIdentityAtomCode.support
    rw [finitePresentationPaddedIdentityAtomCode_support]
    simp
  have componentAMem :
      FiniteModel.FiniteAtom.componentA ∈
        (CartPresentationBetween.toPresentation
          finiteSelectiveTwoToSupportPresentation).1.atomEquiv.support :=
    Eq.mp
      (congrArg (fun support => FiniteModel.FiniteAtom.componentA ∈ support)
        supportEquality.symm)
      componentAMemPadded
  change FiniteModel.FiniteAtom.componentA ∈
    finiteSelectiveTwoToSupportPresentation.atomEquiv.support at componentAMem
  simp at componentAMem

/-- The two raw-distinct presentations decode to the same exact pointed hom. -/
theorem finiteSelectiveTwoToSupportPresentation_semanticHom_eq :
    typedPresentationToSemantic finiteSelectiveTwoToSupportPresentation =
      typedPresentationToSemantic
        finitePaddedSelectiveTwoToSupportPresentation := by
  apply ExtInstHom.ext
  apply ExactDoctrineHom.ext
  · rfl
  · change
      finiteSelectiveTwoToSupportPresentation.atomEquiv.toEquiv =
        finitePresentationPaddedIdentityAtomCode.toEquiv
    rw [finiteCanonicalSelectiveTwoToSupportPresentation_atomEquiv,
      finitePresentationPaddedIdentityAtomCode_toEquiv]

/-- The raw-distinct pair has equal full `CartSemanticInput` decodings. -/
theorem finiteSelectiveTwoToSupportPresentation_semanticInput_eq :
    typedCartSemanticInput finiteSelectiveTwoToSupportPresentation =
      typedCartSemanticInput
        finitePaddedSelectiveTwoToSupportPresentation := by
  exact typedCartSemanticInput_eq_of_hom_eq
    finiteSelectiveTwoToSupportPresentation
    finitePaddedSelectiveTwoToSupportPresentation
    finiteSelectiveTwoToSupportPresentation_semanticHom_eq

/-! ## Fixed-input provenance comparison -/

/-- The infinite-source semantic identity admits no finite realization provenance. -/
theorem infiniteIdentityInput_has_no_cartRealizationProvenance :
    ¬ Nonempty (CartRealizationProvenance infiniteIdentityInput) := by
  rintro ⟨provenance⟩
  exact infiniteIdentityInput_not_presented
    ⟨provenance.presentation, provenance.realization_eq⟩

/--
The canonical selective presentation regarded as finite provenance over its
own literal semantic input.
-/
def finiteSelectiveCanonicalCartProvenance :
    CartRealizationProvenance
      (typedCartSemanticInput finiteSelectiveTwoToSupportPresentation) :=
  typedCartRealizationProvenance finiteSelectiveTwoToSupportPresentation

/--
The padded presentation rebased to the canonical presentation's literal
semantic input using the proved decoder equality.
-/
def finiteSelectivePaddedCartProvenance :
    CartRealizationProvenance
      (typedCartSemanticInput finiteSelectiveTwoToSupportPresentation) :=
  typedCartRealizationProvenanceOfSemanticEq
    finiteSelectiveTwoToSupportPresentation
    finitePaddedSelectiveTwoToSupportPresentation
    finiteSelectiveTwoToSupportPresentation_semanticHom_eq

/-- The fixed-input provenance comparison at the finite four-axis target. -/
noncomputable def finiteSelectiveCartProvenanceComparisonApp :=
  cartRealizationProvenanceComparisonApp
    finiteSelectiveCanonicalCartProvenance
    finiteSelectivePaddedCartProvenance finiteReindexFourAxisTarget

/-- The provenance comparison's forward component satisfies its lift triangle. -/
theorem finiteSelectiveCartProvenanceComparisonApp_hom_fac :
    finiteSelectiveCartProvenanceComparisonApp.hom.1 ≫
        (selectedCoreFiberCartesianLift
          finiteSelectivePaddedCartProvenance.toRealizableHom
          finiteReindexFourAxisTarget).hom =
      (selectedCoreFiberCartesianLift
        finiteSelectiveCanonicalCartProvenance.toRealizableHom
        finiteReindexFourAxisTarget).hom :=
  cartRealizationProvenanceComparisonApp_hom_fac
    finiteSelectiveCanonicalCartProvenance
    finiteSelectivePaddedCartProvenance finiteReindexFourAxisTarget

/-- The provenance comparison's inverse component satisfies the reverse triangle. -/
theorem finiteSelectiveCartProvenanceComparisonApp_inv_fac :
    finiteSelectiveCartProvenanceComparisonApp.inv.1 ≫
        (selectedCoreFiberCartesianLift
          finiteSelectiveCanonicalCartProvenance.toRealizableHom
          finiteReindexFourAxisTarget).hom =
      (selectedCoreFiberCartesianLift
        finiteSelectivePaddedCartProvenance.toRealizableHom
        finiteReindexFourAxisTarget).hom :=
  cartRealizationProvenanceComparisonApp_inv_fac
    finiteSelectiveCanonicalCartProvenance
    finiteSelectivePaddedCartProvenance finiteReindexFourAxisTarget

/-- Fixed-input comparison naturality fires on the genuine four-axis swap. -/
theorem finiteSelectiveCartProvenanceComparison_naturality :
    (selectedCoreFiberReindexFunctor
        finiteSelectiveCanonicalCartProvenance.toRealizableHom).map
          finiteReindexAxisSwapHom ≫
        finiteSelectiveCartProvenanceComparisonApp.hom =
      finiteSelectiveCartProvenanceComparisonApp.hom ≫
        (selectedCoreFiberReindexFunctor
          finiteSelectivePaddedCartProvenance.toRealizableHom).map
            finiteReindexAxisSwapHom :=
  cartRealizationProvenanceComparison_naturality
    finiteSelectiveCanonicalCartProvenance
    finiteSelectivePaddedCartProvenance finiteReindexAxisSwapHom

/-- The whole selected-functor comparison generated from the two provenances. -/
noncomputable def finiteSelectiveCartProvenanceComparison :=
  cartRealizationProvenanceComparison
    finiteSelectiveCanonicalCartProvenance
    finiteSelectivePaddedCartProvenance

/-- The concrete provenance comparison API is reflexive. -/
theorem finiteSelectiveCartProvenanceComparison_refl :
    cartRealizationProvenanceComparison
        finiteSelectiveCanonicalCartProvenance
        finiteSelectiveCanonicalCartProvenance =
      Iso.refl (selectedCoreFiberReindexFunctor
        finiteSelectiveCanonicalCartProvenance.toRealizableHom) :=
  cartRealizationProvenanceComparison_refl
    finiteSelectiveCanonicalCartProvenance

/-- Reversing the concrete provenance comparison gives the reverse comparison. -/
theorem finiteSelectiveCartProvenanceComparison_symm :
    (finiteSelectiveCartProvenanceComparison).symm =
      cartRealizationProvenanceComparison
        finiteSelectivePaddedCartProvenance
        finiteSelectiveCanonicalCartProvenance :=
  cartRealizationProvenanceComparison_symm
    finiteSelectiveCanonicalCartProvenance
    finiteSelectivePaddedCartProvenance

/-- The raw-distinct provenance pair fires the whole-comparison cocycle. -/
theorem finiteSelectiveCartProvenanceComparison_cocycle :
    (finiteSelectiveCartProvenanceComparison).trans
        (cartRealizationProvenanceComparison
          finiteSelectivePaddedCartProvenance
          finiteSelectiveCanonicalCartProvenance) =
      cartRealizationProvenanceComparison
        finiteSelectiveCanonicalCartProvenance
        finiteSelectiveCanonicalCartProvenance :=
  cartRealizationProvenanceComparison_cocycle
    finiteSelectiveCanonicalCartProvenance
    finiteSelectivePaddedCartProvenance
    finiteSelectiveCanonicalCartProvenance

