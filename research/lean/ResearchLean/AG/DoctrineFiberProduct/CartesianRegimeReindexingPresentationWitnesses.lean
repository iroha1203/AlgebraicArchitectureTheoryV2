    finiteSelectiveOneToSupportPresentation
    finitePaddedSelectivePresentationComposition_eq

/--
Componentwise compositor compatibility compares the canonical and padded
direct presentations while keeping both genuine selective-chain legs fixed.
-/
theorem finiteSelectivePresentationCompositor_compatibility_app :
    (selectedTypedCoreFiberPresentationCompositorApp
      finiteSelectiveTwoToSupportPresentation
      finiteSelectiveTwoToOnePresentation
      finiteSelectiveOneToSupportPresentation
      finiteCanonicalSelectivePresentationComposition_eq
      finiteReindexFourAxisTarget).hom ≫
        (selectedTypedCoreFiberPresentationComparisonApp
          finiteSelectiveTwoToSupportPresentation
          finitePaddedSelectiveTwoToSupportPresentation
          (typedPresentationDirect_congr
            finiteSelectiveTwoToSupportPresentation
            finitePaddedSelectiveTwoToSupportPresentation
            finiteSelectiveTwoToOnePresentation
            finiteSelectiveTwoToOnePresentation
            finiteSelectiveOneToSupportPresentation
            finiteSelectiveOneToSupportPresentation
            finiteCanonicalSelectivePresentationComposition_eq
            finitePaddedSelectivePresentationComposition_eq rfl rfl)
          finiteReindexFourAxisTarget).hom =
      (selectedTypedCoreFiberReindexFunctor
        finiteSelectiveTwoToOnePresentation).map
          (selectedTypedCoreFiberPresentationComparisonApp
            finiteSelectiveOneToSupportPresentation
            finiteSelectiveOneToSupportPresentation rfl
            finiteReindexFourAxisTarget).hom ≫
        (selectedTypedCoreFiberPresentationComparisonApp
          finiteSelectiveTwoToOnePresentation
          finiteSelectiveTwoToOnePresentation rfl
          ((selectedTypedCoreFiberReindexFunctor
            finiteSelectiveOneToSupportPresentation).obj
              finiteReindexFourAxisTarget)).hom ≫
        finitePaddedSelectivePresentationCompositorApp.hom :=
  selectedTypedCoreFiberPresentationCompositor_compatibility_app
    finiteSelectiveTwoToSupportPresentation
    finitePaddedSelectiveTwoToSupportPresentation
    finiteSelectiveTwoToOnePresentation
    finiteSelectiveTwoToOnePresentation
    finiteSelectiveOneToSupportPresentation
    finiteSelectiveOneToSupportPresentation
    finiteCanonicalSelectivePresentationComposition_eq
    finitePaddedSelectivePresentationComposition_eq rfl rfl
    finiteReindexFourAxisTarget

/--
The whole relative compositor square commutes under replacement of the raw
direct presentation.
-/
theorem finiteSelectivePresentationCompositor_compatibility :
    (selectedTypedCoreFiberPresentationCompositor
      finiteSelectiveTwoToSupportPresentation
      finiteSelectiveTwoToOnePresentation
      finiteSelectiveOneToSupportPresentation
