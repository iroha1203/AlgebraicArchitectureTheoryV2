import ResearchLean.AG.DoctrineFiberProduct.CartesianBranch

/-!
# Producer-derived cartesian reindexing

This module constructs the contravariant core-fiber functor determined by a
G-110 cartesian regime.  For every object over the target of a realized arrow,
the regime produces a strong cartesian lift internally.  A vertical target
morphism is then reflected by the universal property of the lift at its
codomain.

The public selected functor consumes `selectedCartesianRegime`, which is the
named output of the fixed branch artifact.  No lift, cleavage, object action,
map, factorization, or functor-law certificate is accepted from the caller.
Base-arrow unitor/compositor data, cleavage independence, and the adjunction
with G-109 core transport remain later G-110 obligations.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open CategoryTheory
open AtomFoundation
open CrossStageCoherence

/-! ## One regime's internally generated cleavage -/

/--
Choose the strong cartesian lift supplied by a regime at one admitted realized
arrow and one target-fiber object.  The existence proof is generated by the
regime eliminator; it is not an argument of this definition.
-/
noncomputable def cartesianRegimeChosenLift
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (regime : CartesianRegime U) (input : RealizableHom U)
    (membership : regime.HCart input)
    (targetPackage : CoreFiber input.semantic.target) :
    StrongCartesianLift input.semantic targetPackage :=
  Classical.choice
    (regime.hasStrongCartesianLift input membership targetPackage)

/-- The chosen lift's domain as an object of the semantic source fiber. -/
noncomputable def cartesianRegimeReindexObject
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (regime : CartesianRegime U) (input : RealizableHom U)
    (membership : regime.HCart input)
    (targetPackage : CoreFiber input.semantic.target) :
    CoreFiber input.semantic.source :=
  (cartesianRegimeChosenLift regime input membership targetPackage).domainObject

/--
Reindex a vertical target-fiber morphism through the cartesian lift at its
codomain.  The returned map is vertical over the identity of the source.
-/
noncomputable def cartesianRegimeReindexMap
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (regime : CartesianRegime U) (input : RealizableHom U)
    (membership : regime.HCart input)
    {first second : CoreFiber input.semantic.target}
    (hom : first ⟶ second) :
    cartesianRegimeReindexObject regime input membership first ⟶
      cartesianRegimeReindexObject regime input membership second := by
  let firstLift := cartesianRegimeChosenLift regime input membership first
  let secondLift := cartesianRegimeChosenLift regime input membership second
  letI := firstLift.isStronglyCartesian
  letI := secondLift.isStronglyCartesian
  letI : (packageProjection U).IsHomLift
      (𝟙 input.semantic.target) hom.1 := hom.2
  letI : (packageProjection U).IsHomLift input.semantic.hom
      (firstLift.hom ≫ hom.1) := by
    simpa using inferInstanceAs
      ((packageProjection U).IsHomLift
        (input.semantic.hom ≫ 𝟙 input.semantic.target)
        (firstLift.hom ≫ hom.1))
  exact ⟨CategoryTheory.Functor.IsStronglyCartesian.map
      (packageProjection U) input.semantic.hom secondLift.hom
      (g := 𝟙 input.semantic.source)
      (f' := input.semantic.hom)
      (Category.id_comp input.semantic.hom).symm
      (firstLift.hom ≫ hom.1), inferInstance⟩

/-- The reflected vertical map satisfies its defining cartesian factorization. -/
theorem cartesianRegimeReindexMap_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (regime : CartesianRegime U) (input : RealizableHom U)
    (membership : regime.HCart input)
    {first second : CoreFiber input.semantic.target}
    (hom : first ⟶ second) :
    (cartesianRegimeReindexMap regime input membership hom).1 ≫
        (cartesianRegimeChosenLift regime input membership second).hom =
      (cartesianRegimeChosenLift regime input membership first).hom ≫ hom.1 := by
  let firstLift := cartesianRegimeChosenLift regime input membership first
  let secondLift := cartesianRegimeChosenLift regime input membership second
  letI := firstLift.isStronglyCartesian
  letI := secondLift.isStronglyCartesian
  letI : (packageProjection U).IsHomLift
      (𝟙 input.semantic.target) hom.1 := hom.2
  letI : (packageProjection U).IsHomLift input.semantic.hom
      (firstLift.hom ≫ hom.1) := by
    simpa using inferInstanceAs
      ((packageProjection U).IsHomLift
        (input.semantic.hom ≫ 𝟙 input.semantic.target)
        (firstLift.hom ≫ hom.1))
  exact CategoryTheory.Functor.IsStronglyCartesian.fac
    (packageProjection U) input.semantic.hom secondLift.hom
    (Category.id_comp input.semantic.hom).symm
    (firstLift.hom ≫ hom.1)

/-- The factor graph uniquely determines the reflected vertical map. -/
theorem cartesianRegimeReindexMap_unique
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (regime : CartesianRegime U) (input : RealizableHom U)
    (membership : regime.HCart input)
    {first second : CoreFiber input.semantic.target}
    (hom : first ⟶ second)
    (candidate : cartesianRegimeReindexObject regime input membership first ⟶
      cartesianRegimeReindexObject regime input membership second)
    (candidate_fac : candidate.1 ≫
        (cartesianRegimeChosenLift regime input membership second).hom =
      (cartesianRegimeChosenLift regime input membership first).hom ≫ hom.1) :
    candidate = cartesianRegimeReindexMap regime input membership hom := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let firstLift := cartesianRegimeChosenLift regime input membership first
  let secondLift := cartesianRegimeChosenLift regime input membership second
  letI := firstLift.isStronglyCartesian
  letI := secondLift.isStronglyCartesian
  letI : (packageProjection U).IsHomLift
      (𝟙 input.semantic.target) hom.1 := hom.2
  letI : (packageProjection U).IsHomLift
      (𝟙 input.semantic.source) candidate.1 := candidate.2
  letI : (packageProjection U).IsHomLift input.semantic.hom
      (firstLift.hom ≫ hom.1) := by
    simpa using inferInstanceAs
      ((packageProjection U).IsHomLift
        (input.semantic.hom ≫ 𝟙 input.semantic.target)
        (firstLift.hom ≫ hom.1))
  exact CategoryTheory.Functor.IsStronglyCartesian.map_uniq
    (packageProjection U) input.semantic.hom secondLift.hom
    (Category.id_comp input.semantic.hom).symm
    (firstLift.hom ≫ hom.1) candidate.1 candidate_fac

/-- Reindexing preserves target-fiber identities. -/
theorem cartesianRegimeReindexMap_id
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (regime : CartesianRegime U) (input : RealizableHom U)
    (membership : regime.HCart input)
    (targetPackage : CoreFiber input.semantic.target) :
    cartesianRegimeReindexMap regime input membership (𝟙 targetPackage) =
      𝟙 (cartesianRegimeReindexObject regime input membership targetPackage) := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let lift := cartesianRegimeChosenLift regime input membership targetPackage
  letI := lift.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U) input.semantic.hom lift.hom
    (𝟙 input.semantic.source)
  simpa using
    cartesianRegimeReindexMap_fac regime input membership (𝟙 targetPackage)

/-- Reindexing preserves composition of all target-fiber morphisms. -/
theorem cartesianRegimeReindexMap_comp
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (regime : CartesianRegime U) (input : RealizableHom U)
    (membership : regime.HCart input)
    {first second third : CoreFiber input.semantic.target}
    (firstHom : first ⟶ second) (secondHom : second ⟶ third) :
    cartesianRegimeReindexMap regime input membership (firstHom ≫ secondHom) =
      cartesianRegimeReindexMap regime input membership firstHom ≫
        cartesianRegimeReindexMap regime input membership secondHom := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let thirdLift := cartesianRegimeChosenLift regime input membership third
  letI := thirdLift.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U) input.semantic.hom thirdLift.hom
    (𝟙 input.semantic.source)
  change
    (cartesianRegimeReindexMap regime input membership
        (firstHom ≫ secondHom)).1 ≫ thirdLift.hom =
      ((cartesianRegimeReindexMap regime input membership firstHom).1 ≫
        (cartesianRegimeReindexMap regime input membership secondHom).1) ≫
          thirdLift.hom
  calc
    _ = (cartesianRegimeChosenLift regime input membership first).hom ≫
        (firstHom ≫ secondHom).1 :=
      cartesianRegimeReindexMap_fac regime input membership
        (firstHom ≫ secondHom)
    _ = (cartesianRegimeChosenLift regime input membership first).hom ≫
        (firstHom.1 ≫ secondHom.1) := rfl
    _ = ((cartesianRegimeChosenLift regime input membership first).hom ≫
        firstHom.1) ≫ secondHom.1 := (Category.assoc _ _ _).symm
    _ = ((cartesianRegimeReindexMap regime input membership firstHom).1 ≫
        (cartesianRegimeChosenLift regime input membership second).hom) ≫
          secondHom.1 := by
      rw [cartesianRegimeReindexMap_fac]
    _ = (cartesianRegimeReindexMap regime input membership firstHom).1 ≫
        ((cartesianRegimeChosenLift regime input membership second).hom ≫
          secondHom.1) := Category.assoc _ _ _
    _ = (cartesianRegimeReindexMap regime input membership firstHom).1 ≫
        ((cartesianRegimeReindexMap regime input membership secondHom).1 ≫
          thirdLift.hom) := by
      rw [cartesianRegimeReindexMap_fac]
    _ = _ := (Category.assoc _ _ _).symm

/-- The core-fiber pullback functor generated by one admitted regime arrow. -/
noncomputable def cartesianRegimeReindexFunctor
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (regime : CartesianRegime U) (input : RealizableHom U)
    (membership : regime.HCart input) :
    CoreFiber input.semantic.target ⥤ CoreFiber input.semantic.source where
  obj := cartesianRegimeReindexObject regime input membership
  map := cartesianRegimeReindexMap regime input membership
  map_id := cartesianRegimeReindexMap_id regime input membership
  map_comp := cartesianRegimeReindexMap_comp regime input membership

/-! ## The functor produced by the fixed branch artifact -/

/-- The selected regime's internally generated strong cartesian lift. -/
noncomputable def selectedCoreFiberCartesianLift
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    (targetPackage : CoreFiber input.semantic.target) :
    StrongCartesianLift input.semantic targetPackage :=
  cartesianRegimeChosenLift (selectedCartesianRegime U) input
    (selectedCartesianRegime_HCart U input) targetPackage

/-- The selected producer-derived pullback reindexing functor. -/
noncomputable def selectedCoreFiberReindexFunctor
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U) :
    CoreFiber input.semantic.target ⥤ CoreFiber input.semantic.source :=
  cartesianRegimeReindexFunctor (selectedCartesianRegime U) input
    (selectedCartesianRegime_HCart U input)

/-- The selected functor's object action is the domain of its generated lift. -/
theorem selectedCoreFiberReindexFunctor_obj
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    (targetPackage : CoreFiber input.semantic.target) :
    (selectedCoreFiberReindexFunctor input).obj targetPackage =
      (selectedCoreFiberCartesianLift input targetPackage).domainObject :=
  rfl

/-- The selected functor's map is the internally generated universal factor. -/
theorem selectedCoreFiberReindexFunctor_map
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    {first second : CoreFiber input.semantic.target}
    (hom : first ⟶ second) :
    (selectedCoreFiberReindexFunctor input).map hom =
      cartesianRegimeReindexMap (selectedCartesianRegime U) input
        (selectedCartesianRegime_HCart U input) hom :=
  rfl

/-- The selected map satisfies the actual cartesian factor graph. -/
theorem selectedCoreFiberReindexFunctor_map_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    {first second : CoreFiber input.semantic.target}
    (hom : first ⟶ second) :
    ((selectedCoreFiberReindexFunctor input).map hom).1 ≫
        (selectedCoreFiberCartesianLift input second).hom =
      (selectedCoreFiberCartesianLift input first).hom ≫ hom.1 :=
  cartesianRegimeReindexMap_fac (selectedCartesianRegime U) input
    (selectedCartesianRegime_HCart U input) hom

/-- The selected factor graph uniquely determines the selected map. -/
theorem selectedCoreFiberReindexFunctor_map_unique
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    {first second : CoreFiber input.semantic.target}
    (hom : first ⟶ second)
    (candidate : (selectedCoreFiberReindexFunctor input).obj first ⟶
      (selectedCoreFiberReindexFunctor input).obj second)
    (candidate_fac : candidate.1 ≫
        (selectedCoreFiberCartesianLift input second).hom =
      (selectedCoreFiberCartesianLift input first).hom ≫ hom.1) :
    candidate = (selectedCoreFiberReindexFunctor input).map hom :=
  cartesianRegimeReindexMap_unique (selectedCartesianRegime U) input
    (selectedCartesianRegime_HCart U input) hom candidate candidate_fac

/-- The selected producer's identity law is the generated functor law. -/
theorem selectedCoreFiberReindexFunctor_map_id
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    (targetPackage : CoreFiber input.semantic.target) :
    (selectedCoreFiberReindexFunctor input).map (𝟙 targetPackage) =
      𝟙 ((selectedCoreFiberReindexFunctor input).obj targetPackage) :=
  (selectedCoreFiberReindexFunctor input).map_id targetPackage

/-- The selected producer's composition law is the generated functor law. -/
theorem selectedCoreFiberReindexFunctor_map_comp
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    {first second third : CoreFiber input.semantic.target}
    (firstHom : first ⟶ second) (secondHom : second ⟶ third) :
    (selectedCoreFiberReindexFunctor input).map (firstHom ≫ secondHom) =
      (selectedCoreFiberReindexFunctor input).map firstHom ≫
        (selectedCoreFiberReindexFunctor input).map secondHom :=
  (selectedCoreFiberReindexFunctor input).map_comp firstHom secondHom

end AAT.AG.DoctrineFiberProduct

#assert_standard_axioms_only AAT.AG.DoctrineFiberProduct
