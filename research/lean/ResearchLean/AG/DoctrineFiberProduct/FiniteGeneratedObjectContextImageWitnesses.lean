import ResearchLean.AG.DoctrineFiberProduct.FiniteGeneratedContextImageDescent

/-!
# Concrete generated object and context image witnesses

This module fires the generated-image descent API on the existing selective
two-source chain.  The supplied high lift, prefix, and normalized high factor
are generated internally from that chain.  The architecture object has
nontrivial opaque carriers and values, and the context exercises all four
context carriers, both accepted and rejected readings, and a nonidentity raw
restriction.

The context witness uses only the canonical context image and its internally
generated carrier shape.  It does not construct a context equivalence or a
complete reflected package hom.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open CategoryTheory
open AtomFoundation

/-! ## Internally generated selective-two data -/

/-- The tail input generated by the existing selective two-source chain. -/
def finiteSelectiveTwoObjectContextWitnessInput : FiniteGeneratedLiftInput :=
  finiteSelectiveTwoGeneratedChain.tailGeneratedInput

/-- The theorem-generated high lift of the selective-two tail input. -/
noncomputable def finiteSelectiveTwoObjectContextWitnessLift :
    StrongCartesianLift
      (FiniteGeneratedLiftInput.highInput.{u}
        finiteSelectiveTwoObjectContextWitnessInput)
      (FiniteGeneratedLiftInput.highTarget.{u}
        finiteSelectiveTwoObjectContextWitnessInput) :=
  FiniteGeneratedLiftInput.highGeneratedLift.{u}
    finiteSelectiveTwoObjectContextWitnessInput

/-- The inverse-generated package at the source of the selective-two prefix. -/
noncomputable def finiteSelectiveTwoObjectContextWitnessPackage :
    AATCorePackage FiniteModel.carrier :=
  inverseCorePackage FiniteModel.corePackage
    (finiteSelectiveTwoGeneratedChain.first ≫
      finiteSelectiveTwoGeneratedChain.second)

/-- The concrete selective-two prefix used to form the actual normalized high factor. -/
def finiteSelectiveTwoObjectContextWitnessBase :
    packagePoint finiteSelectiveTwoObjectContextWitnessPackage ⟶
      finiteSelectiveTwoObjectContextWitnessInput.source :=
  finiteSelectiveTwoGeneratedChain.first

/-- The shared generated prefix remains genuinely noninvertible. -/
theorem finiteSelectiveTwoObjectContextWitnessBase_not_isIso :
    ¬ IsIso finiteSelectiveTwoObjectContextWitnessBase := by
  exact finiteSelectiveTwoGeneratedChain_first_not_isIso

/-- The actual normalized high factor generated from the selective-two data. -/
noncomputable def finiteSelectiveTwoObjectContextActualHighFactor :=
  finiteGeneratedNormalizedHighFactor.{u}
    finiteSelectiveTwoObjectContextWitnessInput
    finiteSelectiveTwoObjectContextWitnessLift.{u}
    finiteSelectiveTwoObjectContextWitnessBase

/-! ## A complete nontrivial architecture-object image -/

/--
A finite-model object with a Boolean structure-map value and a two-element
selected-quantity value.
-/
def finiteSelectiveTwoNontrivialObject :
    ArchitectureObject FiniteModel.carrier where
  configuration := FiniteModel.configuration
  StructureMaps := Bool
  SelectedQuantities := Fin 2
  structureMaps := true
  selectedQuantities := 1

/--
The complete object reflected from the actual normalized high factor image of
the nontrivial finite-model object.
-/
noncomputable def finiteSelectiveTwoActualReflectedNontrivialObject :
    ArchitectureObject FiniteModel.carrier :=
  finiteGeneratedReflectedArchitectureObject.{u}
    finiteSelectiveTwoObjectContextWitnessInput
    finiteSelectiveTwoObjectContextWitnessLift.{u}
    finiteSelectiveTwoObjectContextWitnessBase
    finiteSelectiveTwoNontrivialObject

/-- The actual reflected object retains the Boolean structure-map carrier. -/
@[simp]
theorem finiteSelectiveTwoActualReflectedNontrivialObject_structureMaps_type :
    finiteSelectiveTwoActualReflectedNontrivialObject.{u}.StructureMaps = Bool :=
  rfl

/-- The actual reflected object retains the two-element selected-quantity carrier. -/
@[simp]
theorem finiteSelectiveTwoActualReflectedNontrivialObject_selectedQuantities_type :
    finiteSelectiveTwoActualReflectedNontrivialObject.{u}.SelectedQuantities = Fin 2 :=
  rfl

/-- The Boolean value reflected from the actual high image is `true`. -/
@[simp]
theorem finiteSelectiveTwoActualReflectedNontrivialObject_structureMaps :
    cast finiteSelectiveTwoActualReflectedNontrivialObject_structureMaps_type.{u}
      finiteSelectiveTwoActualReflectedNontrivialObject.{u}.structureMaps =
      true := by
  change
    (finiteGeneratedReflectedArchitectureObject.{u}
      finiteSelectiveTwoObjectContextWitnessInput
      finiteSelectiveTwoObjectContextWitnessLift.{u}
      finiteSelectiveTwoObjectContextWitnessBase
      finiteSelectiveTwoNontrivialObject).structureMaps = true
  have hobject := finiteGeneratedReflectedArchitectureObject_transport.{u}
    finiteSelectiveTwoObjectContextWitnessInput
    finiteSelectiveTwoObjectContextWitnessLift.{u}
    finiteSelectiveTwoObjectContextWitnessBase
    finiteSelectiveTwoNontrivialObject
  have hpacked := congrArg
    (fun object : ArchitectureObject FiniteModel.carrier =>
      Sigma.mk (β := fun carrier : Type => carrier)
        object.StructureMaps object.structureMaps)
    hobject
  exact eq_of_heq (Sigma.mk.inj_iff.mp hpacked).2

/-- The selected quantity reflected from the actual high image is the nonzero element. -/
@[simp]
theorem finiteSelectiveTwoActualReflectedNontrivialObject_selectedQuantities :
    cast finiteSelectiveTwoActualReflectedNontrivialObject_selectedQuantities_type.{u}
      finiteSelectiveTwoActualReflectedNontrivialObject.{u}.selectedQuantities =
      (1 : Fin 2) := by
  change
    (finiteGeneratedReflectedArchitectureObject.{u}
      finiteSelectiveTwoObjectContextWitnessInput
      finiteSelectiveTwoObjectContextWitnessLift.{u}
      finiteSelectiveTwoObjectContextWitnessBase
      finiteSelectiveTwoNontrivialObject).selectedQuantities = (1 : Fin 2)
  have hobject := finiteGeneratedReflectedArchitectureObject_transport.{u}
    finiteSelectiveTwoObjectContextWitnessInput
    finiteSelectiveTwoObjectContextWitnessLift.{u}
    finiteSelectiveTwoObjectContextWitnessBase
    finiteSelectiveTwoNontrivialObject
  have hpacked := congrArg
    (fun object : ArchitectureObject FiniteModel.carrier =>
      Sigma.mk (β := fun carrier : Type => carrier)
        object.SelectedQuantities object.selectedQuantities)
    hobject
  exact eq_of_heq (Sigma.mk.inj_iff.mp hpacked).2

/-- The reflected Boolean structure-map value is genuinely nontrivial. -/
theorem finiteSelectiveTwoActualReflectedNontrivialObject_structureMaps_ne_false :
    cast finiteSelectiveTwoActualReflectedNontrivialObject_structureMaps_type.{u}
        finiteSelectiveTwoActualReflectedNontrivialObject.{u}.structureMaps ≠
      false := by
  rw [finiteSelectiveTwoActualReflectedNontrivialObject_structureMaps]
  intro h
  cases h

/-- The reflected selected quantity is genuinely nonzero. -/
theorem finiteSelectiveTwoActualReflectedNontrivialObject_selectedQuantities_ne_zero :
    cast finiteSelectiveTwoActualReflectedNontrivialObject_selectedQuantities_type.{u}
        finiteSelectiveTwoActualReflectedNontrivialObject.{u}.selectedQuantities ≠
      (0 : Fin 2) := by
  rw [finiteSelectiveTwoActualReflectedNontrivialObject_selectedQuantities]
  intro h
  have hval := congrArg Fin.val h
  cases hval

/--
The complete lift of the reflected object is the object produced by the actual
normalized high factor, including both opaque fields.
-/
theorem finiteSelectiveTwoActualReflectedNontrivialObject_high_image :
    finiteModelLiftArchitectureObject.{u}
        finiteSelectiveTwoActualReflectedNontrivialObject.{u} =
      finiteSelectiveTwoObjectContextActualHighFactor.{u}.upper.objectMap
        (finiteModelLiftArchitectureObject.{u}
          finiteSelectiveTwoNontrivialObject) := by
  unfold finiteSelectiveTwoActualReflectedNontrivialObject
    finiteSelectiveTwoObjectContextActualHighFactor
  exact finiteGeneratedReflectedArchitectureObject_high_image.{u}
    finiteSelectiveTwoObjectContextWitnessInput
    finiteSelectiveTwoObjectContextWitnessLift.{u}
    finiteSelectiveTwoObjectContextWitnessBase
    finiteSelectiveTwoNontrivialObject

/-- The lifted reflected structure-map value has the actual-high cast graph. -/
theorem finiteSelectiveTwoActualReflectedNontrivialObject_structureMaps_high_graph :
    ULift.up
        finiteSelectiveTwoActualReflectedNontrivialObject.{u}.structureMaps =
      cast
        (finiteGeneratedNormalizedHighFactor_objectMap_structureMaps_type
          finiteSelectiveTwoObjectContextWitnessInput
          finiteSelectiveTwoObjectContextWitnessLift.{u}
          finiteSelectiveTwoObjectContextWitnessBase
          finiteSelectiveTwoNontrivialObject)
        ((finiteSelectiveTwoObjectContextActualHighFactor.{u}.upper.objectMap
          (finiteModelLiftArchitectureObject.{u}
            finiteSelectiveTwoNontrivialObject)).structureMaps) := by
  unfold finiteSelectiveTwoActualReflectedNontrivialObject
    finiteSelectiveTwoObjectContextActualHighFactor
  exact finiteGeneratedReflectedArchitectureObject_structureMaps_high_graph.{u}
    finiteSelectiveTwoObjectContextWitnessInput
    finiteSelectiveTwoObjectContextWitnessLift.{u}
    finiteSelectiveTwoObjectContextWitnessBase
    finiteSelectiveTwoNontrivialObject

/-- The lifted reflected selected quantity has the actual-high cast graph. -/
theorem finiteSelectiveTwoActualReflectedNontrivialObject_selectedQuantities_high_graph :
    ULift.up
        finiteSelectiveTwoActualReflectedNontrivialObject.{u}.selectedQuantities =
      cast
        (finiteGeneratedNormalizedHighFactor_objectMap_selectedQuantities_type
          finiteSelectiveTwoObjectContextWitnessInput
          finiteSelectiveTwoObjectContextWitnessLift.{u}
          finiteSelectiveTwoObjectContextWitnessBase
          finiteSelectiveTwoNontrivialObject)
        ((finiteSelectiveTwoObjectContextActualHighFactor.{u}.upper.objectMap
          (finiteModelLiftArchitectureObject.{u}
            finiteSelectiveTwoNontrivialObject)).selectedQuantities) := by
  unfold finiteSelectiveTwoActualReflectedNontrivialObject
    finiteSelectiveTwoObjectContextActualHighFactor
  exact finiteGeneratedReflectedArchitectureObject_selectedQuantities_high_graph.{u}
    finiteSelectiveTwoObjectContextWitnessInput
    finiteSelectiveTwoObjectContextWitnessLift.{u}
    finiteSelectiveTwoObjectContextWitnessBase
    finiteSelectiveTwoNontrivialObject

/-- The actual high structure-map field is heterogeneously equal to `ULift.up true`. -/
theorem finiteSelectiveTwoActualHighObject_structureMaps_heq :
    HEq
      (finiteSelectiveTwoObjectContextActualHighFactor.{u}.upper.objectMap
        (finiteModelLiftArchitectureObject.{u}
          finiteSelectiveTwoNontrivialObject)).structureMaps
      (ULift.up true : ULift.{u} Bool) := by
  rw [← finiteSelectiveTwoActualReflectedNontrivialObject_high_image.{u}]
  have htype :=
    finiteSelectiveTwoActualReflectedNontrivialObject_structureMaps_type.{u}
  have hvalue :=
    finiteSelectiveTwoActualReflectedNontrivialObject_structureMaps.{u}
  cases htype
  exact heq_of_eq (congrArg ULift.up hvalue)

/-- The actual high selected-quantity field is heterogeneously equal to `ULift.up 1`. -/
theorem finiteSelectiveTwoActualHighObject_selectedQuantities_heq :
    HEq
      (finiteSelectiveTwoObjectContextActualHighFactor.{u}.upper.objectMap
        (finiteModelLiftArchitectureObject.{u}
          finiteSelectiveTwoNontrivialObject)).selectedQuantities
      (ULift.up (1 : Fin 2) : ULift.{u} (Fin 2)) := by
  rw [← finiteSelectiveTwoActualReflectedNontrivialObject_high_image.{u}]
  have htype :=
    finiteSelectiveTwoActualReflectedNontrivialObject_selectedQuantities_type.{u}
  have hvalue :=
    finiteSelectiveTwoActualReflectedNontrivialObject_selectedQuantities.{u}
  cases htype
  exact heq_of_eq (congrArg ULift.up hvalue)

/-! ## A four-carrier context and its canonical image -/

/-- The transported `componentA` selected by the actual reflected Atom map. -/
noncomputable def finiteSelectiveTwoActualReflectedComponentA :
    FiniteModel.carrier.Atom :=
  finiteGeneratedReflectedUpperAtomEquiv.{u}
    finiteSelectiveTwoObjectContextWitnessInput
    finiteSelectiveTwoObjectContextWitnessLift.{u}
    finiteSelectiveTwoObjectContextWitnessBase
    FiniteModel.FiniteAtom.componentA

/-- The transported `componentA` belongs to the actual reflected object family. -/
theorem finiteSelectiveTwoActualReflectedComponentA_mem :
    finiteSelectiveTwoActualReflectedNontrivialObject.{u}.configuration.family.mem
      finiteSelectiveTwoActualReflectedComponentA.{u} := by
  rw [finiteSelectiveTwoActualReflectedNontrivialObject,
    finiteGeneratedReflectedArchitectureObject_transport]
  refine ⟨FiniteModel.FiniteAtom.componentA, ?_, rfl⟩
  change FiniteModel.allFamily.mem FiniteModel.FiniteAtom.componentA
  exact FiniteModel.allFamily_mem FiniteModel.FiniteAtom.componentA (by
    intro h
    cases h)

/--
A context on the actual reflected object with four nontrivial carriers and
selected positive and negative readings.
-/
noncomputable def finiteSelectiveTwoNontrivialContext :
    Site.ArchitectureContext
      finiteSelectiveTwoActualReflectedNontrivialObject.{u} where
  minimal := {
    Support := Bool
    Axis := Fin 2
    Observable := Bool
    supportReads := fun support atom =>
      support = true ∧
        finiteSelectiveTwoActualReflectedNontrivialObject.{u}.configuration.family.mem atom
    supportReads_objectFamily := by
      intro support atom hread
      exact hread.2
    axisReads := fun axis => axis = 1
    observableReads := fun observable => observable = true
  }
  Extension := Fin 3
  extension := 2

/-- The concrete context support carrier is Boolean. -/
@[simp]
theorem finiteSelectiveTwoNontrivialContext_support_type :
    finiteSelectiveTwoNontrivialContext.{u}.Support = Bool :=
  rfl

/-- The concrete context axis carrier has two elements. -/
@[simp]
theorem finiteSelectiveTwoNontrivialContext_axis_type :
    finiteSelectiveTwoNontrivialContext.{u}.Axis = Fin 2 :=
  rfl

/-- The concrete context observable carrier is Boolean. -/
@[simp]
theorem finiteSelectiveTwoNontrivialContext_observable_type :
    finiteSelectiveTwoNontrivialContext.{u}.Observable = Bool :=
  rfl

/-- The concrete context extension carrier has three elements. -/
@[simp]
theorem finiteSelectiveTwoNontrivialContext_extension_type :
    finiteSelectiveTwoNontrivialContext.{u}.Extension = Fin 3 :=
  rfl

/-- The positive support reads the transported `componentA`. -/
theorem finiteSelectiveTwoNontrivialContext_support_accepts :
    finiteSelectiveTwoNontrivialContext.{u}.minimal.supportReads true
      finiteSelectiveTwoActualReflectedComponentA.{u} :=
  ⟨rfl, finiteSelectiveTwoActualReflectedComponentA_mem.{u}⟩

/-- The negative support does not read the transported `componentA`. -/
theorem finiteSelectiveTwoNontrivialContext_support_rejects :
    ¬ finiteSelectiveTwoNontrivialContext.{u}.minimal.supportReads false
      finiteSelectiveTwoActualReflectedComponentA.{u} := by
  intro hread
  cases hread.1

/-- Axis `1` is accepted by the concrete context. -/
theorem finiteSelectiveTwoNontrivialContext_axis_accepts :
    finiteSelectiveTwoNontrivialContext.{u}.minimal.axisReads (1 : Fin 2) :=
  rfl

/-- Axis `0` is rejected by the concrete context. -/
theorem finiteSelectiveTwoNontrivialContext_axis_rejects :
    ¬ finiteSelectiveTwoNontrivialContext.{u}.minimal.axisReads (0 : Fin 2) := by
  intro hread
  have hval := congrArg Fin.val hread
  cases hval

/-- Observable `true` is accepted by the concrete context. -/
theorem finiteSelectiveTwoNontrivialContext_observable_accepts :
    finiteSelectiveTwoNontrivialContext.{u}.minimal.observableReads true :=
  rfl

/-- Observable `false` is rejected by the concrete context. -/
theorem finiteSelectiveTwoNontrivialContext_observable_rejects :
    ¬ finiteSelectiveTwoNontrivialContext.{u}.minimal.observableReads false := by
  intro hread
  cases hread

/-- The concrete context selects the nonzero extension value `2`. -/
@[simp]
theorem finiteSelectiveTwoNontrivialContext_extension :
    finiteSelectiveTwoNontrivialContext.{u}.extension = (2 : Fin 3) :=
  rfl

/-- The canonical high context image of the concrete four-carrier context. -/
noncomputable def finiteSelectiveTwoLiftedNontrivialContext :=
  finiteModelLiftArchitectureContext.{u}
    finiteSelectiveTwoNontrivialContext.{u}

/-- The high context support carrier is the canonical lift of `Bool`. -/
@[simp]
theorem finiteSelectiveTwoLiftedNontrivialContext_support_type :
    finiteSelectiveTwoLiftedNontrivialContext.{u}.Support = ULift.{u} Bool :=
  rfl

/-- The high context axis carrier is the canonical lift of `Fin 2`. -/
@[simp]
theorem finiteSelectiveTwoLiftedNontrivialContext_axis_type :
    finiteSelectiveTwoLiftedNontrivialContext.{u}.Axis = ULift.{u} (Fin 2) :=
  rfl

/-- The high context observable carrier is the canonical lift of `Bool`. -/
@[simp]
theorem finiteSelectiveTwoLiftedNontrivialContext_observable_type :
    finiteSelectiveTwoLiftedNontrivialContext.{u}.Observable = ULift.{u} Bool :=
  rfl

/-- The high context extension carrier is the canonical lift of `Fin 3`. -/
@[simp]
theorem finiteSelectiveTwoLiftedNontrivialContext_extension_type :
    finiteSelectiveTwoLiftedNontrivialContext.{u}.Extension = ULift.{u} (Fin 3) :=
  rfl

/--
A high context whose empty support carrier cannot have the canonical lifted
shape of the inhabited Boolean support carrier.
-/
noncomputable def finiteSelectiveTwoSupportShapeMismatchContext :
    Site.ArchitectureContext
      (finiteModelLiftArchitectureObject.{u}
        finiteSelectiveTwoActualReflectedNontrivialObject.{u}) where
  minimal := {
    Support := PEmpty
    Axis := ULift.{u} (Fin 2)
    Observable := ULift.{u} Bool
    supportReads := fun _ _ => False
    supportReads_objectFamily := by
      intro support
      exact PEmpty.elim support
    axisReads := fun _ => False
    observableReads := fun _ => False
  }
  Extension := ULift.{u} (Fin 3)
  extension := ULift.up (2 : Fin 3)

/-- The mismatched high context admits no Boolean-template carrier shape. -/
theorem finiteSelectiveTwoSupportShapeMismatchContext_no_shape :
    ¬ Nonempty
      (FiniteModelContextCarrierShape
        finiteSelectiveTwoNontrivialContext.{u}
        finiteSelectiveTwoSupportShapeMismatchContext.{u}) := by
  rintro ⟨shape⟩
  have impossible : PEmpty :=
    _root_.cast shape.support_eq (ULift.up true)
  exact PEmpty.elim impossible

/-- The internally shape-reflected canonical high context. -/
noncomputable def finiteSelectiveTwoReflectedLiftedNontrivialContext :=
  finiteModelReflectArchitectureContextAt.{u}
    finiteSelectiveTwoNontrivialContext.{u}
    finiteSelectiveTwoLiftedNontrivialContext.{u}
    (finiteModelLiftArchitectureContext_shape.{u}
      finiteSelectiveTwoNontrivialContext.{u})

/-- Reflecting the canonical lift recovers the complete four-carrier context. -/
theorem finiteSelectiveTwoReflectedLiftedNontrivialContext_eq :
    finiteSelectiveTwoReflectedLiftedNontrivialContext.{u} =
      finiteSelectiveTwoNontrivialContext.{u} := by
  unfold finiteSelectiveTwoReflectedLiftedNontrivialContext
    finiteSelectiveTwoLiftedNontrivialContext
  exact finiteModelReflectArchitectureContextAt_lift.{u}
    finiteSelectiveTwoNontrivialContext.{u}

/-- Lifting the reflected context recovers the complete canonical high context. -/
theorem finiteSelectiveTwoLiftedReflectedNontrivialContext_eq :
    finiteModelLiftArchitectureContext.{u}
        finiteSelectiveTwoReflectedLiftedNontrivialContext.{u} =
      finiteSelectiveTwoLiftedNontrivialContext.{u} := by
  unfold finiteSelectiveTwoReflectedLiftedNontrivialContext
    finiteSelectiveTwoLiftedNontrivialContext
  exact finiteModelLiftArchitectureContext_reflectAt.{u}
    finiteSelectiveTwoNontrivialContext.{u}
    (finiteModelLiftArchitectureContext.{u}
      finiteSelectiveTwoNontrivialContext.{u})
    (finiteModelLiftArchitectureContext_shape.{u}
      finiteSelectiveTwoNontrivialContext.{u})

/-- The lifted context accepts the lifted positive support reading. -/
theorem finiteSelectiveTwoLiftedNontrivialContext_support_accepts :
    finiteSelectiveTwoLiftedNontrivialContext.{u}.minimal.supportReads
      (ULift.up true)
      (finiteModelLiftCarrierEquiv.{u}.atom
        finiteSelectiveTwoActualReflectedComponentA.{u}) := by
  exact (finiteModelLiftArchitectureContext_supportReads.{u}
    finiteSelectiveTwoNontrivialContext.{u} true
    finiteSelectiveTwoActualReflectedComponentA.{u}).2
      finiteSelectiveTwoNontrivialContext_support_accepts

/-- The lifted context rejects the lifted negative support reading. -/
theorem finiteSelectiveTwoLiftedNontrivialContext_support_rejects :
    ¬ finiteSelectiveTwoLiftedNontrivialContext.{u}.minimal.supportReads
      (ULift.up false)
      (finiteModelLiftCarrierEquiv.{u}.atom
        finiteSelectiveTwoActualReflectedComponentA.{u}) := by
  intro hread
  exact finiteSelectiveTwoNontrivialContext_support_rejects
    ((finiteModelLiftArchitectureContext_supportReads.{u}
      finiteSelectiveTwoNontrivialContext.{u} false
      finiteSelectiveTwoActualReflectedComponentA.{u}).1 hread)

/-- The lifted context accepts the lifted selected axis. -/
theorem finiteSelectiveTwoLiftedNontrivialContext_axis_accepts :
    finiteSelectiveTwoLiftedNontrivialContext.{u}.minimal.axisReads
      (ULift.up (1 : Fin 2)) :=
  (finiteModelLiftArchitectureContext_axisReads.{u}
    finiteSelectiveTwoNontrivialContext.{u} (1 : Fin 2)).2
      finiteSelectiveTwoNontrivialContext_axis_accepts.{u}

/-- The lifted context rejects the lifted unselected axis. -/
theorem finiteSelectiveTwoLiftedNontrivialContext_axis_rejects :
    ¬ finiteSelectiveTwoLiftedNontrivialContext.{u}.minimal.axisReads
      (ULift.up (0 : Fin 2)) := by
  intro hread
  exact finiteSelectiveTwoNontrivialContext_axis_rejects.{u}
    ((finiteModelLiftArchitectureContext_axisReads.{u}
      finiteSelectiveTwoNontrivialContext.{u} (0 : Fin 2)).1 hread)

/-- The lifted context accepts the lifted selected observable. -/
theorem finiteSelectiveTwoLiftedNontrivialContext_observable_accepts :
    finiteSelectiveTwoLiftedNontrivialContext.{u}.minimal.observableReads
      (ULift.up true) :=
  (finiteModelLiftArchitectureContext_observableReads.{u}
    finiteSelectiveTwoNontrivialContext.{u} true).2
      finiteSelectiveTwoNontrivialContext_observable_accepts.{u}

/-- The lifted context rejects the lifted unselected observable. -/
theorem finiteSelectiveTwoLiftedNontrivialContext_observable_rejects :
    ¬ finiteSelectiveTwoLiftedNontrivialContext.{u}.minimal.observableReads
      (ULift.up false) := by
  intro hread
  exact finiteSelectiveTwoNontrivialContext_observable_rejects.{u}
    ((finiteModelLiftArchitectureContext_observableReads.{u}
      finiteSelectiveTwoNontrivialContext.{u} false).1 hread)

/-- The lifted extension value is the lift of the concrete nonzero value `2`. -/
@[simp]
theorem finiteSelectiveTwoLiftedNontrivialContext_extension :
    finiteSelectiveTwoLiftedNontrivialContext.{u}.extension =
      ULift.up (2 : Fin 3) :=
  rfl

/-! ## A nonidentity restriction and its two round trips -/

/-- The negative Boolean support viewed in the concrete context carrier. -/
def finiteSelectiveTwoContextFalseSupport :
    finiteSelectiveTwoNontrivialContext.{u}.Support := by
  change Bool
  exact false

/-- The positive Boolean support viewed in the concrete context carrier. -/
def finiteSelectiveTwoContextTrueSupport :
    finiteSelectiveTwoNontrivialContext.{u}.Support := by
  change Bool
  exact true

/-- The unselected axis viewed in the concrete context carrier. -/
def finiteSelectiveTwoContextZeroAxis :
    finiteSelectiveTwoNontrivialContext.{u}.Axis := by
  change Fin 2
  exact 0

/-- The selected axis viewed in the concrete context carrier. -/
def finiteSelectiveTwoContextOneAxis :
    finiteSelectiveTwoNontrivialContext.{u}.Axis := by
  change Fin 2
  exact 1

/--
A raw restriction endomap that sends every support to `true`, every axis to
`1`, and leaves observables unchanged.
-/
noncomputable def finiteSelectiveTwoNonidentityRestriction :
    Site.ContextMorphism finiteSelectiveTwoNontrivialContext.{u}
      finiteSelectiveTwoNontrivialContext.{u} where
  supportMap _ := finiteSelectiveTwoContextTrueSupport.{u}
  axisMap _ := finiteSelectiveTwoContextOneAxis.{u}
  observableRestrict := by
    change Bool → Bool
    exact id

/-- The concrete raw endomap satisfies the selected restriction role. -/
theorem finiteSelectiveTwoNonidentityRestriction_isRestriction :
    finiteSelectiveTwoNonidentityRestriction.{u}.IsRestriction := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro support atom hread
    change true = true ∧
      finiteSelectiveTwoActualReflectedNontrivialObject.{u}.configuration.family.mem atom
    exact ⟨rfl, hread.2⟩
  · intro axis hread
    change (1 : Fin 2) = 1
    rfl
  · intro observable hread
    exact hread
  · intro support atom hread
    exact hread.2

/-- The raw restriction is not the identity context morphism. -/
theorem finiteSelectiveTwoNonidentityRestriction_ne_identity :
    finiteSelectiveTwoNonidentityRestriction.{u} ≠
      Site.identityContextMorphism finiteSelectiveTwoNontrivialContext.{u} := by
  intro heq
  have hmap := congrArg
    (fun f => f.supportMap finiteSelectiveTwoContextFalseSupport.{u}) heq
  change true = false at hmap
  cases hmap

/-- The nonidentity restriction fires by sending `false` support to `true`. -/
@[simp]
theorem finiteSelectiveTwoNonidentityRestriction_supportMap_false :
    finiteSelectiveTwoNonidentityRestriction.{u}.supportMap
        finiteSelectiveTwoContextFalseSupport.{u} =
      finiteSelectiveTwoContextTrueSupport.{u} :=
  rfl

/-- The nonidentity restriction fires by sending axis `0` to axis `1`. -/
@[simp]
theorem finiteSelectiveTwoNonidentityRestriction_axisMap_zero :
    finiteSelectiveTwoNonidentityRestriction.{u}.axisMap
        finiteSelectiveTwoContextZeroAxis.{u} =
      finiteSelectiveTwoContextOneAxis.{u} :=
  rfl

/-- The canonical high lift of the nonidentity restriction. -/
noncomputable def finiteSelectiveTwoLiftedNonidentityRestriction :=
  finiteModelLiftContextMorphism.{u}
    finiteSelectiveTwoNonidentityRestriction.{u}

/-- The lifted nonidentity endomap remains a restriction. -/
theorem finiteSelectiveTwoLiftedNonidentityRestriction_isRestriction :
    finiteSelectiveTwoLiftedNonidentityRestriction.{u}.IsRestriction :=
  finiteModelLiftContextMorphism_isRestriction.{u}
    finiteSelectiveTwoNonidentityRestriction_isRestriction.{u}

/-- The lifted restriction fires on the lifted negative support. -/
@[simp]
theorem finiteSelectiveTwoLiftedNonidentityRestriction_supportMap_false :
    finiteSelectiveTwoLiftedNonidentityRestriction.{u}.supportMap
        (ULift.up finiteSelectiveTwoContextFalseSupport.{u}) =
      ULift.up finiteSelectiveTwoContextTrueSupport.{u} :=
  rfl

