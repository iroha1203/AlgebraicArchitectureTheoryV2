import ResearchLean.AG.DoctrineFiberProduct.BCDiagnosticSourceFiberBridge
import ResearchLean.AG.DoctrineFiberProduct.BCDiagnosticAxisFoldComparisonWitnesses

/-!
# Finite witness for the source-fiber incidence bridge

The existing ordinary double-diamond `BCDiagnosticInterpretation` is placed in
the southwest fiber of its decoded BC presentation.  Its source comparators
remain genuinely distinct, while the actual direct and via-base target data
and their mate comparison are generated by the bridge.
-/

namespace AAT.AG.DoctrineFiberProduct

open CategoryTheory
open AtomFoundation CrossStageCoherence TransportCoherence

local instance finiteAxisFoldBridgeAtomDecidableEq :
    DecidableEq FiniteModel.carrier.Atom := by
  change DecidableEq FiniteModel.FiniteAtom
  infer_instance

/-- The previously reviewed ordinary G-106 interpretation, stated directly
over the decoded finite BC presentation. -/
noncomputable def finiteAxisFoldPresentationInterpretation :
    BCDiagnosticInterpretation FiniteModel.carrier
      (toSemanticBC finiteAxisFoldBCPresentation) := by
  simpa [finiteAxisFoldSquare, realizableSquareOf] using
    finiteAxisFoldInterpretation

/-- The finite ordinary interpretation lies in the actual southwest source
fiber; its existing identity edges lie over the source identity. -/
noncomputable def finiteAxisFoldSourceFiberIncidence :
    BCDiagnosticSourceFiberIncidence finiteAxisFoldBCPresentation
      finiteAxisFoldPresentationInterpretation where
  vertexBase := by
    intro vertex
    rfl
  edgeVertical := by
    intro i j edge
    exact CategoryTheory.IsHomLift.id rfl

/-- The bridge preserves the already selected source packages. -/
theorem finiteAxisFoldSourceFiberBridge_package
    (vertex : (toSemanticBC
      finiteAxisFoldBCPresentation).diagnostic.Vertex) :
    finiteAxisFoldSourceFiberIncidence.toFiberwise.toTransportData.lift.package
        vertex =
      finiteAxisFoldPresentationInterpretation.data.lift.package vertex :=
  finiteAxisFoldSourceFiberIncidence.toFiberwise_package vertex

/-- The bridge preserves the already selected source edge lifts. -/
theorem finiteAxisFoldSourceFiberBridge_edgeLift
    {i j : (toSemanticBC
      finiteAxisFoldBCPresentation).diagnostic.Vertex}
    (edge : (toSemanticBC
      finiteAxisFoldBCPresentation).diagnostic.Edge i j) :
    finiteAxisFoldSourceFiberIncidence.toFiberwise.toTransportData.lift.edgeLift
        edge =
      finiteAxisFoldPresentationInterpretation.data.lift.edgeLift edge :=
  finiteAxisFoldSourceFiberIncidence.toFiberwise_edgeLift edge

/-- The two authored source comparators remain genuinely distinct after the
ordinary-data-to-fiberwise bridge. -/
theorem finiteAxisFoldSourceFiberBridge_comparators_ne :
    finiteAxisFoldSourceFiberIncidence.toFiberwise.toTransportData.comparator
        DoubleDiamondTwoCell.first ≠
      finiteAxisFoldSourceFiberIncidence.toFiberwise.toTransportData.comparator
        DoubleDiamondTwoCell.second := by
  simpa [finiteAxisFoldPresentationInterpretation, finiteAxisFoldSquare,
    realizableSquareOf] using finiteAxisFold_comparators_ne

/-- Target data generated from the ordinary interpretation along the actual
direct BC route. -/
noncomputable def finiteAxisFoldBridgeDirectTransportedData :=
  bcDiagnosticDirectTransportedInterpretationData
    finiteAxisFoldBCPresentation finiteAxisFoldPresentationInterpretation
    finiteAxisFoldSourceFiberIncidence

/-- Target data generated from the same ordinary interpretation along the
actual via-base BC route. -/
noncomputable def finiteAxisFoldBridgeViaBaseTransportedData :=
  bcDiagnosticViaBaseTransportedInterpretationData
    finiteAxisFoldBCPresentation finiteAxisFoldPresentationInterpretation
    finiteAxisFoldSourceFiberIncidence

/-- The generated mate comparison identifies the two actual target comparator
tables pointwise on the finite ordinary G-106 interpretation. -/
theorem finiteAxisFoldBridgeTransportedComparator_naturality
    (cell : (toSemanticBC
      finiteAxisFoldBCPresentation).diagnostic.TwoCell) :
    bcDiagnosticEndpointComparison finiteAxisFoldBCPresentation
        (finiteAxisFoldSourceFiberIncidence.toFiberwise.package
          ((toSemanticBC finiteAxisFoldBCPresentation).diagnostic.twoTarget
            cell))
        (finiteAxisFoldBridgeDirectTransportedData.comparator cell) =
      finiteAxisFoldBridgeViaBaseTransportedData.comparator cell := by
  exact bcDiagnosticTransportedInterpretationComparator_naturality
    finiteAxisFoldBCPresentation finiteAxisFoldPresentationInterpretation
    finiteAxisFoldSourceFiberIncidence cell

end AAT.AG.DoctrineFiberProduct

#assert_standard_axioms_only AAT.AG.DoctrineFiberProduct
