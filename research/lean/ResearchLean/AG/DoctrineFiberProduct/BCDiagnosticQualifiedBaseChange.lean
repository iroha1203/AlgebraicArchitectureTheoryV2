import ResearchLean.AG.DoctrineFiberProduct.BCDiagnosticSourceFiberBridge

/-!
# Qualified diagnostic base change through the actual Beck--Chevalley routes

This module assembles the unconditional `(d1)`--`(d3)` package on the fixed
source-fiber-incidence input domain.  The source ordinary interpretation is
converted to the southwest core fiber, endpoint automorphisms are mapped by
the direct and via-base core-fiber functors, and both transported diagnostic
data sets are generated by those actual square-dependent routes.

No `H_bc`, raw-defect preservation, reselection equivariance, orbit map, or
vanishing conclusion is accepted or produced here.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open CategoryTheory
open AtomFoundation CrossStageCoherence TransportCoherence

/-- The generated `(d1)`--`(d3)` diagnostic base-change package on an ordinary
interpretation equipped with southwest source-fiber incidence.

All target data and endpoint actions are outputs.  The input incidence records
only source vertex bases and source-edge verticality. -/
structure QualifiedDiagnosticBaseChangeD1D3
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U)
    (interpretation : BCDiagnosticInterpretation U
      (toSemanticBC presentation))
    (incidence : BCDiagnosticSourceFiberIncidence presentation
      interpretation) where
  /-- `(d1)`: the ordinary interpretation expressed in the actual southwest
  core fiber, without replacing its packages, edges, or comparators. -/
  sourcePackage_eq : ∀ vertex,
    incidence.toFiberwise.toTransportData.lift.package vertex =
      interpretation.data.lift.package vertex
  sourceEdgeLift_eq : ∀ {i j} (edge :
      (toSemanticBC presentation).diagnostic.Edge i j),
    incidence.toFiberwise.toTransportData.lift.edgeLift edge =
      interpretation.data.lift.edgeLift edge
  sourceComparator_eq : ∀ cell,
    incidence.toFiberwise.toTransportData.comparator cell =
      interpretation.data.comparator cell
  /-- `(d2)`: endpoint group actions generated by the two actual BC routes. -/
  directEndpointAction_one : ∀ vertex,
    coreFiberFunctorPackageAutHom (bcDiagnosticDirectFunctor presentation)
        (incidence.toFiberwise.package vertex) 1 = 1
  viaBaseEndpointAction_one : ∀ vertex,
    coreFiberFunctorPackageAutHom (bcDiagnosticViaBaseFunctor presentation)
        (incidence.toFiberwise.package vertex) 1 = 1
  /-- `(d3)`: the direct target comparator obeys the fixed generation law. -/
  directComparatorGenerated : ∀ cell,
    (bcDiagnosticDirectTransportedInterpretationData presentation
      interpretation incidence).comparator cell =
      coreFiberFunctorPackageAutHom (bcDiagnosticDirectFunctor presentation)
        (incidence.toFiberwise.package
          ((toSemanticBC presentation).diagnostic.twoTarget cell))
        (interpretation.data.comparator cell)
  /-- `(d3)`: the via-base target comparator obeys the fixed generation law. -/
  viaBaseComparatorGenerated : ∀ cell,
    (bcDiagnosticViaBaseTransportedInterpretationData presentation
      interpretation incidence).comparator cell =
      coreFiberFunctorPackageAutHom (bcDiagnosticViaBaseFunctor presentation)
        (incidence.toFiberwise.package
          ((toSemanticBC presentation).diagnostic.twoTarget cell))
        (interpretation.data.comparator cell)
  directEdgeStrong : ∀ {i j} (edge :
      (toSemanticBC presentation).diagnostic.Edge i j),
    (packageProjection U).IsStronglyCocartesian
      ((bcDiagnosticDirectTransportedInterpretationData presentation
        interpretation incidence).lift.edgeLift edge).base
      ((bcDiagnosticDirectTransportedInterpretationData presentation
        interpretation incidence).lift.edgeLift edge)
  viaBaseEdgeStrong : ∀ {i j} (edge :
      (toSemanticBC presentation).diagnostic.Edge i j),
    (packageProjection U).IsStronglyCocartesian
      ((bcDiagnosticViaBaseTransportedInterpretationData presentation
        interpretation incidence).lift.edgeLift edge).base
      ((bcDiagnosticViaBaseTransportedInterpretationData presentation
        interpretation incidence).lift.edgeLift edge)
  directTwoCellBase : ∀ cell,
    ((bcDiagnosticDirectTransportedInterpretationData presentation
      interpretation incidence).lift.pathLift
        ((toSemanticBC presentation).diagnostic.twoLeft cell)).base =
      ((bcDiagnosticDirectTransportedInterpretationData presentation
        interpretation incidence).lift.pathLift
        ((toSemanticBC presentation).diagnostic.twoRight cell)).base
  viaBaseTwoCellBase : ∀ cell,
    ((bcDiagnosticViaBaseTransportedInterpretationData presentation
      interpretation incidence).lift.pathLift
        ((toSemanticBC presentation).diagnostic.twoLeft cell)).base =
      ((bcDiagnosticViaBaseTransportedInterpretationData presentation
        interpretation incidence).lift.pathLift
        ((toSemanticBC presentation).diagnostic.twoRight cell)).base
  /-- The exact canonical mate compares the two generated comparator tables. -/
  comparatorNaturality : ∀ cell,
    bcDiagnosticEndpointComparison presentation
        (incidence.toFiberwise.package
          ((toSemanticBC presentation).diagnostic.twoTarget cell))
        ((bcDiagnosticDirectTransportedInterpretationData presentation
          interpretation incidence).comparator cell) =
      (bcDiagnosticViaBaseTransportedInterpretationData presentation
        interpretation incidence).comparator cell

/-- Construct the complete unconditional `(d1)`--`(d3)` package from the fixed
qualified input.  In particular, no target diagnostic field is supplied. -/
noncomputable def qualifiedDiagnosticBaseChangeD1D3
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U)
    (interpretation : BCDiagnosticInterpretation U
      (toSemanticBC presentation))
    (incidence : BCDiagnosticSourceFiberIncidence presentation
      interpretation) :
    QualifiedDiagnosticBaseChangeD1D3 presentation interpretation incidence :=
  { sourcePackage_eq := incidence.toFiberwise_package
    sourceEdgeLift_eq := incidence.toFiberwise_edgeLift
    sourceComparator_eq := incidence.toFiberwise_comparator
    directEndpointAction_one := fun vertex =>
      coreFiberFunctorPackageAutHom_one (bcDiagnosticDirectFunctor presentation)
        (incidence.toFiberwise.package vertex)
    viaBaseEndpointAction_one := fun vertex =>
      coreFiberFunctorPackageAutHom_one (bcDiagnosticViaBaseFunctor presentation)
        (incidence.toFiberwise.package vertex)
    directComparatorGenerated :=
      bcDiagnosticDirectTransportedInterpretationData_comparator presentation
        interpretation incidence
    viaBaseComparatorGenerated :=
      bcDiagnosticViaBaseTransportedInterpretationData_comparator presentation
        interpretation incidence
    directEdgeStrong :=
      bcDiagnosticDirectTransportedInterpretationData_edgeStrong presentation
        interpretation incidence
    viaBaseEdgeStrong :=
      bcDiagnosticViaBaseTransportedInterpretationData_edgeStrong presentation
        interpretation incidence
    directTwoCellBase :=
      bcDiagnosticDirectTransportedInterpretationData_twoCellBase presentation
        interpretation incidence
    viaBaseTwoCellBase :=
      bcDiagnosticViaBaseTransportedInterpretationData_twoCellBase presentation
        interpretation incidence
    comparatorNaturality :=
      bcDiagnosticTransportedInterpretationComparator_naturality presentation
        interpretation incidence }

end AAT.AG.DoctrineFiberProduct

#assert_standard_axioms_only AAT.AG.DoctrineFiberProduct
