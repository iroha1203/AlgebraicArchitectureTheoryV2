import ResearchLean.AG.DoctrineFiberProduct.BCDiagnosticVanishingPreservation

/-!
# Actual-route diagnostic covariance

This module specializes the reviewed functorial reselection map and coherence
theorem to the two core-fiber functors generated by a validated Beck--Chevalley
presentation.  The source reselection is the one on the source-fiber
interpretation constructed from ordinary diagnostic data and southwest
incidence.  Both target reselections and both target coherence proofs are
outputs; no target diagnostic certificate is accepted from a caller.

Implementation notes: the generic `mapEdgeReselection` is retained as the
single construction because its endpoint action is exactly the core-fiber
functor action.  Named specializations are added here so the fixed G-110(D)
route audit cannot silently substitute a square-independent functor.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open AtomFoundation CrossStageCoherence TransportCoherence

/-- `(d4)`, direct route: map a source-fiber reselection through the actual
direct Beck--Chevalley core-fiber functor. -/
noncomputable def bcDiagnosticDirectMapEdgeReselection
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U)
    (interpretation : BCDiagnosticInterpretation U
      (toSemanticBC presentation))
    (incidence : BCDiagnosticSourceFiberIncidence presentation interpretation)
    (reselection : EdgeReselection incidence.toFiberwise.toLiftData) :
    EdgeReselection
      (bcDiagnosticDirectTransportedInterpretationData presentation
        interpretation incidence).lift :=
  mapEdgeReselection incidence.toFiberwise
    (bcDiagnosticDirectFunctor presentation) reselection

/-- `(d4)`, via-base route: map the same source-fiber reselection through the
actual via-base Beck--Chevalley core-fiber functor. -/
noncomputable def bcDiagnosticViaBaseMapEdgeReselection
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U)
    (interpretation : BCDiagnosticInterpretation U
      (toSemanticBC presentation))
    (incidence : BCDiagnosticSourceFiberIncidence presentation interpretation)
    (reselection : EdgeReselection incidence.toFiberwise.toLiftData) :
    EdgeReselection
      (bcDiagnosticViaBaseTransportedInterpretationData presentation
        interpretation incidence).lift :=
  mapEdgeReselection incidence.toFiberwise
    (bcDiagnosticViaBaseFunctor presentation) reselection

/-- `(d4)` edge law on the direct actual route. -/
theorem bcDiagnosticDirectReselectedEdge_map
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U)
    (interpretation : BCDiagnosticInterpretation U
      (toSemanticBC presentation))
    (incidence : BCDiagnosticSourceFiberIncidence presentation interpretation)
    (reselection : EdgeReselection incidence.toFiberwise.toLiftData)
    {i j : (toSemanticBC presentation).diagnostic.Vertex}
    (edge : (toSemanticBC presentation).diagnostic.Edge i j) :
    fiberReselectedEdge
        (incidence.toFiberwise.map (bcDiagnosticDirectFunctor presentation))
        (bcDiagnosticDirectMapEdgeReselection presentation interpretation
          incidence reselection) edge =
      (bcDiagnosticDirectFunctor presentation).map
        (fiberReselectedEdge incidence.toFiberwise reselection edge) :=
  fiberReselectedEdge_map incidence.toFiberwise
    (bcDiagnosticDirectFunctor presentation) reselection edge

/-- `(d4)` edge law on the via-base actual route. -/
theorem bcDiagnosticViaBaseReselectedEdge_map
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U)
    (interpretation : BCDiagnosticInterpretation U
      (toSemanticBC presentation))
    (incidence : BCDiagnosticSourceFiberIncidence presentation interpretation)
    (reselection : EdgeReselection incidence.toFiberwise.toLiftData)
    {i j : (toSemanticBC presentation).diagnostic.Vertex}
    (edge : (toSemanticBC presentation).diagnostic.Edge i j) :
    fiberReselectedEdge
        (incidence.toFiberwise.map (bcDiagnosticViaBaseFunctor presentation))
        (bcDiagnosticViaBaseMapEdgeReselection presentation interpretation
          incidence reselection) edge =
      (bcDiagnosticViaBaseFunctor presentation).map
        (fiberReselectedEdge incidence.toFiberwise reselection edge) :=
  fiberReselectedEdge_map incidence.toFiberwise
    (bcDiagnosticViaBaseFunctor presentation) reselection edge

/-- `(d4)` path law on the direct actual route. -/
theorem bcDiagnosticDirectReselectedPath_map
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U)
    (interpretation : BCDiagnosticInterpretation U
      (toSemanticBC presentation))
    (incidence : BCDiagnosticSourceFiberIncidence presentation interpretation)
    (reselection : EdgeReselection incidence.toFiberwise.toLiftData)
    {i j : (toSemanticBC presentation).diagnostic.Vertex}
    (path : (toSemanticBC presentation).diagnostic.Path i j) :
    fiberReselectedPath
        (incidence.toFiberwise.map (bcDiagnosticDirectFunctor presentation))
        (bcDiagnosticDirectMapEdgeReselection presentation interpretation
          incidence reselection) path =
      (bcDiagnosticDirectFunctor presentation).map
        (fiberReselectedPath incidence.toFiberwise reselection path) :=
  fiberReselectedPath_map incidence.toFiberwise
    (bcDiagnosticDirectFunctor presentation) reselection path

/-- `(d4)` path law on the via-base actual route. -/
theorem bcDiagnosticViaBaseReselectedPath_map
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U)
    (interpretation : BCDiagnosticInterpretation U
      (toSemanticBC presentation))
    (incidence : BCDiagnosticSourceFiberIncidence presentation interpretation)
    (reselection : EdgeReselection incidence.toFiberwise.toLiftData)
    {i j : (toSemanticBC presentation).diagnostic.Vertex}
    (path : (toSemanticBC presentation).diagnostic.Path i j) :
    fiberReselectedPath
        (incidence.toFiberwise.map (bcDiagnosticViaBaseFunctor presentation))
        (bcDiagnosticViaBaseMapEdgeReselection presentation interpretation
          incidence reselection) path =
      (bcDiagnosticViaBaseFunctor presentation).map
        (fiberReselectedPath incidence.toFiberwise reselection path) :=
  fiberReselectedPath_map incidence.toFiberwise
    (bcDiagnosticViaBaseFunctor presentation) reselection path

/-- `(d5)`, direct route: source coherence is sent to coherence of the
canonically mapped direct-route reselection. -/
theorem bcDiagnosticDirectCoherentAt_map
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U)
    (interpretation : BCDiagnosticInterpretation U
      (toSemanticBC presentation))
    (incidence : BCDiagnosticSourceFiberIncidence presentation interpretation)
    (reselection : EdgeReselection incidence.toFiberwise.toLiftData)
    (coherent : CoherentAt incidence.toFiberwise.toTransportData reselection) :
    CoherentAt
      (bcDiagnosticDirectTransportedInterpretationData presentation
        interpretation incidence)
      (bcDiagnosticDirectMapEdgeReselection presentation interpretation
        incidence reselection) :=
  coherentAt_map incidence.toFiberwise
    (bcDiagnosticDirectFunctor presentation) reselection coherent

/-- `(d5)`, via-base route: source coherence is sent to coherence of the
canonically mapped via-base reselection. -/
theorem bcDiagnosticViaBaseCoherentAt_map
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (presentation : BCPresentation U)
    (interpretation : BCDiagnosticInterpretation U
      (toSemanticBC presentation))
    (incidence : BCDiagnosticSourceFiberIncidence presentation interpretation)
    (reselection : EdgeReselection incidence.toFiberwise.toLiftData)
    (coherent : CoherentAt incidence.toFiberwise.toTransportData reselection) :
    CoherentAt
      (bcDiagnosticViaBaseTransportedInterpretationData presentation
        interpretation incidence)
      (bcDiagnosticViaBaseMapEdgeReselection presentation interpretation
        incidence reselection) :=
  coherentAt_map incidence.toFiberwise
    (bcDiagnosticViaBaseFunctor presentation) reselection coherent

end AAT.AG.DoctrineFiberProduct

#assert_standard_axioms_only AAT.AG.DoctrineFiberProduct
