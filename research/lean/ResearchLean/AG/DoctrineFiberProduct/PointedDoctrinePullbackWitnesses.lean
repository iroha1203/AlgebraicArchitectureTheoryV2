import ResearchLean.AG.DoctrineFiberProduct.DoctrinePullbackWitnesses
import ResearchLean.AG.DoctrineFiberProduct.PointedDoctrinePullback

/-!
# Nondegenerate witnesses for pointed doctrine pullbacks

This module fires the generic pointed pullback on the symmetric three-by-three
over two cospan from the K0 witness.  The selected pullback point is the named
compatible pair `(0, 0)`, the source remains inhabited, and both pointed
projections remain nonisomorphisms.  A second cone uses the existing finite
Atom swap and verifies that the pointed universal factor retains its actual
nonidentity Atom action.

All pullback objects, factors, and pullback certificates are generated by the
generic producer.  Finite decoding occurs only in this witness module.
-/

namespace AAT.AG.DoctrineFiberProduct

open CategoryTheory CategoryTheory.Limits
open AtomFoundation

/-- Executable Atom equality for the finite pointed witness. -/
local instance pointedDoctrinePullbackWitnessAtomDecidableEq :
    DecidableEq FiniteModel.carrier.Atom := by
  change DecidableEq FiniteModel.FiniteAtom
  infer_instance

/-- The decoded pointed leg of the symmetric three-to-two cospan. -/
def finiteProperPointedLeg :
    finiteThreeSourceInstance.toSemantic ⟶ finiteTwoSourceInstance.toSemantic :=
  typedPresentationToSemantic finiteThreeToTwoPresentation

/-- The pointed finite leg exposes the reviewed Cycle 29 doctrine leg. -/
@[simp]
theorem finiteProperPointedLeg_doctrineHom :
    finiteProperPointedLeg.doctrineHom = finiteThreeToTwoDoctrineHom :=
  rfl

/-- The generated selected pullback source is the named compatible pair `(0, 0)`. -/
theorem finiteProperPointedPullback_source_eq_compatible00 :
    (pointedPullback finiteProperPointedLeg finiteProperPointedLeg).source =
      finiteProperFiberCompatible00 := by
  apply Subtype.ext
  rfl

/-- The generated selected point carries the required common-base compatibility. -/
theorem finiteProperPointedPullback_source_compatible :
    finiteThreeToTwoDoctrineHom.sourceMap
        (pointedPullback finiteProperPointedLeg finiteProperPointedLeg).source.val.1 =
      finiteThreeToTwoDoctrineHom.sourceMap
        (pointedPullback finiteProperPointedLeg finiteProperPointedLeg).source.val.2 := by
  exact (pointedPullback finiteProperPointedLeg
    finiteProperPointedLeg).source.property

/-- The proper pointed pullback source is inhabited by its generated point. -/
theorem finiteProperPointedPullback_source_nonempty :
    Nonempty
      (pointedPullback finiteProperPointedLeg
        finiteProperPointedLeg).doctrine.Source :=
  ⟨(pointedPullback finiteProperPointedLeg finiteProperPointedLeg).source⟩

/-- The first pointed projection remains noninvertible. -/
theorem finiteProperPointedPullback_fst_not_isIso :
    ¬ IsIso
      (pointedPullbackFst finiteProperPointedLeg finiteProperPointedLeg) := by
  intro hIso
  letI : IsIso
      (pointedPullbackFst finiteProperPointedLeg finiteProperPointedLeg) := hIso
  have hinjective := extInstHom_sourceMap_injective_of_isIso
    (pointedPullbackFst finiteProperPointedLeg finiteProperPointedLeg)
  exact finiteProperFiberCompatible00_ne_01
    (hinjective (by
      simpa only [pointedPullbackFst_doctrineHom,
        finiteProperPointedLeg_doctrineHom] using
        finiteProperDoctrinePullback_fst_collision))

/-- The second pointed projection remains noninvertible. -/
theorem finiteProperPointedPullback_snd_not_isIso :
    ¬ IsIso
      (pointedPullbackSnd finiteProperPointedLeg finiteProperPointedLeg) := by
  intro hIso
  letI : IsIso
      (pointedPullbackSnd finiteProperPointedLeg finiteProperPointedLeg) := hIso
  have hinjective := extInstHom_sourceMap_injective_of_isIso
    (pointedPullbackSnd finiteProperPointedLeg finiteProperPointedLeg)
  exact finiteProperFiberCompatible00_ne_10
    (hinjective (by
      simpa only [pointedPullbackSnd_doctrineHom,
        finiteProperPointedLeg_doctrineHom] using
        finiteProperDoctrinePullback_snd_collision))

/-- The generated pointed projections form the concrete pullback in `ExtInst_U`. -/
theorem finiteProperPointedPullback_isPullback :
    IsPullback
      (pointedPullbackFst finiteProperPointedLeg finiteProperPointedLeg)
      (pointedPullbackSnd finiteProperPointedLeg finiteProperPointedLeg)
      finiteProperPointedLeg finiteProperPointedLeg :=
  pointedPullback_isPullback finiteProperPointedLeg finiteProperPointedLeg

/-- The decoded pointed automorphism carrying the existing finite Atom swap. -/
noncomputable def finiteProperPointedSwapLeg :
    finiteThreeSourceInstance.toSemantic ⟶
      finiteThreeSourceInstance.toSemantic :=
  typedPresentationToSemantic finiteThreeSwapPresentation

/-- Pointed cone whose two legs use the actual nonidentity finite Atom swap. -/
noncomputable def finiteProperPointedSwapCone :
    PullbackCone finiteProperPointedLeg finiteProperPointedLeg :=
  PullbackCone.mk finiteProperPointedSwapLeg finiteProperPointedSwapLeg rfl

/-- The first pointed cone leg moves `componentC` to `dependsAB`. -/
theorem finiteProperPointedSwapCone_fst_componentC :
    finiteProperPointedSwapCone.fst.doctrineHom.atomEquiv
        FiniteModel.FiniteAtom.componentC =
      FiniteModel.FiniteAtom.dependsAB := by
  change finiteSwapPermutationCode.toEquiv
      FiniteModel.FiniteAtom.componentC =
    FiniteModel.FiniteAtom.dependsAB
  exact finiteSwapPermutationCode_componentC

/-- The generated pointed factor preserves the nonidentity Atom graph. -/
theorem finiteProperPointedSwapLift_componentC :
    (pointedPullbackLift finiteProperPointedLeg finiteProperPointedLeg
        finiteProperPointedSwapCone).doctrineHom.atomEquiv
          FiniteModel.FiniteAtom.componentC =
      FiniteModel.FiniteAtom.dependsAB := by
  rw [pointedPullbackLift_atomEquiv]
  exact finiteProperPointedSwapCone_fst_componentC

end AAT.AG.DoctrineFiberProduct

#assert_standard_axioms_only AAT.AG.DoctrineFiberProduct
