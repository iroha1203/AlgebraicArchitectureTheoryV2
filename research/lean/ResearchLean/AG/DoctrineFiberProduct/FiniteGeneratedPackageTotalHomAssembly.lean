import ResearchLean.AG.DoctrineFiberProduct.FiniteGeneratedUpperAssembly

/-!
# Complete generated total-hom assembly

This module joins the reflected actual-high base from Cycle 18 to the complete
generated low upper from Cycle 24.  Their Atom compatibility is derived
directly from the actual normalized high factor's own compatibility field.

The resulting `PackageTotalHom` is the package-level factor checkpoint needed
before its ambient universal property can be reflected.  Its projection and
high-image API expose the actual data used by the construction.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open CategoryTheory
open AtomFoundation

/-! ## Output and compatibility -/

/--
The exact package-total hom between the outer and inner generated low domains.
Its lower and upper fields are generated by the accepted actual-high reflection
constructions rather than accepted as caller data.
-/
abbrev FiniteGeneratedReflectedPackageTotalHomOutput
    (input : FiniteGeneratedLiftInput)
    {package : AATCorePackage FiniteModel.carrier}
    (base : packagePoint package ⟶ input.source) :=
  PackageTotalHom
    (finiteGeneratedOuterInput input base).lowGeneratedLift.domain
    input.lowGeneratedLift.domain

/--
The reflected lower and upper fields use the same Atom equivalence.  The proof
reads `atomEquiv_eq` from the actual normalized high factor before reflecting
both high Atom values; it does not compare with the canonical generated factor.
-/
theorem finiteGeneratedReflectedPackageTotalHom_atomEquiv_eq
    (input : FiniteGeneratedLiftInput)
    (lift : StrongCartesianLift
      (FiniteGeneratedLiftInput.highInput.{u} input)
      (FiniteGeneratedLiftInput.highTarget.{u} input))
    {package : AATCorePackage FiniteModel.carrier}
    (base : packagePoint package ⟶ input.source) :
    (finiteGeneratedReflectedSignedExactCoreReadingHom input lift base).atomEquiv =
      (finiteGeneratedReflectedBase input lift base).doctrineHom.atomEquiv := by
  apply Equiv.ext
  intro atom
  change finiteModelLiftCarrierEquiv.{u}.atom.symm
      ((finiteGeneratedNormalizedHighFactor input lift base).upper.atomEquiv
        (finiteModelLiftCarrierEquiv.{u}.atom atom)) =
    finiteModelLiftCarrierEquiv.{u}.atom.symm
      ((finiteGeneratedNormalizedHighFactor input lift base).base.doctrineHom.atomEquiv
        (finiteModelLiftCarrierEquiv.{u}.atom atom))
  rw [(finiteGeneratedNormalizedHighFactor input lift base).atomEquiv_eq]

/-! ## Total-hom producer -/

/--
Assemble the reflected generated package-total hom from its actual-high-derived
lower field, complete low upper field, and their direct Atom compatibility.
-/
noncomputable def finiteGeneratedReflectedPackageTotalHom
    (input : FiniteGeneratedLiftInput)
    (lift : StrongCartesianLift
      (FiniteGeneratedLiftInput.highInput.{u} input)
      (FiniteGeneratedLiftInput.highTarget.{u} input))
    {package : AATCorePackage FiniteModel.carrier}
    (base : packagePoint package ⟶ input.source) :
    FiniteGeneratedReflectedPackageTotalHomOutput input base where
  base := finiteGeneratedReflectedBase input lift base
  upper := finiteGeneratedReflectedSignedExactCoreReadingHom input lift base
  atomEquiv_eq :=
    finiteGeneratedReflectedPackageTotalHom_atomEquiv_eq input lift base

/-! ## Package and projection API -/

/-- The total hom's lower field is the reflected actual normalized high base. -/
@[simp]
theorem finiteGeneratedReflectedPackageTotalHom_base
    (input : FiniteGeneratedLiftInput)
    (lift : StrongCartesianLift
      (FiniteGeneratedLiftInput.highInput.{u} input)
      (FiniteGeneratedLiftInput.highTarget.{u} input))
    {package : AATCorePackage FiniteModel.carrier}
    (base : packagePoint package ⟶ input.source) :
    (finiteGeneratedReflectedPackageTotalHom input lift base).base =
      finiteGeneratedReflectedBase input lift base :=
  rfl

/-- The total hom's upper field is the complete reflected generated upper. -/
@[simp]
theorem finiteGeneratedReflectedPackageTotalHom_upper
    (input : FiniteGeneratedLiftInput)
    (lift : StrongCartesianLift
      (FiniteGeneratedLiftInput.highInput.{u} input)
      (FiniteGeneratedLiftInput.highTarget.{u} input))
    {package : AATCorePackage FiniteModel.carrier}
    (base : packagePoint package ⟶ input.source) :
    (finiteGeneratedReflectedPackageTotalHom input lift base).upper =
      finiteGeneratedReflectedSignedExactCoreReadingHom input lift base :=
  rfl

/-- Package projection returns the actual reflected lower field. -/
@[simp]
theorem finiteGeneratedReflectedPackageTotalHom_projection
    (input : FiniteGeneratedLiftInput)
    (lift : StrongCartesianLift
      (FiniteGeneratedLiftInput.highInput.{u} input)
      (FiniteGeneratedLiftInput.highTarget.{u} input))
    {package : AATCorePackage FiniteModel.carrier}
    (base : packagePoint package ⟶ input.source) :
    (packageProjection FiniteModel.carrier).map
        (finiteGeneratedReflectedPackageTotalHom input lift base) =
      finiteGeneratedReflectedBase input lift base :=
  rfl

/--
The reflected total hom lies over the supplied low prefix.  The proof first
uses the actual normalized factor's `IsHomLift` instance to identify its high
base, then uses the lift/reflection roundtrip; no canonical-factor equality is
used.
-/
theorem finiteGeneratedReflectedPackageTotalHom_base_eq
    (input : FiniteGeneratedLiftInput)
    (lift : StrongCartesianLift
      (FiniteGeneratedLiftInput.highInput.{u} input)
      (FiniteGeneratedLiftInput.highTarget.{u} input))
    {package : AATCorePackage FiniteModel.carrier}
    (base : packagePoint package ⟶ input.source) :
    (finiteGeneratedReflectedPackageTotalHom input lift base).base = base := by
  change finiteGeneratedReflectedBase input lift base = base
  letI : (packageProjection finiteModelLiftCarrier.{u}).IsHomLift
      (finiteModelLiftExtInstHom.{u} base)
      (finiteGeneratedNormalizedHighFactor input lift base) :=
    finiteGeneratedNormalizedHighFactor_isHomLift input lift base
  let outer := finiteGeneratedOuterInput input base
  have hactual :
      (finiteGeneratedNormalizedHighFactor input lift base).base =
        finiteModelLiftExtInstHom.{u} base := by
    have hfac := CategoryTheory.IsHomLift.fac'
      (packageProjection finiteModelLiftCarrier.{u})
      (finiteModelLiftExtInstHom.{u} base)
      (finiteGeneratedNormalizedHighFactor input lift base)
    have hdomain :
        CategoryTheory.IsHomLift.domain_eq
            (packageProjection finiteModelLiftCarrier.{u})
            (finiteModelLiftExtInstHom.{u} base)
            (finiteGeneratedNormalizedHighFactor input lift base) =
          outer.highGeneratedLift_domain_point :=
      Subsingleton.elim _ _
    have hcodomain :
        CategoryTheory.IsHomLift.codomain_eq
            (packageProjection finiteModelLiftCarrier.{u})
            (finiteModelLiftExtInstHom.{u} base)
            (finiteGeneratedNormalizedHighFactor input lift base) =
          input.highGeneratedLift_domain_point :=
      Subsingleton.elim _ _
    rw [hdomain, hcodomain] at hfac
    simpa only [outer.highGeneratedLift_domain_point,
      input.highGeneratedLift_domain_point, eqToHom_refl,
      Category.id_comp, Category.comp_id] using hfac
  have hlift :
      finiteModelLiftExtInstHom.{u}
          (finiteGeneratedReflectedBase input lift base) =
        finiteModelLiftExtInstHom.{u} base :=
    (finiteGeneratedReflectedBase_high_graph input lift base).trans hactual
  have hreflect := congrArg
    (fun hom => finiteModelReflectExtInstHom hom) hlift
  simpa using hreflect

/-- Package projection of the reflected total hom is the supplied low prefix. -/
theorem finiteGeneratedReflectedPackageTotalHom_projection_eq
    (input : FiniteGeneratedLiftInput)
    (lift : StrongCartesianLift
      (FiniteGeneratedLiftInput.highInput.{u} input)
      (FiniteGeneratedLiftInput.highTarget.{u} input))
    {package : AATCorePackage FiniteModel.carrier}
    (base : packagePoint package ⟶ input.source) :
    (packageProjection FiniteModel.carrier).map
        (finiteGeneratedReflectedPackageTotalHom input lift base) = base :=
  finiteGeneratedReflectedPackageTotalHom_base_eq input lift base

/-- The reflected package-total hom is a hom lift of the supplied low prefix. -/
theorem finiteGeneratedReflectedPackageTotalHom_isHomLift
    (input : FiniteGeneratedLiftInput)
    (lift : StrongCartesianLift
      (FiniteGeneratedLiftInput.highInput.{u} input)
      (FiniteGeneratedLiftInput.highTarget.{u} input))
    {package : AATCorePackage FiniteModel.carrier}
    (base : packagePoint package ⟶ input.source) :
    (packageProjection FiniteModel.carrier).IsHomLift base
      (finiteGeneratedReflectedPackageTotalHom input lift base) := by
  have hcanonical :
      (packageProjection FiniteModel.carrier).IsHomLift
        ((packageProjection FiniteModel.carrier).map
          (finiteGeneratedReflectedPackageTotalHom input lift base))
        (finiteGeneratedReflectedPackageTotalHom input lift base) := by
    infer_instance
  simpa only [finiteGeneratedReflectedPackageTotalHom_projection_eq] using
    hcanonical

/-! ## Actual-high image projections -/

/-- Lifting the total hom's lower field recovers the actual normalized high base. -/
theorem finiteGeneratedReflectedPackageTotalHom_base_high_image
    (input : FiniteGeneratedLiftInput)
    (lift : StrongCartesianLift
      (FiniteGeneratedLiftInput.highInput.{u} input)
      (FiniteGeneratedLiftInput.highTarget.{u} input))
    {package : AATCorePackage FiniteModel.carrier}
    (base : packagePoint package ⟶ input.source) :
    finiteModelLiftExtInstHom.{u}
        (finiteGeneratedReflectedPackageTotalHom input lift base).base =
      (finiteGeneratedNormalizedHighFactor input lift base).base :=
  finiteGeneratedReflectedBase_high_graph input lift base

/--
The total hom's upper Atom value reproduces the actual normalized high upper
Atom value after the canonical carrier lift.
-/
theorem finiteGeneratedReflectedPackageTotalHom_atom_high_image
    (input : FiniteGeneratedLiftInput)
    (lift : StrongCartesianLift
      (FiniteGeneratedLiftInput.highInput.{u} input)
      (FiniteGeneratedLiftInput.highTarget.{u} input))
    {package : AATCorePackage FiniteModel.carrier}
    (base : packagePoint package ⟶ input.source)
    (atom : FiniteModel.carrier.Atom) :
    finiteModelLiftCarrierEquiv.{u}.atom
        ((finiteGeneratedReflectedPackageTotalHom input lift base).upper.atomEquiv atom) =
      (finiteGeneratedNormalizedHighFactor input lift base).upper.atomEquiv
        (finiteModelLiftCarrierEquiv.{u}.atom atom) :=
  finiteGeneratedReflectedUpperAtomEquiv_high_graph input lift base atom

end AAT.AG.DoctrineFiberProduct

#assert_standard_axioms_only AAT.AG.DoctrineFiberProduct
