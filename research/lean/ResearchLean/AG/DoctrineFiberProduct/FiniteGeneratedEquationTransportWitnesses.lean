import ResearchLean.AG.DoctrineFiberProduct.FiniteGeneratedEquationTransportDescent
import ResearchLean.AG.DoctrineFiberProduct.FiniteGeneratedEquationEquivalenceWitnesses

/-!
# Concrete witnesses for complete generated equation transport

This module instantiates all seven fields of the reflected equation-system
exact transport on the existing selective-two generated-factor fixture.  The
same supplied high lift and genuinely noninvertible prefix drive the context,
index, observable, role, restriction-naturality, violation, and residual
observations.

The naturality observation uses the two distinct finite contexts and their
nonidentity restriction.  The generator observations use a concrete equation
index and Atom, and the residual field is fired separately on the cyclic and
acyclic finite-model objects.  All data are generated by existing constructors;
no field law or comparison certificate is accepted from a caller.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open CategoryTheory
open AtomFoundation

/-! ## The single actual transport under observation -/

/--
The complete reflected equation-system exact transport generated from the
selective-two supplied high lift and noninvertible prefix.
-/
noncomputable def finiteSelectiveTwoReflectedEquationSystemExactTransport :=
  finiteGeneratedReflectedEquationSystemExactTransport.{u}
    finiteSelectiveTwoObjectContextWitnessInput
    finiteSelectiveTwoObjectContextWitnessLift.{u}
    finiteSelectiveTwoObjectContextWitnessBase

/-- The concrete transport uses the existing genuinely noninvertible prefix. -/
theorem finiteSelectiveTwoEquationTransport_base_not_isIso :
    ¬ IsIso finiteSelectiveTwoObjectContextWitnessBase :=
  finiteSelectiveTwoObjectContextWitnessBase_not_isIso

/-! ## The three data projections -/

/--
The concrete transport's context field is the reflected actual context
equivalence used by the two distinct witness contexts.
-/
theorem finiteSelectiveTwoEquationTransport_contextEquivalence :
    finiteSelectiveTwoReflectedEquationSystemExactTransport.{u}.contextEquivalence =
      finiteSelectiveTwoReflectedContextEquivalence.{u} := by
  exact
    finiteGeneratedReflectedEquationSystemExactTransport_contextEquivalence.{u}
      finiteSelectiveTwoObjectContextWitnessInput
      finiteSelectiveTwoObjectContextWitnessLift.{u}
      finiteSelectiveTwoObjectContextWitnessBase

/--
The concrete transport's equation-index field is the equivalence reflected
from the actual normalized high factor.
-/
theorem finiteSelectiveTwoEquationTransport_equationEquiv :
    finiteSelectiveTwoReflectedEquationSystemExactTransport.{u}.equationEquiv =
      finiteGeneratedReflectedEquationIndexEquiv.{u}
        finiteSelectiveTwoObjectContextWitnessInput
        finiteSelectiveTwoObjectContextWitnessLift.{u}
        finiteSelectiveTwoObjectContextWitnessBase := by
  exact
    finiteGeneratedReflectedEquationSystemExactTransport_equationEquiv.{u}
      finiteSelectiveTwoObjectContextWitnessInput
      finiteSelectiveTwoObjectContextWitnessLift.{u}
      finiteSelectiveTwoObjectContextWitnessBase

/--
At the first nontrivial context, the concrete transport's observable component
is the ring equivalence reflected from the actual high component.
-/
theorem finiteSelectiveTwoEquationTransport_observableEquiv :
    finiteSelectiveTwoReflectedEquationSystemExactTransport.{u}.observableEquiv
        finiteSelectiveTwoContextEquivalenceW =
      finiteGeneratedReflectedEquationObservableEquiv.{u}
        finiteSelectiveTwoObjectContextWitnessInput
        finiteSelectiveTwoObjectContextWitnessLift.{u}
        finiteSelectiveTwoObjectContextWitnessBase
        finiteSelectiveTwoContextEquivalenceW := by
  exact
    finiteGeneratedReflectedEquationSystemExactTransport_observableEquiv.{u}
      finiteSelectiveTwoObjectContextWitnessInput
      finiteSelectiveTwoObjectContextWitnessLift.{u}
      finiteSelectiveTwoObjectContextWitnessBase
      finiteSelectiveTwoContextEquivalenceW

/-! ## Role and restriction naturality -/

/--
The concrete generated index retains its role through the assembled transport.
This fires the assembled role field rather than a separately supplied low law.
-/
theorem finiteSelectiveTwoEquationTransport_role_eq :
    finiteSelectiveTwoObjectContextWitnessInput.lowGeneratedLift.domain.algebra.equationSystem.role
        (finiteSelectiveTwoReflectedEquationSystemExactTransport.{u}.equationMap
          finiteSelectiveTwoEquationSourceIndex) =
      finiteSelectiveTwoContextEquivalenceOuterInput.lowGeneratedLift.domain.algebra.equationSystem.role
        finiteSelectiveTwoEquationSourceIndex := by
  exact finiteGeneratedReflectedEquationSystemExactTransport_role_eq.{u}
    finiteSelectiveTwoObjectContextWitnessInput
    finiteSelectiveTwoObjectContextWitnessLift.{u}
    finiteSelectiveTwoObjectContextWitnessBase
    finiteSelectiveTwoEquationSourceIndex

/--
The integer `3`, reflected canonically into the second outer generated
observable ring for the nonidentity restriction test.
-/
noncomputable def finiteSelectiveTwoEquationObservableThreeAtV :
    finiteSelectiveTwoContextEquivalenceOuterInput.lowGeneratedLift.domain.algebra.equationSystem.Observable
      finiteSelectiveTwoContextEquivalenceV :=
  ((inverseCorePackageForwardUpper FiniteModel.corePackage
    finiteSelectiveTwoContextEquivalenceOuterInput.hom).equationTransport.observableEquiv
      finiteSelectiveTwoContextEquivalenceV).symm (3 : Int)

/-- The concrete observable used by naturality is nonzero. -/
theorem finiteSelectiveTwoEquationObservableThreeAtV_ne_zero :
    finiteSelectiveTwoEquationObservableThreeAtV ≠ 0 := by
  let observableEquiv :=
    (inverseCorePackageForwardUpper FiniteModel.corePackage
      finiteSelectiveTwoContextEquivalenceOuterInput.hom).equationTransport.observableEquiv
        finiteSelectiveTwoContextEquivalenceV
  intro hzero
  have himage := congrArg observableEquiv hzero
  change observableEquiv (observableEquiv.symm (3 : Int)) = observableEquiv 0 at himage
  have hthree : (3 : Int) ≠ 0 := by
    norm_num
  have hEq : (3 : Int) = 0 := by
    calc
      3 = observableEquiv (observableEquiv.symm (3 : Int)) :=
        (observableEquiv.apply_symm_apply 3).symm
      _ = observableEquiv 0 := himage
      _ = 0 := map_zero observableEquiv
  exact hthree hEq

/--
The assembled observable components commute with the concrete nonidentity
restriction from the distinct context `W` to the distinct context `V`, at the
nonzero value reflected from `3`.
-/
theorem finiteSelectiveTwoEquationTransport_observable_naturality :
    finiteSelectiveTwoReflectedEquationSystemExactTransport.{u}.observableEquiv
        finiteSelectiveTwoContextEquivalenceW
        (finiteSelectiveTwoContextEquivalenceOuterInput.lowGeneratedLift.domain.algebra.equationSystem.restrict
          finiteSelectiveTwoContextEquivalenceRestriction
          finiteSelectiveTwoEquationObservableThreeAtV) =
      finiteSelectiveTwoObjectContextWitnessInput.lowGeneratedLift.domain.algebra.equationSystem.restrict
        (finiteSelectiveTwoReflectedEquationSystemExactTransport.{u}.contextForward_map
          finiteSelectiveTwoContextEquivalenceRestriction)
        (finiteSelectiveTwoReflectedEquationSystemExactTransport.{u}.observableEquiv
          finiteSelectiveTwoContextEquivalenceV
          finiteSelectiveTwoEquationObservableThreeAtV) := by
  exact
    finiteGeneratedReflectedEquationSystemExactTransport_observable_naturality.{u}
      finiteSelectiveTwoObjectContextWitnessInput
      finiteSelectiveTwoObjectContextWitnessLift.{u}
      finiteSelectiveTwoObjectContextWitnessBase
      finiteSelectiveTwoContextEquivalenceRestriction
      finiteSelectiveTwoEquationObservableThreeAtV

/-! ## Violation-coordinate firing -/

/--
The concrete source violation coordinate at `W`, the generated index, and
`componentA` is preserved by the assembled transport.
-/
theorem finiteSelectiveTwoEquationTransport_violationCoordinate_eq :
    finiteSelectiveTwoReflectedEquationSystemExactTransport.{u}.observableEquiv
        finiteSelectiveTwoContextEquivalenceW
        (finiteSelectiveTwoContextEquivalenceOuterInput.lowGeneratedLift.domain.algebra.equationSystem.violationCoordinate
          finiteSelectiveTwoContextEquivalenceW
          finiteSelectiveTwoEquationSourceIndex
          FiniteModel.FiniteAtom.componentA) =
      finiteSelectiveTwoObjectContextWitnessInput.lowGeneratedLift.domain.algebra.equationSystem.violationCoordinate
        (finiteSelectiveTwoReflectedEquationSystemExactTransport.{u}.contextForward
          finiteSelectiveTwoContextEquivalenceW)
        (finiteSelectiveTwoReflectedEquationSystemExactTransport.{u}.equationMap
          finiteSelectiveTwoEquationSourceIndex)
        (finiteGeneratedReflectedUpperAtomEquiv.{u}
          finiteSelectiveTwoObjectContextWitnessInput
          finiteSelectiveTwoObjectContextWitnessLift.{u}
          finiteSelectiveTwoObjectContextWitnessBase
          FiniteModel.FiniteAtom.componentA) := by
  exact
    finiteGeneratedReflectedEquationSystemExactTransport_violationCoordinate_eq.{u}
      finiteSelectiveTwoObjectContextWitnessInput
      finiteSelectiveTwoObjectContextWitnessLift.{u}
      finiteSelectiveTwoObjectContextWitnessBase
      finiteSelectiveTwoContextEquivalenceW
      finiteSelectiveTwoEquationSourceIndex
      FiniteModel.FiniteAtom.componentA

/-- The selected finite target violation coordinate is the nonzero integer `2`. -/
theorem finiteSelectiveTwoTargetViolationCoordinate_ne_zero :
    FiniteModel.corePackage.algebra.equationSystem.violationCoordinate
        finiteSelectiveTwoContextEquivalenceCoreW PUnit.unit
        FiniteModel.FiniteAtom.componentA ≠ 0 := by
  change (2 : Int) ≠ 0
  norm_num

/-! ## Residual firing and object sensitivity -/

/--
The assembled residual field is fired on the cyclic finite-model object at the
same concrete context, index, and Atom.
-/
theorem finiteSelectiveTwoEquationTransport_cyclic_equationResidual_eq :
    finiteSelectiveTwoReflectedEquationSystemExactTransport.{u}.observableEquiv
        finiteSelectiveTwoContextEquivalenceW
        (finiteSelectiveTwoContextEquivalenceOuterInput.lowGeneratedLift.domain.algebra.equationSystem.equationResidual
          finiteSelectiveTwoContextEquivalenceW FiniteModel.object
          finiteSelectiveTwoEquationSourceIndex
          FiniteModel.FiniteAtom.componentA) =
      finiteSelectiveTwoObjectContextWitnessInput.lowGeneratedLift.domain.algebra.equationSystem.equationResidual
        (finiteSelectiveTwoReflectedEquationSystemExactTransport.{u}.contextForward
          finiteSelectiveTwoContextEquivalenceW)
        (finiteGeneratedReflectedArchitectureObject.{u}
          finiteSelectiveTwoObjectContextWitnessInput
          finiteSelectiveTwoObjectContextWitnessLift.{u}
          finiteSelectiveTwoObjectContextWitnessBase FiniteModel.object)
        (finiteSelectiveTwoReflectedEquationSystemExactTransport.{u}.equationMap
          finiteSelectiveTwoEquationSourceIndex)
        (finiteGeneratedReflectedUpperAtomEquiv.{u}
          finiteSelectiveTwoObjectContextWitnessInput
          finiteSelectiveTwoObjectContextWitnessLift.{u}
          finiteSelectiveTwoObjectContextWitnessBase
          FiniteModel.FiniteAtom.componentA) := by
  exact
    finiteGeneratedReflectedEquationSystemExactTransport_equationResidual_eq.{u}
      finiteSelectiveTwoObjectContextWitnessInput
      finiteSelectiveTwoObjectContextWitnessLift.{u}
      finiteSelectiveTwoObjectContextWitnessBase
      finiteSelectiveTwoContextEquivalenceW FiniteModel.object
      finiteSelectiveTwoEquationSourceIndex
      FiniteModel.FiniteAtom.componentA

/--
The assembled residual field is also fired on the acyclic finite-model object,
so the complete object argument is exercised independently of the cyclic case.
-/
theorem finiteSelectiveTwoEquationTransport_acyclic_equationResidual_eq :
    finiteSelectiveTwoReflectedEquationSystemExactTransport.{u}.observableEquiv
        finiteSelectiveTwoContextEquivalenceW
        (finiteSelectiveTwoContextEquivalenceOuterInput.lowGeneratedLift.domain.algebra.equationSystem.equationResidual
          finiteSelectiveTwoContextEquivalenceW FiniteModel.acyclicObject
          finiteSelectiveTwoEquationSourceIndex
          FiniteModel.FiniteAtom.componentA) =
      finiteSelectiveTwoObjectContextWitnessInput.lowGeneratedLift.domain.algebra.equationSystem.equationResidual
        (finiteSelectiveTwoReflectedEquationSystemExactTransport.{u}.contextForward
          finiteSelectiveTwoContextEquivalenceW)
        (finiteGeneratedReflectedArchitectureObject.{u}
          finiteSelectiveTwoObjectContextWitnessInput
          finiteSelectiveTwoObjectContextWitnessLift.{u}
          finiteSelectiveTwoObjectContextWitnessBase FiniteModel.acyclicObject)
        (finiteSelectiveTwoReflectedEquationSystemExactTransport.{u}.equationMap
          finiteSelectiveTwoEquationSourceIndex)
        (finiteGeneratedReflectedUpperAtomEquiv.{u}
          finiteSelectiveTwoObjectContextWitnessInput
          finiteSelectiveTwoObjectContextWitnessLift.{u}
          finiteSelectiveTwoObjectContextWitnessBase
          FiniteModel.FiniteAtom.componentA) := by
  exact
    finiteGeneratedReflectedEquationSystemExactTransport_equationResidual_eq.{u}
      finiteSelectiveTwoObjectContextWitnessInput
      finiteSelectiveTwoObjectContextWitnessLift.{u}
      finiteSelectiveTwoObjectContextWitnessBase
      finiteSelectiveTwoContextEquivalenceW FiniteModel.acyclicObject
      finiteSelectiveTwoEquationSourceIndex
      FiniteModel.FiniteAtom.componentA

/-- The cyclic finite-model object has residual value `1`. -/
theorem finiteSelectiveTwoCyclic_noCycleResidual_eq_one :
    FiniteModel.noCycleResidual FiniteModel.object = 1 := by
  have hcycle : FiniteModel.hasDependencyCycle FiniteModel.object := by
    simpa [FiniteModel.hasCycleWitness, FiniteModel.hasDependencyCycle] using
      FiniteModel.object_hasCycleWitness
  simp [FiniteModel.noCycleResidual, hcycle]

/-- The acyclic finite-model object has residual value `0`. -/
theorem finiteSelectiveTwoAcyclic_noCycleResidual_eq_zero :
    FiniteModel.noCycleResidual FiniteModel.acyclicObject = 0 := by
  have hacyclic : ¬ FiniteModel.hasDependencyCycle FiniteModel.acyclicObject := by
    intro hcycle
    exact hcycle.1
  simp [FiniteModel.noCycleResidual, hacyclic]

/-- The selected residual generator distinguishes the cyclic and acyclic objects. -/
theorem finiteSelectiveTwo_noCycleResidual_object_sensitive :
    FiniteModel.noCycleResidual FiniteModel.object ≠
      FiniteModel.noCycleResidual FiniteModel.acyclicObject := by
  rw [finiteSelectiveTwoCyclic_noCycleResidual_eq_one,
    finiteSelectiveTwoAcyclic_noCycleResidual_eq_zero]
  norm_num

end AAT.AG.DoctrineFiberProduct

#assert_standard_axioms_only AAT.AG.DoctrineFiberProduct
