import ResearchLean.AG.DoctrineFiberProduct.BCHorizontalPastingComparisonEquality
import ResearchLean.AG.DoctrineFiberProduct.BCVerticalPastingComparisonEquality
import ResearchLean.AG.DoctrineFiberProduct.BCPresentationReplacement

/-!
# Canonical mates of normalized outer pasting comparisons

This module identifies the canonical mate generated by each pasted outer
presentation with the mate of the corresponding reviewed exact-boundary
covariant comparison.  It connects the Cycle 91 and 92 comparison equalities
to the canonical-mate API while retaining the later obligation to align these
outer routes with the literal composites of the component mates.
-/

namespace AAT.AG.DoctrineFiberProduct

universe u

open CategoryTheory
open AtomFoundation CrossStageCoherence

set_option maxHeartbeats 2000000

/-- G-110(E) horizontal outer-mate predecessor: the canonical mate generated
by the independently constructed outer presentation is the mate of the
reviewed horizontal exact-boundary comparison.  Both the route provenance and
the comparison are generated from `data`; comparison with the literal
component-mate composite remains a later northwest/reindexing obligation. -/
theorem horizontalBCPastingOuterCanonicalMate_eq
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (data : HorizontalBCPastingData U) :
    bcProvenanceCanonicalMate
        (bcPastingNormalizedProvenance (.horizontal data)) =
      (mateEquiv
        (coreTransportReindexAdjunction
          (bcPastingNormalizedProvenance
            (.horizontal data)).leftProvenance.toRealizableHom)
        (coreTransportReindexAdjunction
          (bcPastingNormalizedProvenance
            (.horizontal data)).rightProvenance.toRealizableHom)
        (horizontalBCPastingOuterBoundaryComparison data).hom).natTrans := by
  rw [← bcSemanticSelectedMate_self
    (bcPastingNormalizedProvenance (.horizontal data))]
  unfold bcSemanticSelectedMate
  rw [bcPastingCoreTransportSquareIso_eq_semantic,
    ← horizontalBCPastingComparison_eq_outer]
  rfl

/-- G-110(E) vertical outer-mate predecessor: the canonical mate generated by
the independently constructed outer presentation is the mate of the reviewed
vertical exact-boundary comparison.  The literal component-mate composite
still uses composed adjunctions and requires the later adjunction and
northwest/reindexing alignment. -/
theorem verticalBCPastingOuterCanonicalMate_eq
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (data : VerticalBCPastingData U) :
    bcProvenanceCanonicalMate
        (bcPastingNormalizedProvenance (.vertical data)) =
      (mateEquiv
        (coreTransportReindexAdjunction
          (bcPastingNormalizedProvenance
            (.vertical data)).leftProvenance.toRealizableHom)
        (coreTransportReindexAdjunction
          (bcPastingNormalizedProvenance
            (.vertical data)).rightProvenance.toRealizableHom)
        (verticalBCPastingOuterBoundaryComparison data).hom).natTrans := by
  rw [← bcSemanticSelectedMate_self
    (bcPastingNormalizedProvenance (.vertical data))]
  unfold bcSemanticSelectedMate
  rw [bcPastingCoreTransportSquareIso_eq_semantic,
    ← verticalBCPastingComparison_eq_outer]
  rfl

end AAT.AG.DoctrineFiberProduct

#assert_standard_axioms_only AAT.AG.DoctrineFiberProduct
