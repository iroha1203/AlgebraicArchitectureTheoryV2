import ResearchLean.AG.CrossStageCoherence.FiberTransport

/-!
# Pseudofunctor coherence for geometry-fiber transport

This module constructs the compositor and unitor of the geometry-fiber
transport as natural isomorphisms.  Their components are the unique vertical
comparisons between canonical strongly cocartesian lifts.  Naturality,
three-arrow associativity, and both unit equations are then proved from the
same factorization equations.

## Implementation notes

No comparison is stored in a transport package.  The helper
`strongLiftComparisonIso` exposes the standard uniqueness construction for two
strongly cocartesian lifts of one base arrow.  The G-109 compositor and unitor
instantiate it only with the canonical lifts from `FiberTransport`.  The
coherence equations compare the actual composed routes, including the
equality-induced casts for associativity and unit laws.
-/

namespace AAT.AG.CrossStageCoherence

universe u v u₁ u₂ v₁ v₂

open CategoryTheory
open AtomFoundation
open GeometryTransport

set_option maxHeartbeats 2000000

/-- The unique vertical comparison from one strong lift to another. -/
noncomputable def strongLiftComparisonHom
    {𝒳 : Type u₁} {𝒮 : Type u₂}
    [Category.{v₁} 𝒳] [Category.{v₂} 𝒮]
    (q : 𝒳 ⥤ 𝒮) {R S : 𝒮} {a : 𝒳}
    {B C : q.Fiber S} (f : R ⟶ S)
    (φ : a ⟶ B.1) (ψ : a ⟶ C.1)
    [q.IsStronglyCocartesian f φ]
    [q.IsStronglyCocartesian f ψ] : B ⟶ C :=
  ⟨CategoryTheory.Functor.IsStronglyCocartesian.map
      q f φ (g := 𝟙 S) (f' := f) (Category.comp_id f).symm ψ,
    inferInstance⟩

/-- The comparison hom is characterized by factorization of the first lift. -/
theorem strongLiftComparisonHom_fac
    {𝒳 : Type u₁} {𝒮 : Type u₂}
    [Category.{v₁} 𝒳] [Category.{v₂} 𝒮]
    (q : 𝒳 ⥤ 𝒮) {R S : 𝒮} {a : 𝒳}
    {B C : q.Fiber S} (f : R ⟶ S)
    (φ : a ⟶ B.1) (ψ : a ⟶ C.1)
    [q.IsStronglyCocartesian f φ]
    [q.IsStronglyCocartesian f ψ] :
    φ ≫ (strongLiftComparisonHom q f φ ψ).1 = ψ :=
  CategoryTheory.Functor.IsStronglyCocartesian.fac
    q f φ (Category.comp_id f).symm ψ

/-- Two strong lifts of one base arrow have canonically isomorphic fiber targets. -/
noncomputable def strongLiftComparisonIso
    {𝒳 : Type u₁} {𝒮 : Type u₂}
    [Category.{v₁} 𝒳] [Category.{v₂} 𝒮]
    (q : 𝒳 ⥤ 𝒮) {R S : 𝒮} {a : 𝒳}
    {B C : q.Fiber S} (f : R ⟶ S)
    (φ : a ⟶ B.1) (ψ : a ⟶ C.1)
    [q.IsStronglyCocartesian f φ]
    [q.IsStronglyCocartesian f ψ] : B ≅ C where
  hom := strongLiftComparisonHom q f φ ψ
  inv := strongLiftComparisonHom q f ψ φ
  hom_inv_id := by
    apply CategoryTheory.Functor.Fiber.hom_ext
    apply CategoryTheory.Functor.IsStronglyCocartesian.ext q f φ (𝟙 S)
    change φ ≫ ((strongLiftComparisonHom q f φ ψ).1 ≫
      (strongLiftComparisonHom q f ψ φ).1) = φ ≫ 𝟙 B.1
    rw [← Category.assoc, strongLiftComparisonHom_fac,
      strongLiftComparisonHom_fac]
    simp
  inv_hom_id := by
    apply CategoryTheory.Functor.Fiber.hom_ext
    apply CategoryTheory.Functor.IsStronglyCocartesian.ext q f ψ (𝟙 S)
    change ψ ≫ ((strongLiftComparisonHom q f ψ φ).1 ≫
      (strongLiftComparisonHom q f φ ψ).1) = ψ ≫ 𝟙 C.1
    rw [← Category.assoc, strongLiftComparisonHom_fac,
      strongLiftComparisonHom_fac]
    simp

/-- The two-step canonical lift associated to composable pointed arrows. -/
noncomputable def geomFiberIteratedLift {U : AtomCarrier.{u}}
    {X Y Z : ExtractionInstance U} (σ : X ⟶ Y) (τ : Y ⟶ Z)
    (G : GeomFiber.{u, v} X) :
    G.1 ⟶ ((geomFiberTransportFunctor τ).obj
      ((geomFiberTransportFunctor σ).obj G)).1 :=
  geomFiberLift σ G ≫
    geomFiberLift τ ((geomFiberTransportFunctor σ).obj G)

/-- The two-step canonical lift is strong over the composite pointed arrow. -/
theorem geomFiberIteratedLift_isStronglyCocartesian
    {U : AtomCarrier.{u}}
    {X Y Z : ExtractionInstance U} (σ : X ⟶ Y) (τ : Y ⟶ Z)
    (G : GeomFiber.{u, v} X) :
    (crossStageProjection.{u, v} U).IsStronglyCocartesian
      (σ ≫ τ) (geomFiberIteratedLift σ τ G) := by
  letI : (crossStageProjection.{u, v} U).IsStronglyCocartesian
      σ (geomFiberLift σ G) := geomFiberLift_isStronglyCocartesian σ G
  letI : (crossStageProjection.{u, v} U).IsStronglyCocartesian
      τ (geomFiberLift τ ((geomFiberTransportFunctor σ).obj G)) :=
    geomFiberLift_isStronglyCocartesian τ
      ((geomFiberTransportFunctor σ).obj G)
  exact CategoryTheory.Functor.IsStronglyCocartesian.comp
    (crossStageProjection.{u, v} U)

/-- The compositor component generated by direct-versus-iterated lift uniqueness. -/
noncomputable def geomFiberCompositorApp {U : AtomCarrier.{u}}
    {X Y Z : ExtractionInstance U} (σ : X ⟶ Y) (τ : Y ⟶ Z)
    (G : GeomFiber.{u, v} X) :
    (geomFiberTransportFunctor (σ ≫ τ)).obj G ≅
      (geomFiberTransportFunctor τ).obj
        ((geomFiberTransportFunctor σ).obj G) := by
  letI : (crossStageProjection.{u, v} U).IsStronglyCocartesian
      (σ ≫ τ) (geomFiberLift (σ ≫ τ) G) :=
    geomFiberLift_isStronglyCocartesian (σ ≫ τ) G
  letI : (crossStageProjection.{u, v} U).IsStronglyCocartesian
      (σ ≫ τ) (geomFiberIteratedLift σ τ G) :=
    geomFiberIteratedLift_isStronglyCocartesian σ τ G
  exact strongLiftComparisonIso (crossStageProjection.{u, v} U)
    (σ ≫ τ) (geomFiberLift (σ ≫ τ) G) (geomFiberIteratedLift σ τ G)

/-- The compositor component factors the direct lift as the iterated lift. -/
theorem geomFiberCompositorApp_hom_fac {U : AtomCarrier.{u}}
    {X Y Z : ExtractionInstance U} (σ : X ⟶ Y) (τ : Y ⟶ Z)
    (G : GeomFiber.{u, v} X) :
    geomFiberLift (σ ≫ τ) G ≫ (geomFiberCompositorApp σ τ G).hom.1 =
      geomFiberIteratedLift σ τ G := by
  letI : (crossStageProjection.{u, v} U).IsStronglyCocartesian
      (σ ≫ τ) (geomFiberLift (σ ≫ τ) G) :=
    geomFiberLift_isStronglyCocartesian (σ ≫ τ) G
  letI : (crossStageProjection.{u, v} U).IsStronglyCocartesian
      (σ ≫ τ) (geomFiberIteratedLift σ τ G) :=
    geomFiberIteratedLift_isStronglyCocartesian σ τ G
  exact strongLiftComparisonHom_fac (crossStageProjection.{u, v} U)
    (σ ≫ τ) (geomFiberLift (σ ≫ τ) G) (geomFiberIteratedLift σ τ G)

/-- The iterated lift transports a vertical morphism to its authored composite. -/
theorem geomFiberIteratedMap_fac {U : AtomCarrier.{u}}
    {X Y Z : ExtractionInstance U} (σ : X ⟶ Y) (τ : Y ⟶ Z)
    {G H : GeomFiber.{u, v} X} (f : G ⟶ H) :
    geomFiberIteratedLift σ τ G ≫
        ((geomFiberTransportFunctor σ ⋙
          geomFiberTransportFunctor τ).map f).1 =
      f.1 ≫ geomFiberIteratedLift σ τ H := by
  change (geomFiberLift σ G ≫
      geomFiberLift τ ((geomFiberTransportFunctor σ).obj G)) ≫
        (geomFiberTransportMap τ (geomFiberTransportMap σ f)).1 =
    f.1 ≫ (geomFiberLift σ H ≫
      geomFiberLift τ ((geomFiberTransportFunctor σ).obj H))
  calc
    _ = geomFiberLift σ G ≫
        (geomFiberLift τ ((geomFiberTransportFunctor σ).obj G) ≫
          (geomFiberTransportMap τ (geomFiberTransportMap σ f)).1) :=
      Category.assoc _ _ _
    _ = geomFiberLift σ G ≫
        ((geomFiberTransportMap σ f).1 ≫
          geomFiberLift τ ((geomFiberTransportFunctor σ).obj H)) := by
      rw [show geomFiberLift τ ((geomFiberTransportFunctor σ).obj G) ≫
          (geomFiberTransportMap τ (geomFiberTransportMap σ f)).1 =
        (geomFiberTransportMap σ f).1 ≫
          geomFiberLift τ ((geomFiberTransportFunctor σ).obj H) by
        simpa only [geomFiberTransportFunctor] using
          geomFiberTransportMap_fac τ (geomFiberTransportMap σ f)]
    _ = (geomFiberLift σ G ≫ (geomFiberTransportMap σ f).1) ≫
        geomFiberLift τ ((geomFiberTransportFunctor σ).obj H) :=
      (Category.assoc _ _ _).symm
    _ = (f.1 ≫ geomFiberLift σ H) ≫
        geomFiberLift τ ((geomFiberTransportFunctor σ).obj H) := by
      rw [geomFiberTransportMap_fac]
    _ = _ := Category.assoc _ _ _

/-- The compositor is natural on vertical geometry morphisms. -/
theorem geomFiberCompositor_naturality {U : AtomCarrier.{u}}
    {X Y Z : ExtractionInstance U} (σ : X ⟶ Y) (τ : Y ⟶ Z)
    {G H : GeomFiber.{u, v} X} (f : G ⟶ H) :
    (geomFiberTransportFunctor (σ ≫ τ)).map f ≫
        (geomFiberCompositorApp σ τ H).hom =
      (geomFiberCompositorApp σ τ G).hom ≫
        (geomFiberTransportFunctor σ ⋙
          geomFiberTransportFunctor τ).map f := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  letI : (crossStageProjection.{u, v} U).IsStronglyCocartesian
      (σ ≫ τ) (geomFiberLift (σ ≫ τ) G) :=
    geomFiberLift_isStronglyCocartesian (σ ≫ τ) G
  apply CategoryTheory.Functor.IsStronglyCocartesian.ext
    (crossStageProjection.{u, v} U) (σ ≫ τ)
    (geomFiberLift (σ ≫ τ) G) (𝟙 Z)
  change geomFiberLift (σ ≫ τ) G ≫
      ((geomFiberTransportMap (σ ≫ τ) f).1 ≫
        (geomFiberCompositorApp σ τ H).hom.1) =
    geomFiberLift (σ ≫ τ) G ≫
      ((geomFiberCompositorApp σ τ G).hom.1 ≫
        (geomFiberTransportMap τ (geomFiberTransportMap σ f)).1)
  calc
    _ = (geomFiberLift (σ ≫ τ) G ≫
        (geomFiberTransportMap (σ ≫ τ) f).1) ≫
          (geomFiberCompositorApp σ τ H).hom.1 :=
      (Category.assoc _ _ _).symm
    _ = (f.1 ≫ geomFiberLift (σ ≫ τ) H) ≫
          (geomFiberCompositorApp σ τ H).hom.1 := by
      rw [geomFiberTransportMap_fac]
    _ = f.1 ≫ (geomFiberLift (σ ≫ τ) H ≫
          (geomFiberCompositorApp σ τ H).hom.1) :=
      Category.assoc _ _ _
    _ = f.1 ≫ geomFiberIteratedLift σ τ H := by
      rw [geomFiberCompositorApp_hom_fac]
    _ = geomFiberIteratedLift σ τ G ≫
        (geomFiberTransportMap τ (geomFiberTransportMap σ f)).1 :=
      (geomFiberIteratedMap_fac σ τ f).symm
    _ = (geomFiberLift (σ ≫ τ) G ≫
        (geomFiberCompositorApp σ τ G).hom.1) ≫
          (geomFiberTransportMap τ (geomFiberTransportMap σ f)).1 := by
      rw [geomFiberCompositorApp_hom_fac]
    _ = _ := Category.assoc _ _ _

/-- The natural compositor of the geometry-fiber transport. -/
noncomputable def geomFiberCompositor {U : AtomCarrier.{u}}
    {X Y Z : ExtractionInstance U} (σ : X ⟶ Y) (τ : Y ⟶ Z) :
    geomFiberTransportFunctor.{u, v} (σ ≫ τ) ≅
      geomFiberTransportFunctor.{u, v} σ ⋙
        geomFiberTransportFunctor.{u, v} τ :=
  NatIso.ofComponents (geomFiberCompositorApp σ τ)
    (fun f => geomFiberCompositor_naturality σ τ f)

/-- The identity lift of an object in a geometry fiber. -/
noncomputable def geomFiberIdentityLift {U : AtomCarrier.{u}}
    (X : ExtractionInstance U) (G : GeomFiber.{u, v} X) : G.1 ⟶ G.1 :=
  𝟙 G.1

/-- The identity lift is strong over the identity pointed arrow. -/
theorem geomFiberIdentityLift_isStronglyCocartesian {U : AtomCarrier.{u}}
    (X : ExtractionInstance U) (G : GeomFiber.{u, v} X) :
    (crossStageProjection.{u, v} U).IsStronglyCocartesian
      (𝟙 X) (geomFiberIdentityLift X G) := by
  letI : (crossStageProjection.{u, v} U).IsHomLift
      (𝟙 X) (geomFiberIdentityLift X G) := CategoryTheory.IsHomLift.id G.2
  letI : IsIso (geomFiberIdentityLift X G) := by
    change IsIso (𝟙 G.1)
    infer_instance
  exact CategoryTheory.Functor.IsStronglyCocartesian.of_isIso
    (crossStageProjection.{u, v} U) (𝟙 X) (geomFiberIdentityLift X G)

/-- The unitor component generated by canonical-versus-identity lift uniqueness. -/
noncomputable def geomFiberUnitorApp {U : AtomCarrier.{u}}
    (X : ExtractionInstance U) (G : GeomFiber.{u, v} X) :
    (geomFiberTransportFunctor (𝟙 X)).obj G ≅ G := by
  letI : (crossStageProjection.{u, v} U).IsStronglyCocartesian
      (𝟙 X) (geomFiberLift (𝟙 X) G) :=
    geomFiberLift_isStronglyCocartesian (𝟙 X) G
  letI : (crossStageProjection.{u, v} U).IsStronglyCocartesian
      (𝟙 X) (geomFiberIdentityLift X G) :=
    geomFiberIdentityLift_isStronglyCocartesian X G
  exact strongLiftComparisonIso (crossStageProjection.{u, v} U)
    (𝟙 X) (geomFiberLift (𝟙 X) G) (geomFiberIdentityLift X G)

/-- The unitor component factors canonical identity transport as the identity lift. -/
theorem geomFiberUnitorApp_hom_fac {U : AtomCarrier.{u}}
    (X : ExtractionInstance U) (G : GeomFiber.{u, v} X) :
    geomFiberLift (𝟙 X) G ≫ (geomFiberUnitorApp X G).hom.1 = 𝟙 G.1 := by
  letI : (crossStageProjection.{u, v} U).IsStronglyCocartesian
      (𝟙 X) (geomFiberLift (𝟙 X) G) :=
    geomFiberLift_isStronglyCocartesian (𝟙 X) G
  letI : (crossStageProjection.{u, v} U).IsStronglyCocartesian
      (𝟙 X) (geomFiberIdentityLift X G) :=
    geomFiberIdentityLift_isStronglyCocartesian X G
  exact strongLiftComparisonHom_fac (crossStageProjection.{u, v} U)
    (𝟙 X) (geomFiberLift (𝟙 X) G) (geomFiberIdentityLift X G)

/-- The unitor is natural on every vertical geometry morphism. -/
theorem geomFiberUnitor_naturality {U : AtomCarrier.{u}}
    (X : ExtractionInstance U) {G H : GeomFiber.{u, v} X} (f : G ⟶ H) :
    (geomFiberTransportFunctor (𝟙 X)).map f ≫
        (geomFiberUnitorApp X H).hom =
      (geomFiberUnitorApp X G).hom ≫ f := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  letI : (crossStageProjection.{u, v} U).IsStronglyCocartesian
      (𝟙 X) (geomFiberLift (𝟙 X) G) :=
    geomFiberLift_isStronglyCocartesian (𝟙 X) G
  apply CategoryTheory.Functor.IsStronglyCocartesian.ext
    (crossStageProjection.{u, v} U) (𝟙 X)
    (geomFiberLift (𝟙 X) G) (𝟙 X)
  change geomFiberLift (𝟙 X) G ≫
      ((geomFiberTransportMap (𝟙 X) f).1 ≫
        (geomFiberUnitorApp X H).hom.1) =
    geomFiberLift (𝟙 X) G ≫ ((geomFiberUnitorApp X G).hom.1 ≫ f.1)
  calc
    _ = (geomFiberLift (𝟙 X) G ≫
        (geomFiberTransportMap (𝟙 X) f).1) ≫
          (geomFiberUnitorApp X H).hom.1 :=
      (Category.assoc _ _ _).symm
    _ = (f.1 ≫ geomFiberLift (𝟙 X) H) ≫
          (geomFiberUnitorApp X H).hom.1 := by
      rw [geomFiberTransportMap_fac]
    _ = f.1 ≫ (geomFiberLift (𝟙 X) H ≫
          (geomFiberUnitorApp X H).hom.1) := Category.assoc _ _ _
    _ = f.1 := by rw [geomFiberUnitorApp_hom_fac, Category.comp_id]
    _ = (geomFiberLift (𝟙 X) G ≫
          (geomFiberUnitorApp X G).hom.1) ≫ f.1 := by
      rw [geomFiberUnitorApp_hom_fac, Category.id_comp]
    _ = _ := Category.assoc _ _ _

/-- The natural unitor of the geometry-fiber transport. -/
noncomputable def geomFiberUnitor {U : AtomCarrier.{u}}
    (X : ExtractionInstance U) :
    geomFiberTransportFunctor.{u, v} (𝟙 X) ≅ 𝟭 (GeomFiber.{u, v} X) :=
  NatIso.ofComponents (geomFiberUnitorApp X)
    (fun f => geomFiberUnitor_naturality X f)

/-- Transport-object cast induced by equality of two pointed base arrows. -/
noncomputable def geomFiberTransportEqCast {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} {σ τ : X ⟶ Y} (h : σ = τ)
    (G : GeomFiber.{u, v} X) :
    (geomFiberTransportFunctor σ).obj G ⟶
      (geomFiberTransportFunctor τ).obj G :=
  eqToHom (congrArg (fun k => (geomFiberTransportFunctor k).obj G) h)

/-- Equality transport of the base arrow carries its canonical lift to the other lift. -/
theorem geomFiberLift_eqCast_fac {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} {σ τ : X ⟶ Y} (h : σ = τ)
    (G : GeomFiber.{u, v} X) :
    geomFiberLift σ G ≫ (geomFiberTransportEqCast h G).1 =
      geomFiberLift τ G := by
  cases h
  change geomFiberLift σ G ≫ 𝟙 _ = geomFiberLift σ G
  exact Category.comp_id _

/-- The fully iterated right-associated three-arrow canonical lift. -/
noncomputable def geomFiberTripleIteratedLift {U : AtomCarrier.{u}}
    {W X Y Z : ExtractionInstance U}
    (σ : W ⟶ X) (τ : X ⟶ Y) (υ : Y ⟶ Z)
    (G : GeomFiber.{u, v} W) :
    G.1 ⟶ ((geomFiberTransportFunctor υ).obj
      ((geomFiberTransportFunctor τ).obj
        ((geomFiberTransportFunctor σ).obj G))).1 :=
  geomFiberLift σ G ≫
    geomFiberIteratedLift τ υ ((geomFiberTransportFunctor σ).obj G)

/-- The object cast from left- to right-associated base composition. -/
noncomputable def geomFiberAssociatorCast {U : AtomCarrier.{u}}
    {W X Y Z : ExtractionInstance U}
    (σ : W ⟶ X) (τ : X ⟶ Y) (υ : Y ⟶ Z)
    (G : GeomFiber.{u, v} W) :
    (geomFiberTransportFunctor ((σ ≫ τ) ≫ υ)).obj G ⟶
      (geomFiberTransportFunctor (σ ≫ (τ ≫ υ))).obj G :=
  geomFiberTransportEqCast (Category.assoc σ τ υ) G

/-- The left-associated compositor route in the three-arrow pentagon. -/
noncomputable def geomFiberPentagonLeftRoute {U : AtomCarrier.{u}}
    {W X Y Z : ExtractionInstance U}
    (σ : W ⟶ X) (τ : X ⟶ Y) (υ : Y ⟶ Z)
    (G : GeomFiber.{u, v} W) :
    (geomFiberTransportFunctor ((σ ≫ τ) ≫ υ)).obj G ⟶
      (geomFiberTransportFunctor υ).obj
        ((geomFiberTransportFunctor τ).obj
          ((geomFiberTransportFunctor σ).obj G)) :=
  (geomFiberCompositorApp (σ ≫ τ) υ G).hom ≫
    (geomFiberTransportFunctor υ).map (geomFiberCompositorApp σ τ G).hom

/-- The right-associated compositor route in the three-arrow pentagon. -/
noncomputable def geomFiberPentagonRightRoute {U : AtomCarrier.{u}}
    {W X Y Z : ExtractionInstance U}
    (σ : W ⟶ X) (τ : X ⟶ Y) (υ : Y ⟶ Z)
    (G : GeomFiber.{u, v} W) :
    (geomFiberTransportFunctor ((σ ≫ τ) ≫ υ)).obj G ⟶
      (geomFiberTransportFunctor υ).obj
        ((geomFiberTransportFunctor τ).obj
          ((geomFiberTransportFunctor σ).obj G)) :=
  geomFiberAssociatorCast σ τ υ G ≫
    ((geomFiberCompositorApp σ (τ ≫ υ) G).hom ≫
      (geomFiberCompositorApp τ υ
        ((geomFiberTransportFunctor σ).obj G)).hom)

/-- The left compositor route factors the direct lift as full iteration. -/
theorem geomFiberPentagonLeftRoute_fac {U : AtomCarrier.{u}}
    {W X Y Z : ExtractionInstance U}
    (σ : W ⟶ X) (τ : X ⟶ Y) (υ : Y ⟶ Z)
    (G : GeomFiber.{u, v} W) :
    geomFiberLift ((σ ≫ τ) ≫ υ) G ≫
        (geomFiberPentagonLeftRoute σ τ υ G).1 =
      geomFiberTripleIteratedLift σ τ υ G := by
  change geomFiberLift ((σ ≫ τ) ≫ υ) G ≫
      ((geomFiberCompositorApp (σ ≫ τ) υ G).hom.1 ≫
        (geomFiberTransportMap υ
          (geomFiberCompositorApp σ τ G).hom).1) =
    geomFiberLift σ G ≫
      geomFiberIteratedLift τ υ ((geomFiberTransportFunctor σ).obj G)
  calc
    _ = (geomFiberLift ((σ ≫ τ) ≫ υ) G ≫
        (geomFiberCompositorApp (σ ≫ τ) υ G).hom.1) ≫
          (geomFiberTransportMap υ
            (geomFiberCompositorApp σ τ G).hom).1 :=
      (Category.assoc _ _ _).symm
    _ = geomFiberIteratedLift (σ ≫ τ) υ G ≫
          (geomFiberTransportMap υ
            (geomFiberCompositorApp σ τ G).hom).1 := by
      rw [geomFiberCompositorApp_hom_fac]
    _ = (geomFiberLift (σ ≫ τ) G ≫
          geomFiberLift υ ((geomFiberTransportFunctor (σ ≫ τ)).obj G)) ≫
          (geomFiberTransportMap υ
            (geomFiberCompositorApp σ τ G).hom).1 := rfl
    _ = geomFiberLift (σ ≫ τ) G ≫
        (geomFiberLift υ ((geomFiberTransportFunctor (σ ≫ τ)).obj G) ≫
          (geomFiberTransportMap υ
            (geomFiberCompositorApp σ τ G).hom).1) :=
      Category.assoc _ _ _
    _ = geomFiberLift (σ ≫ τ) G ≫
        ((geomFiberCompositorApp σ τ G).hom.1 ≫
          geomFiberLift υ
            ((geomFiberTransportFunctor τ).obj
              ((geomFiberTransportFunctor σ).obj G))) := by
      rw [show geomFiberLift υ ((geomFiberTransportFunctor (σ ≫ τ)).obj G) ≫
          (geomFiberTransportMap υ
            (geomFiberCompositorApp σ τ G).hom).1 =
        (geomFiberCompositorApp σ τ G).hom.1 ≫
          geomFiberLift υ
            ((geomFiberTransportFunctor τ).obj
              ((geomFiberTransportFunctor σ).obj G)) by
        simpa only [geomFiberTransportFunctor] using
          geomFiberTransportMap_fac υ
            (geomFiberCompositorApp σ τ G).hom]
    _ = (geomFiberLift (σ ≫ τ) G ≫
          (geomFiberCompositorApp σ τ G).hom.1) ≫
        geomFiberLift υ
          ((geomFiberTransportFunctor τ).obj
            ((geomFiberTransportFunctor σ).obj G)) :=
      (Category.assoc _ _ _).symm
    _ = geomFiberIteratedLift σ τ G ≫
        geomFiberLift υ
          ((geomFiberTransportFunctor τ).obj
            ((geomFiberTransportFunctor σ).obj G)) := by
      rw [geomFiberCompositorApp_hom_fac]
    _ = _ := by
      simp only [geomFiberIteratedLift, Category.assoc]

/-- The right compositor route factors the direct lift as full iteration. -/
theorem geomFiberPentagonRightRoute_fac {U : AtomCarrier.{u}}
    {W X Y Z : ExtractionInstance U}
    (σ : W ⟶ X) (τ : X ⟶ Y) (υ : Y ⟶ Z)
    (G : GeomFiber.{u, v} W) :
    geomFiberLift ((σ ≫ τ) ≫ υ) G ≫
        (geomFiberPentagonRightRoute σ τ υ G).1 =
      geomFiberTripleIteratedLift σ τ υ G := by
  change geomFiberLift ((σ ≫ τ) ≫ υ) G ≫
      ((geomFiberAssociatorCast σ τ υ G).1 ≫
        ((geomFiberCompositorApp σ (τ ≫ υ) G).hom.1 ≫
          (geomFiberCompositorApp τ υ
            ((geomFiberTransportFunctor σ).obj G)).hom.1)) =
    geomFiberLift σ G ≫
      geomFiberIteratedLift τ υ ((geomFiberTransportFunctor σ).obj G)
  calc
    _ = (geomFiberLift ((σ ≫ τ) ≫ υ) G ≫
        (geomFiberAssociatorCast σ τ υ G).1) ≫
          ((geomFiberCompositorApp σ (τ ≫ υ) G).hom.1 ≫
            (geomFiberCompositorApp τ υ
              ((geomFiberTransportFunctor σ).obj G)).hom.1) :=
      (Category.assoc _ _ _).symm
    _ = geomFiberLift (σ ≫ (τ ≫ υ)) G ≫
          ((geomFiberCompositorApp σ (τ ≫ υ) G).hom.1 ≫
            (geomFiberCompositorApp τ υ
              ((geomFiberTransportFunctor σ).obj G)).hom.1) := by
      rw [geomFiberAssociatorCast, geomFiberLift_eqCast_fac]
    _ = (geomFiberLift (σ ≫ (τ ≫ υ)) G ≫
          (geomFiberCompositorApp σ (τ ≫ υ) G).hom.1) ≫
        (geomFiberCompositorApp τ υ
          ((geomFiberTransportFunctor σ).obj G)).hom.1 :=
      (Category.assoc _ _ _).symm
    _ = geomFiberIteratedLift σ (τ ≫ υ) G ≫
        (geomFiberCompositorApp τ υ
          ((geomFiberTransportFunctor σ).obj G)).hom.1 := by
      rw [geomFiberCompositorApp_hom_fac]
    _ = (geomFiberLift σ G ≫
          geomFiberLift (τ ≫ υ) ((geomFiberTransportFunctor σ).obj G)) ≫
        (geomFiberCompositorApp τ υ
          ((geomFiberTransportFunctor σ).obj G)).hom.1 := rfl
    _ = geomFiberLift σ G ≫
        (geomFiberLift (τ ≫ υ) ((geomFiberTransportFunctor σ).obj G) ≫
          (geomFiberCompositorApp τ υ
            ((geomFiberTransportFunctor σ).obj G)).hom.1) :=
      Category.assoc _ _ _
    _ = _ := by rw [geomFiberCompositorApp_hom_fac]

/-- Three-arrow associativity: the two actual compositor routes coincide. -/
theorem geomFiberCompositor_assoc {U : AtomCarrier.{u}}
    {W X Y Z : ExtractionInstance U}
    (σ : W ⟶ X) (τ : X ⟶ Y) (υ : Y ⟶ Z)
    (G : GeomFiber.{u, v} W) :
    geomFiberPentagonLeftRoute σ τ υ G =
      geomFiberPentagonRightRoute σ τ υ G := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  letI : (crossStageProjection.{u, v} U).IsStronglyCocartesian
      ((σ ≫ τ) ≫ υ) (geomFiberLift ((σ ≫ τ) ≫ υ) G) :=
    geomFiberLift_isStronglyCocartesian ((σ ≫ τ) ≫ υ) G
  apply CategoryTheory.Functor.IsStronglyCocartesian.ext
    (crossStageProjection.{u, v} U) ((σ ≫ τ) ≫ υ)
    (geomFiberLift ((σ ≫ τ) ≫ υ) G) (𝟙 Z)
  change geomFiberLift ((σ ≫ τ) ≫ υ) G ≫
      (geomFiberPentagonLeftRoute σ τ υ G).1 =
    geomFiberLift ((σ ≫ τ) ≫ υ) G ≫
      (geomFiberPentagonRightRoute σ τ υ G).1
  rw [geomFiberPentagonLeftRoute_fac, geomFiberPentagonRightRoute_fac]

/-- Equality cast for the right unit equation. -/
noncomputable def geomFiberRightUnitCast {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (σ : X ⟶ Y)
    (G : GeomFiber.{u, v} X) :
    (geomFiberTransportFunctor (σ ≫ 𝟙 Y)).obj G ⟶
      (geomFiberTransportFunctor σ).obj G :=
  geomFiberTransportEqCast (Category.comp_id σ) G

/-- Compositor followed by the target unitor, the right unit route. -/
noncomputable def geomFiberRightUnitRoute {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (σ : X ⟶ Y)
    (G : GeomFiber.{u, v} X) :
    (geomFiberTransportFunctor (σ ≫ 𝟙 Y)).obj G ⟶
      (geomFiberTransportFunctor σ).obj G :=
  (geomFiberCompositorApp σ (𝟙 Y) G).hom ≫
    (geomFiberUnitorApp Y ((geomFiberTransportFunctor σ).obj G)).hom

/-- The right unit route factors to the original canonical lift. -/
theorem geomFiberRightUnitRoute_fac {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (σ : X ⟶ Y)
    (G : GeomFiber.{u, v} X) :
    geomFiberLift (σ ≫ 𝟙 Y) G ≫
        (geomFiberRightUnitRoute σ G).1 = geomFiberLift σ G := by
  change geomFiberLift (σ ≫ 𝟙 Y) G ≫
      ((geomFiberCompositorApp σ (𝟙 Y) G).hom.1 ≫
        (geomFiberUnitorApp Y
          ((geomFiberTransportFunctor σ).obj G)).hom.1) =
    geomFiberLift σ G
  calc
    _ = (geomFiberLift (σ ≫ 𝟙 Y) G ≫
        (geomFiberCompositorApp σ (𝟙 Y) G).hom.1) ≫
          (geomFiberUnitorApp Y
            ((geomFiberTransportFunctor σ).obj G)).hom.1 :=
      (Category.assoc _ _ _).symm
    _ = geomFiberIteratedLift σ (𝟙 Y) G ≫
          (geomFiberUnitorApp Y
            ((geomFiberTransportFunctor σ).obj G)).hom.1 := by
      rw [geomFiberCompositorApp_hom_fac]
    _ = (geomFiberLift σ G ≫
          geomFiberLift (𝟙 Y) ((geomFiberTransportFunctor σ).obj G)) ≫
        (geomFiberUnitorApp Y
          ((geomFiberTransportFunctor σ).obj G)).hom.1 := rfl
    _ = geomFiberLift σ G ≫
        (geomFiberLift (𝟙 Y) ((geomFiberTransportFunctor σ).obj G) ≫
          (geomFiberUnitorApp Y
            ((geomFiberTransportFunctor σ).obj G)).hom.1) :=
      Category.assoc _ _ _
    _ = _ := by
      rw [geomFiberUnitorApp_hom_fac]
      exact Category.comp_id _

/-- The right unit triangle compares the actual route with the base equality cast. -/
theorem geomFiberCompositor_right_unit {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (σ : X ⟶ Y)
    (G : GeomFiber.{u, v} X) :
    geomFiberRightUnitRoute σ G = geomFiberRightUnitCast σ G := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  letI : (crossStageProjection.{u, v} U).IsStronglyCocartesian
      (σ ≫ 𝟙 Y) (geomFiberLift (σ ≫ 𝟙 Y) G) :=
    geomFiberLift_isStronglyCocartesian (σ ≫ 𝟙 Y) G
  apply CategoryTheory.Functor.IsStronglyCocartesian.ext
    (crossStageProjection.{u, v} U) (σ ≫ 𝟙 Y)
    (geomFiberLift (σ ≫ 𝟙 Y) G) (𝟙 Y)
  change geomFiberLift (σ ≫ 𝟙 Y) G ≫
      (geomFiberRightUnitRoute σ G).1 =
    geomFiberLift (σ ≫ 𝟙 Y) G ≫
      (geomFiberRightUnitCast σ G).1
  rw [geomFiberRightUnitRoute_fac]
  exact (geomFiberLift_eqCast_fac (Category.comp_id σ) G).symm

/-- Equality cast for the left unit equation. -/
noncomputable def geomFiberLeftUnitCast {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (σ : X ⟶ Y)
    (G : GeomFiber.{u, v} X) :
    (geomFiberTransportFunctor (𝟙 X ≫ σ)).obj G ⟶
      (geomFiberTransportFunctor σ).obj G :=
  geomFiberTransportEqCast (Category.id_comp σ) G

/-- Source unitor transported along `σ`, the left unit route. -/
noncomputable def geomFiberLeftUnitRoute {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (σ : X ⟶ Y)
    (G : GeomFiber.{u, v} X) :
    (geomFiberTransportFunctor (𝟙 X ≫ σ)).obj G ⟶
      (geomFiberTransportFunctor σ).obj G :=
  (geomFiberCompositorApp (𝟙 X) σ G).hom ≫
    (geomFiberTransportFunctor σ).map (geomFiberUnitorApp X G).hom

/-- The left unit route factors to the original canonical lift. -/
theorem geomFiberLeftUnitRoute_fac {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (σ : X ⟶ Y)
    (G : GeomFiber.{u, v} X) :
    geomFiberLift (𝟙 X ≫ σ) G ≫
        (geomFiberLeftUnitRoute σ G).1 = geomFiberLift σ G := by
  change geomFiberLift (𝟙 X ≫ σ) G ≫
      ((geomFiberCompositorApp (𝟙 X) σ G).hom.1 ≫
        (geomFiberTransportMap σ (geomFiberUnitorApp X G).hom).1) =
    geomFiberLift σ G
  calc
    _ = (geomFiberLift (𝟙 X ≫ σ) G ≫
        (geomFiberCompositorApp (𝟙 X) σ G).hom.1) ≫
          (geomFiberTransportMap σ (geomFiberUnitorApp X G).hom).1 :=
      (Category.assoc _ _ _).symm
    _ = geomFiberIteratedLift (𝟙 X) σ G ≫
          (geomFiberTransportMap σ (geomFiberUnitorApp X G).hom).1 := by
      rw [geomFiberCompositorApp_hom_fac]
    _ = (geomFiberLift (𝟙 X) G ≫
          geomFiberLift σ ((geomFiberTransportFunctor (𝟙 X)).obj G)) ≫
        (geomFiberTransportMap σ (geomFiberUnitorApp X G).hom).1 := rfl
    _ = geomFiberLift (𝟙 X) G ≫
        (geomFiberLift σ ((geomFiberTransportFunctor (𝟙 X)).obj G) ≫
          (geomFiberTransportMap σ (geomFiberUnitorApp X G).hom).1) :=
      Category.assoc _ _ _
    _ = geomFiberLift (𝟙 X) G ≫
        ((geomFiberUnitorApp X G).hom.1 ≫ geomFiberLift σ G) := by
      rw [show geomFiberLift σ ((geomFiberTransportFunctor (𝟙 X)).obj G) ≫
          (geomFiberTransportMap σ (geomFiberUnitorApp X G).hom).1 =
        (geomFiberUnitorApp X G).hom.1 ≫ geomFiberLift σ G by
        simpa only [geomFiberTransportFunctor] using
          geomFiberTransportMap_fac σ (geomFiberUnitorApp X G).hom]
    _ = (geomFiberLift (𝟙 X) G ≫
          (geomFiberUnitorApp X G).hom.1) ≫ geomFiberLift σ G :=
      (Category.assoc _ _ _).symm
    _ = _ := by rw [geomFiberUnitorApp_hom_fac, Category.id_comp]

/-- The left unit triangle compares the actual route with the base equality cast. -/
theorem geomFiberCompositor_left_unit {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (σ : X ⟶ Y)
    (G : GeomFiber.{u, v} X) :
    geomFiberLeftUnitRoute σ G = geomFiberLeftUnitCast σ G := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  letI : (crossStageProjection.{u, v} U).IsStronglyCocartesian
      (𝟙 X ≫ σ) (geomFiberLift (𝟙 X ≫ σ) G) :=
    geomFiberLift_isStronglyCocartesian (𝟙 X ≫ σ) G
  apply CategoryTheory.Functor.IsStronglyCocartesian.ext
    (crossStageProjection.{u, v} U) (𝟙 X ≫ σ)
    (geomFiberLift (𝟙 X ≫ σ) G) (𝟙 Y)
  change geomFiberLift (𝟙 X ≫ σ) G ≫
      (geomFiberLeftUnitRoute σ G).1 =
    geomFiberLift (𝟙 X ≫ σ) G ≫
      (geomFiberLeftUnitCast σ G).1
  rw [geomFiberLeftUnitRoute_fac]
  exact (geomFiberLift_eqCast_fac (Category.id_comp σ) G).symm

end AAT.AG.CrossStageCoherence

#assert_standard_axioms_only AAT.AG.CrossStageCoherence
