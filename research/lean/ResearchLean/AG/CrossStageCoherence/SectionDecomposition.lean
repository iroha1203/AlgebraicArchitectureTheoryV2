import ResearchLean.AG.CrossStageCoherence.StrictObstruction
import ResearchLean.AG.TransportCoherence.VanishingCoherence

/-!
# Aligned edge sections and the cross-stage obstruction decomposition

An edge edgeSection consists only of typed core edge gauges, fixed-endpoint lifts
in `C_G`, and their edgewise projection equations.  No cell-level comparison
equation is stored.  The cell comparison `m` is generated by the upper
canonical comparator from the lifted edge coordinate.

`CoreAlignmentAt` is an independent category-level path equation for the
projected authored comparator.  Strong-cocartesian uniqueness derives
`p(m) = p(u)`.  That theorem supplies both membership of `u m⁻¹` in `H_G` and
the fixed-order factorization
`u phi⁻¹ = (u m⁻¹) (m phi⁻¹)`.

## Implementation notes

`EdgeSectionFamily` contains only edge gauges, fixed-endpoint lifts, and their
projection equations; cell comparison equations are deliberately derived.
Storing `p(m) = p(u)` or reversing the displayed factor order was rejected,
because both would hide the provenance of the kernel term.
-/

namespace AAT.AG.CrossStageCoherence

universe u v

open CategoryTheory
open AtomFoundation
open GeometryTransport
open TransportCoherence

set_option maxHeartbeats 3000000

/-- Edge-level core gauges with fixed-endpoint lifts through `p`. -/
structure EdgeSectionFamily {P : FiniteTransportPresentation.{u}}
    {U : AtomCarrier.{u}} (data : TwoLayerTransportData.{u, v} P U) where
  /-- Typed core edge values. -/
  core : EdgeReselection data.coreData.lift
  /-- Fixed-endpoint geometry lifts of those edge values. -/
  lift : UpperEdgeReselection data.lift
  /-- Edgewise projection equation; no cell comparator equation occurs here. -/
  projects : ∀ (i j : P.Vertex) (edge : P.Edge i j),
    compositeFiberPushforward (data.lift.geometry j) (lift i j edge) =
      core i j edge

/-- The pushed lifted coordinate is exactly the authored core coordinate. -/
theorem EdgeSectionFamily.pushforward_lift_eq_core
    {P : FiniteTransportPresentation.{u}} {U : AtomCarrier.{u}}
    {data : TwoLayerTransportData.{u, v} P U}
    (edgeSection : EdgeSectionFamily data) :
    pushforwardEdgeReselection data.lift edgeSection.lift = edgeSection.core := by
  funext i j edge
  exact edgeSection.projects i j edge

/-- The identity edge edgeSection, constructed without any cell-level premise. -/
noncomputable def identityEdgeSection
    {P : FiniteTransportPresentation.{u}} {U : AtomCarrier.{u}}
    (data : TwoLayerTransportData.{u, v} P U) : EdgeSectionFamily data where
  core := 1
  lift := 1
  projects _ _ _ := map_one _

/-- Cell comparison generated by the lifted edge edgeSection. -/
noncomputable def sectionCellComparator
    {P : FiniteTransportPresentation.{u}} {U : AtomCarrier.{u}}
    (data : TwoLayerTransportData.{u, v} P U)
    (edgeSection : EdgeSectionFamily data) (cell : P.TwoCell) :
    CompositeFiberAut (data.lift.geometry (P.twoTarget cell)) :=
  upperCanonicalTwoCellComparator data edgeSection.lift cell

/-- Projection of the generated cell comparison is the core canonical comparison. -/
theorem sectionCellComparator_pushforward
    {P : FiniteTransportPresentation.{u}} {U : AtomCarrier.{u}}
    (data : TwoLayerTransportData.{u, v} P U)
    (edgeSection : EdgeSectionFamily data) (cell : P.TwoCell) :
    compositeFiberPushforward (data.lift.geometry (P.twoTarget cell))
        (sectionCellComparator data edgeSection cell) =
      canonicalTwoCellComparator data.coreData edgeSection.core cell := by
  unfold sectionCellComparator
  rw [pushforward_upperCanonicalTwoCellComparator,
    edgeSection.pushforward_lift_eq_core]

/-- Category-level alignment of the projected authored comparator with the core edge gauge. -/
def CoreAlignmentAt {P : FiniteTransportPresentation.{u}}
    {U : AtomCarrier.{u}} (data : TwoLayerTransportData.{u, v} P U)
    (edgeSection : EdgeSectionFamily data) : Prop :=
  ∀ cell : P.TwoCell,
    (reselectedPathLift data.coreData.lift edgeSection.core
      (P.twoLeft cell)).comp
      (PackageFiberAut.hom
        (compositeFiberPushforward
          (data.lift.geometry (P.twoTarget cell))
          (data.comparator cell))) =
    reselectedPathLift data.coreData.lift edgeSection.core (P.twoRight cell)

/-- Alignment derives the forbidden-to-store equation `p(m) = p(u)`. -/
theorem sectionCellComparator_pushforward_eq_authored
    {P : FiniteTransportPresentation.{u}} {U : AtomCarrier.{u}}
    (data : TwoLayerTransportData.{u, v} P U)
    (edgeSection : EdgeSectionFamily data) (alignment : CoreAlignmentAt data edgeSection)
    (cell : P.TwoCell) :
    compositeFiberPushforward (data.lift.geometry (P.twoTarget cell))
        (sectionCellComparator data edgeSection cell) =
      compositeFiberPushforward (data.lift.geometry (P.twoTarget cell))
        (data.comparator cell) := by
  rw [sectionCellComparator_pushforward]
  letI : (packageProjection U).IsStronglyCocartesian
      (reselectedPathLift data.coreData.lift edgeSection.core
        (P.twoLeft cell)).base
      (reselectedPathLift data.coreData.lift edgeSection.core
        (P.twoLeft cell)) :=
    reselectedPathLift_isStronglyCocartesian
      data.coreData.lift edgeSection.core (P.twoLeft cell)
  apply PackageFiberAut.ext_of_strong_fac
    (reselectedPathLift data.coreData.lift edgeSection.core
      (P.twoLeft cell))
  exact (canonicalTwoCellComparator_fac data.coreData edgeSection.core cell).trans
    (alignment cell).symm

/-- The baseline composite canonical comparator `phi`. -/
noncomputable def baselineUpperComparator
    {P : FiniteTransportPresentation.{u}} {U : AtomCarrier.{u}}
    (data : TwoLayerTransportData.{u, v} P U) (cell : P.TwoCell) :
    CompositeFiberAut (data.lift.geometry (P.twoTarget cell)) :=
  upperCanonicalTwoCellComparator data 1 cell

/-- Total obstruction term `u * phi⁻¹`. -/
noncomputable def totalObstruction
    {P : FiniteTransportPresentation.{u}} {U : AtomCarrier.{u}}
    (data : TwoLayerTransportData.{u, v} P U) (cell : P.TwoCell) :
    CompositeFiberAut (data.lift.geometry (P.twoTarget cell)) :=
  data.comparator cell * (baselineUpperComparator data cell)⁻¹

/-- Core interstage obstruction for the projected data. -/
noncomputable def interstageObstruction
    {P : FiniteTransportPresentation.{u}} {U : AtomCarrier.{u}}
    (data : TwoLayerTransportData.{u, v} P U) (cell : P.TwoCell) :
    PackageFiberAut (data.coreData.lift.package (P.twoTarget cell)) :=
  rawTwoCellDefect data.coreData 1 cell

/-- Pushforward of the identity upper edge coordinate is identity. -/
theorem pushforwardEdgeReselection_one
    {P : FiniteTransportPresentation.{u}} {U : AtomCarrier.{u}}
    (data : TwoLayerLiftData.{u, v} P U) :
    pushforwardEdgeReselection data 1 = 1 := by
  funext i j edge
  exact map_one _

/-- The baseline raw defect is the explicitly named total obstruction. -/
theorem totalObstruction_eq_upperRaw
    {P : FiniteTransportPresentation.{u}} {U : AtomCarrier.{u}}
    (data : TwoLayerTransportData.{u, v} P U) (cell : P.TwoCell) :
    totalObstruction data cell = upperRawTwoCellDefect data 1 cell :=
  rfl

/-- Unconditional projection formula `p(total) = interstage`. -/
theorem totalObstruction_projection
    {P : FiniteTransportPresentation.{u}} {U : AtomCarrier.{u}}
    (data : TwoLayerTransportData.{u, v} P U) (cell : P.TwoCell) :
    compositeFiberPushforward (data.lift.geometry (P.twoTarget cell))
        (totalObstruction data cell) = interstageObstruction data cell := by
  rw [totalObstruction_eq_upperRaw, interstageObstruction,
    pushforward_upperRawTwoCellDefect, pushforwardEdgeReselection_one]

/-- The edgeSection lift of the interstage term, independently `m * phi⁻¹`. -/
noncomputable def sectionLiftTerm
    {P : FiniteTransportPresentation.{u}} {U : AtomCarrier.{u}}
    (data : TwoLayerTransportData.{u, v} P U)
    (edgeSection : EdgeSectionFamily data) (cell : P.TwoCell) :
    CompositeFiberAut (data.lift.geometry (P.twoTarget cell)) :=
  sectionCellComparator data edgeSection cell *
    (baselineUpperComparator data cell)⁻¹

/-- The raw inner factor `u * m⁻¹` before kernel restriction. -/
noncomputable def rawSectionInnerFactor
    {P : FiniteTransportPresentation.{u}} {U : AtomCarrier.{u}}
    (data : TwoLayerTransportData.{u, v} P U)
    (edgeSection : EdgeSectionFamily data) (cell : P.TwoCell) :
    CompositeFiberAut (data.lift.geometry (P.twoTarget cell)) :=
  data.comparator cell * (sectionCellComparator data edgeSection cell)⁻¹

/-- Alignment forces the raw inner factor into the kernel of `p`. -/
theorem rawSectionInnerFactor_pushforward_eq_one
    {P : FiniteTransportPresentation.{u}} {U : AtomCarrier.{u}}
    (data : TwoLayerTransportData.{u, v} P U)
    (edgeSection : EdgeSectionFamily data) (alignment : CoreAlignmentAt data edgeSection)
    (cell : P.TwoCell) :
    compositeFiberPushforward (data.lift.geometry (P.twoTarget cell))
        (rawSectionInnerFactor data edgeSection cell) = 1 := by
  rw [rawSectionInnerFactor, map_mul, map_inv,
    sectionCellComparator_pushforward_eq_authored data edgeSection alignment cell]
  exact mul_inv_cancel _

/-- Aligned inner obstruction as an actual element of `H_G`. -/
noncomputable def sectionInnerObstruction
    {P : FiniteTransportPresentation.{u}} {U : AtomCarrier.{u}}
    (data : TwoLayerTransportData.{u, v} P U)
    (edgeSection : EdgeSectionFamily data) (alignment : CoreAlignmentAt data edgeSection)
    (cell : P.TwoCell) :
    InnerFiberAut (data.lift.geometry (P.twoTarget cell)) :=
  innerFiberAutOfPushforwardEqOne
    (rawSectionInnerFactor data edgeSection cell)
    (rawSectionInnerFactor_pushforward_eq_one
      data edgeSection alignment cell)

/-- Inclusion of the inner obstruction recovers `u * m⁻¹`. -/
@[simp] theorem sectionInnerObstruction_inclusion
    {P : FiniteTransportPresentation.{u}} {U : AtomCarrier.{u}}
    (data : TwoLayerTransportData.{u, v} P U)
    (edgeSection : EdgeSectionFamily data) (alignment : CoreAlignmentAt data edgeSection)
    (cell : P.TwoCell) :
    innerFiberInclusion (data.lift.geometry (P.twoTarget cell))
        (sectionInnerObstruction data edgeSection alignment cell) =
      rawSectionInnerFactor data edgeSection cell :=
  rfl

/-- The edgeSection lift term projects to the interstage obstruction. -/
theorem sectionLiftTerm_projection
    {P : FiniteTransportPresentation.{u}} {U : AtomCarrier.{u}}
    (data : TwoLayerTransportData.{u, v} P U)
    (edgeSection : EdgeSectionFamily data) (alignment : CoreAlignmentAt data edgeSection)
    (cell : P.TwoCell) :
    compositeFiberPushforward (data.lift.geometry (P.twoTarget cell))
        (sectionLiftTerm data edgeSection cell) =
      interstageObstruction data cell := by
  rw [sectionLiftTerm, map_mul, map_inv,
    sectionCellComparator_pushforward_eq_authored data edgeSection alignment cell]
  exact totalObstruction_projection data cell

/-- Fixed-order kernel decomposition of the total obstruction. -/
theorem totalObstruction_kernel_decomposition
    {P : FiniteTransportPresentation.{u}} {U : AtomCarrier.{u}}
    (data : TwoLayerTransportData.{u, v} P U)
    (edgeSection : EdgeSectionFamily data) (alignment : CoreAlignmentAt data edgeSection)
    (cell : P.TwoCell) :
    totalObstruction data cell =
      innerFiberInclusion (data.lift.geometry (P.twoTarget cell))
          (sectionInnerObstruction data edgeSection alignment cell) *
        sectionLiftTerm data edgeSection cell := by
  rw [sectionInnerObstruction_inclusion]
  unfold totalObstruction rawSectionInnerFactor sectionLiftTerm
  simp [mul_assoc]

/-- Identity-edgeSection alignment is exactly core coherence at the identity coordinate. -/
theorem coreAlignmentAt_identity_iff
    {P : FiniteTransportPresentation.{u}} {U : AtomCarrier.{u}}
    (data : TwoLayerTransportData.{u, v} P U) :
    CoreAlignmentAt data (identityEdgeSection data) ↔
      CoherentAt data.coreData 1 := by
  rfl

end AAT.AG.CrossStageCoherence

#assert_standard_axioms_only AAT.AG.CrossStageCoherence
