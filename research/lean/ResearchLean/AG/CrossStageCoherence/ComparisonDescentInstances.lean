import ResearchLean.AG.CrossStageCoherence.ComparisonDescent
import ResearchLean.AG.CrossStageCoherence.CellChainInstances

/-!
# Finite instances for comparison descent

This module supplies the acceptance instances for theorem (C).  The positive
fixture has a genuinely nonidentity and noncentral canonical comparator
generated by a strongly cocartesian nonidentity edge lift.  Its three selected
signature axes retain adjacent-transposition `S₃` symmetry, so the canonical
twist acts nontrivially by conjugation.  The existing compatible-pair
refutation supplies the negative comparison-section instance.

## Implementation notes

The finite package reuses the reviewed four-axis core, actual context preorder,
nonzero polynomial relation, and identity restriction system.  Only the
coverage selects three axes instead of two, exposing a noncommutative stabilizer.
The canonical comparator is not stored in `TwoLayerTransportData`: it is proved
equal to the edge-lift automorphism from
`upperCanonicalTwoCellComparator_fac`.  Assigning an arbitrary authored
noncentral comparator without this generated equality was rejected.
-/

namespace AAT.AG.CrossStageCoherence

open CategoryTheory
open AtomFoundation
open GeometryTransport
open TransportCoherence

set_option maxHeartbeats 4000000

namespace NoncentralTwistWitness

open FiniteCrossStageWitness

/-! ## A nondegenerate three-selected-axis geometry -/

/-- The selected triple whose stabilizer contains the noncommutative group `S₃`. -/
def SelectedAxis (axis : Fin 4) : Prop := axis ≠ (3 : Fin 4)

/-- Coverage selects exactly the first three signature axes. -/
def requirements : Site.CoverageRequirements FiniteCrossStageWitness.core.object
    FiniteCrossStageWitness.core.equationSystem
    FiniteCrossStageWitness.core.algebra.signatureReading where
  requiredSupport := fun _ => False
  requiredEquationCoordinate := fun _ => False
  selectedViolationWitness := fun _ => False
  requiredAxis := fun axis => SelectedAxis axis
  supportVisibleOn := fun _ _ => True
  equationCoordinateVisibleOn := fun _ _ => True
  violationWitnessVisibleOn := fun _ _ => True
  axisReadableOn := fun _ axis => SelectedAxis axis
  boundaryVisibleOn := fun _ _ => True

/-- Selected finite geometry with an actual three-axis symmetry locus. -/
noncomputable def geometry :
    Site.SelectedGeometryReading FiniteCrossStageWitness.core where
  requirements := requirements
  overlap := Site.meetOverlapPullback
    FiniteCrossStageWitness.core.contextPreorder Site.productContextFiniteMeet

/-- The reviewed nonzero integral relation system on the unchanged finite site. -/
noncomputable def raw :
    LawAlgebra.RawAmbientRestrictionSystem geometry.toAATSite Int where
  coordFamily := FiniteCrossStageWitness.coordFamily
  relationFamily := FiniteCrossStageWitness.relationFamily
  restrictionStable := FiniteCrossStageWitness.restrictionStable
  identity_polynomialMap W :=
    FiniteCrossStageWitness.coordinateRestriction_polynomialMap (𝟙 W)
  composition_polynomialMap f g := by
    change (FiniteCrossStageWitness.coordinateRestriction (f ≫ g)).polynomialMap =
      ((FiniteCrossStageWitness.coordinateRestriction f).polynomialMap).comp
        ((FiniteCrossStageWitness.coordinateRestriction g).polynomialMap)
    rw [FiniteCrossStageWitness.coordinateRestriction_polynomialMap,
      FiniteCrossStageWitness.coordinateRestriction_polynomialMap,
      FiniteCrossStageWitness.coordinateRestriction_polynomialMap]
    exact (RingHom.id_comp _).symm

/-- Finite geometry package carrying the noncentral canonical twist. -/
noncomputable def package : GeometryPackage.{0, 0} FiniteModel.carrier where
  core := FiniteCrossStageWitness.core
  geometry := geometry
  Coefficient := Int
  coefficientCommRing := inferInstance
  raw := raw

/-- The selected site has an actual finite context. -/
theorem site_nonempty : Nonempty package.site.category :=
  ⟨⟨FiniteCrossStageWitness.baseContext⟩⟩

/-- The top sieve is an actual cover on the selected finite context. -/
theorem has_actual_cover :
    (⊤ : Sieve (⟨FiniteCrossStageWitness.baseContext⟩ : package.site.category)) ∈
      package.site.topology ⟨FiniteCrossStageWitness.baseContext⟩ :=
  package.site.top_mem _

/-- The fixture coefficient ring is nonzero. -/
theorem coefficient_nontrivial : (2 : package.Coefficient) ≠ 0 := by
  change (2 : Int) ≠ 0
  norm_num

/-- The inherited integral relation remains genuinely nonzero. -/
theorem raw_relation_nonzero :
    ((package.raw.relationFamily
      (⟨FiniteCrossStageWitness.baseContext⟩ : package.site.category)).polynomial ()) ≠ 0 := by
  change (MvPolynomial.X () ^ 2 - MvPolynomial.X () :
    MvPolynomial Unit Int) ≠ 0
  intro equality
  have evaluated := congrArg
    (MvPolynomial.eval₂Hom (RingHom.id Int) (fun _ : Unit => (2 : Int))) equality
  norm_num at evaluated

/-- Pure signature reindexing fixes the raw restriction system. -/
theorem rawReindex_corePermutation (permutation : Equiv.Perm (Fin 4))
    (system : LawAlgebra.RawAmbientRestrictionSystem package.site
      package.Coefficient) :
    rawReindex (G := package) (H := package)
      (FiniteCrossStageWitness.corePermutationTotal permutation) system = system := by
  apply LawAlgebra.RawAmbientRestrictionSystem.ext
  · rfl
  · rfl
  · rfl

/-- Compare dependent geometry homs after identifying their base maps. -/
theorem geometryHom_heq_of_base_eq
    {f g : PackageTotalHom package.core package.core}
    (F : GeomReadHom package package f)
    (T : GeomReadHom package package g)
    (baseEquality : f = g)
    (coefficientEquality : F.coefficientHom = T.coefficientHom)
    (supportEquality : HEq F.supportComp T.supportComp)
    (axisEquality : HEq F.axisComp T.axisComp)
    (observableEquality : HEq F.observableComp T.observableComp) :
    HEq F T := by
  cases baseEquality
  exact heq_of_eq (GeomReadHom.ext coefficientEquality supportEquality
    axisEquality observableEquality)

/-- Every selected-triple-preserving axis permutation lifts to geometry. -/
noncomputable def geometryPermutationHom
    (permutation : Equiv.Perm (Fin 4))
    (preservesSelected : ∀ axis, SelectedAxis axis →
      SelectedAxis (permutation axis)) :
    GeomReadHom package package
      (FiniteCrossStageWitness.corePermutationTotal permutation) where
  coverage := {
    requiredSupport := fun _ h => False.elim h
    requiredEquationCoordinate := fun _ h => False.elim h
    selectedViolationWitness := fun _ h => False.elim h
    requiredAxis := preservesSelected
    supportVisibleOn := fun _ _ _ => trivial
    equationCoordinateVisibleOn := fun _ _ _ => trivial
    violationWitnessVisibleOn := fun _ _ _ => trivial
    axisReadableOn := fun _ axis readable => preservesSelected axis readable
    boundaryVisibleOn := fun _ _ _ => trivial }
  overlap := { overlapIso := fun _ _ _ => Iso.refl _ }
  coefficientHom := RingHom.id package.Coefficient
  raw_eq := by
    unfold rawTransport
    rw [LawAlgebra.RawAmbientRestrictionSystem.baseChange_id]
    exact (rawReindex_corePermutation permutation package.raw).symm
  supportComp _ := _root_.id
  axisComp _ := _root_.id
  observableComp _ := _root_.id
  supportReads _ _ _ h := h
  axisReads _ _ h := h
  observableReads _ _ h := h
  support_naturality _ _ := rfl
  axis_naturality _ _ := rfl
  observable_naturality _ _ := rfl

/-! ## Two noncommuting composite-fiber automorphisms -/

/-- First adjacent transposition of the selected triple. -/
noncomputable def swap01 : Equiv.Perm (Fin 4) := Equiv.swap 0 1

/-- Second adjacent transposition of the selected triple. -/
noncomputable def swap12 : Equiv.Perm (Fin 4) := Equiv.swap 1 2

/-- The first adjacent transposition preserves selected coverage. -/
theorem swap01_preserves :
    ∀ axis, SelectedAxis axis → SelectedAxis (swap01 axis) := by
  intro axis selected
  fin_cases axis <;> simp_all [SelectedAxis, swap01]
  all_goals decide

/-- The second adjacent transposition preserves selected coverage. -/
theorem swap12_preserves :
    ∀ axis, SelectedAxis axis → SelectedAxis (swap12 axis) := by
  intro axis selected
  fin_cases axis <;> simp_all [SelectedAxis, swap12]
  all_goals decide

/-- Geometry lift of the first selected-axis transposition. -/
noncomputable def swap01Total : GeometryTotalHom package package where
  base := FiniteCrossStageWitness.corePermutationTotal swap01
  geometry := geometryPermutationHom swap01 swap01_preserves

/-- Geometry lift of the second selected-axis transposition. -/
noncomputable def swap12Total : GeometryTotalHom package package where
  base := FiniteCrossStageWitness.corePermutationTotal swap12
  geometry := geometryPermutationHom swap12 swap12_preserves

/-- The first adjacent transposition is involutive. -/
theorem swap01_square : swap01.trans swap01 = Equiv.refl (Fin 4) := by
  apply Equiv.ext
  intro axis
  fin_cases axis <;> rfl

/-- The second adjacent transposition is involutive. -/
theorem swap12_square : swap12.trans swap12 = Equiv.refl (Fin 4) := by
  apply Equiv.ext
  intro axis
  fin_cases axis <;> rfl

/-- The first geometry transposition squares to the identity. -/
theorem swap01Total_square :
    swap01Total.comp swap01Total = GeometryTotalHom.id package := by
  have baseSquare :
      (swap01Total.comp swap01Total).base =
        (GeometryTotalHom.id package).base := by
    change (FiniteCrossStageWitness.corePermutationTotal swap01).comp
        (FiniteCrossStageWitness.corePermutationTotal swap01) =
      PackageTotalHom.id FiniteCrossStageWitness.core
    rw [FiniteCrossStageWitness.corePermutationTotal_comp, swap01_square]
    exact FiniteCrossStageWitness.corePermutationTotal_refl
  apply GeometryTotalHom.ext
  · exact baseSquare
  · apply geometryHom_heq_of_base_eq _ _ baseSquare
    · exact RingHom.id_comp _
    · rfl
    · rfl
    · rfl

/-- The second geometry transposition squares to the identity. -/
theorem swap12Total_square :
    swap12Total.comp swap12Total = GeometryTotalHom.id package := by
  have baseSquare :
      (swap12Total.comp swap12Total).base =
        (GeometryTotalHom.id package).base := by
    change (FiniteCrossStageWitness.corePermutationTotal swap12).comp
        (FiniteCrossStageWitness.corePermutationTotal swap12) =
      PackageTotalHom.id FiniteCrossStageWitness.core
    rw [FiniteCrossStageWitness.corePermutationTotal_comp, swap12_square]
    exact FiniteCrossStageWitness.corePermutationTotal_refl
  apply GeometryTotalHom.ext
  · exact baseSquare
  · apply geometryHom_heq_of_base_eq _ _ baseSquare
    · exact RingHom.id_comp _
    · rfl
    · rfl
    · rfl

/-- First selected-axis transposition as a geometry automorphism. -/
noncomputable def swap01Iso : Aut package where
  hom := swap01Total
  inv := swap01Total
  hom_inv_id := swap01Total_square
  inv_hom_id := swap01Total_square

/-- Second selected-axis transposition as a geometry automorphism. -/
noncomputable def swap12Iso : Aut package where
  hom := swap12Total
  inv := swap12Total
  hom_inv_id := swap12Total_square
  inv_hom_id := swap12Total_square

/-- First transposition as an element of the composite fiber group `C_G`. -/
noncomputable def compositeSwap01 : CompositeFiberAut package :=
  ⟨swap01Iso, rfl⟩

/-- Second transposition as an element of the composite fiber group `C_G`. -/
noncomputable def compositeSwap12 : CompositeFiberAut package :=
  ⟨swap12Iso, rfl⟩

/-- The geometry edge lift itself is not the identity total hom. -/
theorem swap01Total_ne_id :
    swap01Total ≠ GeometryTotalHom.id package := by
  intro equality
  have axisEquality := congrArg
    (fun total : GeometryTotalHom package package =>
      total.base.upper.axisMap (0 : Fin 4)) equality
  change (1 : Fin 4) = 0 at axisEquality
  exact (by decide : (1 : Fin 4) ≠ 0) axisEquality

/-- The first selected-axis transposition is nonidentity. -/
theorem compositeSwap01_ne_one : compositeSwap01 ≠ 1 := by
  intro equality
  have axisEquality := congrArg
    (fun automorphism : CompositeFiberAut package =>
      (CompositeFiberAut.hom automorphism).base.upper.axisMap (0 : Fin 4))
    equality
  change (1 : Fin 4) = 0 at axisEquality
  exact (by decide : (1 : Fin 4) ≠ 0) axisEquality

/-- Adjacent selected-axis transpositions do not commute in `C_G`. -/
theorem compositeSwaps_do_not_commute :
    compositeSwap01 * compositeSwap12 ≠
      compositeSwap12 * compositeSwap01 := by
  intro equality
  have axisEquality := congrArg
    (fun automorphism : CompositeFiberAut package =>
      (CompositeFiberAut.hom automorphism).base.upper.axisMap (0 : Fin 4))
    equality
  change (1 : Fin 4) = 2 at axisEquality
  exact (by decide : (1 : Fin 4) ≠ 2) axisEquality

/-! ## One-cell presentation with an input-generated canonical twist -/

/-- The single nonidentity edge of the twist fixture. -/
inductive TwistEdge
  | twist
  deriving DecidableEq, Fintype

/-- The cell comparing the empty path with the nonidentity edge. -/
inductive TwistCell
  | comparison
  deriving DecidableEq, Fintype

/-- Empty path at the fixture vertex. -/
def nilPath : PresentedPath (fun _ _ : PUnit => TwistEdge)
    PUnit.unit PUnit.unit :=
  .nil PUnit.unit

/-- The one-edge path carrying the nonidentity strongly cocartesian lift. -/
def twistPath : PresentedPath (fun _ _ : PUnit => TwistEdge)
    PUnit.unit PUnit.unit :=
  .cons .twist (.nil PUnit.unit)

/-- Finite one-cell presentation used to generate the canonical comparator. -/
abbrev presentation : FiniteTransportPresentation where
  Vertex := PUnit
  vertexFintype := inferInstance
  Edge := fun _ _ => TwistEdge
  edgeFintype := fun _ _ => inferInstance
  TwoCell := TwistCell
  twoCellFintype := inferInstance
  twoSource := fun _ => PUnit.unit
  twoTarget := fun _ => PUnit.unit
  twoLeft := fun _ => nilPath
  twoRight := fun _ => twistPath
  ThreeCell := PEmpty
  threeCellFintype := inferInstance
  threeSource := fun cell => nomatch cell
  threeTarget := fun cell => nomatch cell
  threeStart := fun cell => nomatch cell
  threeFinish := fun cell => nomatch cell
  threeLeft := fun cell => nomatch cell
  threeRight := fun cell => nomatch cell

/-- The nonidentity geometry edge lift is strongly cocartesian. -/
theorem swap01_geometryStrong :
    (geometryProjection FiniteModel.carrier).IsStronglyCocartesian
      swap01Total.base swap01Total := by
  letI : (geometryProjection FiniteModel.carrier).IsHomLift
      swap01Total.base swap01Iso.hom := by
    change (geometryProjection FiniteModel.carrier).IsHomLift
      ((geometryProjection FiniteModel.carrier).map swap01Iso.hom)
      swap01Iso.hom
    infer_instance
  exact CategoryTheory.Functor.IsStronglyCocartesian.of_iso
    (geometryProjection FiniteModel.carrier) swap01Total.base swap01Iso

/-- Its projected core edge lift is independently strongly cocartesian. -/
theorem swap01_coreStrong :
    (packageProjection FiniteModel.carrier).IsStronglyCocartesian
      swap01Total.base.base swap01Total.base := by
  letI : (packageProjection FiniteModel.carrier).IsHomLift
      swap01Total.base.base
      (compositeFiberPushforward package compositeSwap01).1.hom := by
    change (packageProjection FiniteModel.carrier).IsHomLift
      ((packageProjection FiniteModel.carrier).map
        (compositeFiberPushforward package compositeSwap01).1.hom)
      (compositeFiberPushforward package compositeSwap01).1.hom
    infer_instance
  exact CategoryTheory.Functor.IsStronglyCocartesian.of_iso
    (packageProjection FiniteModel.carrier) swap01Total.base.base
      (compositeFiberPushforward package compositeSwap01).1

/-- Two-layer lift data whose unique edge is the nonidentity permutation lift. -/
noncomputable abbrev liftData :
    TwoLayerLiftData presentation FiniteModel.carrier where
  geometry _ := package
  edgeLift _ := swap01Total
  edgeGeometryStrong _ := swap01_geometryStrong
  edgeCoreStrong _ := swap01_coreStrong

/-- The presentation's unique edge uses the nonidentity geometry lift. -/
theorem edgeLift_twist_ne_id :
    liftData.edgeLift (i := PUnit.unit) (j := PUnit.unit) TwistEdge.twist ≠
      GeometryTotalHom.id package :=
  swap01Total_ne_id

/-- The empty path evaluates to the identity geometry lift. -/
theorem pathLift_nil :
    liftData.pathLift (presentation.twoLeft .comparison) =
      GeometryTotalHom.id package := by
  rfl

/-- The one-edge path evaluates to the first noncommuting automorphism. -/
theorem pathLift_twist :
    liftData.pathLift (presentation.twoRight .comparison) = swap01Total := by
  change swap01Total.comp (GeometryTotalHom.id package) = swap01Total
  exact @Category.comp_id
    (GeomReadCategory.{0, 0} FiniteModel.carrier)
    (geometryTotalCategory FiniteModel.carrier)
    package package swap01Total

/-- Authored data agrees with the generated nonidentity comparison on this fixture. -/
noncomputable abbrev data :
    TwoLayerTransportData presentation FiniteModel.carrier where
  lift := liftData
  twoCellBase := by
    intro cell
    change TwistCell at cell
    cases cell
    rw [pathLift_nil, pathLift_twist]
    rfl
  comparator _ := compositeSwap01

/-- The identity reselection leaves the empty path lift unchanged. -/
theorem upperPathLift_nil :
    upperReselectedPathLift liftData 1
        (presentation.twoLeft .comparison) =
      GeometryTotalHom.id package := by
  rfl

/-- The identity reselection retains the nonidentity twist path lift. -/
theorem upperPathLift_twist :
    upperReselectedPathLift liftData 1
        (presentation.twoRight .comparison) = swap01Total := by
  change (swap01Total.comp (CompositeFiberAut.hom 1)).comp
      (GeometryTotalHom.id package) = swap01Total
  change (swap01Total.comp (GeometryTotalHom.id package)).comp
      (GeometryTotalHom.id package) = swap01Total
  calc
    (swap01Total.comp (GeometryTotalHom.id package)).comp
        (GeometryTotalHom.id package) =
        swap01Total.comp (GeometryTotalHom.id package) :=
      @Category.comp_id
        (GeomReadCategory.{0, 0} FiniteModel.carrier)
        (geometryTotalCategory FiniteModel.carrier)
        package package (swap01Total.comp (GeometryTotalHom.id package))
    _ = swap01Total :=
      @Category.comp_id
        (GeomReadCategory.{0, 0} FiniteModel.carrier)
        (geometryTotalCategory FiniteModel.carrier)
        package package swap01Total

/-- The canonical comparator is generated from the nonidentity edge lift. -/
theorem canonicalComparator_eq_swap01 :
    upperCanonicalTwoCellComparator data 1 .comparison =
      compositeSwap01 := by
  let leftLift := upperReselectedPathLift liftData 1
    (presentation.twoLeft .comparison)
  letI : (crossStageProjection.{0, 0} FiniteModel.carrier).IsStronglyCocartesian
      leftLift.base.base leftLift :=
    (upperReselectLiftData liftData 1).pathLift_compositeStrong
      (presentation.twoLeft .comparison)
  apply CompositeFiberAut.ext_of_strong_fac leftLift
  calc
    leftLift.comp (CompositeFiberAut.hom
        (upperCanonicalTwoCellComparator data 1 .comparison)) =
        upperReselectedPathLift liftData 1
          (presentation.twoRight .comparison) :=
      upperCanonicalTwoCellComparator_fac data 1 .comparison
    _ = leftLift.comp (CompositeFiberAut.hom compositeSwap01) := by
      dsimp only [leftLift]
      rw [upperPathLift_nil, upperPathLift_twist]
      exact (@Category.id_comp
        (GeomReadCategory.{0, 0} FiniteModel.carrier)
        (geometryTotalCategory FiniteModel.carrier)
        package package swap01Total).symm

/-- The generated canonical comparator is nonidentity. -/
theorem canonicalComparator_ne_one :
    upperCanonicalTwoCellComparator data 1 .comparison ≠ 1 := by
  rw [canonicalComparator_eq_swap01]
  exact compositeSwap01_ne_one

/-- The generated canonical comparator is noncentral in the composite fiber. -/
theorem canonicalComparator_noncentral :
    upperCanonicalTwoCellComparator data 1 .comparison * compositeSwap12 ≠
      compositeSwap12 *
        upperCanonicalTwoCellComparator data 1 .comparison := by
  rw [canonicalComparator_eq_swap01]
  exact compositeSwaps_do_not_commute

/-- The authored comparator is coherently realized at identity reselection. -/
theorem coherentAt_identity : CrossStageCoherentAt data 1 := by
  intro cell
  cases cell
  have factorization :=
    upperCanonicalTwoCellComparator_fac data 1 .comparison
  rw [canonicalComparator_eq_swap01] at factorization
  exact factorization

/-- The finite noncentral-twist datum has an actual joint coherence gauge. -/
theorem jointVanishes : JointVanishes data :=
  (jointVanishes_iff_crossStageCoherentizable data).2
    ⟨1, coherentAt_identity⟩

/-- The canonical forward cell step of the finite twist presentation. -/
def forwardStep : CellChainStep presentation
    (CellChainNode.left presentation TwistCell.comparison)
    (CellChainNode.right presentation TwistCell.comparison) :=
  CellChainStep.forward TwistCell.comparison

/-- The canonical factor of the forward step is the generated transposition. -/
theorem canonicalFactor_eq_swap01 :
    cellCanonicalFactor data 1 forwardStep = compositeSwap01 := by
  exact canonicalComparator_eq_swap01

/-- The noncentral right factor makes the affine transition genuinely twisted. -/
theorem affine_twist_fires :
    CellAffineStep data forwardStep compositeSwap12 ≠ compositeSwap12 := by
  intro equality
  rw [cellAffineStep_apply, canonicalFactor_eq_swap01] at equality
  change compositeSwap01 * compositeSwap12 * compositeSwap01⁻¹ =
    compositeSwap12 at equality
  apply compositeSwaps_do_not_commute
  calc
    compositeSwap01 * compositeSwap12 =
        (compositeSwap01 * compositeSwap12 * compositeSwap01⁻¹) *
          compositeSwap01 := by group
    _ = compositeSwap12 * compositeSwap01 := by rw [equality]

/-- The positive noncentral fixture satisfies universal cell-chain coherence. -/
theorem cellChainCoherent : CellChainCoherent data :=
  jointVanishes_cellChainCoherent data jointVanishes

/-- Theorem (C) constructs an actual normalized comparison section on the fixture. -/
noncomputable def comparisonSection : CellComparisonSection data :=
  comparisonSectionOfCellChainCoherent data cellChainCoherent

/-- The comparison-section certificate is concretely inhabited. -/
theorem comparisonSection_nonempty :
    Nonempty (CellComparisonSection data) :=
  ⟨comparisonSection⟩

end NoncentralTwistWitness

/-! ## Acceptance instances -/

namespace QualityInstances

/-- The new selected-axis predicate has direct positive and negative instances. -/
theorem noncentralSelectedAxis_instances :
    NoncentralTwistWitness.SelectedAxis (0 : Fin 4) ∧
      ¬ NoncentralTwistWitness.SelectedAxis (3 : Fin 4) := by
  constructor
  · change (0 : Fin 4) ≠ 3
    decide
  · change ¬ ((3 : Fin 4) ≠ 3)
    simp

/-- Comparison-section certificates are inhabited and uninhabited on finite data. -/
theorem cellComparisonSection_instances :
    Nonempty (CellComparisonSection NoncentralTwistWitness.data) ∧
      ¬ Nonempty
        (CellComparisonSection CompatiblePairRefutation.data) := by
  refine ⟨NoncentralTwistWitness.comparisonSection_nonempty, ?_⟩
  intro comparison
  exact CellChainRefutation.not_cellChainCoherent
    ((cellChainCoherent_iff_nonempty_comparisonSection
      CompatiblePairRefutation.data).2 comparison)

end QualityInstances

end AAT.AG.CrossStageCoherence

#assert_standard_axioms_only AAT.AG.CrossStageCoherence
