import ResearchLean.AG.CrossStageCoherence.Basic

/-!
# Fiber transport along pointed doctrine morphisms

This module constructs the G-109 transport functor between the geometry fibers
over an arbitrary `ExtInstHom`.  Its object map is the G-108 canonical geometry
transport.  Its morphism map is generated by the composite strong
cocartesian universal property from `Basic`, so no vertical action or functor
law is accepted as input.

## Implementation notes

An object of Mathlib's `Functor.Fiber` projects to its base only up to an
equality.  The lift therefore starts with the equality-induced pointed map and
then composes with the authored `ExtInstHom`.  This uses `source_eq` to identify
the canonical target with the selected target point.  Replacing the authored
pointed morphism by its `ExactDoctrineHom` alone was rejected because that
would lose the selected target required by the fixed G-109 statement.
-/

namespace AAT.AG.CrossStageCoherence

universe u v

open CategoryTheory
open AtomFoundation
open GeometryTransport

set_option maxHeartbeats 1000000

/-- The geometry fiber over a pointed extraction doctrine. -/
abbrev GeomFiber {U : AtomCarrier.{u}} (X : ExtractionInstance U) :=
  (crossStageProjection.{u, v} U).Fiber X

/-- The base arrow used to transport a geometry-fiber object along `σ`. -/
noncomputable def geomFiberBaseHom {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (σ : X ⟶ Y)
    (G : GeomFiber.{u, v} X) :
    (crossStageProjection.{u, v} U).obj G.1 ⟶ Y :=
  eqToHom G.2 ≫ σ

/-- The underlying canonical geometry object transported along a pointed arrow. -/
noncomputable def geomFiberTransportObject {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (σ : X ⟶ Y)
    (G : GeomFiber.{u, v} X) : GeomReadCategory.{u, v} U :=
  geomTransportAlong G.1 (geomFiberBaseHom σ G).doctrineHom

/--
The transported object projects to the authored target point.

The doctrine component is computed by canonical transport and the source
component is exactly `geomFiberBaseHom.source_eq`, which contains
`σ.source_eq` through pointed composition.
-/
theorem geomFiberTransportObject_point {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (σ : X ⟶ Y)
    (G : GeomFiber.{u, v} X) :
    (crossStageProjection.{u, v} U).obj
      (geomFiberTransportObject σ G) = Y := by
  apply ExtractionInstance.ext
  · rfl
  · apply heq_of_eq
    exact (geomFiberBaseHom σ G).source_eq

/-- The transported object, placed in the target geometry fiber. -/
noncomputable def geomFiberTransportObj {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (σ : X ⟶ Y)
    (G : GeomFiber.{u, v} X) : GeomFiber.{u, v} Y :=
  ⟨geomFiberTransportObject σ G, geomFiberTransportObject_point σ G⟩

/-- The canonical geometry lift used to generate the fiber transport. -/
noncomputable def geomFiberLift {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (σ : X ⟶ Y)
    (G : GeomFiber.{u, v} X) :
    G.1 ⟶ (geomFiberTransportObj σ G).1 :=
  geomTransportAlongHom G.1 (geomFiberBaseHom σ G).doctrineHom

/-- The canonical lift projects to the authored pointed arrow, with fiber casts. -/
theorem geomFiberLift_projection {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (σ : X ⟶ Y)
    (G : GeomFiber.{u, v} X) :
    (crossStageProjection.{u, v} U).map (geomFiberLift σ G) ≫
        eqToHom (geomFiberTransportObj σ G).2 =
      eqToHom G.2 ≫ σ := by
  apply ExtInstHom.ext
  change (extInstToDoctrine U).map
      ((crossStageProjection U).map (geomFiberLift σ G) ≫
        eqToHom (geomFiberTransportObj σ G).2) =
    (extInstToDoctrine U).map (eqToHom G.2 ≫ σ)
  rw [Functor.map_comp, Functor.map_comp, eqToHom_map, eqToHom_map]
  simp [geomFiberLift, geomFiberTransportObj, geomFiberTransportObject,
    geomFiberBaseHom, crossStageProjection, extInstToDoctrine]
  have hlift :
      (transportAlongHom G.1.core
        (eqToHom G.2 ≫ σ).doctrineHom).base.doctrineHom =
        (eqToHom G.2 ≫ σ).doctrineHom := rfl
  rw [hlift]
  rw [← eqToHom_map (extInstToDoctrine U) G.2]
  rfl

/-- The canonical geometry lift is a lift of the actual `ExtInstHom` `σ`. -/
theorem geomFiberLift_isHomLift {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (σ : X ⟶ Y)
    (G : GeomFiber.{u, v} X) :
    (crossStageProjection.{u, v} U).IsHomLift σ (geomFiberLift σ G) := by
  exact CategoryTheory.IsHomLift.of_commsq
    (crossStageProjection.{u, v} U) σ (geomFiberLift σ G)
    G.2 (geomFiberTransportObj σ G).2 (geomFiberLift_projection σ G)

/--
The canonical lift is strongly cocartesian over the authored `ExtInstHom`.

This is a reindexing of the composite certificate proved in `Basic`; the
certificate itself is still generated from the G-108 and G-101 universal
properties.
-/
theorem geomFiberLift_isStronglyCocartesian {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (σ : X ⟶ Y)
    (G : GeomFiber.{u, v} X) :
    (crossStageProjection.{u, v} U).IsStronglyCocartesian
      σ (geomFiberLift σ G) := by
  letI : (crossStageProjection.{u, v} U).IsStronglyCocartesian
      ((crossStageProjection.{u, v} U).map (geomFiberLift σ G))
      (geomFiberLift σ G) :=
    geomTransportAlongHom_isCrossStageStronglyCocartesian
      G.1 (geomFiberBaseHom σ G).doctrineHom
  letI : (crossStageProjection.{u, v} U).IsHomLift
      σ (geomFiberLift σ G) := geomFiberLift_isHomLift σ G
  exact stronglyCocartesian_of_isHomLift
    (crossStageProjection.{u, v} U) σ (geomFiberLift σ G)

/--
Transport a vertical geometry morphism by the composite opcartesian universal
property.
-/
noncomputable def geomFiberTransportMap {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (σ : X ⟶ Y)
    {G H : GeomFiber.{u, v} X} (f : G ⟶ H) :
    geomFiberTransportObj σ G ⟶ geomFiberTransportObj σ H := by
  letI : (crossStageProjection.{u, v} U).IsStronglyCocartesian
      σ (geomFiberLift σ G) := geomFiberLift_isStronglyCocartesian σ G
  letI : (crossStageProjection.{u, v} U).IsHomLift
      (𝟙 X) f.1 := f.2
  letI : (crossStageProjection.{u, v} U).IsHomLift
      σ (geomFiberLift σ H) := geomFiberLift_isHomLift σ H
  letI : (crossStageProjection.{u, v} U).IsHomLift
      σ (f.1 ≫ geomFiberLift σ H) := by
    simpa using inferInstanceAs
      ((crossStageProjection.{u, v} U).IsHomLift
        ((𝟙 X) ≫ σ) (f.1 ≫ geomFiberLift σ H))
  exact ⟨CategoryTheory.Functor.IsStronglyCocartesian.map
      (crossStageProjection.{u, v} U) σ (geomFiberLift σ G)
      (g := 𝟙 Y) (f' := σ) (Category.comp_id σ).symm
      (f.1 ≫ geomFiberLift σ H), inferInstance⟩

/-- The generated vertical map satisfies its defining factorization equation. -/
theorem geomFiberTransportMap_fac {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (σ : X ⟶ Y)
    {G H : GeomFiber.{u, v} X} (f : G ⟶ H) :
    geomFiberLift σ G ≫ (geomFiberTransportMap σ f).1 =
      f.1 ≫ geomFiberLift σ H := by
  letI : (crossStageProjection.{u, v} U).IsStronglyCocartesian
      σ (geomFiberLift σ G) := geomFiberLift_isStronglyCocartesian σ G
  letI : (crossStageProjection.{u, v} U).IsHomLift
      (𝟙 X) f.1 := f.2
  letI : (crossStageProjection.{u, v} U).IsHomLift
      σ (geomFiberLift σ H) := geomFiberLift_isHomLift σ H
  letI : (crossStageProjection.{u, v} U).IsHomLift
      σ (f.1 ≫ geomFiberLift σ H) := by
    simpa using inferInstanceAs
      ((crossStageProjection.{u, v} U).IsHomLift
        ((𝟙 X) ≫ σ) (f.1 ≫ geomFiberLift σ H))
  exact CategoryTheory.Functor.IsStronglyCocartesian.fac
    (crossStageProjection.{u, v} U) σ (geomFiberLift σ G)
    (Category.comp_id σ).symm (f.1 ≫ geomFiberLift σ H)

/-- Transporting a vertical identity gives the target-fiber identity. -/
theorem geomFiberTransportMap_id {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (σ : X ⟶ Y)
    (G : GeomFiber.{u, v} X) :
    geomFiberTransportMap σ (𝟙 G) = 𝟙 (geomFiberTransportObj σ G) := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  letI : (crossStageProjection.{u, v} U).IsStronglyCocartesian
      σ (geomFiberLift σ G) := geomFiberLift_isStronglyCocartesian σ G
  apply CategoryTheory.Functor.IsStronglyCocartesian.ext
    (crossStageProjection.{u, v} U) σ (geomFiberLift σ G) (𝟙 Y)
  simpa using geomFiberTransportMap_fac σ (𝟙 G)

/-- Transport preserves composition of vertical geometry morphisms. -/
theorem geomFiberTransportMap_comp {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (σ : X ⟶ Y)
    {G H K : GeomFiber.{u, v} X} (f : G ⟶ H) (g : H ⟶ K) :
    geomFiberTransportMap σ (f ≫ g) =
      geomFiberTransportMap σ f ≫ geomFiberTransportMap σ g := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  letI : (crossStageProjection.{u, v} U).IsStronglyCocartesian
      σ (geomFiberLift σ G) := geomFiberLift_isStronglyCocartesian σ G
  apply CategoryTheory.Functor.IsStronglyCocartesian.ext
    (crossStageProjection.{u, v} U) σ (geomFiberLift σ G) (𝟙 Y)
  change geomFiberLift σ G ≫ (geomFiberTransportMap σ (f ≫ g)).1 =
    geomFiberLift σ G ≫
      ((geomFiberTransportMap σ f).1 ≫ (geomFiberTransportMap σ g).1)
  calc
    _ = (f ≫ g).1 ≫ geomFiberLift σ K :=
      geomFiberTransportMap_fac σ (f ≫ g)
    _ = f.1 ≫ (g.1 ≫ geomFiberLift σ K) := Category.assoc _ _ _
    _ = f.1 ≫ (geomFiberLift σ H ≫ (geomFiberTransportMap σ g).1) :=
      congrArg (fun h => f.1 ≫ h) (geomFiberTransportMap_fac σ g).symm
    _ = (f.1 ≫ geomFiberLift σ H) ≫ (geomFiberTransportMap σ g).1 :=
      (Category.assoc _ _ _).symm
    _ = (geomFiberLift σ G ≫ (geomFiberTransportMap σ f).1) ≫
        (geomFiberTransportMap σ g).1 :=
      congrArg (fun h => h ≫ (geomFiberTransportMap σ g).1)
        (geomFiberTransportMap_fac σ f).symm
    _ = _ := Category.assoc _ _ _

/-- The G-109 transport functor between geometry fibers over an `ExtInstHom`. -/
noncomputable def geomFiberTransportFunctor {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (σ : X ⟶ Y) :
    GeomFiber.{u, v} X ⥤ GeomFiber.{u, v} Y where
  obj := geomFiberTransportObj σ
  map := geomFiberTransportMap σ
  map_id := geomFiberTransportMap_id σ
  map_comp := geomFiberTransportMap_comp σ

/-- A geometry package as the canonical object of its own composite fiber. -/
def geomFiberMk {U : AtomCarrier.{u}} (G : GeometryPackage.{u, v} U) :
    GeomFiber.{u, v} (packagePoint G.core) :=
  ⟨G, rfl⟩

/--
Transport along an `ExtInstHom` agrees on canonical fiber representatives with
G-108 transport along its underlying exact doctrine morphism.
-/
@[simp] theorem geomFiberTransportFunctor_obj_mk {U : AtomCarrier.{u}}
    (G : GeometryPackage.{u, v} U) {Y : ExtractionInstance U}
    (σ : packagePoint G.core ⟶ Y) :
    ((geomFiberTransportFunctor.{u, v} σ).obj (geomFiberMk G)).1 =
      geomTransportAlong G σ.doctrineHom :=
  rfl

/-- The canonical target comparison uses the selected-source equation of `σ`. -/
theorem geomTransportAlong_extInst_point {U : AtomCarrier.{u}}
    (G : GeometryPackage.{u, v} U) {Y : ExtractionInstance U}
    (σ : packagePoint G.core ⟶ Y) :
    (crossStageProjection.{u, v} U).obj
      (geomTransportAlong G σ.doctrineHom) = Y := by
  apply ExtractionInstance.ext
  · rfl
  · apply heq_of_eq
    exact σ.source_eq

end AAT.AG.CrossStageCoherence

#assert_standard_axioms_only AAT.AG.CrossStageCoherence
