import ResearchLean.AG.FullGeometryNormalization.ExactGeometryPull
import ResearchLean.AG.DoctrineFiberProduct.CartesianRegimeReindexingCoherence

/-!
# Typed coherence for exact complete-geometry pullback

Identity and composition comparisons for the exact complete-geometry pullback
are generated here solely from strongly Cartesian uniqueness.  Base arrows
come from typed finite presentations; callers provide no comparison, equality
between pullback objects, or Cartesian certificate.
-/

namespace AAT.AG.FullGeometryNormalization

universe u v u₁ u₂ v₁ v₂

open CategoryTheory AtomFoundation GeometryTransport CrossStageCoherence
open DoctrineFiberProduct

set_option maxHeartbeats 3000000

/-- Exact complete-geometry pullback along a typed finite presentation. -/
noncomputable def exactTypedGeometryPullFunctor
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target) :
    GeomFiber.{u, v} target.toSemantic ⥤ GeomFiber.{u, v} source.toSemantic :=
  exactGeometryPullFunctor (typedRealizableHom presentation)

/-- The complete lift selected by the exact typed pullback. -/
noncomputable def exactTypedGeometryPullLift
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target)
    (G : GeomFiber.{u, v} target.toSemantic) :
    ((exactTypedGeometryPullFunctor presentation).obj G).1 ⟶ G.1 :=
  exactGeometryPullLift (typedRealizableHom presentation) G

/-- The typed complete lift is strongly Cartesian over its decoded arrow. -/
theorem exactTypedGeometryPullLift_isStronglyCartesian
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target)
    (G : GeomFiber.{u, v} target.toSemantic) :
    (crossStageProjection.{u, v} U).IsStronglyCartesian
      (typedCartSemanticInput presentation).hom
      (exactTypedGeometryPullLift presentation G) :=
  exactGeometryPullLift_crossStageStronglyCartesian
    (typedRealizableHom presentation) G

/-- The typed pullback map satisfies its defining complete-geometry triangle. -/
theorem exactTypedGeometryPullFunctor_map_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target)
    {G H : GeomFiber.{u, v} target.toSemantic} (f : G ⟶ H) :
    ((exactTypedGeometryPullFunctor presentation).map f).1 ≫
        exactTypedGeometryPullLift presentation H =
      exactTypedGeometryPullLift presentation G ≫ f.1 :=
  exactGeometryPullMap_fac (typedRealizableHom presentation) f

/-- The unique vertical comparison from the domain of `second` to that of
`first`, generated by their common strongly Cartesian property. -/
private noncomputable def exactStrongCartesianComparisonHom
    {Base : Type u₁} {Total : Type u₂}
    [Category.{v₁} Base] [Category.{v₂} Total]
    (p : Total ⥤ Base) {X Y : Base} {A B : p.Fiber X} {T : Total}
    (f : X ⟶ Y) (first : A.1 ⟶ T) (second : B.1 ⟶ T)
    [p.IsStronglyCartesian f first] [p.IsStronglyCartesian f second] : B ⟶ A := by
  refine ⟨CategoryTheory.Functor.IsStronglyCartesian.map p f first
    (g := 𝟙 X) (f' := f) (Category.id_comp f).symm second, ?_⟩
  infer_instance

/-- The generated vertical comparison followed by `first` is `second`. -/
private theorem exactStrongCartesianComparisonHom_fac
    {Base : Type u₁} {Total : Type u₂}
    [Category.{v₁} Base] [Category.{v₂} Total]
    (p : Total ⥤ Base) {X Y : Base} {A B : p.Fiber X} {T : Total}
    (f : X ⟶ Y) (first : A.1 ⟶ T) (second : B.1 ⟶ T)
    [p.IsStronglyCartesian f first] [p.IsStronglyCartesian f second] :
    (exactStrongCartesianComparisonHom p f first second).1 ≫ first = second :=
  CategoryTheory.Functor.IsStronglyCartesian.fac p f first
    (Category.id_comp f).symm second

/-- Two strongly Cartesian complete lifts over one arrow have canonically
isomorphic domains. -/
private noncomputable def exactStrongCartesianComparisonIso
    {Base : Type u₁} {Total : Type u₂}
    [Category.{v₁} Base] [Category.{v₂} Total]
    (p : Total ⥤ Base) {X Y : Base} {A B : p.Fiber X} {T : Total}
    (f : X ⟶ Y) (first : A.1 ⟶ T) (second : B.1 ⟶ T)
    [p.IsStronglyCartesian f first] [p.IsStronglyCartesian f second] : B ≅ A where
  hom := exactStrongCartesianComparisonHom p f first second
  inv := exactStrongCartesianComparisonHom p f second first
  hom_inv_id := by
    apply CategoryTheory.Functor.Fiber.hom_ext
    apply CategoryTheory.Functor.IsStronglyCartesian.ext p f second (𝟙 X)
    change ((exactStrongCartesianComparisonHom p f first second).1 ≫
      (exactStrongCartesianComparisonHom p f second first).1) ≫ second =
        𝟙 B.1 ≫ second
    rw [Category.assoc, exactStrongCartesianComparisonHom_fac,
      exactStrongCartesianComparisonHom_fac]
    simp
  inv_hom_id := by
    apply CategoryTheory.Functor.Fiber.hom_ext
    apply CategoryTheory.Functor.IsStronglyCartesian.ext p f first (𝟙 X)
    change ((exactStrongCartesianComparisonHom p f second first).1 ≫
      (exactStrongCartesianComparisonHom p f first second).1) ≫ first =
        𝟙 A.1 ≫ first
    rw [Category.assoc, exactStrongCartesianComparisonHom_fac,
      exactStrongCartesianComparisonHom_fac]
    simp

/-- The literal two-step exact complete-geometry lift. -/
noncomputable def exactTypedGeometryPullIteratedLift
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (first : CartPresentationBetween source middle)
    (second : CartPresentationBetween middle target)
    (G : GeomFiber.{u, v} target.toSemantic) :
    ((exactTypedGeometryPullFunctor first).obj
      ((exactTypedGeometryPullFunctor second).obj G)).1 ⟶ G.1 :=
  exactTypedGeometryPullLift first
      ((exactTypedGeometryPullFunctor second).obj G) ≫
    exactTypedGeometryPullLift second G

/-- The two-step lift is strongly Cartesian over the decoded composite. -/
theorem exactTypedGeometryPullIteratedLift_isStronglyCartesian
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (first : CartPresentationBetween source middle)
    (second : CartPresentationBetween middle target)
    (G : GeomFiber.{u, v} target.toSemantic) :
    (crossStageProjection.{u, v} U).IsStronglyCartesian
      ((typedCartSemanticInput first).hom ≫
        (typedCartSemanticInput second).hom)
      (exactTypedGeometryPullIteratedLift first second G) := by
  letI := exactTypedGeometryPullLift_isStronglyCartesian first
    ((exactTypedGeometryPullFunctor second).obj G)
  letI := exactTypedGeometryPullLift_isStronglyCartesian second G
  exact CategoryTheory.Functor.IsStronglyCartesian.comp
    (crossStageProjection.{u, v} U)

/-- The contravariant compositor component generated by direct-versus-iterated
strongly Cartesian uniqueness. -/
noncomputable def exactTypedGeometryPullCompositorApp
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (first : CartPresentationBetween source middle)
    (second : CartPresentationBetween middle target)
    (G : GeomFiber.{u, v} target.toSemantic) :
    (exactTypedGeometryPullFunctor second ⋙
      exactTypedGeometryPullFunctor first).obj G ≅
        (exactTypedGeometryPullFunctor (compPresentation first second)).obj G := by
  let direct := exactTypedGeometryPullLift (compPresentation first second) G
  let iterated := exactTypedGeometryPullIteratedLift first second G
  letI : (crossStageProjection.{u, v} U).IsStronglyCartesian
      ((typedCartSemanticInput first).hom ≫
        (typedCartSemanticInput second).hom) direct := by
    have hcomp :
        (typedCartSemanticInput (compPresentation first second)).hom =
          (typedCartSemanticInput first).hom ≫
            (typedCartSemanticInput second).hom :=
      typedRealizableHom_comp_hom first second
    rw [← hcomp]
    exact exactTypedGeometryPullLift_isStronglyCartesian
      (compPresentation first second) G
  letI := exactTypedGeometryPullIteratedLift_isStronglyCartesian first second G
  exact exactStrongCartesianComparisonIso (crossStageProjection.{u, v} U)
    ((typedCartSemanticInput first).hom ≫
      (typedCartSemanticInput second).hom) direct iterated

/-- The compositor followed by the direct lift is the two-step lift. -/
theorem exactTypedGeometryPullCompositorApp_hom_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (first : CartPresentationBetween source middle)
    (second : CartPresentationBetween middle target)
    (G : GeomFiber.{u, v} target.toSemantic) :
    (exactTypedGeometryPullCompositorApp first second G).hom.1 ≫
        exactTypedGeometryPullLift (compPresentation first second) G =
      exactTypedGeometryPullIteratedLift first second G := by
  letI : (crossStageProjection.{u, v} U).IsStronglyCartesian
      ((typedCartSemanticInput first).hom ≫
        (typedCartSemanticInput second).hom)
      (exactTypedGeometryPullLift (compPresentation first second) G) := by
    have hcomp :
        (typedCartSemanticInput (compPresentation first second)).hom =
          (typedCartSemanticInput first).hom ≫
            (typedCartSemanticInput second).hom :=
      typedRealizableHom_comp_hom first second
    rw [← hcomp]
    exact exactTypedGeometryPullLift_isStronglyCartesian
      (compPresentation first second) G
  letI := exactTypedGeometryPullIteratedLift_isStronglyCartesian first second G
  exact exactStrongCartesianComparisonHom_fac (crossStageProjection.{u, v} U)
    ((typedCartSemanticInput first).hom ≫
      (typedCartSemanticInput second).hom)
    (exactTypedGeometryPullLift (compPresentation first second) G)
    (exactTypedGeometryPullIteratedLift first second G)

/-- The compositor is natural on vertical complete-geometry morphisms. -/
theorem exactTypedGeometryPullCompositor_naturality
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (first : CartPresentationBetween source middle)
    (second : CartPresentationBetween middle target)
    {G H : GeomFiber.{u, v} target.toSemantic} (f : G ⟶ H) :
    (exactTypedGeometryPullFunctor second ⋙
      exactTypedGeometryPullFunctor first).map f ≫
        (exactTypedGeometryPullCompositorApp first second H).hom =
      (exactTypedGeometryPullCompositorApp first second G).hom ≫
        (exactTypedGeometryPullFunctor (compPresentation first second)).map f := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let directTarget := exactTypedGeometryPullLift (compPresentation first second) H
  letI : (crossStageProjection.{u, v} U).IsStronglyCartesian
      ((typedCartSemanticInput first).hom ≫
        (typedCartSemanticInput second).hom) directTarget := by
    have hcomp :
        (typedCartSemanticInput (compPresentation first second)).hom =
          (typedCartSemanticInput first).hom ≫
            (typedCartSemanticInput second).hom :=
      typedRealizableHom_comp_hom first second
    rw [← hcomp]
    exact exactTypedGeometryPullLift_isStronglyCartesian
      (compPresentation first second) H
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (crossStageProjection.{u, v} U)
    ((typedCartSemanticInput first).hom ≫
      (typedCartSemanticInput second).hom) directTarget (𝟙 source.toSemantic)
  change ((((exactTypedGeometryPullFunctor second ⋙
      exactTypedGeometryPullFunctor first).map f).1 ≫
      (exactTypedGeometryPullCompositorApp first second H).hom.1) ≫
        directTarget) =
    (((exactTypedGeometryPullCompositorApp first second G).hom.1 ≫
      ((exactTypedGeometryPullFunctor
        (compPresentation first second)).map f).1) ≫ directTarget)
  calc
    _ = ((exactTypedGeometryPullFunctor second ⋙
          exactTypedGeometryPullFunctor first).map f).1 ≫
        ((exactTypedGeometryPullCompositorApp first second H).hom.1 ≫
          directTarget) := Category.assoc _ _ _
    _ = ((exactTypedGeometryPullFunctor second ⋙
          exactTypedGeometryPullFunctor first).map f).1 ≫
        exactTypedGeometryPullIteratedLift first second H := by
      rw [exactTypedGeometryPullCompositorApp_hom_fac]
    _ = exactTypedGeometryPullIteratedLift first second G ≫ f.1 := by
      change ((exactTypedGeometryPullFunctor first).map
        ((exactTypedGeometryPullFunctor second).map f)).1 ≫
          (exactTypedGeometryPullLift first
            ((exactTypedGeometryPullFunctor second).obj H) ≫
            exactTypedGeometryPullLift second H) = _
      rw [← Category.assoc, exactTypedGeometryPullFunctor_map_fac,
        Category.assoc, exactTypedGeometryPullFunctor_map_fac,
        ← Category.assoc]
      rfl
    _ = ((exactTypedGeometryPullCompositorApp first second G).hom.1 ≫
        exactTypedGeometryPullLift (compPresentation first second) G) ≫ f.1 := by
      rw [exactTypedGeometryPullCompositorApp_hom_fac]
    _ = (exactTypedGeometryPullCompositorApp first second G).hom.1 ≫
        (exactTypedGeometryPullLift (compPresentation first second) G ≫ f.1) :=
      Category.assoc _ _ _
    _ = (exactTypedGeometryPullCompositorApp first second G).hom.1 ≫
        (((exactTypedGeometryPullFunctor
          (compPresentation first second)).map f).1 ≫ directTarget) := by
      rw [exactTypedGeometryPullFunctor_map_fac]
    _ = _ := (Category.assoc _ _ _).symm

/-- The natural contravariant compositor for typed exact pullback. -/
noncomputable def exactTypedGeometryPullCompositor
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (first : CartPresentationBetween source middle)
    (second : CartPresentationBetween middle target) :
    exactTypedGeometryPullFunctor.{u, v} second ⋙
      exactTypedGeometryPullFunctor.{u, v} first ≅
        exactTypedGeometryPullFunctor.{u, v} (compPresentation first second) :=
  NatIso.ofComponents (exactTypedGeometryPullCompositorApp first second)
    (fun f => exactTypedGeometryPullCompositor_naturality first second f)

/-- The literal identity complete-geometry lift. -/
noncomputable def exactTypedGeometryPullIdentityLift
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U)
    (G : GeomFiber.{u, v} instanceCode.toSemantic) : G.1 ⟶ G.1 := 𝟙 G.1

/-- The literal identity lift is strongly Cartesian over identity. -/
theorem exactTypedGeometryPullIdentityLift_isStronglyCartesian
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U)
    (G : GeomFiber.{u, v} instanceCode.toSemantic) :
    (crossStageProjection.{u, v} U).IsStronglyCartesian
      (𝟙 instanceCode.toSemantic)
      (exactTypedGeometryPullIdentityLift instanceCode G) := by
  letI : (crossStageProjection.{u, v} U).IsHomLift
      (𝟙 instanceCode.toSemantic) (𝟙 G.1) :=
    CategoryTheory.IsHomLift.id G.2
  letI : IsIso (𝟙 G.1) := by infer_instance
  exact CategoryTheory.Functor.IsStronglyCartesian.of_isIso
    (crossStageProjection.{u, v} U) (𝟙 instanceCode.toSemantic) (𝟙 G.1)

/-- The exact unitor component generated by identity-versus-selected
strongly Cartesian uniqueness. -/
noncomputable def exactTypedGeometryPullUnitorApp
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U)
    (G : GeomFiber.{u, v} instanceCode.toSemantic) :
    G ≅ (exactTypedGeometryPullFunctor
      (idTypedPresentation instanceCode)).obj G := by
  let direct := exactTypedGeometryPullLift (idTypedPresentation instanceCode) G
  let identity := exactTypedGeometryPullIdentityLift instanceCode G
  letI : (crossStageProjection.{u, v} U).IsStronglyCartesian
      (𝟙 instanceCode.toSemantic) direct := by
    rw [← typedRealizableHom_id_hom instanceCode]
    exact exactTypedGeometryPullLift_isStronglyCartesian
      (idTypedPresentation instanceCode) G
  letI := exactTypedGeometryPullIdentityLift_isStronglyCartesian instanceCode G
  exact exactStrongCartesianComparisonIso (crossStageProjection.{u, v} U)
    (𝟙 instanceCode.toSemantic) direct identity

/-- The unitor followed by the selected identity lift is literal identity. -/
theorem exactTypedGeometryPullUnitorApp_hom_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U)
    (G : GeomFiber.{u, v} instanceCode.toSemantic) :
    (exactTypedGeometryPullUnitorApp instanceCode G).hom.1 ≫
        exactTypedGeometryPullLift (idTypedPresentation instanceCode) G = 𝟙 G.1 := by
  letI : (crossStageProjection.{u, v} U).IsStronglyCartesian
      (𝟙 instanceCode.toSemantic)
      (exactTypedGeometryPullLift (idTypedPresentation instanceCode) G) := by
    rw [← typedRealizableHom_id_hom instanceCode]
    exact exactTypedGeometryPullLift_isStronglyCartesian
      (idTypedPresentation instanceCode) G
  letI := exactTypedGeometryPullIdentityLift_isStronglyCartesian instanceCode G
  exact exactStrongCartesianComparisonHom_fac (crossStageProjection.{u, v} U)
    (𝟙 instanceCode.toSemantic)
    (exactTypedGeometryPullLift (idTypedPresentation instanceCode) G)
    (exactTypedGeometryPullIdentityLift instanceCode G)

/-- The exact unitor is natural on vertical complete-geometry maps. -/
theorem exactTypedGeometryPullUnitor_naturality
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U)
    {G H : GeomFiber.{u, v} instanceCode.toSemantic} (f : G ⟶ H) :
    f ≫ (exactTypedGeometryPullUnitorApp instanceCode H).hom =
      (exactTypedGeometryPullUnitorApp instanceCode G).hom ≫
        (exactTypedGeometryPullFunctor (idTypedPresentation instanceCode)).map f := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let directTarget := exactTypedGeometryPullLift (idTypedPresentation instanceCode) H
  letI : (crossStageProjection.{u, v} U).IsStronglyCartesian
      (𝟙 instanceCode.toSemantic) directTarget := by
    rw [← typedRealizableHom_id_hom instanceCode]
    exact exactTypedGeometryPullLift_isStronglyCartesian
      (idTypedPresentation instanceCode) H
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (crossStageProjection.{u, v} U) (𝟙 instanceCode.toSemantic)
    directTarget (𝟙 instanceCode.toSemantic)
  change (f.1 ≫ (exactTypedGeometryPullUnitorApp instanceCode H).hom.1) ≫
      directTarget =
    ((exactTypedGeometryPullUnitorApp instanceCode G).hom.1 ≫
      ((exactTypedGeometryPullFunctor
        (idTypedPresentation instanceCode)).map f).1) ≫ directTarget
  calc
    _ = f.1 ≫ ((exactTypedGeometryPullUnitorApp instanceCode H).hom.1 ≫
        directTarget) := Category.assoc _ _ _
    _ = f.1 := by rw [exactTypedGeometryPullUnitorApp_hom_fac, Category.comp_id]
    _ = 𝟙 G.1 ≫ f.1 := (Category.id_comp _).symm
    _ = ((exactTypedGeometryPullUnitorApp instanceCode G).hom.1 ≫
        exactTypedGeometryPullLift (idTypedPresentation instanceCode) G) ≫ f.1 := by
      rw [exactTypedGeometryPullUnitorApp_hom_fac]
    _ = (exactTypedGeometryPullUnitorApp instanceCode G).hom.1 ≫
        (exactTypedGeometryPullLift (idTypedPresentation instanceCode) G ≫ f.1) :=
      Category.assoc _ _ _
    _ = (exactTypedGeometryPullUnitorApp instanceCode G).hom.1 ≫
        (((exactTypedGeometryPullFunctor
          (idTypedPresentation instanceCode)).map f).1 ≫ directTarget) := by
      rw [exactTypedGeometryPullFunctor_map_fac]
    _ = _ := (Category.assoc _ _ _).symm

/-- The natural contravariant unitor for typed exact pullback. -/
noncomputable def exactTypedGeometryPullUnitor
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U) :
    𝟭 (GeomFiber.{u, v} instanceCode.toSemantic) ≅
      exactTypedGeometryPullFunctor.{u, v} (idTypedPresentation instanceCode) :=
  NatIso.ofComponents (exactTypedGeometryPullUnitorApp instanceCode)
    (fun f => exactTypedGeometryPullUnitor_naturality instanceCode f)

/-- Every exact compositor component fixes the inherited coefficient ring. -/
theorem exactTypedGeometryPullCompositorApp_coefficient_id
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (first : CartPresentationBetween source middle)
    (second : CartPresentationBetween middle target)
    (G : GeomFiber.{u, v} target.toSemantic) :
    (exactTypedGeometryPullCompositorApp first second G).hom.1.geometry.coefficientHom =
      RingHom.id G.1.Coefficient := by
  have h := congrArg (fun hom => hom.geometry.coefficientHom)
    (exactTypedGeometryPullCompositorApp_hom_fac first second G)
  change (RingHom.id G.1.Coefficient).comp
      (exactTypedGeometryPullCompositorApp first second G).hom.1.geometry.coefficientHom =
    (RingHom.id G.1.Coefficient).comp (RingHom.id G.1.Coefficient) at h
  simpa only [RingHom.id_comp, RingHom.comp_id] using h

/-- Every exact unitor component fixes the inherited coefficient ring. -/
theorem exactTypedGeometryPullUnitorApp_coefficient_id
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (instanceCode : FiniteInstanceCode U)
    (G : GeomFiber.{u, v} instanceCode.toSemantic) :
    (exactTypedGeometryPullUnitorApp instanceCode G).hom.1.geometry.coefficientHom =
      RingHom.id G.1.Coefficient := by
  have h := congrArg (fun hom => hom.geometry.coefficientHom)
    (exactTypedGeometryPullUnitorApp_hom_fac instanceCode G)
  change (RingHom.id G.1.Coefficient).comp
      (exactTypedGeometryPullUnitorApp instanceCode G).hom.1.geometry.coefficientHom =
    RingHom.id G.1.Coefficient at h
  simpa only [RingHom.id_comp] using h

/-! ## Associativity coherence -/

/-- Relative compositor to an arbitrary direct typed presentation whose
decoded arrow is the composite of the two legs. -/
private noncomputable def exactTypedGeometryPullRelativeCompositorApp
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (direct : CartPresentationBetween source target)
    (first : CartPresentationBetween source middle)
    (second : CartPresentationBetween middle target)
    (base_eq : (typedCartSemanticInput direct).hom =
      (typedCartSemanticInput first).hom ≫
        (typedCartSemanticInput second).hom)
    (G : GeomFiber.{u, v} target.toSemantic) :
    (exactTypedGeometryPullFunctor second ⋙
      exactTypedGeometryPullFunctor first).obj G ≅
        (exactTypedGeometryPullFunctor direct).obj G := by
  let directLift := exactTypedGeometryPullLift direct G
  let iteratedLift := exactTypedGeometryPullIteratedLift first second G
  letI : (crossStageProjection.{u, v} U).IsStronglyCartesian
      ((typedCartSemanticInput first).hom ≫
        (typedCartSemanticInput second).hom) directLift := by
    rw [← base_eq]
    exact exactTypedGeometryPullLift_isStronglyCartesian direct G
  letI := exactTypedGeometryPullIteratedLift_isStronglyCartesian first second G
  exact exactStrongCartesianComparisonIso (crossStageProjection.{u, v} U)
    ((typedCartSemanticInput first).hom ≫
      (typedCartSemanticInput second).hom) directLift iteratedLift

/-- The relative compositor has the same generated factor triangle. -/
private theorem exactTypedGeometryPullRelativeCompositorApp_hom_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source middle target : FiniteInstanceCode U}
    (direct : CartPresentationBetween source target)
    (first : CartPresentationBetween source middle)
    (second : CartPresentationBetween middle target)
    (base_eq : (typedCartSemanticInput direct).hom =
      (typedCartSemanticInput first).hom ≫
        (typedCartSemanticInput second).hom)
    (G : GeomFiber.{u, v} target.toSemantic) :
    (exactTypedGeometryPullRelativeCompositorApp
      direct first second base_eq G).hom.1 ≫
        exactTypedGeometryPullLift direct G =
      exactTypedGeometryPullIteratedLift first second G := by
  letI : (crossStageProjection.{u, v} U).IsStronglyCartesian
      ((typedCartSemanticInput first).hom ≫
        (typedCartSemanticInput second).hom)
      (exactTypedGeometryPullLift direct G) := by
    rw [← base_eq]
    exact exactTypedGeometryPullLift_isStronglyCartesian direct G
  letI := exactTypedGeometryPullIteratedLift_isStronglyCartesian first second G
  exact exactStrongCartesianComparisonHom_fac (crossStageProjection.{u, v} U)
    ((typedCartSemanticInput first).hom ≫
      (typedCartSemanticInput second).hom)
    (exactTypedGeometryPullLift direct G)
    (exactTypedGeometryPullIteratedLift first second G)

/-- Semantic associativity used only to retag the strongly Cartesian
proposition of the right-associated two-step lift. -/
private theorem exactTypedGeometryPull_assoc_base_eq
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {W X Y Z : FiniteInstanceCode U}
    (first : CartPresentationBetween W X)
    (second : CartPresentationBetween X Y)
    (third : CartPresentationBetween Y Z) :
    (typedCartSemanticInput
      (compPresentation (compPresentation first second) third)).hom =
      (typedCartSemanticInput first).hom ≫
        (typedCartSemanticInput (compPresentation second third)).hom := by
  calc
    _ = (typedCartSemanticInput (compPresentation first second)).hom ≫
        (typedCartSemanticInput third).hom :=
      typedRealizableHom_comp_hom (compPresentation first second) third
    _ = ((typedCartSemanticInput first).hom ≫
        (typedCartSemanticInput second).hom) ≫
          (typedCartSemanticInput third).hom := by
      have hcomp :
          (typedCartSemanticInput (compPresentation first second)).hom =
            (typedCartSemanticInput first).hom ≫
              (typedCartSemanticInput second).hom :=
        typedRealizableHom_comp_hom first second
      exact congrArg (fun hom => hom ≫
        (typedCartSemanticInput third).hom) hcomp
    _ = (typedCartSemanticInput first).hom ≫
        ((typedCartSemanticInput second).hom ≫
          (typedCartSemanticInput third).hom) := Category.assoc _ _ _
    _ = _ := by
      have hcomp :
          (typedCartSemanticInput (compPresentation second third)).hom =
            (typedCartSemanticInput second).hom ≫
              (typedCartSemanticInput third).hom :=
        typedRealizableHom_comp_hom second third
      exact congrArg (fun hom =>
        (typedCartSemanticInput first).hom ≫ hom) hcomp.symm

/-- The literal three-step exact complete-geometry lift. -/
noncomputable def exactTypedGeometryPullTripleIteratedLift
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {W X Y Z : FiniteInstanceCode U}
    (first : CartPresentationBetween W X)
    (second : CartPresentationBetween X Y)
    (third : CartPresentationBetween Y Z)
    (G : GeomFiber.{u, v} Z.toSemantic) :
    ((exactTypedGeometryPullFunctor first).obj
      ((exactTypedGeometryPullFunctor second).obj
        ((exactTypedGeometryPullFunctor third).obj G))).1 ⟶ G.1 :=
  exactTypedGeometryPullLift first
      ((exactTypedGeometryPullFunctor second).obj
        ((exactTypedGeometryPullFunctor third).obj G)) ≫
    (exactTypedGeometryPullLift second
      ((exactTypedGeometryPullFunctor third).obj G) ≫
      exactTypedGeometryPullLift third G)

/-- Left-associated compositor route to one fixed direct presentation. -/
noncomputable def exactTypedGeometryPullAssocLeftRoute
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {W X Y Z : FiniteInstanceCode U}
    (first : CartPresentationBetween W X)
    (second : CartPresentationBetween X Y)
    (third : CartPresentationBetween Y Z)
    (G : GeomFiber.{u, v} Z.toSemantic) :
    (exactTypedGeometryPullFunctor first).obj
      ((exactTypedGeometryPullFunctor second).obj
        ((exactTypedGeometryPullFunctor third).obj G)) ⟶
    (exactTypedGeometryPullFunctor
      (compPresentation (compPresentation first second) third)).obj G :=
  (exactTypedGeometryPullCompositorApp first second
      ((exactTypedGeometryPullFunctor third).obj G)).hom ≫
    (exactTypedGeometryPullCompositorApp
      (compPresentation first second) third G).hom

/-- Right-associated compositor route to the same fixed direct presentation. -/
noncomputable def exactTypedGeometryPullAssocRightRoute
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {W X Y Z : FiniteInstanceCode U}
    (first : CartPresentationBetween W X)
    (second : CartPresentationBetween X Y)
    (third : CartPresentationBetween Y Z)
    (G : GeomFiber.{u, v} Z.toSemantic) :
    (exactTypedGeometryPullFunctor first).obj
      ((exactTypedGeometryPullFunctor second).obj
        ((exactTypedGeometryPullFunctor third).obj G)) ⟶
    (exactTypedGeometryPullFunctor
      (compPresentation (compPresentation first second) third)).obj G :=
  (exactTypedGeometryPullFunctor first).map
      (exactTypedGeometryPullCompositorApp second third G).hom ≫
    (exactTypedGeometryPullRelativeCompositorApp
      (compPresentation (compPresentation first second) third)
      first (compPresentation second third)
      (exactTypedGeometryPull_assoc_base_eq first second third) G).hom

/-- The left-associated route factors the direct lift as the triple lift. -/
theorem exactTypedGeometryPullAssocLeftRoute_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {W X Y Z : FiniteInstanceCode U}
    (first : CartPresentationBetween W X)
    (second : CartPresentationBetween X Y)
    (third : CartPresentationBetween Y Z)
    (G : GeomFiber.{u, v} Z.toSemantic) :
    (exactTypedGeometryPullAssocLeftRoute first second third G).1 ≫
      exactTypedGeometryPullLift
        (compPresentation (compPresentation first second) third) G =
      exactTypedGeometryPullTripleIteratedLift first second third G := by
  change ((exactTypedGeometryPullCompositorApp first second
      ((exactTypedGeometryPullFunctor third).obj G)).hom.1 ≫
    (exactTypedGeometryPullCompositorApp
      (compPresentation first second) third G).hom.1) ≫
      exactTypedGeometryPullLift
        (compPresentation (compPresentation first second) third) G = _
  calc
    _ = (exactTypedGeometryPullCompositorApp first second
          ((exactTypedGeometryPullFunctor third).obj G)).hom.1 ≫
        ((exactTypedGeometryPullCompositorApp
          (compPresentation first second) third G).hom.1 ≫
          exactTypedGeometryPullLift
            (compPresentation (compPresentation first second) third) G) :=
      Category.assoc _ _ _
    _ = (exactTypedGeometryPullCompositorApp first second
          ((exactTypedGeometryPullFunctor third).obj G)).hom.1 ≫
        exactTypedGeometryPullIteratedLift
          (compPresentation first second) third G := by
      rw [exactTypedGeometryPullCompositorApp_hom_fac]
    _ = ((exactTypedGeometryPullCompositorApp first second
          ((exactTypedGeometryPullFunctor third).obj G)).hom.1 ≫
        exactTypedGeometryPullLift (compPresentation first second)
          ((exactTypedGeometryPullFunctor third).obj G)) ≫
        exactTypedGeometryPullLift third G := (Category.assoc _ _ _).symm
    _ = exactTypedGeometryPullIteratedLift first second
          ((exactTypedGeometryPullFunctor third).obj G) ≫
        exactTypedGeometryPullLift third G := by
      rw [exactTypedGeometryPullCompositorApp_hom_fac]
    _ = _ := Category.assoc _ _ _

/-- The right-associated route factors the same direct lift as the triple lift. -/
theorem exactTypedGeometryPullAssocRightRoute_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {W X Y Z : FiniteInstanceCode U}
    (first : CartPresentationBetween W X)
    (second : CartPresentationBetween X Y)
    (third : CartPresentationBetween Y Z)
    (G : GeomFiber.{u, v} Z.toSemantic) :
    (exactTypedGeometryPullAssocRightRoute first second third G).1 ≫
      exactTypedGeometryPullLift
        (compPresentation (compPresentation first second) third) G =
      exactTypedGeometryPullTripleIteratedLift first second third G := by
  let assocEq := exactTypedGeometryPull_assoc_base_eq first second third
  change (((exactTypedGeometryPullFunctor first).map
      (exactTypedGeometryPullCompositorApp second third G).hom).1 ≫
    (exactTypedGeometryPullRelativeCompositorApp
      (compPresentation (compPresentation first second) third)
      first (compPresentation second third) assocEq G).hom.1) ≫
      exactTypedGeometryPullLift
        (compPresentation (compPresentation first second) third) G = _
  calc
    _ = ((exactTypedGeometryPullFunctor first).map
          (exactTypedGeometryPullCompositorApp second third G).hom).1 ≫
        ((exactTypedGeometryPullRelativeCompositorApp
          (compPresentation (compPresentation first second) third)
          first (compPresentation second third) assocEq G).hom.1 ≫
          exactTypedGeometryPullLift
            (compPresentation (compPresentation first second) third) G) :=
      Category.assoc _ _ _
    _ = ((exactTypedGeometryPullFunctor first).map
          (exactTypedGeometryPullCompositorApp second third G).hom).1 ≫
        exactTypedGeometryPullIteratedLift
          first (compPresentation second third) G := by
      rw [exactTypedGeometryPullRelativeCompositorApp_hom_fac]
    _ = (((exactTypedGeometryPullFunctor first).map
          (exactTypedGeometryPullCompositorApp second third G).hom).1 ≫
        exactTypedGeometryPullLift first
          ((exactTypedGeometryPullFunctor
            (compPresentation second third)).obj G)) ≫
          exactTypedGeometryPullLift (compPresentation second third) G :=
      (Category.assoc _ _ _).symm
    _ = (exactTypedGeometryPullLift first
          ((exactTypedGeometryPullFunctor third ⋙
            exactTypedGeometryPullFunctor second).obj G) ≫
        (exactTypedGeometryPullCompositorApp second third G).hom.1) ≫
          exactTypedGeometryPullLift (compPresentation second third) G := by
      rw [exactTypedGeometryPullFunctor_map_fac]
    _ = exactTypedGeometryPullLift first
          ((exactTypedGeometryPullFunctor second).obj
            ((exactTypedGeometryPullFunctor third).obj G)) ≫
        ((exactTypedGeometryPullCompositorApp second third G).hom.1 ≫
          exactTypedGeometryPullLift (compPresentation second third) G) :=
      Category.assoc _ _ _
    _ = exactTypedGeometryPullLift first
          ((exactTypedGeometryPullFunctor second).obj
            ((exactTypedGeometryPullFunctor third).obj G)) ≫
        exactTypedGeometryPullIteratedLift second third G := by
      rw [exactTypedGeometryPullCompositorApp_hom_fac]
    _ = _ := rfl

/-- Constructor-relative associativity of the two actual contravariant
compositor routes. -/
theorem exactTypedGeometryPullCompositor_assoc
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {W X Y Z : FiniteInstanceCode U}
    (first : CartPresentationBetween W X)
    (second : CartPresentationBetween X Y)
    (third : CartPresentationBetween Y Z)
    (G : GeomFiber.{u, v} Z.toSemantic) :
    exactTypedGeometryPullAssocLeftRoute first second third G =
      exactTypedGeometryPullAssocRightRoute first second third G := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let directLift := exactTypedGeometryPullLift
    (compPresentation (compPresentation first second) third) G
  letI := exactTypedGeometryPullLift_isStronglyCartesian
    (compPresentation (compPresentation first second) third) G
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (crossStageProjection.{u, v} U)
    (typedCartSemanticInput
      (compPresentation (compPresentation first second) third)).hom
    directLift (𝟙 W.toSemantic)
  change (exactTypedGeometryPullAssocLeftRoute first second third G).1 ≫
      directLift =
    (exactTypedGeometryPullAssocRightRoute first second third G).1 ≫ directLift
  rw [exactTypedGeometryPullAssocLeftRoute_fac,
    exactTypedGeometryPullAssocRightRoute_fac]

/-! ## Unit coherence -/

/-- Semantic left-unit equality for the relative compositor. -/
private theorem exactTypedGeometryPull_left_unit_base_eq
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target) :
    (typedCartSemanticInput presentation).hom =
      (typedCartSemanticInput (idTypedPresentation source)).hom ≫
        (typedCartSemanticInput presentation).hom := by
  have hid :
      (typedCartSemanticInput (idTypedPresentation source)).hom =
        𝟙 source.toSemantic := typedRealizableHom_id_hom source
  rw [hid]
  exact (Category.id_comp _).symm

/-- Semantic right-unit equality for the relative compositor. -/
private theorem exactTypedGeometryPull_right_unit_base_eq
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target) :
    (typedCartSemanticInput presentation).hom =
      (typedCartSemanticInput presentation).hom ≫
        (typedCartSemanticInput (idTypedPresentation target)).hom := by
  have hid :
      (typedCartSemanticInput (idTypedPresentation target)).hom =
        𝟙 target.toSemantic := typedRealizableHom_id_hom target
  rw [hid]
  exact (Category.comp_id _).symm

/-- Source-identity unitor followed by the relative compositor. -/
noncomputable def exactTypedGeometryPullLeftUnitRoute
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target)
    (G : GeomFiber.{u, v} target.toSemantic) :
    (exactTypedGeometryPullFunctor presentation).obj G ⟶
      (exactTypedGeometryPullFunctor presentation).obj G :=
  (exactTypedGeometryPullUnitorApp source
    ((exactTypedGeometryPullFunctor presentation).obj G)).hom ≫
  (exactTypedGeometryPullRelativeCompositorApp presentation
    (idTypedPresentation source) presentation
    (exactTypedGeometryPull_left_unit_base_eq presentation) G).hom

/-- Target-identity unitor transported by pullback, then the relative
compositor. -/
noncomputable def exactTypedGeometryPullRightUnitRoute
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target)
    (G : GeomFiber.{u, v} target.toSemantic) :
    (exactTypedGeometryPullFunctor presentation).obj G ⟶
      (exactTypedGeometryPullFunctor presentation).obj G :=
  (exactTypedGeometryPullFunctor presentation).map
      (exactTypedGeometryPullUnitorApp target G).hom ≫
  (exactTypedGeometryPullRelativeCompositorApp presentation presentation
    (idTypedPresentation target)
    (exactTypedGeometryPull_right_unit_base_eq presentation) G).hom

/-- The left unit route factors to the original selected exact lift. -/
theorem exactTypedGeometryPullLeftUnitRoute_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target)
    (G : GeomFiber.{u, v} target.toSemantic) :
    (exactTypedGeometryPullLeftUnitRoute presentation G).1 ≫
      exactTypedGeometryPullLift presentation G =
        exactTypedGeometryPullLift presentation G := by
  let unitEq := exactTypedGeometryPull_left_unit_base_eq presentation
  change ((exactTypedGeometryPullUnitorApp source
      ((exactTypedGeometryPullFunctor presentation).obj G)).hom.1 ≫
    (exactTypedGeometryPullRelativeCompositorApp presentation
      (idTypedPresentation source) presentation unitEq G).hom.1) ≫
      exactTypedGeometryPullLift presentation G = _
  calc
    _ = (exactTypedGeometryPullUnitorApp source
          ((exactTypedGeometryPullFunctor presentation).obj G)).hom.1 ≫
        ((exactTypedGeometryPullRelativeCompositorApp presentation
          (idTypedPresentation source) presentation unitEq G).hom.1 ≫
          exactTypedGeometryPullLift presentation G) := Category.assoc _ _ _
    _ = (exactTypedGeometryPullUnitorApp source
          ((exactTypedGeometryPullFunctor presentation).obj G)).hom.1 ≫
        exactTypedGeometryPullIteratedLift
          (idTypedPresentation source) presentation G := by
      rw [exactTypedGeometryPullRelativeCompositorApp_hom_fac]
    _ = ((exactTypedGeometryPullUnitorApp source
          ((exactTypedGeometryPullFunctor presentation).obj G)).hom.1 ≫
        exactTypedGeometryPullLift (idTypedPresentation source)
          ((exactTypedGeometryPullFunctor presentation).obj G)) ≫
          exactTypedGeometryPullLift presentation G :=
      (Category.assoc _ _ _).symm
    _ = 𝟙 ((exactTypedGeometryPullFunctor presentation).obj G).1 ≫
        exactTypedGeometryPullLift presentation G := by
      rw [exactTypedGeometryPullUnitorApp_hom_fac]
    _ = _ := Category.id_comp _

/-- The right unit route factors to the original selected exact lift. -/
theorem exactTypedGeometryPullRightUnitRoute_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target)
    (G : GeomFiber.{u, v} target.toSemantic) :
    (exactTypedGeometryPullRightUnitRoute presentation G).1 ≫
      exactTypedGeometryPullLift presentation G =
        exactTypedGeometryPullLift presentation G := by
  let unitEq := exactTypedGeometryPull_right_unit_base_eq presentation
  change (((exactTypedGeometryPullFunctor presentation).map
      (exactTypedGeometryPullUnitorApp target G).hom).1 ≫
    (exactTypedGeometryPullRelativeCompositorApp presentation presentation
      (idTypedPresentation target) unitEq G).hom.1) ≫
      exactTypedGeometryPullLift presentation G = _
  calc
    _ = ((exactTypedGeometryPullFunctor presentation).map
          (exactTypedGeometryPullUnitorApp target G).hom).1 ≫
        ((exactTypedGeometryPullRelativeCompositorApp presentation presentation
          (idTypedPresentation target) unitEq G).hom.1 ≫
          exactTypedGeometryPullLift presentation G) := Category.assoc _ _ _
    _ = ((exactTypedGeometryPullFunctor presentation).map
          (exactTypedGeometryPullUnitorApp target G).hom).1 ≫
        exactTypedGeometryPullIteratedLift presentation
          (idTypedPresentation target) G := by
      rw [exactTypedGeometryPullRelativeCompositorApp_hom_fac]
    _ = (((exactTypedGeometryPullFunctor presentation).map
          (exactTypedGeometryPullUnitorApp target G).hom).1 ≫
        exactTypedGeometryPullLift presentation
          ((exactTypedGeometryPullFunctor
            (idTypedPresentation target)).obj G)) ≫
          exactTypedGeometryPullLift (idTypedPresentation target) G :=
      (Category.assoc _ _ _).symm
    _ = (exactTypedGeometryPullLift presentation G ≫
        (exactTypedGeometryPullUnitorApp target G).hom.1) ≫
          exactTypedGeometryPullLift (idTypedPresentation target) G := by
      rw [exactTypedGeometryPullFunctor_map_fac]
    _ = exactTypedGeometryPullLift presentation G ≫
        ((exactTypedGeometryPullUnitorApp target G).hom.1 ≫
          exactTypedGeometryPullLift (idTypedPresentation target) G) :=
      Category.assoc _ _ _
    _ = exactTypedGeometryPullLift presentation G ≫ 𝟙 G.1 := by
      rw [exactTypedGeometryPullUnitorApp_hom_fac]
    _ = _ := Category.comp_id _

/-- Constructor-relative left unit coherence. -/
theorem exactTypedGeometryPullCompositor_left_unit
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target)
    (G : GeomFiber.{u, v} target.toSemantic) :
    exactTypedGeometryPullLeftUnitRoute presentation G =
      𝟙 ((exactTypedGeometryPullFunctor presentation).obj G) := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let lift := exactTypedGeometryPullLift presentation G
  letI := exactTypedGeometryPullLift_isStronglyCartesian presentation G
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (crossStageProjection.{u, v} U)
    (typedCartSemanticInput presentation).hom lift (𝟙 source.toSemantic)
  change (exactTypedGeometryPullLeftUnitRoute presentation G).1 ≫ lift =
    𝟙 ((exactTypedGeometryPullFunctor presentation).obj G).1 ≫ lift
  rw [exactTypedGeometryPullLeftUnitRoute_fac, Category.id_comp]

/-- Constructor-relative right unit coherence. -/
theorem exactTypedGeometryPullCompositor_right_unit
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    {source target : FiniteInstanceCode U}
    (presentation : CartPresentationBetween source target)
    (G : GeomFiber.{u, v} target.toSemantic) :
    exactTypedGeometryPullRightUnitRoute presentation G =
      𝟙 ((exactTypedGeometryPullFunctor presentation).obj G) := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let lift := exactTypedGeometryPullLift presentation G
  letI := exactTypedGeometryPullLift_isStronglyCartesian presentation G
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (crossStageProjection.{u, v} U)
    (typedCartSemanticInput presentation).hom lift (𝟙 source.toSemantic)
  change (exactTypedGeometryPullRightUnitRoute presentation G).1 ≫ lift =
    𝟙 ((exactTypedGeometryPullFunctor presentation).obj G).1 ≫ lift
  rw [exactTypedGeometryPullRightUnitRoute_fac, Category.id_comp]

