import ResearchLean.AG.FullGeometryNormalization.CanonicalNormalization
import ResearchLean.AG.FullGeometryNormalization.ExactGeometryPull
import ResearchLean.AG.DoctrineFiberProduct.LaxDiagnosticProjectorAdmissibleFiber

/-!
# Canonical normalization along exact complete-geometry transport

This module establishes the object-level part of G-122(B3): canonical
normalization admissibility is generated at the endpoints of the actual
complete-geometry push and pull functors.  No target admissibility proof is
accepted from the caller.
-/

namespace AAT.AG.FullGeometryNormalization

universe u v

open CategoryTheory AtomFoundation GeometryTransport CrossStageCoherence
open DoctrineFiberProduct

/-- Exact complete-geometry push preserves canonical normalization
admissibility.  The target proof is generated by G-117's transport theorem
from the actual core underlying `geomFiberTransportFunctor`. -/
theorem canonicalGeometryNormalizationAdmissible_exactTransport
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    (source : GeomFiber.{u, v} input.semantic.source)
    (admissible : CanonicalObjectNormalizationAdmissible source.1.core) :
    CanonicalObjectNormalizationAdmissible
      ((geomFiberTransportFunctor input.semantic.hom).obj source).1.core := by
  change CanonicalObjectNormalizationAdmissible
    (transportAlong source.1.core
      (geomFiberBaseHom input.semantic.hom source).doctrineHom)
  exact canonicalObjectNormalizationAdmissible_transportAlong
    source.1.core admissible
      (geomFiberBaseHom input.semantic.hom source).doctrineHom

/-- Canonical package transport has the operation coherence needed for
normalization naturality.  This is generated by the transported operation
reading and is not an additional premise. -/
theorem transportArchitectureObject_forward_canonicalObjectNormalization_inverseCore
    {U : AtomCarrier.{u}} {X : ExtractionInstance U}
    (Q : AATCorePackage U) (f : X ⟶ packagePoint Q)
    (object : ArchitectureObject U) :
    transportArchitectureObject f.doctrineHom.atomEquiv
        (canonicalObjectNormalization (inverseCorePackage Q f) object) =
      canonicalObjectNormalization Q
        (transportArchitectureObject f.doctrineHom.atomEquiv object) := by
  unfold canonicalObjectNormalization inverseCorePackage inverseCoreReading
    transportObjectReading
  simp [transportArchitectureObject]

/-- Configuration-only equation residual dependence is preserved by the
canonical inverse-core reindexing used by exact geometry pullback. -/
theorem equationResidualConfigurationInvariant_inverseCorePackage
    {U : AtomCarrier.{u}} {X : ExtractionInstance U}
    (Q : AATCorePackage U)
    (invariant : EquationResidualConfigurationInvariant
      Q.algebra.equationSystem)
    (f : X ⟶ packagePoint Q) :
    EquationResidualConfigurationInvariant
      (inverseCorePackage Q f).algebra.equationSystem := by
  unfold inverseCorePackage inverseCoreReading
  apply castEquationResidual_configurationInvariant
  apply transportEquationResidual_configurationInvariant
  exact invariant

/-- Canonical inverse-core reindexing preserves normalization admissibility.
This is the core object generated by exact complete-geometry pullback, so the
statement supplies the missing direction complementary to canonical forward
transport. -/
theorem canonicalObjectNormalizationAdmissible_inverseCorePackage
    {U : AtomCarrier.{u}} {X : ExtractionInstance U}
    (Q : AATCorePackage U)
    (admissible : CanonicalObjectNormalizationAdmissible Q)
    (f : X ⟶ packagePoint Q) :
    CanonicalObjectNormalizationAdmissible (inverseCorePackage Q f) := by
  let operationTypeEq : ∀ first second,
      (inverseCorePackage Q f).reading.operationReading.Op first second =
        (inverseCorePackage Q f).reading.operationReading.Op
          (canonicalObjectNormalization (inverseCorePackage Q f) first)
          (canonicalObjectNormalization (inverseCorePackage Q f) second) := by
    intro first second
    change Q.reading.operationReading.Op
        (transportArchitectureObject f.doctrineHom.atomEquiv first)
        (transportArchitectureObject f.doctrineHom.atomEquiv second) =
      Q.reading.operationReading.Op
        (transportArchitectureObject f.doctrineHom.atomEquiv
          (canonicalObjectNormalization (inverseCorePackage Q f) first))
        (transportArchitectureObject f.doctrineHom.atomEquiv
          (canonicalObjectNormalization (inverseCorePackage Q f) second))
    rw [transportArchitectureObject_forward_canonicalObjectNormalization_inverseCore,
      transportArchitectureObject_forward_canonicalObjectNormalization_inverseCore]
    exact admissible.operation_type_eq _ _
  refine {
    equationResidual_eq := ?_
    operation_type_eq := operationTypeEq
    operation_naturality := ?_
    invariant_transport := ?_
    coordinate_eq := ?_ }
  · intro W object index atom
    apply equationResidualConfigurationInvariant_inverseCorePackage Q
      admissible.equationResidual_configurationInvariant f
    exact (canonicalObjectNormalization_configuration
      (inverseCorePackage Q f) object).symm
  · intro first second operation
    have hnat := congrArg ConfigurationHom.atomMap
      (admissible.operation_naturality
        (transportArchitectureObject f.doctrineHom.atomEquiv first)
        (transportArchitectureObject f.doctrineHom.atomEquiv second)
        operation)
    apply ConfigurationHom.ext
    simp only [castConfigurationHom_atomMap,
      inverseCorePackage, inverseCoreReading, transportOperationReading,
      transportConfigurationHom_atomMap, ConfigurationHom.comp,
      canonicalObjectNormalizationConfigurationHom_atomMap] at hnat ⊢
    apply funext
    intro atom
    apply f.doctrineHom.atomEquiv.symm.injective
    simp only [Function.comp_apply]
    rw [operationConfigurationMap_atomMap_eq_of_heq
      Q.reading.operationReading
      (transportArchitectureObject_forward_canonicalObjectNormalization_inverseCore
        Q f first)
      (transportArchitectureObject_forward_canonicalObjectNormalization_inverseCore
        Q f second)
      ((cast_heq (operationTypeEq first second) operation).trans
        (cast_heq
          (admissible.operation_type_eq
            (transportArchitectureObject f.doctrineHom.atomEquiv first)
            (transportArchitectureObject f.doctrineHom.atomEquiv second))
          operation).symm)]
    simpa [Function.comp_def] using
      congrFun hnat (f.doctrineHom.atomEquiv atom)
  · intro index
    apply transportedInvariant_self_naturality f.doctrineHom.atomEquiv.symm
      (Q.reading.invariantReading.invariant index)
      (canonicalObjectNormalization Q)
      (canonicalObjectNormalization (inverseCorePackage Q f))
      (admissible.invariant_transport index)
    exact transportArchitectureObject_forward_canonicalObjectNormalization_inverseCore Q f
  · intro object axis
    change Q.reading.signatureReading.coordinate
        (transportArchitectureObject f.doctrineHom.atomEquiv object) axis =
      Q.reading.signatureReading.coordinate
        (transportArchitectureObject f.doctrineHom.atomEquiv
          (canonicalObjectNormalization (inverseCorePackage Q f) object)) axis
    rw [transportArchitectureObject_forward_canonicalObjectNormalization_inverseCore]
    exact admissible.coordinate_eq _ _

/-- Exact complete-geometry pullback preserves canonical normalization
admissibility, generated from the target proof and the actual inverse-core
object selected by the exact pull cleavage. -/
theorem canonicalGeometryNormalizationAdmissible_exactPull
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    (target : GeomFiber.{u, v} input.semantic.target)
    (admissible : CanonicalObjectNormalizationAdmissible target.1.core) :
    CanonicalObjectNormalizationAdmissible
      ((exactGeometryPullFunctor input).obj target).1.core := by
  change CanonicalObjectNormalizationAdmissible
    (exactGeometryPull input target).1.core
  rw [exactGeometryPull_core]
  exact canonicalObjectNormalizationAdmissible_inverseCorePackage
    target.1.core admissible (exactGeometryPullBaseHom input target)

/-! ## The actual exact functors restricted to admissible endpoints -/

/-- The admissible objects in a complete-geometry fiber are precisely those
whose projected core admits canonical object normalization. -/
def canonicalNormalizationAdmissibleGeomFiberProperty
    {U : AtomCarrier.{u}} (X : ExtractionInstance U) :
    ObjectProperty (GeomFiber.{u, v} X) :=
  fun G ↦ CanonicalObjectNormalizationAdmissible G.1.core

/-- The full subcategory of one complete-geometry fiber selected by canonical
normalization admissibility. -/
abbrev CanonicalNormalizationAdmissibleGeomFiber
    {U : AtomCarrier.{u}} (X : ExtractionInstance U) :=
  (canonicalNormalizationAdmissibleGeomFiberProperty.{u, v} X).FullSubcategory

/-- The actual exact complete-geometry push functor restricted to admissible
objects.  Target membership is generated by exact transport preservation. -/
noncomputable def exactGeometryTransportAdmissibleFunctor
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U) :
    CanonicalNormalizationAdmissibleGeomFiber.{u, v} input.semantic.source ⥤
      CanonicalNormalizationAdmissibleGeomFiber.{u, v} input.semantic.target :=
  (canonicalNormalizationAdmissibleGeomFiberProperty input.semantic.target).lift
    ((canonicalNormalizationAdmissibleGeomFiberProperty input.semantic.source).ι ⋙
      geomFiberTransportFunctor input.semantic.hom)
    (fun source ↦ canonicalGeometryNormalizationAdmissible_exactTransport
      input source.obj source.property)

/-- The actual exact complete-geometry pull functor restricted to admissible
objects.  Source membership is generated by inverse-core preservation. -/
noncomputable def exactGeometryPullAdmissibleFunctor
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U) :
    CanonicalNormalizationAdmissibleGeomFiber.{u, v} input.semantic.target ⥤
      CanonicalNormalizationAdmissibleGeomFiber.{u, v} input.semantic.source :=
  (canonicalNormalizationAdmissibleGeomFiberProperty input.semantic.source).lift
    ((canonicalNormalizationAdmissibleGeomFiberProperty input.semantic.target).ι ⋙
      exactGeometryPullFunctor input)
    (fun target ↦ canonicalGeometryNormalizationAdmissible_exactPull
      input target.obj target.property)

@[simp]
theorem exactGeometryTransportAdmissibleFunctor_obj_obj
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    (source : CanonicalNormalizationAdmissibleGeomFiber.{u, v}
      input.semantic.source) :
    ((exactGeometryTransportAdmissibleFunctor input).obj source).obj =
      (geomFiberTransportFunctor input.semantic.hom).obj source.obj :=
  rfl

@[simp]
theorem exactGeometryPullAdmissibleFunctor_obj_obj
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    (target : CanonicalNormalizationAdmissibleGeomFiber.{u, v}
      input.semantic.target) :
    ((exactGeometryPullAdmissibleFunctor input).obj target).obj =
      (exactGeometryPullFunctor input).obj target.obj :=
  rfl

@[simp]
theorem exactGeometryTransportAdmissibleFunctor_map_hom
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    {first second : CanonicalNormalizationAdmissibleGeomFiber.{u, v}
      input.semantic.source} (hom : first ⟶ second) :
    ((exactGeometryTransportAdmissibleFunctor input).map hom).hom =
      (geomFiberTransportFunctor input.semantic.hom).map hom.hom :=
  rfl

@[simp]
theorem exactGeometryPullAdmissibleFunctor_map_hom
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    {first second : CanonicalNormalizationAdmissibleGeomFiber.{u, v}
      input.semantic.target} (hom : first ⟶ second) :
    ((exactGeometryPullAdmissibleFunctor input).map hom).hom =
      (exactGeometryPullFunctor input).map hom.hom :=
  rfl

end AAT.AG.FullGeometryNormalization

#assert_standard_axioms_only AAT.AG.FullGeometryNormalization
