import ResearchLean.AG.FullGeometryNormalization.ExactGeometryPull
import ResearchLean.AG.CrossStageCoherence.TowerCompatibility
import ResearchLean.AG.DoctrineFiberProduct.CartesianRegimeReindexing

/-!
# Core projection of exact complete-geometry pullback

The exact complete-geometry cleavage and the selected core cleavage produce
strongly Cartesian lifts of the same realized arrow.  Cartesian uniqueness
therefore gives a canonical comparison between their domains.  The
comparison is assembled here into a natural isomorphism, so compatibility of
the complete pullback with core projection is a statement about the whole
reindexing functors rather than an object-only equality.

No comparison, lift, or Cartesian certificate is accepted from the caller.
Naturality is forced by the two defining factorization equations for the
independently generated vertical maps.
-/

namespace AAT.AG.FullGeometryNormalization

universe u v

open CategoryTheory AtomFoundation GeometryTransport CrossStageCoherence
open DoctrineFiberProduct

set_option maxHeartbeats 3000000

/-- The map action of exact geometry pullback is the universal factor
generated by the exact Cartesian lift. -/
@[simp] theorem exactGeometryPullFunctor_map
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    {first second : GeomFiber.{u, v} input.semantic.target}
    (hom : first ⟶ second) :
    (exactGeometryPullFunctor input).map hom =
      exactGeometryPullMap input hom :=
  rfl

/-- Projection of the exact complete-geometry lift is a lift of the authored
realized arrow between the corresponding core-fiber objects. -/
theorem exactGeometryPullLift_core_isHomLift
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    (target : GeomFiber.{u, v} input.semantic.target) :
    (packageProjection U).IsHomLift input.semantic.hom
      ((geometryProjection U).map
        (exactGeometryPullLift input target)) := by
  letI : (crossStageProjection.{u, v} U).IsHomLift input.semantic.hom
      (exactGeometryPullLift input target) :=
    exactGeometryPullLift_isHomLift input target
  exact CategoryTheory.IsHomLift.of_commsq
    (packageProjection U) input.semantic.hom
    ((geometryProjection U).map (exactGeometryPullLift input target))
    (exactGeometryPull input target).2 target.2
    (CategoryTheory.IsHomLift.commSq
      (crossStageProjection.{u, v} U) input.semantic.hom
      (exactGeometryPullLift input target)).w

/-- Projection of the exact complete-geometry lift is strongly Cartesian over
the authored realized arrow. -/
theorem exactGeometryPullLift_core_isStronglyCartesian
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    (target : GeomFiber.{u, v} input.semantic.target) :
    (packageProjection U).IsStronglyCartesian input.semantic.hom
      ((geometryProjection U).map
        (exactGeometryPullLift input target)) := by
  let projected := (geometryProjection U).map
    (exactGeometryPullLift input target)
  letI : (packageProjection U).IsStronglyCartesian
      ((packageProjection U).map projected) projected := by
    simpa only [projected, exactGeometryPullLift_coreProjection] using
      inverseCorePackageHom_isStronglyCartesian target.1.core
        (exactGeometryPullBaseHom input target)
  letI : (packageProjection U).IsHomLift input.semantic.hom projected := by
    exact exactGeometryPullLift_core_isHomLift input target
  exact stronglyCartesian_of_isHomLift
    (packageProjection U) input.semantic.hom projected

/-- The projected exact pull object is canonically isomorphic to the object
chosen by the existing core reindexing functor. -/
noncomputable def exactGeometryPullProjectionIsoApp
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    (target : GeomFiber.{u, v} input.semantic.target) :
    ((exactGeometryPullFunctor input ⋙
      geometryFiberProjection input.semantic.source).obj target) ≅
      ((geometryFiberProjection input.semantic.target ⋙
        selectedCoreFiberReindexFunctor input).obj target) := by
  let exactLift := (geometryProjection U).map
    (exactGeometryPullLift input target)
  let selectedLift :=
    (selectedCoreFiberCartesianLift input
      ((geometryFiberProjection input.semantic.target).obj target)).hom
  letI : (packageProjection U).IsStronglyCartesian
      input.semantic.hom exactLift :=
    exactGeometryPullLift_core_isStronglyCartesian input target
  letI : (packageProjection U).IsStronglyCartesian
      input.semantic.hom selectedLift :=
    (selectedCoreFiberCartesianLift input
      ((geometryFiberProjection input.semantic.target).obj target)).isStronglyCartesian
  have base_fac : input.semantic.hom =
      (Iso.refl input.semantic.source).hom ≫ input.semantic.hom := by
    simp
  let comparison :=
    CategoryTheory.Functor.IsStronglyCartesian.domainIsoOfBaseIso
    (p := packageProjection U)
    (g := Iso.refl input.semantic.source)
    (f := input.semantic.hom) (f' := input.semantic.hom)
    base_fac selectedLift exactLift
  exact
    { hom := ⟨comparison.hom, by
        change (packageProjection U).IsHomLift
          (Iso.refl input.semantic.source).hom comparison.hom
        infer_instance⟩
      inv := ⟨comparison.inv, by
        change (packageProjection U).IsHomLift
          (Iso.refl input.semantic.source).inv comparison.inv
        infer_instance⟩
      hom_inv_id := by
        apply CategoryTheory.Functor.Fiber.hom_ext
        exact comparison.hom_inv_id
      inv_hom_id := by
        apply CategoryTheory.Functor.Fiber.hom_ext
        exact comparison.inv_hom_id }

/-- The comparison hom factors the selected core lift as the projection of
the exact complete-geometry lift. -/
theorem exactGeometryPullProjectionIsoApp_hom_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    (target : GeomFiber.{u, v} input.semantic.target) :
    (exactGeometryPullProjectionIsoApp input target).hom.1 ≫
        (selectedCoreFiberCartesianLift input
          ((geometryFiberProjection input.semantic.target).obj target)).hom =
      (geometryProjection U).map
        (exactGeometryPullLift input target) := by
  let exactLift := (geometryProjection U).map
    (exactGeometryPullLift input target)
  let selectedLift :=
    (selectedCoreFiberCartesianLift input
      ((geometryFiberProjection input.semantic.target).obj target)).hom
  letI : (packageProjection U).IsStronglyCartesian
      input.semantic.hom exactLift :=
    exactGeometryPullLift_core_isStronglyCartesian input target
  letI : (packageProjection U).IsStronglyCartesian
      input.semantic.hom selectedLift :=
    (selectedCoreFiberCartesianLift input
      ((geometryFiberProjection input.semantic.target).obj target)).isStronglyCartesian
  have base_fac : input.semantic.hom =
      (Iso.refl input.semantic.source).hom ≫ input.semantic.hom := by
    simp
  exact CategoryTheory.Functor.IsStronglyCartesian.fac
    (packageProjection U) input.semantic.hom selectedLift
    base_fac exactLift

/-- Core projection carries the defining exact-geometry factorization to the
defining factorization for the projected vertical map. -/
theorem exactGeometryPullMap_core_fac
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    {first second : GeomFiber.{u, v} input.semantic.target}
    (hom : first ⟶ second) :
    ((geometryFiberProjection input.semantic.source).map
        (exactGeometryPullMap input hom)).1 ≫
        (geometryProjection U).map
          (exactGeometryPullLift input second) =
      (geometryProjection U).map
          (exactGeometryPullLift input first) ≫
        ((geometryFiberProjection input.semantic.target).map hom).1 := by
  have factorization := congrArg (geometryProjection U).map
    (exactGeometryPullMap_fac input hom)
  simpa only [Functor.map_comp, geometryFiberProjection] using factorization

/-- The object comparisons commute with every vertical complete-geometry
morphism. -/
theorem exactGeometryPullProjectionIso_naturality
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    {first second : GeomFiber.{u, v} input.semantic.target}
    (hom : first ⟶ second) :
    (exactGeometryPullFunctor input ⋙
        geometryFiberProjection input.semantic.source).map hom ≫
        (exactGeometryPullProjectionIsoApp input second).hom =
      (exactGeometryPullProjectionIsoApp input first).hom ≫
        (geometryFiberProjection input.semantic.target ⋙
          selectedCoreFiberReindexFunctor input).map hom := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let selectedSecond := selectedCoreFiberCartesianLift input
    ((geometryFiberProjection input.semantic.target).obj second)
  letI : (packageProjection U).IsStronglyCartesian
      input.semantic.hom selectedSecond.hom :=
    selectedSecond.isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U) input.semantic.hom selectedSecond.hom
    (𝟙 input.semantic.source)
  change
    ((geometryFiberProjection input.semantic.source).map
        (exactGeometryPullMap input hom)).1 ≫
        (exactGeometryPullProjectionIsoApp input second).hom.1 ≫
          selectedSecond.hom =
      (exactGeometryPullProjectionIsoApp input first).hom.1 ≫
        ((selectedCoreFiberReindexFunctor input).map
          ((geometryFiberProjection input.semantic.target).map hom)).1 ≫
          selectedSecond.hom
  calc
    _ = ((geometryFiberProjection input.semantic.source).map
          (exactGeometryPullMap input hom)).1 ≫
        (geometryProjection U).map
          (exactGeometryPullLift input second) := by
      rw [exactGeometryPullProjectionIsoApp_hom_fac]
    _ = (geometryProjection U).map
          (exactGeometryPullLift input first) ≫
        ((geometryFiberProjection input.semantic.target).map hom).1 :=
      exactGeometryPullMap_core_fac input hom
    _ = ((exactGeometryPullProjectionIsoApp input first).hom.1 ≫
          (selectedCoreFiberCartesianLift input
            ((geometryFiberProjection input.semantic.target).obj first)).hom) ≫
        ((geometryFiberProjection input.semantic.target).map hom).1 := by
      rw [exactGeometryPullProjectionIsoApp_hom_fac]
    _ = (exactGeometryPullProjectionIsoApp input first).hom.1 ≫
        ((selectedCoreFiberCartesianLift input
          ((geometryFiberProjection input.semantic.target).obj first)).hom ≫
            ((geometryFiberProjection input.semantic.target).map hom).1) :=
      Category.assoc _ _ _
    _ = (exactGeometryPullProjectionIsoApp input first).hom.1 ≫
        (((selectedCoreFiberReindexFunctor input).map
          ((geometryFiberProjection input.semantic.target).map hom)).1 ≫
            selectedSecond.hom) := by
      rw [selectedCoreFiberReindexFunctor_map_fac]
    _ = _ := (Category.assoc _ _ _).symm

/-- Core projection of exact complete-geometry reindexing is naturally
isomorphic to the existing selected core reindexing. -/
noncomputable def exactGeometryPullProjectionIso
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U) :
    exactGeometryPullFunctor.{u, v} input ⋙
        geometryFiberProjection input.semantic.source ≅
      geometryFiberProjection input.semantic.target ⋙
        selectedCoreFiberReindexFunctor input :=
  NatIso.ofComponents (exactGeometryPullProjectionIsoApp input)
    (fun hom => exactGeometryPullProjectionIso_naturality input hom)

/-- Exact pullback preserves the coefficient map of every vertical geometry
morphism, as forced by the lift factorization and the identity coefficient
maps of both exact lifts. -/
theorem exactGeometryPullMap_coefficientHom
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (input : RealizableHom U)
    {first second : GeomFiber.{u, v} input.semantic.target}
    (hom : first ⟶ second) :
    (exactGeometryPullMap input hom).1.geometry.coefficientHom =
      hom.1.geometry.coefficientHom := by
  have factorization := congrArg
    (fun totalHom => totalHom.geometry.coefficientHom)
    (exactGeometryPullMap_fac input hom)
  change
    (exactGeometryPullLift input second).geometry.coefficientHom.comp
        (exactGeometryPullMap input hom).1.geometry.coefficientHom =
      hom.1.geometry.coefficientHom.comp
        (exactGeometryPullLift input first).geometry.coefficientHom
    at factorization
  rw [exactGeometryPullLift_coefficientHom,
    exactGeometryPullLift_coefficientHom] at factorization
  simpa only [RingHom.id_comp, RingHom.comp_id] using factorization

end AAT.AG.FullGeometryNormalization

#assert_standard_axioms_only AAT.AG.FullGeometryNormalization
