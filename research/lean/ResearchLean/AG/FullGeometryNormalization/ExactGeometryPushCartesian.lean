    (W : K.site.category) (observable : W.ctx.Observable) :
    geomTransportObservableComp G sigma (contextForward factorBase W)
        (incomingGeometryFactorObservableComp G K sigma factorBase
          { base := PackageTotalHom.comp factorBase
