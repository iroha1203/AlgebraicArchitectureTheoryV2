/-- Componentwise cancellation identifies the generated geometry factor
followed by canonical geometry transport with the incoming geometry data. -/
theorem incomingGeometryFactorGeometryHom_fac_exact
    {U : AtomCarrier.{u}}
    (G K : GeometryPackage.{u, v} U)
    {E : ExtractionDoctrine U}
    (sigma : ExactDoctrineHom G.core.reading.doctrine E)
    (factorBase : PackageTotalHom K.core G.core)
    (hom : GeomReadHom K (geomTransportAlong G sigma)
      (PackageTotalHom.comp factorBase (transportAlongHom G.core sigma))) :
    GeomReadHom.comp
        (incomingGeometryFactorGeometryHom G K sigma factorBase
          { base := PackageTotalHom.comp factorBase
              (transportAlongHom G.core sigma)
            geometry := hom } rfl)
        (geomTransportAlongGeometryHom G sigma) = hom := by
  apply GeomReadHom.ext
  · rfl
  · apply heq_of_eq
    funext W support
    exact incomingGeometryFactorSupportComp_fac_exact
      G K sigma factorBase hom W support
  · apply heq_of_eq
    funext W axis
    exact incomingGeometryFactorAxisComp_fac_exact
      G K sigma factorBase hom W axis
  · apply heq_of_eq
    funext W observable
    exact incomingGeometryFactorObservableComp_fac_exact
      G K sigma factorBase hom W observable

/-- Cancelling canonical transport after composing an arbitrary incoming
geometry factor reconstructs that factor. -/
theorem incomingGeometryFactor_of_composite
    {U : AtomCarrier.{u}}
    (G K : GeometryPackage.{u, v} U)
    {E : ExtractionDoctrine U}
    (sigma : ExactDoctrineHom G.core.reading.doctrine E)
    (factorBase : PackageTotalHom K.core G.core)
    (factor : GeomReadHom K G factorBase) :
    incomingGeometryFactorGeometryHom G K sigma factorBase
        { base := PackageTotalHom.comp factorBase
            (transportAlongHom G.core sigma)
          geometry := GeomReadHom.comp factor
            (geomTransportAlongGeometryHom G sigma) } rfl =
      factor := by
  apply GeomReadHom.ext
  · rfl
  · apply heq_of_eq
    funext W support
    unfold incomingGeometryFactorGeometryHom
      incomingGeometryFactorSupportComp
    have hproof :
        incomingGeometryFactorContext_eq G K sigma factorBase
          { base := PackageTotalHom.comp factorBase
              (transportAlongHom G.core sigma)
            geometry := GeomReadHom.comp factor
              (geomTransportAlongGeometryHom G sigma) } rfl W = rfl := by
      apply Subsingleton.elim
    change
      (transportCoreSupportEquiv G.core.reading sigma
          (contextForward factorBase W)).symm
        (supportEquivOfContextEq
          (incomingGeometryFactorContext_eq G K sigma factorBase
            { base := PackageTotalHom.comp factorBase
                (transportAlongHom G.core sigma)
              geometry := GeomReadHom.comp factor
                (geomTransportAlongGeometryHom G sigma) } rfl W)
          (geomTransportSupportComp G sigma (contextForward factorBase W)
            (factor.supportComp W support))) = factor.supportComp W support
    rw [hproof]
    exact Equiv.symm_apply_apply _ _
  · apply heq_of_eq
    funext W axis
    unfold incomingGeometryFactorGeometryHom
      incomingGeometryFactorAxisComp
    have hproof :
        incomingGeometryFactorContext_eq G K sigma factorBase
          { base := PackageTotalHom.comp factorBase
              (transportAlongHom G.core sigma)
            geometry := GeomReadHom.comp factor
              (geomTransportAlongGeometryHom G sigma) } rfl W = rfl := by
      apply Subsingleton.elim
    change
      (transportCoreAxisEquiv G.core.reading sigma
          (contextForward factorBase W)).symm
        (axisEquivOfContextEq
          (incomingGeometryFactorContext_eq G K sigma factorBase
            { base := PackageTotalHom.comp factorBase
                (transportAlongHom G.core sigma)
              geometry := GeomReadHom.comp factor
                (geomTransportAlongGeometryHom G sigma) } rfl W)
          (geomTransportAxisComp G sigma (contextForward factorBase W)
            (factor.axisComp W axis))) = factor.axisComp W axis
    rw [hproof]
    exact Equiv.symm_apply_apply _ _
  · apply heq_of_eq
    funext W observable
    unfold incomingGeometryFactorGeometryHom
      incomingGeometryFactorObservableComp
    have hproof :
        incomingGeometryFactorContext_eq G K sigma factorBase
          { base := PackageTotalHom.comp factorBase
              (transportAlongHom G.core sigma)
            geometry := GeomReadHom.comp factor
              (geomTransportAlongGeometryHom G sigma) } rfl W = rfl := by
      apply Subsingleton.elim
    change
      (transportCoreObservableEquiv G.core.reading sigma
          (contextForward factorBase W)).symm
        (observableEquivOfContextEq
          (incomingGeometryFactorContext_eq G K sigma factorBase
            { base := PackageTotalHom.comp factorBase
                (transportAlongHom G.core sigma)
              geometry := GeomReadHom.comp factor
                (geomTransportAlongGeometryHom G sigma) } rfl W)
          (geomTransportObservableComp G sigma (contextForward factorBase W)
            (factor.observableComp W observable))) =
        factor.observableComp W observable
    rw [hproof]
    exact Equiv.symm_apply_apply _ _

/-- Componentwise cancellation for an incoming total hom after dependent base
normalization. -/
theorem incomingGeometryFactorGeometryHom_fac
    {U : AtomCarrier.{u}}
    (G K : GeometryPackage.{u, v} U)
    {E : ExtractionDoctrine U}
    (sigma : ExactDoctrineHom G.core.reading.doctrine E)
    (factorBase : PackageTotalHom K.core G.core)
    (h : GeometryTotalHom K (geomTransportAlong G sigma))
    (hbase : h.base = PackageTotalHom.comp factorBase
      (transportAlongHom G.core sigma)) :
    GeomReadHom.comp
        (incomingGeometryTotalFactor G K sigma factorBase h hbase).geometry
        (geomTransportAlongGeometryHom G sigma) =
      GeomReadHom.castBase hbase h.geometry := by
  exact incomingGeometryFactorGeometryHom_fac_exact G K sigma factorBase
    (GeomReadHom.castBase hbase h.geometry)

/-- The generated incoming geometry factor followed by canonical transport is
the authored incoming hom. -/
theorem incomingGeometryTotalFactor_fac
    {U : AtomCarrier.{u}}
    (G K : GeometryPackage.{u, v} U)
    {E : ExtractionDoctrine U}
    (sigma : ExactDoctrineHom G.core.reading.doctrine E)
    (factorBase : PackageTotalHom K.core G.core)
    (h : GeometryTotalHom K (geomTransportAlong G sigma))
    (hbase : h.base = PackageTotalHom.comp factorBase
      (transportAlongHom G.core sigma)) :
    GeometryTotalHom.comp
        (incomingGeometryTotalFactor G K sigma factorBase h hbase)
        (geomTransportAlongHom G sigma) = h := by
  apply GeometryTotalHom.ext
  · exact hbase.symm
  · exact (heq_of_eq
      (incomingGeometryFactorGeometryHom_fac
        G K sigma factorBase h hbase)).trans
      (geomReadHom_castBase_heq hbase h.geometry)

private theorem geomReadHom_comp_castBase_left_heq
    {U : AtomCarrier.{u}}
    {G H K : GeometryPackage.{u, v} U}
    {first first' : PackageTotalHom G.core H.core}
    {second : PackageTotalHom H.core K.core}
    (hfirst : first = first') (head : GeomReadHom G H first)
    (tail : GeomReadHom H K second) :
    HEq (GeomReadHom.comp (GeomReadHom.castBase hfirst head) tail)
      (GeomReadHom.comp head tail) := by
  cases hfirst
  rfl

private theorem geometry_heq_of_total_eq
    {U : AtomCarrier.{u}}
    {G H : GeometryPackage.{u, v} U}
    {first second : GeometryTotalHom G H}
    (h : first = second) : HEq first.geometry second.geometry := by
  cases h
  rfl

/-- Every incoming total factor over a fixed lower factor is the generated
factor.  The only hypothesis about the candidate is its factor equation. -/
theorem incomingGeometryTotalFactor_unique
    {U : AtomCarrier.{u}}
    (G K : GeometryPackage.{u, v} U)
    {E : ExtractionDoctrine U}
    (sigma : ExactDoctrineHom G.core.reading.doctrine E)
    (factorBase : PackageTotalHom K.core G.core)
    (h : GeometryTotalHom K (geomTransportAlong G sigma))
    (hbase : h.base = PackageTotalHom.comp factorBase
      (transportAlongHom G.core sigma))
    (candidate : GeometryTotalHom K G)
    (candidateBase : candidate.base = factorBase)
    (candidateFac : GeometryTotalHom.comp candidate
      (geomTransportAlongHom G sigma) = h) :
    candidate = incomingGeometryTotalFactor G K sigma factorBase h hbase := by
  let candidateGeometry := GeomReadHom.castBase candidateBase candidate.geometry
  let normalizedH := GeomReadHom.castBase hbase h.geometry
  have hnormalized : GeomReadHom.comp candidateGeometry
      (geomTransportAlongGeometryHom G sigma) = normalizedH := by
    apply eq_of_heq
    exact ((geomReadHom_comp_castBase_left_heq candidateBase candidate.geometry
      (geomTransportAlongGeometryHom G sigma)).trans
        (geometry_heq_of_total_eq candidateFac)).trans
          (geomReadHom_castBase_heq hbase h.geometry).symm
  have hgeometry : candidateGeometry =
      (incomingGeometryTotalFactor G K sigma factorBase h hbase).geometry := by
    calc
      candidateGeometry = incomingGeometryFactorGeometryHom G K sigma factorBase
          { base := PackageTotalHom.comp factorBase
              (transportAlongHom G.core sigma)
            geometry := GeomReadHom.comp candidateGeometry
              (geomTransportAlongGeometryHom G sigma) } rfl :=
        (incomingGeometryFactor_of_composite G K sigma factorBase
          candidateGeometry).symm
      _ = incomingGeometryFactorGeometryHom G K sigma factorBase
          { base := PackageTotalHom.comp factorBase
              (transportAlongHom G.core sigma)
            geometry := normalizedH } rfl := by
        rw [hnormalized]
      _ = (incomingGeometryTotalFactor G K sigma factorBase h hbase).geometry := rfl
  apply GeometryTotalHom.ext
  · exact candidateBase
  · exact (geomReadHom_castBase_heq candidateBase candidate.geometry).symm.trans
      (heq_of_eq hgeometry)

/-- The generated incoming factor is the unique total factor over the fixed
lower Cartesian factor. -/
theorem geomTransportAlongHom_incomingFactor_existsUnique
    {U : AtomCarrier.{u}}
    (G K : GeometryPackage.{u, v} U)
    {E : ExtractionDoctrine U}
    (sigma : ExactDoctrineHom G.core.reading.doctrine E)
    (factorBase : PackageTotalHom K.core G.core)
    (h : GeometryTotalHom K (geomTransportAlong G sigma))
    (hbase : h.base = PackageTotalHom.comp factorBase
      (transportAlongHom G.core sigma)) :
    ∃! factor : GeometryTotalHom K G,
      factor.base = factorBase ∧
        GeometryTotalHom.comp factor (geomTransportAlongHom G sigma) = h := by
  refine ⟨incomingGeometryTotalFactor G K sigma factorBase h hbase,
    ⟨rfl, incomingGeometryTotalFactor_fac G K sigma factorBase h hbase⟩, ?_⟩
  intro candidate hcandidate
  exact incomingGeometryTotalFactor_unique G K sigma factorBase h hbase
    candidate hcandidate.1 hcandidate.2

/-- Canonical complete-geometry push transport is strongly Cartesian over its
actual core-package morphism.  Its incoming factor is constructed above by
cancelling the canonical local-carrier equivalences. -/
theorem geomTransportAlongHom_isStronglyCartesian
    {U : AtomCarrier.{u}}
    (G : GeometryPackage.{u, v} U)
    {E : ExtractionDoctrine U}
    (sigma : ExactDoctrineHom G.core.reading.doctrine E) :
    (geometryProjection U).IsStronglyCartesian
      (transportAlongHom G.core sigma)
      (geomTransportAlongHom G sigma) := by
  letI : (geometryProjection U).IsHomLift
      (transportAlongHom G.core sigma) (geomTransportAlongHom G sigma) := by
    change (geometryProjection U).IsHomLift
      ((geometryProjection U).map (geomTransportAlongHom G sigma))
      (geomTransportAlongHom G sigma)
    infer_instance
  apply CategoryTheory.Functor.IsStronglyCartesian.mk
  rintro (K : GeomReadCategory.{u, v} U)
    (factorBase : PackageTotalHom K.core G.core)
    (h : GeometryTotalHom K (geomTransportAlong G sigma)) hLift
  letI : (geometryProjection U).IsHomLift
      (PackageTotalHom.comp factorBase (transportAlongHom G.core sigma)) h := hLift
  have hbase : h.base = PackageTotalHom.comp factorBase
      (transportAlongHom G.core sigma) := by
    have hbase' := CategoryTheory.IsHomLift.eq_of_isHomLift
      (p := geometryProjection U)
      (a := K) (b := geomTransportAlong G sigma)
      (f := (show K.core ⟶ (geomTransportAlong G sigma).core from
        PackageTotalHom.comp factorBase
          (transportAlongHom G.core sigma)))
      (φ := h)
    change PackageTotalHom.comp factorBase
      (transportAlongHom G.core sigma) = h.base at hbase'
    exact hbase'.symm
  rcases geomTransportAlongHom_incomingFactor_existsUnique
      G K sigma factorBase h hbase with ⟨factor, hfactor, hunique⟩
  refine ⟨factor, ?_, ?_⟩
  · constructor
    · rw [← hfactor.1]
      change (geometryProjection U).IsHomLift
        ((geometryProjection U).map factor) factor
      infer_instance
    · exact hfactor.2
  · intro candidate hcandidate
    apply hunique candidate
    constructor
    · letI : (geometryProjection U).IsHomLift factorBase candidate :=
        hcandidate.1
      exact (CategoryTheory.IsHomLift.eq_of_isHomLift
        (geometryProjection U) factorBase candidate).symm
    · exact hcandidate.2

/-- Canonical complete-geometry push transport is strongly Cartesian for the
composed projection over its definitionally projected pointed arrow. -/
theorem geomTransportAlongHom_crossStageStronglyCartesian_map
    {U : AtomCarrier.{u}}
    (G : GeometryPackage.{u, v} U)
    {E : ExtractionDoctrine U}
    (sigma : ExactDoctrineHom G.core.reading.doctrine E) :
    (crossStageProjection.{u, v} U).IsStronglyCartesian
      ((crossStageProjection.{u, v} U).map
        (geomTransportAlongHom G sigma))
      (geomTransportAlongHom G sigma) := by
  letI : (geometryProjection U).IsStronglyCartesian
      ((geometryProjection U).map (geomTransportAlongHom G sigma))
      (geomTransportAlongHom G sigma) := by
    simpa using geomTransportAlongHom_isStronglyCartesian G sigma
  letI : (packageProjection U).IsStronglyCartesian
      ((packageProjection U).map
        ((geometryProjection U).map (geomTransportAlongHom G sigma)))
      ((geometryProjection U).map (geomTransportAlongHom G sigma)) := by
    simpa using AAT.AG.DoctrineFiberProduct.transportAlongHom_isStronglyCartesian
      G.core sigma
  exact stronglyCartesian_comp_projection
    (geometryProjection U) (packageProjection U)
    (geomTransportAlongHom G sigma)

/-- G-122 B1: the canonical complete-geometry fiber push is strongly
Cartesian over the authored semantic hom, not merely over its projected map. -/
theorem geomFiberLift_crossStageStronglyCartesian
    {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U} (sigma : X ⟶ Y)
    (G : GeomFiber.{u, v} X) :
    (crossStageProjection.{u, v} U).IsStronglyCartesian sigma
      (geomFiberLift sigma G) := by
  letI : (crossStageProjection.{u, v} U).IsStronglyCartesian
      ((crossStageProjection.{u, v} U).map (geomFiberLift sigma G))
      (geomFiberLift sigma G) :=
    geomTransportAlongHom_crossStageStronglyCartesian_map
      G.1 (geomFiberBaseHom sigma G).doctrineHom
  letI : (crossStageProjection.{u, v} U).IsHomLift sigma
      (geomFiberLift sigma G) := geomFiberLift_isHomLift sigma G
  exact stronglyCartesian_of_isHomLift
    (crossStageProjection.{u, v} U) sigma (geomFiberLift sigma G)

end AAT.AG.FullGeometryNormalization

