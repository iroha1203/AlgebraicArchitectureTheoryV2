    geomTransportSupportComp G sigma (contextForward factorBase W)
        (incomingGeometryFactorSupportComp G K sigma factorBase
          { base := PackageTotalHom.comp factorBase
              (transportAlongHom G.core sigma)
            geometry := hom } rfl W support) =
      hom.supportComp W support := by
  unfold incomingGeometryFactorSupportComp geomTransportSupportComp
  rw [incomingGeometryFactorContext_eq_exact G K sigma factorBase hom W]
  exact Equiv.apply_symm_apply _ _

private theorem incomingGeometryFactorAxisComp_fac_exact
