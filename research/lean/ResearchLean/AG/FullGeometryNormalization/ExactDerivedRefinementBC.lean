import ResearchLean.AG.CrossStageCoherence.TowerCompatibility
import ResearchLean.AG.DoctrineFiberProduct.BCRelativeSchema
import ResearchLean.AG.DoctrineFiberProduct.RefinementBaseChange.Qualification
import ResearchLean.AG.DoctrineFiberProduct.RefinementBaseChange.Supply
import ResearchLean.AG.DoctrineFiberProduct.UpperGeometryCompatibleMateNaturality

/-!
# Exact-derived refinement base change at one authored cell

This module turns one realized Beck--Chevalley square and one complete geometry
at an authored southwest endpoint into the exact stratum of the G-114
refinement construction.  The compatible source, exact-image witness, active
condition, and active context are all generated from the original square.

The G-118 compatible input is deliberately localized to a one-vertex
presentation with no edges or higher cells.  Thus its root paths and transport
fields are generated internally from the transported geometry, without an
assumption that the vertices of the original diagnostic lie in one fiber or
that they are reachable from a selected root.
-/

namespace AAT.AG.FullGeometryNormalization

universe u v

open CategoryTheory AtomFoundation GeometryTransport CrossStageCoherence
open DoctrineFiberProduct TransportCoherence

set_option maxHeartbeats 3000000

/-- The G-122 table of G-114 doctrines and arrows generated by the original
exact Beck--Chevalley square. -/
noncomputable def authoredExactRefinementBCConfiguration
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) : RefinementBCConfiguration U :=
  let square := A.context.square.semantic.square
  { sOnePrime := square.southwest.doctrine
    sOne := square.southeast.doctrine
    sTwo := square.northeast.doctrine
    bottom := square.southeast.doctrine
    fst := ExactDoctrineHom.id square.southeast.doctrine
    snd := square.right.doctrineHom
    refinement := exactToRefinement square.bottom.doctrineHom }

/-- The original southwest and northeast selected sources form the compatible
source of the exact-derived refinement configuration. -/
noncomputable def authoredExactRefinementBCCompatibleSource
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) :
    (authoredExactRefinementBCConfiguration A).CompatibleSource := by
  let square := A.context.square.semantic.square
  let points := A.context.square.semantic.compatiblePoints
  refine
    { sourcePrime := points.southwest
      sourceTwo := points.northeast
      bottom_eq := ?_ }
  change (ExactDoctrineHom.id square.southeast.doctrine).sourceMap
      ((exactToRefinement square.bottom.doctrineHom).sourceMap points.southwest) =
    square.right.doctrineHom.sourceMap points.northeast
  change square.bottom.doctrineHom.sourceMap points.southwest =
    square.right.doctrineHom.sourceMap points.northeast
  exact points.bottom_eq.trans points.right_eq.symm

/-- The exact-derived refinement is literally the comparison image of the
original bottom exact doctrine morphism. -/
theorem authoredExactRefinementBC_exactImage
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) :
    RefinementExactComparisonImage
      (authoredExactRefinementBCConfiguration A) := by
  exact ⟨A.context.square.semantic.square.bottom.doctrineHom, rfl⟩

/-- The active realized-reflection condition is derived from exactness rather
than supplied as a certificate. -/
theorem authoredExactRefinementBC_condition
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) :
    RealizedLocusExtractionReflecting
      ((authoredExactRefinementBCConfiguration A).baseRefinementAt
        (authoredExactRefinementBCCompatibleSource A)) :=
  (configurationRealizedReflection_of_exactImage
    (authoredExactRefinementBCConfiguration A)
    (authoredExactRefinementBC_exactImage A))
      (authoredExactRefinementBCCompatibleSource A)

/-- The generated target point is the southeast selected point of the
original square. -/
theorem authoredExactRefinementBCTargetPoint_eq
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) :
    (authoredExactRefinementBCConfiguration A).targetPointAt
        (authoredExactRefinementBCCompatibleSource A) =
      A.context.square.semantic.square.southeast := by
  rcases A with ⟨⟨⟨semantic, presentation, realization_eq⟩,
    lift, endpoint_eq⟩, twoCellBase, authored⟩
  cases realization_eq
  apply ExtractionInstance.ext
  · rfl
  · apply heq_of_eq
    change (toSemanticBC presentation).square.bottom.doctrineHom.sourceMap
        (toSemanticBC presentation).compatiblePoints.southwest =
      (toSemanticBC presentation).square.southeast.source
    exact (toSemanticBC presentation).square.bottom.source_eq

/-- Regard the authored fixed-coefficient geometry as an object of the
southwest complete-geometry fiber. -/
def authoredSouthwestGeometryFiberAt
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) (z : A.context.Category)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt (A.context.supportPackage z.as) k) :
    GeomFiber A.context.square.semantic.square.southwest :=
  ⟨g.package, A.context.endpoint_eq z.as⟩

/-- The complete geometry `q_z = (sigma_1)_! g_z` in the southeast fiber. -/
noncomputable def authoredExactTargetGeometryAt
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) (z : A.context.Category)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt (A.context.supportPackage z.as) k) :
    GeomFiber A.context.square.semantic.square.southeast :=
  (geomFiberTransportFunctor A.context.square.semantic.square.bottom).obj
    (authoredSouthwestGeometryFiberAt A z k g)

/-- The target core package `Q_z`, retagged from the southeast point to the
definitionally generated G-114 target point.  Its underlying package is the
core projection of `q_z`, hence definitionally the canonical core transport. -/
noncomputable def authoredExactTargetPackageAt
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) (z : A.context.Category)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt (A.context.supportPackage z.as) k) :
    CoreFiber
      ((authoredExactRefinementBCConfiguration A).targetPointAt
        (authoredExactRefinementBCCompatibleSource A)) :=
  let q := authoredExactTargetGeometryAt A z k g
  ⟨q.1.core, q.2.trans (authoredExactRefinementBCTargetPoint_eq A).symm⟩

/-- The active G-114 context derived from the exact square and the transported
target package. -/
noncomputable def authoredExactRefinementBCContextAt
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) (z : A.context.Category)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt (A.context.supportPackage z.as) k) :
    ActiveRefinementBCContext U :=
  activeRefinementBCContextOfCondition
    (authoredExactRefinementBCConfiguration A)
    (authoredExactRefinementBCCompatibleSource A)
    (authoredExactTargetPackageAt A z k g)
    (authoredExactRefinementBC_condition A)

/-! ## Cell-local compatible source -/

/-- A single vertex and no nonidentity generators or higher cells. -/
abbrev exactDerivedPointPresentation
    (_U : AtomCarrier.{u}) : FiniteTransportPresentation.{u} where
  Vertex := PUnit
  vertexFintype := inferInstance
  Edge := fun _ _ => PEmpty
  edgeFintype := fun _ _ => inferInstance
  TwoCell := PEmpty
  twoCellFintype := inferInstance
  twoSource := fun cell => nomatch cell
  twoTarget := fun cell => nomatch cell
  twoLeft := fun cell => nomatch cell
  twoRight := fun cell => nomatch cell
  ThreeCell := PEmpty
  threeCellFintype := inferInstance
  threeSource := fun cell => nomatch cell
  threeTarget := fun cell => nomatch cell
  threeStart := fun cell => nomatch cell
  threeFinish := fun cell => nomatch cell
  threeLeft := fun cell => nomatch cell
  threeRight := fun cell => nomatch cell

/-- The constant one-object source diagram at `Q_z`. -/
noncomputable def authoredExactSourceFiberDiagramAt
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) (z : A.context.Category)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt (A.context.supportPackage z.as) k) :
    PresentedPathCategory (exactDerivedPointPresentation U) ⥤
      CoreFiber
        ((authoredExactRefinementBCConfiguration A).targetPointAt
          (authoredExactRefinementBCCompatibleSource A)) where
  obj _ := authoredExactTargetPackageAt A z k g
  map _ := 𝟙 (authoredExactTargetPackageAt A z k g)
  map_id _ := rfl
  map_comp _ _ := by simp

/-- The transported geometry `q_z`, read over the constant target package. -/
noncomputable def authoredExactSourceGeometryAt
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) (z : A.context.Category)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt (A.context.supportPackage z.as) k)
    (_ : (exactDerivedPointPresentation U).Vertex) :
    FixedCoefficientGeometryAt
      ((authoredExactSourceFiberDiagramAt A z k g).obj ⟨PUnit.unit⟩).1 k where
  geometry := (authoredExactTargetGeometryAt A z k g).1.geometry
  raw := (authoredExactTargetGeometryAt A z k g).1.raw

/-- The unique transport on the edge- and cell-free local presentation. -/
noncomputable def authoredExactSourceTransportAt
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) (z : A.context.Category)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt (A.context.supportPackage z.as) k) :
    FixedCoefficientTwoLayerTransportOver (exactDerivedPointPresentation U)
      (authoredExactSourceFiberDiagramAt A z k g) k
      (authoredExactSourceGeometryAt A z k g) where
  edgeLift edge := nomatch edge
  edge_base edge := nomatch edge
  edgeGeometryStrong edge := nomatch edge
  edgeCoreStrong edge := nomatch edge
  twoCellBase cell := nomatch cell
  comparator cell := nomatch cell
  edge_coefficient_id edge := nomatch edge
  comparator_coefficient_id cell := nomatch cell

/-- The certificate-free G-118 compatible input generated solely from `q_z`.
All finite transport obligations are vacuous on the cell-local presentation. -/
noncomputable def authoredExactCompatibleProblemDataAt
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) (z : A.context.Category)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt (A.context.supportPackage z.as) k) :
    UpperGeometryCompatibleProblemInputData
      (authoredExactRefinementBCContextAt A z k g)
      (exactDerivedPointPresentation U) (CommRingCat.of k) where
  root := PUnit.unit
  rootPath _ := .nil PUnit.unit
  sourceFiberDiagram := authoredExactSourceFiberDiagramAt A z k g
  sourceGeometry := authoredExactSourceGeometryAt A z k g
  sourceTransport := authoredExactSourceTransportAt A z k g

/-- The existing G-118 generated complete-geometry mate, specialized to the
exact-derived one-cell compatible input. -/
noncomputable def authoredExactGeneratedCompatibleUpperGeometryMateAt
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) (z : A.context.Category)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt (A.context.supportPackage z.as) k) :=
  (authoredExactCompatibleProblemDataAt A z k g).generatedCompatibleUpperGeometryMateAt
    PUnit.unit

end AAT.AG.FullGeometryNormalization

#assert_standard_axioms_only AAT.AG.FullGeometryNormalization
