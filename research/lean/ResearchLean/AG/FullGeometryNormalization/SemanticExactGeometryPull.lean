import ResearchLean.AG.DoctrineFiberProduct.UpperGeometryCartesian
import ResearchLean.AG.CrossStageCoherence.FiberTransport

/-!
# Semantic exact complete-geometry pullback

A complete geometry in the fiber over `Y` pulls back along any `ExtInstHom X Y`.
The construction uses the exact geometry cleavage and its Cartesian universal
property, without a realization or a finite presentation of the arrow.
-/

namespace AAT.AG.FullGeometryNormalization

universe u v u₁ u₂ u₃ v₁ v₂ v₃

open CategoryTheory AtomFoundation GeometryTransport CrossStageCoherence
open DoctrineFiberProduct

set_option maxHeartbeats 3000000

/-- The pointed exact arrow obtained from a semantic arrow and the target
geometry fiber equality. -/
noncomputable def semanticGeometryPullBaseHom
    {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U}
    (input : ExtInstHom X Y)
    (target : GeomFiber.{u, v} Y) :
    X ⟶ packagePoint target.1.core :=
  input ≫ eqToHom target.2.symm

/-- The canonical complete geometry pulled back along a semantic arrow. -/
noncomputable def semanticGeometryPullObject
    {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U}
    (input : ExtInstHom X Y)
    (target : GeomFiber.{u, v} Y) :
    GeomReadCategory.{u, v} U :=
  UpperGeometryCleavage.exactSourceGeometry target.1
    (semanticGeometryPullBaseHom input target)

/-- The canonical pullback geometry lies over the source of the semantic
arrow. -/
theorem semanticGeometryPullObject_point
    {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U}
    (input : ExtInstHom X Y)
    (target : GeomFiber.{u, v} Y) :
    (crossStageProjection.{u, v} U).obj
        (semanticGeometryPullObject input target) = X := by
  change packagePoint
      (UpperGeometryCleavage.exactSourceGeometry target.1
        (semanticGeometryPullBaseHom input target)).core = X
  rw [UpperGeometryCleavage.exactSourceGeometry_core]
  exact inverseCorePackage_point target.1.core
    (semanticGeometryPullBaseHom input target)

/-- The canonical complete-geometry pullback, placed in the source fiber. -/
noncomputable def semanticGeometryPull
    {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U}
    (input : ExtInstHom X Y)
    (target : GeomFiber.{u, v} Y) :
    GeomFiber.{u, v} X :=
  ⟨semanticGeometryPullObject input target,
    semanticGeometryPullObject_point input target⟩

/-- The exact pullback retains the target coefficient ring definitionally;
the simp normal form points from the generated object to the input target. -/
@[simp] theorem semanticGeometryPull_coefficient
    {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U}
    (input : ExtInstHom X Y)
    (target : GeomFiber.{u, v} Y) :
    (semanticGeometryPull input target).1.Coefficient = target.1.Coefficient :=
  UpperGeometryCleavage.exactSourceGeometry_coefficient_eq target.1
    (semanticGeometryPullBaseHom input target)

/-- The core of the complete-geometry pullback is the canonical exact inverse
package over the semantic arrow; the simp normal form exposes that predecessor
construction. -/
@[simp] theorem semanticGeometryPull_core
    {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U}
    (input : ExtInstHom X Y)
    (target : GeomFiber.{u, v} Y) :
    (semanticGeometryPull input target).1.core =
      inverseCorePackage target.1.core
        (semanticGeometryPullBaseHom input target) :=
  UpperGeometryCleavage.exactSourceGeometry_core target.1
    (semanticGeometryPullBaseHom input target)

/-- The complete exact geometry lift generated by the canonical cleavage. -/
noncomputable def semanticGeometryPullLift
    {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U}
    (input : ExtInstHom X Y)
    (target : GeomFiber.{u, v} Y) :
    (semanticGeometryPull input target).1 ⟶ target.1 :=
  UpperGeometryCleavage.generatedExactGeometryHom target.1
    (semanticGeometryPullBaseHom input target)

/-- The generated lift has the canonical exact inverse-package map as its
core projection; the simp normal form exposes the core-stage map. -/
@[simp] theorem semanticGeometryPullLift_coreProjection
    {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U}
    (input : ExtInstHom X Y)
    (target : GeomFiber.{u, v} Y) :
    (geometryProjection U).map (semanticGeometryPullLift input target) =
      UpperGeometryCleavage.exactBaseHom target.1
        (semanticGeometryPullBaseHom input target) :=
  rfl

/-- The coefficient component of the generated complete lift is the identity
under the definitional coefficient identification; the simp normal form removes
the generated coefficient map. -/
@[simp] theorem semanticGeometryPullLift_coefficientHom
    {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U}
    (input : ExtInstHom X Y)
    (target : GeomFiber.{u, v} Y) :
    (semanticGeometryPullLift input target).geometry.coefficientHom =
      RingHom.id target.1.Coefficient :=
  rfl

/-- The complete lift projects to the exact arrow obtained from the semantic
arrow and the target fiber equality. -/
@[simp] theorem semanticGeometryPullLift_crossStageProjection
    {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U}
    (input : ExtInstHom X Y)
    (target : GeomFiber.{u, v} Y) :
    (crossStageProjection.{u, v} U).map
        (semanticGeometryPullLift input target) =
      semanticGeometryPullBaseHom input target :=
  rfl

/-- After exact-to-refinement embedding, the generated complete lift is the
strongly cartesian geometry cleavage over its exact core projection. -/
theorem semanticGeometryPullLift_refinementStronglyCartesian
    {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U}
    (input : ExtInstHom X Y)
    (target : GeomFiber.{u, v} Y) :
    (refinementGeometryProjection U).IsStronglyCartesian
      ((exactPackageToRefinement U).map
        (UpperGeometryCleavage.exactBaseHom target.1
          (semanticGeometryPullBaseHom input target)))
      ((exactGeometryToRefinementGeometry U).map
        (semanticGeometryPullLift input target)) :=
  UpperGeometryCleavage.generatedExactGeometryHom_isStronglyCartesian
    target.1 (semanticGeometryPullBaseHom input target)

/-- The exact complete lift is strongly Cartesian over its exact core-package
projection.  Its universal factor is obtained in the refinement category and
then exactified over the original exact package map. -/
theorem semanticGeometryPullLift_geometryStronglyCartesian
    {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U}
    (input : ExtInstHom X Y)
    (target : GeomFiber.{u, v} Y) :
    (geometryProjection U).IsStronglyCartesian
      (UpperGeometryCleavage.exactBaseHom target.1
        (semanticGeometryPullBaseHom input target))
      (semanticGeometryPullLift input target) := by
  let lift := semanticGeometryPullLift input target
  let refinementLift := (exactGeometryToRefinementGeometry U).map lift
  letI : (refinementGeometryProjection U).IsStronglyCartesian
      ((exactPackageToRefinement U).map
        (UpperGeometryCleavage.exactBaseHom target.1
          (semanticGeometryPullBaseHom input target))) refinementLift :=
    semanticGeometryPullLift_refinementStronglyCartesian input target
  letI : (geometryProjection U).IsHomLift
      (UpperGeometryCleavage.exactBaseHom target.1
        (semanticGeometryPullBaseHom input target)) lift := by
    apply CategoryTheory.IsHomLift.of_fac'
      (geometryProjection U) _ lift rfl rfl
    rfl
  apply CategoryTheory.Functor.IsStronglyCartesian.mk
  intro K g h hLift
  letI : (geometryProjection U).IsHomLift
      (g ≫ UpperGeometryCleavage.exactBaseHom target.1
        (semanticGeometryPullBaseHom input target)) h := hLift
  let refinementH := (exactGeometryToRefinementGeometry U).map h
  let refinementG := (exactPackageToRefinement U).map g
  have refinementHBase : refinementH.base = refinementG.comp
      ((exactPackageToRefinement U).map
        (UpperGeometryCleavage.exactBaseHom target.1
          (semanticGeometryPullBaseHom input target))) := by
    have hbase : h.base =
        g ≫ UpperGeometryCleavage.exactBaseHom target.1
          (semanticGeometryPullBaseHom input target) :=
      (CategoryTheory.IsHomLift.eq_of_isHomLift
        (geometryProjection U)
        (g ≫ UpperGeometryCleavage.exactBaseHom target.1
          (semanticGeometryPullBaseHom input target)) h).symm
    change (exactPackageToRefinement U).map h.base = _
    simpa only [Functor.map_comp] using
      congrArg (exactPackageToRefinement U).map hbase
  let refinementFactor :=
    UpperGeometryCleavage.generatedExactCartesianFactor target.1
      (semanticGeometryPullBaseHom input target) refinementG refinementH
      refinementHBase
  let factor := UpperGeometryCleavage.exactGeometryHomOfRefinement g
    refinementFactor rfl
  refine ⟨factor, ?_, ?_⟩
  · constructor
    · apply CategoryTheory.IsHomLift.of_fac'
        (geometryProjection U) g factor rfl rfl
      rfl
    · apply (exactGeometryToRefinementGeometry U).map_injective
      rw [(exactGeometryToRefinementGeometry U).map_comp]
      change refinementFactor ≫ refinementLift = refinementH
      exact UpperGeometryCleavage.generatedExactCartesianFactor_fac target.1
        (semanticGeometryPullBaseHom input target) refinementG refinementH
        refinementHBase
  · intro factor' hfactor'
    apply (exactGeometryToRefinementGeometry U).map_injective
    apply UpperGeometryCleavage.generatedExactCartesianFactor_unique target.1
      (semanticGeometryPullBaseHom input target) refinementG refinementH
      refinementHBase
    · letI : (geometryProjection U).IsHomLift g factor' := hfactor'.1
      have hfactorBase := CategoryTheory.IsHomLift.eq_of_isHomLift
        (geometryProjection U) g factor'
      change (exactPackageToRefinement U).map factor'.base = refinementG
      exact congrArg (exactPackageToRefinement U).map hfactorBase.symm
    · change (exactGeometryToRefinementGeometry U).map
          (factor' ≫ lift) = refinementH
      rw [hfactor'.2]

/-- Strong Cartesian morphisms compose through two successive projections.
The factor is obtained first in the lower projection and then in the upper
projection, dual to the existing cocartesian tower lemma. -/
theorem semanticStronglyCartesian_comp_projection
    {𝒳 : Type u₁} {𝒴 : Type u₂} {𝒵 : Type u₃}
    [Category.{v₁} 𝒳] [Category.{v₂} 𝒴] [Category.{v₃} 𝒵]
    (q : 𝒳 ⥤ 𝒴) (p : 𝒴 ⥤ 𝒵)
    {a b : 𝒳} (φ : a ⟶ b)
    [q.IsStronglyCartesian (q.map φ) φ]
    [p.IsStronglyCartesian (p.map (q.map φ)) (q.map φ)] :
    (q ⋙ p).IsStronglyCartesian ((q ⋙ p).map φ) φ := by
  apply CategoryTheory.Functor.IsStronglyCartesian.mk
  intro c g ψ hψ
  letI : (q ⋙ p).IsHomLift
      (g ≫ (q ⋙ p).map φ) ψ := hψ
  letI : p.IsHomLift
      (g ≫ p.map (q.map φ)) (q.map ψ) := by
    have hmap := CategoryTheory.IsHomLift.eq_of_isHomLift
      (q ⋙ p) (g ≫ (q ⋙ p).map φ) ψ
    change g ≫ p.map (q.map φ) = p.map (q.map ψ) at hmap
    rw [hmap]
    infer_instance
  rcases CategoryTheory.Functor.IsStronglyCartesian.universal_property
      p (p.map (q.map φ)) (q.map φ) g
      (g ≫ p.map (q.map φ)) rfl (q.map ψ) with
    ⟨η, hη, hη_unique⟩
  letI : p.IsHomLift g η := hη.1
  letI : q.IsHomLift (η ≫ q.map φ) ψ := by
    rw [hη.2]
    infer_instance
  rcases CategoryTheory.Functor.IsStronglyCartesian.universal_property
      q (q.map φ) φ η (η ≫ q.map φ) rfl ψ with
    ⟨χ, hχ, hχ_unique⟩
  letI : q.IsHomLift η χ := hχ.1
  have compositeLift : (q ⋙ p).IsHomLift g χ := by
    have hq := CategoryTheory.IsHomLift.eq_of_isHomLift q η χ
    have hp := CategoryTheory.IsHomLift.eq_of_isHomLift p g η
    have hmap : g = (q ⋙ p).map χ := by
      change g = p.map (q.map χ)
      calc
        g = p.map η := hp
        _ = p.map (q.map χ) := congrArg p.map hq
    rw [hmap]
    infer_instance
  refine ⟨χ, ⟨compositeLift, hχ.2⟩, ?_⟩
  intro χ' hχ'
  letI : (q ⋙ p).IsHomLift g χ' := hχ'.1
  letI : p.IsHomLift g (q.map χ') := by
    have hmap := CategoryTheory.IsHomLift.eq_of_isHomLift (q ⋙ p) g χ'
    change g = p.map (q.map χ') at hmap
    subst g
    infer_instance
  have hqfac : q.map χ' ≫ q.map φ = q.map ψ := by
    simpa only [← q.map_comp] using congrArg q.map hχ'.2
  have hqχ' : q.map χ' = η :=
    hη_unique (q.map χ') ⟨inferInstance, hqfac⟩
  letI : q.IsHomLift η χ' := by
    rw [← hqχ']
    infer_instance
  exact hχ_unique χ' ⟨inferInstance, hχ'.2⟩

/-- The generated complete lift is strongly Cartesian for the composed
geometry-to-pointed projection over its actual projected arrow. -/
theorem semanticGeometryPullLift_crossStageStronglyCartesian_map
    {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U}
    (input : ExtInstHom X Y)
    (target : GeomFiber.{u, v} Y) :
    (crossStageProjection.{u, v} U).IsStronglyCartesian
      ((crossStageProjection.{u, v} U).map
        (semanticGeometryPullLift input target))
      (semanticGeometryPullLift input target) := by
  letI : (geometryProjection U).IsStronglyCartesian
      ((geometryProjection U).map (semanticGeometryPullLift input target))
      (semanticGeometryPullLift input target) := by
    simpa only [semanticGeometryPullLift_coreProjection] using
      semanticGeometryPullLift_geometryStronglyCartesian input target
  letI : (packageProjection U).IsStronglyCartesian
      ((packageProjection U).map
        ((geometryProjection U).map (semanticGeometryPullLift input target)))
      ((geometryProjection U).map (semanticGeometryPullLift input target)) := by
    simpa only [semanticGeometryPullLift_coreProjection] using
      AAT.AG.DoctrineFiberProduct.inverseCorePackageHom_isStronglyCartesian
        target.1.core
        (semanticGeometryPullBaseHom input target)
  exact semanticStronglyCartesian_comp_projection
    (geometryProjection U) (packageProjection U)
    (semanticGeometryPullLift input target)

/-- The generated complete lift is a genuine lift of the given semantic
arrow, including both endpoint equalities stored by the source and target
fiber objects. -/
theorem semanticGeometryPullLift_isHomLift
    {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U}
    (input : ExtInstHom X Y)
    (target : GeomFiber.{u, v} Y) :
    (crossStageProjection.{u, v} U).IsHomLift input
      (semanticGeometryPullLift input target) := by
  apply CategoryTheory.IsHomLift.of_commsq
    (crossStageProjection.{u, v} U) input
    (semanticGeometryPullLift input target)
    (semanticGeometryPull input target).2 target.2
  change (input ≫ eqToHom target.2.symm) ≫
      eqToHom target.2 =
    eqToHom (semanticGeometryPull input target).2 ≫ input
  simp


/-- Reindex a strong Cartesian certificate along a genuine hom-lift witness
for the same total morphism. -/
theorem semanticStronglyCartesian_of_isHomLift
    {Base : Type u₁} {Total : Type u₂}
    [Category.{v₁} Base] [Category.{v₂} Total]
    (projection : Total ⥤ Base) {source target : Base}
    {domain codomain : Total} (base : source ⟶ target)
    (hom : domain ⟶ codomain)
    [projection.IsStronglyCartesian (projection.map hom) hom]
    [projection.IsHomLift base hom] :
    projection.IsStronglyCartesian base hom := by
  subst_hom_lift projection base hom
  infer_instance


/-- The exact lift is strongly Cartesian over the given semantic arrow. -/
theorem semanticGeometryPullLift_crossStageStronglyCartesian
    {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U}
    (input : ExtInstHom X Y)
    (target : GeomFiber.{u, v} Y) :
    (crossStageProjection.{u, v} U).IsStronglyCartesian input
      (semanticGeometryPullLift input target) := by
  letI : (crossStageProjection.{u, v} U).IsStronglyCartesian
      ((crossStageProjection.{u, v} U).map
        (semanticGeometryPullLift input target))
      (semanticGeometryPullLift input target) :=
    semanticGeometryPullLift_crossStageStronglyCartesian_map input target
  letI : (crossStageProjection.{u, v} U).IsHomLift input
      (semanticGeometryPullLift input target) :=
    semanticGeometryPullLift_isHomLift input target
  exact semanticStronglyCartesian_of_isHomLift
    (crossStageProjection.{u, v} U) input
    (semanticGeometryPullLift input target)

/-- A vertical morphism in the target geometry fiber is pulled back by the
strong Cartesian universal property of the exact lift at its codomain. -/
noncomputable def semanticGeometryPullMap
    {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U}
    (input : ExtInstHom X Y)
    {first second : GeomFiber.{u, v} Y}
    (hom : first ⟶ second) :
    semanticGeometryPull input first ⟶ semanticGeometryPull input second := by
  let firstLift := semanticGeometryPullLift input first
  let secondLift := semanticGeometryPullLift input second
  letI : (crossStageProjection.{u, v} U).IsStronglyCartesian
      input secondLift :=
    semanticGeometryPullLift_crossStageStronglyCartesian input second
  letI : (crossStageProjection.{u, v} U).IsHomLift
      input firstLift :=
    semanticGeometryPullLift_isHomLift input first
  letI : (crossStageProjection.{u, v} U).IsHomLift
      (𝟙 Y) hom.1 := hom.2
  letI : (crossStageProjection.{u, v} U).IsHomLift
      input (firstLift ≫ hom.1) := by
    simpa using inferInstanceAs
      ((crossStageProjection.{u, v} U).IsHomLift
        (input ≫ 𝟙 Y)
        (firstLift ≫ hom.1))
  exact ⟨CategoryTheory.Functor.IsStronglyCartesian.map
      (crossStageProjection.{u, v} U) input secondLift
      (g := 𝟙 X) (f' := input)
      (show input = 𝟙 X ≫ input from by simp)
      (firstLift ≫ hom.1), inferInstance⟩

/-- The pulled vertical morphism satisfies its defining factorization through
the exact lift at the target object. -/
theorem semanticGeometryPullMap_fac
    {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U}
    (input : ExtInstHom X Y)
    {first second : GeomFiber.{u, v} Y}
    (hom : first ⟶ second) :
    (semanticGeometryPullMap input hom).1 ≫
        semanticGeometryPullLift input second =
      semanticGeometryPullLift input first ≫ hom.1 := by
  let firstLift := semanticGeometryPullLift input first
  let secondLift := semanticGeometryPullLift input second
  letI : (crossStageProjection.{u, v} U).IsStronglyCartesian
      input secondLift :=
    semanticGeometryPullLift_crossStageStronglyCartesian input second
  letI : (crossStageProjection.{u, v} U).IsHomLift
      input firstLift :=
    semanticGeometryPullLift_isHomLift input first
  letI : (crossStageProjection.{u, v} U).IsHomLift
      (𝟙 Y) hom.1 := hom.2
  letI : (crossStageProjection.{u, v} U).IsHomLift
      input (firstLift ≫ hom.1) := by
    simpa using inferInstanceAs
      ((crossStageProjection.{u, v} U).IsHomLift
        (input ≫ 𝟙 Y)
        (firstLift ≫ hom.1))
  exact CategoryTheory.Functor.IsStronglyCartesian.fac
    (crossStageProjection.{u, v} U) input secondLift
    (show input = 𝟙 X ≫ input from by simp)
    (firstLift ≫ hom.1)

/-- Exact geometry pullback preserves vertical identities. -/
theorem semanticGeometryPullMap_id
    {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U}
    (input : ExtInstHom X Y)
    (target : GeomFiber.{u, v} Y) :
    semanticGeometryPullMap input (𝟙 target) =
      𝟙 (semanticGeometryPull input target) := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let lift := semanticGeometryPullLift input target
  letI : (crossStageProjection.{u, v} U).IsStronglyCartesian
      input lift :=
    semanticGeometryPullLift_crossStageStronglyCartesian input target
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (crossStageProjection.{u, v} U) input lift
    (𝟙 X)
  simpa using semanticGeometryPullMap_fac input (𝟙 target)

/-- Exact geometry pullback preserves composition of vertical morphisms. -/
theorem semanticGeometryPullMap_comp
    {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U}
    (input : ExtInstHom X Y)
    {first second third : GeomFiber.{u, v} Y}
    (f : first ⟶ second) (g : second ⟶ third) :
    semanticGeometryPullMap input (f ≫ g) =
      semanticGeometryPullMap input f ≫ semanticGeometryPullMap input g := by
  apply CategoryTheory.Functor.Fiber.hom_ext
  let thirdLift := semanticGeometryPullLift input third
  letI : (crossStageProjection.{u, v} U).IsStronglyCartesian
      input thirdLift :=
    semanticGeometryPullLift_crossStageStronglyCartesian input third
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (crossStageProjection.{u, v} U) input thirdLift
    (𝟙 X)
  change (semanticGeometryPullMap input (f ≫ g)).1 ≫
      semanticGeometryPullLift input third =
    ((semanticGeometryPullMap input f).1 ≫
      (semanticGeometryPullMap input g).1) ≫
      semanticGeometryPullLift input third
  calc
    _ = semanticGeometryPullLift input first ≫ (f ≫ g).1 :=
      semanticGeometryPullMap_fac input (f ≫ g)
    _ = (semanticGeometryPullLift input first ≫ f.1) ≫ g.1 :=
      (Category.assoc _ _ _).symm
    _ = ((semanticGeometryPullMap input f).1 ≫
        semanticGeometryPullLift input second) ≫ g.1 :=
      congrArg (fun h => h ≫ g.1)
        (semanticGeometryPullMap_fac input f).symm
    _ = (semanticGeometryPullMap input f).1 ≫
        (semanticGeometryPullLift input second ≫ g.1) :=
      Category.assoc _ _ _
    _ = (semanticGeometryPullMap input f).1 ≫
        ((semanticGeometryPullMap input g).1 ≫
          semanticGeometryPullLift input third) :=
      congrArg (fun h => (semanticGeometryPullMap input f).1 ≫ h)
        (semanticGeometryPullMap_fac input g).symm
    _ = _ := (Category.assoc _ _ _).symm

/-- Reindexing of complete geometry fibers generated by the exact Cartesian
cleavage over a semantic arrow. -/
noncomputable def semanticGeometryPullFunctor
    {U : AtomCarrier.{u}}
    {X Y : ExtractionInstance U}
    (input : ExtInstHom X Y) :
    GeomFiber.{u, v} Y ⥤
      GeomFiber.{u, v} X where
  obj := semanticGeometryPull input
  map := semanticGeometryPullMap input
  map_id := semanticGeometryPullMap_id input
  map_comp := semanticGeometryPullMap_comp input
end AAT.AG.FullGeometryNormalization

#assert_standard_axioms_only AAT.AG.FullGeometryNormalization
