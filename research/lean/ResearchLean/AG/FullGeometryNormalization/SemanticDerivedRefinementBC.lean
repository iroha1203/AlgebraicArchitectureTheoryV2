import ResearchLean.AG.FullGeometryNormalization.ExactDerivedRefinementBC

/-!
# Semantic exact-derived refinement base change

An arbitrary semantic Beck--Chevalley input supplies an exact bottom arrow.
Its actual pointed endpoints generate an exact G-114 refinement configuration,
the compatible source, and the realized-reflection condition.  No realization
presentation or additional conclusion data is required.
-/

namespace AAT.AG.FullGeometryNormalization

universe u v

open CategoryTheory AtomFoundation GeometryTransport CrossStageCoherence
open DoctrineFiberProduct TransportCoherence

set_option maxHeartbeats 3000000

/-- The exact G-114 configuration generated by the semantic bottom arrow. -/
noncomputable def semanticDerivedRefinementBCConfiguration
    {U : AtomCarrier.{u}} (input : BCSemanticInput U) :
    RefinementBCConfiguration U :=
  let square := input.square
  { sOnePrime := square.southwest.doctrine
    sOne := square.southeast.doctrine
    sTwo := square.northeast.doctrine
    bottom := square.southeast.doctrine
    fst := ExactDoctrineHom.id square.southeast.doctrine
    snd := square.right.doctrineHom
    refinement := exactToRefinement square.bottom.doctrineHom }

/-- The actual southwest and northeast endpoint sources agree after the two
semantic arrows into the southeast endpoint. -/
noncomputable def semanticDerivedRefinementBCCompatibleSource
    {U : AtomCarrier.{u}} (input : BCSemanticInput U) :
    (semanticDerivedRefinementBCConfiguration input).CompatibleSource := by
  let square := input.square
  refine
    { sourcePrime := square.southwest.source
      sourceTwo := square.northeast.source
      bottom_eq := ?_ }
  change square.bottom.doctrineHom.sourceMap square.southwest.source =
    square.right.doctrineHom.sourceMap square.northeast.source
  exact square.bottom.source_eq.trans square.right.source_eq.symm

/-- The generated refinement is the image of the actual semantic bottom
exact doctrine morphism. -/
theorem semanticDerivedRefinementBC_exactImage
    {U : AtomCarrier.{u}} (input : BCSemanticInput U) :
    RefinementExactComparisonImage
      (semanticDerivedRefinementBCConfiguration input) := by
  exact ⟨input.square.bottom.doctrineHom, rfl⟩

/-- Realized reflection follows from membership in the exact comparison
image, with no supplied regime or reflection certificate. -/
theorem semanticDerivedRefinementBC_condition
    {U : AtomCarrier.{u}} (input : BCSemanticInput U) :
    RealizedLocusExtractionReflecting
      ((semanticDerivedRefinementBCConfiguration input).baseRefinementAt
        (semanticDerivedRefinementBCCompatibleSource input)) :=
  (configurationRealizedReflection_of_exactImage
    (semanticDerivedRefinementBCConfiguration input)
    (semanticDerivedRefinementBC_exactImage input))
      (semanticDerivedRefinementBCCompatibleSource input)

/-- The G-114 target is the actual southeast endpoint of the semantic
square; this uses the source equality already carried by its bottom arrow. -/
theorem semanticDerivedRefinementBCTargetPoint_eq
    {U : AtomCarrier.{u}} (input : BCSemanticInput U) :
    (semanticDerivedRefinementBCConfiguration input).targetPointAt
        (semanticDerivedRefinementBCCompatibleSource input) =
      input.square.southeast := by
  apply ExtractionInstance.ext
  · rfl
  · apply heq_of_eq
    change input.square.bottom.doctrineHom.sourceMap
        input.square.southwest.source = input.square.southeast.source
    exact input.square.bottom.source_eq

/-- Transport an arbitrary southwest complete geometry along the actual
semantic bottom arrow. -/
noncomputable def semanticDerivedTargetGeometry
    {U : AtomCarrier.{u}} (input : BCSemanticInput U)
    (g : GeomFiber.{u, v} input.square.southwest) :
    GeomFiber input.square.southeast :=
  (geomFiberTransportFunctor input.square.bottom).obj g

/-- Retag the core of the transported complete geometry at the definitionally
generated G-114 target point. -/
noncomputable def semanticDerivedTargetPackage
    {U : AtomCarrier.{u}} (input : BCSemanticInput U)
    (g : GeomFiber.{u, v} input.square.southwest) :
    CoreFiber
      ((semanticDerivedRefinementBCConfiguration input).targetPointAt
        (semanticDerivedRefinementBCCompatibleSource input)) :=
  let q := semanticDerivedTargetGeometry input g
  ⟨q.1.core, q.2.trans (semanticDerivedRefinementBCTargetPoint_eq input).symm⟩

/-- The active G-114 context generated from the semantic exact square and
one arbitrary complete geometry in its southwest fiber. -/
noncomputable def semanticDerivedRefinementBCContext
    {U : AtomCarrier.{u}} (input : BCSemanticInput U)
    (g : GeomFiber.{u, v} input.square.southwest) :
    ActiveRefinementBCContext U :=
  activeRefinementBCContextOfCondition
    (semanticDerivedRefinementBCConfiguration input)
    (semanticDerivedRefinementBCCompatibleSource input)
    (semanticDerivedTargetPackage input g)
    (semanticDerivedRefinementBC_condition input)

/-! ## The one-vertex compatible source at a fixed coefficient -/

/-- Place a fixed-coefficient geometry over the actual southwest endpoint. -/
def semanticDerivedSouthwestGeometryFiber
    {U : AtomCarrier.{u}} (input : BCSemanticInput U)
    (Q : AATCorePackage U) (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt Q k)
    (endpoint_eq : packagePoint Q = input.square.southwest) :
    GeomFiber input.square.southwest :=
  ⟨g.package, endpoint_eq⟩

/-- The constant one-vertex diagram at the transported target package. -/
noncomputable def semanticDerivedSourceFiberDiagram
    {U : AtomCarrier.{u}} (input : BCSemanticInput U)
    (Q : AATCorePackage U) (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt Q k)
    (endpoint_eq : packagePoint Q = input.square.southwest) :
    PresentedPathCategory (exactDerivedPointPresentation U) ⥤
      CoreFiber
        ((semanticDerivedRefinementBCConfiguration input).targetPointAt
          (semanticDerivedRefinementBCCompatibleSource input)) where
  obj _ := semanticDerivedTargetPackage input
    (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq)
  map _ := 𝟙 (semanticDerivedTargetPackage input
    (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq))
  map_id _ := rfl
  map_comp _ _ := by simp

/-- The transported complete geometry, read at the fixed coefficient `k`. -/
noncomputable def semanticDerivedSourceGeometry
    {U : AtomCarrier.{u}} (input : BCSemanticInput U)
    (Q : AATCorePackage U)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt Q k)
    (endpoint_eq : packagePoint Q = input.square.southwest)
    (_ : (exactDerivedPointPresentation U).Vertex) :
    FixedCoefficientGeometryAt
      ((semanticDerivedSourceFiberDiagram input Q k g endpoint_eq).obj
        ⟨PUnit.unit⟩).1 k where
  geometry := (semanticDerivedTargetGeometry input
    (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq)).1.geometry
  raw := (semanticDerivedTargetGeometry input
    (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq)).1.raw

/-- The unique two-layer transport on the one-vertex presentation. -/
noncomputable def semanticDerivedSourceTransport
    {U : AtomCarrier.{u}} (input : BCSemanticInput U)
    (Q : AATCorePackage U)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt Q k)
    (endpoint_eq : packagePoint Q = input.square.southwest) :
    FixedCoefficientTwoLayerTransportOver (exactDerivedPointPresentation U)
      (semanticDerivedSourceFiberDiagram input Q k g endpoint_eq) k
      (semanticDerivedSourceGeometry input Q k g endpoint_eq) where
  edgeLift edge := nomatch edge
  edge_base edge := nomatch edge
  edgeGeometryStrong edge := nomatch edge
  edgeCoreStrong edge := nomatch edge
  twoCellBase cell := nomatch cell
  comparator cell := nomatch cell
  edge_coefficient_id edge := nomatch edge
  comparator_coefficient_id cell := nomatch cell

/-- A cell-local G-118 compatible problem generated from a fixed-coefficient
southwest geometry. -/
noncomputable def semanticDerivedCompatibleProblemData
    {U : AtomCarrier.{u}} (input : BCSemanticInput U)
    (Q : AATCorePackage U)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt Q k)
    (endpoint_eq : packagePoint Q = input.square.southwest) :
    UpperGeometryCompatibleProblemInputData
      (semanticDerivedRefinementBCContext input
        (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq))
      (exactDerivedPointPresentation U) (CommRingCat.of k) where
  root := PUnit.unit
  rootPath _ := .nil PUnit.unit
  sourceFiberDiagram := semanticDerivedSourceFiberDiagram input Q k g endpoint_eq
  sourceGeometry := semanticDerivedSourceGeometry input Q k g endpoint_eq
  sourceTransport := semanticDerivedSourceTransport input Q k g endpoint_eq

/-- The existing G-118 generator evaluated on the semantic one-cell input. -/
noncomputable def semanticDerivedGeneratedCompatibleUpperGeometryMate
    {U : AtomCarrier.{u}} (input : BCSemanticInput U)
    (Q : AATCorePackage U)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt Q k)
    (endpoint_eq : packagePoint Q = input.square.southwest) :=
  (semanticDerivedCompatibleProblemData input Q k g endpoint_eq).generatedCompatibleUpperGeometryMateAt
    PUnit.unit

end AAT.AG.FullGeometryNormalization

#assert_standard_axioms_only AAT.AG.FullGeometryNormalization
