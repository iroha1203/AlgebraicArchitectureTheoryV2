import ResearchLean.AG.FullGeometryNormalization.ExactDerivedEndpointGeometry
import ResearchLean.AG.FullGeometryNormalization.ExactGeometryTransportUnitIso
import ResearchLean.AG.DoctrineFiberProduct.QualifiedComparisonFixedDecision

/-!
# The exact-derived generated complete-geometry mate

This module places the certificate-free G-118 generated mate in the mixed
pullback geometry fiber generated by G-122, transports it through the
realization-proven source comparison to the original northwest point, and
pushes the resulting vertical map along the original top edge.

The two mixed-fiber objects are wrappers around the actual generated route
geometries.  Their incidence equations are the theorems of the G-115 route
constructors; no endpoint equation or verticality certificate is supplied by
the caller.
-/

namespace AAT.AG.FullGeometryNormalization

universe u v

open CategoryTheory AtomFoundation GeometryTransport CrossStageCoherence
open DoctrineFiberProduct

set_option maxHeartbeats 3000000

/-! ## Generated route geometries in the mixed pullback fiber -/

/-- The generated base-first route geometry, placed over the exact-derived
mixed pullback source using its constructor's package-point theorem. -/
noncomputable def authoredExactGeneratedBaseRouteFiberAt
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) (z : A.context.Category)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt (A.context.supportPackage z.as) k) :
    GeomFiber
      ((authoredExactRefinementBCConfiguration A).pullbackSourceAt
        (authoredExactRefinementBCCompatibleSource A)) :=
  let input := authoredExactCompatibleProblemDataAt A z k g
  let ctx := authoredExactRefinementBCContextAt A z k g
  ⟨input.generatedBaseRouteGeometryAt PUnit.unit,
    UpperGeometryCleavage.baseRouteGeometry_packagePoint_eq
      (ctx.retarget (input.sourceFiberDiagram.obj ⟨PUnit.unit⟩))
      (input.sourceTargetGeometryAt PUnit.unit)⟩

/-- The generated pulled-first route geometry, placed over the same
exact-derived mixed pullback source. -/
noncomputable def authoredExactGeneratedPulledRouteFiberAt
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) (z : A.context.Category)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt (A.context.supportPackage z.as) k) :
    GeomFiber
      ((authoredExactRefinementBCConfiguration A).pullbackSourceAt
        (authoredExactRefinementBCCompatibleSource A)) :=
  let input := authoredExactCompatibleProblemDataAt A z k g
  let ctx := authoredExactRefinementBCContextAt A z k g
  ⟨input.generatedPulledRouteGeometryAt PUnit.unit,
    UpperGeometryCleavage.pulledRouteGeometry_packagePoint_eq
      (ctx.retarget (input.sourceFiberDiagram.obj ⟨PUnit.unit⟩))
      (input.sourceTargetGeometryAt PUnit.unit)⟩

/-- The existing G-118 generated complete-geometry mate, regarded as a
vertical morphism in the exact-derived mixed pullback fiber. -/
noncomputable def authoredExactGeneratedMateInMixedFiberAt
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) (z : A.context.Category)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt (A.context.supportPackage z.as) k) :
    authoredExactGeneratedBaseRouteFiberAt A z k g ⟶
      authoredExactGeneratedPulledRouteFiberAt A z k g := by
  let input := authoredExactCompatibleProblemDataAt A z k g
  let ctx := authoredExactRefinementBCContextAt A z k g
  let mate := input.generatedCompatibleUpperGeometryMateAt PUnit.unit
  letI coreLift : (packageProjection U).IsHomLift
      (𝟙 ((authoredExactRefinementBCConfiguration A).pullbackSourceAt
        (authoredExactRefinementBCCompatibleSource A))) mate.base := by
    rw [show mate.base =
      (UpperGeometryCleavage.generatedRouteCoreMate
        (ctx.retarget (input.sourceFiberDiagram.obj ⟨PUnit.unit⟩))
        (input.sourceTargetGeometryAt PUnit.unit)).1 from
          input.generatedCompatibleUpperGeometryMateAt_base PUnit.unit]
    exact (UpperGeometryCleavage.generatedRouteCoreMate
      (ctx.retarget (input.sourceFiberDiagram.obj ⟨PUnit.unit⟩))
      (input.sourceTargetGeometryAt PUnit.unit)).2
  refine ⟨mate, ?_⟩
  apply CategoryTheory.IsHomLift.of_fac'
    (crossStageProjection.{u, v} U)
    (𝟙 ((authoredExactRefinementBCConfiguration A).pullbackSourceAt
      (authoredExactRefinementBCCompatibleSource A))) mate
    (UpperGeometryCleavage.baseRouteGeometry_packagePoint_eq
      (ctx.retarget (input.sourceFiberDiagram.obj ⟨PUnit.unit⟩))
      (input.sourceTargetGeometryAt PUnit.unit))
    (UpperGeometryCleavage.pulledRouteGeometry_packagePoint_eq
      (ctx.retarget (input.sourceFiberDiagram.obj ⟨PUnit.unit⟩))
      (input.sourceTargetGeometryAt PUnit.unit))
  rw [crossStageProjection_map]
  exact CategoryTheory.IsHomLift.fac'
    (packageProjection U)
    (𝟙 ((authoredExactRefinementBCConfiguration A).pullbackSourceAt
      (authoredExactRefinementBCCompatibleSource A)))
    mate.base

/-! ## Transport to the original square and push along its top edge -/

/-- The generated base-route geometry transported from the mixed pullback to
the original northwest point. -/
noncomputable def authoredExactGeneratedBaseRouteNorthwestAt
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) (z : A.context.Category)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt (A.context.supportPackage z.as) k) :
    GeomFiber A.context.square.semantic.square.northwest :=
  (geomFiberTransportFunctor (authoredExactPullbackSourceIso A).hom).obj
    (authoredExactGeneratedBaseRouteFiberAt A z k g)

/-- The generated pulled-route geometry transported from the mixed pullback
to the original northwest point. -/
noncomputable def authoredExactGeneratedPulledRouteNorthwestAt
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) (z : A.context.Category)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt (A.context.supportPackage z.as) k) :
    GeomFiber A.context.square.semantic.square.northwest :=
  (geomFiberTransportFunctor (authoredExactPullbackSourceIso A).hom).obj
    (authoredExactGeneratedPulledRouteFiberAt A z k g)

/-- `m_z`: the actual generated G-118 mate transported through the
realization-proven mixed-pullback comparison to the original northwest fiber. -/
noncomputable def authoredExactGeneratedMateNorthwestAt
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) (z : A.context.Category)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt (A.context.supportPackage z.as) k) :
    authoredExactGeneratedBaseRouteNorthwestAt A z k g ⟶
      authoredExactGeneratedPulledRouteNorthwestAt A z k g :=
  (geomFiberTransportFunctor (authoredExactPullbackSourceIso A).hom).map
    (authoredExactGeneratedMateInMixedFiberAt A z k g)

/-- The top-edge push of `m_z`, a vertical comparison in the original
northeast fiber. -/
noncomputable def authoredExactGeneratedMateTopPushAt
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) (z : A.context.Category)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt (A.context.supportPackage z.as) k) :=
  (geomFiberTransportFunctor A.context.square.semantic.square.top).map
    (authoredExactGeneratedMateNorthwestAt A z k g)

/-! ## Coefficient control -/

/-- The exact-derived mixed-fiber mate is invertible because it is the actual
G-118 generated comparison, whose invertibility was proved from the generated
cleavage rather than supplied as a new premise. -/
theorem authoredExactGeneratedMateInMixedFiberAt_isIso
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) (z : A.context.Category)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt (A.context.supportPackage z.as) k) :
    IsIso (authoredExactGeneratedMateInMixedFiberAt A z k g) := by
  let input := authoredExactCompatibleProblemDataAt A z k g
  have generatedIsIso : IsIso (show
      input.generatedBaseRouteGeometryAt PUnit.unit ⟶
        input.generatedPulledRouteGeometryAt PUnit.unit from
      input.generatedCompatibleUpperGeometryMateAt PUnit.unit) :=
    input.generatedCompatibleUpperGeometryMateAt_isIso PUnit.unit
  letI := generatedIsIso
  letI : IsIso (authoredExactGeneratedMateInMixedFiberAt A z k g).1 := by
    change IsIso (show
      input.generatedBaseRouteGeometryAt PUnit.unit ⟶
        input.generatedPulledRouteGeometryAt PUnit.unit from
      input.generatedCompatibleUpperGeometryMateAt PUnit.unit)
    infer_instance
  exact geomFiberHom_isIso_of_total_isIso
    (authoredExactGeneratedMateInMixedFiberAt A z k g)

/-- Transport through the realization-proven source comparison preserves the
invertibility of the generated mate. -/
theorem authoredExactGeneratedMateNorthwestAt_isIso
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) (z : A.context.Category)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt (A.context.supportPackage z.as) k) :
    IsIso (authoredExactGeneratedMateNorthwestAt A z k g) := by
  letI := authoredExactGeneratedMateInMixedFiberAt_isIso A z k g
  dsimp only [authoredExactGeneratedMateNorthwestAt]
  infer_instance

/-- Pushing along the original top edge preserves the invertibility of the
generated mate. -/
theorem authoredExactGeneratedMateTopPushAt_isIso
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) (z : A.context.Category)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt (A.context.supportPackage z.as) k) :
    IsIso (authoredExactGeneratedMateTopPushAt A z k g) := by
  letI := authoredExactGeneratedMateNorthwestAt_isIso A z k g
  dsimp only [authoredExactGeneratedMateTopPushAt]
  infer_instance

/-- The mixed-fiber generated mate fixes the authored coefficient ring.  The
identity is forced by its generated route triangle and the two literal route
coefficient identities. -/
theorem authoredExactGeneratedMateInMixedFiberAt_coefficient_id
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) (z : A.context.Category)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt (A.context.supportPackage z.as) k) :
    (authoredExactGeneratedMateInMixedFiberAt A z k g).1.geometry.coefficientHom =
      RingHom.id k := by
  let input := authoredExactCompatibleProblemDataAt A z k g
  have h := congrArg (fun hom => hom.geometry.coefficientHom)
    (input.generatedCompatibleUpperGeometryMateAt_triangle PUnit.unit)
  change
    (input.generatedPulledRouteLegAt PUnit.unit).geometry.coefficientHom.comp
        (input.generatedCompatibleUpperGeometryMateAt
          PUnit.unit).geometry.coefficientHom =
      (input.generatedBaseRouteLegAt PUnit.unit).geometry.coefficientHom at h
  have hpulled :
      (input.generatedPulledRouteLegAt PUnit.unit).geometry.coefficientHom =
        RingHom.id k := by
    ext x
    rfl
  have hbase :
      (input.generatedBaseRouteLegAt PUnit.unit).geometry.coefficientHom =
        RingHom.id k := by
    ext x
    rfl
  rw [hpulled, hbase] at h
  simpa only [RingHom.id_comp] using h

/-- Transporting the generated mate to the northwest fiber preserves its
coefficient identity. -/
theorem authoredExactGeneratedMateNorthwestAt_coefficient_id
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) (z : A.context.Category)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt (A.context.supportPackage z.as) k) :
    (authoredExactGeneratedMateNorthwestAt A z k g).1.geometry.coefficientHom =
      RingHom.id k := by
  dsimp only [authoredExactGeneratedMateNorthwestAt]
  change (geomFiberTransportMap (authoredExactPullbackSourceIso A).hom
      (authoredExactGeneratedMateInMixedFiberAt A z k g)).1.geometry.coefficientHom =
    RingHom.id k
  rw [geomFiberTransportMap_coefficientHom]
  exact authoredExactGeneratedMateInMixedFiberAt_coefficient_id A z k g

/-- The top-edge push of the generated mate still fixes the authored
coefficient ring. -/
theorem authoredExactGeneratedMateTopPushAt_coefficient_id
    {U : AtomCarrier.{u}} [DecidableEq U.Atom]
    (A : AuthoredBCDatumSquare U) (z : A.context.Category)
    (k : Type v) [CommRing k]
    (g : FixedCoefficientGeometryAt (A.context.supportPackage z.as) k) :
    (authoredExactGeneratedMateTopPushAt A z k g).1.geometry.coefficientHom =
      RingHom.id k := by
  dsimp only [authoredExactGeneratedMateTopPushAt]
  change (geomFiberTransportMap A.context.square.semantic.square.top
      (authoredExactGeneratedMateNorthwestAt A z k g)).1.geometry.coefficientHom =
    RingHom.id k
  rw [geomFiberTransportMap_coefficientHom]
  exact authoredExactGeneratedMateNorthwestAt_coefficient_id A z k g

end AAT.AG.FullGeometryNormalization

#assert_standard_axioms_only AAT.AG.FullGeometryNormalization
