import ResearchLean.AG.DoctrineFiberProduct.BCPresentationReplacement
import ResearchLean.AG.FullGeometryNormalization.SemanticDerivedEndpointBridge
import ResearchLean.AG.FullGeometryNormalization.SemanticExactCoreNormalizationNaturality
import ResearchLean.AG.FullGeometryNormalization.SemanticCoreBeckChevalleyMate
import ResearchLean.AG.CrossStageCoherence.TowerCompatibility

/-!
# Core endpoints of the semantic complete-geometry routes

The endpoint maps are generated by the geometry/core transport comparison and
by the canonical inverse-package pullback at each semantic edge.
-/

namespace AAT.AG.FullGeometryNormalization

universe u v

open CategoryTheory AtomFoundation GeometryTransport CrossStageCoherence
open DoctrineFiberProduct

set_option maxHeartbeats 3000000

/-- The core of semantic geometry pullback is the selected inverse-package
core pullback at the same exact arrow. -/
noncomputable def semanticDerivedPullCoreIsoApp
    {U : AtomCarrier.{u}} {X Y : ExtractionInstance U}
    (arrow : ExtInstHom X Y) (target : GeomFiber.{u, v} Y) :
    (geometryFiberProjection X).obj
        ((semanticGeometryPullFunctor arrow).obj target) ≅
      (semanticCoreInverseReindexFunctor arrow).obj
        ((geometryFiberProjection Y).obj target) :=
  Iso.refl _

/-- The selected geometry pull lift projects to the selected inverse-package
core lift, definitionally at the total package arrow. -/
theorem semanticDerivedPullCoreLift_eq
    {U : AtomCarrier.{u}} {X Y : ExtractionInstance U}
    (arrow : ExtInstHom X Y) (target : GeomFiber.{u, v} Y) :
    (geometryProjection U).map (semanticGeometryPullLift arrow target) =
      (semanticCoreInverseLift arrow
        ((geometryFiberProjection Y).obj target)).hom := by
  rfl

/-- The projected direct endpoint is the independent core mate's direct
route, using the semantic-global selected core cleavage. -/
noncomputable def semanticDerivedDirectCoreIsoAt
    {U : AtomCarrier.{u}}
    (input : BCSemanticInput U) (Q : AATCorePackage U)
    (k : Type v) [CommRing k] (g : FixedCoefficientGeometryAt Q k)
    (endpoint_eq : packagePoint Q = input.square.southwest) :
    (geometryFiberProjection input.square.northeast).obj
        (semanticDerivedDirectGeometryAt input Q k g endpoint_eq) ≅
      (exact_bottom_semantic_global_reindex_functor input.square.left ⋙
        coreFiberTransportFunctor input.square.top).obj
          ((geometryFiberProjection input.square.southwest).obj
            (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq)) :=
  towerTransportComparisonApp input.square.top
      (semanticDerivedLeftPulledGeometryAt input Q k g endpoint_eq) ≪≫
    (coreFiberTransportFunctor input.square.top).mapIso
      (semanticDerivedPullCoreIsoApp input.square.left
        (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq)) ≪≫
    (coreFiberTransportFunctor input.square.top).mapIso
      ((semanticCoreInverseReindexToGlobalIso input.square.left).app
        ((geometryFiberProjection input.square.southwest).obj
          (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq)))

/-- The projected via-base endpoint is the independent core mate's via-base
route, with the same semantic-global selected core cleavage. -/
noncomputable def semanticDerivedViaBaseCoreIsoAt
    {U : AtomCarrier.{u}}
    (input : BCSemanticInput U) (Q : AATCorePackage U)
    (k : Type v) [CommRing k] (g : FixedCoefficientGeometryAt Q k)
    (endpoint_eq : packagePoint Q = input.square.southwest) :
    (geometryFiberProjection input.square.northeast).obj
        (semanticDerivedViaBaseGeometryAt input Q k g endpoint_eq) ≅
      (coreFiberTransportFunctor input.square.bottom ⋙
        exact_bottom_semantic_global_reindex_functor input.square.right).obj
          ((geometryFiberProjection input.square.southwest).obj
            (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq)) :=
  semanticDerivedPullCoreIsoApp input.square.right
      (semanticDerivedTargetGeometryAt input Q k g endpoint_eq) ≪≫
    (semanticCoreInverseReindexFunctor input.square.right).mapIso
      (towerTransportComparisonApp input.square.bottom
        (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq)) ≪≫
    (semanticCoreInverseReindexToGlobalIso input.square.right).app
      ((coreFiberTransportFunctor input.square.bottom).obj
        ((geometryFiberProjection input.square.southwest).obj
          (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq)))

/-- The via-base endpoint comparison followed by the global right lift
factors through the projected geometry pull lift and the bottom tower map. -/
theorem semanticDerivedViaBaseCoreIsoAt_right_fac
    {U : AtomCarrier.{u}}
    (input : BCSemanticInput U) (Q : AATCorePackage U)
    (k : Type v) [CommRing k] (g : FixedCoefficientGeometryAt Q k)
    (endpoint_eq : packagePoint Q = input.square.southwest) :
    (semanticDerivedViaBaseCoreIsoAt input Q k g endpoint_eq).hom.1 ≫
      (exact_bottom_semantic_global_selected_lift input.square.right
        ((coreFiberTransportFunctor input.square.bottom).obj
          ((geometryFiberProjection input.square.southwest).obj
            (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq)))).hom =
    (geometryProjection U).map
        (semanticGeometryPullLift input.square.right
          (semanticDerivedTargetGeometryAt input Q k g endpoint_eq)) ≫
      (towerTransportComparisonApp input.square.bottom
        (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq)).hom.1 := by
  let tower := towerTransportComparisonApp input.square.bottom
    (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq)
  let projectedTarget := (geometryFiberProjection input.square.southeast).obj
    (semanticDerivedTargetGeometryAt input Q k g endpoint_eq)
  have hglobal := semanticCoreInverseReindexToGlobalIso_hom_fac
    input.square.right
    ((coreFiberTransportFunctor input.square.bottom).obj
      ((geometryFiberProjection input.square.southwest).obj
        (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq)))
  change
    ((semanticCoreInverseReindexToGlobalIso input.square.right).app
      ((coreFiberTransportFunctor input.square.bottom).obj
        ((geometryFiberProjection input.square.southwest).obj
          (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq)))).hom.1 ≫
    (exact_bottom_semantic_global_selected_lift input.square.right
      ((coreFiberTransportFunctor input.square.bottom).obj
        ((geometryFiberProjection input.square.southwest).obj
          (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq)))).hom =
    (semanticCoreInverseLift input.square.right
      ((coreFiberTransportFunctor input.square.bottom).obj
        ((geometryFiberProjection input.square.southwest).obj
          (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq)))).hom
    at hglobal
  have hmap := (semanticCoreInverseCleavage input.square.right).reindexFunctor_map_fac
    tower.hom
  change
    ((semanticCoreInverseReindexFunctor input.square.right).map tower.hom).1 ≫
      (semanticCoreInverseLift input.square.right
        ((coreFiberTransportFunctor input.square.bottom).obj
          ((geometryFiberProjection input.square.southwest).obj
            (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq)))).hom =
    (semanticCoreInverseLift input.square.right projectedTarget).hom ≫ tower.hom.1
    at hmap
  unfold semanticDerivedViaBaseCoreIsoAt
  simp only [Iso.trans_hom, Functor.mapIso_hom]
  change
    ((semanticCoreInverseReindexFunctor input.square.right).map
      tower.hom).1 ≫
      ((semanticCoreInverseReindexToGlobalIso input.square.right).app
        ((coreFiberTransportFunctor input.square.bottom).obj
          ((geometryFiberProjection input.square.southwest).obj
            (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq)))).hom.1 ≫
      (exact_bottom_semantic_global_selected_lift input.square.right
        ((coreFiberTransportFunctor input.square.bottom).obj
          ((geometryFiberProjection input.square.southwest).obj
            (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq)))).hom = _
  rw [hglobal]
  rw [hmap]
  rw [semanticDerivedPullCoreLift_eq]

/-- The two-step cancellation principle needed to identify the projection of
the complete geometry comparison with the independent core mate. -/
theorem semanticDerivedBarAlpha_projection_of_post_fac
    {U : AtomCarrier.{u}}
    (input : BCSemanticInput U) (Q : AATCorePackage U)
    (k : Type v) [CommRing k] (g : FixedCoefficientGeometryAt Q k)
    (endpoint_eq : packagePoint Q = input.square.southwest)
    (square_isPullback : IsPullback input.square.left input.square.top
      input.square.bottom input.square.right)
    : let sourceCore := (geometryFiberProjection input.square.southwest).obj
        (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq)
      let rightTarget := (coreFiberTransportFunctor input.square.bottom).obj sourceCore
      let rightLift := (exact_bottom_semantic_global_selected_lift
        input.square.right rightTarget).hom
      let topLift := (geometryProjection U).map
        (geomFiberLift input.square.top
          (semanticDerivedLeftPulledGeometryAt input Q k g endpoint_eq))
      (
      topLift ≫
        (((geometryFiberProjection input.square.northeast).map
          (semanticDerivedBarAlphaIsoAt input Q k g endpoint_eq
            square_isPullback).hom ≫
          (semanticDerivedViaBaseCoreIsoAt input Q k g endpoint_eq).hom).1 ≫
            rightLift) =
      topLift ≫
        (((semanticDerivedDirectCoreIsoAt input Q k g endpoint_eq).hom ≫
          (semanticCoreBeckChevalleyMate input).app sourceCore).1 ≫
            rightLift)) →
    (geometryFiberProjection input.square.northeast).map
          (semanticDerivedBarAlphaIsoAt input Q k g endpoint_eq
            square_isPullback).hom ≫
        (semanticDerivedViaBaseCoreIsoAt input Q k g endpoint_eq).hom =
      (semanticDerivedDirectCoreIsoAt input Q k g endpoint_eq).hom ≫
        (semanticCoreBeckChevalleyMate input).app sourceCore := by
  dsimp only
  intro hpost
  let sourceCore := (geometryFiberProjection input.square.southwest).obj
    (semanticDerivedSouthwestGeometryFiber input Q k g endpoint_eq)
  let rightTarget := (coreFiberTransportFunctor input.square.bottom).obj sourceCore
  let rightLift := (exact_bottom_semantic_global_selected_lift
    input.square.right rightTarget).hom
  let topLift := (geometryProjection U).map
    (geomFiberLift input.square.top
      (semanticDerivedLeftPulledGeometryAt input Q k g endpoint_eq))
  let lhs := (geometryFiberProjection input.square.northeast).map
      (semanticDerivedBarAlphaIsoAt input Q k g endpoint_eq
        square_isPullback).hom ≫
      (semanticDerivedViaBaseCoreIsoAt input Q k g endpoint_eq).hom
  let rhs := (semanticDerivedDirectCoreIsoAt input Q k g endpoint_eq).hom ≫
    (semanticCoreBeckChevalleyMate input).app sourceCore
  change lhs = rhs
  apply CategoryTheory.Functor.Fiber.hom_ext
  letI : (packageProjection U).IsHomLift
      (𝟙 input.square.northeast) lhs.1 := lhs.2
  letI : (packageProjection U).IsHomLift
      (𝟙 input.square.northeast) rhs.1 := rhs.2
  change lhs.1 = rhs.1
  letI : (packageProjection U).IsStronglyCartesian
      input.square.right rightLift :=
    (exact_bottom_semantic_global_selected_lift
      input.square.right rightTarget).isStronglyCartesian
  apply CategoryTheory.Functor.IsStronglyCartesian.ext
    (packageProjection U) input.square.right rightLift
    (𝟙 input.square.northeast) (ψ := lhs.1) (ψ' := rhs.1)
  letI : (packageProjection U).IsStronglyCocartesian
      input.square.top topLift :=
    projectedGeomFiberLift_isStronglyCocartesian input.square.top
      (semanticDerivedLeftPulledGeometryAt input Q k g endpoint_eq)
  apply CategoryTheory.Functor.IsStronglyCocartesian.ext
    (packageProjection U) input.square.top topLift
    input.square.right (ψ := lhs.1 ≫ rightLift)
    (ψ' := rhs.1 ≫ rightLift)
  simpa only [lhs, rhs, sourceCore, rightTarget, rightLift, topLift] using hpost

end AAT.AG.FullGeometryNormalization

#assert_standard_axioms_only AAT.AG.FullGeometryNormalization
