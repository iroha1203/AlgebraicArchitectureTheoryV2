import ResearchLean.AG.RealizationComparisonIdempotents.QualifiedComparisonGroup

/-!
# Generated qualified comparison groups

This file constructs G-119(B3).  It specializes the identity-idempotent
comparison object and the qualified comparison group equivalence to every
upper-geometry-compatible mate generated by the G-118 input data.

## Implementation notes

The generated source, target, and comparison are retained definitionally; no
identity condition is imposed on the comparison itself.  The endpoint
projection theorems explicitly reuse the general B2 compatibility results so
that the specialization carries no additional certificate or premise.
-/

open CategoryTheory CategoryTheory.Idempotents

namespace AAT.AG.RealizationComparisonIdempotents

open AtomFoundation GeometryTransport CrossStageCoherence
open DoctrineFiberProduct TransportCoherence

universe u v

/-- The generated upper-geometry mate, embedded with identity endpoint
idempotents in the maximal comparison subgroupoid. -/
noncomputable def generatedCompatibleReversibleComparisonAt
    {U : AtomCarrier.{u}} {ctx : ActiveRefinementBCContext U}
    {P : FiniteTransportPresentation.{u}} {k : CommRingCat.{v}}
    (input : UpperGeometryCompatibleProblemInputData ctx P k) (i : P.Vertex) :
    ReversibleRepresentationChanges (GeomReadCategory.{u, v} U) :=
  identityIdempotentReversibleComparison
    (input.generatedCompatibleUpperGeometryMateAt i)

/-- Normalization rule: the generated comparison object retains its source endpoint. -/
@[simp]
theorem generatedCompatibleReversibleComparisonAt_left_X
    {U : AtomCarrier.{u}} {ctx : ActiveRefinementBCContext U}
    {P : FiniteTransportPresentation.{u}} {k : CommRingCat.{v}}
    (input : UpperGeometryCompatibleProblemInputData ctx P k) (i : P.Vertex) :
    (generatedCompatibleReversibleComparisonAt input i).of.left.X =
      input.generatedBaseRouteGeometryAt i :=
  identityIdempotentReversibleComparison_left_X _

/-- Normalization rule: the generated source endpoint keeps the identity idempotent. -/
@[simp]
theorem generatedCompatibleReversibleComparisonAt_left_p
    {U : AtomCarrier.{u}} {ctx : ActiveRefinementBCContext U}
    {P : FiniteTransportPresentation.{u}} {k : CommRingCat.{v}}
    (input : UpperGeometryCompatibleProblemInputData ctx P k) (i : P.Vertex) :
    (generatedCompatibleReversibleComparisonAt input i).of.left.p =
      (𝟙 (input.generatedBaseRouteGeometryAt i) : GeometryTotalHom _ _) :=
  identityIdempotentReversibleComparison_left_p _

/-- Normalization rule: the generated comparison object retains its target endpoint. -/
@[simp]
theorem generatedCompatibleReversibleComparisonAt_right_X
    {U : AtomCarrier.{u}} {ctx : ActiveRefinementBCContext U}
    {P : FiniteTransportPresentation.{u}} {k : CommRingCat.{v}}
    (input : UpperGeometryCompatibleProblemInputData ctx P k) (i : P.Vertex) :
    (generatedCompatibleReversibleComparisonAt input i).of.right.X =
      input.generatedPulledRouteGeometryAt i :=
  identityIdempotentReversibleComparison_right_X _

/-- Normalization rule: the generated target endpoint keeps the identity idempotent. -/
@[simp]
theorem generatedCompatibleReversibleComparisonAt_right_p
    {U : AtomCarrier.{u}} {ctx : ActiveRefinementBCContext U}
    {P : FiniteTransportPresentation.{u}} {k : CommRingCat.{v}}
    (input : UpperGeometryCompatibleProblemInputData ctx P k) (i : P.Vertex) :
    (generatedCompatibleReversibleComparisonAt input i).of.right.p =
      (𝟙 (input.generatedPulledRouteGeometryAt i) : GeometryTotalHom _ _) :=
  identityIdempotentReversibleComparison_right_p _

/-- Normalization rule: the generated comparison object retains the generated mate. -/
@[simp]
theorem generatedCompatibleReversibleComparisonAt_hom_f
    {U : AtomCarrier.{u}} {ctx : ActiveRefinementBCContext U}
    {P : FiniteTransportPresentation.{u}} {k : CommRingCat.{v}}
    (input : UpperGeometryCompatibleProblemInputData ctx P k) (i : P.Vertex) :
    (generatedCompatibleReversibleComparisonAt input i).of.hom.f =
      input.generatedCompatibleUpperGeometryMateAt i :=
  identityIdempotentReversibleComparison_hom_f _

/-- Normalization rule: projection retains the generated mate's actual base map,
without requiring it to be an identity. -/
@[simp]
theorem generatedCompatibleReversibleComparisonAt_projected_hom
    {U : AtomCarrier.{u}} {ctx : ActiveRefinementBCContext U}
    {P : FiniteTransportPresentation.{u}} {k : CommRingCat.{v}}
    (input : UpperGeometryCompatibleProblemInputData ctx P k) (i : P.Vertex) :
    ((crossStageComparisonProjection U).obj
      (generatedCompatibleReversibleComparisonAt input i).of).hom.f =
      (input.generatedCompatibleUpperGeometryMateAt i).base.base :=
  identityIdempotentReversibleComparison_projected_hom _

/-- Base-qualified reversible changes of the generated comparison object. -/
noncomputable def generatedCompatibleBaseQualifiedReversibleComparisonSubgroup
    {U : AtomCarrier.{u}} {ctx : ActiveRefinementBCContext U}
    {P : FiniteTransportPresentation.{u}} {k : CommRingCat.{v}}
    (input : UpperGeometryCompatibleProblemInputData ctx P k) (i : P.Vertex) :
    Subgroup (Aut (generatedCompatibleReversibleComparisonAt input i)) :=
  baseQualifiedReversibleComparisonSubgroup
    (input.generatedCompatibleUpperGeometryMateAt i)

/-- G-119(B3): the general qualified comparison group identification at the
generated upper-geometry mate. -/
noncomputable def generatedCompatibleQualifiedComparisonReversibleMulEquiv
    {U : AtomCarrier.{u}} {ctx : ActiveRefinementBCContext U}
    {P : FiniteTransportPresentation.{u}} {k : CommRingCat.{v}}
    (input : UpperGeometryCompatibleProblemInputData ctx P k) (i : P.Vertex) :
    qualifiedComparisonSubgroup (input.generatedCompatibleUpperGeometryMateAt i) ≃*
      generatedCompatibleBaseQualifiedReversibleComparisonSubgroup input i :=
  qualifiedComparisonReversibleMulEquiv _

/-- Normalization rule: the generated group identification preserves the
existing source projection. -/
@[simp]
theorem generatedCompatibleQualifiedComparisonReversibleMulEquiv_source_projection
    {U : AtomCarrier.{u}} {ctx : ActiveRefinementBCContext U}
    {P : FiniteTransportPresentation.{u}} {k : CommRingCat.{v}}
    (input : UpperGeometryCompatibleProblemInputData ctx P k) (i : P.Vertex)
    (q : qualifiedComparisonSubgroup
      (input.generatedCompatibleUpperGeometryMateAt i)) :
    baseQualifiedReversibleComparisonSourceProjection
        (input.generatedCompatibleUpperGeometryMateAt i)
        (generatedCompatibleQualifiedComparisonReversibleMulEquiv input i q) =
      qualifiedComparisonSourceProjection
        (input.generatedCompatibleUpperGeometryMateAt i) q :=
  qualifiedComparisonReversibleMulEquiv_source_projection _ q

/-- Normalization rule: the generated group identification preserves the
existing target projection. -/
@[simp]
theorem generatedCompatibleQualifiedComparisonReversibleMulEquiv_target_projection
    {U : AtomCarrier.{u}} {ctx : ActiveRefinementBCContext U}
    {P : FiniteTransportPresentation.{u}} {k : CommRingCat.{v}}
    (input : UpperGeometryCompatibleProblemInputData ctx P k) (i : P.Vertex)
    (q : qualifiedComparisonSubgroup
      (input.generatedCompatibleUpperGeometryMateAt i)) :
    baseQualifiedReversibleComparisonTargetProjection
        (input.generatedCompatibleUpperGeometryMateAt i)
        (generatedCompatibleQualifiedComparisonReversibleMulEquiv input i q) =
      qualifiedComparisonTargetProjection
        (input.generatedCompatibleUpperGeometryMateAt i) q :=
  qualifiedComparisonReversibleMulEquiv_target_projection _ q

#assert_standard_axioms_only AAT.AG.RealizationComparisonIdempotents

end AAT.AG.RealizationComparisonIdempotents
