import Formal.Util.AssertStandardAxioms
import ResearchLean.AG.RelativeRepairComposition.FiniteElimination
import Mathlib.LinearAlgebra.Matrix.ToLin
import Mathlib.LinearAlgebra.Basis.Basic

/-!
# Full image coordinates generated by the row reduction

## Implementation notes

Nonzero diagonal positions index the whole image. Its coordinates and inverse
are explicitly computed from the generated row and column matrices. They give
an effective image basis, rather than an externally selected image subspace.
-/
namespace AAT.AG.RelativeRepairComposition.FiniteElimination
open Matrix Module
universe uk un
variable {k : Type uk} [Field k] [DecidableEq k]
variable {n : Type un} [Fintype n] [DecidableEq n]
variable (M : Matrix n n k) (R : Reduction M)

/-- Every nonzero reduced pivot is retained with its original row index. -/
abbrev Active := {i : n // R.value i ≠ 0}

/-- Insert active coordinate values and exactly zero at all other reduced rows. -/
def activeExtend (v : Active M R → k) : n → k :=
  fun i => if hi : R.value i ≠ 0 then v ⟨i,hi⟩ else 0

omit [DecidableEq k] in
/-- Undoing the row operation expresses the complete original column map. -/
theorem matrix_factor : M * R.column = R.rowInv * Matrix.diagonal R.value := by
  have h := congrArg (fun X => R.rowInv * X) R.diagonal_eq
  have hr : R.rowInv * R.row = 1 := R.row_inverse.2
  have hh : (R.rowInv * R.row) * M * R.column = R.rowInv * Matrix.diagonal R.value := by
    simpa only [Matrix.mul_assoc] using h
  simpa only [hr,Matrix.one_mul] using hh

omit [DecidableEq k] in
/-- Undoing the column operation expresses every complete reduced row value. -/
theorem row_factor : R.row * M = Matrix.diagonal R.value * R.columnInv := by
  have h := congrArg (fun X => X * R.columnInv) R.diagonal_eq
  have hc : R.column * R.columnInv = 1 := R.column_inverse.1
  have hh : R.row * M * (R.column * R.columnInv) = Matrix.diagonal R.value * R.columnInv := by
    simpa only [Matrix.mul_assoc] using h
  simpa only [hc,Matrix.mul_one] using hh

/-- Read all image coordinates after the generated row operation. -/
def imageCoordinate (h : LinearMap.range (Matrix.toLin' M)) : Active M R → k :=
  fun i => Matrix.toLin' R.row h.1 i.1

omit [DecidableEq k] in
/-- All inactive rows of every original image value vanish. -/
theorem inactive_image_zero (h : LinearMap.range (Matrix.toLin' M)) (i : n) (hi : R.value i = 0) :
    Matrix.toLin' R.row h.1 i = 0 := by
  obtain ⟨x,hx⟩ := h.2
  rw [← hx,Matrix.toLin'_apply,Matrix.toLin'_apply,Matrix.mulVec_mulVec,row_factor]
  rw [← Matrix.mulVec_mulVec,Matrix.mulVec_diagonal,hi,zero_mul]

/-- Reconstruct the whole original image from every active coordinate. -/
def imageRestore (v : Active M R → k) : LinearMap.range (Matrix.toLin' M) :=
  ⟨Matrix.toLin' R.rowInv (activeExtend M R v),by
    refine ⟨Matrix.toLin' R.column (Matrix.toLin' (Matrix.diagonal (fun i => (R.value i)⁻¹)) (activeExtend M R v)),?_⟩
    simp only [Matrix.toLin'_apply,Matrix.mulVec_mulVec]
    rw [← Matrix.mul_assoc,matrix_factor,Matrix.mul_assoc]
    rw [← Matrix.mulVec_mulVec]
    congr 1
    rw [← Matrix.mulVec_mulVec]
    funext i
    simp only [Matrix.mulVec_diagonal]
    by_cases hi : R.value i = 0
    · simp [activeExtend,hi]
    · simp [hi]⟩

/-- Active coordinates retain every complete reconstructed image value. -/
theorem image_coordinate_restore (v : Active M R → k) : imageCoordinate M R (imageRestore M R v) = v := by
  funext i
  change Matrix.toLin' R.row (Matrix.toLin' R.rowInv (activeExtend M R v)) i.1 = v i
  simp only [Matrix.toLin'_apply,Matrix.mulVec_mulVec,R.row_inverse.1,Matrix.one_mulVec]
  exact dif_pos i.2

/-- Full original image values survive both coordinate operations. -/
theorem image_restore_coordinate (h : LinearMap.range (Matrix.toLin' M)) : imageRestore M R (imageCoordinate M R h) = h := by
  apply Subtype.ext
  have he : activeExtend M R (imageCoordinate M R h) = Matrix.toLin' R.row h.1 := by
    funext i
    unfold activeExtend
    split
    · rfl
    · exact (inactive_image_zero M R h i (not_ne_iff.mp ‹¬ R.value i ≠ 0›)).symm
  change Matrix.toLin' R.rowInv (activeExtend M R (imageCoordinate M R h)) = h.1
  rw [he]
  simp only [Matrix.toLin'_apply,Matrix.mulVec_mulVec,R.row_inverse.2,Matrix.one_mulVec]

/-- The whole original image has full mutually inverse effective pivot coordinates. -/
def imageEquivalence : LinearMap.range (Matrix.toLin' M) ≃ₗ[k] (Active M R → k) where
  toFun := imageCoordinate M R
  invFun := imageRestore M R
  left_inv := image_restore_coordinate M R
  right_inv := image_coordinate_restore M R
  map_add' h h' := by
    funext i
    change Matrix.toLin' R.row (h.1 + h'.1) i.1 = _
    exact congrFun ((Matrix.toLin' R.row).map_add h.1 h'.1) i.1
  map_smul' t h := by
    funext i
    change Matrix.toLin' R.row (t • h.1) i.1 = _
    exact congrFun ((Matrix.toLin' R.row).map_smul t h.1) i.1

/-- Every generated image basis vector is reconstructed in the complete original image. -/
def imageBasisValue (i : Active M R) : LinearMap.range (Matrix.toLin' M) :=
  imageRestore M R (Pi.single i 1)

/-- The native basis is identified with the explicitly generated original image vectors. -/
noncomputable def imageBasis : Basis (Active M R) k (LinearMap.range (Matrix.toLin' M)) :=
  Basis.ofEquivFun (imageEquivalence M R)

/-- Native basis values are precisely the computed original image vectors. -/
theorem image_basis_value (i : Active M R) : imageBasis M R i = imageBasisValue M R i := by
  exact congrFun (Basis.coe_ofEquivFun (imageEquivalence M R)) i

/-- The computed image vectors are independent in the full original image. -/
theorem image_basis_independent : LinearIndependent k (imageBasisValue M R) := by
  have he : imageBasis M R = imageBasisValue M R := funext (image_basis_value M R)
  rw [← he]
  exact (imageBasis M R).linearIndependent

/-- The computed vectors span the complete original image. -/
theorem image_basis_span : Submodule.span k (Set.range (imageBasisValue M R)) = ⊤ := by
  have he : imageBasis M R = imageBasisValue M R := funext (image_basis_value M R)
  rw [← he]
  exact (imageBasis M R).span_eq

end AAT.AG.RelativeRepairComposition.FiniteElimination

#assert_standard_axioms_only AAT.AG.RelativeRepairComposition
