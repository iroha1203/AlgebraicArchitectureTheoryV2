import Formal.Util.AssertStandardAxioms
import ResearchLean.AG.RelativeRepairComposition.LinearInterface

/-!
# Full original-label action on the generated interface

## Implementation notes

The label is the entire original zero-cochain. In particular two labels with
the same effect remain different arrows, and all stabilizers are preserved.
-/
namespace AAT.AG.RelativeRepairComposition.LinearInterface
open CategoryTheory
universe uk ux uz uv ub
variable {k : Type uk} [Field k]
variable {X : Type ux} {Z : Type uz} {V : Type uv} {B : Type ub}
variable [AddCommGroup X] [Module k X] [AddCommGroup Z] [Module k Z]
variable [AddCommGroup V] [Module k V] [AddCommGroup B] [Module k B]
variable (D : X →ₗ[k] V) (F : Z →ₗ[k] V) (σ : V →ₗ[k] X)
variable (hσ : ∀ x, D (σ (D x)) = D x)
variable (a : B →ₗ[k] X) (c : B →ₗ[k] Z)
variable (hzero : ∀ b, D (a b) + F (c b) = 0) (r : V)

/-- The internal label component is generated by subtracting the section contribution. -/
def gamma : B →ₗ[k] LinearMap.ker D where
  toFun b := ⟨a b - σ (D (a b)),by
    change D (a b - σ (D (a b))) = 0
    rw [map_sub,hσ,sub_self]⟩
  map_add' b b' := Subtype.ext (by
    change a (b + b') - σ (D (a (b + b'))) = (a b - σ (D (a b))) + (a b' - σ (D (a b')))
    simp only [map_add]
    abel)
  map_smul' t b := Subtype.ext (by
    change a (t • b) - σ (D (a (t • b))) = t • (a b - σ (D (a b)))
    simp only [map_smul,smul_sub])

include hσ hzero in
/-- Every original label has zero projected public coboundary. -/
theorem projection_c (b : B) : projection D σ (F (c b)) = 0 := by
  have hc : F (c b) = -D (a b) := eq_neg_iff_add_eq_zero.mpr (by simpa only [add_comm] using hzero b)
  rw [hc,map_neg,projection_D D σ hσ,neg_zero]

/-- Full interface objects are indexed by the same original label maps. -/
def Objects (_hσ : ∀ x, D (σ (D x)) = D x) (_a : B →ₗ[k] X) (_c : B →ₗ[k] Z) (_hzero : ∀ b, D (_a b) + F (_c b) = 0)
    (r : V) := Coordinates D F σ r

/-- The generated action keeps both the public value and internal degree of freedom. -/
def gauge (b : B) (y : Objects D F σ hσ a c hzero r) : Objects D F σ hσ a c hzero r :=
  (⟨y.1.1 + c b,by
    change projection D σ (F (y.1.1 + c b)) = projection D σ r
    rw [map_add,map_add,y.1.2,projection_c D F σ hσ a c hzero,add_zero]⟩,
   y.2 + gamma D σ hσ a b)

/-- The zero label is identity and sum of full labels is composition. -/
instance interfaceAddAction : AddAction B (Objects D F σ hσ a c hzero r) where
  vadd := gauge D F σ hσ a c hzero r
  zero_vadd y := by
    apply Prod.ext
    · apply Subtype.ext
      change y.1.1 + c 0 = y.1.1
      rw [map_zero,add_zero]
    · change y.2 + gamma D σ hσ a 0 = y.2
      rw [map_zero,add_zero]
  add_vadd b b' y := by
    apply Prod.ext
    · apply Subtype.ext
      change y.1.1 + c (b + b') = (y.1.1 + c b') + c b
      rw [map_add]
      abel
    · change y.2 + gamma D σ hσ a (b + b') = (y.2 + gamma D σ hσ a b') + gamma D σ hσ a b
      rw [map_add]
      abel

/-- Reconstruction commutes with the full original coboundary. -/
theorem rec_gauge (b : B) (y : Objects D F σ hσ a c hzero r) :
    (rec D F σ r (gauge D F σ hσ a c hzero r b y)).1 =
      (rec D F σ r y).1 + (a b,c b) := by
  have hc : F (c b) = -D (a b) := eq_neg_iff_add_eq_zero.mpr (by simpa only [add_comm] using hzero b)
  apply Prod.ext
  · change σ (r - F (y.1.1 + c b)) + (y.2.1 + (a b - σ (D (a b)))) =
        (σ (r - F y.1.1) + y.2.1) + a b
    rw [map_add,hc,sub_add_eq_sub_sub,sub_neg_eq_add,map_add]
    abel
  · rfl

/-- The native groupoid retains every original label arrow. -/
abbrev Groupoid := by
  letI := interfaceAddAction D F σ hσ a c hzero r
  exact ActionCategory (Multiplicative B) (Objects D F σ hσ a c hzero r)

/-- The uneliminated equation uses the same two full differential components. -/
def differential : (X × Z) →ₗ[k] V := D.comp (LinearMap.fst k X Z) + F.comp (LinearMap.snd k X Z)

/-- The original full label maps to both its internal and public coboundary. -/
def coboundary : B →ₗ[k] (X × Z) := a.prod c

include hzero in
/-- The differential square is zero from the same original coboundary identity. -/
theorem differential_coboundary (b : B) : differential D F (coboundary a c b) = 0 := hzero b

/-- Independent equation objects with the original full-label native action. -/
abbrev EquationObjects := Equation.Solution (coboundary a c).toAddMonoidHom
  (differential D F).toAddMonoidHom (differential_coboundary D F a c hzero) r

/-- The complete interface coordinates are mutually inverse on the independent equation. -/
def equationCoordinateEquiv : EquationObjects D F a c hzero r ≃ Objects D F σ hσ a c hzero r where
  toFun h := coord D F σ hσ r ⟨h.1,h.2⟩
  invFun y := ⟨(rec D F σ r y).1,(rec D F σ r y).2⟩
  left_inv h := Subtype.ext (congrArg Subtype.val (rec_coord D F σ hσ r ⟨h.1,h.2⟩))
  right_inv y := coord_rec D F σ hσ r y

/-- Coordinate changes commute with each full original label, including all stabilizers. -/
theorem equation_coordinate_equivariant (b : Multiplicative B) (h : EquationObjects D F a c hzero r) :
    equationCoordinateEquiv D F σ hσ a c hzero r (b • h) =
      b • equationCoordinateEquiv D F σ hσ a c hzero r h := by
  apply (equationCoordinateEquiv D F σ hσ a c hzero r).symm.injective
  rw [Equiv.symm_apply_apply]
  apply Subtype.ext
  change h.1 + (a b.toAdd,c b.toAdd) =
    (rec D F σ r (gauge D F σ hσ a c hzero r b.toAdd
      (equationCoordinateEquiv D F σ hσ a c hzero r h))).1
  rw [rec_gauge]
  exact congrArg (fun x : X × Z => x + (a b.toAdd,c b.toAdd))
    (congrArg Subtype.val (rec_coord D F σ hσ r ⟨h.1,h.2⟩)).symm

/-- Full native equivalence preserves objects, every label, and both inverse restorations. -/
def equationEquivalence :
    Equation.Groupoid (coboundary a c).toAddMonoidHom (differential D F).toAddMonoidHom
      (differential_coboundary D F a c hzero) r ≌ Groupoid D F σ hσ a c hzero r :=
  changedLabelEquivalence (MulEquiv.refl (Multiplicative B))
    (equationCoordinateEquiv D F σ hσ a c hzero r)
    (equation_coordinate_equivariant D F σ hσ a c hzero r)

/-- Every forward arrow has exactly its original full label. -/
theorem equation_functor_label {x y : Equation.Groupoid (coboundary a c).toAddMonoidHom
    (differential D F).toAddMonoidHom (differential_coboundary D F a c hzero) r} (f : x ⟶ y) :
    ((equationEquivalence D F σ hσ a c hzero r).functor.map f).1 = f.1 := rfl

/-- Every inverse arrow restores exactly the same full label. -/
theorem equation_inverse_label {x y : Groupoid D F σ hσ a c hzero r} (f : x ⟶ y) :
    ((equationEquivalence D F σ hσ a c hzero r).inverse.map f).1 = f.1 := rfl

end AAT.AG.RelativeRepairComposition.LinearInterface

#assert_standard_axioms_only AAT.AG.RelativeRepairComposition
