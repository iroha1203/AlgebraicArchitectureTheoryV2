import ResearchLean.AG.RelativeRepairComposition.FinitePresentationEmbedding

/-! # Full typed common-presentation embedding generated by the actual parallel pins -/
namespace AAT.AG.RelativeRepairComposition.ParallelPinGeometry
open TransportCoherence
universe uG
variable (K : FiniteTransportPresentation.{uG})

/-- The actual finite pin construction embeds every original cell and typed context. -/
noncomputable def embedding : FinitePresentationEmbedding K (presentation K) where
  vertex := id
  vertex_injective := Function.injective_id
  edge := fun e => .inl e
  edge_injective _ _ := Sum.inl_injective
  path := includePath K
  path_nil _ := rfl
  path_cons _ _ := rfl
  face := Sum.inl
  face_injective := Sum.inl_injective
  face_source _ := rfl
  face_target _ := rfl
  face_left _ := HEq.rfl
  face_right _ := HEq.rfl
  step := fun s => includeStep K s
  step_face _ := rfl
  step_incoming _ := HEq.rfl
  step_outgoing _ := HEq.rfl
  step_orientation _ := rfl
  route := fun p => includePasting K p
  route_nil _ := rfl
  route_cons _ _ := rfl
  triple := id
  triple_injective := Function.injective_id
  triple_source _ := rfl
  triple_target _ := rfl
  triple_start _ := HEq.rfl
  triple_finish _ := HEq.rfl
  triple_left _ := HEq.rfl
  triple_right _ := HEq.rfl

end AAT.AG.RelativeRepairComposition.ParallelPinGeometry
#assert_standard_axioms_only AAT.AG.RelativeRepairComposition.ParallelPinGeometry
