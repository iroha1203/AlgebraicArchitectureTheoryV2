import ResearchLean.AG.RelativeRepairComposition.NativeAffineTower
import ResearchLean.AG.RelativeRepairComposition.SubdivisionFactors

/-!
# Arbitrary whole affine factors generate the actual subdivision input

Both full affine equivalences are primitive operations. Their actual product
is the old reference at the complete selected edge name. Original L and R
remain distinct inputs on the full original typed geometry.

## Implementation notes

All strongness and entire-kernel bijectivity fields are generated by the same
native group extension. The factory applies in particular to every finite
field and every A=k^d; it does not assume a repair or a cohomology comparison.
-/
namespace AAT.AG.RelativeRepairComposition.NativeAffine
open CategoryTheory TransportCoherence TransportCoherence.Arbitrary AbelianLiftingObstruction
universe uk uA uG
variable {k : Type uk} [Field k] {A : Type uA} [AddCommGroup A] [Module k A]
variable (K : FiniteTransportPresentation.{uG})
variable (L R : ∀ {i j : K.Vertex}, K.Edge i j → Operations k A)
variable (c : K.TwoCell → A)
variable (hfaces : ∀ f : K.TwoCell,
  (GroupExtension.pathValue K R (K.twoLeft f)).linear =
    (GroupExtension.pathValue K R (K.twoRight f)).linear)
variable (chosen : EdgeName (K := K)) (first second : Operations k A)
variable (hproduct : second * first = R chosen.2.2)
local notation "π" => projection (k := k) (A := A)

/-- Primitive whole affine operations generate every field of the same actual factorization. -/
noncomputable def subdivisionFactors : Subdivision.Factorization (tower K L R c hfaces) chosen where
  middle := SingleObj.star (Operations k A)
  first := first
  second := second
  composite := by
    rw [tower_reference_edge]
    exact hproduct
  firstStrong := by simpa using GroupExtension.selectedStrong π first
  secondStrong := by simpa using GroupExtension.selectedStrong π second
  firstLowerStrong := by simpa using GroupExtension.selectedLowerStrong π first
  secondLowerStrong := by simpa using GroupExtension.selectedLowerStrong π second
  firstBijective := GroupExtension.transport_bijective π first
  secondBijective := GroupExtension.transport_bijective π second

/-- The generated first arrow is literally the supplied entire affine equivalence. -/
theorem subdivisionFactors_first :
    (subdivisionFactors K L R c hfaces chosen first second hproduct).first = first := rfl

/-- The generated second arrow is literally the supplied entire affine equivalence. -/
theorem subdivisionFactors_second :
    (subdivisionFactors K L R c hfaces chosen first second hproduct).second = second := rfl

/-- The generated actual factor composite recovers the arbitrary old selected reference. -/
theorem subdivisionFactors_product :
    (subdivisionFactors K L R c hfaces chosen first second hproduct).first ≫
      (subdivisionFactors K L R c hfaces chosen first second hproduct).second =
      (tower K L R c hfaces).toTower.upper.edgeLift chosen.2.2 :=
  (subdivisionFactors K L R c hfaces chosen first second hproduct).composite

end AAT.AG.RelativeRepairComposition.NativeAffine
#assert_standard_axioms_only AAT.AG.RelativeRepairComposition.NativeAffine
