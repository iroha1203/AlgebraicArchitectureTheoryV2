import ResearchLean.AG.RepairObservationDuality.FinitePlanningBranches
import ResearchLean.AG.RepairObservationDuality.PrimitiveOutputEquivalence
/-!
# G-131 D: complete generated answers in the prescribed full coordinates

## Implementation notes

The source equivalence retains every full coordinate. Its matrix equality is
generated by ActualFinitePlanning.matrix_differential, not a supplied solver
or successful output. Both success and none are transported, and arbitrary
correct procedures in both full answer representations have equal costs.
-/
namespace AAT.AG.RepairObservationDuality.FiniteCoordinatePlanning
open RelativeRepairComposition PrimitiveQueries
universe uk ui uv uh uI uJ
variable {k : Type uk} [Field k] [Fintype k] [DecidableEq k]
variable {m n : Type ui} [Fintype m] [DecidableEq m] [Fintype n] [DecidableEq n]
variable {V : Type uv} [AddCommGroup V] [Module k V]
variable {H : Type uh} [AddCommGroup H] [Module k H]
variable {I : Type uI} [AddCommGroup I] [Module k I] [DecidableEq I]
variable {J : Type uJ} [DecidableEq J]
variable (eH : H ≃ₗ[k] (n → k)) (D : H →ₗ[k] (m → k)) (M : Matrix m n k)
variable (hD : FiniteMatrixSolver.differential M = D.comp eH.symm.toLinearMap)
include hD

omit [Fintype k] [DecidableEq k] [Fintype m] [DecidableEq m] [AddCommGroup V] [Module k V] in
/-- Full matrix answers and their inverse complete coordinates satisfy the same independent validator. -/
theorem valid_iff (rhs : V → (m → k)) (v : V) (out : Option (n → k)) :
    ValidOutput (FiniteMatrixSolver.differential M) rhs v out ↔
      ValidOutput D rhs v (out.map eH.symm) := by
  cases out with
  | none =>
    rw [Option.map_none,validOutput_none_iff,validOutput_none_iff]
    apply not_congr
    constructor
    · rintro ⟨x,hx⟩
      rw [hD] at hx
      exact ⟨eH.symm x,hx⟩
    · rintro ⟨h,hh⟩
      refine ⟨eH h,?_⟩
      rw [hD,LinearMap.comp_apply,LinearEquiv.coe_coe, eH.symm_apply_apply]
      exact hh
  | some x =>
    rw [Option.map_some,validOutput_some_iff,validOutput_some_iff,hD]
    rfl

omit [Fintype k] [DecidableEq k] [Fintype m] [DecidableEq m] [AddCommGroup V] [Module k V] [DecidableEq J] in
/-- Arbitrary full correction procedures retain the same optimum under inverse complete source coordinates. -/
theorem optimum_eq (eval : V → J → k) (F : Set V) (rhs : V → (m → k)) :
    optimum eval F (ValidOutput D rhs) = optimum eval F (ValidOutput (FiniteMatrixSolver.differential M) rhs) := by
  let e : Option (n → k) ≃ Option H := Equiv.optionCongr eH.symm.toEquiv
  have hv : (fun v out => ValidOutput (FiniteMatrixSolver.differential M) rhs v (e.symm out)) =
      ValidOutput D rhs := by
    funext v out
    apply propext
    have hh := valid_iff eH D M hD rhs v (e.symm out)
    have he : (e.symm out).map eH.symm = out := e.apply_symm_apply out
    rwa [he] at hh
  rw [← hv]
  exact PrimitiveOutputEquivalence.optimum_eq eval e F _

omit [Fintype k] [DecidableEq k] [Fintype m] [DecidableEq m] [AddCommGroup V] [Module k V] [DecidableEq J] in
/-- Transporting a generated matrix procedure preserves total correctness of its complete correction values. -/
theorem correct_iff (eval : V → J → k) (F : Set V) (rhs : V → (m → k))
    (next : Procedure J k (Option (n → k))) :
    Correct eval F (ValidOutput D rhs)
      (PrimitiveOutputEquivalence.transport (Equiv.optionCongr eH.symm.toEquiv) next) ↔
      Correct eval F (ValidOutput (FiniteMatrixSolver.differential M) rhs) next := by
  let e : Option (n → k) ≃ Option H := Equiv.optionCongr eH.symm.toEquiv
  have hv : (fun v out => ValidOutput (FiniteMatrixSolver.differential M) rhs v (e.symm out)) =
      ValidOutput D rhs := by
    funext v out
    apply propext
    have hh := valid_iff eH D M hD rhs v (e.symm out)
    have he : (e.symm out).map eH.symm = out := e.apply_symm_apply out
    rwa [he] at hh
  rw [← hv]
  exact PrimitiveOutputEquivalence.correct_iff eval e F _ next

variable (enumK : FiniteElimination.Enumeration k) (enumM : FiniteElimination.Enumeration m)
variable (enumN : FiniteElimination.Enumeration n) (enumV : FiniteElimination.Enumeration V)
variable (enumJ : FiniteElimination.Enumeration J)
variable (B : V →ₗ[k] (m → k)) (b₀ : m → k) (lam : J → V →ₗ[k] k) (L : V →ₗ[k] I) (s : I)

/-- The finite minimum planner computes a correct complete answer in the prescribed coordinates and attains the all-procedure optimum. -/
theorem ready {points : Finset J}
    (hp : FinitePlanningBranches.plan enumK enumM enumN enumV enumJ M B b₀ lam L s B = Sum.inl (some points)) :
    let next := PrimitiveOutputEquivalence.transport (Equiv.optionCongr eH.symm.toEquiv)
      (FiniteRepairPlanning.numericalProcedure enumK enumM enumN enumV enumJ M B b₀ lam L s points)
    Correct (fun v j => lam j v) (informationFiber L s) (ValidOutput D (affineRhs B b₀)) next ∧
      worst (fun v j => lam j v) (informationFiber L s) next =
        optimum (fun v j => lam j v) (informationFiber L s) (ValidOutput D (affineRhs B b₀)) := by
  have h := FinitePlanningBranches.numerical_ready enumK enumM enumN enumV enumJ M B b₀ lam L s hp
  refine ⟨(correct_iff eH D M hD _ _ _ _).mpr h.1,?_⟩
  rw [PrimitiveOutputEquivalence.worst_eq,h.2,← optimum_eq eH D M hD]

end AAT.AG.RepairObservationDuality.FiniteCoordinatePlanning
#assert_standard_axioms_only AAT.AG.RepairObservationDuality.FiniteCoordinatePlanning
