import ResearchLean.AG.RepairObservationDuality.W1GeneratedNumericalPlan
import ResearchLean.AG.RepairObservationDuality.DualValueAcquisition
import ResearchLean.AG.RelativeRepairComposition.W1DualMinimalRanges

/-!
# G-131 E: the same original W1 dual and its primitive acquisition

## Implementation notes

The functional is the original quotient dual generated by G-130, evaluated
on the original actual obstruction. Its pullback is y-x. Value acquisition
is proved on every physical input of the retained fiber and uses precisely
the known-kernel primitive span. The finite reader consumes only received
history and returns that same original dual value.
-/
namespace AAT.AG.RepairObservationDuality.W1DualQueries
open RelativeRepairComposition W1PhysicalInputs W1NumericalEquation W1ObservationCosts PrimitiveQueries
set_option autoImplicit false
set_option maxHeartbeats 2000000
set_option maxRecDepth 4096

/-- The input pullback of the original full W1 quotient dual is y-x. -/
def pullback : Values →ₗ[ZMod 3] ZMod 3 := primitive true - primitive false

/-- The pullback retains both original input coordinate evaluations with their actual signs. -/
theorem pullback_apply (v : Values) : pullback v = v true - v false := rfl

/-- The original actual obstruction and its original quotient dual evaluate to the same primitive pullback. -/
theorem actual_value (X : Inputs) :
    W1DualMinimalRanges.dualCoordinate (values X false) (values X true)
      (W1OriginalObstruction.obstruction (values X false) (values X true)) = pullback (values X) :=
  W1DualMinimalRanges.dualCoordinate_obstruction _ _

/-- Physical acquisition of that original dual value is exactly the restricted primitive span condition. -/
theorem acquisition_iff (m : Fin 3) (w : Values) (points : Finset Bool) :
    (∃ f : (points → ZMod 3) → ZMod 3,
      ∀ X ∈ values ⁻¹' informationFiber (known m) (known m w),
        f (observation primitive points (values X)) =
          W1DualMinimalRanges.dualCoordinate (values X false) (values X true)
            (W1OriginalObstruction.obstruction (values X false) (values X true))) ↔
    pullback.comp (LinearMap.ker (known m)).subtype ∈
      LinearObservationDuality.evaluationSpan
        (fun j => (primitive j).comp (LinearMap.ker (known m)).subtype) points := by
  have h := DualValueAcquisition.acquisition_iff_span (known m) (known m w) primitive points pullback 0
    (w := w) rfl
  rw [← h]
  constructor
  · rintro ⟨f,hf⟩
    refine ⟨f,?_⟩
    intro v hv
    have he := hf (realize v) (by
      change known m (values (realize v)) = known m w
      rw [values_realize]
      exact hv)
    rw [actual_value,values_realize] at he
    simpa only [zero_add,values_realize] using he
  · rintro ⟨f,hf⟩
    refine ⟨f,?_⟩
    intro X hX
    rw [actual_value]
    simpa only [zero_add] using hf (values X) hX

/-- The generated minimum full-value set is sufficient to acquire the same original dual pullback. -/
theorem sufficient (m : Fin 3) :
    SufficientSet primitive (known m) (LinearMap.ker pullback) (W1GeneratedNumericalPlan.points m) := by
  have hp := (FiniteMinimumPlan.plan_spec W1GeneratedNumericalPlan.indices W1GeneratedNumericalPlan.inputs
    primitive (known m) rhsLinear (W1GeneratedNumericalPlan.plan_points m)).1
  intro v hv
  have hn := hp hv
  have hx := congrFun hn 0
  have hy := congrFun hn 1
  change v false = 0 at hx
  change v true = 0 at hy
  rw [LinearMap.mem_ker,pullback_apply,hx,hy,sub_self]

/-- The finite visible-history reader evaluates the original quotient dual on every actual retained-fiber input. -/
theorem read_actual (m : Fin 3) (w : Values) (X : Inputs)
    (hX : known m (values X) = known m w) :
    FiniteObservedValues.readAffine W1GeneratedNumericalPlan.inputs primitive (known m) (known m w)
      pullback 0 (transcript evaluate (FiniteMinimumPlan.questions W1GeneratedNumericalPlan.indices
        (W1GeneratedNumericalPlan.points m)) X) =
      W1DualMinimalRanges.dualCoordinate (values X false) (values X true)
        (W1OriginalObstruction.obstruction (values X false) (values X true)) := by
  rw [PrimitiveInputQueries.transcript_eq values evaluate (fun v j => primitive j v) evaluate_values,
    FiniteObservedValues.readAffine_transcript W1GeneratedNumericalPlan.inputs primitive (known m) (known m w)
      W1GeneratedNumericalPlan.indices (W1GeneratedNumericalPlan.points m) pullback 0 (sufficient m) hX,
    actual_value,zero_add]

end AAT.AG.RepairObservationDuality.W1DualQueries
#assert_standard_axioms_only AAT.AG.RepairObservationDuality.W1DualQueries
