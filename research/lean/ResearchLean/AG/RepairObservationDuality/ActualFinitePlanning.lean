import ResearchLean.AG.RepairObservationDuality.ActualFamilyCoordinates
import ResearchLean.AG.RepairObservationDuality.FiniteFullCoordinates
import ResearchLean.AG.RepairObservationDuality.FiniteCoordinatePlanning
/-!
# G-131 D: generated matrix answers restore the original actual repair

## Implementation notes

The matrix is generated by evaluating the original selected differential in
the same complete prescribed bases, with only a reversible flattening of its
source. G-130's section takes this matrix before acquiring values. Actual
input parameters occur only in correctness and restoration, while the query
finisher takes visible history. Restoration is the mathematical inverse for
actual arrows and keeps all correction values and fixed arrows.
-/
namespace AAT.AG.RepairObservationDuality.ActualFinitePlanning
open CategoryTheory TransportCoherence TransportCoherence.Arbitrary
open AbelianLiftingObstruction RelativeRepairComposition PrimitiveAffineDefect
set_option autoImplicit false
universe uk uV uF uG uE uB uD vE vB vD
variable {k : Type uk} [Field k]
variable {V : Type uV} [AddCommGroup V] [Module k V]
variable {F : Type uF}
variable {K : FiniteTransportPresentation.{uG}}
variable {E : Type uE} {B : Type uB} {D : Type uD}
variable [Category.{vE} E] [Category.{vB} B] [Category.{vD} D]
variable {p : E ⥤ B} {q : B ⥤ D}
variable (T : TowerPresentation K p q)
variable [∀ v, Module k ((T.localCoefficients).A v)]
variable (edgeChange : V →ₗ[k] (C1 (T.localCoefficients)))
variable (comparisonChange : V →ₗ[k] (C2 (T.localCoefficients)))
variable (input : F → OriginalTowerPresentation K p q) (ν : F → V)
variable (hdata : ∀ X : F, (input X).toTower.toTransportData =
  data T (edgeChange (ν X)) (comparisonChange (ν X)))

variable (realize : V → F) (hrealize : ∀ v, ν (realize v) = v)
variable (P : ClosedRegion K)
variable (hfixed : ∀ X : F, ∀ f ∈ P.faces,
  (input X).toTower.upper.pathLift (K.twoLeft f) ≫
    FiberAut.hom ((input X).comparator f) =
  (input X).toTower.upper.pathLift (K.twoRight f))
variable (hlinear : ∀ {i j : K.Vertex} (e : K.Edge i j) (t : k)
  (x : (T.localCoefficients).A i),
  (T.localCoefficients).edge e (t • x) = t • (T.localCoefficients).edge e x)
variable (bases : FiniteFamily.Bases (k := k) T.localCoefficients.A)
variable (candidates : Set (EdgeName (K := K))) [DecidablePred (· ∈ candidates)]
variable (houtside : ∀ e ∈ candidates, e ∉ P.edges)
variable [Fintype (EdgeName (K := K))] [DecidableEq (EdgeName (K := K))]
attribute [local instance] Classical.propDecidable
local notation "D₀" => OriginalColumns.D (k := k) T.localCoefficients P candidates hlinear
local notation "C" => OriginalColumns.column (k := k) T.localCoefficients P candidates houtside hlinear
local notation "fixed" => ActualAffineFamily.model_fixed T edgeChange comparisonChange input ν hdata realize hrealize P hfixed
local notation "b₀" => RelativeAffineDefect.baseRhs T edgeChange comparisonChange P fixed
local notation "B₀" => RelativeAffineDefect.rhsLinear T hlinear edgeChange comparisonChange P fixed
local notation "eH" => FullCorrectionCoordinates.coordinate (k := k) T.localCoefficients bases P candidates
local notation "eW" => FiniteNative.coordinate2 (k := k) T.localCoefficients bases ClosedRegion.all P


variable (S : Set candidates)
variable [Fintype (FiniteFullCoordinates.Index (k := k) T.localCoefficients bases P candidates S)] [DecidableEq (FiniteFullCoordinates.Index (k := k) T.localCoefficients bases P candidates S)] [Fintype (FiniteNative.Index2 (k := k) T.localCoefficients bases ClosedRegion.all P)] [DecidableEq (FiniteNative.Index2 (k := k) T.localCoefficients bases ClosedRegion.all P)]

local notation "HIndex" => FiniteFullCoordinates.Index (k := k) T.localCoefficients bases P candidates S
local notation "WIndex" => FiniteNative.Index2 (k := k) T.localCoefficients bases ClosedRegion.all P
local notation "flat" => FiniteFullCoordinates.flatten (k := k) T.localCoefficients bases P candidates S
local notation "ND" => ActualFamilyCoordinates.numericalD (k := k) T P hlinear bases candidates houtside S
local notation "NB" => ActualFamilyCoordinates.numericalB (k := k) T edgeChange comparisonChange input ν hdata realize hrealize P hfixed hlinear bases
local notation "NC" => ActualFamilyCoordinates.numericalBase (k := k) T edgeChange comparisonChange input ν hdata realize hrealize P hfixed bases

/-- D's known whole matrix comes from the same actual selected differential and complete original bases. -/
noncomputable def matrix : Matrix (WIndex) (HIndex) k := LinearMap.toMatrix' ((ND).comp (flat).symm.toLinearMap)

omit [Fintype (FiniteNative.Index2 (k := k) T.localCoefficients bases ClosedRegion.all P)]
  [DecidableEq (FiniteNative.Index2 (k := k) T.localCoefficients bases ClosedRegion.all P)] in
/-- The generated matrix acts exactly as the original whole numerical differential after inverse flattening. -/
theorem matrix_differential :
    FiniteMatrixSolver.differential (matrix T P hlinear bases candidates houtside S) =
      (ND).comp (flat).symm.toLinearMap := Matrix.toLin'_toMatrix' _

variable [Fintype k] [DecidableEq k]
variable (enumK : FiniteElimination.Enumeration k) (enumW : FiniteElimination.Enumeration (FiniteNative.Index2 (k := k) T.localCoefficients bases ClosedRegion.all P))
variable (enumH : FiniteElimination.Enumeration (FiniteFullCoordinates.Index (k := k) T.localCoefficients bases P candidates S))

/-- A returned full matrix vector satisfies the same original complete numerical equation. -/
theorem solve_some_original (X : F) (x : (HIndex) → k)
    (hx : FiniteMatrixSolver.solve enumK enumW enumH
      (matrix T P hlinear bases candidates houtside S) (affineRhs (NB) (NC) (ν X)) = some x) :
    (ND) ((flat).symm x) = affineRhs (NB) (NC) (ν X) := by
  have h := ((FiniteMatrixSolver.solve_some_iff enumK enumW enumH
    (matrix T P hlinear bases candidates houtside S) _ x).mp hx).2
  rw [matrix_differential] at h
  exact h

/-- D's fully computed matrix answer restores the independently defined original actual repair. -/
noncomputable def restore (X : F) (x : (HIndex) → k)
    (hx : FiniteMatrixSolver.solve enumK enumW enumH
      (matrix T P hlinear bases candidates houtside S) (affineRhs (NB) (NC) (ν X)) = some x) :
    SupportedRepair (input X)
      (fixedEdgesForRange P.edges candidates (OriginalRanges.allowed candidates S)) :=
  ActualFamilyCoordinates.restore T edgeChange comparisonChange input ν hdata realize hrealize P hfixed
    hlinear bases candidates houtside X S ((flat).symm x)
    (solve_some_original T edgeChange comparisonChange input ν hdata realize hrealize P hfixed
      hlinear bases candidates houtside S enumK enumW enumH X x hx)

/-- Restoration from the generated whole vector keeps each forbidden original correction zero. -/
theorem restore_forbidden_zero (X : F) (x : (HIndex) → k)
    (hx : FiniteMatrixSolver.solve enumK enumW enumH
      (matrix T P hlinear bases candidates houtside S) (affineRhs (NB) (NC) (ν X)) = some x)
    (e : candidates) (he : e ∉ S) :
    (input X).solutionCorrection
      (restore T edgeChange comparisonChange input ν hdata realize hrealize P hfixed hlinear bases
        candidates houtside S enumK enumW enumH X x hx).1 e.1 = 0 :=
  ActualFamilyCoordinates.restore_forbidden_zero T edgeChange comparisonChange input ν hdata realize
    hrealize P hfixed hlinear bases candidates houtside X S ((flat).symm x)
    (solve_some_original T edgeChange comparisonChange input ν hdata realize hrealize P hfixed
      hlinear bases candidates houtside S enumK enumW enumH X x hx) e he

/-- Every generated restored repair preserves the input's original actual fixed arrows. -/
theorem restore_fixed_arrow (X : F) (x : (HIndex) → k)
    (hx : FiniteMatrixSolver.solve enumK enumW enumH
      (matrix T P hlinear bases candidates houtside S) (affineRhs (NB) (NC) (ν X)) = some x)
    (e : EdgeName (K := K))
    (he : e ∈ fixedEdgesForRange P.edges candidates (OriginalRanges.allowed candidates S)) :
    (selectedUpper K p q (input X).original
      (restore T edgeChange comparisonChange input ν hdata realize hrealize P hfixed hlinear bases
        candidates houtside S enumK enumW enumH X x hx).1.choice).edgeLift e.2.2 =
      (input X).toTower.upper.edgeLift e.2.2 :=
  ActualFamilyCoordinates.restore_fixed_arrow T edgeChange comparisonChange input ν hdata realize
    hrealize P hfixed hlinear bases candidates houtside X S ((flat).symm x)
    (solve_some_original T edgeChange comparisonChange input ν hdata realize hrealize P hfixed
      hlinear bases candidates houtside S enumK enumW enumH X x hx) e he

/-- Every generated repair restores all original whole correction values through the two inverse prescribed basis maps. -/
theorem restore_value (X : F) (x : (HIndex) → k)
    (hx : FiniteMatrixSolver.solve enumK enumW enumH
      (matrix T P hlinear bases candidates houtside S) (affineRhs (NB) (NC) (ν X)) = some x)
    (e : EdgeName (K := K)) :
    letI := ActualAffineFamily.inputModules T edgeChange comparisonChange input ν hdata X
    let a := CoefficientTransport.values (k := k) T.localCoefficients
      (input X).toTower.localCoefficients P candidates
      (ActualAffineFamily.input_coefficients T edgeChange comparisonChange input ν hdata X).symm S
      ((eH S).symm ((flat).symm x))
    (input X).solutionCorrection
      (restore T edgeChange comparisonChange input ν hdata realize hrealize P hfixed hlinear bases
        candidates houtside S enumK enumW enumH X x hx).1 e =
      a.1.1.1 ⟨e,Set.mem_univ e⟩ +
      (OriginalRanges.selectedCorrection (k := k) (input X).toTower.localCoefficients P candidates houtside S a.2).1
        ⟨e,Set.mem_univ e⟩ :=
  ActualFamilyCoordinates.restore_value T edgeChange comparisonChange input ν hdata realize hrealize
    P hfixed hlinear bases candidates houtside X S ((flat).symm x)
    (solve_some_original T edgeChange comparisonChange input ν hdata realize hrealize P hfixed
      hlinear bases candidates houtside S enumK enumW enumH X x hx) e

omit [Fintype (FiniteNative.Index2 (k := k) T.localCoefficients bases ClosedRegion.all P)]
  [DecidableEq (FiniteNative.Index2 (k := k) T.localCoefficients bases ClosedRegion.all P)]
  [Fintype k] [DecidableEq k] in

/-- The generated whole matrix decides precisely the same independently defined original actual repair. -/
theorem matrix_actual_equation_iff (X : F) :
    Nonempty (SupportedRepair (input X)
      (fixedEdgesForRange P.edges candidates (OriginalRanges.allowed candidates S))) ↔
    Solvable (FiniteMatrixSolver.differential (matrix T P hlinear bases candidates houtside S))
      (affineRhs (NB) (NC)) (ν X) := by
  rw [ActualFamilyCoordinates.actual_numerical_equation_iff T edgeChange comparisonChange input ν hdata
    realize hrealize P hfixed hlinear bases candidates houtside X S]
  constructor
  · rintro ⟨h,hh⟩
    refine ⟨(flat) h,?_⟩
    rw [matrix_differential,LinearMap.comp_apply,LinearEquiv.coe_coe,LinearEquiv.symm_apply_apply]
    exact hh
  · rintro ⟨x,hx⟩
    rw [matrix_differential] at hx
    exact ⟨(flat).symm x,hx⟩

variable {I : Type*} [AddCommGroup I] [Module k I] [DecidableEq I]
variable {J : Type*} [DecidableEq J]
variable (enumV : FiniteElimination.Enumeration V) (enumJ : FiniteElimination.Enumeration J)
variable (lam : J → V →ₗ[k] k) (L : V →ₗ[k] I) (s : I)
variable (evalActual : F → J → k) (heval : ∀ X j, evalActual X j = lam j (ν X))

/-- D's numerical controller returns every original prescribed correction coordinate from visible primitive replies. -/
noncomputable def numericalProcedure (points : Finset J) : PrimitiveQueries.Procedure J k
    (Option (FullCorrectionCoordinates.NumericalValues (k := k) T.localCoefficients bases P candidates S)) :=
  PrimitiveOutputEquivalence.transport (Equiv.optionCongr (flat).symm.toEquiv)
    (FiniteRepairPlanning.numericalProcedure enumK enumW enumH enumV enumJ
      (matrix T P hlinear bases candidates houtside S) (NB) (NC) lam L s points)

/-- The original complete-output controller changes only the answer coordinates, retaining every primitive question. -/
theorem numericalProcedure_apply (points : Finset J) :
    numericalProcedure T edgeChange comparisonChange input ν hdata realize hrealize P hfixed hlinear bases
      candidates houtside S enumK enumW enumH enumV enumJ lam L s points =
    PrimitiveOutputEquivalence.transport (Equiv.optionCongr (flat).symm.toEquiv)
      (FiniteRepairPlanning.numericalProcedure enumK enumW enumH enumV enumJ
        (matrix T P hlinear bases candidates houtside S) (NB) (NC) lam L s points) := rfl

include heval

/-- D's generated minimum plan is correct and optimal on all actual inputs, returning full original prescribed numerical values. -/
theorem numerical_ready (points : Finset J)
    (hp : FinitePlanningBranches.plan enumK enumW enumH enumV enumJ
      (matrix T P hlinear bases candidates houtside S) (NB) (NC) lam L s (NB) = Sum.inl (some points)) :
    let next := numericalProcedure T edgeChange comparisonChange input ν hdata realize hrealize P hfixed
      hlinear bases candidates houtside S enumK enumW enumH enumV enumJ lam L s points
    PrimitiveQueries.Correct evalActual (ν ⁻¹' informationFiber L s)
      (fun X out => ValidOutput (ND) (affineRhs (NB) (NC)) (ν X) out) next ∧
    PrimitiveQueries.worst evalActual (ν ⁻¹' informationFiber L s) next =
      PrimitiveQueries.optimum evalActual (ν ⁻¹' informationFiber L s)
        (fun X out => ValidOutput (ND) (affineRhs (NB) (NC)) (ν X) out) := by
  have h := FiniteCoordinatePlanning.ready (flat) (ND)
    (matrix T P hlinear bases candidates houtside S) (matrix_differential T P hlinear bases candidates houtside S)
    enumK enumW enumH enumV enumJ (NB) (NC) lam L s hp
  dsimp only at h ⊢
  rw [numericalProcedure_apply]
  refine ⟨(PrimitiveInputQueries.correct_iff ν realize hrealize evalActual (fun v j => lam j v)
    heval (informationFiber L s) _ _).mpr h.1,?_⟩
  rw [PrimitiveInputQueries.worst_eq ν realize hrealize evalActual (fun v j => lam j v) heval,
    PrimitiveInputQueries.optimum_eq ν realize hrealize evalActual (fun v j => lam j v) heval]
  exact h.2

/-- D's computed failure pair is realized by two original actual inputs with identical known values and every primitive reply. -/
theorem actual_failure_pair {W : Type*} [AddCommGroup W] [Module k W] [DecidableEq W]
    (Q : V →ₗ[k] W) {w r : V}
    (hp : FinitePlanningBranches.plan enumK enumW enumH enumV enumJ
      (matrix T P hlinear bases candidates houtside S) (NB) (NC) lam L s Q = Sum.inr (w,r)) :
    L (ν (realize w)) = s ∧ L (ν (realize (w + r))) = s ∧
    (∀ j, evalActual (realize (w + r)) j = evalActual (realize w) j) ∧
    Q (ν (realize (w + r))) ≠ Q (ν (realize w)) ∧
    Nonempty (SupportedRepair (input (realize w))
      (fixedEdgesForRange P.edges candidates (OriginalRanges.allowed candidates S))) := by
  have h := FinitePlanningBranches.failure_spec enumK enumW enumH enumV enumJ
    (matrix T P hlinear bases candidates houtside S) (NB) (NC) lam L s Q hp
  refine ⟨by simpa only [hrealize] using h.1,by simpa only [hrealize] using h.2.2.1,
    fun j => by simpa only [heval,hrealize] using h.2.2.2.1 j,
    by simpa only [hrealize] using h.2.2.2.2.1,?_⟩
  apply (matrix_actual_equation_iff T edgeChange comparisonChange input ν hdata realize hrealize
    P hfixed hlinear bases candidates houtside S (realize w)).mpr
  simpa only [hrealize] using h.2.1

/-- A generated numerical failure rules out every total correct full original-coordinate procedure on the actual fiber. -/
theorem no_actual_numerical_procedure {w r : V}
    (hp : FinitePlanningBranches.plan enumK enumW enumH enumV enumJ
      (matrix T P hlinear bases candidates houtside S) (NB) (NC) lam L s (NB) = Sum.inr (w,r)) :
    ¬ ∃ next : PrimitiveQueries.Procedure J k
      (Option (FullCorrectionCoordinates.NumericalValues (k := k) T.localCoefficients bases P candidates S)),
      PrimitiveQueries.Correct evalActual (ν ⁻¹' informationFiber L s)
        (fun X out => ValidOutput (ND) (affineRhs (NB) (NC)) (ν X) out) next := by
  have h := FinitePlanningBranches.failure_spec enumK enumW enumH enumV enumJ
    (matrix T P hlinear bases candidates houtside S) (NB) (NC) lam L s (NB) hp
  have hs : Solvable (ND) (affineRhs (NB) (NC)) w := by
    obtain ⟨x,hx⟩ := h.2.1
    rw [matrix_differential] at hx
    exact ⟨(flat).symm x,hx⟩
  have hn := no_numerical_procedure lam (ND) (NB) (NC) L s h.1 hs h.2.2.2.2.2
  rintro ⟨next,hc⟩
  exact hn ⟨next,(PrimitiveInputQueries.correct_iff ν realize hrealize evalActual
    (fun v j => lam j v) heval (informationFiber L s) _ next).mp hc⟩

/-- D's finite residual plan decides the independent original actual repair and attains the all-adaptive actual optimum. -/
theorem decision_ready (points : Finset J)
    (hp : FinitePlanningBranches.plan enumK enumW enumH enumV enumJ
      (matrix T P hlinear bases candidates houtside S) (NB) (NC) lam L s
      ((FiniteMatrixSolver.residual enumK enumW enumH (matrix T P hlinear bases candidates houtside S)).comp (NB)) =
        Sum.inl (some points)) :
    let next := FiniteRepairPlanning.decisionProcedure enumK enumW enumH enumV enumJ
      (matrix T P hlinear bases candidates houtside S) (NB) (NC) lam L s points
    let valid := fun (X : F) (a : Bool) => a = true ↔ Nonempty (SupportedRepair (input X)
      (fixedEdgesForRange P.edges candidates (OriginalRanges.allowed candidates S)))
    PrimitiveQueries.Correct evalActual (ν ⁻¹' informationFiber L s) valid next ∧
      PrimitiveQueries.worst evalActual (ν ⁻¹' informationFiber L s) next =
        PrimitiveQueries.optimum evalActual (ν ⁻¹' informationFiber L s) valid := by
  have h := FinitePlanningBranches.decision_ready enumK enumW enumH enumV enumJ
    (matrix T P hlinear bases candidates houtside S) (NB) (NC) lam L s hp
  have hv : (fun (X : F) (a : Bool) => ValidDecision
      (FiniteMatrixSolver.differential (matrix T P hlinear bases candidates houtside S)) (NB) (NC) (ν X) a) =
    (fun (X : F) (a : Bool) => a = true ↔ Nonempty (SupportedRepair (input X)
      (fixedEdgesForRange P.edges candidates (OriginalRanges.allowed candidates S)))) := by
    funext X a
    apply propext
    rw [valid_decision_iff,← matrix_actual_equation_iff T edgeChange comparisonChange input ν hdata
      realize hrealize P hfixed hlinear bases candidates houtside S X]
  dsimp only
  rw [← hv]
  refine ⟨(PrimitiveInputQueries.correct_iff ν realize hrealize evalActual (fun v j => lam j v)
    heval (informationFiber L s) _ _).mpr h.1,?_⟩
  rw [PrimitiveInputQueries.worst_eq ν realize hrealize evalActual (fun v j => lam j v) heval,
    PrimitiveInputQueries.optimum_eq ν realize hrealize evalActual (fun v j => lam j v) heval]
  exact h.2

/-- The finite decision failure pair gives indistinguishable actual inputs with opposite independent repairability. -/
theorem decision_failure_pair {w r : V}
    (hp : FinitePlanningBranches.plan enumK enumW enumH enumV enumJ
      (matrix T P hlinear bases candidates houtside S) (NB) (NC) lam L s
      ((FiniteMatrixSolver.residual enumK enumW enumH (matrix T P hlinear bases candidates houtside S)).comp (NB)) =
        Sum.inr (w,r)) :
    (∀ j, evalActual (realize (w + r)) j = evalActual (realize w) j) ∧
    Nonempty (SupportedRepair (input (realize w))
      (fixedEdgesForRange P.edges candidates (OriginalRanges.allowed candidates S))) ∧
    ¬ Nonempty (SupportedRepair (input (realize (w + r)))
      (fixedEdgesForRange P.edges candidates (OriginalRanges.allowed candidates S))) := by
  have h := actual_failure_pair T edgeChange comparisonChange input ν hdata realize hrealize P hfixed
    hlinear bases candidates houtside S enumK enumW enumH enumV enumJ lam L s evalActual heval _ hp
  have hd := FinitePlanningBranches.plan_spec enumK enumW enumH enumV enumJ
    (matrix T P hlinear bases candidates houtside S) (NB) (NC) lam L s
    ((FiniteMatrixSolver.residual enumK enumW enumH (matrix T P hlinear bases candidates houtside S)).comp (NB))
  rw [hp] at hd
  refine ⟨h.2.2.1,h.2.2.2.2,?_⟩
  intro hs
  have hs' := (matrix_actual_equation_iff T edgeChange comparisonChange input ν hdata realize hrealize
    P hfixed hlinear bases candidates houtside S (realize (w + r))).mp hs
  rw [hrealize] at hs'
  have hn := (solvable_add_iff
    (FiniteMatrixSolver.differential (matrix T P hlinear bases candidates houtside S)) (NB) (NC) hd.2.1 r).mp hs'
  have hk : r ∈ LinearMap.ker
      (((FiniteMatrixSolver.residual enumK enumW enumH (matrix T P hlinear bases candidates houtside S))).comp (NB)) := by
    rw [FiniteMatrixSolver.residual_comp_ker]
    exact hn
  exact hd.2.2.2.2.1 hk

/-- A computed decision failure excludes every correct total actual adaptive repairability procedure. -/
theorem no_actual_decision_procedure {w r : V}
    (hp : FinitePlanningBranches.plan enumK enumW enumH enumV enumJ
      (matrix T P hlinear bases candidates houtside S) (NB) (NC) lam L s
      ((FiniteMatrixSolver.residual enumK enumW enumH (matrix T P hlinear bases candidates houtside S)).comp (NB)) =
        Sum.inr (w,r)) :
    ¬ ∃ next : PrimitiveQueries.Procedure J k Bool,
      PrimitiveQueries.Correct evalActual (ν ⁻¹' informationFiber L s)
        (fun (X : F) (a : Bool) => a = true ↔ Nonempty (SupportedRepair (input X)
          (fixedEdgesForRange P.edges candidates (OriginalRanges.allowed candidates S)))) next := by
  have hn := FinitePlanningBranches.decision_failure enumK enumW enumH enumV enumJ
    (matrix T P hlinear bases candidates houtside S) (NB) (NC) lam L s hp
  have hv : (fun (X : F) (a : Bool) => ValidDecision
      (FiniteMatrixSolver.differential (matrix T P hlinear bases candidates houtside S)) (NB) (NC) (ν X) a) =
    (fun (X : F) (a : Bool) => a = true ↔ Nonempty (SupportedRepair (input X)
      (fixedEdgesForRange P.edges candidates (OriginalRanges.allowed candidates S)))) := by
    funext X a
    apply propext
    rw [valid_decision_iff,← matrix_actual_equation_iff T edgeChange comparisonChange input ν hdata
      realize hrealize P hfixed hlinear bases candidates houtside S X]
  rintro ⟨next,hc⟩
  rw [← hv] at hc
  exact hn ⟨next,(PrimitiveInputQueries.correct_iff ν realize hrealize evalActual
    (fun v j => lam j v) heval (informationFiber L s) _ next).mp hc⟩

omit heval in
/-- A computed impossible fiber gives zero actual primitive optima for original repairability and full corrections. -/
theorem actual_impossible_zero
    (hp : FinitePlanningBranches.plan enumK enumW enumH enumV enumJ
      (matrix T P hlinear bases candidates houtside S) (NB) (NC) lam L s (NB) = Sum.inl none) :
    PrimitiveQueries.optimum evalActual (ν ⁻¹' informationFiber L s)
      (fun (X : F) (a : Bool) => a = true ↔ Nonempty (SupportedRepair (input X)
        (fixedEdgesForRange P.edges candidates (OriginalRanges.allowed candidates S)))) = 0 ∧
    PrimitiveQueries.optimum evalActual (ν ⁻¹' informationFiber L s)
      (fun X out => ValidOutput (ND) (affineRhs (NB) (NC)) (ν X) out) = 0 := by
  have hi := FinitePlanningBranches.impossible_spec enumK enumW enumH enumV enumJ
    (matrix T P hlinear bases candidates houtside S) (NB) (NC) lam L s (NB) hp
  have hn : ∀ X : F, L (ν X) = s → ¬ Nonempty (SupportedRepair (input X)
      (fixedEdgesForRange P.edges candidates (OriginalRanges.allowed candidates S))) := by
    intro X hx hs
    exact hi (ν X) hx ((matrix_actual_equation_iff T edgeChange comparisonChange input ν hdata
      realize hrealize P hfixed hlinear bases candidates houtside S X).mp hs)
  constructor
  · exact PrimitiveQueries.optimum_zero_of_constant _ _ _ false
      (fun X hx => iff_of_false Bool.false_ne_true (hn X hx))
  · apply PrimitiveQueries.optimum_zero_of_constant _ _ _ none
    intro X hx
    exact (ActualFamilyCoordinates.valid_none_actual_iff T edgeChange comparisonChange input ν hdata
      realize hrealize P hfixed hlinear bases candidates houtside X S).mpr (hn X hx)

end AAT.AG.RepairObservationDuality.ActualFinitePlanning
#assert_standard_axioms_only AAT.AG.RepairObservationDuality.ActualFinitePlanning
