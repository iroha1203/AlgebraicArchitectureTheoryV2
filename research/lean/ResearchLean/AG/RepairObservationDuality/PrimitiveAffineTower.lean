import ResearchLean.AG.RepairObservationDuality.PrimitiveAffineDefect

/-!
# Actual towers generated by the same primitive kernel changes

## Implementation notes

G-131 A / n1017 §3.5, §6.1 uses arbitrary categories and the whole native kernels.
The primitive edge/comparison model supplies a genuine tower. Strongness,
core alignment, bijective kernel transport and centralization are derived from
the original tower, not supplied as new conclusion-bearing certificates.
The input hypotheses are the existing G-129 tower conditions; the primitive
physical model is the Cycle 4 accepted API (head 9937ee378ee26d75c798633c8d544fd4602ff9fe).
G-129 native coefficient, strong lifting and defect APIs are reused at their
accepted head cbe70c4dc734a851a90c5030a736141f4352fcba.
-/

namespace AAT.AG.RepairObservationDuality.PrimitiveAffineTower
open CategoryTheory TransportCoherence TransportCoherence.Arbitrary
open AbelianLiftingObstruction PrimitiveAffineDefect
set_option autoImplicit false
universe uG uE uB uD vE vB vD
variable {K : FiniteTransportPresentation.{uG}}
variable {E : Type uE} {B : Type uB} {D : Type uD}
variable [Category.{vE} E] [Category.{vB} B] [Category.{vD} D]
variable {p : E ⥤ B} {q : B ⥤ D}
variable (T : TowerPresentation K p q)
local notation "M" => T.localCoefficients

/-- G-131 A / n1017 §3.5, §6.1 API: the same physical corrected edge retains lower strongness. -/
theorem lower_strong (h : C1 M) (a : C2 M)
    {i j : K.Vertex} (e : K.Edge i j) :
    q.IsStronglyCocartesian ((data T h a).lift.edgeBase e)
      (p.map ((data T h a).lift.edgeLift e)) := by
  rw [edge_value,p.map_comp,kernelInclusion_map,Category.comp_id]
  exact T.lowerStrong e

/-- G-131 A / n1017 §3.5, §6.1 API: full kernel edge transport is generated unchanged. -/
theorem edge_transport (h : C1 M) (a : C2 M)
    {i j : K.Vertex} (e : K.Edge i j) :
    kernelTransportHom p q ((data T h a).lift.edgeLift e)
      ((data T h a).lift.edgeStrong e) (lower_strong T h a e) =
    kernelTransportHom p q (T.upper.edgeLift e) (T.upper.edgeStrong e) (T.lowerStrong e) := by
  exact kernelTransport_eq_of_kernel_comparison p q
    (T.upper.edgeLift e) ((data T h a).lift.edgeLift e)
    (T.upper.edgeStrong e) ((data T h a).lift.edgeStrong e)
    (T.lowerStrong e) (lower_strong T h a e) (T.kernelComm j)
    (Additive.toMul (h ⟨i,j,e⟩)) (edge_value T h a e).symm

/-- G-131 A / n1017 §3.5, §6.1 API: primitive comparison changes preserve the actual core alignment. -/
theorem core_alignment (h : C1 M) (a : C2 M) (f : K.TwoCell) :
    p.map ((data T h a).lift.pathLift (K.twoLeft f)) ≫
      p.map (FiberAut.hom ((data T h a).comparator f)) =
    p.map ((data T h a).lift.pathLift (K.twoRight f)) := by
  have hc : p.map (FiberAut.hom ((data T h a).comparator f)) =
      p.map (FiberAut.hom (T.comparator f)) := by
    change p.map (FiberAut.hom (T.comparator f) ≫
      FiberAut.hom (kernelInclusion p q _ (Additive.toMul (a f)))) = _
    rw [p.map_comp,kernelInclusion_map,Category.comp_id]
  rw [hc]
  exact T.correctedCoreAlignment h f

/-- G-131 A / n1017 §3.5, §6.1 API: the changed comparison centralizes the same whole actual kernel. -/
theorem centralizes (a : C2 M) (f : K.TwoCell)
    (z : Kernel p q (T.upper.object (K.twoTarget f))) :
    (kernelInclusion p q _ (Additive.toMul (a f)) * T.comparator f) *
      kernelInclusion p q _ z = kernelInclusion p q _ z *
      (kernelInclusion p q _ (Additive.toMul (a f)) * T.comparator f) := by
  rw [mul_assoc,T.comparatorCentralizes]
  rw [← mul_assoc,← map_mul,T.kernelComm _ (Additive.toMul (a f)) z,map_mul,mul_assoc]

/-- G-131 A / n1017 §3.5, §6.1: the primitive changes generate a tower with every required native
condition from the same original tower input. -/
def tower (h : C1 M) (a : C2 M) : TowerPresentation K p q where
  upper := (data T h a).lift
  lowerStrong := lower_strong T h a
  faceBase := (data T h a).faceBase
  comparator := (data T h a).comparator
  coreAlignment := core_alignment T h a
  kernelComm := T.kernelComm
  edgeBijective := by
    intro i j e
    rw [edge_transport T h a e]
    exact T.edgeBijective e
  comparatorCentralizes := centralizes T a

/-- G-131 A / n1017 §3.5, §6.1 API: generated tower transport data is the primitive physical data. -/
theorem tower_data (h : C1 M) (a : C2 M) :
    (tower T h a).toTransportData = data T h a := rfl

/-- G-131 A / n1017 §3.5, §6.1 API: generated edge coefficients equal the original full native
coefficient system, including every actual edge equivalence. -/
theorem edge_coefficients (h : C1 M) (a : C2 M) :
    (tower T h a).edgeCoefficients = T.edgeCoefficients := by
  unfold TowerPresentation.edgeCoefficients
  congr 1
  funext i j e
  apply AddEquiv.ext
  intro x
  change Additive.ofMul
    (kernelTransportHom p q ((data T h a).lift.edgeLift e)
      ((data T h a).lift.edgeStrong e) (lower_strong T h a e) (Additive.toMul x)) =
    Additive.ofMul
    (kernelTransportHom p q (T.upper.edgeLift e)
      (T.upper.edgeStrong e) (T.lowerStrong e) (Additive.toMul x))
  rw [edge_transport]
  rfl

/-- G-131 A / n1017 §3.5, §6.1 API: generated local coefficients are the same whole coefficient
system; face descent is proof irrelevant after the edge-system equality. -/
theorem local_coefficients (h : C1 M) (a : C2 M) :
    (tower T h a).localCoefficients = T.localCoefficients := by
  have he := edge_coefficients T h a
  have hinj : ∀ M₁ M₂ : LocalCoefficients K,
      M₁.toEdgeCoefficients = M₂.toEdgeCoefficients → M₁ = M₂ := by
    intro M₁ M₂ hh
    cases M₁
    cases M₂
    cases hh
    rfl
  exact hinj _ _ he

/-- G-131 A / n1017 §3.5, §6.1: each generated tower has the same actual defect coordinate derived
from its physical paths and authored comparison. -/
theorem tower_defect (h : C1 M) (a : C2 M) (f : K.TwoCell) :
    (tower T h a).defect f = PrimitiveAffineDefect.defect T h a f := by
  apply Additive.toMul.injective
  apply kernelInclusion_injective p q
  change kernelInclusion p q _ ((tower T h a).faceDefect f) = _
  rw [TowerPresentation.faceDefect_eq_raw]
  exact (defect_inclusion T h a f).symm

/-- G-131 A / n1017 §3.5, §6.1 API: equality of the actual lifted arrows and authored comparisons
identifies towers; the remaining native conditions are propositions. -/
theorem tower_eq_of_data_eq {T₁ T₂ : TowerPresentation K p q}
    (hh : T₁.toTransportData = T₂.toTransportData) : T₁ = T₂ := by
  cases T₁
  cases T₂
  simp only [TowerPresentation.toTransportData, TransportData.mk.injEq] at hh
  rcases hh with ⟨hl,hc⟩
  cases hl
  cases hc
  rfl

end AAT.AG.RepairObservationDuality.PrimitiveAffineTower
#assert_standard_axioms_only AAT.AG.RepairObservationDuality.PrimitiveAffineTower
