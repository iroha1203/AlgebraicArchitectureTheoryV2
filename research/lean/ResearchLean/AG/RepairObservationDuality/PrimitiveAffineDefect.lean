import ResearchLean.AG.AbelianLiftingObstruction.Correction
import ResearchLean.AG.RelativeRepairComposition.FiniteCoefficientDifferentials

/-!
# Primitive affine changes of arbitrary actual reference arrows and comparisons

## Implementation notes

G-131 A / n1017 §3.5 and §6.1. Primitive tower and affine-change conditions
are the input assumptions. The main results derive the same physical defect
from accepted G-129 correction and G-130 linear-differential APIs. Fixed-part
assumptions in the relative module are actual face equalities, not defect laws.

The edge changes live in each vertex's whole actual projection kernel. The
comparison changes use those same kernels. Actual paths and their canonical
comparators generate the raw defect; its affine formula is a theorem, not an
input certificate. No common coefficient module or affine-operation category
is required. Identification with an externally presented input family remains
a separate bridge.
-/

namespace AAT.AG.RepairObservationDuality.PrimitiveAffineDefect
open CategoryTheory TransportCoherence TransportCoherence.Arbitrary
open AbelianLiftingObstruction RelativeRepairComposition FiniteCoefficients
set_option autoImplicit false
universe uk uV uG uE uB uD vE vB vD
variable {k : Type uk} [Field k]
variable {V : Type uV} [AddCommGroup V] [Module k V]
variable {K : FiniteTransportPresentation.{uG}}
variable {E : Type uE} {B : Type uB} {D : Type uD}
variable [Category.{vE} E] [Category.{vB} B] [Category.{vD} D]
variable {p : E ⥤ B} {q : B ⥤ D}
variable (T : TowerPresentation K p q)
local notation "M" => T.localCoefficients

/-- Actual corrected reference arrows and actual changed authored comparisons.

G-131 A / n1017 §3.5, §6.1. Main construction/theorem.
Input assumptions and predecessor use are specified in the module notes.
-/
def data (h : C1 M) (a : C2 M) :
    TransportData K.toFiniteTransportTwoPresentation (p ⋙ q) where
  lift := reselectLiftData T.upper (T.correctionReselection h)
  faceBase := by
    intro f
    rw [reselectLiftData_pathBase,reselectLiftData_pathBase]
    exact T.faceBase f
  comparator f := kernelInclusion p q _ (Additive.toMul (a f)) * T.comparator f

/-- Every original edge retains its actual correction value at its own target.

G-131 A / n1017 §3.5, §6.1. API lemma/constructor for the named primitive or relative construction.
Input assumptions and predecessor use are specified in the module notes.
-/
theorem edge_value (h : C1 M) (a : C2 M) {i j : K.Vertex} (e : K.Edge i j) :
    (data T h a).lift.edgeLift e = T.upper.edgeLift e ≫
      FiberAut.hom (kernelInclusion p q _ (Additive.toMul (h ⟨i,j,e⟩))) := rfl

/-- The comparison update is an actual whole-kernel operation on the same face.

G-131 A / n1017 §3.5, §6.1. API lemma/constructor for the named primitive or relative construction.
Input assumptions and predecessor use are specified in the module notes.
-/
theorem comparison_value (h : C1 M) (a : C2 M) (f : K.TwoCell) :
    (data T h a).comparator f =
      kernelInclusion p q _ (Additive.toMul (a f)) * T.comparator f := rfl

/-- Canonical comparison uses the same corrected physical paths, independently
of the authored comparison update.

G-131 A / n1017 §3.5, §6.1. API lemma/constructor for the named primitive or relative construction.
Input assumptions and predecessor use are specified in the module notes.
-/
theorem canonical_eq (h : C1 M) (a : C2 M) (f : K.TwoCell) :
    canonicalFaceComparator (data T h a) 1 f =
      canonicalFaceComparator T.toTransportData (T.correctionReselection h) f := by
  apply FiberAut.ext_of_strong_fac
    (reselectedPathLift T.upper (T.correctionReselection h) (K.twoLeft f))
    (reselectedPathLift_isStronglyCocartesian T.upper
      (T.correctionReselection h) (K.twoLeft f))
  have hl : reselectedPathLift (data T h a).lift 1 (K.twoLeft f) =
      reselectedPathLift T.upper (T.correctionReselection h) (K.twoLeft f) := by
    rw [Arbitrary.reselectedPathLift_one]
    rfl
  have hr : reselectedPathLift (data T h a).lift 1 (K.twoRight f) =
      reselectedPathLift T.upper (T.correctionReselection h) (K.twoRight f) := by
    rw [Arbitrary.reselectedPathLift_one]
    rfl
  have ha := canonicalFaceComparator_fac (data T h a) 1 f
  rw [hl,hr] at ha
  exact ha.trans (canonicalFaceComparator_fac T.toTransportData
    (T.correctionReselection h) f).symm

/-- The raw defect is generated by composing the actual changed comparison
with the canonical comparison of the actual changed paths.

G-131 A / n1017 §3.5, §6.1. Main construction/theorem.
Input assumptions and predecessor use are specified in the module notes.
-/
theorem raw_defect (h : C1 M) (a : C2 M) (f : K.TwoCell) :
    rawFaceDefect (data T h a) 1 f =
      kernelInclusion p q _ (Additive.toMul (a f)) *
        rawFaceDefect T.toTransportData (T.correctionReselection h) f := by
  unfold rawFaceDefect
  rw [canonical_eq,comparison_value,mul_assoc]

/-- The native defect cochain obtained from the physical changed paths.

G-131 A / n1017 §3.5, §6.1. API lemma/constructor for the named primitive or relative construction.
Input assumptions and predecessor use are specified in the module notes.
-/
noncomputable def defect (h : C1 M) (a : C2 M) : C2 M :=
  a + T.correctedDefect h

/-- The generated native value includes to that same physical raw defect.

G-131 A / n1017 §3.5, §6.1. Main construction/theorem.
Input assumptions and predecessor use are specified in the module notes.
-/
theorem defect_inclusion (h : C1 M) (a : C2 M) (f : K.TwoCell) :
    kernelInclusion p q _ (Additive.toMul (defect T h a f)) =
      rawFaceDefect (data T h a) 1 f := by
  rw [raw_defect]
  change kernelInclusion p q _
    (Additive.toMul (a f + T.correctedDefect h f)) = _
  rw [toMul_add,map_mul]
  rw [← T.correctedFaceDefect_eq_raw h f]
  rfl

/-- The same two original face paths supply the affine native defect formula.

G-131 A / n1017 §3.5, §6.1. Main construction/theorem.
Input assumptions and predecessor use are specified in the module notes.
-/
theorem defect_eq (h : C1 M) (a : C2 M) :
    defect T h a = T.defect + a + d1 M h := by
  unfold defect
  rw [T.correctedDefect_eq]
  abel

/-- Zero native defect is precisely the actual same-face equality of the
changed reference paths and authored comparison.

G-131 A / n1017 §3.5, §6.1. Main construction/theorem.
Input assumptions and predecessor use are specified in the module notes.
-/
theorem defect_zero_iff (h : C1 M) (a : C2 M) (f : K.TwoCell) :
    defect T h a f = 0 ↔
      (data T h a).lift.pathLift (K.twoLeft f) ≫
        FiberAut.hom ((data T h a).comparator f) =
      (data T h a).lift.pathLift (K.twoRight f) := by
  have hi : defect T h a f = 0 ↔ rawFaceDefect (data T h a) 1 f = 1 := by
    constructor
    · intro hz
      rw [← defect_inclusion,hz]
      rfl
    · intro hz
      apply Additive.toMul.injective
      apply kernelInclusion_injective p q _
      exact (defect_inclusion T h a f).trans (by simpa using hz)
  exact hi.trans (by
    rw [rawFaceDefect_eq_one_iff_coherent,
      Arbitrary.reselectedPathLift_one,Arbitrary.reselectedPathLift_one])

variable [∀ v, Module k ((T.localCoefficients).A v)]
variable (hlinear : ∀ {i j : K.Vertex} (e : K.Edge i j) (t : k)
  (x : (T.localCoefficients).A i),
  (T.localCoefficients).edge e (t • x) = t • (T.localCoefficients).edge e x)

/-- The whole original face differential as a linear map, with no basis change.

G-131 A / n1017 §3.5, §6.1. API lemma/constructor for the named primitive or relative construction.
Input assumptions and predecessor use are specified in the module notes.
-/
noncomputable def faceDifferential : C1 M →ₗ[k] C2 M where
  toFun := d1 M
  map_add' := d1_add M
  map_smul' t h := d1_smul M hlinear h t

/-- Evaluation of the generated linear differential is the same native d1.

G-131 A / n1017 §3.5, §6.1. API lemma/constructor for the named primitive or relative construction.
Input assumptions and predecessor use are specified in the module notes.
-/
theorem faceDifferential_apply (h : C1 M) :
    faceDifferential (k := k) T hlinear h = d1 M h := rfl


/-- The affine defect's linear term is generated from primitive comparison
changes and the original two-path differential of primitive edge changes.

G-131 A / n1017 §3.5, §6.1. Main construction/theorem.
Input assumptions and predecessor use are specified in the module notes.
-/
noncomputable def linearTerm (edgeMap : V →ₗ[k] C1 M) (comparisonMap : V →ₗ[k] C2 M) :
    V →ₗ[k] C2 M := comparisonMap + (faceDifferential T hlinear).comp edgeMap

/-- The parameter map evaluates using the same primitive changes and paths.

G-131 A / n1017 §3.5, §6.1. API lemma/constructor for the named primitive or relative construction.
Input assumptions and predecessor use are specified in the module notes.
-/
theorem linearTerm_apply (edgeMap : V →ₗ[k] C1 M)
    (comparisonMap : V →ₗ[k] C2 M) (v : V) :
    linearTerm T hlinear edgeMap comparisonMap v =
      comparisonMap v + d1 M (edgeMap v) := rfl

/-- The primitive actual evaluations agree with the generated affine cochain.

G-131 A / n1017 §3.5, §6.1. Main construction/theorem.
Input assumptions and predecessor use are specified in the module notes.
-/
theorem affine_defect (edgeChange : V →ₗ[k] (C1 (T.localCoefficients)))
    (comparisonChange : V →ₗ[k] (C2 (T.localCoefficients))) (v : V) :
    defect T (edgeChange v) (comparisonChange v) = T.defect + linearTerm T hlinear edgeChange comparisonChange v := by
  rw [defect_eq,linearTerm_apply]
  exact add_assoc _ _ _

/-- Every affine face value is the same raw physical path defect, including at
nonzero parameters and in every whole target-vertex kernel.

G-131 A / n1017 §3.5, §6.1. Main construction/theorem.
Input assumptions and predecessor use are specified in the module notes.
-/
theorem affine_inclusion (edgeChange : V →ₗ[k] (C1 (T.localCoefficients)))
    (comparisonChange : V →ₗ[k] (C2 (T.localCoefficients))) (v : V) (f : K.TwoCell) :
    kernelInclusion p q _
      (Additive.toMul ((T.defect + linearTerm T hlinear edgeChange comparisonChange v) f)) =
      rawFaceDefect (data T (edgeChange v) (comparisonChange v)) 1 f := by
  rw [← affine_defect]
  exact defect_inclusion T (edgeChange v) (comparisonChange v) f

end AAT.AG.RepairObservationDuality.PrimitiveAffineDefect
#assert_standard_axioms_only AAT.AG.RepairObservationDuality.PrimitiveAffineDefect
