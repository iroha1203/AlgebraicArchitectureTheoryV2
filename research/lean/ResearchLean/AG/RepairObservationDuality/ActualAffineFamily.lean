import ResearchLean.AG.RepairObservationDuality.PrimitiveAffineTower
import ResearchLean.AG.RepairObservationDuality.RelativeAffineDefect
import ResearchLean.AG.RepairObservationDuality.CoefficientTransport

/-!
# Original input families represented by the primitive affine operations

## Implementation notes

G-131 A / n1017 §3.5, §6.1 allows the original arrows to vary between inputs.
Each original tower retains its own original arrows, core lifts and references.
The family representation condition is equality of the physical reference
transport data with the primitive kernel changes; no defect, differential or
repair conclusion is input. Every parameter realization and fixed-face actual
identity generate the relative-family condition used by Cycle 4.
-/
namespace AAT.AG.RepairObservationDuality.ActualAffineFamily
open CategoryTheory TransportCoherence TransportCoherence.Arbitrary
open AbelianLiftingObstruction RelativeRepairComposition PrimitiveAffineDefect
set_option autoImplicit false
universe uk uV uF uG uE uB uD vE vB vD
variable {k : Type uk} [Field k]
variable {V : Type uV} [AddCommGroup V] [Module k V]
variable {F : Type uF}
variable {K : FiniteTransportPresentation.{uG}}
variable {E : Type uE} {B : Type uB} {D : Type uD}
variable [Category.{vE} E] [Category.{vB} B] [Category.{vD} D]
variable {p : E ⥤ B} {q : B ⥤ D}
variable (T : TowerPresentation K p q)
variable [∀ v, Module k ((T.localCoefficients).A v)]
variable (edgeChange : V →ₗ[k] (C1 (T.localCoefficients)))
variable (comparisonChange : V →ₗ[k] (C2 (T.localCoefficients)))
variable (input : F → OriginalTowerPresentation K p q) (ν : F → V)
variable (hdata : ∀ X : F, (input X).toTower.toTransportData =
  data T (edgeChange (ν X)) (comparisonChange (ν X)))

include hdata

/-- G-131 A / n1017 §3.5, §6.1 API: physical affine reference operations identify
an input's selected tower with the generated tower, retaining its original data. -/
theorem input_tower (X : F) :
    (input X).toTower = PrimitiveAffineTower.tower T
      (edgeChange (ν X)) (comparisonChange (ν X)) :=
  PrimitiveAffineTower.tower_eq_of_data_eq (hdata X)

/-- G-131 A / n1017 §3.5, §6.1: whole native coefficient groups and actual edge
transport of every input equal the shared system, derived from physical data. -/
theorem input_coefficients (X : F) :
    (input X).toTower.localCoefficients = T.localCoefficients := by
  rw [input_tower T edgeChange comparisonChange input ν hdata X]
  exact PrimitiveAffineTower.local_coefficients T _ _

variable (realize : V → F) (hrealize : ∀ v, ν (realize v) = v)
variable (P : ClosedRegion K)
variable (hfixed : ∀ X : F, ∀ f ∈ P.faces,
  (input X).toTower.upper.pathLift (K.twoLeft f) ≫
    FiberAut.hom ((input X).comparator f) =
  (input X).toTower.upper.pathLift (K.twoRight f))

include hrealize hfixed

/-- G-131 A / n1017 §3.5, §6.1: all parameter realizations and the original
fixed-face actual identities generate the model's fixed-face identities. -/
theorem model_fixed (v : V) (f : K.TwoCell) (hf : f ∈ P.faces) :
    (data T (edgeChange v) (comparisonChange v)).lift.pathLift (K.twoLeft f) ≫
      FiberAut.hom ((data T (edgeChange v) (comparisonChange v)).comparator f) =
    (data T (edgeChange v) (comparisonChange v)).lift.pathLift (K.twoRight f) := by
  have hx := hfixed (realize v) f hf
  change ((input (realize v)).toTower.toTransportData).lift.pathLift (K.twoLeft f) ≫
    FiberAut.hom (((input (realize v)).toTower.toTransportData).comparator f) =
    ((input (realize v)).toTower.toTransportData).lift.pathLift (K.twoRight f) at hx
  rw [hdata, hrealize] at hx
  exact hx

omit hdata hrealize in
/-- G-131 A / n1017 §3.5, §6.1 API: the existing original relative defect
retains the complete native value of each physical face. -/
theorem original_defect_coordinate (X : F) (f : K.TwoCell) :
    (ActualEquation.defectFamily (input X) P (hfixed X)).1 ⟨f,Set.mem_univ f⟩ =
      (input X).toTower.defect f := rfl

/-- G-131 A / n1017 §3.5, §6.1 constructor: transport the actual original defect
onto the shared full relative faces using the derived coefficient equality. -/
noncomputable def commonDefect (X : F) :
    RelativeCover.C2 T.localCoefficients ClosedRegion.all P :=
  CoefficientTransport.faces _ _ P
    (input_coefficients T edgeChange comparisonChange input ν hdata X)
    (ActualEquation.defectFamily (input X) P (hfixed X))

omit hrealize in
/-- G-131 A / n1017 §3.5, §6.1: all transported original actual defect values
are the values generated by the same primitive physical operations. -/
theorem common_defect_value (X : F) (f : K.TwoCell) :
    (commonDefect T edgeChange comparisonChange input ν hdata P hfixed X).1
      ⟨f,Set.mem_univ f⟩ = defect T (edgeChange (ν X)) (comparisonChange (ν X)) f := by
  rw [commonDefect,CoefficientTransport.faces_value,original_defect_coordinate]
  have ht := input_tower T edgeChange comparisonChange input ν hdata X
  have hd : HEq ((input X).toTower.defect f)
      ((PrimitiveAffineTower.tower T (edgeChange (ν X)) (comparisonChange (ν X))).defect f) := by
    rw [ht]
  have hc : HEq
      (Eq.mp (congrArg (fun M : LocalCoefficients K => M.A (K.twoTarget f))
        (input_coefficients T edgeChange comparisonChange input ν hdata X))
        ((input X).toTower.defect f)) ((input X).toTower.defect f) := by
    exact cast_heq _ _
  exact (eq_of_heq (hc.trans hd)).trans (PrimitiveAffineTower.tower_defect T _ _ f)

/-- G-131 A / n1017 §3.5, §6.1: the original actual relative defect agrees with
the model relative defect on every original face. -/
theorem common_defect_eq (X : F) :
    commonDefect T edgeChange comparisonChange input ν hdata P hfixed X =
      RelativeAffineDefect.relativeDefect T edgeChange comparisonChange P
        (model_fixed T edgeChange comparisonChange input ν hdata realize hrealize P hfixed)
        (ν X) := by
  apply Subtype.ext
  funext f
  rw [common_defect_value, RelativeAffineDefect.relativeDefect_value]

variable (hlinear : ∀ {i j : K.Vertex} (e : K.Edge i j) (t : k)
  (x : (T.localCoefficients).A i),
  (T.localCoefficients).edge e (t • x) = t • (T.localCoefficients).edge e x)

/-- G-131 A / n1017 §3.5, §6.1: the negative defect of each original input is
the same primitive-generated constant plus linear right-hand side. -/
theorem negative_defect_affine (X : F) :
    -commonDefect T edgeChange comparisonChange input ν hdata P hfixed X =
    RelativeAffineDefect.baseRhs T edgeChange comparisonChange P
      (model_fixed T edgeChange comparisonChange input ν hdata realize hrealize P hfixed) +
    RelativeAffineDefect.rhsLinear T hlinear edgeChange comparisonChange P
      (model_fixed T edgeChange comparisonChange input ν hdata realize hrealize P hfixed) (ν X) := by
  rw [common_defect_eq T edgeChange comparisonChange input ν hdata realize hrealize P hfixed X]
  exact RelativeAffineDefect.negative_defect_affine T hlinear edgeChange comparisonChange P _ _

/-- G-131 A / n1017 §3.5, §6.1 constructor: derive each actual whole-kernel
module structure from the shared coefficient system's modules. -/
def inputModules (X : F) : ∀ v, Module k ((input X).toTower.localCoefficients.A v) :=
  CoefficientTransport.modules (k := k) T.localCoefficients _
    (input_coefficients T edgeChange comparisonChange input ν hdata X).symm

omit hrealize hfixed in
include hlinear in
/-- G-131 A / n1017 §3.5, §6.1 API: the physical input's full kernel transport
is linear for the same transported whole-kernel modules. -/
theorem input_linearity (X : F) :
    letI := inputModules T edgeChange comparisonChange input ν hdata X
    ∀ {i j : K.Vertex} (e : K.Edge i j) (t : k)
      (x : (input X).toTower.localCoefficients.A i),
      (input X).toTower.localCoefficients.edge e (t • x) =
        t • (input X).toTower.localCoefficients.edge e x :=
  CoefficientTransport.linearity T.localCoefficients _ hlinear
    (input_coefficients T edgeChange comparisonChange input ν hdata X).symm

variable (candidates : Set (EdgeName (K := K))) [DecidablePred (· ∈ candidates)]
variable (houtside : ∀ e ∈ candidates, e ∉ P.edges)
variable [Fintype (EdgeName (K := K))] [DecidableEq (EdgeName (K := K))]
attribute [local instance] Classical.propDecidable
local notation "D₀" => OriginalColumns.D (k := k) T.localCoefficients P candidates hlinear
local notation "C" => OriginalColumns.column (k := k) T.localCoefficients P candidates houtside hlinear

omit hrealize in
/-- G-131 A / n1017 §3.5, §6.1: every input's independent actual repair exists
exactly when the shared full split equation has its same negative actual RHS. -/
theorem actual_equation_iff (X : F) (S : Set candidates) :
    Nonempty (SupportedRepair (input X)
      (fixedEdgesForRange P.edges candidates (OriginalRanges.allowed candidates S))) ↔
    ∃ h, SelectedCokernel.differential D₀ C S h =
      -commonDefect T edgeChange comparisonChange input ν hdata P hfixed X := by
  letI := inputModules T edgeChange comparisonChange input ν hdata X
  have hfirst := NativeCorrectionEquation.actual_equation_iff (k := k) (input X) P
    candidates houtside (input_linearity T edgeChange comparisonChange input ν hdata hlinear X)
    (hfixed X) S
  have hsecond := CoefficientTransport.equation_iff (k := k) T.localCoefficients
    (input X).toTower.localCoefficients P hlinear candidates houtside
    (input_coefficients T edgeChange comparisonChange input ν hdata X).symm S
    (-ActualEquation.defectFamily (input X) P (hfixed X))
  refine hfirst.trans (hsecond.trans ?_)
  rw [CoefficientTransport.faces_symm, AddEquiv.map_neg]
  rfl

/-- G-131 A / n1017 §3.5, §6.1: all candidate ranges and original inputs use
the same primitive-generated affine RHS and the same complete differential. -/
theorem actual_affine_equation_iff (X : F) (S : Set candidates) :
    Nonempty (SupportedRepair (input X)
      (fixedEdgesForRange P.edges candidates (OriginalRanges.allowed candidates S))) ↔
    ∃ h, SelectedCokernel.differential D₀ C S h =
      RelativeAffineDefect.baseRhs T edgeChange comparisonChange P
        (model_fixed T edgeChange comparisonChange input ν hdata realize hrealize P hfixed) +
      RelativeAffineDefect.rhsLinear T hlinear edgeChange comparisonChange P
        (model_fixed T edgeChange comparisonChange input ν hdata realize hrealize P hfixed) (ν X) := by
  rw [actual_equation_iff T edgeChange comparisonChange input ν hdata P hfixed hlinear candidates houtside X S]
  rw [negative_defect_affine T edgeChange comparisonChange input ν hdata realize hrealize P hfixed hlinear X]

omit hrealize [Fintype (EdgeName (K := K))] [DecidableEq (EdgeName (K := K))] in
/-- G-131 A / n1017 §3.5, §6.1 API: the shared coordinate map reverses to the
identical whole original defect on every input. -/
theorem common_defect_inverse (X : F) :
    CoefficientTransport.faces T.localCoefficients (input X).toTower.localCoefficients P
      (input_coefficients T edgeChange comparisonChange input ν hdata X).symm
      (commonDefect T edgeChange comparisonChange input ν hdata P hfixed X) =
    ActualEquation.defectFamily (input X) P (hfixed X) := by
  rw [← CoefficientTransport.faces_symm]
  exact (CoefficientTransport.faces _ _ P
    (input_coefficients T edgeChange comparisonChange input ν hdata X)).symm_apply_apply _

omit hrealize in
/-- G-131 A / n1017 §3.5, §6.1: a complete shared correction solution becomes
a solution of the same actual native equation by the generated coordinate map. -/
theorem solution_transport (X : F) (S : Set candidates)
    (h : OriginalColumns.alwaysSpace (k := k) T.localCoefficients P candidates ×
      (∀ e : S, T.localCoefficients.A e.1.1.2.1))
    (hh : SelectedCokernel.differential D₀ C S h =
      -commonDefect T edgeChange comparisonChange input ν hdata P hfixed X) :
    letI := inputModules T edgeChange comparisonChange input ν hdata X
    NativeCorrectionEquation.differential (k := k) (input X) P candidates houtside
      (input_linearity T edgeChange comparisonChange input ν hdata hlinear X) S
      (CoefficientTransport.values (k := k) T.localCoefficients
        (input X).toTower.localCoefficients P candidates
        (input_coefficients T edgeChange comparisonChange input ν hdata X).symm S h) =
      -ActualEquation.defectFamily (input X) P (hfixed X) := by
  letI := inputModules T edgeChange comparisonChange input ν hdata X
  have hd := CoefficientTransport.differential (k := k) T.localCoefficients
    (input X).toTower.localCoefficients P hlinear candidates houtside
    (input_coefficients T edgeChange comparisonChange input ν hdata X).symm S h
  rw [hh,AddEquiv.map_neg,common_defect_inverse T edgeChange comparisonChange input ν hdata P hfixed X] at hd
  exact hd.symm

local notation "rhs" => (fun X : F =>
  RelativeAffineDefect.baseRhs T edgeChange comparisonChange P
    (model_fixed T edgeChange comparisonChange input ν hdata realize hrealize P hfixed) +
  RelativeAffineDefect.rhsLinear T hlinear edgeChange comparisonChange P
    (model_fixed T edgeChange comparisonChange input ν hdata realize hrealize P hfixed) (ν X))

/-- G-131 A / n1017 §3.5, §6.1: actual repair is precisely zero of the same
complete cokernel applied to the primitive-generated affine RHS. -/
theorem actual_affine_cokernel_iff (X : F) (S : Set candidates) :
    Nonempty (SupportedRepair (input X)
      (fixedEdgesForRange P.edges candidates (OriginalRanges.allowed candidates S))) ↔
    (LinearMap.range (SelectedCokernel.differential D₀ C S)).mkQ (rhs X) = 0 :=
  (actual_affine_equation_iff T edgeChange comparisonChange input ν hdata realize hrealize P hfixed
    hlinear candidates houtside X S).trans (SelectedCokernel.equation_iff_zero D₀ C S (rhs X))

/-- G-131 A / n1017 §3.5, §6.1 constructor: every complete numerical solution
of the shared affine equation restores to the same original actual repair. -/
noncomputable def restore (X : F) (S : Set candidates)
    (h : OriginalColumns.alwaysSpace (k := k) T.localCoefficients P candidates ×
      (∀ e : S, T.localCoefficients.A e.1.1.2.1))
    (hh : SelectedCokernel.differential D₀ C S h = rhs X) :
    SupportedRepair (input X)
      (fixedEdgesForRange P.edges candidates (OriginalRanges.allowed candidates S)) := by
  letI := inputModules T edgeChange comparisonChange input ν hdata X
  have heq : SelectedCokernel.differential D₀ C S h =
      -commonDefect T edgeChange comparisonChange input ν hdata P hfixed X :=
    hh.trans (negative_defect_affine T edgeChange comparisonChange input ν hdata realize hrealize P hfixed hlinear X).symm
  exact NativeCorrectionEquation.restore (k := k) (input X) P candidates houtside
    (input_linearity T edgeChange comparisonChange input ν hdata hlinear X) (hfixed X) S
    (CoefficientTransport.values (k := k) T.localCoefficients (input X).toTower.localCoefficients P
      candidates (input_coefficients T edgeChange comparisonChange input ν hdata X).symm S h)
    (solution_transport T edgeChange comparisonChange input ν hdata P hfixed hlinear candidates houtside X S h heq)

/-- G-131 A / n1017 §3.5, §6.1 API: all restored original edge corrections
are exactly the transported whole always value plus the same selected values. -/
theorem restore_value (X : F) (S : Set candidates)
    (h : OriginalColumns.alwaysSpace (k := k) T.localCoefficients P candidates ×
      (∀ e : S, T.localCoefficients.A e.1.1.2.1))
    (hh : SelectedCokernel.differential D₀ C S h = rhs X)
    (e : EdgeName (K := K)) :
    letI := inputModules T edgeChange comparisonChange input ν hdata X
    let a := CoefficientTransport.values (k := k) T.localCoefficients
      (input X).toTower.localCoefficients P candidates
      (input_coefficients T edgeChange comparisonChange input ν hdata X).symm S h
    (input X).solutionCorrection
      (restore T edgeChange comparisonChange input ν hdata realize hrealize P hfixed hlinear candidates houtside X S h hh).1 e =
      a.1.1.1 ⟨e,Set.mem_univ e⟩ +
      (OriginalRanges.selectedCorrection (k := k) (input X).toTower.localCoefficients P candidates houtside S a.2).1
        ⟨e,Set.mem_univ e⟩ := by
  letI := inputModules T edgeChange comparisonChange input ν hdata X
  have hs := solution_transport T edgeChange comparisonChange input ν hdata P hfixed hlinear candidates houtside X S h
    (hh.trans (negative_defect_affine T edgeChange comparisonChange input ν hdata realize hrealize P hfixed hlinear X).symm)
  exact NativeCorrectionEquation.restore_value (k := k) (input X) P candidates houtside
    (input_linearity T edgeChange comparisonChange input ν hdata hlinear X) (hfixed X) S _ hs e

/-- G-131 A / n1017 §3.5, §6.1 API: every forbidden original candidate has zero
complete correction after restoration to the original input's actual operations. -/
theorem restore_forbidden_zero (X : F) (S : Set candidates)
    (h : OriginalColumns.alwaysSpace (k := k) T.localCoefficients P candidates ×
      (∀ e : S, T.localCoefficients.A e.1.1.2.1))
    (hh : SelectedCokernel.differential D₀ C S h = rhs X)
    (e : candidates) (he : e ∉ S) :
    (input X).solutionCorrection
      (restore T edgeChange comparisonChange input ν hdata realize hrealize P hfixed hlinear candidates houtside X S h hh).1 e.1 = 0 := by
  letI := inputModules T edgeChange comparisonChange input ν hdata X
  have hs := solution_transport T edgeChange comparisonChange input ν hdata P hfixed hlinear candidates houtside X S h
    (hh.trans (negative_defect_affine T edgeChange comparisonChange input ν hdata realize hrealize P hfixed hlinear X).symm)
  exact NativeCorrectionEquation.restore_forbidden_zero (k := k) (input X) P candidates houtside
    (input_linearity T edgeChange comparisonChange input ν hdata hlinear X) (hfixed X) S _ hs e he

/-- G-131 A / n1017 §3.5, §6.1 API: restoration preserves every input's actual
fixed arrow at P and at each forbidden original candidate. -/
theorem restore_fixed_arrow (X : F) (S : Set candidates)
    (h : OriginalColumns.alwaysSpace (k := k) T.localCoefficients P candidates ×
      (∀ e : S, T.localCoefficients.A e.1.1.2.1))
    (hh : SelectedCokernel.differential D₀ C S h = rhs X)
    (e : EdgeName (K := K))
    (he : e ∈ fixedEdgesForRange P.edges candidates (OriginalRanges.allowed candidates S)) :
    (selectedUpper K p q (input X).original
      (restore T edgeChange comparisonChange input ν hdata realize hrealize P hfixed hlinear candidates houtside X S h hh).1.choice).edgeLift e.2.2 =
      (input X).toTower.upper.edgeLift e.2.2 :=
  (restore T edgeChange comparisonChange input ν hdata realize hrealize P hfixed hlinear candidates houtside X S h hh).2 e he

end AAT.AG.RepairObservationDuality.ActualAffineFamily
#assert_standard_axioms_only AAT.AG.RepairObservationDuality.ActualAffineFamily
