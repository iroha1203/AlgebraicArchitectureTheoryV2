import ResearchLean.AG.TransportCoherence.ArbitraryFinitePresentation
import ResearchLean.AG.TransportCoherence.PastingObstruction

/-!
# Transport obstruction over an arbitrary functor

This module formalizes Lemma 4.20 through Proposition 4.26 of the fixed
Rising Sea manuscript for an arbitrary functor `r : E ⥤ B`.

Starting from the arbitrary-functor lift and comparison data in
`ArbitraryFinitePresentation`, it constructs the endpoint transition generated
by successive edge reselection, the resulting noncommutative action and orbit,
the equivalence between obstruction vanishing and simultaneous coherence, the
group homomorphism that transports fiber automorphisms along a following path,
and typed comparison pastings with their syzygy and closed-obstruction laws.

All endpoint transitions, canonical comparisons, and whiskered maps are
generated by strong cocartesian uniqueness.  They are not input fields.

## Implementation notes

The implementation reuses the finite path, face, and typed-pasting syntax from
`FinitePresentation`, while every semantic construction is parameterized by
the arbitrary functor.  This keeps data separate from properties: strong edge
lifts and authored comparisons are input data, whereas transition laws,
coherence, route comparison, and obstruction equations are theorems.  The
alternative of storing endpoint transitions or syzygy equations in structures
was rejected because it would move the conclusions of Lemma 4.20 and
Propositions 4.25--4.26 into assumptions.
-/

namespace AAT.AG.TransportCoherence.Arbitrary

universe uG uE uB vE vB u

open CategoryTheory

/-! ## Successive edge reselection and endpoint transitions (Lemma 4.20) -/

/-- Pointwise multiplication performs two edge reselections successively. -/
theorem reselectedEdgeLift_mul
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : LiftData G r)
    (left right : EdgeReselection data) {i j : G.Vertex}
    (edge : G.Edge i j) :
    reselectedEdgeLift data (left * right) edge =
      reselectedEdgeLift data right edge ≫
        FiberAut.hom (left i j edge) := by
  change data.edgeLift edge ≫
      ((right i j edge).1.hom ≫ (left i j edge).1.hom) =
    (data.edgeLift edge ≫ (right i j edge).1.hom) ≫
      (left i j edge).1.hom
  exact (Category.assoc _ _ _).symm

/-- Reselected path evaluation preserves finite concatenation. -/
theorem reselectedPathLift_append
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : LiftData G r)
    (reselection : EdgeReselection data) {i j k : G.Vertex}
    (first : G.Path i j) (second : G.Path j k) :
    reselectedPathLift data reselection (first.append second) =
      reselectedPathLift data reselection first ≫
        reselectedPathLift data reselection second :=
  (reselectLiftData data reselection).pathLift_append first second

/-- Pointwise multiplication evaluates a path by two successive reselections. -/
theorem reselectedPathLift_mul
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : LiftData G r)
    (left right : EdgeReselection data) {i j : G.Vertex}
    (path : G.Path i j) :
    reselectedPathLift data (left * right) path =
      reselectedPathLift (reselectLiftData data right) left path := by
  induction path with
  | nil vertex => rfl
  | cons edge tail inductionHypothesis =>
      change reselectedEdgeLift data (left * right) edge ≫
          reselectedPathLift data (left * right) tail =
        reselectedEdgeLift (reselectLiftData data right) left edge ≫
          reselectedPathLift (reselectLiftData data right) left tail
      rw [reselectedEdgeLift_mul, inductionHypothesis]
      rfl

/--
The unique endpoint automorphism `A_π(a,b)` generated when `increment` is
performed after the current edge choice.
-/
noncomputable def pathReselectionTransition
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : LiftData G r)
    (current increment : EdgeReselection data) {i j : G.Vertex}
    (path : G.Path i j) : FiberAut r (data.object j) :=
  canonicalFiberComparator r (data.pathBase path)
    (reselectedPathLift data current path)
    (reselectedPathLift data (increment * current) path)
    (reselectedPathLift_isStronglyCocartesian data current path)
    (reselectedPathLift_isStronglyCocartesian
      data (increment * current) path)

/-- Equation (4.23): the endpoint transition factors the current path lift. -/
@[simp]
theorem pathReselectionTransition_fac
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : LiftData G r)
    (current increment : EdgeReselection data) {i j : G.Vertex}
    (path : G.Path i j) :
    reselectedPathLift data current path ≫
        FiberAut.hom
          (pathReselectionTransition data current increment path) =
      reselectedPathLift data (increment * current) path := by
  unfold pathReselectionTransition
  apply canonicalFiberComparator_fac

/-- The identity increment generates the identity endpoint transition. -/
@[simp]
theorem pathReselectionTransition_one
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : LiftData G r)
    (current : EdgeReselection data) {i j : G.Vertex}
    (path : G.Path i j) :
    pathReselectionTransition data current 1 path = 1 := by
  apply FiberAut.ext_of_strong_fac
    (reselectedPathLift data current path)
    (reselectedPathLift_isStronglyCocartesian data current path)
  rw [pathReselectionTransition_fac]
  rw [one_mul]
  change reselectedPathLift data current path =
    reselectedPathLift data current path ≫ 𝟙 (data.object j)
  exact (Category.comp_id _).symm

/--
Equation (4.24): endpoint transitions retain the noncommutative execution
order of successive edge reselections.
-/
theorem pathReselectionTransition_mul
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : LiftData G r)
    (current increment middle : EdgeReselection data)
    {i j : G.Vertex} (path : G.Path i j) :
    pathReselectionTransition data current (middle * increment) path =
      pathReselectionTransition data (increment * current) middle path *
        pathReselectionTransition data current increment path := by
  apply FiberAut.ext_of_strong_fac
    (reselectedPathLift data current path)
    (reselectedPathLift_isStronglyCocartesian data current path)
  calc
    reselectedPathLift data current path ≫
        FiberAut.hom
          (pathReselectionTransition data current
            (middle * increment) path) =
      reselectedPathLift data ((middle * increment) * current) path :=
        pathReselectionTransition_fac
          data current (middle * increment) path
    _ = reselectedPathLift data (middle * (increment * current)) path := by
      rw [mul_assoc]
    _ = reselectedPathLift data (increment * current) path ≫
          FiberAut.hom
            (pathReselectionTransition data
              (increment * current) middle path) :=
      (pathReselectionTransition_fac
        data (increment * current) middle path).symm
    _ = (reselectedPathLift data current path ≫
          FiberAut.hom
            (pathReselectionTransition data current increment path)) ≫
          FiberAut.hom
            (pathReselectionTransition data
              (increment * current) middle path) := by
      exact congrArg
        (fun lift => lift ≫
          FiberAut.hom
            (pathReselectionTransition data
              (increment * current) middle path))
        (pathReselectionTransition_fac
          data current increment path).symm
    _ = reselectedPathLift data current path ≫
        (FiberAut.hom
            (pathReselectionTransition data current increment path) ≫
          FiberAut.hom
            (pathReselectionTransition data
              (increment * current) middle path)) :=
      Category.assoc _ _ _
    _ = reselectedPathLift data current path ≫
        FiberAut.hom
          (pathReselectionTransition data
              (increment * current) middle path *
            pathReselectionTransition data current increment path) := by
      rfl

/-- Equation (4.25), first line, before solving for the new comparator. -/
theorem canonicalFaceComparator_transition_fac
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r)
    (current increment : EdgeReselection data.lift) (cell : G.TwoCell) :
    canonicalFaceComparator data (increment * current) cell *
        pathReselectionTransition data.lift current increment
          (G.twoLeft cell) =
      pathReselectionTransition data.lift current increment
          (G.twoRight cell) *
        canonicalFaceComparator data current cell := by
  apply FiberAut.ext_of_strong_fac
    (reselectedPathLift data.lift current (G.twoLeft cell))
    (reselectedPathLift_isStronglyCocartesian
      data.lift current (G.twoLeft cell))
  change reselectedPathLift data.lift current (G.twoLeft cell) ≫
      (FiberAut.hom
          (pathReselectionTransition data.lift current increment
            (G.twoLeft cell)) ≫
        FiberAut.hom
          (canonicalFaceComparator data (increment * current) cell)) =
    reselectedPathLift data.lift current (G.twoLeft cell) ≫
      (FiberAut.hom (canonicalFaceComparator data current cell) ≫
        FiberAut.hom
          (pathReselectionTransition data.lift current increment
            (G.twoRight cell)))
  calc
    _ = (reselectedPathLift data.lift current (G.twoLeft cell) ≫
          FiberAut.hom
            (pathReselectionTransition data.lift current increment
              (G.twoLeft cell))) ≫
        FiberAut.hom
          (canonicalFaceComparator data (increment * current) cell) :=
      (Category.assoc _ _ _).symm
    _ = reselectedPathLift data.lift (increment * current)
          (G.twoLeft cell) ≫
        FiberAut.hom
          (canonicalFaceComparator data (increment * current) cell) := by
      rw [pathReselectionTransition_fac]
    _ = reselectedPathLift data.lift (increment * current)
          (G.twoRight cell) :=
      canonicalFaceComparator_fac data (increment * current) cell
    _ = reselectedPathLift data.lift current (G.twoRight cell) ≫
        FiberAut.hom
          (pathReselectionTransition data.lift current increment
            (G.twoRight cell)) :=
      (pathReselectionTransition_fac data.lift current increment
        (G.twoRight cell)).symm
    _ = (reselectedPathLift data.lift current (G.twoLeft cell) ≫
          FiberAut.hom (canonicalFaceComparator data current cell)) ≫
        FiberAut.hom
          (pathReselectionTransition data.lift current increment
            (G.twoRight cell)) := by
      rw [canonicalFaceComparator_fac]
    _ = _ := Category.assoc _ _ _

/-- Solved comparator transformation in equation (4.25). -/
theorem canonicalFaceComparator_transition
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r)
    (current increment : EdgeReselection data.lift) (cell : G.TwoCell) :
    canonicalFaceComparator data (increment * current) cell =
      pathReselectionTransition data.lift current increment
          (G.twoRight cell) *
        canonicalFaceComparator data current cell *
          (pathReselectionTransition data.lift current increment
            (G.twoLeft cell))⁻¹ := by
  apply mul_right_cancel
    (b := pathReselectionTransition data.lift current increment
      (G.twoLeft cell))
  rw [canonicalFaceComparator_transition_fac]
  simp [mul_assoc]

/-- Equation (4.25), second line: the raw defect transformation law. -/
theorem rawFaceDefect_transition
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r)
    (current increment : EdgeReselection data.lift) (cell : G.TwoCell) :
    rawFaceDefect data (increment * current) cell =
      (data.comparator cell *
          pathReselectionTransition data.lift current increment
            (G.twoLeft cell) *
          (data.comparator cell)⁻¹) *
        rawFaceDefect data current cell *
          (pathReselectionTransition data.lift current increment
            (G.twoRight cell))⁻¹ := by
  rw [rawFaceDefect, rawFaceDefect,
    canonicalFaceComparator_transition]
  simp only [mul_inv_rev, inv_inv]
  simp [mul_assoc]

/-! ## The reselection action and its orbit (Proposition 4.21) -/

/-- A family of raw face defects over all declared 2-cells. -/
abbrev DefectCochain
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r) :=
  (cell : G.TwoCell) → FiberAut r (data.lift.object (G.twoTarget cell))

/-- Evaluate the raw defect cochain at one edge coordinate. -/
noncomputable def rawDefectCochain
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r)
    (reselection : EdgeReselection data.lift) : DefectCochain data :=
  fun cell => rawFaceDefect data reselection cell

/-- The raw cochain before any edge is reselected. -/
noncomputable def initialRawDefectCochain
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r) : DefectCochain data :=
  rawDefectCochain data 1

/-- The identity defect cochain. -/
def identityDefectCochain
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r) : DefectCochain data :=
  fun _ => 1

/-- Coordinate-dependent translation of a raw cochain by one reselection. -/
noncomputable def reselectionTranslate
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r)
    (current increment : EdgeReselection data.lift)
    (cochain : DefectCochain data) : DefectCochain data :=
  fun cell =>
    (data.comparator cell *
        pathReselectionTransition data.lift current increment
          (G.twoLeft cell) *
        (data.comparator cell)⁻¹) *
      cochain cell *
        (pathReselectionTransition data.lift current increment
          (G.twoRight cell))⁻¹

/-- The identity edge reselection translates no cochain coordinate. -/
@[simp]
theorem reselectionTranslate_one
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r)
    (current : EdgeReselection data.lift) (cochain : DefectCochain data) :
    reselectionTranslate data current 1 cochain = cochain := by
  funext cell
  simp [reselectionTranslate]

/-- Equation (4.26): successive translations satisfy the left action law. -/
theorem reselectionTranslate_mul
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r)
    (current increment middle : EdgeReselection data.lift)
    (cochain : DefectCochain data) :
    reselectionTranslate data (increment * current) middle
        (reselectionTranslate data current increment cochain) =
      reselectionTranslate data current (middle * increment) cochain := by
  funext cell
  simp only [reselectionTranslate, pathReselectionTransition_mul]
  simp [mul_assoc]

/-- The raw cochain is equivariant for the coordinate-dependent action. -/
theorem rawDefectCochain_transition
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r)
    (current increment : EdgeReselection data.lift) :
    rawDefectCochain data (increment * current) =
      reselectionTranslate data current increment
        (rawDefectCochain data current) := by
  funext cell
  exact rawFaceDefect_transition data current increment cell

/-- State space `A × Z` from Proposition 4.21. -/
@[ext] structure ReselectionCochainState
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r) where
  /-- Current edge coordinate. -/
  coordinate : EdgeReselection data.lift
  /-- Current raw-cochain coordinate. -/
  cochain : DefectCochain data

/-- The transformation `Γ_b` of equation (4.26). -/
noncomputable def reselectionStep
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r)
    (increment : EdgeReselection data.lift)
    (state : ReselectionCochainState data) :
    ReselectionCochainState data where
  coordinate := increment * state.coordinate
  cochain := reselectionTranslate data state.coordinate increment state.cochain

/-- `Γ_1` is the identity transformation. -/
@[simp]
theorem reselectionStep_one
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r)
    (state : ReselectionCochainState data) :
    reselectionStep data 1 state = state := by
  cases state
  simp [reselectionStep]

/-- `Γ_c (Γ_b state) = Γ_(cb) state`. -/
theorem reselectionStep_mul
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r)
    (increment middle : EdgeReselection data.lift)
    (state : ReselectionCochainState data) :
    reselectionStep data middle (reselectionStep data increment state) =
      reselectionStep data (middle * increment) state := by
  cases state
  simp [reselectionStep, reselectionTranslate_mul, mul_assoc]

/-- The state `(1, δ(1))` whose orbit is considered in Proposition 4.21. -/
noncomputable def initialReselectionState
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r) :
    ReselectionCochainState data where
  coordinate := 1
  cochain := initialRawDefectCochain data

/-- Acting on `(1, δ(1))` gives exactly `(a, δ(a))`. -/
theorem reselectionStep_initial
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r)
    (reselection : EdgeReselection data.lift) :
    reselectionStep data reselection (initialReselectionState data) =
      { coordinate := reselection
        cochain := rawDefectCochain data reselection } := by
  apply ReselectionCochainState.ext
  · simp [reselectionStep, initialReselectionState]
  · change reselectionTranslate data 1 reselection
        (rawDefectCochain data 1) = rawDefectCochain data reselection
    simpa only [mul_one] using
      (rawDefectCochain_transition data 1 reselection).symm

/-- The orbit of `(1, δ(1))` is exactly the family `(a, δ(a))`. -/
theorem initialReselectionOrbit
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r) :
    Set.range
        (fun reselection : EdgeReselection data.lift =>
          reselectionStep data reselection (initialReselectionState data)) =
      Set.range
        (fun reselection : EdgeReselection data.lift =>
          ({ coordinate := reselection
             cochain := rawDefectCochain data reselection } :
            ReselectionCochainState data)) := by
  apply Set.ext
  intro state
  constructor
  · rintro ⟨reselection, rfl⟩
    exact ⟨reselection, (reselectionStep_initial data reselection).symm⟩
  · rintro ⟨reselection, rfl⟩
    exact ⟨reselection, reselectionStep_initial data reselection⟩

/--
The two-edge one-object groupoid calculation immediately following
Proposition 4.21.  The first current edge value cancels, while the second
remains as a noncommutative conjugating coordinate.
-/
theorem twoEdgeEndpointTransition_formula
    {H : Type u} [Group H] (a₁ a₂ b₁ b₂ : H) :
    (b₂ * a₂ * b₁ * a₁) * (a₂ * a₁)⁻¹ =
      b₂ * a₂ * b₁ * a₂⁻¹ := by
  simp [mul_inv_rev, mul_assoc]

/-- A concrete `S₃` witness that the two-edge transition depends on `a₂`. -/
theorem finThree_twoEdgeTransition_depends_on_current :
    let b₁ : Equiv.Perm (Fin 3) := Equiv.swap 0 1
    let b₂ : Equiv.Perm (Fin 3) := Equiv.swap 1 2
    let a₂ : Equiv.Perm (Fin 3) := Equiv.swap 0 2
    b₂ * a₂ * b₁ * a₂⁻¹ ≠ b₂ * 1 * b₁ * (1 : Equiv.Perm (Fin 3))⁻¹ := by
  decide

/-! ## Vanishing and simultaneous coherence (Theorem 4.22) -/

/-- All authored comparisons are simultaneously coherent at one edge choice. -/
def CoherentAt
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r)
    (reselection : EdgeReselection data.lift) : Prop :=
  ∀ cell : G.TwoCell,
    reselectedPathLift data.lift reselection (G.twoLeft cell) ≫
        FiberAut.hom (data.comparator cell) =
      reselectedPathLift data.lift reselection (G.twoRight cell)

/-- There exists one edge choice coherent for every declared face. -/
def Coherentizable
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r) : Prop :=
  ∃ reselection : EdgeReselection data.lift, CoherentAt data reselection

/-- One raw defect is identity exactly when its authored face is coherent. -/
theorem rawFaceDefect_eq_one_iff_coherent
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r)
    (reselection : EdgeReselection data.lift) (cell : G.TwoCell) :
    rawFaceDefect data reselection cell = 1 ↔
      reselectedPathLift data.lift reselection (G.twoLeft cell) ≫
          FiberAut.hom (data.comparator cell) =
        reselectedPathLift data.lift reselection (G.twoRight cell) := by
  constructor
  · intro defectIdentity
    have comparatorEquality :=
      (rawFaceDefect_eq_one_iff data reselection cell).mp defectIdentity
    rw [comparatorEquality]
    exact canonicalFaceComparator_fac data reselection cell
  · intro coherent
    apply (rawFaceDefect_eq_one_iff data reselection cell).mpr
    apply FiberAut.ext_of_strong_fac
      (reselectedPathLift data.lift reselection (G.twoLeft cell))
      (reselectedPathLift_isStronglyCocartesian
        data.lift reselection (G.twoLeft cell))
    exact coherent.trans
      (canonicalFaceComparator_fac data reselection cell).symm

/-- Pointwise coherence is equivalent to identity of the complete raw cochain. -/
theorem coherentAt_iff_rawDefectCochain_eq_identity
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r)
    (reselection : EdgeReselection data.lift) :
    CoherentAt data reselection ↔
      rawDefectCochain data reselection = identityDefectCochain data := by
  constructor
  · intro coherent
    funext cell
    exact (rawFaceDefect_eq_one_iff_coherent data reselection cell).mpr
      (coherent cell)
  · intro cochainIdentity cell
    apply (rawFaceDefect_eq_one_iff_coherent data reselection cell).mp
    exact congrFun cochainIdentity cell

/-- The raw-cochain orbit under all edge reselections. -/
def reselectionOrbit
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r) :
    Set (DefectCochain data) :=
  Set.range (rawDefectCochain data)

/-- The baseline raw cochain is in its reselection orbit. -/
theorem initialRawDefectCochain_mem_orbit
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r) :
    initialRawDefectCochain data ∈ reselectionOrbit data := by
  exact ⟨1, rfl⟩

/-- The obstruction orbit intersects the identity cochain. -/
def TransportObstructionVanishes
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r) : Prop :=
  identityDefectCochain data ∈ reselectionOrbit data

/-- Theorem 4.22: orbit vanishing is equivalent to a coherent edge choice. -/
theorem transportObstructionVanishes_iff_coherentizable
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : TransportData G r) :
    TransportObstructionVanishes data ↔ Coherentizable data := by
  constructor
  · rintro ⟨reselection, equality⟩
    exact ⟨reselection,
      (coherentAt_iff_rawDefectCochain_eq_identity
        data reselection).mpr equality⟩
  · rintro ⟨reselection, coherent⟩
    exact ⟨reselection,
      (coherentAt_iff_rawDefectCochain_eq_identity
        data reselection).mp coherent⟩

/-! ## Transport of fiber automorphisms (Lemma 4.23) -/

/-- Compose a source-fiber automorphism before a reselected following path. -/
def fiberAutThenPath
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : LiftData G r)
    (reselection : EdgeReselection data) {i j : G.Vertex}
    (automorphism : FiberAut r (data.object i))
    (path : G.Path i j) : data.object i ⟶ data.object j :=
  FiberAut.hom automorphism ≫ reselectedPathLift data reselection path

/-- The upper path used to transport a fiber automorphism is a strong lift. -/
theorem fiberAutThenPath_isStronglyCocartesian
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : LiftData G r)
    (reselection : EdgeReselection data) {i j : G.Vertex}
    (automorphism : FiberAut r (data.object i))
    (path : G.Path i j) :
    r.IsStronglyCocartesian (data.pathBase path)
      (fiberAutThenPath data reselection automorphism path) := by
  letI : r.IsHomLift
      (𝟙 (r.obj (data.object i))) automorphism.1.hom := by
    rw [← automorphism.2]
    infer_instance
  letI : r.IsStronglyCocartesian
      (𝟙 (r.obj (data.object i))) automorphism.1.hom :=
    CategoryTheory.Functor.IsStronglyCocartesian.of_iso
      r (𝟙 (r.obj (data.object i))) automorphism.1
  letI : r.IsStronglyCocartesian
      (data.pathBase path) (reselectedPathLift data reselection path) :=
    reselectedPathLift_isStronglyCocartesian data reselection path
  have composed : r.IsStronglyCocartesian
      (𝟙 (r.obj (data.object i)) ≫ data.pathBase path)
      (automorphism.1.hom ≫ reselectedPathLift data reselection path) :=
    CategoryTheory.Functor.IsStronglyCocartesian.comp r
  simpa only [fiberAutThenPath, FiberAut.hom, Category.id_comp] using composed

/-- Whiskering preserves the exact base path. -/
theorem fiberAutThenPath_map_eq
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : LiftData G r)
    (reselection : EdgeReselection data) {i j : G.Vertex}
    (automorphism : FiberAut r (data.object i))
    (path : G.Path i j) :
    r.map (fiberAutThenPath data reselection automorphism path) =
      data.pathBase path := by
  rw [fiberAutThenPath, r.map_comp, FiberAut.hom_map_eq,
    reselectedPathLift_map_eq, Category.id_comp]

/-- The unique endpoint automorphism transported along a following path. -/
noncomputable def whiskerFiberAut
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : LiftData G r)
    (reselection : EdgeReselection data) {i j : G.Vertex}
    (automorphism : FiberAut r (data.object i))
    (path : G.Path i j) : FiberAut r (data.object j) :=
  canonicalFiberComparator r (data.pathBase path)
    (reselectedPathLift data reselection path)
    (fiberAutThenPath data reselection automorphism path)
    (reselectedPathLift_isStronglyCocartesian data reselection path)
    (fiberAutThenPath_isStronglyCocartesian
      data reselection automorphism path)

/-- Equation (4.28), the defining factorization of transported automorphisms. -/
@[simp]
theorem whiskerFiberAut_fac
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : LiftData G r)
    (reselection : EdgeReselection data) {i j : G.Vertex}
    (automorphism : FiberAut r (data.object i))
    (path : G.Path i j) :
    reselectedPathLift data reselection path ≫
        FiberAut.hom
          (whiskerFiberAut data reselection automorphism path) =
      fiberAutThenPath data reselection automorphism path := by
  unfold whiskerFiberAut
  apply canonicalFiberComparator_fac

/-- Transport along a path sends the identity automorphism to the identity. -/
@[simp]
theorem whiskerFiberAut_one
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : LiftData G r)
    (reselection : EdgeReselection data) {i j : G.Vertex}
    (path : G.Path i j) :
    whiskerFiberAut data reselection 1 path = 1 := by
  apply FiberAut.ext_of_strong_fac
    (reselectedPathLift data reselection path)
    (reselectedPathLift_isStronglyCocartesian data reselection path)
  rw [whiskerFiberAut_fac]
  change 𝟙 (data.object i) ≫ reselectedPathLift data reselection path =
    reselectedPathLift data reselection path ≫ 𝟙 (data.object j)
  simp

/-- Transport along a path preserves multiplication of fiber automorphisms. -/
theorem whiskerFiberAut_mul
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : LiftData G r)
    (reselection : EdgeReselection data) {i j : G.Vertex}
    (left right : FiberAut r (data.object i))
    (path : G.Path i j) :
    whiskerFiberAut data reselection (left * right) path =
      whiskerFiberAut data reselection left path *
        whiskerFiberAut data reselection right path := by
  apply FiberAut.ext_of_strong_fac
    (reselectedPathLift data reselection path)
    (reselectedPathLift_isStronglyCocartesian data reselection path)
  rw [whiskerFiberAut_fac]
  unfold fiberAutThenPath
  rw [show FiberAut.hom (left * right) =
      FiberAut.hom right ≫ FiberAut.hom left by rfl]
  rw [show FiberAut.hom
      (whiskerFiberAut data reselection left path *
        whiskerFiberAut data reselection right path) =
      FiberAut.hom (whiskerFiberAut data reselection right path) ≫
        FiberAut.hom (whiskerFiberAut data reselection left path) by rfl]
  calc
    (FiberAut.hom right ≫ FiberAut.hom left) ≫
        reselectedPathLift data reselection path =
      FiberAut.hom right ≫
        (FiberAut.hom left ≫
          reselectedPathLift data reselection path) :=
      Category.assoc _ _ _
    _ = FiberAut.hom right ≫
        (reselectedPathLift data reselection path ≫
          FiberAut.hom
            (whiskerFiberAut data reselection left path)) := by
      rw [whiskerFiberAut_fac]
      rfl
    _ = (FiberAut.hom right ≫
          reselectedPathLift data reselection path) ≫
        FiberAut.hom
          (whiskerFiberAut data reselection left path) :=
      (Category.assoc _ _ _).symm
    _ = (reselectedPathLift data reselection path ≫
          FiberAut.hom
            (whiskerFiberAut data reselection right path)) ≫
        FiberAut.hom
          (whiskerFiberAut data reselection left path) := by
      rw [whiskerFiberAut_fac]
      rfl
    _ = reselectedPathLift data reselection path ≫
        (FiberAut.hom
            (whiskerFiberAut data reselection right path) ≫
          FiberAut.hom
            (whiskerFiberAut data reselection left path)) :=
      Category.assoc _ _ _

/-- Lemma 4.23 as a group homomorphism between endpoint fiber groups. -/
noncomputable def whiskerFiberAutHom
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : LiftData G r)
    (reselection : EdgeReselection data) {i j : G.Vertex}
    (path : G.Path i j) :
    FiberAut r (data.object i) →* FiberAut r (data.object j) where
  toFun automorphism := whiskerFiberAut data reselection automorphism path
  map_one' := whiskerFiberAut_one data reselection path
  map_mul' left right := whiskerFiberAut_mul
    data reselection left right path

/-! ## Ordered comparison pasting (Construction 4.24) -/

/-- Comparator families on the 2-cells of a full finite presentation. -/
abbrev TwoCellComparatorFamily
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r) :=
  DefectCochain data

/-- The fixed authored comparator family. -/
def authoredComparatorFamily
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r) :
    TwoCellComparatorFamily data :=
  data.comparator

/-- The canonical comparator family generated at one edge coordinate. -/
noncomputable def canonicalComparatorFamily
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift) :
    TwoCellComparatorFamily data :=
  canonicalFaceComparator data reselection

/--
Transport one local comparator through the outgoing path of an oriented face;
a backward face transports the inverse local comparator.
-/
noncomputable def orientedFaceComparator
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift)
    (family : TwoCellComparatorFamily data)
    {source target : G.Vertex}
    (face : WhiskeredFace G.toFiniteTransportTwoPresentation source target) :
    FiberAut r (data.lift.object target) :=
  let localComparator :=
    match face.orientation with
    | .forward => family face.cell
    | .backward => (family face.cell)⁻¹
  whiskerFiberAut data.lift reselection localComparator face.outgoing

/-- The authored comparator carried by one oriented whiskered face. -/
noncomputable def orientedFaceAuthoredComparator
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift)
    {source target : G.Vertex}
    (face : WhiskeredFace G.toFiniteTransportTwoPresentation source target) :
    FiberAut r (data.lift.object target) :=
  orientedFaceComparator data reselection
    (authoredComparatorFamily data) face

/-- The canonical comparator carried by one oriented whiskered face. -/
noncomputable def orientedFaceCanonicalComparator
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift)
    {source target : G.Vertex}
    (face : WhiskeredFace G.toFiniteTransportTwoPresentation source target) :
    FiberAut r (data.lift.object target) :=
  orientedFaceComparator data reselection
    (canonicalComparatorFamily data reselection) face

/-- The oriented one-face raw defect. -/
noncomputable def orientedFaceDefect
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift)
    {source target : G.Vertex}
    (face : WhiskeredFace G.toFiniteTransportTwoPresentation source target) :
    FiberAut r (data.lift.object target) :=
  orientedFaceAuthoredComparator data reselection face *
    (orientedFaceCanonicalComparator data reselection face)⁻¹

/--
Compose a comparator family in temporal rewrite order.  The tail factor occurs
on the left because `Aut` multiplication reverses underlying arrow order.
-/
noncomputable def pastingComparator
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift)
    (family : TwoCellComparatorFamily data)
    {source target : G.Vertex} {before finish : G.Path source target}
    (pasting :
      RewritePasting G.toFiniteTransportTwoPresentation before finish) :
    FiberAut r (data.lift.object target) :=
  match pasting with
  | .nil _ => 1
  | .cons step tail =>
      pastingComparator data reselection family tail *
        orientedFaceComparator data reselection family step.face

/-- The complete authored route comparator `U_P(a)`. -/
noncomputable def authoredPastingComparator
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift)
    {source target : G.Vertex} {before finish : G.Path source target}
    (pasting :
      RewritePasting G.toFiniteTransportTwoPresentation before finish) :
    FiberAut r (data.lift.object target) :=
  pastingComparator data reselection (authoredComparatorFamily data) pasting

/-- The complete canonical route comparator `Φ_P(a)`. -/
noncomputable def canonicalPastingComparator
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift)
    {source target : G.Vertex} {before finish : G.Path source target}
    (pasting :
      RewritePasting G.toFiniteTransportTwoPresentation before finish) :
    FiberAut r (data.lift.object target) :=
  pastingComparator data reselection
    (canonicalComparatorFamily data reselection) pasting

/-- Equation (4.29): raw defect of a complete rewrite route. -/
noncomputable def pastingRawDefect
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift)
    {source target : G.Vertex} {before finish : G.Path source target}
    (pasting :
      RewritePasting G.toFiniteTransportTwoPresentation before finish) :
    FiberAut r (data.lift.object target) :=
  authoredPastingComparator data reselection pasting *
    (canonicalPastingComparator data reselection pasting)⁻¹

/-- The inverse canonical face comparator factors the reverse relation. -/
theorem canonicalFaceComparator_inv_fac
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift) (cell : G.TwoCell) :
    reselectedPathLift data.lift reselection (G.twoRight cell) ≫
        FiberAut.hom
          (canonicalFaceComparator data reselection cell)⁻¹ =
      reselectedPathLift data.lift reselection (G.twoLeft cell) := by
  let comparator := canonicalFaceComparator data reselection cell
  change reselectedPathLift data.lift reselection (G.twoRight cell) ≫
      FiberAut.inv comparator = _
  calc
    _ = (reselectedPathLift data.lift reselection (G.twoLeft cell) ≫
          FiberAut.hom comparator) ≫ FiberAut.inv comparator := by
      exact congrArg
        (fun morphism => morphism ≫ FiberAut.inv comparator)
        (canonicalFaceComparator_fac data reselection cell).symm
    _ = reselectedPathLift data.lift reselection (G.twoLeft cell) ≫
        (FiberAut.hom comparator ≫ FiberAut.inv comparator) :=
      Category.assoc _ _ _
    _ = reselectedPathLift data.lift reselection (G.twoLeft cell) ≫
        𝟙 (data.lift.object (G.twoTarget cell)) := by
      exact congrArg
        (fun morphism =>
          reselectedPathLift data.lift reselection (G.twoLeft cell) ≫
            morphism)
        comparator.1.hom_inv_id
    _ = _ := Category.comp_id _

/-- The oriented canonical face comparator identifies its complete paths. -/
theorem orientedFaceCanonicalComparator_fac
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift)
    {source target : G.Vertex}
    (face : WhiskeredFace G.toFiniteTransportTwoPresentation source target) :
    reselectedPathLift data.lift reselection face.before ≫
        FiberAut.hom
          (orientedFaceCanonicalComparator data reselection face) =
      reselectedPathLift data.lift reselection face.after := by
  rcases face with ⟨cell, incoming, outgoing, orientation⟩
  cases orientation <;>
    simp only [WhiskeredFace.before, WhiskeredFace.after,
      WhiskeredFace.localBefore, WhiskeredFace.localAfter,
      orientedFaceCanonicalComparator, orientedFaceComparator,
      canonicalComparatorFamily, reselectedPathLift_append,
      Category.assoc, whiskerFiberAut_fac, fiberAutThenPath]
  · rw [← Category.assoc
        (reselectedPathLift data.lift reselection (G.twoLeft cell))
        (FiberAut.hom (canonicalFaceComparator data reselection cell))
        (reselectedPathLift data.lift reselection outgoing)]
    rw [canonicalFaceComparator_fac]
  · rw [← Category.assoc
        (reselectedPathLift data.lift reselection (G.twoRight cell))
        (FiberAut.hom (canonicalFaceComparator data reselection cell)⁻¹)
        (reselectedPathLift data.lift reselection outgoing)]
    rw [canonicalFaceComparator_inv_fac]

/-- A typed rewrite step's canonical comparator identifies its indexed paths. -/
theorem rewriteStepCanonicalComparator_fac
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift)
    {source target : G.Vertex} {before finish : G.Path source target}
    (step : RewriteStep G.toFiniteTransportTwoPresentation before finish) :
    reselectedPathLift data.lift reselection before ≫
        FiberAut.hom
          (orientedFaceCanonicalComparator data reselection step.face) =
      reselectedPathLift data.lift reselection finish := by
  rcases step with ⟨face, beforeEq, finishEq⟩
  subst before
  subst finish
  exact orientedFaceCanonicalComparator_fac data reselection face

/-- Equation (4.29): the canonical comparator factors the complete route. -/
theorem canonicalPastingComparator_fac
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift)
    {source target : G.Vertex} {before finish : G.Path source target}
    (pasting :
      RewritePasting G.toFiniteTransportTwoPresentation before finish) :
    reselectedPathLift data.lift reselection before ≫
        FiberAut.hom
          (canonicalPastingComparator data reselection pasting) =
      reselectedPathLift data.lift reselection finish := by
  induction pasting with
  | nil path =>
      change reselectedPathLift data.lift reselection path ≫
          𝟙 (data.lift.object target) = _
      exact Category.comp_id _
  | cons step tail inductionHypothesis =>
      simp only [canonicalPastingComparator, pastingComparator]
      change reselectedPathLift data.lift reselection _ ≫
          (FiberAut.hom
              (orientedFaceCanonicalComparator data reselection step.face) ≫
            FiberAut.hom
              (pastingComparator data reselection
                (canonicalComparatorFamily data reselection) tail)) = _
      calc
        _ = (reselectedPathLift data.lift reselection _ ≫
              FiberAut.hom
                (orientedFaceCanonicalComparator
                  data reselection step.face)) ≫
            FiberAut.hom
              (pastingComparator data reselection
                (canonicalComparatorFamily data reselection) tail) :=
          (Category.assoc _ _ _).symm
        _ = _ := by
          rw [rewriteStepCanonicalComparator_fac]
          exact inductionHypothesis

/-- The canonical route comparator depends only on its endpoint paths. -/
theorem canonicalPastingComparator_unique
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift)
    {source target : G.Vertex} {before finish : G.Path source target}
    (left right :
      RewritePasting G.toFiniteTransportTwoPresentation before finish) :
    canonicalPastingComparator data reselection left =
      canonicalPastingComparator data reselection right := by
  apply FiberAut.ext_of_strong_fac
    (reselectedPathLift data.lift reselection before)
    (reselectedPathLift_isStronglyCocartesian
      data.lift reselection before)
  exact (canonicalPastingComparator_fac data reselection left).trans
    (canonicalPastingComparator_fac data reselection right).symm

/-- Transport along an empty outgoing path leaves a fiber automorphism fixed. -/
@[simp]
theorem whiskerFiberAut_nil
    {G : FiniteTransportTwoPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} (data : LiftData G r)
    (reselection : EdgeReselection data) {vertex : G.Vertex}
    (automorphism : FiberAut r (data.object vertex)) :
    whiskerFiberAut data reselection automorphism (.nil vertex) =
      automorphism := by
  apply FiberAut.ext_of_strong_fac
    (reselectedPathLift data reselection (.nil vertex))
    (reselectedPathLift_isStronglyCocartesian
      data reselection (.nil vertex))
  calc
    _ = fiberAutThenPath data reselection automorphism (.nil vertex) :=
      whiskerFiberAut_fac data reselection automorphism (.nil vertex)
    _ = FiberAut.hom automorphism := by
      change FiberAut.hom automorphism ≫ 𝟙 (data.object vertex) = _
      exact Category.comp_id _
    _ = _ := by
      change FiberAut.hom automorphism =
        𝟙 (data.object vertex) ≫ FiberAut.hom automorphism
      exact (Category.id_comp _).symm

/--
The purely noncommutative two-factor identity underlying equation (4.30).
-/
theorem twoFactorRawDefect_formula
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B} {X : E}
    (u₁ u₂ φ₁ φ₂ : FiberAut r X) :
    (u₂ * u₁) * (φ₂ * φ₁)⁻¹ =
      (u₂ * (u₁ * φ₁⁻¹) * u₂⁻¹) * (u₂ * φ₂⁻¹) := by
  simp [mul_inv_rev, mul_assoc]

/--
Equation (4.30) for a typed two-step pasting: the second authored comparison
conjugates the first raw defect before multiplication by the second defect.
-/
theorem pastingRawDefect_two_steps
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift)
    {source target : G.Vertex}
    {first middle finish : G.Path source target}
    (step₁ : RewriteStep G.toFiniteTransportTwoPresentation first middle)
    (step₂ : RewriteStep G.toFiniteTransportTwoPresentation middle finish) :
    pastingRawDefect data reselection
        (.cons step₁ (.cons step₂ (.nil finish))) =
      (orientedFaceAuthoredComparator data reselection step₂.face *
          orientedFaceDefect data reselection step₁.face *
          (orientedFaceAuthoredComparator data reselection step₂.face)⁻¹) *
        orientedFaceDefect data reselection step₂.face := by
  unfold pastingRawDefect authoredPastingComparator
    canonicalPastingComparator orientedFaceDefect
  simp only [pastingComparator, one_mul]
  exact twoFactorRawDefect_formula
    (orientedFaceAuthoredComparator data reselection step₁.face)
    (orientedFaceAuthoredComparator data reselection step₂.face)
    (orientedFaceCanonicalComparator data reselection step₁.face)
    (orientedFaceCanonicalComparator data reselection step₂.face)

/-! ## Syzygies and closed comparison obstructions (Propositions 4.25--4.26) -/

/-- Equation (4.31), imposed only as a direction hypothesis on authored routes. -/
def SyzygyCompatible
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift) : Prop :=
  ∀ cell : G.ThreeCell,
    authoredPastingComparator data reselection (G.threeLeft cell) =
      authoredPastingComparator data reselection (G.threeRight cell)

/-- Pointwise face coherence entails every declared authored syzygy equation. -/
theorem syzygyCompatible_of_coherentAt
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift)
    (coherent : CoherentAt data reselection) :
    SyzygyCompatible data reselection := by
  have familyEquality :
      authoredComparatorFamily data =
        canonicalComparatorFamily data reselection := by
    funext cell
    apply FiberAut.ext_of_strong_fac
      (reselectedPathLift data.lift reselection (G.twoLeft cell))
      (reselectedPathLift_isStronglyCocartesian
        data.lift reselection (G.twoLeft cell))
    exact (coherent cell).trans
      (canonicalFaceComparator_fac data reselection cell).symm
  intro cell
  change pastingComparator data reselection (authoredComparatorFamily data)
      (G.threeLeft cell) =
    pastingComparator data reselection (authoredComparatorFamily data)
      (G.threeRight cell)
  rw [familyEquality]
  exact canonicalPastingComparator_unique data reselection
    (G.threeLeft cell) (G.threeRight cell)

/-- A named authored mismatch gives a negative syzygy instance. -/
theorem not_syzygyCompatible_of_authored_ne
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift) (cell : G.ThreeCell)
    (authoredNe :
      authoredPastingComparator data reselection (G.threeLeft cell) ≠
        authoredPastingComparator data reselection (G.threeRight cell)) :
    ¬ SyzygyCompatible data reselection := by
  intro compatible
  exact authoredNe (compatible cell)

/-- Proposition 4.25: an authored syzygy gives equality of route defects. -/
theorem rawDefect_cocycle_of_syzygy
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift)
    (compatible : SyzygyCompatible data reselection)
    (cell : G.ThreeCell) :
    pastingRawDefect data reselection (G.threeLeft cell) =
      pastingRawDefect data reselection (G.threeRight cell) := by
  unfold pastingRawDefect
  rw [compatible cell]
  rw [canonicalPastingComparator_unique data reselection
    (G.threeLeft cell) (G.threeRight cell)]

/-- Closed route obstruction comparing the two pastings of a 3-cell. -/
noncomputable def closedPastingRawObstruction
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift) (cell : G.ThreeCell) :
    FiberAut r (data.lift.object (G.threeTarget cell)) :=
  (pastingRawDefect data reselection (G.threeRight cell))⁻¹ *
    pastingRawDefect data reselection (G.threeLeft cell)

/-- Authored route mismatch between the two pastings of a 3-cell. -/
noncomputable def authoredPastingMismatch
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift) (cell : G.ThreeCell) :
    FiberAut r (data.lift.object (G.threeTarget cell)) :=
  (authoredPastingComparator data reselection (G.threeRight cell))⁻¹ *
    authoredPastingComparator data reselection (G.threeLeft cell)

/-- Equation (4.32): the closed raw obstruction is the stated conjugate. -/
theorem closedPastingRawObstruction_eq_conjugate
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift) (cell : G.ThreeCell) :
    closedPastingRawObstruction data reselection cell =
      canonicalPastingComparator data reselection (G.threeLeft cell) *
        authoredPastingMismatch data reselection cell *
          (canonicalPastingComparator data reselection
            (G.threeLeft cell))⁻¹ := by
  unfold closedPastingRawObstruction pastingRawDefect
    authoredPastingMismatch
  rw [← canonicalPastingComparator_unique data reselection
    (G.threeLeft cell) (G.threeRight cell)]
  simp only [mul_inv_rev, inv_inv, mul_assoc]

/-- Closed obstruction is identity exactly when equation (4.31) holds. -/
theorem closedPastingRawObstruction_eq_one_iff
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift) (cell : G.ThreeCell) :
    closedPastingRawObstruction data reselection cell = 1 ↔
      authoredPastingComparator data reselection (G.threeLeft cell) =
        authoredPastingComparator data reselection (G.threeRight cell) := by
  rw [closedPastingRawObstruction_eq_conjugate]
  let canonical :=
    canonicalPastingComparator data reselection (G.threeLeft cell)
  let mismatch := authoredPastingMismatch data reselection cell
  change canonical * mismatch * canonical⁻¹ = 1 ↔ _
  constructor
  · intro equality
    have mismatchIdentity := congrArg
      (fun element => canonical⁻¹ * element * canonical) equality
    have mismatchEq : mismatch = 1 := by
      simpa [mul_assoc] using mismatchIdentity
    have authoredEq := congrArg
      (fun element =>
        authoredPastingComparator data reselection (G.threeRight cell) *
          element) mismatchEq
    simpa [mismatch, authoredPastingMismatch, mul_assoc] using authoredEq
  · intro authoredEq
    dsimp [mismatch, authoredPastingMismatch]
    rw [authoredEq]
    simp

/-- A compatible authored syzygy has identity closed raw obstruction. -/
theorem closedPastingRawObstruction_eq_one_of_syzygy
    {G : FiniteTransportPresentation.{uG}}
    {E : Type uE} {B : Type uB}
    [Category.{vE} E] [Category.{vB} B]
    {r : E ⥤ B}
    (data : TransportData G.toFiniteTransportTwoPresentation r)
    (reselection : EdgeReselection data.lift)
    (compatible : SyzygyCompatible data reselection)
    (cell : G.ThreeCell) :
    closedPastingRawObstruction data reselection cell = 1 :=
  (closedPastingRawObstruction_eq_one_iff
    data reselection cell).mpr (compatible cell)

/-! ## Connection to the existing package-projection implementation -/

open AtomFoundation

/-- The package-to-arbitrary edge map preserves pointwise multiplication. -/
theorem packageEdgeReselection_mul
    {G : FiniteTransportPresentation.{u}}
    {U : AtomCarrier.{u}} (data : AdmissibleLiftData G U)
    (left right : AAT.AG.TransportCoherence.EdgeReselection data) :
    packageEdgeReselection data (left * right) =
      packageEdgeReselection data left * packageEdgeReselection data right := by
  rfl

/-- Recover the existing package edge coordinate from an arbitrary one. -/
def unpackageEdgeReselection
    {G : FiniteTransportPresentation.{u}}
    {U : AtomCarrier.{u}} (data : AdmissibleLiftData G U)
    (reselection : EdgeReselection (packageLiftData data)) :
    AAT.AG.TransportCoherence.EdgeReselection data :=
  fun i j edge =>
    (packageFiberAutMulEquiv (data.package j)).symm
      (reselection i j edge)

/-- Mapping after recovery returns the arbitrary edge coordinate. -/
theorem packageEdgeReselection_unpackage
    {G : FiniteTransportPresentation.{u}}
    {U : AtomCarrier.{u}} (data : AdmissibleLiftData G U)
    (reselection : EdgeReselection (packageLiftData data)) :
    packageEdgeReselection data
        (unpackageEdgeReselection data reselection) = reselection := by
  funext i j edge
  exact (packageFiberAutMulEquiv
    (data.package j)).apply_symm_apply (reselection i j edge)

/-- Recovery after mapping returns the existing package edge coordinate. -/
theorem unpackageEdgeReselection_package
    {G : FiniteTransportPresentation.{u}}
    {U : AtomCarrier.{u}} (data : AdmissibleLiftData G U)
    (reselection : AAT.AG.TransportCoherence.EdgeReselection data) :
    unpackageEdgeReselection data
        (packageEdgeReselection data reselection) = reselection := by
  funext i j edge
  exact (packageFiberAutMulEquiv
    (data.package j)).symm_apply_apply (reselection i j edge)

/-- The arbitrary endpoint transition specializes to the existing package transition. -/
theorem package_pathReselectionTransition
    {G : FiniteTransportPresentation.{u}}
    {U : AtomCarrier.{u}} (data : AdmissibleLiftData G U)
    (current increment : AAT.AG.TransportCoherence.EdgeReselection data)
    {i j : G.Vertex} (path : G.Path i j) :
    pathReselectionTransition (packageLiftData data)
        (packageEdgeReselection data current)
        (packageEdgeReselection data increment) path =
      packageFiberAutMulEquiv _
        (AAT.AG.TransportCoherence.pathReselectionTransition
          data current increment path) := by
  apply FiberAut.ext_of_strong_fac
    (reselectedPathLift (packageLiftData data)
      (packageEdgeReselection data current) path)
    (reselectedPathLift_isStronglyCocartesian
      (packageLiftData data) (packageEdgeReselection data current) path)
  calc
    reselectedPathLift (packageLiftData data)
        (packageEdgeReselection data current) path ≫
          FiberAut.hom
            (pathReselectionTransition (packageLiftData data)
              (packageEdgeReselection data current)
              (packageEdgeReselection data increment) path) =
      reselectedPathLift (packageLiftData data)
        (packageEdgeReselection data increment *
          packageEdgeReselection data current) path :=
      pathReselectionTransition_fac (packageLiftData data)
        (packageEdgeReselection data current)
        (packageEdgeReselection data increment) path
    _ = reselectedPathLift (packageLiftData data)
        (packageEdgeReselection data (increment * current)) path := by
      rw [packageEdgeReselection_mul]
    _ = AAT.AG.TransportCoherence.reselectedPathLift
          data (increment * current) path :=
      package_reselectedPathLift data (increment * current) path
    _ = (AAT.AG.TransportCoherence.reselectedPathLift
          data current path).comp
        (PackageFiberAut.hom
          (AAT.AG.TransportCoherence.pathReselectionTransition
            data current increment path)) :=
      (AAT.AG.TransportCoherence.pathReselectionTransition_fac
        data current increment path).symm
    _ = reselectedPathLift (packageLiftData data)
          (packageEdgeReselection data current) path ≫
        FiberAut.hom
          (packageFiberAutMulEquiv _
            (AAT.AG.TransportCoherence.pathReselectionTransition
              data current increment path)) := by
      rw [package_reselectedPathLift, packageFiberAutMulEquiv_hom]
      rfl

/-- Transport of fiber automorphisms specializes to the existing package map. -/
theorem package_whiskerFiberAut
    {G : FiniteTransportPresentation.{u}}
    {U : AtomCarrier.{u}} (data : AdmissibleLiftData G U)
    (reselection : AAT.AG.TransportCoherence.EdgeReselection data)
    {i j : G.Vertex} (automorphism : PackageFiberAut (data.package i))
    (path : G.Path i j) :
    whiskerFiberAut (packageLiftData data)
        (packageEdgeReselection data reselection)
        (packageFiberAutMulEquiv _ automorphism) path =
      packageFiberAutMulEquiv _
        (AAT.AG.TransportCoherence.whiskerFiberAut
          data reselection automorphism path) := by
  apply FiberAut.ext_of_strong_fac
    (reselectedPathLift (packageLiftData data)
      (packageEdgeReselection data reselection) path)
    (reselectedPathLift_isStronglyCocartesian
      (packageLiftData data) (packageEdgeReselection data reselection) path)
  calc
    reselectedPathLift (packageLiftData data)
        (packageEdgeReselection data reselection) path ≫
          FiberAut.hom
            (whiskerFiberAut (packageLiftData data)
              (packageEdgeReselection data reselection)
              (packageFiberAutMulEquiv _ automorphism) path) =
      fiberAutThenPath (packageLiftData data)
        (packageEdgeReselection data reselection)
        (packageFiberAutMulEquiv _ automorphism) path :=
      whiskerFiberAut_fac (packageLiftData data)
        (packageEdgeReselection data reselection)
        (packageFiberAutMulEquiv _ automorphism) path
    _ = (PackageFiberAut.hom automorphism).comp
        (AAT.AG.TransportCoherence.reselectedPathLift
          data reselection path) := by
      unfold fiberAutThenPath
      rw [packageFiberAutMulEquiv_hom,
        package_reselectedPathLift]
      rfl
    _ = (AAT.AG.TransportCoherence.reselectedPathLift
          data reselection path).comp
        (PackageFiberAut.hom
          (AAT.AG.TransportCoherence.whiskerFiberAut
            data reselection automorphism path)) :=
      (AAT.AG.TransportCoherence.whiskerFiberAut_fac
        data reselection automorphism path).symm
    _ = reselectedPathLift (packageLiftData data)
          (packageEdgeReselection data reselection) path ≫
        FiberAut.hom
          (packageFiberAutMulEquiv _
            (AAT.AG.TransportCoherence.whiskerFiberAut
              data reselection automorphism path)) := by
      rw [package_reselectedPathLift, packageFiberAutMulEquiv_hom]
      rfl

/-- Simultaneous coherence agrees with the existing package predicate. -/
theorem package_coherentAt_iff
    {G : FiniteTransportPresentation.{u}}
    {U : AtomCarrier.{u}} (data : AdmissibleTransportData G U)
    (reselection : AAT.AG.TransportCoherence.EdgeReselection data.lift) :
    CoherentAt (packageTransportData data)
        (packageEdgeReselection data.lift reselection) ↔
      AAT.AG.TransportCoherence.CoherentAt data reselection := by
  constructor
  · intro coherent cell
    have equality := coherent cell
    change reselectedPathLift (packageLiftData data.lift)
          (packageEdgeReselection data.lift reselection) (G.twoLeft cell) ≫
          FiberAut.hom
            (packageFiberAutMulEquiv _ (data.comparator cell)) =
        reselectedPathLift (packageLiftData data.lift)
          (packageEdgeReselection data.lift reselection)
          (G.twoRight cell) at equality
    rw [package_reselectedPathLift,
      packageFiberAutMulEquiv_hom,
      package_reselectedPathLift] at equality
    exact equality
  · intro coherent cell
    change reselectedPathLift (packageLiftData data.lift)
          (packageEdgeReselection data.lift reselection) (G.twoLeft cell) ≫
          FiberAut.hom
            (packageFiberAutMulEquiv _ (data.comparator cell)) =
        reselectedPathLift (packageLiftData data.lift)
          (packageEdgeReselection data.lift reselection)
          (G.twoRight cell)
    rw [package_reselectedPathLift,
      packageFiberAutMulEquiv_hom,
      package_reselectedPathLift]
    exact coherent cell

/-- Coherentizability agrees under the pointwise fiber-group equivalence. -/
theorem package_coherentizable_iff
    {G : FiniteTransportPresentation.{u}}
    {U : AtomCarrier.{u}} (data : AdmissibleTransportData G U) :
    Coherentizable (packageTransportData data) ↔
      AAT.AG.TransportCoherence.Coherentizable data := by
  constructor
  · rintro ⟨reselection, coherent⟩
    let recovered := unpackageEdgeReselection data.lift reselection
    refine ⟨recovered,
      (package_coherentAt_iff data recovered).mp ?_⟩
    simpa only [recovered,
      packageEdgeReselection_unpackage data.lift reselection] using coherent
  · rintro ⟨reselection, coherent⟩
    exact ⟨packageEdgeReselection data.lift reselection,
      (package_coherentAt_iff data reselection).mpr coherent⟩

/-- Obstruction vanishing agrees with the existing package obstruction. -/
theorem package_transportObstructionVanishes_iff
    {G : FiniteTransportPresentation.{u}}
    {U : AtomCarrier.{u}} (data : AdmissibleTransportData G U) :
    TransportObstructionVanishes (packageTransportData data) ↔
      AAT.AG.TransportCoherence.TransportObstructionVanishes data := by
  rw [transportObstructionVanishes_iff_coherentizable,
    AAT.AG.TransportCoherence.transportObstructionVanishes_iff_coherentizable]
  exact package_coherentizable_iff data

/-- Map an existing package comparator family into the arbitrary fiber groups. -/
def packageComparatorFamily
    {G : FiniteTransportPresentation.{u}}
    {U : AtomCarrier.{u}} (data : AdmissibleTransportData G U)
    (family : AAT.AG.TransportCoherence.TwoCellComparatorFamily data) :
    TwoCellComparatorFamily (packageTransportData data) :=
  fun cell => packageFiberAutMulEquiv _ (family cell)

/-- The mapped authored family is the arbitrary authored family. -/
theorem package_authoredComparatorFamily
    {G : FiniteTransportPresentation.{u}}
    {U : AtomCarrier.{u}} (data : AdmissibleTransportData G U) :
    packageComparatorFamily data
        (AAT.AG.TransportCoherence.authoredComparatorFamily data) =
      authoredComparatorFamily (packageTransportData data) := by
  rfl

/-- The mapped canonical family is the arbitrary canonical family. -/
theorem package_canonicalComparatorFamily
    {G : FiniteTransportPresentation.{u}}
    {U : AtomCarrier.{u}} (data : AdmissibleTransportData G U)
    (reselection : AAT.AG.TransportCoherence.EdgeReselection data.lift) :
    packageComparatorFamily data
        (AAT.AG.TransportCoherence.canonicalComparatorFamily
          data reselection) =
      canonicalComparatorFamily (packageTransportData data)
        (packageEdgeReselection data.lift reselection) := by
  funext cell
  exact (package_canonicalFaceComparator data reselection cell).symm

/-- Oriented comparator transport commutes with the package-fiber equivalence. -/
theorem package_orientedFaceComparator
    {G : FiniteTransportPresentation.{u}}
    {U : AtomCarrier.{u}} (data : AdmissibleTransportData G U)
    (reselection : AAT.AG.TransportCoherence.EdgeReselection data.lift)
    (family : AAT.AG.TransportCoherence.TwoCellComparatorFamily data)
    {source target : G.Vertex}
    (face : WhiskeredFace G.toFiniteTransportTwoPresentation source target) :
    orientedFaceComparator (packageTransportData data)
        (packageEdgeReselection data.lift reselection)
        (packageComparatorFamily data family) face =
      packageFiberAutMulEquiv _
        (AAT.AG.TransportCoherence.orientedFaceComparator
          data reselection family face) := by
  rcases face with ⟨cell, incoming, outgoing, orientation⟩
  cases orientation
  · exact package_whiskerFiberAut data.lift reselection
      (family cell) outgoing
  · simpa only [orientedFaceComparator, packageComparatorFamily,
        map_inv] using
      (package_whiskerFiberAut data.lift reselection
        (family cell)⁻¹ outgoing)

/-- Complete typed pasting commutes with the package-fiber equivalence. -/
theorem package_pastingComparator
    {G : FiniteTransportPresentation.{u}}
    {U : AtomCarrier.{u}} (data : AdmissibleTransportData G U)
    (reselection : AAT.AG.TransportCoherence.EdgeReselection data.lift)
    (family : AAT.AG.TransportCoherence.TwoCellComparatorFamily data)
    {source target : G.Vertex} {before finish : G.Path source target}
    (pasting :
      RewritePasting G.toFiniteTransportTwoPresentation before finish) :
    pastingComparator (packageTransportData data)
        (packageEdgeReselection data.lift reselection)
        (packageComparatorFamily data family) pasting =
      packageFiberAutMulEquiv _
        (AAT.AG.TransportCoherence.pastingComparator
          data reselection family pasting) := by
  induction pasting with
  | nil path =>
      change (1 : FiberAut (packageProjection U)
          (data.lift.package target)) =
        packageFiberAutMulEquiv _
          (1 : PackageFiberAut (data.lift.package target))
      exact (map_one (packageFiberAutMulEquiv _)).symm
  | cons step tail inductionHypothesis =>
      simp only [pastingComparator]
      rw [inductionHypothesis,
        package_orientedFaceComparator data reselection family step.face]
      exact (map_mul (packageFiberAutMulEquiv _)
        (AAT.AG.TransportCoherence.pastingComparator
          data reselection family tail)
        (AAT.AG.TransportCoherence.orientedFaceComparator
          data reselection family step.face)).symm

/-- The arbitrary authored route specializes to the existing authored route. -/
theorem package_authoredPastingComparator
    {G : FiniteTransportPresentation.{u}}
    {U : AtomCarrier.{u}} (data : AdmissibleTransportData G U)
    (reselection : AAT.AG.TransportCoherence.EdgeReselection data.lift)
    {source target : G.Vertex} {before finish : G.Path source target}
    (pasting :
      RewritePasting G.toFiniteTransportTwoPresentation before finish) :
    authoredPastingComparator (packageTransportData data)
        (packageEdgeReselection data.lift reselection) pasting =
      packageFiberAutMulEquiv _
        (AAT.AG.TransportCoherence.authoredPastingComparator
          data reselection pasting) := by
  simpa only [authoredPastingComparator,
    AAT.AG.TransportCoherence.authoredPastingComparator,
    package_authoredComparatorFamily] using
    (package_pastingComparator data reselection
      (AAT.AG.TransportCoherence.authoredComparatorFamily data) pasting)

/-- The arbitrary canonical route specializes to the existing canonical route. -/
theorem package_canonicalPastingComparator
    {G : FiniteTransportPresentation.{u}}
    {U : AtomCarrier.{u}} (data : AdmissibleTransportData G U)
    (reselection : AAT.AG.TransportCoherence.EdgeReselection data.lift)
    {source target : G.Vertex} {before finish : G.Path source target}
    (pasting :
      RewritePasting G.toFiniteTransportTwoPresentation before finish) :
    canonicalPastingComparator (packageTransportData data)
        (packageEdgeReselection data.lift reselection) pasting =
      packageFiberAutMulEquiv _
        (AAT.AG.TransportCoherence.canonicalPastingComparator
          data reselection pasting) := by
  have mapped := package_pastingComparator data reselection
    (AAT.AG.TransportCoherence.canonicalComparatorFamily data reselection)
    pasting
  rw [package_canonicalComparatorFamily data reselection] at mapped
  exact mapped

/-- The arbitrary complete raw defect specializes to the existing raw defect. -/
theorem package_pastingRawDefect
    {G : FiniteTransportPresentation.{u}}
    {U : AtomCarrier.{u}} (data : AdmissibleTransportData G U)
    (reselection : AAT.AG.TransportCoherence.EdgeReselection data.lift)
    {source target : G.Vertex} {before finish : G.Path source target}
    (pasting :
      RewritePasting G.toFiniteTransportTwoPresentation before finish) :
    pastingRawDefect (packageTransportData data)
        (packageEdgeReselection data.lift reselection) pasting =
      packageFiberAutMulEquiv _
        (AAT.AG.TransportCoherence.pastingRawDefect
          data reselection pasting) := by
  unfold pastingRawDefect AAT.AG.TransportCoherence.pastingRawDefect
  rw [package_authoredPastingComparator,
    package_canonicalPastingComparator]
  rw [← map_inv (packageFiberAutMulEquiv _)
    (AAT.AG.TransportCoherence.canonicalPastingComparator
      data reselection pasting)]
  exact (map_mul (packageFiberAutMulEquiv _)
    (AAT.AG.TransportCoherence.authoredPastingComparator
      data reselection pasting)
    (AAT.AG.TransportCoherence.canonicalPastingComparator
      data reselection pasting)⁻¹).symm

/-- The arbitrary closed obstruction specializes to the existing closed obstruction. -/
theorem package_closedPastingRawObstruction
    {G : FiniteTransportPresentation.{u}}
    {U : AtomCarrier.{u}} (data : AdmissibleTransportData G U)
    (reselection : AAT.AG.TransportCoherence.EdgeReselection data.lift)
    (cell : G.ThreeCell) :
    closedPastingRawObstruction (packageTransportData data)
        (packageEdgeReselection data.lift reselection) cell =
      packageFiberAutMulEquiv _
        (AAT.AG.TransportCoherence.closedPastingRawObstruction
          data reselection cell) := by
  unfold closedPastingRawObstruction
    AAT.AG.TransportCoherence.closedPastingRawObstruction
  rw [package_pastingRawDefect, package_pastingRawDefect]
  rw [← map_inv (packageFiberAutMulEquiv _)
    (AAT.AG.TransportCoherence.pastingRawDefect
      data reselection (G.threeRight cell))]
  exact (map_mul (packageFiberAutMulEquiv _)
    (AAT.AG.TransportCoherence.pastingRawDefect
      data reselection (G.threeRight cell))⁻¹
    (AAT.AG.TransportCoherence.pastingRawDefect
      data reselection (G.threeLeft cell))).symm

/-- Authored syzygy compatibility agrees with the existing package predicate. -/
theorem package_syzygyCompatible_iff
    {G : FiniteTransportPresentation.{u}}
    {U : AtomCarrier.{u}} (data : AdmissibleTransportData G U)
    (reselection : AAT.AG.TransportCoherence.EdgeReselection data.lift) :
    SyzygyCompatible (packageTransportData data)
        (packageEdgeReselection data.lift reselection) ↔
      AAT.AG.TransportCoherence.SyzygyCompatible data reselection := by
  constructor
  · intro compatible cell
    apply (packageFiberAutMulEquiv
      (data.lift.package (G.threeTarget cell))).injective
    simpa only [← package_authoredPastingComparator] using
      (compatible cell)
  · intro compatible cell
    rw [package_authoredPastingComparator,
      package_authoredPastingComparator]
    exact congrArg (packageFiberAutMulEquiv
      (data.lift.package (G.threeTarget cell))) (compatible cell)

end AAT.AG.TransportCoherence.Arbitrary

#assert_standard_axioms_only AAT.AG.TransportCoherence.Arbitrary
