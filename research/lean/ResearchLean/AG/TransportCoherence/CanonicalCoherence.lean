import ResearchLean.AG.AtomFoundation.LiftUniqueness

/-!
# Canonical coherence of AAT package transport

This module begins G-106 at the accepted G-101 universal property.  It compares
the canonical lift of a composite exact doctrine morphism with the composite of
the two canonical lifts and proves the adjacent-composition equation by
uniqueness of strongly cocartesian factorization.

## Implementation notes

The comparison is constructed by `transportAlong_liftUniqueUpToFiberIso`; no
comparison or coherence certificate is accepted as input.  Direct equality of
the two transported package structures was rejected because G-106 needs the
fiber isomorphism supplied by the opcartesian universal property.
-/

namespace AAT.AG.TransportCoherence

universe u

open CategoryTheory
open AtomFoundation

/--
The G-106/J0 two-step lift, used as the target of the binary comparison.
It is composed solely from the two G-101 canonical package lifts; `P,f,g` are
the ambient package and exact morphisms, not comparison certificates.
-/
def transportAlongCompHom {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E) :
    PackageTotalHom P (transportAlong (transportAlong P f) g) :=
  (transportAlongHom P f).comp (transportAlongHom (transportAlong P f) g)

/--
The G-106/J0 two-step lift is strongly cocartesian over its composite base map.
The proof derives both factor instances from G-101 and composes them; no
cocartesian premise is exposed in the theorem signature.
-/
theorem transportAlongCompHom_isStronglyCocartesian {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E) :
    (packageProjection U).IsStronglyCocartesian
      (transportAlongCompHom P f g).base (transportAlongCompHom P f g) := by
  letI : (packageProjection U).IsStronglyCocartesian
      (transportAlongHom P f).base (transportAlongHom P f) :=
    transportAlongHom_isStronglyCocartesian P f
  letI : (packageProjection U).IsStronglyCocartesian
      (transportAlongHom (transportAlong P f) g).base
      (transportAlongHom (transportAlong P f) g) :=
    transportAlongHom_isStronglyCocartesian (transportAlong P f) g
  change (packageProjection U).IsStronglyCocartesian
    ((transportAlongHom P f).base.comp
      (transportAlongHom (transportAlong P f) g).base)
    ((transportAlongHom P f).comp
      (transportAlongHom (transportAlong P f) g))
  exact CategoryTheory.Functor.IsStronglyCocartesian.comp (packageProjection U)

/--
Direct and iterated G-106/J0 transport have the same pointed doctrine.
This computed equality only aligns dependent types; it does not supply the
binary comparison that is subsequently generated from G-101 uniqueness.
-/
theorem transportAlong_comp_point {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E) :
    packagePoint (transportAlong P (f.comp g)) =
      packagePoint (transportAlong (transportAlong P f) g) :=
  rfl

/--
The G-106/J0 iterated lift lies over the direct composite base followed by
fiber identity.  The equation is computed from `f,g` and discharges the base
alignment required by the G-101 universal property.
-/
theorem transportAlongCompHom_base_eq {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E) :
    (transportAlongHom P (f.comp g)).base.comp
        (eqToHom (transportAlong_comp_point P f g) : ExtInstHom
          (packagePoint (transportAlong P (f.comp g)))
          (packagePoint (transportAlong (transportAlong P f) g))) =
      (transportAlongCompHom P f g).base := by
  apply ExtInstHom.ext
  apply ExactDoctrineHom.ext
  · rfl
  · apply Equiv.ext
    intro atom
    rfl

/--
The G-106/J0 canonical fiber isomorphism from transport along a composite to
iterated transport.  Both legs lie over the equality-induced identity of the
common pointed doctrine.  The isomorphism is generated by G-101 lift uniqueness
from `P,f,g`; it is not accepted as a theorem premise.
-/
noncomputable def transportAlong_compFiberIso {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E) :
    PackageFiberInnerIso
      (transportAlong P (f.comp g))
      (transportAlong (transportAlong P f) g)
      (transportAlong_comp_point P f g) := by
  letI : (packageProjection U).IsStronglyCocartesian
      (transportAlongCompHom P f g).base (transportAlongCompHom P f g) :=
    transportAlongCompHom_isStronglyCocartesian P f g
  letI : (packageProjection U).IsStronglyCocartesian
      ((transportAlongHom P (f.comp g)).base.comp
        (eqToHom (transportAlong_comp_point P f g) : ExtInstHom
          (packagePoint (transportAlong P (f.comp g)))
          (packagePoint (transportAlong (transportAlong P f) g))))
      (transportAlongCompHom P f g) := by
    rw [transportAlongCompHom_base_eq]
    exact transportAlongCompHom_isStronglyCocartesian P f g
  exact transportAlong_liftUniqueUpToFiberIso P
    (transportAlong (transportAlong P f) g) (f.comp g)
    (transportAlong_comp_point P f g)
    (transportAlongCompHom P f g)

/--
The G-106/J0 comparison identifies the direct composite lift with the iterated
lift.  This factorization is the G-101 universal-property certificate generated
for `transportAlong_compFiberIso`, not an input to its construction.
-/
theorem transportAlong_compFiberIso_hom_fac {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E) :
    (transportAlongHom P (f.comp g)).comp
        (transportAlong_compFiberIso P f g).iso.hom =
      transportAlongCompHom P f g := by
  letI : (packageProjection U).IsStronglyCocartesian
      (transportAlongCompHom P f g).base (transportAlongCompHom P f g) :=
    transportAlongCompHom_isStronglyCocartesian P f g
  letI : (packageProjection U).IsStronglyCocartesian
      ((transportAlongHom P (f.comp g)).base.comp
        (eqToHom (transportAlong_comp_point P f g) : ExtInstHom
          (packagePoint (transportAlong P (f.comp g)))
          (packagePoint (transportAlong (transportAlong P f) g))))
      (transportAlongCompHom P f g) := by
    rw [transportAlongCompHom_base_eq]
    exact transportAlongCompHom_isStronglyCocartesian P f g
  exact transportAlong_liftUniqueUpToFiberIso_hom_fac P
    (transportAlong (transportAlong P f) g) (f.comp g)
    (transportAlong_comp_point P f g)
    (transportAlongCompHom P f g)

/--
The G-106/J0 fully iterated three-step lift.  It is an API helper composed from
three G-101 canonical lifts and introduces no comparison or coherence data.
-/
def transportAlongTripleHom {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    PackageTotalHom P
      (transportAlong (transportAlong (transportAlong P f) g) h) :=
  (transportAlongCompHom P f g).comp
    (transportAlongHom (transportAlong (transportAlong P f) g) h)

/--
The G-106/J0 three-step lift is strongly cocartesian over its composite base.
All component instances are derived from G-101 inside the proof.
-/
theorem transportAlongTripleHom_isStronglyCocartesian {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    (packageProjection U).IsStronglyCocartesian
      (transportAlongTripleHom P f g h).base
      (transportAlongTripleHom P f g h) := by
  letI : (packageProjection U).IsStronglyCocartesian
      (transportAlongCompHom P f g).base (transportAlongCompHom P f g) :=
    transportAlongCompHom_isStronglyCocartesian P f g
  letI : (packageProjection U).IsStronglyCocartesian
      (transportAlongHom (transportAlong (transportAlong P f) g) h).base
      (transportAlongHom (transportAlong (transportAlong P f) g) h) :=
    transportAlongHom_isStronglyCocartesian
      (transportAlong (transportAlong P f) g) h
  change (packageProjection U).IsStronglyCocartesian
    ((transportAlongCompHom P f g).base.comp
      (transportAlongHom (transportAlong (transportAlong P f) g) h).base)
    ((transportAlongCompHom P f g).comp
      (transportAlongHom (transportAlong (transportAlong P f) g) h))
  exact CategoryTheory.Functor.IsStronglyCocartesian.comp (packageProjection U)

/--
Right-associated direct and fully iterated G-106/J0 transport have the same
pointed doctrine.  This computed equality supplies only dependent alignment.
-/
theorem transportAlong_triple_point {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    packagePoint (transportAlong P (f.comp (g.comp h))) =
      packagePoint
        (transportAlong (transportAlong (transportAlong P f) g) h) :=
  rfl

/--
The fully iterated G-106/J0 lift has the base of the right-associated direct
composite followed by endpoint identity.  The base equation is derived from
`f,g,h`, with no supplied coherence certificate.
-/
theorem transportAlongTripleHom_base_eq {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    (transportAlongHom P (f.comp (g.comp h))).base.comp
        (eqToHom (transportAlong_triple_point P f g h) : ExtInstHom
          (packagePoint (transportAlong P (f.comp (g.comp h))))
          (packagePoint
            (transportAlong (transportAlong (transportAlong P f) g) h))) =
      (transportAlongTripleHom P f g h).base := by
  apply ExtInstHom.ext
  apply ExactDoctrineHom.ext
  · rfl
  · apply Equiv.ext
    intro atom
    rfl

/--
The G-106/J0 universal normal-form comparison from right-associated direct
three-step transport to full iteration.  G-101 lift uniqueness generates it
from the canonical lifts; it is an auxiliary comparator, not a coherence input.
-/
noncomputable def transportAlong_tripleFiberIso {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    PackageFiberInnerIso
      (transportAlong P (f.comp (g.comp h)))
      (transportAlong (transportAlong (transportAlong P f) g) h)
      (transportAlong_triple_point P f g h) := by
  letI : (packageProjection U).IsStronglyCocartesian
      (transportAlongTripleHom P f g h).base
      (transportAlongTripleHom P f g h) :=
    transportAlongTripleHom_isStronglyCocartesian P f g h
  letI : (packageProjection U).IsStronglyCocartesian
      ((transportAlongHom P (f.comp (g.comp h))).base.comp
        (eqToHom (transportAlong_triple_point P f g h) : ExtInstHom
          (packagePoint (transportAlong P (f.comp (g.comp h))))
          (packagePoint
            (transportAlong (transportAlong (transportAlong P f) g) h))))
      (transportAlongTripleHom P f g h) := by
    rw [transportAlongTripleHom_base_eq]
    exact transportAlongTripleHom_isStronglyCocartesian P f g h
  exact transportAlong_liftUniqueUpToFiberIso P
    (transportAlong (transportAlong (transportAlong P f) g) h)
    (f.comp (g.comp h)) (transportAlong_triple_point P f g h)
    (transportAlongTripleHom P f g h)

/--
The direct three-step lift followed by the G-106/J0 normal-form comparison is
the fully iterated lift.  This is its G-101-generated factorization equation.
-/
theorem transportAlong_tripleFiberIso_hom_fac {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    (transportAlongHom P (f.comp (g.comp h))).comp
        (transportAlong_tripleFiberIso P f g h).iso.hom =
      transportAlongTripleHom P f g h := by
  letI : (packageProjection U).IsStronglyCocartesian
      (transportAlongTripleHom P f g h).base
      (transportAlongTripleHom P f g h) :=
    transportAlongTripleHom_isStronglyCocartesian P f g h
  letI : (packageProjection U).IsStronglyCocartesian
      ((transportAlongHom P (f.comp (g.comp h))).base.comp
        (eqToHom (transportAlong_triple_point P f g h) : ExtInstHom
          (packagePoint (transportAlong P (f.comp (g.comp h))))
          (packagePoint
            (transportAlong (transportAlong (transportAlong P f) g) h))))
      (transportAlongTripleHom P f g h) := by
    rw [transportAlongTripleHom_base_eq]
    exact transportAlongTripleHom_isStronglyCocartesian P f g h
  exact transportAlong_liftUniqueUpToFiberIso_hom_fac P
    (transportAlong (transportAlong (transportAlong P f) g) h)
    (f.comp (g.comp h)) (transportAlong_triple_point P f g h)
    (transportAlongTripleHom P f g h)

/--
The right-associated G-106/J0 adjacent path from direct transport to full
three-step iteration.  Both binary comparisons are generated separately by
G-101 lift uniqueness; `P,f,g,h` are the only inputs.
-/
noncomputable def transportAlongAdjacentCompHom {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    PackageTotalHom
      (transportAlong P (f.comp (g.comp h)))
      (transportAlong (transportAlong (transportAlong P f) g) h) :=
  (transportAlong_compFiberIso P f (g.comp h)).iso.hom.comp
    (transportAlong_compFiberIso (transportAlong P f) g h).iso.hom

/--
The right-associated G-106/J0 adjacent path lies over identity in the endpoint
fiber.  This is derived from the base fields of the two generated comparisons.
-/
theorem transportAlongAdjacentCompHom_base {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    (transportAlongAdjacentCompHom P f g h).base =
      (eqToHom (transportAlong_triple_point P f g h) : ExtInstHom
        (packagePoint (transportAlong P (f.comp (g.comp h))))
        (packagePoint
          (transportAlong (transportAlong (transportAlong P f) g) h))) := by
  change
    (transportAlong_compFiberIso P f (g.comp h)).iso.hom.base.comp
        (transportAlong_compFiberIso (transportAlong P f) g h).iso.hom.base = _
  rw [(transportAlong_compFiberIso P f (g.comp h)).hom_base_eq]
  rw [(transportAlong_compFiberIso (transportAlong P f) g h).hom_base_eq]
  apply ExtInstHom.ext
  apply ExactDoctrineHom.ext
  · rfl
  · apply Equiv.ext
    intro atom
    rfl

/--
The right-associated direct lift followed by its two G-106/J0 adjacent
comparisons is the triple lift.  The proof uses both G-101 factorization
equations and accepts no path equality as input.
-/
theorem transportAlongAdjacentCompHom_fac {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    (transportAlongHom P (f.comp (g.comp h))).comp
        (transportAlongAdjacentCompHom P f g h) =
      transportAlongTripleHom P f g h := by
  change
    (transportAlongHom P (f.comp (g.comp h))) ≫
        ((transportAlong_compFiberIso P f (g.comp h)).iso.hom ≫
          (transportAlong_compFiberIso (transportAlong P f) g h).iso.hom) = _
  rw [← Category.assoc]
  change
    ((transportAlongHom P (f.comp (g.comp h))).comp
        (transportAlong_compFiberIso P f (g.comp h)).iso.hom).comp
      (transportAlong_compFiberIso (transportAlong P f) g h).iso.hom = _
  rw [transportAlong_compFiberIso_hom_fac]
  change
    (transportAlongCompHom P f (g.comp h)) ≫
        (transportAlong_compFiberIso (transportAlong P f) g h).iso.hom = _
  change
    ((transportAlongHom P f) ≫
        (transportAlongHom (transportAlong P f) (g.comp h))) ≫
        (transportAlong_compFiberIso (transportAlong P f) g h).iso.hom = _
  rw [Category.assoc]
  change
    (transportAlongHom P f).comp
      ((transportAlongHom (transportAlong P f) (g.comp h)).comp
        (transportAlong_compFiberIso (transportAlong P f) g h).iso.hom) = _
  rw [transportAlong_compFiberIso_hom_fac]
  exact (@Category.assoc
    (AATCorePackage U) (PackageTotalHom.packageTotalCategory U)
    P (transportAlong P f) (transportAlong (transportAlong P f) g)
    (transportAlong (transportAlong (transportAlong P f) g) h)
    (transportAlongHom P f)
    (transportAlongHom (transportAlong P f) g)
    (transportAlongHom (transportAlong (transportAlong P f) g) h)).symm

/--
The right-associated G-106/J0 adjacent path equals the independently generated
three-step universal normal form.  This is a one-sided normalization lemma,
forced by G-101 opcartesian uniqueness; full two-path coherence is stated by
`transportAlong_comp_coherence` below.
-/
theorem transportAlong_rightAdjacent_normalization {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    transportAlongAdjacentCompHom P f g h =
      (transportAlong_tripleFiberIso P f g h).iso.hom := by
  letI : (packageProjection U).IsStronglyCocartesian
      (transportAlongHom P (f.comp (g.comp h))).base
      (transportAlongHom P (f.comp (g.comp h))) :=
    transportAlongHom_isStronglyCocartesian P (f.comp (g.comp h))
  letI : (packageProjection U).IsHomLift
      (eqToHom (transportAlong_triple_point P f g h) : ExtInstHom
        (packagePoint (transportAlong P (f.comp (g.comp h))))
        (packagePoint
          (transportAlong (transportAlong (transportAlong P f) g) h)))
      (transportAlongAdjacentCompHom P f g h) := by
    rw [← transportAlongAdjacentCompHom_base]
    change (packageProjection U).IsHomLift
      ((packageProjection U).map (transportAlongAdjacentCompHom P f g h))
      (transportAlongAdjacentCompHom P f g h)
    infer_instance
  letI : (packageProjection U).IsHomLift
      (eqToHom (transportAlong_triple_point P f g h) : ExtInstHom
        (packagePoint (transportAlong P (f.comp (g.comp h))))
        (packagePoint
          (transportAlong (transportAlong (transportAlong P f) g) h)))
      (transportAlong_tripleFiberIso P f g h).iso.hom := by
    rw [← (transportAlong_tripleFiberIso P f g h).hom_base_eq]
    change (packageProjection U).IsHomLift
      ((packageProjection U).map
        (transportAlong_tripleFiberIso P f g h).iso.hom)
      (transportAlong_tripleFiberIso P f g h).iso.hom
    infer_instance
  apply CategoryTheory.Functor.IsStronglyCocartesian.ext
    (packageProjection U) (transportAlongHom P (f.comp (g.comp h))).base
    (transportAlongHom P (f.comp (g.comp h)))
    (eqToHom (transportAlong_triple_point P f g h))
  exact (transportAlongAdjacentCompHom_fac P f g h).trans
    (transportAlong_tripleFiberIso_hom_fac P f g h).symm

/--
The endpoint of transport along `h` after the direct `f ≫ g` transport agrees
with the endpoint of fully iterated transport.  This is the dependent alignment
used to transport the G-106/J0 binary comparison; it is derived from the fixed
exact morphisms and is not a supplied coherence certificate.
-/
theorem transportAlong_whiskeredComp_point {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    packagePoint (transportAlong (transportAlong P (f.comp g)) h) =
      packagePoint
        (transportAlong (transportAlong (transportAlong P f) g) h) :=
  rfl

/--
The G-106/J0 comparison for `f,g`, followed by the canonical lift along `h`.
This is the upper path whose factor through the first canonical `h`-lift
defines whiskering; both factors come from G-101 transport and lift uniqueness.
-/
noncomputable def transportAlongWhiskeredCompHom {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    PackageTotalHom
      (transportAlong P (f.comp g))
      (transportAlong (transportAlong (transportAlong P f) g) h) :=
  (transportAlong_compFiberIso P f g).iso.hom.comp
    (transportAlongHom (transportAlong (transportAlong P f) g) h)

/--
The upper path used to whisker the G-106/J0 binary comparison is strongly
cocartesian.  Its two factors are the G-101-derived fiber isomorphism and the
G-101 canonical lift; no cocartesian certificate occurs in the theorem input.
-/
theorem transportAlongWhiskeredCompHom_isStronglyCocartesian
    {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    (packageProjection U).IsStronglyCocartesian
      (transportAlongWhiskeredCompHom P f g h).base
      (transportAlongWhiskeredCompHom P f g h) := by
  letI : (packageProjection U).IsHomLift
      (transportAlong_compFiberIso P f g).iso.hom.base
      (transportAlong_compFiberIso P f g).iso.hom := by
    change (packageProjection U).IsHomLift
      ((packageProjection U).map
        (transportAlong_compFiberIso P f g).iso.hom)
      (transportAlong_compFiberIso P f g).iso.hom
    infer_instance
  letI : (packageProjection U).IsStronglyCocartesian
      (transportAlong_compFiberIso P f g).iso.hom.base
      (transportAlong_compFiberIso P f g).iso.hom :=
    CategoryTheory.Functor.IsStronglyCocartesian.of_iso
      (packageProjection U)
      (transportAlong_compFiberIso P f g).iso.hom.base
      (transportAlong_compFiberIso P f g).iso
  letI : (packageProjection U).IsStronglyCocartesian
      (transportAlongHom (transportAlong (transportAlong P f) g) h).base
      (transportAlongHom (transportAlong (transportAlong P f) g) h) :=
    transportAlongHom_isStronglyCocartesian
      (transportAlong (transportAlong P f) g) h
  change (packageProjection U).IsStronglyCocartesian
    ((transportAlong_compFiberIso P f g).iso.hom.base.comp
      (transportAlongHom (transportAlong (transportAlong P f) g) h).base)
    ((transportAlong_compFiberIso P f g).iso.hom.comp
      (transportAlongHom (transportAlong (transportAlong P f) g) h))
  exact CategoryTheory.Functor.IsStronglyCocartesian.comp (packageProjection U)

/--
The upper whiskering path lies over the base of the canonical `h`-lift followed
by endpoint identity.  This G-106/J0 equation discharges the base alignment
needed by G-101 lift uniqueness.
-/
theorem transportAlongWhiskeredCompHom_base_eq {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    (transportAlongHom (transportAlong P (f.comp g)) h).base.comp
        (eqToHom (transportAlong_whiskeredComp_point P f g h) : ExtInstHom
          (packagePoint (transportAlong (transportAlong P (f.comp g)) h))
          (packagePoint
            (transportAlong (transportAlong (transportAlong P f) g) h))) =
      (transportAlongWhiskeredCompHom P f g h).base := by
  change
    (transportAlongHom (transportAlong P (f.comp g)) h).base.comp
        (eqToHom (transportAlong_whiskeredComp_point P f g h) : ExtInstHom
          (packagePoint (transportAlong (transportAlong P (f.comp g)) h))
          (packagePoint
            (transportAlong (transportAlong (transportAlong P f) g) h))) =
      (transportAlong_compFiberIso P f g).iso.hom.base.comp
        (transportAlongHom (transportAlong (transportAlong P f) g) h).base
  rw [(transportAlong_compFiberIso P f g).hom_base_eq]
  apply ExtInstHom.ext
  apply ExactDoctrineHom.ext
  · rfl
  · apply Equiv.ext
    intro atom
    rfl

/--
The G-106/J0 whiskering of the binary comparison along `h`.  It is the unique
fiber isomorphism induced by the canonical `h`-lift and the upper path
`transportAlongWhiskeredCompHom`, hence carries no supplied comparison data.
-/
noncomputable def transportAlong_whiskeredCompFiberIso {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    PackageFiberInnerIso
      (transportAlong (transportAlong P (f.comp g)) h)
      (transportAlong (transportAlong (transportAlong P f) g) h)
      (transportAlong_whiskeredComp_point P f g h) := by
  letI : (packageProjection U).IsStronglyCocartesian
      (transportAlongWhiskeredCompHom P f g h).base
      (transportAlongWhiskeredCompHom P f g h) :=
    transportAlongWhiskeredCompHom_isStronglyCocartesian P f g h
  letI : (packageProjection U).IsStronglyCocartesian
      ((transportAlongHom (transportAlong P (f.comp g)) h).base.comp
        (eqToHom (transportAlong_whiskeredComp_point P f g h) : ExtInstHom
          (packagePoint (transportAlong (transportAlong P (f.comp g)) h))
          (packagePoint
            (transportAlong (transportAlong (transportAlong P f) g) h))))
      (transportAlongWhiskeredCompHom P f g h) := by
    rw [transportAlongWhiskeredCompHom_base_eq]
    exact transportAlongWhiskeredCompHom_isStronglyCocartesian P f g h
  exact transportAlong_liftUniqueUpToFiberIso
    (transportAlong P (f.comp g))
    (transportAlong (transportAlong (transportAlong P f) g) h)
    h (transportAlong_whiskeredComp_point P f g h)
    (transportAlongWhiskeredCompHom P f g h)

/--
The canonical `h`-lift followed by the G-106/J0 whiskered comparison equals
the comparison for `f,g` followed by the canonical `h`-lift.  This is the
defining naturality/factorization equation for the whiskered binary comparator.
-/
theorem transportAlong_whiskeredCompFiberIso_hom_fac {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    (transportAlongHom (transportAlong P (f.comp g)) h).comp
        (transportAlong_whiskeredCompFiberIso P f g h).iso.hom =
      transportAlongWhiskeredCompHom P f g h := by
  letI : (packageProjection U).IsStronglyCocartesian
      (transportAlongWhiskeredCompHom P f g h).base
      (transportAlongWhiskeredCompHom P f g h) :=
    transportAlongWhiskeredCompHom_isStronglyCocartesian P f g h
  letI : (packageProjection U).IsStronglyCocartesian
      ((transportAlongHom (transportAlong P (f.comp g)) h).base.comp
        (eqToHom (transportAlong_whiskeredComp_point P f g h) : ExtInstHom
          (packagePoint (transportAlong (transportAlong P (f.comp g)) h))
          (packagePoint
            (transportAlong (transportAlong (transportAlong P f) g) h))))
      (transportAlongWhiskeredCompHom P f g h) := by
    rw [transportAlongWhiskeredCompHom_base_eq]
    exact transportAlongWhiskeredCompHom_isStronglyCocartesian P f g h
  exact transportAlong_liftUniqueUpToFiberIso_hom_fac
    (transportAlong P (f.comp g))
    (transportAlong (transportAlong (transportAlong P f) g) h)
    h (transportAlong_whiskeredComp_point P f g h)
    (transportAlongWhiskeredCompHom P f g h)

/--
The left-associated direct composite and fully iterated transport have the same
endpoint point.  This G-106/J0 equality is computed from `f,g,h`; it only aligns
dependent endpoints and does not encode the desired coherence equation.
-/
theorem transportAlong_leftTriple_point {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    packagePoint (transportAlong P ((f.comp g).comp h)) =
      packagePoint
        (transportAlong (transportAlong (transportAlong P f) g) h) :=
  rfl

/--
The left-associated G-106/J0 adjacent path: first compare transport along
`(f ≫ g) ≫ h` with two-step transport, then whisker the `f,g` comparison along
`h`.  Every comparison is generated by G-101 lift uniqueness.
-/
noncomputable def transportAlongLeftAdjacentCompHom {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    PackageTotalHom
      (transportAlong P ((f.comp g).comp h))
      (transportAlong (transportAlong (transportAlong P f) g) h) :=
  (transportAlong_compFiberIso P (f.comp g) h).iso.hom.comp
    (transportAlong_whiskeredCompFiberIso P f g h).iso.hom

/--
The left-associated G-106/J0 adjacent path lies over endpoint identity.  This
base equation is derived from the two G-101-generated fiber isomorphisms.
-/
theorem transportAlongLeftAdjacentCompHom_base {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    (transportAlongLeftAdjacentCompHom P f g h).base =
      (eqToHom (transportAlong_leftTriple_point P f g h) : ExtInstHom
        (packagePoint (transportAlong P ((f.comp g).comp h)))
        (packagePoint
          (transportAlong (transportAlong (transportAlong P f) g) h))) := by
  change
    (transportAlong_compFiberIso P (f.comp g) h).iso.hom.base.comp
        (transportAlong_whiskeredCompFiberIso P f g h).iso.hom.base = _
  rw [(transportAlong_compFiberIso P (f.comp g) h).hom_base_eq]
  rw [(transportAlong_whiskeredCompFiberIso P f g h).hom_base_eq]
  apply ExtInstHom.ext
  apply ExactDoctrineHom.ext
  · rfl
  · apply Equiv.ext
    intro atom
    rfl

/--
The left-associated direct lift followed by the left G-106/J0 adjacent path is
the fully iterated lift.  The proof uses both binary factorization equations,
including the whiskered comparison, rather than a supplied coherence field.
-/
theorem transportAlongLeftAdjacentCompHom_fac {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    (transportAlongHom P ((f.comp g).comp h)).comp
        (transportAlongLeftAdjacentCompHom P f g h) =
      transportAlongTripleHom P f g h := by
  change
    (transportAlongHom P ((f.comp g).comp h)) ≫
        ((transportAlong_compFiberIso P (f.comp g) h).iso.hom ≫
          (transportAlong_whiskeredCompFiberIso P f g h).iso.hom) = _
  rw [← Category.assoc]
  change
    ((transportAlongHom P ((f.comp g).comp h)).comp
        (transportAlong_compFiberIso P (f.comp g) h).iso.hom).comp
      (transportAlong_whiskeredCompFiberIso P f g h).iso.hom = _
  rw [transportAlong_compFiberIso_hom_fac]
  change
    ((transportAlongHom P (f.comp g)) ≫
      (transportAlongHom (transportAlong P (f.comp g)) h)) ≫
      (transportAlong_whiskeredCompFiberIso P f g h).iso.hom = _
  rw [Category.assoc]
  change
    (transportAlongHom P (f.comp g)).comp
      ((transportAlongHom (transportAlong P (f.comp g)) h).comp
        (transportAlong_whiskeredCompFiberIso P f g h).iso.hom) = _
  rw [transportAlong_whiskeredCompFiberIso_hom_fac]
  change
    (transportAlongHom P (f.comp g)) ≫
      ((transportAlong_compFiberIso P f g).iso.hom ≫
        (transportAlongHom (transportAlong (transportAlong P f) g) h)) = _
  rw [← Category.assoc]
  change
    ((transportAlongHom P (f.comp g)).comp
      (transportAlong_compFiberIso P f g).iso.hom).comp
      (transportAlongHom (transportAlong (transportAlong P f) g) h) = _
  rw [transportAlong_compFiberIso_hom_fac]
  rfl

/--
Right- and left-associated direct composites have the same pointed endpoint.
This G-106/J0 equality is the base-category associativity cast, derived from
`f,g,h` and used only to align the domains of the two adjacent paths.
-/
theorem transportAlong_assoc_point {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    packagePoint (transportAlong P (f.comp (g.comp h))) =
      packagePoint (transportAlong P ((f.comp g).comp h)) :=
  rfl

/--
The left-associated canonical lift lies over the right-associated lift followed
by the G-106/J0 associativity cast.  This base equation is computed from the
exact morphisms and supplies no comparison or coherence conclusion.
-/
theorem transportAlongAssocHom_base_eq {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    (transportAlongHom P (f.comp (g.comp h))).base.comp
        (eqToHom (transportAlong_assoc_point P f g h) : ExtInstHom
          (packagePoint (transportAlong P (f.comp (g.comp h))))
          (packagePoint (transportAlong P ((f.comp g).comp h)))) =
      (transportAlongHom P ((f.comp g).comp h)).base := by
  apply ExtInstHom.ext
  apply ExactDoctrineHom.ext
  · rfl
  · apply Equiv.ext
    intro atom
    rfl

/--
The G-106/J0 package-level associativity alignment between direct transports.
It is generated by G-101 uniqueness from the two canonical lifts; the equality
argument aligns only pointed doctrines and does not contain the desired path
coherence.
-/
noncomputable def transportAlong_assocFiberIso {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    PackageFiberInnerIso
      (transportAlong P (f.comp (g.comp h)))
      (transportAlong P ((f.comp g).comp h))
      (transportAlong_assoc_point P f g h) := by
  letI : (packageProjection U).IsStronglyCocartesian
      (transportAlongHom P ((f.comp g).comp h)).base
      (transportAlongHom P ((f.comp g).comp h)) :=
    transportAlongHom_isStronglyCocartesian P ((f.comp g).comp h)
  letI : (packageProjection U).IsStronglyCocartesian
      ((transportAlongHom P (f.comp (g.comp h))).base.comp
        (eqToHom (transportAlong_assoc_point P f g h) : ExtInstHom
          (packagePoint (transportAlong P (f.comp (g.comp h))))
          (packagePoint (transportAlong P ((f.comp g).comp h)))))
      (transportAlongHom P ((f.comp g).comp h)) := by
    rw [transportAlongAssocHom_base_eq]
    exact transportAlongHom_isStronglyCocartesian P ((f.comp g).comp h)
  exact transportAlong_liftUniqueUpToFiberIso P
    (transportAlong P ((f.comp g).comp h))
    (f.comp (g.comp h)) (transportAlong_assoc_point P f g h)
    (transportAlongHom P ((f.comp g).comp h))

/--
The right-associated direct lift followed by the G-106/J0 associativity
alignment is the left-associated direct lift.  This is the G-101 universal
factorization equation for `transportAlong_assocFiberIso`.
-/
theorem transportAlong_assocFiberIso_hom_fac {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    (transportAlongHom P (f.comp (g.comp h))).comp
        (transportAlong_assocFiberIso P f g h).iso.hom =
      transportAlongHom P ((f.comp g).comp h) := by
  letI : (packageProjection U).IsStronglyCocartesian
      (transportAlongHom P ((f.comp g).comp h)).base
      (transportAlongHom P ((f.comp g).comp h)) :=
    transportAlongHom_isStronglyCocartesian P ((f.comp g).comp h)
  letI : (packageProjection U).IsStronglyCocartesian
      ((transportAlongHom P (f.comp (g.comp h))).base.comp
        (eqToHom (transportAlong_assoc_point P f g h) : ExtInstHom
          (packagePoint (transportAlong P (f.comp (g.comp h))))
          (packagePoint (transportAlong P ((f.comp g).comp h)))))
      (transportAlongHom P ((f.comp g).comp h)) := by
    rw [transportAlongAssocHom_base_eq]
    exact transportAlongHom_isStronglyCocartesian P ((f.comp g).comp h)
  exact transportAlong_liftUniqueUpToFiberIso_hom_fac P
    (transportAlong P ((f.comp g).comp h))
    (f.comp (g.comp h)) (transportAlong_assoc_point P f g h)
    (transportAlongHom P ((f.comp g).comp h))

/--
The left G-106/J0 adjacent path after aligning its direct-composite source with
the right-associated source.  Its two factors are independently generated by
G-101 lift uniqueness.
-/
noncomputable def transportAlongLeftAlignedCompHom {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    PackageTotalHom
      (transportAlong P (f.comp (g.comp h)))
      (transportAlong (transportAlong (transportAlong P f) g) h) :=
  (transportAlong_assocFiberIso P f g h).iso.hom.comp
    (transportAlongLeftAdjacentCompHom P f g h)

/--
The aligned left G-106/J0 path lies over endpoint identity.  The equation is
derived from the associativity alignment and the left adjacent path.
-/
theorem transportAlongLeftAlignedCompHom_base {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    (transportAlongLeftAlignedCompHom P f g h).base =
      (eqToHom (transportAlong_triple_point P f g h) : ExtInstHom
        (packagePoint (transportAlong P (f.comp (g.comp h))))
        (packagePoint
          (transportAlong (transportAlong (transportAlong P f) g) h))) := by
  change
    (transportAlong_assocFiberIso P f g h).iso.hom.base.comp
      (transportAlongLeftAdjacentCompHom P f g h).base = _
  rw [(transportAlong_assocFiberIso P f g h).hom_base_eq]
  rw [transportAlongLeftAdjacentCompHom_base]
  apply ExtInstHom.ext
  apply ExactDoctrineHom.ext
  · rfl
  · apply Equiv.ext
    intro atom
    rfl

/--
The right-associated direct lift followed by the aligned left G-106/J0 path is
the fully iterated lift.  Both factorization stages are consequences of G-101
lift uniqueness.
-/
theorem transportAlongLeftAlignedCompHom_fac {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    (transportAlongHom P (f.comp (g.comp h))).comp
        (transportAlongLeftAlignedCompHom P f g h) =
      transportAlongTripleHom P f g h := by
  change
    (transportAlongHom P (f.comp (g.comp h))) ≫
      ((transportAlong_assocFiberIso P f g h).iso.hom ≫
        transportAlongLeftAdjacentCompHom P f g h) = _
  rw [← Category.assoc]
  change
    ((transportAlongHom P (f.comp (g.comp h))).comp
      (transportAlong_assocFiberIso P f g h).iso.hom).comp
      (transportAlongLeftAdjacentCompHom P f g h) = _
  rw [transportAlong_assocFiberIso_hom_fac]
  exact transportAlongLeftAdjacentCompHom_fac P f g h

/--
G-106/J0 adjacent-composition coherence.  After the base associativity cast,
the right-associated binary-comparison path equals the left-associated path
formed from `alpha_(f≫g),h` and the G-101-induced whiskering of `alpha_f,g`.
No comparison, whiskering, or coherence certificate is accepted as input.
-/
theorem transportAlong_comp_coherence {U : AtomCarrier.{u}}
    (P : AATCorePackage U)
    {D E F : ExtractionDoctrine U}
    (f : ExactDoctrineHom P.reading.doctrine D)
    (g : ExactDoctrineHom D E)
    (h : ExactDoctrineHom E F) :
    transportAlongAdjacentCompHom P f g h =
      transportAlongLeftAlignedCompHom P f g h := by
  letI : (packageProjection U).IsStronglyCocartesian
      (transportAlongHom P (f.comp (g.comp h))).base
      (transportAlongHom P (f.comp (g.comp h))) :=
    transportAlongHom_isStronglyCocartesian P (f.comp (g.comp h))
  letI : (packageProjection U).IsHomLift
      (eqToHom (transportAlong_triple_point P f g h) : ExtInstHom
        (packagePoint (transportAlong P (f.comp (g.comp h))))
        (packagePoint
          (transportAlong (transportAlong (transportAlong P f) g) h)))
      (transportAlongAdjacentCompHom P f g h) := by
    rw [← transportAlongAdjacentCompHom_base]
    change (packageProjection U).IsHomLift
      ((packageProjection U).map (transportAlongAdjacentCompHom P f g h))
      (transportAlongAdjacentCompHom P f g h)
    infer_instance
  letI : (packageProjection U).IsHomLift
      (eqToHom (transportAlong_triple_point P f g h) : ExtInstHom
        (packagePoint (transportAlong P (f.comp (g.comp h))))
        (packagePoint
          (transportAlong (transportAlong (transportAlong P f) g) h)))
      (transportAlongLeftAlignedCompHom P f g h) := by
    rw [← transportAlongLeftAlignedCompHom_base]
    change (packageProjection U).IsHomLift
      ((packageProjection U).map (transportAlongLeftAlignedCompHom P f g h))
      (transportAlongLeftAlignedCompHom P f g h)
    infer_instance
  apply CategoryTheory.Functor.IsStronglyCocartesian.ext
    (packageProjection U) (transportAlongHom P (f.comp (g.comp h))).base
    (transportAlongHom P (f.comp (g.comp h)))
    (eqToHom (transportAlong_triple_point P f g h))
  exact (transportAlongAdjacentCompHom_fac P f g h).trans
    (transportAlongLeftAlignedCompHom_fac P f g h).symm

end AAT.AG.TransportCoherence

#assert_standard_axioms_only AAT.AG.TransportCoherence
