import ResearchLean.AG.VisibleCycleReflection.FiniteTopologyTable
import ResearchLean.AG.VisibleCycleReflection.PrimitiveTableValidation
import ResearchLean.AG.VisibleCycleReflection.ActualCounterinput
import Formal.Util.AssertStandardAxioms

/-!
# Finite-table decoding into the same actual AAT input

## Implementation notes

A checked table generates the actual primitive presentation, adequate reading,
topology, connected geometric cover, and independent target supports. Actual
intersection cells and visibility are compared with the finite enumerations.
The accepted comparison, all-input reflection, and affine gluing APIs apply to
these same decoded objects. Checked proofs are generated by the raw finite
validator; they are not extra fields of the raw input.
-/

noncomputable section
open CategoryTheory TopologicalSpace Opposite
namespace AAT.AG.VisibleCycleReflection.Graph
universe u
/-- Public unoriented-edge evaluation retains the sorted endpoint pair. -/
@[simp] theorem unoriented_val {V : Type u} [LinearOrder V] (G : SimpleGraph V)
    (e : Edge G) : unoriented G e = s(e.1.1,e.1.2) := rfl
end AAT.AG.VisibleCycleReflection.Graph
namespace AAT.AG.VisibleCycleReflection.GeometricCover
universe u
/-- Public graph/nerve inverse evaluation retains the original ordered pair. -/
@[simp] theorem graphEdgeEquiv_symm_val {X I : Type u} [TopologicalSpace X] [LinearOrder I]
    (K : GeometricCover X I) (e : Graph.Edge K.graph) :
    (K.graphEdgeEquiv.symm e).1 = e.1 := rfl
end AAT.AG.VisibleCycleReflection.GeometricCover
namespace AAT.AG.VisibleCycleReflection.FiniteInputTable
open CanonicalResolution ResolutionInvariance ObstructionDiagnosticBridge
variable (T : FiniteInputTable)

/-- The complete checked predicate includes finite reading surjectivity. -/
theorem validSurjective (h : T.Valid) : T.SurjectiveReading := h.1
/-- The complete checked predicate includes finite reading adequacy. -/
theorem validAdequate (h : T.Valid) : T.AdequateReading := h.2.1
/-- The complete checked predicate includes primitive label preservation. -/
theorem validLabelPreserving (h : T.Valid) : T.LabelPreserving := h.2.2.1
/-- The complete checked predicate includes generated primitive Rq. -/
theorem validRelationReflecting (h : T.Valid) : T.RelationReflecting := h.2.2.2.1
/-- The complete checked predicate includes the entire finite topology check. -/
theorem validTopology (h : T.Valid) : T.TopologyValid := h.2.2.2.2.1
/-- The complete checked predicate includes the entire geometric T0 check. -/
theorem validGeometry (h : T.Valid) : T.GeometryValid := h.2.2.2.2.2.1
/-- The complete checked predicate includes independent nonempty target columns. -/
theorem validTarget (h : T.Valid) : T.TargetValid := h.2.2.2.2.2.2

/-- The actual reading is decoded from the same source/target column. -/
def actualReading (h : T.Valid) : Reading T.Source := T.reading (T.validSurjective h)

/-- The actual primitive relation is decoded from the same Boolean table. -/
def actualPresentation (h : T.Valid) : GeneratorPresentation T.laws :=
  T.presentation (T.validLabelPreserving h)

/-- The actual geometric topology is generated from the same finite open family. -/
def actualTopology (h : T.Valid) : TopologicalSpace T.Point := T.topology (T.validTopology h)

/-- The actual connected cover is generated from the finite geometric checks. -/
def actualGeometry (h : T.Valid) :
    @GeometricCover T.Point T.Chart (T.actualTopology h) inferInstance :=
  T.geometricCover (T.validTopology h) (T.validGeometry h)

/-- The actual target support remains the independent finite target column. -/
def actualTarget (h : T.Valid) (i : T.Chart) : Set (T.actualReading h).Target :=
  (T.target i : Set (Fin T.targetCount))

/-- Public point membership in the actual target support. -/
@[simp] theorem actualTarget_mem (h : T.Valid) (i : T.Chart) (t : Fin T.targetCount) :
    t ∈ T.actualTarget h i ↔ t ∈ T.target i := Iff.rfl

/-- Actual target support is exactly the finite column as a subset. -/
@[simp] theorem actualTarget_coe (h : T.Valid) (i : T.Chart) :
    T.actualTarget h i = (T.target i : Set (Fin T.targetCount)) := rfl

/-- Target nonemptiness is generated by the finite target check. -/
theorem actualTarget_nonempty (h : T.Valid) (i : T.Chart) : (T.actualTarget h i).Nonempty :=
  Finset.coe_nonempty.mpr (T.validTarget h i)

/-- Actual reading adequacy is proved from the finite source-fiber check. -/
theorem actualAdequate (h : T.Valid) : T.laws.Adequate (T.actualReading h) :=
  (T.adequate_iff (T.validSurjective h)).mp (T.validAdequate h)

/-- Actual Rq is proved from finite reachability in the original relation graph. -/
theorem actualReflectionCondition (h : T.Valid) : (T.actualPresentation h).ReflectionCondition :=
  (T.reflectionCondition_iff (T.validLabelPreserving h)).mp (T.validRelationReflecting h)

/-- The actual presentation retains exactly the Boolean primitive relations of the same table. -/
theorem actualPresentation_relation (h : T.Valid) (g k : T.Generator) :
    (T.actualPresentation h).relation g k ↔ T.relation g k = true :=
  T.presentation_relation (T.validLabelPreserving h) g k

/-- The actual reading retains the finite reading column at every source. -/
@[simp] theorem actualReading_read (h : T.Valid) (s : T.Source) :
    (T.actualReading h).read s = T.read s := rfl

/-- The actual topology has exactly the finite input's open family. -/
theorem actualTopology_isOpen_iff (h : T.Valid) (U : Finset T.Point) :
    @IsOpen T.Point (T.actualTopology h) (U : Set T.Point) ↔ U ∈ T.opens :=
  T.topology_finset_isOpen_iff (T.validTopology h) U

/-- The actual chart support is exactly its original geometric point column. -/
theorem actualGeometry_patch_coe (h : T.Valid) (i : T.Chart) :
    letI : TopologicalSpace T.Point := T.actualTopology h
    ((T.actualGeometry h).patch i : Set T.Point) = (T.chart i : Set T.Point) :=
  T.patch_coe (T.validTopology h) (T.validGeometry h) i

/-- All actual nerve cells and their orientation agree with the raw intersection test. -/
theorem actualGeometry_edge_iff (h : T.Valid) (i j : T.Chart) :
    letI : TopologicalSpace T.Point := T.actualTopology h
    i < j ∧ (((T.actualGeometry h).patch i ⊓ (T.actualGeometry h).patch j : Opens T.Point) : Set T.Point).Nonempty ↔
      i < j ∧ (T.chart i ∩ T.chart j).Nonempty :=
  T.geometricCover_edge_iff (T.validTopology h) (T.validGeometry h) i j

/-- The complete actual geometric graph is the same finite raw graph. -/
theorem actualGeometry_graph (h : T.Valid) :
    letI : TopologicalSpace T.Point := T.actualTopology h
    (T.actualGeometry h).graph = T.rawGraph := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  ext i j
  rw [GeometricCover.graph_adj,T.rawGraph_adj]
  rw [Opens.coe_inf,T.actualGeometry_patch_coe,T.actualGeometry_patch_coe,
    ← Finset.coe_inter,Finset.coe_nonempty]

/-- Every actual ordered edge is one raw intersection cell, in both directions. -/
def actualRawEdgeEquiv (h : T.Valid) :
    letI : TopologicalSpace T.Point := T.actualTopology h
    (T.actualGeometry h).Edge ≃ T.RawEdge := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  exact {
    toFun e := ⟨e.1,(T.actualGeometry_edge_iff h e.1.1 e.1.2).mp e.2⟩
    invFun e := ⟨e.1,(T.actualGeometry_edge_iff h e.1.1 e.1.2).mpr e.2⟩
    left_inv e := Subtype.ext rfl
    right_inv e := Subtype.ext rfl
  }

/-- Raw edge identification preserves both original endpoint indices. -/
theorem actualRawEdgeEquiv_val (h : T.Valid)
    (e : letI : TopologicalSpace T.Point := T.actualTopology h; (T.actualGeometry h).Edge) :
    (T.actualRawEdgeEquiv h e).1 = e.1 := rfl

/-- Every actual source-generated label occurs in the explicit finite raw label enumeration. -/
theorem rawLabels_complete_actual (l : LawValueLabel T.laws) :
    (T.generatedLabelEquiv l).1 ∈ T.rawLabels := by
  obtain ⟨s,hs⟩ := l.generated
  apply (T.mem_rawLabels_iff _).mpr
  exact ⟨(l.law,s),congrArg (Sigma.mk l.law) hs⟩

/-- Every enumerated raw label denotes a label of the same actual primitive Law family. -/
theorem rawLabels_sound_actual (r : T.RawLabel) (hr : r ∈ T.rawLabels) :
    ∃ l : LawValueLabel T.laws, (T.generatedLabelEquiv l).1 = r := by
  obtain ⟨g,hg⟩ := (T.mem_rawLabels_iff r).mp hr
  exact ⟨PrimitiveGenerator.label T.laws g,hg⟩

/-- Source-level interpretation of the decoded Law descent uses the same evaluation column. -/
theorem actualLawDescend_read (h : T.Valid) (l : LawValueLabel T.laws) (s : T.Source) :
    lawDescend T.laws (T.actualReading h) (T.actualAdequate h) l.law (T.read s) =
      T.eval l.law s :=
  lawDescend_commutes T.laws (T.actualReading h) (T.actualAdequate h) l.law s

/-- Same-target raw support is exactly the actual Law support on any finite target column. -/
theorem rawSupport_iff_actual (h : T.Valid) (l : LawValueLabel T.laws)
    (S : Finset (Fin T.targetCount)) :
    (∃ t ∈ S, ∃ s : T.Source, T.read s = t ∧ T.eval l.law s = l.value) ↔
      ∃ t ∈ (S : Set (Fin T.targetCount)),
        lawDescend T.laws (T.actualReading h) (T.actualAdequate h) l.law t = l.value := by
  constructor
  · rintro ⟨t,ht,s,hs,hv⟩
    refine ⟨t,ht,?_⟩
    rw [← hs,T.actualLawDescend_read]
    exact hv
  · rintro ⟨t,ht,hv⟩
    obtain ⟨s,hs⟩ := T.validSurjective h t
    refine ⟨t,ht,s,hs,?_⟩
    rw [← T.actualLawDescend_read h l s,hs]
    exact hv

/-- The decoded actual vertex visibility is precisely the raw finite predicate. -/
theorem vertexVisible_iff_actual (h : T.Valid) (l : LawValueLabel T.laws) (i : T.Chart) :
    letI : TopologicalSpace T.Point := T.actualTopology h
    T.VertexVisible (T.generatedLabelEquiv l).1 i ↔
      i ∈ (T.actualGeometry h).visibleVertexSet (T.actualTarget h)
        (T.actualTarget_nonempty h) (T.actualAdequate h) l := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  exact T.rawSupport_iff_actual h l (T.target i)

/-- Ordered actual graph edges identify with the same raw geometric intersection table. -/
def actualGraphRawEdgeEquiv (h : T.Valid) :
    letI : TopologicalSpace T.Point := T.actualTopology h
    Graph.Edge (T.actualGeometry h).graph ≃ T.RawEdge := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  exact (T.actualGeometry h).graphEdgeEquiv.symm.trans (T.actualRawEdgeEquiv h)

/-- The graph/raw correspondence preserves both declared endpoint indices. -/
theorem actualGraphRawEdgeEquiv_val (h : T.Valid)
    (e : letI : TopologicalSpace T.Point := T.actualTopology h;
      Graph.Edge (T.actualGeometry h).graph) :
    (T.actualGraphRawEdgeEquiv h e).1 = e.1 := rfl

/-- Raw edge visibility requires the exact same target intersection as the actual diagnostic. -/
theorem edgeVisible_iff_actual (h : T.Valid) (l : LawValueLabel T.laws)
    (e : letI : TopologicalSpace T.Point := T.actualTopology h;
      Graph.Edge (T.actualGeometry h).graph) :
    letI : TopologicalSpace T.Point := T.actualTopology h
    T.EdgeVisible (T.generatedLabelEquiv l).1 (T.actualGraphRawEdgeEquiv h e).1 ↔
      e ∈ (T.actualGeometry h).visibleEdgeSet (T.actualTarget h)
        (T.actualTarget_nonempty h) (T.actualAdequate h) l := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  change _ ↔ ∃ t, t ∈ ((T.actualGeometry h).supportedNerve (T.actualTarget h)
    (T.actualTarget_nonempty h)).edgeSupport ((T.actualGeometry h).graphEdgeEquiv.symm e) ∧ _
  rw [GeometricCover.supportedNerve_edgeSupport]
  simp only [GeometricCover.graphEdgeEquiv_symm_val,T.actualTarget_coe]
  rw [← Finset.coe_inter]
  rw [T.actualGraphRawEdgeEquiv_val]
  exact T.rawSupport_iff_actual h l (T.target e.1.1 ∩ T.target e.1.2)

/-- All local transitions and states of the decoded original AAT Cech cover, with no supplied certificate. -/
abbrev ActualLocalData (h : T.Valid) : Type :=
  letI : TopologicalSpace T.Point := T.actualTopology h
  GeneratorPresentation.ActualCechAffineLocalData (T.actualPresentation h)
    ((T.actualGeometry h).actualCechCover (T.actualPresentation h)
      (T.actualTarget h) (T.actualTarget_nonempty h))

/-- The same decoded target-supported complete nerve, retaining all actual intersection cells. -/
abbrev actualNerve (h : T.Valid) :
    letI : TopologicalSpace T.Point := T.actualTopology h
    TargetSupportedNerve (T.actualReading h) := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  exact (T.actualGeometry h).supportedNerve (T.actualTarget h) (T.actualTarget_nonempty h)

/-- A's coefficient-change/visible-restriction factorization for every actual input of this table. -/
theorem actual_input_factorization (h : T.Valid) (x : T.ActualLocalData h)
    (l : LawValueLabel T.laws) :
    letI : TopologicalSpace T.Point := T.actualTopology h
    (DirectSum.linearEquivFunOnFintype ℚ (LawValueLabel T.laws)
      (fun a => VisibleGraphH1 (T.actualNerve h) (T.actualAdequate h) a)
      (diagnosticVisibleH1Equiv (T.actualNerve h) (T.actualAdequate h)
        (x.diagnosticClass (T.actualAdequate h)))) l =
      rationalRestrictionH1 (T.actualNerve h) (T.actualAdequate h) l
        (integerToRationalH1 (T.actualNerve h).nerve (LawValueLabel T.laws)
          (actualIntegralH1Equiv (T.actualPresentation h)
            ((T.actualGeometry h).actualCechCover (T.actualPresentation h)
              (T.actualTarget h) (T.actualTarget_nonempty h)) (T.actualReflectionCondition h)
            x.existingDescentAdditiveClass)) := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  exact (T.actualGeometry h).input_local_data_factorization (T.actualPresentation h)
    (T.actualTarget h) (T.actualTarget_nonempty h) (T.actualReflectionCondition h)
    (T.actualAdequate h) x l

/-- The all-input reflection property of the same decoded actual obstruction and diagnostic. -/
def ActualReflects (h : T.Valid) : Prop :=
  ∀ x : T.ActualLocalData h,
    x.diagnosticClass (T.actualAdequate h) = 0 ↔ x.existingDescentAdditiveClass = 0

/-- B3 for the same decoded actual graph and independently supplied target columns. -/
def ActualNonbridgeVisible (h : T.Valid) : Prop :=
  letI : TopologicalSpace T.Point := T.actualTopology h
  ∀ l e, ¬ (T.actualGeometry h).graph.IsBridge
    (Graph.unoriented (T.actualGeometry h).graph e) →
      T.EdgeVisible (T.generatedLabelEquiv l).1 (T.actualGraphRawEdgeEquiv h e).1

/-- The finite-table decoding applies accepted all-input B1 iff B3 to the same actual AAT data. -/
theorem actual_reflection_iff_nonbridge_visible (h : T.Valid) :
    T.ActualReflects h ↔ T.ActualNonbridgeVisible h := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  refine ((T.actualGeometry h).input_reflection_iff_nonbridge_visible
    (T.actualTarget h) (T.actualTarget_nonempty h) (T.actualPresentation h)
    (T.actualReflectionCondition h) (T.actualAdequate h)).trans ?_
  apply forall_congr'
  intro l
  apply forall_congr'
  intro e
  exact imp_congr_right fun _ => (T.edgeVisible_iff_actual h l e).symm

/-- The actual chart cover is admissible on the primitive Atom site generated by this table. -/
theorem actual_coverage_admissible (h : T.Valid) :
    letI : TopologicalSpace T.Point := T.actualTopology h
    Site.AdmissibleCover (OpenSupport.coverageRequirements (T.actualPresentation h))
      (OpenSupport.overlap (T.actualPresentation h))
      (OpenSupport.coverageFamily (T.actualPresentation h) (T.actualGeometry h).patch) := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  letI : Nonempty T.Chart := ⟨⟨0,(T.validGeometry h).1⟩⟩
  exact (T.actualGeometry h).coverage_admissible (T.actualPresentation h)

/-- B3 connects diagnostic zero to actual AAT global affine states for every decoded local input. -/
theorem actual_diagnostic_zero_iff_global_state (h : T.Valid)
    (hv : T.ActualNonbridgeVisible h) (x : T.ActualLocalData h) :
    letI : TopologicalSpace T.Point := T.actualTopology h
    x.diagnosticClass (T.actualAdequate h) = 0 ↔
      Nonempty (((T.actualGeometry h).aatStateSheaf (T.actualPresentation h)
        (T.actualTarget h) (T.actualTarget_nonempty h) x.transition).carrier.obj
        (op ((T.actualGeometry h).actualCechCover (T.actualPresentation h)
          (T.actualTarget h) (T.actualTarget_nonempty h)).base)) := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  apply (T.actualGeometry h).diagnostic_zero_iff_aat_global_state
    (T.actualPresentation h) (T.actualTarget h) (T.actualTarget_nonempty h)
    (T.actualAdequate h) (T.actualReflectionCondition h)
  intro l e he
  exact (T.edgeVisible_iff_actual h l e).mp (hv l e he)

/-- The finite-table B3 hypothesis constructs an actual repair and the unique AAT gluing of p-n. -/
theorem actual_repair_and_gluing (h : T.Valid) (hv : T.ActualNonbridgeVisible h)
    (x : T.ActualLocalData h) (hx : x.diagnosticClass (T.actualAdequate h) = 0) :
    letI : TopologicalSpace T.Point := T.actualTopology h
    let P := T.actualPresentation h
    let K := T.actualGeometry h
    let target := T.actualTarget h
    let hne := T.actualTarget_nonempty h
    ∃ n : (P.faceEmptyCechComplex (K.actualCechCover P target hne)).Cn 0,
      (P.faceEmptyCechComplex (K.actualCechCover P target hne)).d 0 n = x.actualMismatch ∧
        ∃! s : (K.aatStateSheaf P target hne x.transition).carrier.obj
          (op (K.actualCechCover P target hne).base),
          ∀ i, (K.actualAffineAtlas P target hne x.transition).localTrivialization i le_rfl
            (K.aatChartStateEquiv P target hne x.transition i
              ((K.aatStateSheaf P target hne x.transition).carrier.map
                ((K.actualCechCover P target hne).inclusion i).op s)) =
                  K.actualChartCoordinates P target hne (x.localState-n) i := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  apply (T.actualGeometry h).exists_actual_repair_and_aat_gluing
    (T.actualPresentation h) (T.actualTarget h) (T.actualTarget_nonempty h)
    (T.actualAdequate h) (T.actualReflectionCondition h) _ x hx
  intro l e he
  exact (T.edgeVisible_iff_actual h l e).mp (hv l e he)

end AAT.AG.VisibleCycleReflection.FiniteInputTable
#assert_standard_axioms_only AAT.AG.VisibleCycleReflection
