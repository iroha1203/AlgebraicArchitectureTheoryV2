import ResearchLean.AG.VisibleCycleReflection.ActualTableDecode
import ResearchLean.AG.VisibleCycleReflection.FiniteReflectionSearch
import Formal.Util.AssertStandardAxioms

/-!
# Finite search interpreted in the same original AAT input

## Implementation notes

The serialized label, edge, integral transition and zero state are interpreted by
the actual Cech normalization of the same validated table. Transport along the
proved raw/actual graph equality retains the computed cycle; no new path is
selected during semantic decoding.
-/

noncomputable section
namespace AAT.AG.VisibleCycleReflection.Graph
open SimpleGraph
universe u
variable {V : Type u} [LinearOrder V] {G H : SimpleGraph V}

/-- Transport the same oriented edge along a proved equality of graphs. -/
def transportEdge (h : G = H) (e : Edge G) : Edge H := h ▸ e
/-- Graph transport preserves the original ordered endpoint pair. -/
@[simp] theorem transportEdge_val (h : G = H) (e : Edge G) :
    (transportEdge h e).val = e.val := by cases h; rfl
/-- Graph transport preserves the underlying unoriented edge. -/
@[simp] theorem transportEdge_unoriented (h : G = H) (e : Edge G) :
    unoriented H (transportEdge h e) = unoriented G e := by cases h; rfl
/-- Graph transport preserves bridge status of the same edge. -/
theorem transportEdge_bridge (h : G = H) (e : Edge G) :
    H.IsBridge (unoriented H (transportEdge h e)) ↔ G.IsBridge (unoriented G e) := by cases h; rfl
/-- Transport a computed walk without selecting a different walk. -/
def transportWalk (h : G = H) {a b : V} (p : G.Walk a b) : H.Walk a b := h ▸ p
omit [LinearOrder V] in
/-- Walk transport retains simple-cycle status and the complete edge list. -/
theorem transportWalk_cycle (h : G = H) {a : V} (p : G.Walk a a) :
    (transportWalk h p).IsCycle ↔ p.IsCycle := by cases h; rfl
omit [LinearOrder V] in
/-- The edge list remains exactly the generated edge list under graph transport. -/
@[simp] theorem transportWalk_edges (h : G = H) {a b : V} (p : G.Walk a b) :
    (transportWalk h p).edges = p.edges := by cases h; rfl
/-- The signed chain coefficient is unchanged by graph transport. -/
theorem transportWalk_coefficient [Fintype V] (h : G = H) {a b : V} (p : G.Walk a b)
    (e : Edge G) : walkChain H (transportWalk h p) (transportEdge h e) = walkChain G p e := by
  cases h; rfl
end AAT.AG.VisibleCycleReflection.Graph

namespace AAT.AG.VisibleCycleReflection.FiniteInputTable
open CanonicalResolution ResolutionInvariance ObstructionDiagnosticBridge
variable (T : FiniteInputTable)

/-- A listed raw label is generated by a source in its exact Law fiber. -/
theorem rawLabel_generated (r : T.GeneratedRawLabel) : ∃ s : T.Source, T.eval r.val.1 s = r.val.2 := by
  obtain ⟨g,hg⟩ := (T.mem_rawLabels_iff r.val).mp r.property
  rw [← hg]
  exact ⟨g.2,rfl⟩

/-- Decode a generated label code into the original Law-value label, retaining its generation proof. -/
def actualLabel (r : T.GeneratedRawLabel) : LawValueLabel T.laws :=
  ⟨r.val.1,r.val.2,T.rawLabel_generated r⟩

/-- Actual label decoding preserves the serialized Law/value code. -/
@[simp] theorem actualLabel_code (r : T.GeneratedRawLabel) :
    (T.generatedLabelEquiv (T.actualLabel r)).val = r.val := rfl

/-- Decode the same raw edge using the proved equality of actual and raw geometric graphs. -/
def actualEdge (h : T.Valid) (e : T.RawEdge) :
    letI : TopologicalSpace T.Point := T.actualTopology h
    Graph.Edge (T.actualGeometry h).graph := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  exact Graph.transportEdge (T.actualGeometry_graph h).symm (T.rawGraphEdge e)

/-- Decoding a raw edge and then reading its raw intersection cell returns that same cell. -/
@[simp] theorem actualEdge_raw (h : T.Valid) (e : T.RawEdge) :
    T.actualGraphRawEdgeEquiv h (T.actualEdge h e) = e := by
  apply Subtype.ext
  rw [T.actualGraphRawEdgeEquiv_val]
  exact Graph.transportEdge_val _ _

/-- The raw finite B3 condition and the actual complete B3 condition agree. -/
theorem raw_nonbridge_iff_actual (h : T.Valid) : T.RawNonbridgeVisible ↔ T.ActualNonbridgeVisible h := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  constructor
  · intro hr l e he
    let r : T.GeneratedRawLabel := ⟨(T.generatedLabelEquiv l).val,T.rawLabels_complete_actual l⟩
    let raw := T.actualGraphRawEdgeEquiv h e
    have heq : T.actualEdge h raw = e := by
      apply (T.actualGraphRawEdgeEquiv h).injective
      rw [T.actualEdge_raw]
    have hb : ¬T.rawGraph.IsBridge (Graph.unoriented T.rawGraph (T.rawGraphEdge raw)) := by
      intro hb
      apply he
      rw [← heq]
      exact (Graph.transportEdge_bridge (T.actualGeometry_graph h).symm _).mpr hb
    exact hr r raw hb
  · intro ha r raw hb
    have he : ¬(T.actualGeometry h).graph.IsBridge
        (Graph.unoriented (T.actualGeometry h).graph (T.actualEdge h raw)) := by
      intro he
      exact hb ((Graph.transportEdge_bridge (T.actualGeometry_graph h).symm _).mp he)
    simpa only [T.actualLabel_code,T.actualEdge_raw] using ha (T.actualLabel r) (T.actualEdge h raw) he

/-- Computed success is equivalent to B3 on the same decoded actual input. -/
theorem reflectsTest_iff_actual_nonbridge (h : T.Valid) :
    T.reflectsTest = true ↔ T.ActualNonbridgeVisible h := by
  rw [reflectsTest,Option.isNone_iff_eq_none,T.searchFailure_none_iff,T.raw_nonbridge_iff_actual h]

/-- Computed success is equivalent to the all-input zero-reflection condition B1. -/
theorem reflectsTest_iff_actual_reflection (h : T.Valid) :
    T.reflectsTest = true ↔ T.ActualReflects h :=
  (T.reflectsTest_iff_actual_nonbridge h).trans (T.actual_reflection_iff_nonbridge_visible h).symm

/-- The actual failure input is the original primitive single-edge transition with zero chart state. -/
def SearchFailure.actualInput (f : T.SearchFailure) (h : T.Valid) : T.ActualLocalData h := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  exact (T.actualGeometry h).singleEdgeData (T.actualTarget h) (T.actualTarget_nonempty h)
    (T.actualPresentation h) (T.actualReflectionCondition h) (T.actualLabel f.label) (T.actualEdge h f.edge)

/-- The decoded actual cycle is the computed cycle transported along raw/actual graph equality. -/
def SearchFailure.actualCycle (f : T.SearchFailure) (h : T.Valid) :
    letI : TopologicalSpace T.Point := T.actualTopology h
    (T.actualGeometry h).graph.Walk f.edge.val.2 f.edge.val.2 := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  exact Graph.transportWalk (T.actualGeometry_graph h).symm f.cycle

/-- The same actual failure edge is invisible to the original independent diagnostic. -/
theorem SearchFailure.actual_invisible (f : T.SearchFailure) (h : T.Valid) :
    letI : TopologicalSpace T.Point := T.actualTopology h
    T.actualEdge h f.edge ∉ (T.actualGeometry h).visibleEdgeSet
      (T.actualTarget h) (T.actualTarget_nonempty h) (T.actualAdequate h) (T.actualLabel f.label) := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  rw [← T.edgeVisible_iff_actual h,T.actualEdge_raw,T.actualLabel_code]
  exact f.invisible

/-- The same actual failure edge is nonbridge, certified by the computed deleted path. -/
theorem SearchFailure.actual_not_bridge (f : T.SearchFailure) (h : T.Valid) :
    letI : TopologicalSpace T.Point := T.actualTopology h
    ¬(T.actualGeometry h).graph.IsBridge
      (Graph.unoriented (T.actualGeometry h).graph (T.actualEdge h f.edge)) := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  exact fun he => SearchFailure.not_bridge T f ((Graph.transportEdge_bridge (T.actualGeometry_graph h).symm _).mp he)

/-- Actual cycle transport preserves simple cycle, once-through count, and signed coefficient. -/
theorem SearchFailure.actual_cycle_correct (f : T.SearchFailure) (h : T.Valid) :
    letI : TopologicalSpace T.Point := T.actualTopology h
    (SearchFailure.actualCycle T f h).IsCycle ∧
      (SearchFailure.actualCycle T f h).edges.count (Graph.unoriented (T.actualGeometry h).graph (T.actualEdge h f.edge)) = 1 ∧
      Graph.walkChain (T.actualGeometry h).graph (SearchFailure.actualCycle T f h) (T.actualEdge h f.edge) = -1 := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  have hc := SearchFailure.cycle_correct T f
  exact ⟨(Graph.transportWalk_cycle _ _).mpr hc.1,
    by simpa only [actualCycle,actualEdge,Graph.transportWalk_edges,Graph.transportEdge_unoriented] using hc.2.1,
    by simpa only [actualCycle,actualEdge,Graph.transportWalk_coefficient] using hc.2.2⟩


/-- B2 uses the actual chain inclusion for every original source-generated label. -/
def ActualHomologySurjective (h : T.Valid) : Prop :=
  letI : TopologicalSpace T.Point := T.actualTopology h
  ∀ l, Function.Surjective (Graph.h1Inclusion (T.actualGeometry h).graph
    ((T.actualGeometry h).visibleVertexSet (T.actualTarget h) (T.actualTarget_nonempty h) (T.actualAdequate h) l)
    ((T.actualGeometry h).visibleEdgeSet (T.actualTarget h) (T.actualTarget_nonempty h) (T.actualAdequate h) l)
    ((T.actualGeometry h).visibleEdge_left (T.actualTarget h) (T.actualTarget_nonempty h) (T.actualAdequate h) l)
    ((T.actualGeometry h).visibleEdge_right (T.actualTarget h) (T.actualTarget_nonempty h) (T.actualAdequate h) l))

/-- The finite procedure succeeds exactly when the actual B2 chain inclusions are surjective. -/
theorem reflectsTest_iff_actual_homology (h : T.Valid) :
    T.reflectsTest = true ↔ T.ActualHomologySurjective h := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  exact (T.reflectsTest_iff_actual_reflection h).trans
    ((T.actualGeometry h).input_reflection_iff_homology_surjective (T.actualTarget h)
      (T.actualTarget_nonempty h) (T.actualPresentation h) (T.actualReflectionCondition h) (T.actualAdequate h))

/-- Actual label equality is exactly equality of the serialized generated label codes. -/
theorem actualLabel_eq_iff (r : T.GeneratedRawLabel) (l : LawValueLabel T.laws) :
    l = T.actualLabel r ↔ (T.generatedLabelEquiv l).val = r.val := by
  constructor
  · rintro rfl; rfl
  · intro he
    apply T.generatedLabelEquiv.injective
    exact Subtype.ext he

/-- The actual primitive transition normalizes to the exact serialized integral transition table. -/
theorem SearchFailure.actual_transition_table (f : T.SearchFailure) (h : T.Valid)
    (e : letI : TopologicalSpace T.Point := T.actualTopology h; Graph.Edge (T.actualGeometry h).graph)
    (l : LawValueLabel T.laws) :
    letI : TopologicalSpace T.Point := T.actualTopology h
    integralLabelEquiv (T.actualPresentation h) (T.actualReflectionCondition h)
      ((T.actualPresentation h).faceEmptyCechCochain1Equiv
        ((T.actualGeometry h).actualCechCover (T.actualPresentation h) (T.actualTarget h) (T.actualTarget_nonempty h))
        (SearchFailure.actualInput T f h).transition ((T.actualGeometry h).graphEdgeEquiv.symm e)) l =
      SearchFailure.transition T f (T.actualGraphRawEdgeEquiv h e) (T.generatedLabelEquiv l).val := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  rw [SearchFailure.actualInput,GeometricCover.singleEdgeData_transition_value]
  have he : e = T.actualEdge h f.edge ↔ T.actualGraphRawEdgeEquiv h e = f.edge := by
    constructor
    · rintro rfl; exact T.actualEdge_raw h f.edge
    · intro he
      apply (T.actualGraphRawEdgeEquiv h).injective
      rw [T.actualEdge_raw]
      exact he
  change _ = if T.actualGraphRawEdgeEquiv h e = f.edge then
    (if (T.generatedLabelEquiv l).val = f.label.val then 1 else 0) else 0
  by_cases hh : e = T.actualEdge h f.edge
  · rw [if_pos hh,integralLabelEquiv_labelBasis,if_pos (he.mp hh)]
    simp only [T.actualLabel_eq_iff]
  · rw [if_neg hh,map_zero,Pi.zero_apply,if_neg (fun heq => hh (he.mpr heq))]

/-- Every actual chart state in the returned input is the serialized zero state. -/
theorem SearchFailure.actual_state_zero (f : T.SearchFailure) (h : T.Valid) :
    (SearchFailure.actualInput T f h).localState = 0 := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  exact GeometricCover.singleEdgeData_localState _ _ _ _ _ _ _

/-- The returned actual input has zero independent diagnostic cochain, hence zero diagnostic class. -/
theorem SearchFailure.actual_diagnostic_zero (f : T.SearchFailure) (h : T.Valid) :
    (SearchFailure.actualInput T f h).diagnosticMismatch (T.actualAdequate h) = 0 ∧
      (SearchFailure.actualInput T f h).diagnosticClass (T.actualAdequate h) = 0 := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  exact ⟨(T.actualGeometry h).singleEdgeData_diagnostic_mismatch_zero _ _ _ _ _ _ _
      (SearchFailure.actual_invisible T f h),
    (T.actualGeometry h).singleEdgeData_diagnostic_zero _ _ _ _ _ _ _
      (SearchFailure.actual_invisible T f h)⟩

/-- The computed cycle has minus the original primitive basis as its nonzero period. -/
theorem SearchFailure.actual_period (f : T.SearchFailure) (h : T.Valid) :
    letI : TopologicalSpace T.Point := T.actualTopology h
    (T.actualGeometry h).actualTransitionPeriod (T.actualTarget h) (T.actualTarget_nonempty h)
      (T.actualPresentation h) (SearchFailure.actualInput T f h) (SearchFailure.actualCycle T f h) =
        -labelBasis (T.actualPresentation h) (T.actualReflectionCondition h) (T.actualLabel f.label) := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  exact (T.actualGeometry h).singleEdgeData_period _ _ _ _ _ _ _
    (SearchFailure.actual_cycle_correct T f h).2.2

/-- The original primitive period is nonzero on the generated cycle. -/
theorem SearchFailure.actual_period_ne_zero (f : T.SearchFailure) (h : T.Valid) :
    letI : TopologicalSpace T.Point := T.actualTopology h
    (T.actualGeometry h).actualTransitionPeriod (T.actualTarget h) (T.actualTarget_nonempty h)
      (T.actualPresentation h) (SearchFailure.actualInput T f h) (SearchFailure.actualCycle T f h) ≠ 0 := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  rw [SearchFailure.actual_period]
  exact neg_ne_zero.mpr (labelBasis_ne_zero _ _ _)

/-- The exact actual input returned by finite search has nonzero existing descent obstruction. -/
theorem SearchFailure.actual_existing_nonzero (f : T.SearchFailure) (h : T.Valid) :
    (SearchFailure.actualInput T f h).existingDescentAdditiveClass ≠ 0 := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  exact (T.actualGeometry h).singleEdgeData_existing_nonzero _ _ _ _ _ _
    (SearchFailure.actual_not_bridge T f h)


/-- The checked procedure succeeds exactly when B1, B2, and B3 all hold on this same actual input. -/
theorem checkAndSearch_actual_success (h : T.Valid) :
    T.checkAndSearch = .success ↔
      T.ActualReflects h ∧ T.ActualHomologySurjective h ∧ T.ActualNonbridgeVisible h := by
  rw [T.checkAndSearch_success_iff h]
  constructor
  · intro hs
    exact ⟨(T.reflectsTest_iff_actual_reflection h).mp hs,
      (T.reflectsTest_iff_actual_homology h).mp hs,(T.reflectsTest_iff_actual_nonbridge h).mp hs⟩
  · intro hs
    exact (T.reflectsTest_iff_actual_reflection h).mpr hs.1

/-- Every actual transition coordinate occurs with its exact value in the returned finite output. -/
theorem SearchFailure.output_actual_transition (f : T.SearchFailure) (h : T.Valid)
    (e : letI : TopologicalSpace T.Point := T.actualTopology h; Graph.Edge (T.actualGeometry h).graph)
    (l : LawValueLabel T.laws) :
    letI : TopologicalSpace T.Point := T.actualTopology h
    (T.actualGraphRawEdgeEquiv h e,(T.generatedLabelEquiv l).val,
      integralLabelEquiv (T.actualPresentation h) (T.actualReflectionCondition h)
        ((T.actualPresentation h).faceEmptyCechCochain1Equiv
          ((T.actualGeometry h).actualCechCover (T.actualPresentation h) (T.actualTarget h) (T.actualTarget_nonempty h))
          (SearchFailure.actualInput T f h).transition ((T.actualGeometry h).graphEdgeEquiv.symm e)) l)
        ∈ (SearchFailure.output T f).transition := by
  letI : TopologicalSpace T.Point := T.actualTopology h
  rw [SearchFailure.output_transition_iff]
  exact ⟨T.rawLabels_complete_actual l,SearchFailure.actual_transition_table T f h e l⟩

/-- A checked failure returns the computed path and an actual input with zero diagnostic and nonzero existing class. -/
theorem checkAndSearch_actual_failure (h : T.Valid) (f : T.SearchFailure)
    (hf : T.checkAndSearch = .failure f) :
    T.deletedPath f.edge = some f.path ∧
      (SearchFailure.actualInput T f h).diagnosticMismatch (T.actualAdequate h) = 0 ∧
      (SearchFailure.actualInput T f h).diagnosticClass (T.actualAdequate h) = 0 ∧
      (SearchFailure.actualInput T f h).existingDescentAdditiveClass ≠ 0 :=
  ⟨(T.searchFailure_provenance f ((T.checkAndSearch_failure_iff h f).mp hf)).2,
    (SearchFailure.actual_diagnostic_zero T f h).1,(SearchFailure.actual_diagnostic_zero T f h).2,
    SearchFailure.actual_existing_nonzero T f h⟩

end AAT.AG.VisibleCycleReflection.FiniteInputTable
#assert_standard_axioms_only AAT.AG.VisibleCycleReflection
