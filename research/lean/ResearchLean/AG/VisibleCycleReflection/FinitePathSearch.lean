import ResearchLean.AG.VisibleCycleReflection.GraphBridge
import Mathlib.Combinatorics.SimpleGraph.Connectivity.WalkCounting
import Formal.Util.AssertStandardAxioms

/-!
# Computable bounded path search and generated once-through cycles

## Implementation notes

Walks are enumerated as lists in vertex-code order, so path data is selected by
finite evaluation rather than a choice of an existential witness. A simple path
has length below the number of vertices. Searching that bound is therefore
complete, including disconnected graphs and equal endpoints.
-/

namespace AAT.AG.VisibleCycleReflection.FinitePathSearch
open SimpleGraph
variable {n : ℕ} (G : SimpleGraph (Fin n)) [DecidableRel G.Adj]

/-- Enumerate exactly the walks of a specified length in finite vertex-code order. -/
def walks : (k : ℕ) → (a b : Fin n) → List (G.Walk a b)
  | 0, a, b => if h : a = b then [h ▸ Walk.nil] else []
  | k+1, a, b => (List.finRange n).flatMap fun w =>
      if h : G.Adj a w then (walks k w b).map (Walk.cons h) else []

/-- Every enumerated walk has the requested length, and every such walk is listed. -/
theorem mem_walks (k : ℕ) (a b : Fin n) (p : G.Walk a b) :
    p ∈ walks G k a b ↔ p.length = k := by
  induction k generalizing a b with
  | zero =>
    cases p with
    | nil => simp [walks]
    | cons h p =>
      by_cases hab : a = b
      · subst b; simp [walks,Walk.length_cons]
      · simp [walks,hab,Walk.length_cons]
  | succ k ih =>
    cases p with
    | nil => simp [walks]
    | @cons a w b h p =>
      simp only [walks,List.mem_flatMap,List.mem_finRange, true_and]
      constructor
      · rintro ⟨v,hv⟩
        split_ifs at hv with ha
        · obtain ⟨q,hq,he⟩ := List.mem_map.mp hv
          have hl := congrArg Walk.length he
          simpa only [Walk.length_cons,(ih v b q).mp hq] using hl.symm
        · simp at hv
      · intro hp
        refine ⟨w,?_⟩
        rw [dif_pos h,List.mem_map]
        exact ⟨p,(ih w b p).mpr (by simpa only [Walk.length_cons,Nat.add_right_cancel_iff] using hp),rfl⟩

/-- Enumerate all walks shorter than the finite vertex count. -/
def boundedWalks (a b : Fin n) : List (G.Walk a b) :=
  (List.range n).flatMap fun k => walks G k a b

/-- The bounded enumeration contains exactly walks below the vertex-count bound. -/
theorem mem_boundedWalks (a b : Fin n) (p : G.Walk a b) :
    p ∈ boundedWalks G a b ↔ p.length < n := by
  simp only [boundedWalks,List.mem_flatMap,List.mem_range,mem_walks]
  constructor
  · rintro ⟨k,hk,hp⟩; simpa only [hp] using hk
  · intro h; exact ⟨p.length,h,rfl⟩

/-- Keep a walk precisely when its finite support has no repeated vertex. -/
def asPath {a b : Fin n} (p : G.Walk a b) : Option (G.Path a b) :=
  if h : p.support.Nodup then some ⟨p,SimpleGraph.Walk.IsPath.mk' h⟩ else none

omit [DecidableRel G.Adj] in
/-- Path filtering fails exactly on walks that are not paths. -/
theorem asPath_none_iff {a b : Fin n} (p : G.Walk a b) :
    asPath G p = none ↔ ¬p.IsPath  := by simp [asPath,SimpleGraph.Walk.isPath_def]

/-- The first simple path is generated by bounded list enumeration and finite filtering. -/
def findPath (a b : Fin n) : Option (G.Path a b) :=
  (boundedWalks G a b).findSome? (asPath G)

/-- Search failure is exactly nonreachability; completeness uses the simple-path bound. -/
theorem findPath_none_iff (a b : Fin n) :
    findPath G a b = none ↔ ¬G.Reachable a b := by
  rw [findPath,List.findSome?_eq_none_iff]
  constructor
  · intro h hr
    exact hr.elim_path fun p =>
      (asPath_none_iff G p.val).mp (h p.val ((mem_boundedWalks G a b p.val).mpr
        (by simpa using p.isPath.length_lt))) p.isPath
  · intro h p hp
    exact (asPath_none_iff G p).mpr (fun _ => h ⟨p⟩)

/-- A returned path is in the explicit bounded enumeration. -/
theorem findPath_sound {a b : Fin n} (p : G.Path a b)
    (h : findPath G a b = some p) : p.val ∈ boundedWalks G a b := by
  obtain ⟨w,hw,he⟩ := List.exists_of_findSome?_eq_some h
  unfold asPath at he
  split_ifs at he with hh
  · have he' := Option.some.inj he
    simpa only [← he'] using hw

end AAT.AG.VisibleCycleReflection.FinitePathSearch
namespace AAT.AG.VisibleCycleReflection.Graph
open SimpleGraph
variable {n : ℕ} (G : SimpleGraph (Fin n)) [DecidableRel G.Adj]

/-- Deletion adjacency is decided from the original edge test and endpoint equality. -/
instance withoutEdgeDecidable (e : Edge G) : DecidableRel (withoutEdge G e).Adj :=
  fun a b => decidable_of_iff (G.Adj a b ∧ s(a,b) ≠ unoriented G e)
    (withoutEdge_adj G e a b).symm

/-- Map a deleted-edge path back to the original graph without changing its vertices. -/
def restoredPath (e : Edge G)
    (p : (withoutEdge G e).Path (left G e) (right G e)) :
    G.Path (left G e) (right G e) :=
  ⟨p.val.mapLe (withoutEdge_le G e),p.isPath.mapLe _⟩

omit [DecidableRel G.Adj] in
/-- A restored deleted path contains no occurrence of the selected edge. -/
theorem restoredPath_avoids (e : Edge G)
    (p : (withoutEdge G e).Path (left G e) (right G e)) :
    unoriented G e ∉ (restoredPath G e p).val.edges := by
  intro h
  rw [restoredPath,Walk.edges_mapLe_eq_edges] at h
  have ha := p.val.adj_of_mem_edges h
  exact ((withoutEdge_adj G e _ _).mp ha).2 rfl

/-- Close the computed deleted path by the reverse selected edge. -/
def cycleOfPath (e : Edge G)
    (p : (withoutEdge G e).Path (left G e) (right G e)) :
    G.Walk (right G e) (right G e) :=
  .cons (adj G e).symm (restoredPath G e p).val

omit [DecidableRel G.Adj] in
/-- The generated closed walk is a simple cycle, rather than an arbitrary closed walk. -/
theorem cycleOfPath_isCycle (e : Edge G)
    (p : (withoutEdge G e).Path (left G e) (right G e)) :
    (cycleOfPath G e p).IsCycle := by
  apply Path.cons_isCycle
  simpa only [Sym2.eq_swap] using restoredPath_avoids G e p

omit [DecidableRel G.Adj] in
/-- The generated cycle traverses the selected edge exactly once. -/
theorem cycleOfPath_once (e : Edge G)
    (p : (withoutEdge G e).Path (left G e) (right G e)) :
    (cycleOfPath G e p).edges.count (unoriented G e) = 1 := by
  change (s(right G e,left G e) :: (restoredPath G e p).val.edges).count _ = 1
  rw [Sym2.eq_swap]
  change (unoriented G e :: (restoredPath G e p).val.edges).count _ = 1
  rw [List.count_cons_self,List.count_eq_zero.mpr (restoredPath_avoids G e p)]

omit [DecidableRel G.Adj] in
/-- The selected oriented edge has coefficient minus one in the computed cycle chain. -/
theorem cycleOfPath_coefficient (e : Edge G)
    (p : (withoutEdge G e).Path (left G e) (right G e)) :
    walkChain G (cycleOfPath G e p) e = -1 := by
  rw [cycleOfPath,walkChain_cons,Pi.add_apply,
    walkChain_eq_zero G _ e (restoredPath_avoids G e p),add_zero]
  rw [hopChain_of_not_lt G _ (not_lt_of_ge (le_of_lt (left_lt_right G e)))]
  rw [Pi.neg_apply,edgeUnit_apply,if_pos]
  apply edge_ext G <;> rfl

omit [DecidableRel G.Adj] in
/-- A computed deleted path certifies nonbridge status for this same original edge. -/
theorem not_bridge_of_deleted_path (e : Edge G)
    (p : (withoutEdge G e).Path (left G e) (right G e)) :
    ¬G.IsBridge (unoriented G e) := by
  rw [isBridge_iff_not_reachable]
  exact fun h => h ⟨p.val⟩

end AAT.AG.VisibleCycleReflection.Graph
#assert_standard_axioms_only AAT.AG.VisibleCycleReflection.FinitePathSearch
#assert_standard_axioms_only AAT.AG.VisibleCycleReflection.Graph
