import ResearchLean.AG.ComparisonInformationLoss.ObservationTransport
import ResearchLean.AG.ComparisonInformationLoss.EndpointKernelClassification
import ResearchLean.AG.DoctrineFiberProduct.UpperGeometryCompatibleSourcePresentationNaturalityF12

/-!
# Presentation transport of generated-comparison observation loss

This module transports the G-120 generated-comparison observation diagram
along an arbitrary G-118 C1s source-presentation change.  The transport is the
actual independently generated endpoint conjugation.  Its observation and
qualified-subgroup squares are inherited from the existing C1s theorems, and
the general clause-A API then restricts it to `K_c`, `L_c`, and the pointed
left-coset set.

The two endpoint components are also restricted to the endpoint observation
kernels.  Their compatibility with comparison conjugation proves naturality
of the B2 classification `Psi`.
-/

namespace AAT.AG.ComparisonInformationLoss.GeneratedComparison

universe u v

open CategoryTheory AtomFoundation GeometryTransport CrossStageCoherence
open TransportCoherence
open AAT.AG.DoctrineFiberProduct

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 100000

noncomputable section

namespace PresentationChange

variable {U : AtomCarrier.{u}} {ctx : ActiveRefinementBCContext U}
variable {P : FiniteTransportPresentation.{u}} {k : CommRingCat.{v}}
variable {input : UpperGeometryCompatibleProblemInputData ctx P k}

/-- G-120(B4) coefficient-observation transport induced by the actual
coefficient components of the two independently generated endpoint
isomorphisms. -/
noncomputable def coefficientObservationEquivAt
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    ObservationGroupAt change.changedInput i ≃*
      ObservationGroupAt input i :=
  MulEquiv.prodCongr
    (coefficientConjugationMulEquiv
      (change.generatedBaseRouteExactGeometryIsoAt i))
    (coefficientConjugationMulEquiv
      (change.generatedPulledRouteExactGeometryIsoAt i))

/-- For a C1s presentation change, the coefficient components of both
generated endpoint isomorphisms are identities.  Thus their induced
coefficient-observation transport is the identity, with the construction
provenance retained by `coefficientObservationEquivAt`. -/
theorem coefficientObservationEquivAt_eq_refl
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    coefficientObservationEquivAt change i = MulEquiv.refl _ := by
  apply MulEquiv.ext
  intro pair
  apply Prod.ext
  · apply CategoryTheory.Iso.ext
    ext value
    change
      ((change.generatedBaseRouteExactGeometryIsoAt i).hom.geometry.coefficientHom.comp
        (pair.1.hom.hom.comp
          (change.generatedBaseRouteExactGeometryIsoAt i).inv.geometry.coefficientHom)) value =
        pair.1.hom.hom value
    rw [change.generatedBaseRouteExactGeometryIsoAt_hom_coefficient_id,
      change.generatedBaseRouteExactGeometryIsoAt_inv_coefficient_id]
    rfl
  · apply CategoryTheory.Iso.ext
    ext value
    change
      ((change.generatedPulledRouteExactGeometryIsoAt i).hom.geometry.coefficientHom.comp
        (pair.2.hom.hom.comp
          (change.generatedPulledRouteExactGeometryIsoAt i).inv.geometry.coefficientHom)) value =
        pair.2.hom.hom value
    rw [change.generatedPulledRouteExactGeometryIsoAt_hom_coefficient_id,
      change.generatedPulledRouteExactGeometryIsoAt_inv_coefficient_id]
    rfl

/-- G-120(B4) main observation-diagram transport.  It runs from the comparison
regenerated by the changed input to the original comparison, using the actual
C1s generated endpoint-pair equivalence, its coefficient square, and its full
qualified-subgroup image theorem. -/
noncomputable def observationEquivAt
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    ObservationEquiv
      (observationAt change.changedInput i)
      (compatibleSubgroupAt change.changedInput i)
      (observationAt input i)
      (compatibleSubgroupAt input i) where
  changeEquiv := change.generatedEndpointPairMulEquivAt i
  observationEquiv := coefficientObservationEquivAt change i
  observation_comm pair := by
    rw [coefficientObservationEquivAt_eq_refl]
    simpa only [MulEquiv.refl_apply] using
      change.generatedEndpointPairMulEquivAt_coefficientObservation i pair
  compatible_map :=
    change.generatedEndpointPairMulEquivAt_map_qualifiedComparisonSubgroup i

/-- G-120(B4) induced transport of the full product observation kernel
`K_c`, constructed through the clause-A observation-diagram API. -/
noncomputable def kernelEquivAt
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    observationKernelAt change.changedInput i ≃*
      observationKernelAt input i :=
  (observationEquivAt change i).kernelEquiv

/-- G-120(B4) induced transport of the compatible kernel `L_c`. -/
noncomputable def compatibleKernelEquivAt
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    compatibleKernelAt change.changedInput i ≃*
      compatibleKernelAt input i :=
  (observationEquivAt change i).compatibleKernelEquiv

/-- G-120(B4) induced pointed transport of the general left-coset loss set.
No normality premise is introduced. -/
noncomputable def quotientEquivAt
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    observationLossAt change.changedInput i ≃ observationLossAt input i :=
  (observationEquivAt change i).quotientEquiv

/-- G-120(B4) representative evaluation of the pointed loss transport. -/
@[simp] theorem quotientEquivAt_mk
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) (value : observationKernelAt change.changedInput i) :
    quotientEquivAt change i (QuotientGroup.mk value) =
      QuotientGroup.mk (kernelEquivAt change i value) :=
  rfl

/-- G-120(B4) the loss transport preserves the distinguished coset. -/
@[simp] theorem quotientEquivAt_basepoint
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    quotientEquivAt change i (QuotientGroup.mk 1) = QuotientGroup.mk 1 :=
  (observationEquivAt change i).quotientEquiv_basepoint

/-- G-120(B4) source-endpoint conjugation supplied by the independently
generated base endpoint comparison of the C1s change. -/
noncomputable def sourceEndpointEquivAt
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    CompositeFiberAut (change.changedInput.generatedBaseRouteGeometryAt i) ≃*
      CompositeFiberAut (input.generatedBaseRouteGeometryAt i) :=
  CompositeFiberAut.conjugationMulEquiv
    (change.generatedBaseRouteExactGeometryIsoAt i)

/-- G-120(B4) target-endpoint conjugation supplied by the independently
generated pulled endpoint comparison of the C1s change. -/
noncomputable def targetEndpointEquivAt
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    CompositeFiberAut (change.changedInput.generatedPulledRouteGeometryAt i) ≃*
      CompositeFiberAut (input.generatedPulledRouteGeometryAt i) :=
  CompositeFiberAut.conjugationMulEquiv
    (change.generatedPulledRouteExactGeometryIsoAt i)

/-- G-120(B4) source endpoint observation commutes with actual C1s endpoint
conjugation.  It is projected from the existing product-observation square. -/
theorem sourceEndpointObservation_comm
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex)
    (value : CompositeFiberAut
      (change.changedInput.generatedBaseRouteGeometryAt i)) :
    CompositeFiberAut.coefficientObservation
        (input.generatedBaseRouteGeometryAt i)
        (sourceEndpointEquivAt change i value) =
      CompositeFiberAut.coefficientObservation
        (change.changedInput.generatedBaseRouteGeometryAt i) value := by
  have h := change.generatedEndpointPairMulEquivAt_coefficientObservation
    i (value, 1)
  exact congrArg Prod.fst h

/-- G-120(B4) target endpoint observation commutes with actual C1s endpoint
conjugation, projected from the existing product-observation square. -/
theorem targetEndpointObservation_comm
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex)
    (value : CompositeFiberAut
      (change.changedInput.generatedPulledRouteGeometryAt i)) :
    CompositeFiberAut.coefficientObservation
        (input.generatedPulledRouteGeometryAt i)
        (targetEndpointEquivAt change i value) =
      CompositeFiberAut.coefficientObservation
        (change.changedInput.generatedPulledRouteGeometryAt i) value := by
  have h := change.generatedEndpointPairMulEquivAt_coefficientObservation
    i (1, value)
  exact congrArg Prod.snd h

/-- G-120(B4) source-endpoint observation diagram induced by the generated
base endpoint isomorphism. -/
noncomputable def sourceObservationEquivAt
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) : ObservationEquiv
      (CompositeFiberAut.coefficientObservation
        (change.changedInput.generatedBaseRouteGeometryAt i)) ⊤
      (CompositeFiberAut.coefficientObservation
        (input.generatedBaseRouteGeometryAt i)) ⊤ where
  changeEquiv := sourceEndpointEquivAt change i
  observationEquiv := MulEquiv.refl _
  observation_comm value := by
    simpa only [MulEquiv.refl_apply] using
      sourceEndpointObservation_comm change i value
  compatible_map := by simp

/-- G-120(B4) target-endpoint observation diagram induced by the generated
pulled endpoint isomorphism. -/
noncomputable def targetObservationEquivAt
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) : ObservationEquiv
      (CompositeFiberAut.coefficientObservation
        (change.changedInput.generatedPulledRouteGeometryAt i)) ⊤
      (CompositeFiberAut.coefficientObservation
        (input.generatedPulledRouteGeometryAt i)) ⊤ where
  changeEquiv := targetEndpointEquivAt change i
  observationEquiv := MulEquiv.refl _
  observation_comm value := by
    simpa only [MulEquiv.refl_apply] using
      targetEndpointObservation_comm change i value
  compatible_map := by simp

/-- G-120(B4) restriction of the source endpoint conjugation to its
coefficient-observation kernel. -/
noncomputable def sourceKernelEquivAt
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    SourceObservationKernelAt change.changedInput i ≃*
      SourceObservationKernelAt input i :=
  (sourceObservationEquivAt change i).kernelEquiv

/-- G-120(B4) restriction of the target endpoint conjugation to its
coefficient-observation kernel. -/
noncomputable def targetKernelEquivAt
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    TargetObservationKernelAt change.changedInput i ≃*
      TargetObservationKernelAt input i :=
  (targetObservationEquivAt change i).kernelEquiv

/-- G-120(B4) API: product-kernel transport is coordinatewise endpoint-kernel
transport under the B2 product identifications. -/
theorem kernelEquivAt_product
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) (value : observationKernelAt change.changedInput i) :
    (endpointKernelProductEquivAt input i).symm (kernelEquivAt change i value) =
      (sourceKernelEquivAt change i
          ((endpointKernelProductEquivAt change.changedInput i).symm value).1,
        targetKernelEquivAt change i
          ((endpointKernelProductEquivAt change.changedInput i).symm value).2) := by
  apply Prod.ext <;> rfl

/-- G-120(B4) comparison conjugation is natural on the full endpoint
automorphism groups under the two independently generated endpoint changes:
`theta_Y T_c' = T_c theta_X`. -/
theorem endpointConjugation_naturality
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex)
    (value : CompositeFiberAut
      (change.changedInput.generatedBaseRouteGeometryAt i)) :
    targetEndpointEquivAt change i
        (endpointChangeEquivAt change.changedInput i value) =
      endpointChangeEquivAt input i
        (sourceEndpointEquivAt change i value) := by
  have hnew :
      (value, endpointChangeEquivAt change.changedInput i value) ∈
        compatibleSubgroupAt change.changedInput i := by
    simpa only [endpointObservationKernelEquivAt_apply] using
      (qualifiedComparisonIsoGraphMulEquiv
        (comparisonIsoAt change.changedInput i)
        value).2
  have hold :=
    (change.generatedEndpointPairMulEquivAt_mem_qualifiedComparison_iff
      i _).mp hnew
  have hprojection := qualifiedComparisonIsoTargetProjectionMulEquiv_apply
    (comparisonIsoAt input i)
    (⟨change.generatedEndpointPairMulEquivAt i
      (value, endpointChangeEquivAt change.changedInput i value), hold⟩)
  have htarget :
      endpointChangeEquivAt input i (sourceEndpointEquivAt change i value) =
        targetEndpointEquivAt change i
          (endpointChangeEquivAt change.changedInput i value) := by
    change endpointChangeEquivAt input i
        (change.generatedEndpointPairMulEquivAt i
          ((value : CompositeFiberAut
            (change.changedInput.generatedBaseRouteGeometryAt i)),
          (endpointChangeEquivAt change.changedInput i value))).1 =
      (change.generatedEndpointPairMulEquivAt i
        ((value : CompositeFiberAut
          (change.changedInput.generatedBaseRouteGeometryAt i)),
        (endpointChangeEquivAt change.changedInput i value))).2 at hprojection
    exact hprojection
  exact htarget.symm

/-- Full endpoint comparison-conjugation naturality in the inverse direction
required by the fixed target: `theta_Y T_c = T_c' theta_X`. -/
theorem endpointConjugation_inverse_naturality
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex)
    (value : CompositeFiberAut (input.generatedBaseRouteGeometryAt i)) :
    endpointChangeEquivAt change.changedInput i
        ((sourceEndpointEquivAt change i).symm value) =
      (targetEndpointEquivAt change i).symm
        (endpointChangeEquivAt input i value) := by
  apply (targetEndpointEquivAt change i).injective
  rw [endpointConjugation_naturality,
    MulEquiv.apply_symm_apply, MulEquiv.apply_symm_apply]

/-- Restriction of full endpoint comparison-conjugation naturality to the
coefficient-observation kernels. -/
theorem endpointKernelConjugation_naturality
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex)
    (value : SourceObservationKernelAt change.changedInput i) :
    targetKernelEquivAt change i
        (endpointObservationKernelEquivAt change.changedInput i value) =
      endpointObservationKernelEquivAt input i
        (sourceKernelEquivAt change i value) := by
  apply Subtype.ext
  exact endpointConjugation_naturality change i value

/-- The same comparison-conjugation square in the inverse endpoint direction,
matching the conventional `theta_Y T_c = T_c' theta_X` orientation. -/
theorem endpointKernelConjugation_inverse_naturality
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex)
    (value : SourceObservationKernelAt input i) :
    endpointObservationKernelEquivAt change.changedInput i
        ((sourceKernelEquivAt change i).symm value) =
      (targetKernelEquivAt change i).symm
        (endpointObservationKernelEquivAt input i value) := by
  apply (targetKernelEquivAt change i).injective
  rw [endpointKernelConjugation_naturality,
    MulEquiv.apply_symm_apply, MulEquiv.apply_symm_apply]

/-- G-120(B4) main naturality square for the B2 pointed classification:
transporting a loss class and then applying `Psi` equals applying `Psi` first
and transporting in the target endpoint kernel. -/
theorem observationLossEquivTargetKernel_naturality
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) (loss : observationLossAt change.changedInput i) :
    observationLossEquivTargetKernelAt input i
        (quotientEquivAt change i loss) =
      targetKernelEquivAt change i
        (observationLossEquivTargetKernelAt change.changedInput i loss) := by
  refine QuotientGroup.induction_on loss fun value => ?_
  rw [quotientEquivAt_mk,
    observationLossEquivTargetKernelAt_mk,
    observationLossEquivTargetKernelAt_mk,
    map_mul, map_inv,
    kernelEquivAt_product,
    endpointKernelConjugation_naturality]

/-- The B2 classification square in the inverse presentation-transport
direction, matching `Psi_c' phibar = theta_Y Psi_c`. -/
theorem observationLossEquivTargetKernel_inverse_naturality
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) (loss : observationLossAt input i) :
    observationLossEquivTargetKernelAt change.changedInput i
        ((quotientEquivAt change i).symm loss) =
      (targetKernelEquivAt change i).symm
        (observationLossEquivTargetKernelAt input i loss) := by
  apply (targetKernelEquivAt change i).injective
  rw [← observationLossEquivTargetKernel_naturality,
    Equiv.apply_symm_apply, MulEquiv.apply_symm_apply]

/-- G-120(B4) equivalence-level form of the B2 classification naturality
square. -/
theorem observationLossEquivTargetKernel_equiv_naturality
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    (quotientEquivAt change i).trans
        (observationLossEquivTargetKernelAt input i) =
      (observationLossEquivTargetKernelAt change.changedInput i).trans
        (targetKernelEquivAt change i) := by
  apply Equiv.ext
  intro loss
  exact observationLossEquivTargetKernel_naturality change i loss

/-- Equivalence-level inverse orientation of the B2 classification square. -/
theorem observationLossEquivTargetKernel_inverse_equiv_naturality
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    (quotientEquivAt change i).symm.trans
        (observationLossEquivTargetKernelAt change.changedInput i) =
      (observationLossEquivTargetKernelAt input i).trans
        (targetKernelEquivAt change i).symm := by
  apply Equiv.ext
  intro loss
  exact observationLossEquivTargetKernel_inverse_naturality change i loss

/-! ## Identity, inverse, and typed-composition coherence -/

/-- The generated source-endpoint action preserves identity changes. -/
theorem sourceEndpointEquivAt_identity
    (input : UpperGeometryCompatibleProblemInputData ctx P k)
    (i : P.Vertex) :
    sourceEndpointEquivAt
        (UpperGeometryCompatibleSourcePresentationChange.identity input) i =
      MulEquiv.refl _ := by
  simpa only [sourceEndpointEquivAt,
    UpperGeometryCompatibleSourcePresentationChange.identity_changedInput,
    UpperGeometryCompatibleSourcePresentationChange.generatedBaseRouteExactGeometryIsoAt_identity] using
      (CompositeFiberAut.conjugationMulEquiv_refl
        (input.generatedBaseRouteGeometryAt i))

/-- The generated target-endpoint action preserves identity changes. -/
theorem targetEndpointEquivAt_identity
    (input : UpperGeometryCompatibleProblemInputData ctx P k)
    (i : P.Vertex) :
    targetEndpointEquivAt
        (UpperGeometryCompatibleSourcePresentationChange.identity input) i =
      MulEquiv.refl _ := by
  simpa only [targetEndpointEquivAt,
    UpperGeometryCompatibleSourcePresentationChange.identity_changedInput,
    UpperGeometryCompatibleSourcePresentationChange.generatedPulledRouteExactGeometryIsoAt_identity] using
      (CompositeFiberAut.conjugationMulEquiv_refl
        (input.generatedPulledRouteGeometryAt i))

/-- The inverse source-endpoint action is the inverse action. -/
theorem sourceEndpointEquivAt_inverse
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    sourceEndpointEquivAt change.inverse i =
      (sourceEndpointEquivAt change i).symm := by
  change CompositeFiberAut.conjugationMulEquiv
      (change.inverse.generatedBaseRouteExactGeometryIsoAt i) =
    (CompositeFiberAut.conjugationMulEquiv
      (change.generatedBaseRouteExactGeometryIsoAt i)).symm
  rw [UpperGeometryCompatibleSourcePresentationChange.generatedBaseRouteExactGeometryIsoAt_inverse]
  apply MulEquiv.ext
  intro value
  apply Subtype.ext
  apply Iso.ext
  rfl

/-- The inverse target-endpoint action is the inverse action. -/
theorem targetEndpointEquivAt_inverse
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    targetEndpointEquivAt change.inverse i =
      (targetEndpointEquivAt change i).symm := by
  change CompositeFiberAut.conjugationMulEquiv
      (change.inverse.generatedPulledRouteExactGeometryIsoAt i) =
    (CompositeFiberAut.conjugationMulEquiv
      (change.generatedPulledRouteExactGeometryIsoAt i)).symm
  rw [UpperGeometryCompatibleSourcePresentationChange.generatedPulledRouteExactGeometryIsoAt_inverse]
  apply MulEquiv.ext
  intro value
  apply Subtype.ext
  apply Iso.ext
  rfl

/-- Source-endpoint action respects typed binary composition. -/
theorem sourceEndpointEquivAt_comp
    (first : UpperGeometryCompatibleSourcePresentationChange input)
    (second : UpperGeometryCompatibleSourcePresentationChange
      first.changedInput)
    (i : P.Vertex) :
    sourceEndpointEquivAt (first.comp second) i =
      (sourceEndpointEquivAt second i).trans
        (sourceEndpointEquivAt first i) := by
  change CompositeFiberAut.conjugationMulEquiv
      ((first.comp second).generatedBaseRouteExactGeometryIsoAt i) = _
  rw [UpperGeometryCompatibleSourcePresentationChange.generatedBaseRouteExactGeometryIsoAt_comp,
    ← CompositeFiberAut.conjugationMulEquiv_trans]
  rfl

/-- Target-endpoint action respects typed binary composition. -/
theorem targetEndpointEquivAt_comp
    (first : UpperGeometryCompatibleSourcePresentationChange input)
    (second : UpperGeometryCompatibleSourcePresentationChange
      first.changedInput)
    (i : P.Vertex) :
    targetEndpointEquivAt (first.comp second) i =
      (targetEndpointEquivAt second i).trans
        (targetEndpointEquivAt first i) := by
  change CompositeFiberAut.conjugationMulEquiv
      ((first.comp second).generatedPulledRouteExactGeometryIsoAt i) = _
  rw [UpperGeometryCompatibleSourcePresentationChange.generatedPulledRouteExactGeometryIsoAt_comp,
    ← CompositeFiberAut.conjugationMulEquiv_trans]
  rfl

/-- Source endpoint observation transport preserves identities. -/
theorem sourceObservationEquivAt_identity
    (input : UpperGeometryCompatibleProblemInputData ctx P k)
    (i : P.Vertex) :
    sourceObservationEquivAt
        (UpperGeometryCompatibleSourcePresentationChange.identity input) i =
      ObservationEquiv.refl
        (CompositeFiberAut.coefficientObservation
          (input.generatedBaseRouteGeometryAt i)) ⊤ := by
  apply ObservationEquiv.ext
  · exact sourceEndpointEquivAt_identity input i
  · rfl

/-- Target endpoint observation transport preserves identities. -/
theorem targetObservationEquivAt_identity
    (input : UpperGeometryCompatibleProblemInputData ctx P k)
    (i : P.Vertex) :
    targetObservationEquivAt
        (UpperGeometryCompatibleSourcePresentationChange.identity input) i =
      ObservationEquiv.refl
        (CompositeFiberAut.coefficientObservation
          (input.generatedPulledRouteGeometryAt i)) ⊤ := by
  apply ObservationEquiv.ext
  · exact targetEndpointEquivAt_identity input i
  · rfl

/-- Source endpoint observation transport respects inversion. -/
theorem sourceObservationEquivAt_inverse
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    sourceObservationEquivAt change.inverse i =
      (sourceObservationEquivAt change i).symm := by
  apply ObservationEquiv.ext
  · exact sourceEndpointEquivAt_inverse change i
  · rfl

/-- Target endpoint observation transport respects inversion. -/
theorem targetObservationEquivAt_inverse
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    targetObservationEquivAt change.inverse i =
      (targetObservationEquivAt change i).symm := by
  apply ObservationEquiv.ext
  · exact targetEndpointEquivAt_inverse change i
  · rfl

/-- Source endpoint observation transport respects typed composition. -/
theorem sourceObservationEquivAt_comp
    (first : UpperGeometryCompatibleSourcePresentationChange input)
    (second : UpperGeometryCompatibleSourcePresentationChange
      first.changedInput)
    (i : P.Vertex) :
    sourceObservationEquivAt (first.comp second) i =
      (sourceObservationEquivAt second i).trans
        (sourceObservationEquivAt first i) := by
  apply ObservationEquiv.ext
  · exact sourceEndpointEquivAt_comp first second i
  · rfl

/-- Target endpoint observation transport respects typed composition. -/
theorem targetObservationEquivAt_comp
    (first : UpperGeometryCompatibleSourcePresentationChange input)
    (second : UpperGeometryCompatibleSourcePresentationChange
      first.changedInput)
    (i : P.Vertex) :
    targetObservationEquivAt (first.comp second) i =
      (targetObservationEquivAt second i).trans
        (targetObservationEquivAt first i) := by
  apply ObservationEquiv.ext
  · exact targetEndpointEquivAt_comp first second i
  · rfl

/-- Source endpoint kernel transport preserves identities. -/
theorem sourceKernelEquivAt_identity
    (input : UpperGeometryCompatibleProblemInputData ctx P k)
    (i : P.Vertex) :
    sourceKernelEquivAt
        (UpperGeometryCompatibleSourcePresentationChange.identity input) i =
      MulEquiv.refl _ := by
  change (sourceObservationEquivAt
    (UpperGeometryCompatibleSourcePresentationChange.identity input) i).kernelEquiv = _
  rw [sourceObservationEquivAt_identity]
  simpa only [UpperGeometryCompatibleSourcePresentationChange.identity_changedInput] using
    (ObservationEquiv.kernelEquiv_refl
      (CompositeFiberAut.coefficientObservation
        (input.generatedBaseRouteGeometryAt i)) ⊤)

/-- Target endpoint kernel transport preserves identities. -/
theorem targetKernelEquivAt_identity
    (input : UpperGeometryCompatibleProblemInputData ctx P k)
    (i : P.Vertex) :
    targetKernelEquivAt
        (UpperGeometryCompatibleSourcePresentationChange.identity input) i =
      MulEquiv.refl _ := by
  change (targetObservationEquivAt
    (UpperGeometryCompatibleSourcePresentationChange.identity input) i).kernelEquiv = _
  rw [targetObservationEquivAt_identity]
  simpa only [UpperGeometryCompatibleSourcePresentationChange.identity_changedInput] using
    (ObservationEquiv.kernelEquiv_refl
      (CompositeFiberAut.coefficientObservation
        (input.generatedPulledRouteGeometryAt i)) ⊤)

/-- Source endpoint kernel transport respects inversion. -/
theorem sourceKernelEquivAt_inverse
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    sourceKernelEquivAt change.inverse i =
      (sourceKernelEquivAt change i).symm := by
  change (sourceObservationEquivAt change.inverse i).kernelEquiv = _
  rw [sourceObservationEquivAt_inverse, ObservationEquiv.kernelEquiv_symm]
  rfl

/-- Target endpoint kernel transport respects inversion. -/
theorem targetKernelEquivAt_inverse
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    targetKernelEquivAt change.inverse i =
      (targetKernelEquivAt change i).symm := by
  change (targetObservationEquivAt change.inverse i).kernelEquiv = _
  rw [targetObservationEquivAt_inverse, ObservationEquiv.kernelEquiv_symm]
  rfl

/-- Source endpoint kernel transport respects typed composition. -/
theorem sourceKernelEquivAt_comp
    (first : UpperGeometryCompatibleSourcePresentationChange input)
    (second : UpperGeometryCompatibleSourcePresentationChange
      first.changedInput)
    (i : P.Vertex) :
    sourceKernelEquivAt (first.comp second) i =
      (sourceKernelEquivAt second i).trans
        (sourceKernelEquivAt first i) := by
  change (sourceObservationEquivAt (first.comp second) i).kernelEquiv = _
  rw [sourceObservationEquivAt_comp, ObservationEquiv.kernelEquiv_trans]
  rfl

/-- Target endpoint kernel transport respects typed composition. -/
theorem targetKernelEquivAt_comp
    (first : UpperGeometryCompatibleSourcePresentationChange input)
    (second : UpperGeometryCompatibleSourcePresentationChange
      first.changedInput)
    (i : P.Vertex) :
    targetKernelEquivAt (first.comp second) i =
      (targetKernelEquivAt second i).trans
        (targetKernelEquivAt first i) := by
  change (targetObservationEquivAt (first.comp second) i).kernelEquiv = _
  rw [targetObservationEquivAt_comp, ObservationEquiv.kernelEquiv_trans]
  rfl

/-- The endpoint action generated by the identity presentation change is the
identity action. -/
theorem generatedEndpointPairMulEquivAt_identity
    (input : UpperGeometryCompatibleProblemInputData ctx P k)
    (i : P.Vertex) :
    (UpperGeometryCompatibleSourcePresentationChange.identity input).generatedEndpointPairMulEquivAt i =
      MulEquiv.refl _ := by
  apply MulEquiv.ext
  intro pair
  change
    (sourceEndpointEquivAt
        (UpperGeometryCompatibleSourcePresentationChange.identity input) i pair.1,
      targetEndpointEquivAt
        (UpperGeometryCompatibleSourcePresentationChange.identity input) i pair.2) = pair
  apply Prod.ext
  · exact congrArg (fun equiv => equiv pair.1)
      (sourceEndpointEquivAt_identity input i)
  · exact congrArg (fun equiv => equiv pair.2)
      (targetEndpointEquivAt_identity input i)

/-- The complete B4 observation diagram for the identity presentation change
is the identity observation diagram. -/
theorem observationEquivAt_identity
    (input : UpperGeometryCompatibleProblemInputData ctx P k)
    (i : P.Vertex) :
    observationEquivAt
        (UpperGeometryCompatibleSourcePresentationChange.identity input) i =
      ObservationEquiv.refl
        (observationAt input i) (compatibleSubgroupAt input i) := by
  apply ObservationEquiv.ext
  · exact generatedEndpointPairMulEquivAt_identity input i
  · change coefficientObservationEquivAt
      (UpperGeometryCompatibleSourcePresentationChange.identity input) i =
        MulEquiv.refl _
    exact coefficientObservationEquivAt_eq_refl _ _

/-- Identity presentation change acts identically on `K_c`. -/
theorem kernelEquivAt_identity
    (input : UpperGeometryCompatibleProblemInputData ctx P k)
    (i : P.Vertex) :
    kernelEquivAt
        (UpperGeometryCompatibleSourcePresentationChange.identity input) i =
      MulEquiv.refl _ := by
  change (observationEquivAt
    (UpperGeometryCompatibleSourcePresentationChange.identity input) i).kernelEquiv = _
  rw [observationEquivAt_identity]
  simpa only [UpperGeometryCompatibleSourcePresentationChange.identity_changedInput] using
    (ObservationEquiv.kernelEquiv_refl
      (observationAt input i) (compatibleSubgroupAt input i))

/-- Identity presentation change acts identically on `L_c`. -/
theorem compatibleKernelEquivAt_identity
    (input : UpperGeometryCompatibleProblemInputData ctx P k)
    (i : P.Vertex) :
    compatibleKernelEquivAt
        (UpperGeometryCompatibleSourcePresentationChange.identity input) i =
      MulEquiv.refl _ := by
  change (observationEquivAt
    (UpperGeometryCompatibleSourcePresentationChange.identity input) i).compatibleKernelEquiv = _
  rw [observationEquivAt_identity]
  simpa only [UpperGeometryCompatibleSourcePresentationChange.identity_changedInput] using
    (ObservationEquiv.compatibleKernelEquiv_refl
      (observationAt input i) (compatibleSubgroupAt input i))

/-- Identity presentation change acts identically on the pointed loss set. -/
theorem quotientEquivAt_identity
    (input : UpperGeometryCompatibleProblemInputData ctx P k)
    (i : P.Vertex) :
    quotientEquivAt
        (UpperGeometryCompatibleSourcePresentationChange.identity input) i =
      Equiv.refl _ := by
  change (observationEquivAt
    (UpperGeometryCompatibleSourcePresentationChange.identity input) i).quotientEquiv = _
  rw [observationEquivAt_identity]
  simpa only [UpperGeometryCompatibleSourcePresentationChange.identity_changedInput] using
    (ObservationEquiv.quotientEquiv_refl
      (observationAt input i) (compatibleSubgroupAt input i))

/-- The actual generated endpoint-pair action respects typed binary
composition.  The terminal-to-intermediate action is followed by the
intermediate-to-initial action. -/
theorem generatedEndpointPairMulEquivAt_comp
    (first : UpperGeometryCompatibleSourcePresentationChange input)
    (second : UpperGeometryCompatibleSourcePresentationChange
      first.changedInput)
    (i : P.Vertex) :
    (first.comp second).generatedEndpointPairMulEquivAt i =
      (second.generatedEndpointPairMulEquivAt i).trans
        (first.generatedEndpointPairMulEquivAt i) := by
  change MulEquiv.prodCongr
      (CompositeFiberAut.conjugationMulEquiv
        ((first.comp second).generatedBaseRouteExactGeometryIsoAt i))
      (CompositeFiberAut.conjugationMulEquiv
        ((first.comp second).generatedPulledRouteExactGeometryIsoAt i)) = _
  rw [UpperGeometryCompatibleSourcePresentationChange.generatedBaseRouteExactGeometryIsoAt_comp,
    UpperGeometryCompatibleSourcePresentationChange.generatedPulledRouteExactGeometryIsoAt_comp,
    ← CompositeFiberAut.conjugationMulEquiv_trans,
    ← CompositeFiberAut.conjugationMulEquiv_trans]
  rfl

/-- The endpoint action generated from the inverse presentation change is the
inverse of the original endpoint action. -/
theorem generatedEndpointPairMulEquivAt_inverse
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    change.inverse.generatedEndpointPairMulEquivAt i =
      (change.generatedEndpointPairMulEquivAt i).symm := by
  change MulEquiv.prodCongr
      (CompositeFiberAut.conjugationMulEquiv
        (change.inverse.generatedBaseRouteExactGeometryIsoAt i))
      (CompositeFiberAut.conjugationMulEquiv
        (change.inverse.generatedPulledRouteExactGeometryIsoAt i)) =
    (MulEquiv.prodCongr
      (CompositeFiberAut.conjugationMulEquiv
        (change.generatedBaseRouteExactGeometryIsoAt i))
      (CompositeFiberAut.conjugationMulEquiv
        (change.generatedPulledRouteExactGeometryIsoAt i))).symm
  rw [UpperGeometryCompatibleSourcePresentationChange.generatedBaseRouteExactGeometryIsoAt_inverse,
    UpperGeometryCompatibleSourcePresentationChange.generatedPulledRouteExactGeometryIsoAt_inverse]
  apply MulEquiv.ext
  intro pair
  apply Prod.ext
  · apply Subtype.ext
    apply Iso.ext
    rfl
  · apply Subtype.ext
    apply Iso.ext
    rfl

/-- The complete B4 observation diagram for an inverse presentation change is
the inverse observation-diagram equivalence. -/
theorem observationEquivAt_inverse
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    observationEquivAt change.inverse i =
      (observationEquivAt change i).symm := by
  apply ObservationEquiv.ext
  · exact generatedEndpointPairMulEquivAt_inverse change i
  · change coefficientObservationEquivAt change.inverse i =
      (coefficientObservationEquivAt change i).symm
    rw [coefficientObservationEquivAt_eq_refl,
      coefficientObservationEquivAt_eq_refl]
    rfl

/-- Inverse coherence also records reconstruction of the whole original
input, rather than only equality of the endpoint groups. -/
theorem inverse_coherence
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    change.inverse.changedInput = input ∧
      observationEquivAt change.inverse i =
        (observationEquivAt change i).symm :=
  ⟨change.inverse_changedInput, observationEquivAt_inverse change i⟩

/-- Kernel transport for an inverse presentation change is inverse transport. -/
theorem kernelEquivAt_inverse
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    kernelEquivAt change.inverse i = (kernelEquivAt change i).symm := by
  change (observationEquivAt change.inverse i).kernelEquiv = _
  rw [observationEquivAt_inverse, ObservationEquiv.kernelEquiv_symm]
  rfl

/-- Compatible-kernel transport for an inverse presentation change is inverse
transport. -/
theorem compatibleKernelEquivAt_inverse
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    compatibleKernelEquivAt change.inverse i =
      (compatibleKernelEquivAt change i).symm := by
  change (observationEquivAt change.inverse i).compatibleKernelEquiv = _
  rw [observationEquivAt_inverse,
    ObservationEquiv.compatibleKernelEquiv_symm]
  rfl

/-- Pointed loss transport for an inverse presentation change is inverse
transport. -/
theorem quotientEquivAt_inverse
    (change : UpperGeometryCompatibleSourcePresentationChange input)
    (i : P.Vertex) :
    quotientEquivAt change.inverse i = (quotientEquivAt change i).symm := by
  change (observationEquivAt change.inverse i).quotientEquiv = _
  rw [observationEquivAt_inverse, ObservationEquiv.quotientEquiv_symm]
  rfl

/-- The complete B4 observation diagram respects typed binary presentation
composition. -/
theorem observationEquivAt_comp
    (first : UpperGeometryCompatibleSourcePresentationChange input)
    (second : UpperGeometryCompatibleSourcePresentationChange
      first.changedInput)
    (i : P.Vertex) :
    observationEquivAt (first.comp second) i =
      (observationEquivAt second i).trans
        (observationEquivAt first i) := by
  apply ObservationEquiv.ext
  · exact generatedEndpointPairMulEquivAt_comp first second i
  · change coefficientObservationEquivAt (first.comp second) i =
      (coefficientObservationEquivAt second i).trans
        (coefficientObservationEquivAt first i)
    rw [coefficientObservationEquivAt_eq_refl,
      coefficientObservationEquivAt_eq_refl,
      coefficientObservationEquivAt_eq_refl]
    rfl

/-- Kernel transport respects typed binary presentation composition. -/
theorem kernelEquivAt_comp
    (first : UpperGeometryCompatibleSourcePresentationChange input)
    (second : UpperGeometryCompatibleSourcePresentationChange
      first.changedInput)
    (i : P.Vertex) :
    kernelEquivAt (first.comp second) i =
      (kernelEquivAt second i).trans (kernelEquivAt first i) := by
  change (observationEquivAt (first.comp second) i).kernelEquiv = _
  rw [observationEquivAt_comp, ObservationEquiv.kernelEquiv_trans]
  rfl

/-- Compatible-kernel transport respects typed binary presentation
composition. -/
theorem compatibleKernelEquivAt_comp
    (first : UpperGeometryCompatibleSourcePresentationChange input)
    (second : UpperGeometryCompatibleSourcePresentationChange
      first.changedInput)
    (i : P.Vertex) :
    compatibleKernelEquivAt (first.comp second) i =
      (compatibleKernelEquivAt second i).trans
        (compatibleKernelEquivAt first i) := by
  change (observationEquivAt (first.comp second) i).compatibleKernelEquiv = _
  rw [observationEquivAt_comp,
    ObservationEquiv.compatibleKernelEquiv_trans]
  rfl

/-- Pointed loss transport respects typed binary presentation composition. -/
theorem quotientEquivAt_comp
    (first : UpperGeometryCompatibleSourcePresentationChange input)
    (second : UpperGeometryCompatibleSourcePresentationChange
      first.changedInput)
    (i : P.Vertex) :
    quotientEquivAt (first.comp second) i =
      (quotientEquivAt second i).trans (quotientEquivAt first i) := by
  change (observationEquivAt (first.comp second) i).quotientEquiv = _
  rw [observationEquivAt_comp, ObservationEquiv.quotientEquiv_trans]
  rfl

/-- Linkwise finite-chain endpoint transport is literally the typed recursive
composition and also the transport freshly generated from the chain
composite.  This is the bridge from binary coherence to arbitrary finite
composition. -/
theorem chainEndpointPairMulEquivAt_coherence
    (chain : UpperGeometryCompatibleSourcePresentationChange.Chain input)
    (i : P.Vertex) :
    chain.pastedEndpointPairMulEquivAt i =
        chain.recursiveEndpointPairMulEquivAt i ∧
      chain.recursiveEndpointPairMulEquivAt i =
        chain.composite.generatedEndpointPairMulEquivAt i :=
  ⟨chain.pastedEndpointPairMulEquivAt_eq_recursive i,
    chain.recursiveEndpointPairMulEquivAt_eq_composite_generated i⟩

/-- Observation transport for a finite dependent chain is composed link by
link.  The C1s bridge below identifies this recursive action with both the
pasted endpoint action and the action freshly generated from the composite. -/
noncomputable def chainObservationEquivAt
    (chain : UpperGeometryCompatibleSourcePresentationChange.Chain input)
    (i : P.Vertex) :
    ObservationEquiv
      (observationAt chain.composite.changedInput i)
      (compatibleSubgroupAt chain.composite.changedInput i)
      (observationAt input i)
      (compatibleSubgroupAt input i) where
  changeEquiv := chain.pastedEndpointPairMulEquivAt i
  observationEquiv := MulEquiv.refl _
  observation_comm pair := by
    simpa only [MulEquiv.refl_apply] using
      chain.pastedEndpointPairMulEquivAt_coefficientObservation i pair
  compatible_map :=
    chain.pastedEndpointPairMulEquivAt_map_qualifiedComparisonSubgroup i

/-- The linkwise pasted observation diagram is exactly the diagram generated
from the structural chain composite. -/
theorem chainObservationEquivAt_eq_composite
    (chain : UpperGeometryCompatibleSourcePresentationChange.Chain input)
    (i : P.Vertex) :
    chainObservationEquivAt chain i =
      observationEquivAt chain.composite i := by
  apply ObservationEquiv.ext
  · exact
      (chain.pastedEndpointPairMulEquivAt_eq_recursive i).trans
        (chain.recursiveEndpointPairMulEquivAt_eq_composite_generated i)
  · exact (coefficientObservationEquivAt_eq_refl chain.composite i).symm

/-- The empty presentation-change chain gives the identity observation
diagram. -/
theorem chainObservationEquivAt_nil
    (input : UpperGeometryCompatibleProblemInputData ctx P k)
    (i : P.Vertex) :
    chainObservationEquivAt
        (UpperGeometryCompatibleSourcePresentationChange.Chain.nil input) i =
      ObservationEquiv.refl
        (observationAt input i) (compatibleSubgroupAt input i) := by
  apply ObservationEquiv.ext
  · exact
      ((UpperGeometryCompatibleSourcePresentationChange.Chain.nil input).pastedEndpointPairMulEquivAt_eq_recursive
        i).trans
        (UpperGeometryCompatibleSourcePresentationChange.Chain.recursiveEndpointPairMulEquivAt_nil
          input i)
  · rfl

/-- Observation transport for a cons chain is the typed composition of tail
transport followed by head transport. -/
theorem chainObservationEquivAt_cons
    (head : UpperGeometryCompatibleSourcePresentationChange input)
    (tail : UpperGeometryCompatibleSourcePresentationChange.Chain
      head.changedInput)
    (i : P.Vertex) :
    chainObservationEquivAt
        (UpperGeometryCompatibleSourcePresentationChange.Chain.cons head tail) i =
      (chainObservationEquivAt tail i).trans
        (observationEquivAt head i) := by
  rw [chainObservationEquivAt_eq_composite]
  change observationEquivAt (head.comp tail.composite) i = _
  rw [observationEquivAt_comp, chainObservationEquivAt_eq_composite]

/-- Finite-chain transport on `K_c`. -/
noncomputable def chainKernelEquivAt
    (chain : UpperGeometryCompatibleSourcePresentationChange.Chain input)
    (i : P.Vertex) :
    observationKernelAt chain.composite.changedInput i ≃*
      observationKernelAt input i :=
  (chainObservationEquivAt chain i).kernelEquiv

/-- Finite-chain transport on `L_c`. -/
noncomputable def chainCompatibleKernelEquivAt
    (chain : UpperGeometryCompatibleSourcePresentationChange.Chain input)
    (i : P.Vertex) :
    compatibleKernelAt chain.composite.changedInput i ≃*
      compatibleKernelAt input i :=
  (chainObservationEquivAt chain i).compatibleKernelEquiv

/-- Finite-chain pointed transport on the left-coset loss set. -/
noncomputable def chainQuotientEquivAt
    (chain : UpperGeometryCompatibleSourcePresentationChange.Chain input)
    (i : P.Vertex) :
    observationLossAt chain.composite.changedInput i ≃
      observationLossAt input i :=
  (chainObservationEquivAt chain i).quotientEquiv

/-- Empty-chain kernel transport is the identity. -/
theorem chainKernelEquivAt_nil
    (input : UpperGeometryCompatibleProblemInputData ctx P k)
    (i : P.Vertex) :
    chainKernelEquivAt
        (UpperGeometryCompatibleSourcePresentationChange.Chain.nil input) i =
      MulEquiv.refl _ := by
  change ObservationEquiv.kernelEquiv (chainObservationEquivAt
    (UpperGeometryCompatibleSourcePresentationChange.Chain.nil input) i) = _
  rw [chainObservationEquivAt_nil]
  simpa only [UpperGeometryCompatibleSourcePresentationChange.Chain.composite,
    UpperGeometryCompatibleSourcePresentationChange.identity_changedInput] using
      (ObservationEquiv.kernelEquiv_refl
        (observationAt input i) (compatibleSubgroupAt input i))

/-- Kernel transport for a cons chain is typed linkwise composition. -/
theorem chainKernelEquivAt_cons
    (head : UpperGeometryCompatibleSourcePresentationChange input)
    (tail : UpperGeometryCompatibleSourcePresentationChange.Chain
      head.changedInput)
    (i : P.Vertex) :
    chainKernelEquivAt
        (UpperGeometryCompatibleSourcePresentationChange.Chain.cons head tail) i =
      (chainKernelEquivAt tail i).trans (kernelEquivAt head i) := by
  change ObservationEquiv.kernelEquiv (chainObservationEquivAt
    (UpperGeometryCompatibleSourcePresentationChange.Chain.cons head tail) i) = _
  rw [chainObservationEquivAt_cons, ObservationEquiv.kernelEquiv_trans]
  rfl

/-- Empty-chain compatible-kernel transport is the identity. -/
theorem chainCompatibleKernelEquivAt_nil
    (input : UpperGeometryCompatibleProblemInputData ctx P k)
    (i : P.Vertex) :
    chainCompatibleKernelEquivAt
        (UpperGeometryCompatibleSourcePresentationChange.Chain.nil input) i =
      MulEquiv.refl _ := by
  change ObservationEquiv.compatibleKernelEquiv (chainObservationEquivAt
    (UpperGeometryCompatibleSourcePresentationChange.Chain.nil input) i) = _
  rw [chainObservationEquivAt_nil]
  simpa only [UpperGeometryCompatibleSourcePresentationChange.Chain.composite,
    UpperGeometryCompatibleSourcePresentationChange.identity_changedInput] using
      (ObservationEquiv.compatibleKernelEquiv_refl
        (observationAt input i) (compatibleSubgroupAt input i))

/-- Compatible-kernel transport for a cons chain is typed linkwise
composition. -/
theorem chainCompatibleKernelEquivAt_cons
    (head : UpperGeometryCompatibleSourcePresentationChange input)
    (tail : UpperGeometryCompatibleSourcePresentationChange.Chain
      head.changedInput)
    (i : P.Vertex) :
    chainCompatibleKernelEquivAt
        (UpperGeometryCompatibleSourcePresentationChange.Chain.cons head tail) i =
      (chainCompatibleKernelEquivAt tail i).trans
        (compatibleKernelEquivAt head i) := by
  change ObservationEquiv.compatibleKernelEquiv (chainObservationEquivAt
    (UpperGeometryCompatibleSourcePresentationChange.Chain.cons head tail) i) = _
  rw [chainObservationEquivAt_cons,
    ObservationEquiv.compatibleKernelEquiv_trans]
  rfl

/-- Empty-chain pointed loss transport is the identity. -/
theorem chainQuotientEquivAt_nil
    (input : UpperGeometryCompatibleProblemInputData ctx P k)
    (i : P.Vertex) :
    chainQuotientEquivAt
        (UpperGeometryCompatibleSourcePresentationChange.Chain.nil input) i =
      Equiv.refl _ := by
  change ObservationEquiv.quotientEquiv (chainObservationEquivAt
    (UpperGeometryCompatibleSourcePresentationChange.Chain.nil input) i) = _
  rw [chainObservationEquivAt_nil]
  simpa only [UpperGeometryCompatibleSourcePresentationChange.Chain.composite,
    UpperGeometryCompatibleSourcePresentationChange.identity_changedInput] using
      (ObservationEquiv.quotientEquiv_refl
        (observationAt input i) (compatibleSubgroupAt input i))

/-- Pointed loss transport for a cons chain is typed linkwise composition. -/
theorem chainQuotientEquivAt_cons
    (head : UpperGeometryCompatibleSourcePresentationChange input)
    (tail : UpperGeometryCompatibleSourcePresentationChange.Chain
      head.changedInput)
    (i : P.Vertex) :
    chainQuotientEquivAt
        (UpperGeometryCompatibleSourcePresentationChange.Chain.cons head tail) i =
      (chainQuotientEquivAt tail i).trans (quotientEquivAt head i) := by
  change ObservationEquiv.quotientEquiv (chainObservationEquivAt
    (UpperGeometryCompatibleSourcePresentationChange.Chain.cons head tail) i) = _
  rw [chainObservationEquivAt_cons, ObservationEquiv.quotientEquiv_trans]
  rfl

/-- The pasted finite-chain action is the action generated by the structural
composite, exposed at the observation-diagram level. -/
theorem chainObservationEquivAt_changeEquiv_eq_composite
    (chain : UpperGeometryCompatibleSourcePresentationChange.Chain input)
    (i : P.Vertex) :
    (chainObservationEquivAt chain i).changeEquiv =
      chain.composite.generatedEndpointPairMulEquivAt i :=
  congrArg ObservationEquiv.changeEquiv
    (chainObservationEquivAt_eq_composite chain i)

/-- Finite-chain kernel transport agrees with transport generated from the
structural composite change. -/
theorem chainKernelEquivAt_eq_composite
    (chain : UpperGeometryCompatibleSourcePresentationChange.Chain input)
    (i : P.Vertex) :
    chainKernelEquivAt chain i = kernelEquivAt chain.composite i := by
  apply MulEquiv.ext
  intro value
  apply Subtype.ext
  exact congrArg (fun equiv => equiv value)
    (chainObservationEquivAt_changeEquiv_eq_composite chain i)

/-- Finite-chain compatible-kernel transport agrees with transport generated
from the structural composite change. -/
theorem chainCompatibleKernelEquivAt_eq_composite
    (chain : UpperGeometryCompatibleSourcePresentationChange.Chain input)
    (i : P.Vertex) :
    chainCompatibleKernelEquivAt chain i =
      compatibleKernelEquivAt chain.composite i := by
  apply MulEquiv.ext
  intro value
  apply Subtype.ext
  apply Subtype.ext
  exact congrArg (fun equiv => equiv value)
    (chainObservationEquivAt_changeEquiv_eq_composite chain i)

/-- Finite-chain pointed loss transport agrees with transport generated from
the structural composite change. -/
theorem chainQuotientEquivAt_eq_composite
    (chain : UpperGeometryCompatibleSourcePresentationChange.Chain input)
    (i : P.Vertex) :
    chainQuotientEquivAt chain i = quotientEquivAt chain.composite i := by
  apply Equiv.ext
  intro loss
  refine QuotientGroup.induction_on loss (fun value => ?_)
  change QuotientGroup.mk (chainKernelEquivAt chain i value) =
    QuotientGroup.mk (kernelEquivAt chain.composite i value)
  rw [chainKernelEquivAt_eq_composite]

/-- Full source-endpoint transport along a finite dependent chain. -/
noncomputable def chainSourceEndpointEquivAt
    (chain : UpperGeometryCompatibleSourcePresentationChange.Chain input)
    (i : P.Vertex) :
    CompositeFiberAut
        (chain.composite.changedInput.generatedBaseRouteGeometryAt i) ≃*
      CompositeFiberAut (input.generatedBaseRouteGeometryAt i) :=
  sourceEndpointEquivAt chain.composite i

/-- Full target-endpoint transport along a finite dependent chain. -/
noncomputable def chainTargetEndpointEquivAt
    (chain : UpperGeometryCompatibleSourcePresentationChange.Chain input)
    (i : P.Vertex) :
    CompositeFiberAut
        (chain.composite.changedInput.generatedPulledRouteGeometryAt i) ≃*
      CompositeFiberAut (input.generatedPulledRouteGeometryAt i) :=
  targetEndpointEquivAt chain.composite i

/-- Empty-chain source endpoint transport is the identity. -/
theorem chainSourceEndpointEquivAt_nil
    (input : UpperGeometryCompatibleProblemInputData ctx P k)
    (i : P.Vertex) :
    chainSourceEndpointEquivAt
        (UpperGeometryCompatibleSourcePresentationChange.Chain.nil input) i =
      MulEquiv.refl _ :=
  sourceEndpointEquivAt_identity input i

/-- Empty-chain target endpoint transport is the identity. -/
theorem chainTargetEndpointEquivAt_nil
    (input : UpperGeometryCompatibleProblemInputData ctx P k)
    (i : P.Vertex) :
    chainTargetEndpointEquivAt
        (UpperGeometryCompatibleSourcePresentationChange.Chain.nil input) i =
      MulEquiv.refl _ :=
  targetEndpointEquivAt_identity input i

/-- The finite-chain source endpoint action is the recursively composed action
of every actual link. -/
theorem chainSourceEndpointEquivAt_coe_eq_recursive
    (chain : UpperGeometryCompatibleSourcePresentationChange.Chain input)
    (i : P.Vertex)
    (value : CompositeFiberAut
      (chain.composite.changedInput.generatedBaseRouteGeometryAt i)) :
    chainSourceEndpointEquivAt chain i value =
      (chain.recursiveEndpointPairMulEquivAt i
        (value, (1 : CompositeFiberAut
          (chain.composite.changedInput.generatedPulledRouteGeometryAt i)))).1 := by
  change
    (chain.composite.generatedEndpointPairMulEquivAt i
      (value, (1 : CompositeFiberAut
        (chain.composite.changedInput.generatedPulledRouteGeometryAt i)))).1 = _
  rw [← chain.recursiveEndpointPairMulEquivAt_eq_composite_generated]

/-- The finite-chain target endpoint action is the recursively composed action
of every actual link. -/
theorem chainTargetEndpointEquivAt_coe_eq_recursive
    (chain : UpperGeometryCompatibleSourcePresentationChange.Chain input)
    (i : P.Vertex)
    (value : CompositeFiberAut
      (chain.composite.changedInput.generatedPulledRouteGeometryAt i)) :
    chainTargetEndpointEquivAt chain i value =
      (chain.recursiveEndpointPairMulEquivAt i
        ((1 : CompositeFiberAut
          (chain.composite.changedInput.generatedBaseRouteGeometryAt i)), value)).2 := by
  change
    (chain.composite.generatedEndpointPairMulEquivAt i
      ((1 : CompositeFiberAut
        (chain.composite.changedInput.generatedBaseRouteGeometryAt i)), value)).2 = _
  rw [← chain.recursiveEndpointPairMulEquivAt_eq_composite_generated]

/-- Full comparison conjugation is natural along an arbitrary finite
presentation-change chain. -/
theorem chainEndpointConjugation_naturality
    (chain : UpperGeometryCompatibleSourcePresentationChange.Chain input)
    (i : P.Vertex)
    (value : CompositeFiberAut
      (chain.composite.changedInput.generatedBaseRouteGeometryAt i)) :
    chainTargetEndpointEquivAt chain i
        (endpointChangeEquivAt chain.composite.changedInput i value) =
      endpointChangeEquivAt input i
        (chainSourceEndpointEquivAt chain i value) :=
  endpointConjugation_naturality chain.composite i value

/-- Full finite-chain comparison naturality in the fixed target's
initial-to-final orientation. -/
theorem chainEndpointConjugation_inverse_naturality
    (chain : UpperGeometryCompatibleSourcePresentationChange.Chain input)
    (i : P.Vertex)
    (value : CompositeFiberAut (input.generatedBaseRouteGeometryAt i)) :
    endpointChangeEquivAt chain.composite.changedInput i
        ((chainSourceEndpointEquivAt chain i).symm value) =
      (chainTargetEndpointEquivAt chain i).symm
        (endpointChangeEquivAt input i value) :=
  endpointConjugation_inverse_naturality chain.composite i value

