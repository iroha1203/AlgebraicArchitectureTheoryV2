import ResearchLean.AG.ObstructionDiagnosticBridge.FiniteContextSupport
import Formal.AG.Site.Geometry
import Formal.Util.AssertStandardAxioms

/-!
# Point-Atom provenance for the selected G-125 context supports

The eight points of the selected finite space are represented directly by
Atoms.  An open context reads exactly the point Atoms in its open.  For
arbitrary contexts, support is the
interior of the set of readable point Atoms.  This makes support functorial
for the canonical restriction-morphism preorder without assuming that an
arbitrary context already carries an open set.

Implementation notes: the interior construction is the one fixed by the
paper design.  Attaching an open set as context extension data was rejected:
it would let the support conclusion be supplied independently of the point
Atom readings.  With the present definition, product contexts compute open
intersection from the existing `Site.productContext` reading conjunction.

This cycle isolates the point-support clause of Issue #4791 section 10.
Accordingly, the equation and signature index types below are empty and the
boundary predicate is true: among the four requirement clauses, only coverage
of all eight point Atoms is nonvacuous.  An admissible cover also proves the
independent `nonGeneration` condition.  Adding placeholder Law coordinates was
rejected because it would not provide the later primitive-generator
provenance.  That integration requires a separate construction before this
point-only site can be used as the full G-125 input.
-/

noncomputable section

open CategoryTheory Set TopologicalSpace

namespace AAT.AG.ObstructionDiagnosticBridge
namespace PointAtomContextSupport

open SelectedFiniteGeometry

/-- Atom carrier for the selected finite G-125 geometry. -/
def carrier : AtomCarrier where
  AtomKind := Unit
  Axis := Unit
  Subject := Unit
  Predicate := Unit
  Payload := Unit
  Atom := Point
  kind := fun _ => ()
  axis := fun _ => ()
  subject := fun _ => ()
  predicate := fun _ => ()
  payload := fun _ => ()

/-- Architecture object generated by all eight selected point Atoms. -/
def object : ArchitectureObject carrier where
  configuration := {
    family := ⟨fun _ => True⟩
    relation := fun _ _ => False
    identification := fun _ _ => False
  }
  StructureMaps := Unit
  SelectedQuantities := Unit
  structureMaps := ()
  selectedQuantities := ()

/-- A context whose point-Atom readings are exactly a selected open support. -/
def openContext (W : Opens Space) : Site.ArchCtx object where
  minimal := {
    Support := Unit
    Axis := Unit
    Observable := Unit
    supportReads := fun _ point => point ∈ W
    supportReads_objectFamily := by simp [object]
    axisReads := fun _ => True
    observableReads := fun _ => True
  }
  Extension := Unit
  extension := ()

/-- Readable point Atoms of an arbitrary context. -/
def readablePointSet (W : Site.ArchCtx object) : Set Space :=
  {x | ∃ support : W.Support, W.minimal.supportReads support x}

/-- Open support derived from readable point Atoms. -/
def contextSupport (W : Site.ArchCtx object) : Opens Space :=
  Opens.interior (readablePointSet W)

/-- A restriction morphism makes the readable point set monotone. -/
theorem readablePointSet_mono {W V : Site.ArchCtx object}
    (f : Site.ContextMorphism W V) (hf : f.IsRestriction) :
    readablePointSet W ⊆ readablePointSet V := by
  rintro x ⟨support, hsupport⟩
  exact ⟨f.supportMap support, hf.1 hsupport⟩

/-- A restriction morphism induces inclusion of the derived open supports. -/
theorem contextSupport_mono {W V : Site.ArchCtx object}
    (f : Site.ContextMorphism W V) (hf : f.IsRestriction) :
    contextSupport W ≤ contextSupport V :=
  interior_mono (readablePointSet_mono f hf)

/-- The canonical thin category of actual restriction context morphisms. -/
noncomputable abbrev contextPreorder :=
  Site.contextMorphismPreorderCategory object

/-- Point-Atom support as a functor from selected AAT contexts to opens. -/
def supportFunctor : Site.ContextCategoryObject contextPreorder ⥤ Opens Space where
  obj W := contextSupport W.ctx
  map f := by
    apply homOfLE
    exact contextSupport_mono
      (contextPreorder.morphism (leOfHom f))
      (contextPreorder.morphism_isRestriction (leOfHom f))
  map_id _ := Subsingleton.elim _ _
  map_comp _ _ := Subsingleton.elim _ _

/-- An open context recovers its open from its point-Atom readings. -/
@[simp]
theorem contextSupport_openContext (W : Opens Space) :
    contextSupport (openContext W) = W := by
  ext x
  change x ∈ interior (readablePointSet (openContext W)) ↔ x ∈ W
  rw [show readablePointSet (openContext W) = (W : Set Space) by
    ext y
    constructor
    · rintro ⟨_support, hsupport⟩
      exact hsupport
    · intro hy
      exact ⟨(), hy⟩]
  rw [W.isOpen.interior_eq]
  rfl

/-- The readable point set of a product context is the intersection of the factors. -/
theorem readablePointSet_product (W V : Site.ArchCtx object) :
    readablePointSet (Site.productContext W V) =
      readablePointSet W ∩ readablePointSet V := by
  ext x
  constructor
  · rintro ⟨⟨left, right⟩, hleft, hright⟩
    exact ⟨⟨left, hleft⟩, ⟨right, hright⟩⟩
  · rintro ⟨⟨left, hleft⟩, ⟨right, hright⟩⟩
    exact ⟨⟨left, right⟩, hleft, hright⟩

/-- Product context support is intersection for arbitrary architecture contexts. -/
@[simp]
theorem contextSupport_product (W V : Site.ArchCtx object) :
    contextSupport (Site.productContext W V) = contextSupport W ⊓ contextSupport V := by
  ext x
  change x ∈ interior
      (readablePointSet (Site.productContext W V)) ↔
    x ∈ interior (readablePointSet W) ∧ x ∈ interior (readablePointSet V)
  rw [readablePointSet_product, interior_inter]
  rfl

/-- The general product formula specializes to the selected open contexts. -/
@[simp]
theorem contextSupport_product_openContext (W V : Opens Space) :
    contextSupport (Site.productContext (openContext W) (openContext V)) = W ⊓ V := by
  rw [contextSupport_product, contextSupport_openContext, contextSupport_openContext]

/-- Inclusion of opens gives an actual restriction between their contexts. -/
def openContextMorphism {W V : Opens Space} (_h : W ≤ V) :
    Site.ContextMorphism (openContext W) (openContext V) where
  supportMap := id
  axisMap := id
  observableRestrict := id

/-- The open-context morphism is a restriction precisely by Atom readability. -/
theorem openContextMorphism_isRestriction {W V : Opens Space} (h : W ≤ V) :
    (openContextMorphism h).IsRestriction := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro support atom hatom
    exact h hatom
  · intro axis haxis
    exact haxis
  · intro observable hobservable
    exact hobservable
  · intro support atom hatom
    trivial

/-- Inclusion of opens is represented in the canonical context preorder. -/
theorem openContext_le {W V : Opens Space} (h : W ≤ V) :
    contextPreorder.le (openContext W) (openContext V) :=
  ⟨openContextMorphism h, openContextMorphism_isRestriction h⟩

/-- Empty equation component of the point-support-only geometric site. -/
def equationSystem : ArchitecturalEquationSystem contextPreorder where
  Index := Empty
  role := Empty.elim
  Observable := fun _ => Int
  observableCommRing := fun _ => inferInstance
  restrict := fun _ => RingHom.id Int
  restrict_id := by intros; rfl
  restrict_comp := by intros; rfl
  violationCoordinate := fun _ index => nomatch index
  violationCoordinate_restrict := by intros; contradiction
  equationResidual := fun _ _ index => nomatch index
  equationResidual_restrict := by intros; contradiction

/-- Empty signature component; this cycle's coverage is carried by point Atoms. -/
def signature : ArchitectureSignature carrier where
  Axis := Empty
  Coordinate := Empty.elim
  selected := Empty.elim
  coordinate := fun _ axis => nomatch axis

/-- Coverage requires every point Atom to occur in the derived open support.

The equation, violation, and axis clauses are empty, and boundary visibility is
true.  Thus among the four requirement clauses only `atomSupportCoverage` is
nonvacuous.  `AdmissibleCover.nonGeneration` remains a separate obligation.
-/
def coverageRequirements :
    Site.CoverageRequirements object equationSystem signature where
  requiredSupport := fun _ => True
  requiredEquationCoordinate := fun coordinate => nomatch coordinate.1.1
  selectedViolationWitness := fun coordinate => nomatch coordinate.1
  requiredAxis := Empty.elim
  supportVisibleOn := fun W point => point ∈ contextSupport W
  equationCoordinateVisibleOn := fun _ coordinate => nomatch coordinate.1.1
  violationWitnessVisibleOn := fun _ coordinate => nomatch coordinate.1
  axisReadableOn := fun _ axis => nomatch axis
  boundaryVisibleOn := fun _ _ => True

/-- Product contexts provide the actual overlap object. -/
noncomputable def overlap : Site.ContextOverlapPullback contextPreorder :=
  Site.meetOverlapPullback contextPreorder Site.productContextFiniteMeet

/-- The point-support-only AAT site for the selected finite geometry. -/
noncomputable def site : Site.AATSite object where
  contextPreorder := contextPreorder
  equationSystem := equationSystem
  signature := signature
  requirements := coverageRequirements
  overlap := overlap

/-- The full-space base context. -/
def baseContext : Site.ArchCtx object := openContext ⊤

/-- The coarse three-patch context family. -/
def coarseCoverageFamily : Site.CoverageFamily contextPreorder where
  base := baseContext
  Index := CoarseChart
  patch chart := openContext (coarsePatch chart)
  inclusion _chart := openContext_le le_top

/-- The fine four-patch context family. -/
def fineCoverageFamily : Site.CoverageFamily contextPreorder where
  base := baseContext
  Index := FineChart
  patch chart := openContext (finePatch chart)
  inclusion _chart := openContext_le le_top

/-- Point-Atom coverage makes the coarse family an actual admissible AAT cover. -/
theorem coarseCoverageFamily_admissible :
    Site.AdmissibleCover coverageRequirements overlap coarseCoverageFamily := by
  refine {
    atomSupportCoverage := ?_
    equationCoordinateCoverage := ?_
    violationWitnessCoverage := ?_
    signatureAxisCoverage := ?_
    boundaryCoverage := ?_
    nonGeneration := ?_
  }
  · intro atom hatom
    obtain ⟨chart, hx⟩ := coarse_cover atom
    exact ⟨chart, by simpa [coverageRequirements, coarseCoverageFamily] using hx⟩
  · intro coordinate
    exact Empty.elim coordinate.1.1
  · intro coordinate
    exact Empty.elim coordinate.1
  · intro axis
    exact Empty.elim axis
  · intros
    trivial
  · intro chart
    exact coarseCoverageFamily.inclusion_nonGenerating chart

/-- Point-Atom coverage makes the fine family an actual admissible AAT cover. -/
theorem fineCoverageFamily_admissible :
    Site.AdmissibleCover coverageRequirements overlap fineCoverageFamily := by
  refine {
    atomSupportCoverage := ?_
    equationCoordinateCoverage := ?_
    violationWitnessCoverage := ?_
    signatureAxisCoverage := ?_
    boundaryCoverage := ?_
    nonGeneration := ?_
  }
  · intro atom hatom
    obtain ⟨chart, hx⟩ := fine_cover atom
    exact ⟨chart, by simpa [coverageRequirements, fineCoverageFamily] using hx⟩
  · intro coordinate
    exact Empty.elim coordinate.1.1
  · intro coordinate
    exact Empty.elim coordinate.1
  · intro axis
    exact Empty.elim axis
  · intros
    trivial
  · intro chart
    exact fineCoverageFamily.inclusion_nonGenerating chart

/-- Every coarse patch support is derived from the corresponding point Atoms. -/
@[simp]
theorem supportFunctor_coarse_patch (chart : CoarseChart) :
    supportFunctor.obj
        (Site.ContextCategoryObject.of contextPreorder
          (coarseCoverageFamily.patch chart)) = coarsePatch chart := by
  exact contextSupport_openContext _

/-- Every fine patch support is derived from the corresponding point Atoms. -/
@[simp]
theorem supportFunctor_fine_patch (chart : FineChart) :
    supportFunctor.obj
        (Site.ContextCategoryObject.of contextPreorder
          (fineCoverageFamily.patch chart)) = finePatch chart := by
  exact contextSupport_openContext _

/-- Any admissible family maps to a genuine pointwise open cover. -/
theorem admissible_support_covers
    {F : Site.CoverageFamily contextPreorder}
    (hF : Site.AdmissibleCover coverageRequirements overlap F)
    (x : Space) :
    ∃ i : F.Index,
      x ∈ supportFunctor.obj
        (Site.ContextCategoryObject.of contextPreorder (F.patch i)) := by
  obtain ⟨i, hi⟩ := hF.atomSupportCoverage x trivial
  exact ⟨i, hi⟩

#assert_standard_axioms_only
  AAT.AG.ObstructionDiagnosticBridge.PointAtomContextSupport

end PointAtomContextSupport
end AAT.AG.ObstructionDiagnosticBridge
