import ResearchLean.AG.ObstructionDiagnosticBridge.CombinedAtomH1Input
import ResearchLean.AG.ObstructionDiagnosticBridge.SpecifiedAffineObstruction
import Formal.Util.AssertStandardAxioms

/-!
# Selected affine obstruction and diagnostic classes on the combined site

The general affine mismatch package is instantiated at both selected readings.
The coarse and fine local-data types use the actual combined-site Cech covers,
the shared primitive presentation, and the corresponding selected adequacy
witness.  This exposes the G-125(B1) class correspondence and zero preservation
at the same input surface used by Cycle 17.

## Implementation notes

No local transition values are fixed in this module: B1 quantifies over every
allowed primitive transition and chart state.  Concrete zero and nonzero data
belong to the finite-example obligation.  The diagnostic cocycle is always
computed from the Law-value evaluations of the same transition and chart state;
it is not an independent field.  Its equality with the selected cochain-map
image is proved by the general package rather than made definitional.
-/

noncomputable section

namespace AAT.AG.ObstructionDiagnosticBridge
namespace CombinedAtomSpecifiedObstruction

open Cohomology TwoPhase
open PointAtomLawInput

/-- Allowed fine-reading affine local data on the actual combined-site cover. -/
abbrev FineLocalData :=
  presentation.ActualCechAffineLocalData CombinedAtomActualNerve.fineCechCover

/-- Allowed coarse-reading affine local data on the actual combined-site cover. -/
abbrev CoarseLocalData :=
  presentation.ActualCechAffineLocalData CombinedAtomActualNerve.coarseCechCover

/-- Fine actual obstruction cocycle generated by the local affine data. -/
def fineActualCocycle (x : FineLocalData) := x.actualCocycle

/-- Coarse actual obstruction cocycle generated by the local affine data. -/
def coarseActualCocycle (x : CoarseLocalData) := x.actualCocycle

/-- Fine law-value diagnostic cocycle generated from the same mismatch. -/
def fineDiagnosticCocycle (x : FineLocalData) := x.diagnosticCocycle fine_adequate

/-- Coarse law-value diagnostic cocycle generated from the same mismatch. -/
def coarseDiagnosticCocycle (x : CoarseLocalData) := x.diagnosticCocycle coarse_adequate

/-- Fine actual obstruction class generated by the local affine data. -/
def fineActualClass (x : FineLocalData) := x.actualClass

/-- Coarse actual obstruction class generated by the local affine data. -/
def coarseActualClass (x : CoarseLocalData) := x.actualClass

/-- Fine diagnostic class generated from the same local affine data. -/
def fineDiagnosticClass (x : FineLocalData) := x.diagnosticClass fine_adequate

/-- Coarse diagnostic class generated from the same local affine data. -/
def coarseDiagnosticClass (x : CoarseLocalData) := x.diagnosticClass coarse_adequate

/-- Selected fine-reading instance of G-125(B1)'s class correspondence. -/
theorem fine_h1_map_actual_class_eq_diagnostic_class (x : FineLocalData) :
    CombinedAtomH1Input.fineH1Map (fineActualClass x) =
      fineDiagnosticClass x :=
  x.h1_map_actual_class_eq_diagnostic_class fine_adequate

/-- Selected coarse-reading instance of G-125(B1)'s class correspondence. -/
theorem coarse_h1_map_actual_class_eq_diagnostic_class (x : CoarseLocalData) :
    CombinedAtomH1Input.coarseH1Map (coarseActualClass x) =
      coarseDiagnosticClass x :=
  x.h1_map_actual_class_eq_diagnostic_class coarse_adequate

/-- Fine obstruction-class vanishing implies fine diagnostic-class vanishing. -/
theorem fine_diagnostic_class_eq_zero_of_actual_class_eq_zero (x : FineLocalData)
    (hzero : fineActualClass x = 0) : fineDiagnosticClass x = 0 :=
  x.diagnostic_class_eq_zero_of_actual_class_eq_zero fine_adequate hzero

/-- Coarse obstruction-class vanishing implies coarse diagnostic-class vanishing. -/
theorem coarse_diagnostic_class_eq_zero_of_actual_class_eq_zero
    (x : CoarseLocalData) (hzero : coarseActualClass x = 0) :
    coarseDiagnosticClass x = 0 :=
  x.diagnostic_class_eq_zero_of_actual_class_eq_zero coarse_adequate hzero

#assert_standard_axioms_only
  AAT.AG.ObstructionDiagnosticBridge.CombinedAtomSpecifiedObstruction

end CombinedAtomSpecifiedObstruction
end AAT.AG.ObstructionDiagnosticBridge
