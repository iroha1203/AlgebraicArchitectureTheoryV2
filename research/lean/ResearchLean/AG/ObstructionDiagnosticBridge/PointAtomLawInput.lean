import ResearchLean.AG.ObstructionDiagnosticBridge.PointAtomActualNerve
import ResearchLean.AG.ObstructionDiagnosticBridge.GeneratorPresentation
import Formal.Util.AssertStandardAxioms

/-!
# Selected Law input for the point-Atom obstruction bridge

This module fixes the Law side of the selected finite example.  The source is
`Bool × Bool`, the unique Law reads the first coordinate, the coarse reading
retains exactly that coordinate, and the fine reading retains both.  Thus the
same nonconstant Law is adequate for both readings while the canonical factor
from the fine target to the coarse target is not injective.

The primitive presentation separately lists the two undirected source edges
from the paper design.  Its reflection condition is proved by exhausting the
four source points and constructing paths in those declared edges; it is not
stored as a field or defined by label equality or the desired cohomology
conclusion.
-/

noncomputable section

namespace AAT.AG.ObstructionDiagnosticBridge
namespace PointAtomLawInput

open CanonicalResolution ResolutionInvariance
open PointAtomActualNerve

/-- The selected nonconstant Law evaluates the first Boolean source coordinate. -/
def laws : FiniteLawFamily Source where
  Law := PUnit
  lawFintype := inferInstance
  Value := fun _ => Bool
  valueDecidableEq := fun _ => inferInstance
  eval := fun _ source => source.1

/-- The selected Law descends through the coarse reading by the identity map. -/
theorem coarse_adequate : laws.Adequate coarseReading := by
  intro law
  cases law
  exact ⟨id, fun _ => rfl⟩

/-- The selected Law descends through the fine reading by first projection. -/
theorem fine_adequate : laws.Adequate fineReading := by
  intro law
  cases law
  exact ⟨Prod.fst, fun _ => rfl⟩

/-- The coarse reading is coarser than the identity fine reading. -/
theorem coarse_coarser_fine : coarseReading.CoarserThan fineReading := by
  intro left right heq
  change left = right at heq
  subst right
  rfl

/-- The canonical comparison factor is first projection. -/
theorem comparisonFactor_eq_fst :
    comparisonFactor coarseReading fineReading coarse_coarser_fine = Prod.fst := by
  symm
  apply comparisonFactor_unique coarseReading fineReading coarse_coarser_fine
  intro source
  rfl

/-- The canonical factor identifies the two hidden-coordinate values. -/
theorem comparisonFactor_not_injective :
    ¬ Function.Injective
      (comparisonFactor coarseReading fineReading coarse_coarser_fine) := by
  intro hinjective
  have hsame :
      comparisonFactor coarseReading fineReading coarse_coarser_fine
          (false, false) =
        comparisonFactor coarseReading fineReading coarse_coarser_fine
          (false, true) := by
    rw [comparisonFactor_eq_fst]
  exact Bool.noConfusion (congrArg Prod.snd (hinjective hsame))

/-- The declared Law distinguishes the two visible Boolean values. -/
theorem law_nonconstant :
    ∃ law left right, laws.eval law left ≠ laws.eval law right := by
  exact ⟨PUnit.unit, (false, false), (true, false), by decide⟩

/-- The two undirected primitive source edges `g00--g01` and `g10--g11`. -/
def sourceRelation : Source → Source → Prop
  | (false, false), (false, true)
  | (false, true), (false, false)
  | (true, false), (true, true)
  | (true, true), (true, false) => True
  | _, _ => False

/-- Selected primitive presentation generated by the two explicitly listed edges. -/
def presentation : GeneratorPresentation laws where
  relation := fun left right => sourceRelation left.2 right.2
  relation_preserves_label := by
    rintro ⟨⟨⟩, ⟨leftVisible, leftHidden⟩⟩
      ⟨⟨⟩, ⟨rightVisible, rightHidden⟩⟩ hrelation
    cases leftVisible <;> cases leftHidden <;>
      cases rightVisible <;> cases rightHidden <;>
      simp_all [sourceRelation, PrimitiveGenerator.label,
        LawValueLabel.ofSource, laws]

/-- The explicit primitive relations satisfy the structural reflection condition. -/
theorem presentation_reflectionCondition : presentation.ReflectionCondition := by
  rintro ⟨⟨⟩, ⟨leftVisible, leftHidden⟩⟩
    ⟨⟨⟩, ⟨rightVisible, rightHidden⟩⟩ hlabel
  have hvisible : leftVisible = rightVisible :=
    congrArg (fun label : LawValueLabel laws => label.value) hlabel
  subst rightVisible
  cases leftVisible <;> cases leftHidden <;> cases rightHidden
  · exact Relation.EqvGen.refl _
  · apply Relation.EqvGen.rel
    simp [presentation, sourceRelation]
  · apply Relation.EqvGen.rel
    simp [presentation, sourceRelation]
  · exact Relation.EqvGen.refl _
  · exact Relation.EqvGen.refl _
  · apply Relation.EqvGen.rel
    simp [presentation, sourceRelation]
  · apply Relation.EqvGen.rel
    simp [presentation, sourceRelation]
  · exact Relation.EqvGen.refl _

/-- Both visible Law values occur among the source-generated labels. -/
theorem generated_labels_distinct :
    LawValueLabel.ofSource laws PUnit.unit (false, false) ≠
      LawValueLabel.ofSource laws PUnit.unit (true, false) := by
  intro h
  have hvalue := congrArg (fun label : LawValueLabel laws => label.value) h
  exact Bool.noConfusion hvalue

/-- The relation connects sources differing only in the hidden coordinate. -/
theorem presentation_relates_hidden_pair :
    presentation.Related
      ⟨PUnit.unit, (false, false)⟩ ⟨PUnit.unit, (false, true)⟩ :=
  Relation.EqvGen.rel _ _ (by simp [presentation, sourceRelation])

/-- The relation does not connect generators with different visible Law values. -/
theorem presentation_does_not_relate_visible_pair :
    ¬ presentation.Related
      ⟨PUnit.unit, (false, false)⟩ ⟨PUnit.unit, (true, false)⟩ := by
  intro hrelated
  exact generated_labels_distinct
    (presentation.related_preserves_label hrelated)

#assert_standard_axioms_only
  AAT.AG.ObstructionDiagnosticBridge.PointAtomLawInput

end PointAtomLawInput
end AAT.AG.ObstructionDiagnosticBridge
