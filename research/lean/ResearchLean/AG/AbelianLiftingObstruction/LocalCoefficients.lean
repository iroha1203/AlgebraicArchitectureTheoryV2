import ResearchLean.AG.AbelianLiftingObstruction.KernelTransportLaws
import Mathlib.Algebra.Category.Grp.Abelian

/-!
# Local coefficients on a finite transport presentation

This is the algebraic path layer for G-129 A. The `face_transport` field records
the relation that must be discharged from the actual kernel comparison before
this layer is used for the tower. It does not contain a differential or a
coherence conclusion.

## Implementation notes

The vertex groups are dependent because the actual kernels can vary with the
vertex. Edge maps are additive equivalences because G-129 condition 2 assumes
bijectivity of the constructed kernel transport. A single constant group would
lose the actual vertex-dependent coefficients and nontrivial edge action.
-/

namespace AAT.AG.AbelianLiftingObstruction

open CategoryTheory TransportCoherence

universe uG uA

/-- G-129 A: coefficient groups and transport on the actual finite presentation. -/
structure EdgeCoefficients (K : FiniteTransportPresentation.{uG}) where
  /-- Group at each vertex. The tower realization uses its actual kernel. -/
  A : K.Vertex → Type uA
  /-- The abelian-kernel hypothesis at each vertex. -/
  commGroup : ∀ v, AddCommGroup (A v)
  /-- Transport along an edge, generated from the strong lift in the tower realization. -/
  edge : ∀ {i j : K.Vertex}, K.Edge i j → (A i ≃+ A j)
namespace EdgeCoefficients

/-- The supplied abelian structure on each actual vertex coefficient. -/
instance {K : FiniteTransportPresentation.{uG}}
    (M : EdgeCoefficients.{uG,uA} K) (v : K.Vertex) : AddCommGroup (M.A v) :=
  M.commGroup v

/-- Recursive transport along a path, including the empty path. -/
def pathTransport {K : FiniteTransportPresentation.{uG}}
    (M : EdgeCoefficients.{uG,uA} K) :
    ∀ {i j : K.Vertex}, K.Path i j → (M.A i ≃+ M.A j)
  | _, _, .nil _ => AddEquiv.refl _
  | _, _, .cons e w => (M.edge e).trans (pathTransport M w)

end EdgeCoefficients

/-- G-129 A: an edge coefficient system whose transport respects each authored face. -/
structure LocalCoefficients (K : FiniteTransportPresentation.{uG})
    extends EdgeCoefficients.{uG,uA} K where
  /-- The face relation required for descent; the tower realizes it via centralization. -/
  face_transport : ∀ f : K.TwoCell,
    toEdgeCoefficients.pathTransport (K.twoLeft f) =
      toEdgeCoefficients.pathTransport (K.twoRight f)

namespace LocalCoefficients

variable {K : FiniteTransportPresentation.{uG}} (M : LocalCoefficients.{uG,uA} K)

/-- API: path transport of the underlying edge data. -/
abbrev pathTransport {i j : K.Vertex} (w : K.Path i j) : M.A i ≃+ M.A j :=
  M.toEdgeCoefficients.pathTransport w

/-- API: an empty path transports by the identity. -/
@[simp] theorem pathTransport_nil (v : K.Vertex) :
    M.pathTransport (PresentedPath.nil v) = AddEquiv.refl (M.A v) := rfl

/-- API: a cons path first transports across its edge. -/
@[simp] theorem pathTransport_cons {i j k : K.Vertex}
    (e : K.Edge i j) (w : K.Path j k) :
    M.pathTransport (PresentedPath.cons e w) =
      (M.edge e).trans (M.pathTransport w) := rfl

/-- G-129 A: path transport respects concatenation and every edge occurrence. -/
theorem pathTransport_append {i j k : K.Vertex}
    (w : K.Path i j) (z : K.Path j k) :
    M.pathTransport (w.append z) =
      (M.pathTransport w).trans (M.pathTransport z) := by
  induction w with
  | nil v => rfl
  | cons e tail ih =>
      simp only [PresentedPath.append, pathTransport_cons, ih]
      rfl

/-- API: each authored face induces equal transport from source to target. -/
theorem transport_face (f : K.TwoCell) :
    M.pathTransport (K.twoLeft f) = M.pathTransport (K.twoRight f) :=
  M.face_transport f

end LocalCoefficients

/-- An authored face relation, with arbitrary typed prefix and suffix. -/
inductive FaceRewrite (K : FiniteTransportPresentation.{uG})
    {i j : K.Vertex} : K.Path i j → K.Path i j → Prop
  | step (f : K.TwoCell)
      (incoming : K.Path i (K.twoSource f))
      (outgoing : K.Path (K.twoTarget f) j) :
      FaceRewrite K
        (incoming.append ((K.twoLeft f).append outgoing))
        (incoming.append ((K.twoRight f).append outgoing))

/-- Paths modulo all relations generated by the authored faces. -/
abbrev PresentedHom (K : FiniteTransportPresentation.{uG}) (i j : K.Vertex) :=
  Quot (@FaceRewrite K i j)

namespace FaceRewrite

variable {K : FiniteTransportPresentation.{uG}}

/-- A face relation remains valid after adding a common suffix. -/
theorem append_right {i j k : K.Vertex} {w z : K.Path i j}
    (h : FaceRewrite K w z) (tail : K.Path j k) :
    FaceRewrite K (w.append tail) (z.append tail) := by
  cases h with
  | step f incoming outgoing =>
      simpa only [PresentedPath.append_assoc] using
        (FaceRewrite.step f incoming (outgoing.append tail))

/-- A face relation remains valid after adding a common prefix. -/
theorem append_left {i j k : K.Vertex} (head : K.Path i j)
    {w z : K.Path j k} (h : FaceRewrite K w z) :
    FaceRewrite K (head.append w) (head.append z) := by
  cases h with
  | step f incoming outgoing =>
      simpa only [PresentedPath.append_assoc] using
        (FaceRewrite.step f (head.append incoming) outgoing)

end FaceRewrite

namespace PresentedHom

variable {K : FiniteTransportPresentation.{uG}}

/-- Composition of paths modulo the authored face relations. -/
def append {i j k : K.Vertex}
    (w : PresentedHom K i j) (z : PresentedHom K j k) : PresentedHom K i k :=
  Quot.liftOn₂ w z (fun a b => Quot.mk _ (a.append b))
    (by
      intro a b b' h
      exact Quot.sound (FaceRewrite.append_left a h))
    (by
      intro a a' b h
      exact Quot.sound (FaceRewrite.append_right h b))

/-- API: quotient composition retains the original path concatenation. -/
@[simp] theorem append_mk {i j k : K.Vertex}
    (w : K.Path i j) (z : K.Path j k) :
    append (Quot.mk _ w) (Quot.mk _ z) = Quot.mk _ (w.append z) := rfl

end PresentedHom

/-- Objects of the category presented by the same finite vertices, edges, and faces. -/
def PresentedVertex (K : FiniteTransportPresentation.{uG}) := K.Vertex

namespace PresentedVertex

variable (K : FiniteTransportPresentation.{uG})

/-- The path category modulo the congruence generated by the authored faces. -/
instance : Category (PresentedVertex K) where
  Hom i j := PresentedHom K i j
  id i := Quot.mk _ (PresentedPath.nil i)
  comp := PresentedHom.append
  id_comp := by
    intro i j f
    induction f using Quot.ind with
    | _ w => rfl
  comp_id := by
    intro i j f
    induction f using Quot.ind with
    | _ w =>
        change Quot.mk _ (w.append (PresentedPath.nil j)) = Quot.mk _ w
        rw [PresentedPath.append_nil]
  assoc := by
    intro i j k l f g h
    induction f using Quot.ind with
    | _ w =>
      induction g using Quot.ind with
      | _ z =>
        induction h using Quot.ind with
        | _ t =>
          change Quot.mk _ ((w.append z).append t) =
            Quot.mk _ (w.append (z.append t))
          rw [PresentedPath.append_assoc]

end PresentedVertex

namespace LocalCoefficients

variable {K : FiniteTransportPresentation.{uG}} (M : LocalCoefficients.{uG,uA} K)

/-- G-129 A: the local coefficient transport respects a face in every context. -/
theorem transport_faceRewrite {i j : K.Vertex}
    {w z : K.Path i j} (h : FaceRewrite K w z) :
    M.pathTransport w = M.pathTransport z := by
  cases h with
  | step f incoming outgoing =>
      simp only [M.pathTransport_append]
      rw [M.transport_face f]

/-- G-129 A: transport descends to the relation generated by the same faces. -/
def descendedTransport {i j : K.Vertex} : PresentedHom K i j → (M.A i ≃+ M.A j) :=
  Quot.lift (fun w => M.pathTransport w)
    (fun _ _ h => M.transport_faceRewrite h)

/-- API: descent retains the original transport on each path representative. -/
@[simp] theorem descendedTransport_mk {i j : K.Vertex} (w : K.Path i j) :
    M.descendedTransport (Quot.mk _ w) = M.pathTransport w := rfl

/-- G-129 A: the descended coefficient system as an abelian-group-valued functor. -/
def asFunctor : PresentedVertex K ⥤ Ab where
  obj v := AddCommGrpCat.of (M.A v)
  map f := AddCommGrpCat.ofHom (M.descendedTransport f).toAddMonoidHom
  map_id := by
    intro v
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro a
    rfl
  map_comp := by
    intro i j k f g
    induction f using Quot.ind with
    | _ w =>
      induction g using Quot.ind with
      | _ z =>
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro a
        exact congrArg (fun h : M.A i ≃+ M.A k => h a)
          (M.pathTransport_append w z)

end LocalCoefficients

end AAT.AG.AbelianLiftingObstruction

#assert_standard_axioms_only AAT.AG.AbelianLiftingObstruction
