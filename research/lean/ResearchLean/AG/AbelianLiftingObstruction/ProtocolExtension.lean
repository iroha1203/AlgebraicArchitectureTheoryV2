import ResearchLean.AG.AbelianLiftingObstruction.GroupExtension
import ResearchLean.AG.ProtocolHolonomy.LiftableVisible

/-! # Applying the same obstruction theorem to actual G-127 protocol changes

G-129 D: retain ChangeGroup, projectionToLiftable, verticalLiftInclusion and
all original state/fiber maps. Abelianness of the full vertical lift group is
the sole extra mathematical hypothesis; other group-extension conditions are derived.
-/
namespace AAT.AG.AbelianLiftingObstruction.ProtocolExtension
open CategoryTheory TransportCoherence TransportCoherence.Arbitrary
open ProtocolHolonomy RealizationReconstruction
universe u v w
variable {Q : FixedFDirectedMultigraph.{u,v}} (D : ReversibleData.{u,v,w} Q)
variable (H : Subgroup (FixedFGraphAutomorphism Q))

/-- G-129 D API: the whole original vertical lift group is the same actual
categorical kernel, composing two inclusion-preserving group equivalences. -/
noncomputable def kernelEquiv : D.Lift (1 : FixedFGraphAutomorphism Q) ≃*
    Kernel (GroupExtension.projection (D.projectionToLiftable H))
      (GroupExtension.terminal (D.LiftableVisible H)) (SingleObj.star (D.ChangeGroup H)) :=
  (D.verticalLiftEquivLiftableKernel H).trans
    (GroupExtension.kernelEquiv (D.projectionToLiftable H))

/-- G-129 D API: inclusion recovers exactly verticalLiftInclusion in the
same ChangeGroup, keeping the original visible change and all state maps. -/
theorem kernelEquiv_inclusion (a : D.Lift (1 : FixedFGraphAutomorphism Q)) :
    FiberAut.hom (kernelInclusion _ _ _ (kernelEquiv D H a)) =
      D.verticalLiftInclusion H a := rfl

/-- G-129 D API: on every original total state the included kernel acts by
exactly the same G-127 vertical lift, without forgetting any fiber value. -/
theorem kernelEquiv_state (a : D.Lift (1 : FixedFGraphAutomorphism Q))
    (p : Σ x, D.Fiber x) :
    (FiberAut.hom (kernelInclusion _ _ _ (kernelEquiv D H a))).1.state p =
      (D.verticalLiftInclusion H a).1.state p := rfl

/-- G-129 D API: the actual categorical projection gives exactly the original
visible graph change of every full G-127 ChangeGroup element. -/
theorem projection_visible (c : D.ChangeGroup H) :
    (FiberAut.hom (fiberPushforward
      (GroupExtension.projection (D.projectionToLiftable H))
      (GroupExtension.terminal (D.LiftableVisible H)) _
      (GroupExtension.upperEquiv (D.projectionToLiftable H) c))).1.1 = c.1.visible := rfl

/-- G-129 A1/D discharge API: commutativity of all original vertical lifts
implies commutativity of the entire actual projection kernel. -/
theorem kernel_comm
    (hc : ∀ a b : D.Lift (1 : FixedFGraphAutomorphism Q), a * b = b * a)
    (a b : (D.projectionToLiftable H).ker) : a * b = b * a := by
  apply (D.verticalLiftEquivLiftableKernel H).symm.injective
  rw [map_mul, map_mul]
  exact hc _ _

/-- G-129 D construction: the same liftable-visible group acts on the whole
original projection kernel; surjectivity is generated by G-127's actual image. -/
noncomputable def visibleAction
    (hc : ∀ a b : D.Lift (1 : FixedFGraphAutomorphism Q), a * b = b * a) :=
  GroupExtension.visibleAction (D.projectionToLiftable H)
    (D.projectionToLiftable_surjective H) (kernel_comm D H hc)

variable (K : FiniteTransportPresentation)
variable (hc : ∀ a b : D.Lift (1 : FixedFGraphAutomorphism Q), a * b = b * a)
variable (core : ∀ {i j : K.Vertex}, K.Edge i j → D.LiftableVisible H)
variable (reference : ∀ {i j : K.Vertex}, K.Edge i j → D.ChangeGroup H)
variable (projects : ∀ {i j : K.Vertex} (e : K.Edge i j),
  D.projectionToLiftable H (reference e) = core e)
variable (relations : ∀ f : K.TwoCell,
  GroupExtension.pathValue K core (K.twoLeft f) =
    GroupExtension.pathValue K core (K.twoRight f))

/-- G-129 D construction: apply the group-extension adapter directly to the
same original G-127 groups/projection, generating all remaining A conditions. -/
noncomputable abbrev input := GroupExtension.input K (D.projectionToLiftable H)
  (kernel_comm D H hc) core reference projects relations

/-- G-129 D main correspondence: every actual categorical solution is precisely
an original relation-preserving ChangeGroup lift of the fixed visible changes. -/
noncomputable def solutionEquiv :=
  GroupExtension.solutionEquiv K (D.projectionToLiftable H)
    (kernel_comm D H hc) core reference projects relations

/-- G-129 D main existence criterion: the same H2 obstruction vanishes exactly
when the original visible changes have relation-preserving full protocol changes. -/
theorem obstruction_zero_iff :
    (input D H K hc core reference projects relations).toTower.obstructionClass
      (GroupExtension.syzygy K (D.projectionToLiftable H)
        (kernel_comm D H hc) core reference projects relations) = 0 ↔
      Nonempty (GroupExtension.GroupSolution K (D.projectionToLiftable H) core) :=
  GroupExtension.obstruction_zero_iff K (D.projectionToLiftable H)
    (kernel_comm D H hc) core reference projects relations

/-- G-129 D solution API: the group correspondence retains every original
protocol state's value under each full operation-preserving edge change. -/
theorem solutionEquiv_state
    (S : Solution (input D H K hc core reference projects relations))
    {i j : K.Vertex} (e : K.Edge i j) (p : Σ x, D.Fiber x) :
    ((solutionEquiv D H K hc core reference projects relations S).edge e).1.state p =
      (FiberAut.hom (S.choice e)).1.state p := rfl

/-- G-129 D solution API: the correspondence retains the full original visible
vertex-and-edge graph automorphism for every solution edge. -/
theorem solutionEquiv_visible
    (S : Solution (input D H K hc core reference projects relations))
    {i j : K.Vertex} (e : K.Edge i j) :
    ((solutionEquiv D H K hc core reference projects relations S).edge e).1.visible =
      (FiberAut.hom (S.choice e)).1.visible := rfl

end AAT.AG.AbelianLiftingObstruction.ProtocolExtension
#assert_standard_axioms_only AAT.AG.AbelianLiftingObstruction.ProtocolExtension
