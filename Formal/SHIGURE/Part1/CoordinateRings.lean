import Mathlib.Algebra.MvPolynomial.CommRing
import Mathlib.Algebra.MvPolynomial.Rename
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-! # Coordinate rings of polynomial Law presentations

Proposition 3.11 identifies Law-satisfying assignments with maps out of the
coordinate ring. Including declaration names induces an algebra map on those
rings, and precomposition restricts the original assignment.
-/

universe u v w t
namespace SHIGURE
open MvPolynomial

noncomputable section

/-- Named quantity variables and globally required polynomial equations. -/
structure PolynomialPresentation (k : Type u) [CommRing k] where
  /-- The declared quantity variables. -/
  Variable : Type v
  /-- The names of the required Laws. -/
  Law : Type v
  /-- The left polynomial of each Law. -/
  left : Law → MvPolynomial Variable k
  /-- The right polynomial of each Law. -/
  right : Law → MvPolynomial Variable k

namespace PolynomialPresentation

variable {k : Type u} [CommRing k] (V : PolynomialPresentation.{u,v} k)

/-- The ideal generated by the differences of the two sides of the written Laws. -/
def lawIdeal : Ideal (MvPolynomial V.Variable k) :=
  Ideal.span (Set.range fun l => V.left l - V.right l)

/-- The polynomial ring modulo the Law ideal. -/
abbrev CoordinateRing := MvPolynomial V.Variable k ⧸ V.lawIdeal

/-- The class of a named variable in the coordinate ring. -/
def generator (z : V.Variable) : V.CoordinateRing := Ideal.Quotient.mkₐ k V.lawIdeal (X z)

variable (R : Type w) [CommRing R] [Algebra k R]

/-- An assignment in a commutative algebra satisfying every polynomial Law. -/
structure Assignment (V : PolynomialPresentation.{u,v} k) (R : Type w)
    [CommRing R] [Algebra k R] where
  /-- The value assigned to each name. -/
  value : V.Variable → R
  /-- Evaluation agrees on both sides of each Law. -/
  holds (l : V.Law) : aeval value (V.left l) = aeval value (V.right l)

variable {V R}

private theorem Assignment.ideal_le_ker (a : V.Assignment R) :
    V.lawIdeal ≤ RingHom.ker (aeval a.value).toRingHom := by
  apply Ideal.span_le.mpr
  rintro _ ⟨l, rfl⟩
  apply RingHom.mem_ker.mpr
  change aeval a.value (V.left l - V.right l) = 0
  rw [map_sub, a.holds, sub_self]

/-- Evaluation descends to a homomorphism of algebras on the Law quotient. -/
def Assignment.toHom (a : V.Assignment R) :
    V.CoordinateRing →ₐ[k] R where
  toRingHom := Ideal.Quotient.lift V.lawIdeal (aeval a.value).toRingHom
    fun _ h => a.ideal_le_ker h
  commutes' := by
    intro c
    exact (aeval a.value).commutes c

/-- The descended evaluation sends each retained generator to its assigned value. -/
@[simp] theorem Assignment.toHom_variable (a : V.Assignment R) (z : V.Variable) :
    a.toHom (V.generator z) = a.value z := aeval_X a.value z

/-- A coordinate ring homomorphism is determined by its values on the named generators. -/
theorem hom_ext {f g : V.CoordinateRing →ₐ[k] R}
    (h : ∀ z, f (V.generator z) = g (V.generator z)) : f = g := by
  have eq : f.comp (Ideal.Quotient.mkₐ k V.lawIdeal) =
      g.comp (Ideal.Quotient.mkₐ k V.lawIdeal) := MvPolynomial.algHom_ext h
  ext x
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  exact DFunLike.congr_fun eq p

/-- Read a satisfying assignment from a homomorphism of coordinate rings. -/
def Assignment.ofHom (f : V.CoordinateRing →ₐ[k] R) : V.Assignment R where
  value z := f (V.generator z)
  holds := by
    have eq : aeval (fun z => f (V.generator z)) =
        f.comp (Ideal.Quotient.mkₐ k V.lawIdeal) := MvPolynomial.algHom_ext (by simp [generator])
    intro l
    rw [eq, ← sub_eq_zero, ← map_sub]
    have mem : V.left l - V.right l ∈ V.lawIdeal := Ideal.subset_span ⟨l, rfl⟩
    rw [AlgHom.comp_apply]
    change f (Ideal.Quotient.mk V.lawIdeal _) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr mem, map_zero]

/-- Two satisfying assignments with the same values are equal. -/
@[ext] theorem Assignment.ext {a b : V.Assignment R} (h : ∀ z, a.value z = b.value z) :
    a = b := by
  cases a with
  | mk av ah =>
    cases b with
    | mk bv bh =>
      have eq : av = bv := funext h
      cases eq
      rfl

/-- The coordinate ring represents the satisfying assignments in any coefficient algebra. -/
def assignmentEquiv (V : PolynomialPresentation.{u,v} k) (R : Type w)
    [CommRing R] [Algebra k R] : V.Assignment R ≃ (V.CoordinateRing →ₐ[k] R) where
  toFun := Assignment.toHom
  invFun := Assignment.ofHom
  left_inv a := Assignment.ext a.toHom_variable
  right_inv f := hom_ext (fun z => (Assignment.ofHom f).toHom_variable z)

/-- A variable inclusion along which the old Law ideal maps into the new Law ideal. -/
structure Inclusion (V : PolynomialPresentation.{u,v} k) (W : PolynomialPresentation.{u,t} k) where
  /-- The inclusion on variable names. -/
  names : V.Variable ↪ W.Variable
  /-- All old Laws remain consequences of the new ones. -/
  preserves : V.lawIdeal ≤ W.lawIdeal.comap (rename names)

namespace Inclusion

variable {W : PolynomialPresentation.{u,t} k} (i : V.Inclusion W)

/-- Inclusion of variable names induces the covariant map of coordinate rings. -/
def coordinateMap : V.CoordinateRing →ₐ[k] W.CoordinateRing :=
  Ideal.quotientMapₐ W.lawIdeal (rename i.names) i.preserves

/-- The induced map sends each variable to the same variable in the larger presentation. -/
@[simp] theorem coordinateMap_generator (z : V.Variable) :
    i.coordinateMap (V.generator z) = W.generator (i.names z) := by
  change Ideal.Quotient.mkₐ k W.lawIdeal (rename i.names (X z)) = W.generator (i.names z)
  rw [rename_X]
  rfl

/-- Retain the assigned values for the included variable names. -/
def forget (a : W.Assignment R) : V.Assignment R where
  value z := a.value (i.names z)
  holds l := by
    have h : V.left l - V.right l ∈ V.lawIdeal := Ideal.subset_span ⟨l, rfl⟩
    have preserved : rename i.names (V.left l - V.right l) ∈ W.lawIdeal := i.preserves h
    have zero := RingHom.mem_ker.mp (a.ideal_le_ker preserved)
    change aeval a.value (rename i.names (V.left l - V.right l)) = 0 at zero
    rw [aeval_rename, map_sub, sub_eq_zero] at zero
    exact zero

/-- Equation (3.8): forgetting variables on assignments corresponds to precomposition. -/
theorem forget_toHom (a : W.Assignment R) :
    (i.forget a).toHom = a.toHom.comp i.coordinateMap := by
  apply hom_ext
  intro z
  rw [Assignment.toHom_variable, AlgHom.comp_apply, coordinateMap_generator, Assignment.toHom_variable]
  rfl

/-- Precomposition gives the smaller assignment under the inverse correspondence. -/
theorem assignmentEquiv_symm_precomp (f : W.CoordinateRing →ₐ[k] R) :
    (V.assignmentEquiv R).symm (f.comp i.coordinateMap) =
      i.forget ((W.assignmentEquiv R).symm f) := by
  apply (V.assignmentEquiv R).injective
  rw [Equiv.apply_symm_apply]
  change f.comp i.coordinateMap = (i.forget ((W.assignmentEquiv R).symm f)).toHom
  rw [i.forget_toHom]
  exact congrArg (fun g : W.CoordinateRing →ₐ[k] R => g.comp i.coordinateMap)
    ((W.assignmentEquiv R).apply_symm_apply f).symm

end Inclusion

end PolynomialPresentation
end
end SHIGURE
