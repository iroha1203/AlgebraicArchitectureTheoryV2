import Formal.SHIGURE.Part1.MarkedQuotients
import Mathlib.Data.Fin.VecNotation
import Mathlib.LinearAlgebra.Isomorphisms
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Ring

/-! # The marked rational quotients of Example 3.7

The positive overlap has kernel generated by (3, -2) and coordinate
2x + 3y. The changed right overlap has kernel generated by (0, 1) and
coordinate x. Their quotient modules are both rank one.
-/

namespace SHIGURE.Marked.RationalExample

/-- The linear functional selecting the single coordinate for p and r. -/
def unitRow : Coordinates ℚ 1 →ₗ[ℚ] ℚ :=
  LinearMap.proj (0 : Fin 1)

/-- The single coordinate of p and r gives all rationals. -/
theorem unitRow_surjective : Function.Surjective unitRow :=
  fun a => ⟨fun _ => a, rfl⟩

/-- The canonical rank-one quotient for p and r, with one named generator. -/
def unitKernel : Kernel ℚ 1 := LinearMap.ker unitRow

/-- The coordinate identification used to read the p and r operations of Example 3.7. -/
noncomputable def unitEquiv : Quotient unitKernel ≃ₗ[ℚ] ℚ :=
  unitRow.quotKerEquivOfSurjective unitRow_surjective

/-- The single-coordinate quotient equivalence reads the coordinate of any representative. -/
theorem unitEquiv_projection (x : Coordinates ℚ 1) : unitEquiv (projection unitKernel x) = x 0 :=
  unitRow.quotKerEquivOfSurjective_apply_mk unitRow_surjective x

/-- The functional of Equation (3.5) defining the positive overlap kernel. -/
def row : Coordinates ℚ 2 →ₗ[ℚ] ℚ :=
  2 • LinearMap.proj (0 : Fin 2) + 3 • LinearMap.proj (1 : Fin 2)

/-- Compute the written functional of Equation (3.5). -/
@[simp] theorem row_apply (x : Coordinates ℚ 2) : row x = 2 * x 0 + 3 * x 1 := by
  simp [row]

/-- The functional is onto, witnessed by the first coordinate divided by two. -/
theorem row_surjective : Function.Surjective row := by
  intro a
  refine ⟨![a / 2, 0], ?_⟩
  simp only [row_apply, Matrix.cons_val_zero, Matrix.cons_val_one]
  ring

/-- The left and unchanged right q kernel in Example 3.7. -/
def sharedKernel : Kernel ℚ 2 := LinearMap.ker row

/-- The positive kernel has exactly the specified line of relations. -/
theorem sharedKernel_eq_span : sharedKernel =
    Submodule.span ℚ {(![3, -2] : Coordinates ℚ 2)} := by
  ext x
  change row x = 0 ↔ x ∈ Submodule.span ℚ {(![3, -2] : Coordinates ℚ 2)}
  rw [row_apply, Submodule.mem_span_singleton]
  constructor
  · intro eq
    refine ⟨-(x 1) / 2, ?_⟩
    funext i
    fin_cases i
    · change (-(x 1) / 2) * 3 = x 0
      linarith
    · change (-(x 1) / 2) * (-2) = x 1
      ring
  · rintro ⟨r, rfl⟩
    simp only [Pi.smul_apply, smul_eq_mul, Matrix.cons_val_zero, Matrix.cons_val_one]
    ring

/-- The quotient coordinate map of Equation (3.5). -/
noncomputable def phi : Quotient sharedKernel ≃ₗ[ℚ] ℚ :=
  row.quotKerEquivOfSurjective row_surjective

/-- The value of phi on each quotient class is the written linear expression. -/
@[simp] theorem phi_projection (x : Coordinates ℚ 2) :
    phi (projection sharedKernel x) = 2 * x 0 + 3 * x 1 := by
  exact (row.quotKerEquivOfSurjective_apply_mk row_surjective x).trans (row_apply x)

/-- The positive q basis point written as [1/2, 0]. -/
noncomputable def e : Quotient sharedKernel :=
  projection sharedKernel ![(1 / 2 : ℚ), 0]

/-- The written basis point has coordinate 1. -/
@[simp] theorem phi_e : phi e = 1 := by
  norm_num [e]

/-- In positive coordinates the two named q generators are two and three times e. -/
theorem shared_generators :
    generator sharedKernel 0 = (2 : ℚ) • e ∧ generator sharedKernel 1 = (3 : ℚ) • e := by
  constructor <;> rw [← projection_single] <;> apply phi.injective <;> simp [smul_eq_mul]

/-- The q functional used on the changed right piece. -/
def changedRow : Coordinates ℚ 2 →ₗ[ℚ] ℚ :=
  LinearMap.proj (0 : Fin 2)

/-- The changed functional is onto, witnessed by a vector with zero second coordinate. -/
theorem changedRow_surjective : Function.Surjective changedRow :=
  fun a => ⟨![a, 0], rfl⟩

/-- The q kernel for the changed right piece of Example 3.7. -/
def changedKernel : Kernel ℚ 2 := LinearMap.ker changedRow

/-- The changed right-hand kernel is the line generated by the second coordinate basis vector. -/
theorem changedKernel_eq_span : changedKernel =
    Submodule.span ℚ {(![0, 1] : Coordinates ℚ 2)} := by
  ext x
  change x 0 = 0 ↔ x ∈ Submodule.span ℚ {(![0, 1] : Coordinates ℚ 2)}
  rw [Submodule.mem_span_singleton]
  constructor
  · intro eq
    refine ⟨x 1, ?_⟩
    funext i
    fin_cases i <;> simp [eq]
  · rintro ⟨r, rfl⟩
    simp

/-- The changed right-hand quotient coordinate takes [x, y] to x. -/
noncomputable def phiChanged : Quotient changedKernel ≃ₗ[ℚ] ℚ :=
  changedRow.quotKerEquivOfSurjective changedRow_surjective

/-- The value of the changed coordinate on a quotient class. -/
@[simp] theorem phiChanged_projection (x : Coordinates ℚ 2) :
    phiChanged (projection changedKernel x) = x 0 := by
  exact changedRow.quotKerEquivOfSurjective_apply_mk changedRow_surjective x

/-- The changed right-hand basis point written as [1, 0]. -/
noncomputable def eChanged : Quotient changedKernel :=
  projection changedKernel ![1, 0]

/-- The changed right-hand basis point again has coordinate 1. -/
@[simp] theorem phiChanged_eChanged : phiChanged eChanged = 1 := by
  simp [eChanged]

/-- A quotient with a linear coordinate equivalence to ℚ meets the rank-one specification. -/
theorem fixedRank_one {m : ℕ} {K : Kernel ℚ m} (coord : Quotient K ≃ₗ[ℚ] ℚ) :
    FixedRank K 1 where
  projective := by
    letI := Module.Free.of_equiv coord.symm
    infer_instance
  atPrime p := by
    rw [Module.rankAtStalk_eq_of_equiv coord, Module.rankAtStalk_self]
    rfl

/-- The same positive q quotient cannot meet the rank-two condition. -/
theorem shared_not_rank_two : ¬ FixedRank sharedKernel 2 := by
  intro rankTwo
  let p : PrimeSpectrum ℚ := ⟨⊥, Ideal.isPrime_bot⟩
  have same : (1 : ℕ) = 2 := ((fixedRank_one phi).atPrime p).symm.trans (rankTwo.atPrime p)
  cases same

/-- The second coordinate vector separates the two q kernels. -/
theorem sharedKernel_ne_changedKernel : sharedKernel ≠ changedKernel := by
  intro eq
  have inside : (![0, 1] : Coordinates ℚ 2) ∈ changedKernel := rfl
  rw [← eq] at inside
  have zero : row ![0, 1] = 0 := inside
  norm_num at zero

/-- No linear equivalence can identify both named generators across the changed overlap. -/
theorem no_marked_equiv : ¬ ∃ F : Quotient sharedKernel ≃ₗ[ℚ] Quotient changedKernel,
    ∀ i, F (generator sharedKernel i) = generator changedKernel i := by
  rintro ⟨F, preserves⟩
  exact sharedKernel_ne_changedKernel (kernel_eq_of_preserves F preserves)

end SHIGURE.Marked.RationalExample
