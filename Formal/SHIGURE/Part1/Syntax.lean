import Formal.SHIGURE.Part1.Signature

/-! # Sorted terms and positive formulas

Definitions 1.3–1.4. The value graph in (1.3) is itself a positive formula.

## Implementation notes

A term's context and result sort are indices of its type. A strict binding
extends the context of its body. Renamings act on positions rather than textual
names, so weakening and insertion under binders preserve all free variables.
Atomic formulas take only variable arguments. The constructions for term
arguments introduce existentially bound values and constrain their graphs.
Context extensions keep the innermost binder at position zero. Block
quantification removes positions in that order, and its semantics recovers
the argument tuple in the original context order.

Using named variable syntax would require a separate freshness and
capture-avoidance invariant. The position indices put those obligations in
the constructors of renamings. The finite-scope graph expansion keeps the
context order and abstracts its head first, so an input block is written with
its last coordinate outermost in the resulting formula. The semantic
comparison recovers the original tuple.

Term evaluation is first defined by its input–output relation. A uniqueness
proof yields a partial value in mathlib's `Part`, with the same domain. Its
definition is independent of the formula that expresses its graph.
An executable `Option` evaluator would require deciding membership in the
interpreted partial domains, which Definition 1.3 does not require.
-/

universe u

namespace SHIGURE

/-- Terms generated by variables, operation application, and strict binding. -/
inductive Term (sig : Signature.{u}) : List sig.SortType → sig.SortType → Type u
  | var {Γ s} : Var Γ s → Term sig Γ s
  | app {Γ} (op : Operation sig) :
      (∀ {s}, Var op.arity.inputs s → Term sig Γ s) → Term sig Γ op.arity.output
  | letBind {Γ s t} : Term sig Γ s → Term sig (s :: Γ) t → Term sig Γ t

/-- Atomic formulas take typed variables as their arguments. -/
inductive Atomic (sig : Signature.{u}) (Γ : List sig.SortType) : Type u
  | eq {s} : Var Γ s → Var Γ s → Atomic sig Γ
  | rel (r : sig.Rel) : Renaming (sig.relInputs r) Γ → Atomic sig Γ
  | domain (p : sig.Partial) : Renaming (sig.partialArity p).inputs Γ → Atomic sig Γ
  | graph (op : Operation sig) :
      Renaming op.arity.inputs Γ → Var Γ op.arity.output → Atomic sig Γ

/-- The positive syntax of Definition 1.4. -/
inductive Formula (sig : Signature.{u}) : List sig.SortType → Type u
  | atom {Γ} : Atomic sig Γ → Formula sig Γ
  | truth {Γ} : Formula sig Γ
  | falsehood {Γ} : Formula sig Γ
  | conj {Γ} : Formula sig Γ → Formula sig Γ → Formula sig Γ
  | disj {Γ} : Formula sig Γ → Formula sig Γ → Formula sig Γ
  | ex {Γ s} : Formula sig (s :: Γ) → Formula sig Γ

namespace Atomic

variable {sig : Signature.{u}} {Γ Δ : List sig.SortType}

/-- Rename the variables of an atom without changing any of its symbols. -/
def rename (ρ : Renaming Γ Δ) : Atomic sig Γ → Atomic sig Δ
  | .eq x y => .eq (ρ x) (ρ y)
  | .rel r vars => .rel r (fun v => ρ (vars v))
  | .domain p vars => .domain p (fun v => ρ (vars v))
  | .graph op vars y => .graph op (fun v => ρ (vars v)) (ρ y)

/-- Renaming equality selects both of its named positions. -/
@[simp] theorem rename_eq {s : sig.SortType} (x y : Var Γ s) (ρ : Renaming Γ Δ) :
    (Atomic.eq (sig := sig) x y).rename ρ = .eq (ρ x) (ρ y) :=
  rfl

/-- Rename a relation atom by mapping its selected arguments. -/
@[simp] theorem rename_rel (r : sig.Rel) (vars : Renaming (sig.relInputs r) Γ)
    (ρ : Renaming Γ Δ) : (Atomic.rel r vars).rename ρ = .rel r (fun i => ρ (vars i)) :=
  rfl

/-- Rename a domain atom by mapping its selected arguments. -/
@[simp] theorem rename_domain (p : sig.Partial) (vars : Renaming (sig.partialArity p).inputs Γ)
    (ρ : Renaming Γ Δ) : (Atomic.domain p vars).rename ρ = .domain p (fun i => ρ (vars i)) :=
  rfl

/-- Rename a graph atom by mapping its selected arguments and output. -/
@[simp] theorem rename_graph (op : Operation sig) (vars : Renaming op.arity.inputs Γ)
    (y : Var Γ op.arity.output) (ρ : Renaming Γ Δ) :
    (Atomic.graph op vars y).rename ρ = .graph op (fun v => ρ (vars v)) (ρ y) :=
  rfl

/-- Interpret an atom in a structure at the given assignment. -/
def Holds (a : Atomic sig Γ) (A : Structure sig) (e : Assignment A.carrier Γ) : Prop :=
  match a with
  | .eq x y => e x = e y
  | .rel r vars => e.pull vars ∈ A.relation r
  | .domain p vars => e.pull vars ∈ A.partialDomain p
  | .graph op vars y => A.Graph op (e.pull vars) (e y)

/-- A relation atom reduces to membership of the selected tuple in the interpreted relation. -/
@[simp] theorem holds_rel (r : sig.Rel) (vars : Renaming (sig.relInputs r) Γ)
    (A : Structure sig) (e : Assignment A.carrier Γ) :
    (Atomic.rel r vars).Holds A e ↔ e.pull vars ∈ A.relation r :=
  Iff.rfl

/-- A domain atom reduces to membership of the selected tuple in the partial domain. -/
@[simp] theorem holds_domain (p : sig.Partial) (vars : Renaming (sig.partialArity p).inputs Γ)
    (A : Structure sig) (e : Assignment A.carrier Γ) :
    (Atomic.domain p vars).Holds A e ↔ e.pull vars ∈ A.partialDomain p :=
  Iff.rfl

/-- A graph atom tests the interpreted graph on its selected coordinates. -/
@[simp] theorem holds_graph (op : Operation sig) (vars : Renaming op.arity.inputs Γ)
    (y : Var Γ op.arity.output) (A : Structure sig) (e : Assignment A.carrier Γ) :
    (Atomic.graph op vars y).Holds A e ↔ A.Graph op (e.pull vars) (e y) :=
  Iff.rfl

/-- Renaming an atom is evaluated by pulling the assignment back. -/
@[simp] theorem holds_rename (a : Atomic sig Γ) (ρ : Renaming Γ Δ)
    (A : Structure sig) (e : Assignment A.carrier Δ) :
    (a.rename ρ).Holds A e ↔ a.Holds A (e.pull ρ) := by
  cases a <;> rfl

end Atomic

namespace Formula

variable {sig : Signature.{u}} {Γ Δ : List sig.SortType}

/-- Rename the free variables of a positive formula. -/
def rename : {Γ Δ : List sig.SortType} → Renaming Γ Δ → Formula sig Γ → Formula sig Δ
  | _, _, ρ, .atom a => .atom (a.rename ρ)
  | _, _, _, .truth => .truth
  | _, _, _, .falsehood => .falsehood
  | _, _, ρ, .conj p q => .conj (rename ρ p) (rename ρ q)
  | _, _, ρ, .disj p q => .disj (rename ρ p) (rename ρ q)
  | _, _, ρ, .ex p => .ex (rename (Renaming.lift ρ) p)

/-- Renaming an atomic formula acts on the underlying atom. -/
@[simp] theorem rename_atom (a : Atomic sig Γ) (ρ : Renaming Γ Δ) :
    (Formula.atom a).rename ρ = .atom (a.rename ρ) :=
  rfl

/-- Renaming a conjunction acts on each conjunct. -/
@[simp] theorem rename_conj (p q : Formula sig Γ) (ρ : Renaming Γ Δ) :
    (p.conj q).rename ρ = (p.rename ρ).conj (q.rename ρ) :=
  rfl

/-- Renaming a disjunction acts on each disjunct. -/
@[simp] theorem rename_disj (p q : Formula sig Γ) (ρ : Renaming Γ Δ) :
    (p.disj q).rename ρ = (p.rename ρ).disj (q.rename ρ) :=
  rfl

/-- Renaming an existential formula retains its binder and lifts the free-variable map. -/
@[simp] theorem rename_ex {s : sig.SortType} (p : Formula sig (s :: Γ)) (ρ : Renaming Γ Δ) :
    p.ex.rename ρ = (p.rename (Renaming.lift ρ)).ex :=
  rfl

/-- Satisfaction interprets the positive connectives and uses the full carrier for a witness. -/
def Holds : {Γ : List sig.SortType} → Formula sig Γ → (A : Structure sig) →
    Assignment A.carrier Γ → Prop
  | _, .atom a, A, e => a.Holds A e
  | _, .truth, _, _ => True
  | _, .falsehood, _, _ => False
  | _, .conj p q, A, e => Holds p A e ∧ Holds q A e
  | _, .disj p q, A, e => Holds p A e ∨ Holds q A e
  | _, @Formula.ex _ _ s p, A, e => ∃ x : A.carrier s, Holds p A (Assignment.cons x e)

/-- Satisfaction of atoms is their interpretation in the structure. -/
@[simp] theorem holds_atom (a : Atomic sig Γ) (A : Structure sig) (e : Assignment A.carrier Γ) :
    (Formula.atom a).Holds A e ↔ a.Holds A e :=
  Iff.rfl

/-- Conjunction combines the two satisfaction conditions. -/
@[simp] theorem holds_conj (p q : Formula sig Γ) (A : Structure sig)
    (e : Assignment A.carrier Γ) : (p.conj q).Holds A e ↔ p.Holds A e ∧ q.Holds A e :=
  Iff.rfl

/-- Disjunction reduces to either of the two satisfaction conditions. -/
@[simp] theorem holds_disj (p q : Formula sig Γ) (A : Structure sig)
    (e : Assignment A.carrier Γ) : (p.disj q).Holds A e ↔ p.Holds A e ∨ q.Holds A e :=
  Iff.rfl

/-- Existential satisfaction is witnessed in the declared sort. -/
@[simp] theorem holds_ex {s : sig.SortType} (p : Formula sig (s :: Γ)) (A : Structure sig)
    (e : Assignment A.carrier Γ) :
    (Formula.ex p).Holds A e ↔ ∃ x : A.carrier s, p.Holds A (Assignment.cons x e) :=
  Iff.rfl

/-- Satisfaction commutes with capture-free renaming of arbitrary positive formulas. -/
@[simp] theorem holds_rename (A : Structure sig) (p : Formula sig Γ) :
    ∀ {Δ : List sig.SortType} (ρ : Renaming Γ Δ) (e : Assignment A.carrier Δ),
      (rename ρ p).Holds A e ↔ p.Holds A (e.pull ρ) := by
  induction p with
  | atom a =>
    intro Δ ρ e
    exact a.holds_rename ρ A e
  | truth => intros; rfl
  | falsehood => intros; rfl
  | conj p q hp hq =>
    intro Δ ρ e
    simp [rename, hp, hq]
  | disj p q hp hq =>
    intro Δ ρ e
    simp only [rename, holds_disj, hp, hq]
  | ex p hp =>
    intro Δ ρ e
    simp [rename, hp]

/-- Conjoin a family indexed by the positions of a finite context, with an empty conjunction. -/
def conjoin : (Λ : List sig.SortType) → (∀ {s}, Var Λ s → Formula sig Γ) → Formula sig Γ
  | [], _ => .truth
  | _ :: Λ, fs => .conj (fs .here) (conjoin Λ (fun var => fs (.there var)))

/-- An empty conjunction is the truth formula. -/
theorem conjoin_nil (fs : ∀ {s}, Var ([] : List sig.SortType) s → Formula sig Γ) :
    conjoin [] fs = .truth := rfl

/-- A nonempty conjunction separates its first formula from the remaining formulas. -/
theorem conjoin_cons {s : sig.SortType} {Λ : List sig.SortType}
    (fs : ∀ {t}, Var (s :: Λ) t → Formula sig Γ) :
    conjoin (s :: Λ) fs = (fs .here).conj (conjoin Λ (fun i => fs (.there i))) := rfl

/-- The finite conjunction is satisfied exactly when each indexed component is satisfied. -/
@[simp] theorem holds_conjoin (Λ : List sig.SortType) (fs : ∀ {s}, Var Λ s → Formula sig Γ)
    (A : Structure sig) (e : Assignment A.carrier Γ) :
    (conjoin Λ fs).Holds A e ↔ ∀ {s} (var : Var Λ s), (fs var).Holds A e := by
  induction Λ with
  | nil =>
    refine ⟨fun _ _ var => ?_, fun _ => True.intro⟩
    nomatch var
  | cons s Λ ih =>
    rw [conjoin, holds_conj, ih]
    constructor
    · intro h t var
      cases var with
      | here => exact h.1
      | there var => exact h.2 var
    · intro h
      exact ⟨h .here, fun var => h (.there var)⟩

/-- Quantify away the typed positions in a leading context block. -/
def existsMany : (Λ : List sig.SortType) → Formula sig (Λ ++ Γ) → Formula sig Γ
  | [], p => p
  | _ :: Λ, p => existsMany Λ (.ex p)

/-- An empty witness block leaves its body in the ambient context. -/
theorem existsMany_nil (p : Formula sig Γ) : existsMany [] p = p := rfl

/-- A nonempty witness block binds the head within the remaining witnesses. -/
theorem existsMany_cons {s : sig.SortType} {Λ : List sig.SortType}
    (p : Formula sig (s :: (Λ ++ Γ))) : existsMany (s :: Λ) p = existsMany Λ p.ex := rfl

/-- A singleton witness block is one existential quantifier. -/
theorem existsMany_singleton {s : sig.SortType} (p : Formula sig (s :: Γ)) :
    existsMany [s] p = p.ex := rfl

/-- A block of bound variables is witnessed by a single tuple of its specified sorts. -/
@[simp] theorem holds_existsMany (Λ : List sig.SortType) (p : Formula sig (Λ ++ Γ))
    (A : Structure sig) (e : Assignment A.carrier Γ) :
    (existsMany Λ p).Holds A e ↔ ∃ xs : Assignment A.carrier Λ, p.Holds A (xs.append e) := by
  induction Λ with
  | nil =>
    simp only [existsMany, Assignment.append_empty]
    exact ⟨fun h => ⟨Assignment.empty, h⟩, fun ⟨_, h⟩ => h⟩
  | cons s Λ ih =>
    rw [existsMany, ih]
    constructor
    · rintro ⟨xs, x, h⟩
      exact ⟨Assignment.cons x xs, h⟩
    · rintro ⟨xs, h⟩
      refine ⟨xs.tail, xs.head, ?_⟩
      simpa only [← Assignment.append_cons, Assignment.cons_head_tail] using h

end Formula

namespace Term

variable {sig : Signature.{u}} {Γ : List sig.SortType} {s : sig.SortType}

/-- The empty tuple of argument terms. -/
def argsNil : ∀ {s}, Var ([] : List sig.SortType) s → Term sig Γ s :=
  fun index => nomatch index

/-- Place a term before an existing tuple of argument terms. -/
def argsCons {Λ : List sig.SortType} (term : Term sig Γ s)
    (rest : ∀ {t}, Var Λ t → Term sig Γ t) :
    ∀ {t}, Var (s :: Λ) t → Term sig Γ t
  | _, .here => term
  | _, .there index => rest index

/-- Read the leading term of a nonempty tuple. -/
@[simp] theorem argsCons_here {Λ : List sig.SortType} (term : Term sig Γ s)
    (rest : ∀ {t}, Var Λ t → Term sig Γ t) : argsCons term rest .here = term := rfl

/-- Read an older argument after adding a leading term. -/
@[simp] theorem argsCons_there {Λ : List sig.SortType} (term : Term sig Γ s)
    (rest : ∀ {t}, Var Λ t → Term sig Γ t) {t : sig.SortType} (index : Var Λ t) :
    argsCons term rest (.there index) = rest index := rfl

/-- Partial evaluation written as a relation between an assignment and an output. -/
def Evaluates : {Γ : List sig.SortType} → {s : sig.SortType} → Term sig Γ s →
    (A : Structure sig) → Assignment A.carrier Γ → A.carrier s → Prop
  | _, _, .var index, _, e, y => e index = y
  | _, _, .app op terms, A, e, y =>
    ∃ xs : Assignment A.carrier op.arity.inputs,
      (∀ {t} (var : Var op.arity.inputs t), Evaluates (terms var) A e (xs var)) ∧ A.Graph op xs y
  | _, _, @Term.letBind _ _ s _ init body, A, e, y =>
    ∃ x : A.carrier s, Evaluates init A e x ∧ Evaluates body A (Assignment.cons x e) y

/-- Partial evaluation has at most one value at each input. -/
theorem evaluates_unique (A : Structure sig) (t : Term sig Γ s) :
    ∀ (e : Assignment A.carrier Γ) {y z : A.carrier s},
      t.Evaluates A e y → t.Evaluates A e z → y = z := by
  induction t with
  | var index =>
    intro e y z hy hz
    exact hy.symm.trans hz
  | app op terms ih =>
    intro e y z hy hz
    obtain ⟨xs, hxs, hgraph⟩ := hy
    obtain ⟨ys, hys, hgraph'⟩ := hz
    have hxy : xs = ys := Assignment.ext (fun var => ih var e (hxs var) (hys var))
    subst ys
    exact A.graph_rightUnique op hgraph hgraph'
  | letBind init body hi hb =>
    intro e y z hy hz
    obtain ⟨x, hx, hbody⟩ := hy
    obtain ⟨x', hx', hbody'⟩ := hz
    have hxx : x = x' := hi e hx hx'
    subst x'
    exact hb (Assignment.cons x e) hbody hbody'

/-- A variable evaluates to its coordinate in the assignment. -/
@[simp] theorem evaluates_var_iff (index : Var Γ s) (A : Structure sig)
    (e : Assignment A.carrier Γ) (y : A.carrier s) :
    (Term.var index).Evaluates A e y ↔ e index = y :=
  Iff.rfl

/-- Application evaluation consists of evaluated arguments and an edge of the operation graph. -/
theorem evaluates_app_iff (op : Operation sig) (terms : ∀ {s}, Var op.arity.inputs s → Term sig Γ s)
    (A : Structure sig) (e : Assignment A.carrier Γ) (y : A.carrier op.arity.output) :
    (Term.app op terms).Evaluates A e y ↔
      ∃ xs : Assignment A.carrier op.arity.inputs,
        (∀ {t} (i : Var op.arity.inputs t), (terms i).Evaluates A e (xs i)) ∧ A.Graph op xs y :=
  Iff.rfl

/-- With evaluated arguments, application evaluates precisely on the operation graph. -/
theorem evaluates_app_at (op : Operation sig) (terms : ∀ {s}, Var op.arity.inputs s → Term sig Γ s)
    (A : Structure sig) (e : Assignment A.carrier Γ) (xs : Assignment A.carrier op.arity.inputs)
    (hxs : ∀ {s} (index : Var op.arity.inputs s), (terms index).Evaluates A e (xs index))
    (y : A.carrier op.arity.output) :
    (Term.app op terms).Evaluates A e y ↔ A.Graph op xs y := by
  constructor
  · rintro ⟨ys, hys, hgraph⟩
    have h : ys = xs := Assignment.ext fun index =>
      (terms index).evaluates_unique A e (hys index) (hxs index)
    exact h ▸ hgraph
  · intro h
    exact ⟨xs, hxs, h⟩

/-- Both stages of a strict binding must evaluate. -/
theorem evaluates_let_iff {t : sig.SortType} (init : Term sig Γ s)
    (body : Term sig (s :: Γ) t) (A : Structure sig) (e : Assignment A.carrier Γ)
    (y : A.carrier t) : (Term.letBind init body).Evaluates A e y ↔
    ∃ x, init.Evaluates A e x ∧ body.Evaluates A (Assignment.cons x e) y :=
  Iff.rfl

/-- Evaluate terms in the special case of a signature of total operations and quantities. -/
def totalValue [IsEmpty sig.Partial] :
    {Γ : List sig.SortType} → {s : sig.SortType} → Term sig Γ s →
    (A : Structure sig) → Assignment A.carrier Γ → A.carrier s
  | _, _, .var index, _, e => e index
  | _, _, .app (.total f) terms, A, e =>
    A.total f ⟨fun index => totalValue (terms index) A e⟩
  | _, _, .app (.partialOp p) _, _, _ => isEmptyElim p
  | _, _, .app (.quantity q) terms, A, e =>
    A.quantity q ⟨fun index => totalValue (terms index) A e⟩
  | _, _, .letBind init body, A, e =>
    totalValue body A (Assignment.cons (totalValue init A e) e)

/-- The total evaluator yields the value of the general partial evaluation relation. -/
theorem evaluates_totalValue [IsEmpty sig.Partial] (A : Structure sig) (term : Term sig Γ s) :
    ∀ e : Assignment A.carrier Γ, term.Evaluates A e (term.totalValue A e) := by
  induction term with
  | var index => intro e; rfl
  | app op terms ih =>
    intro e
    cases op with
    | total f =>
      exact ⟨⟨fun index => (terms index).totalValue A e⟩, fun index => ih index e,
        (A.graph_total_iff f _ _).2 rfl⟩
    | partialOp p =>
      have impossible : False := isEmptyElim p
      exact impossible.elim
    | quantity q =>
      exact ⟨⟨fun index => (terms index).totalValue A e⟩, fun index => ih index e,
        (A.graph_quantity_iff q _ _).2 rfl⟩
  | letBind init body hi hb =>
    intro e
    exact ⟨init.totalValue A e, hi e, hb (Assignment.cons (init.totalValue A e) e)⟩

/-- The partial value in Definition 1.3, obtained from the unique evaluation relation. -/
noncomputable def eval (t : Term sig Γ s) (A : Structure sig) (e : Assignment A.carrier Γ) :
    Part (A.carrier s) :=
  ⟨∃ y, t.Evaluates A e y, fun h => Classical.choose h⟩

/-- Membership in the partial value is the underlying evaluation relation. -/
theorem mem_eval_iff (t : Term sig Γ s) (A : Structure sig) (e : Assignment A.carrier Γ)
    (y : A.carrier s) : y ∈ t.eval A e ↔ t.Evaluates A e y := by
  constructor
  · rintro ⟨h, rfl⟩
    exact Classical.choose_spec h
  · intro h
    exact ⟨⟨y, h⟩, t.evaluates_unique A e (Classical.choose_spec ⟨y, h⟩) h⟩

/-- The set of inputs at which a term has a value. -/
def domain (t : Term sig Γ s) (A : Structure sig) : Set (Assignment A.carrier Γ) :=
  {e | ∃ y, t.Evaluates A e y}

/-- The domain of a term is the domain of its partial value. -/
@[simp] theorem mem_domain_iff (t : Term sig Γ s) (A : Structure sig)
    (e : Assignment A.carrier Γ) : e ∈ t.domain A ↔ (t.eval A e).Dom :=
  Iff.rfl

/-- Express the value graph inside a context that already contains an output variable. -/
def graphAt : {Γ : List sig.SortType} → {s : sig.SortType} → {Δ : List sig.SortType} →
    Term sig Γ s → Renaming Γ Δ → Var Δ s → Formula sig Δ
  | _, _, _, .var index, ρ, out => .atom (.eq (ρ index) out)
  | _, _, Δ, .app op terms, ρ, out =>
    Formula.existsMany op.arity.inputs
      (.conj
        (Formula.conjoin op.arity.inputs fun index =>
          graphAt (terms index) (fun v => (ρ v).shift op.arity.inputs) (index.inLeft Δ))
        (.atom (.graph op (Var.inLeft Δ) (out.shift op.arity.inputs))))
  | _, _, _, .letBind init body, ρ, out =>
    .ex (.conj
      (graphAt init (fun index => .there (ρ index)) .here)
      (graphAt body (Renaming.lift ρ) (.there out)))

/-- The value graph of a variable is equality with the output. -/
theorem graphAt_var {Δ : List sig.SortType} (i : Var Γ s) (ρ : Renaming Γ Δ) (out : Var Δ s) :
    (Term.var (sig := sig) i).graphAt ρ out = .atom (.eq (ρ i) out) := rfl

/-- The graph of an application binds all argument values before using the primitive graph. -/
theorem graphAt_app {Δ : List sig.SortType} (op : Operation sig)
    (args : ∀ {t}, Var op.arity.inputs t → Term sig Γ t)
    (ρ : Renaming Γ Δ) (out : Var Δ op.arity.output) :
    (Term.app op args).graphAt ρ out = Formula.existsMany op.arity.inputs
      ((Formula.conjoin op.arity.inputs fun i =>
        (args i).graphAt (fun j => (ρ j).shift op.arity.inputs) (i.inLeft Δ)).conj
        (.atom (.graph op (Var.inLeft Δ) (out.shift op.arity.inputs)))) := rfl

/-- The graph of a strict binding shares its witness between the initializer and the body. -/
theorem graphAt_letBind {Δ : List sig.SortType} {a : sig.SortType}
    (init : Term sig Γ a) (body : Term sig (a :: Γ) s) (ρ : Renaming Γ Δ) (out : Var Δ s) :
    (Term.letBind init body).graphAt ρ out =
      ((init.graphAt (fun i => .there (ρ i)) .here).conj
        (body.graphAt (Renaming.lift ρ) (.there out))).ex := rfl

/-- A variable application graph introduces one witness per argument as in (1.3). -/
theorem graphAt_app_vars (op : Operation sig) (args : Renaming op.arity.inputs Γ)
    (out : Var Γ op.arity.output) :
    (Term.app op (fun i => Term.var (args i))).graphAt (fun i => i) out =
      Formula.existsMany op.arity.inputs
        (.conj
          (Formula.conjoin op.arity.inputs (fun i =>
            .atom (.eq ((args i).shift op.arity.inputs) (i.inLeft Γ))))
          (.atom (.graph op (Var.inLeft Γ) (out.shift op.arity.inputs)))) :=
  rfl

/-- The graph formula recognizes exactly semantic evaluation at its output variable. -/
theorem holds_graphAt (A : Structure sig) (t : Term sig Γ s) :
    ∀ {Δ : List sig.SortType} (ρ : Renaming Γ Δ) (out : Var Δ s)
      (e : Assignment A.carrier Δ),
      (t.graphAt ρ out).Holds A e ↔ t.Evaluates A (e.pull ρ) (e out) := by
  induction t with
  | var index => intros; rfl
  | app op terms ih =>
    intro Δ ρ out e
    simp only [graphAt, Formula.holds_existsMany, Formula.holds_conj, Formula.holds_conjoin,
      ih, Formula.holds_atom, Atomic.holds_graph, Assignment.pull_append_left,
      Assignment.pull_append_shift, Assignment.append_inLeft, Assignment.append_shift, Evaluates]
  | letBind init body hi hb =>
    intro Δ ρ out e
    simp only [graphAt, Formula.holds_ex, Formula.holds_conj, hi, hb, Assignment.pull_cons_there,
      Assignment.pull_lift_cons, Assignment.cons_here, Assignment.cons_there, Evaluates]

/-- The value graph `E_t` of (1.3) uses one fresh output position. -/
def graph (t : Term sig Γ s) : Formula sig (s :: Γ) :=
  t.graphAt (fun index => .there index) .here

/-- The canonical graph uses a fresh head variable as its output. -/
theorem graph_eq_graphAt (t : Term sig Γ s) : t.graph = t.graphAt (fun i => .there i) .here := rfl

/-- An assignment satisfies the value graph precisely at the term's defined value. -/
theorem holds_graph_iff (t : Term sig Γ s) (A : Structure sig) (e : Assignment A.carrier Γ)
    (y : A.carrier s) :
    t.graph.Holds A (Assignment.cons y e) ↔ y ∈ t.eval A e := by
  rw [t.mem_eval_iff]
  simpa only [graph, Assignment.pull_cons_there, Assignment.pull_id, Assignment.cons_here]
    using t.holds_graphAt A (fun index => Var.there index) Var.here (Assignment.cons y e)

/-- The graph formula asserts membership in the domain together with the specified value. -/
theorem holds_graph_iff_domain_value (t : Term sig Γ s) (A : Structure sig)
    (e : Assignment A.carrier Γ) (y : A.carrier s) :
    t.graph.Holds A (Assignment.cons y e) ↔
      ∃ he : e ∈ t.domain A, (t.eval A e).get ((t.mem_domain_iff A e).1 he) = y :=
  t.holds_graph_iff A e y

/-- The value graph is single-valued. -/
theorem graph_functional (t : Term sig Γ s) (A : Structure sig)
    (e : Assignment A.carrier Γ) {y z : A.carrier s}
    (hy : t.graph.Holds A (Assignment.cons y e)) (hz : t.graph.Holds A (Assignment.cons z e)) :
    y = z :=
  Part.mem_unique ((t.holds_graph_iff A e y).1 hy) ((t.holds_graph_iff A e z).1 hz)

/-- The formula `Def_t` existentially quantifies the graph's output. -/
def defined (t : Term sig Γ s) : Formula sig Γ := .ex t.graph

/-- Definedness is the existential closure of the value graph at its result sort. -/
theorem defined_eq_ex_graph (t : Term sig Γ s) : t.defined = t.graph.ex := rfl

/-- The satisfaction locus of the definedness formula is the domain of evaluation. -/
@[simp] theorem holds_defined (t : Term sig Γ s) (A : Structure sig)
    (e : Assignment A.carrier Γ) :
    t.defined.Holds A e ↔ e ∈ t.domain A := by
  simp only [defined, Formula.holds_ex, t.holds_graph_iff, t.mem_domain_iff, Part.dom_iff_mem]

/-- The satisfaction set of the definedness formula is exactly the term domain. -/
theorem defined_locus (t : Term sig Γ s) (A : Structure sig) :
    {e | t.defined.Holds A e} = t.domain A :=
  Set.ext (t.holds_defined A)

end Term

/-- A total operation, with its ordinary or quantity declaration tag. -/
inductive TotalSymbol (sig : Signature.{u}) : Type u
  | ordinary : sig.Total → TotalSymbol sig
  | quantity : sig.Quantity → TotalSymbol sig

/-- Read the symbol as an operation in the term language. -/
def TotalSymbol.operation {sig : Signature.{u}} : TotalSymbol sig → Operation sig
  | .ordinary f => .total f
  | .quantity q => .quantity q

/-- A declared total symbol whose input and output profile has been identified. -/
structure TypedTotal (sig : Signature.{u}) (profile : Arity sig.SortType) : Type u where
  /-- The existing symbol in the signature. -/
  symbol : TotalSymbol sig
  /-- Its declared profile agrees with the selected profile. -/
  arity_eq : symbol.operation.arity = profile

namespace TypedTotal

variable {sig : Signature.{u}} {profile : Arity sig.SortType}

/-- Apply the declared total symbol to a well-sorted family of terms. -/
def term (op : TypedTotal sig profile) {Γ : List sig.SortType}
    (args : ∀ {s}, Var profile.inputs s → Term sig Γ s) : Term sig Γ profile.output := by
  obtain ⟨symbol, h⟩ := op
  subst profile
  exact .app symbol.operation args

/-- Evaluate the interpretation of a declared total symbol on its typed input tuple. -/
def value (op : TypedTotal sig profile) (A : Structure sig)
    (xs : Assignment A.carrier profile.inputs) : A.carrier profile.output := by
  obtain ⟨symbol, h⟩ := op
  subst profile
  cases symbol with
  | ordinary f => exact A.total f xs
  | quantity q => exact A.quantity q xs

/-- Applying the selected symbol after evaluating the arguments gives its interpreted value. -/
theorem evaluates_term (op : TypedTotal sig profile) {Γ : List sig.SortType}
    (args : ∀ {s}, Var profile.inputs s → Term sig Γ s)
    (A : Structure sig) (e : Assignment A.carrier Γ) (xs : Assignment A.carrier profile.inputs)
    (h : ∀ {s} (index : Var profile.inputs s), (args index).Evaluates A e (xs index)) :
    (op.term args).Evaluates A e (op.value A xs) := by
  obtain ⟨symbol, hprofile⟩ := op
  subst profile
  cases symbol with
  | ordinary f =>
    exact (Term.evaluates_app_at (.total f) args A e xs h _).2 ((A.graph_total_iff f xs _).2 rfl)
  | quantity q =>
    exact (Term.evaluates_app_at (.quantity q) args A e xs h _).2 ((A.graph_quantity_iff q xs _).2 rfl)

end TypedTotal

namespace Formula

variable {sig : Signature.{u}} {Γ : List sig.SortType} {s : sig.SortType}

/-- Term equality shares one existential output between the two value graphs. -/
def termEq (t t' : Term sig Γ s) : Formula sig Γ := .ex (.conj t.graph t'.graph)

/-- A term equation binds a shared result of its two value graphs. -/
theorem termEq_eq_ex (t t' : Term sig Γ s) : termEq t t' = (t.graph.conj t'.graph).ex := rfl

/-- An expanded term equality is satisfied exactly when both terms have the same value. -/
@[simp] theorem holds_termEq (t t' : Term sig Γ s) (A : Structure sig)
    (e : Assignment A.carrier Γ) :
    (termEq t t').Holds A e ↔ ∃ y, y ∈ t.eval A e ∧ y ∈ t'.eval A e := by
  simp only [termEq, holds_ex, holds_conj, Term.holds_graph_iff]

/-- The reflexive equality of a partial term asserts its definedness. -/
theorem holds_termEq_self (t : Term sig Γ s) (A : Structure sig)
    (e : Assignment A.carrier Γ) : (termEq t t).Holds A e ↔ t.defined.Holds A e := by
  simp only [holds_termEq, Term.holds_defined, and_self, Term.mem_domain_iff, Part.dom_iff_mem]

/-- Bind the values of a tuple of terms before interpreting a formula on those values. -/
def bindArguments (Λ : List sig.SortType) (terms : ∀ {s}, Var Λ s → Term sig Γ s)
    (body : Formula sig (Λ ++ Γ)) : Formula sig Γ :=
  existsMany Λ (.conj
    (conjoin Λ fun index => (terms index).graphAt (fun var => var.shift Λ) (index.inLeft Γ))
    body)

/-- Binding arguments existentially quantifies their graph conjunction together with the body. -/
theorem bindArguments_eq_existsMany (Λ : List sig.SortType)
    (terms : ∀ {s}, Var Λ s → Term sig Γ s) (body : Formula sig (Λ ++ Γ)) :
    bindArguments Λ terms body = existsMany Λ
      ((conjoin Λ fun i => (terms i).graphAt (Var.shift Λ) (i.inLeft Γ)).conj body) := rfl

/-- Interpret the expansion of term arguments by an assignment of their evaluated values. -/
theorem holds_bindArguments (Λ : List sig.SortType) (terms : ∀ {s}, Var Λ s → Term sig Γ s)
    (body : Formula sig (Λ ++ Γ)) (A : Structure sig) (e : Assignment A.carrier Γ) :
    (bindArguments Λ terms body).Holds A e ↔
      ∃ xs : Assignment A.carrier Λ,
        (∀ {s} (index : Var Λ s), xs index ∈ (terms index).eval A e) ∧ body.Holds A (xs.append e) := by
  simp only [bindArguments, holds_existsMany, holds_conj, holds_conjoin, Term.holds_graphAt,
    Assignment.pull_append_shift, Assignment.pull_id, Assignment.append_inLeft, Term.mem_eval_iff]

/-- A relation applied to terms is expanded using their value graphs, as in (1.4). -/
def termRel (r : sig.Rel) (terms : ∀ {s}, Var (sig.relInputs r) s → Term sig Γ s) : Formula sig Γ :=
  bindArguments (sig.relInputs r) terms (.atom (.rel r (Var.inLeft Γ)))

/-- A term relation tests the relation atom after binding the argument values. -/
theorem termRel_eq_bindArguments (r : sig.Rel) (terms : ∀ {s}, Var (sig.relInputs r) s → Term sig Γ s) :
    termRel r terms = bindArguments (sig.relInputs r) terms (.atom (.rel r (Var.inLeft Γ))) := rfl

/-- A domain atom applied to terms is expanded using their value graphs. -/
def termDomain (p : sig.Partial) (terms : ∀ {s}, Var (sig.partialArity p).inputs s → Term sig Γ s) :
    Formula sig Γ :=
  bindArguments (sig.partialArity p).inputs terms (.atom (.domain p (Var.inLeft Γ)))

/-- A term domain formula tests the domain atom after binding the argument values. -/
theorem termDomain_eq_bindArguments (p : sig.Partial)
    (terms : ∀ {s}, Var (sig.partialArity p).inputs s → Term sig Γ s) :
    termDomain p terms = bindArguments (sig.partialArity p).inputs terms (.atom (.domain p (Var.inLeft Γ))) := rfl

/-- An operation graph can be applied to input terms together with a term for its output. -/
def termGraph (op : Operation sig) (terms : ∀ {s}, Var op.arity.inputs s → Term sig Γ s)
    (out : Term sig Γ op.arity.output) : Formula sig Γ :=
  bindArguments (op.arity.output :: op.arity.inputs)
    (fun index => match index with
      | .here => out
      | .there previous => terms previous)
    (.atom (.graph op (fun index => (Var.there index).inLeft Γ) (Var.here.inLeft Γ)))

/-- A term graph binds the output term and every input term before testing its graph atom. -/
theorem termGraph_eq_bindArguments (op : Operation sig) (terms : ∀ {s}, Var op.arity.inputs s → Term sig Γ s)
    (out : Term sig Γ op.arity.output) : termGraph op terms out =
      bindArguments (op.arity.output :: op.arity.inputs)
        (fun i => match i with
          | .here => out
          | .there index => terms index)
        (.atom (.graph op (fun i => (Var.there i).inLeft Γ) (Var.here.inLeft Γ))) := rfl

/-- A term relation tests the tuple of evaluated argument values. -/
theorem holds_termRel (r : sig.Rel) (terms : ∀ {s}, Var (sig.relInputs r) s → Term sig Γ s)
    (A : Structure sig) (e : Assignment A.carrier Γ) :
    (termRel r terms).Holds A e ↔
      ∃ xs : Assignment A.carrier (sig.relInputs r),
        (∀ {s} (index : Var (sig.relInputs r) s), xs index ∈ (terms index).eval A e) ∧
        xs ∈ A.relation r := by
  simp only [termRel, holds_bindArguments, holds_atom, Atomic.holds_rel, Assignment.pull_append_left]

/-- A domain atom tests the tuple of evaluated argument values. -/
theorem holds_termDomain (p : sig.Partial)
    (terms : ∀ {s}, Var (sig.partialArity p).inputs s → Term sig Γ s)
    (A : Structure sig) (e : Assignment A.carrier Γ) :
    (termDomain p terms).Holds A e ↔
      ∃ xs : Assignment A.carrier (sig.partialArity p).inputs,
        (∀ {s} (index : Var (sig.partialArity p).inputs s), xs index ∈ (terms index).eval A e) ∧
        xs ∈ A.partialDomain p := by
  simp only [termDomain, holds_bindArguments, holds_atom, Atomic.holds_domain,
    Assignment.pull_append_left]

/-- A term graph tests the graph on the evaluated arguments and output. -/
theorem holds_termGraph (op : Operation sig)
    (terms : ∀ {s}, Var op.arity.inputs s → Term sig Γ s) (out : Term sig Γ op.arity.output)
    (A : Structure sig) (e : Assignment A.carrier Γ) :
    (termGraph op terms out).Holds A e ↔
      ∃ (xs : Assignment A.carrier op.arity.inputs) (y : A.carrier op.arity.output),
        (∀ {s} (index : Var op.arity.inputs s), xs index ∈ (terms index).eval A e) ∧
        y ∈ out.eval A e ∧ A.Graph op xs y := by
  rw [termGraph, holds_bindArguments]
  constructor
  · rintro ⟨ys, hy, hg⟩
    have hp : (ys.append e).pull (fun i => (Var.there i).inLeft Γ) = ys.tail := by
      apply Assignment.ext
      intro t i
      exact Assignment.append_inLeft (.there i) ys e
    rw [holds_atom, Atomic.holds_graph, hp, Assignment.append_inLeft] at hg
    exact ⟨ys.tail, ys.head, fun index => hy (.there index), hy .here, hg⟩
  · rintro ⟨xs, y, hx, hy, hg⟩
    refine ⟨Assignment.cons y xs, ?_, ?_⟩
    · intro t index
      cases index with
      | here => exact hy
      | there previous => exact hx previous
    · have hp : ((Assignment.cons y xs).append e).pull
          (fun i => (Var.there i).inLeft Γ) = xs := by
        apply Assignment.ext
        intro t i
        exact Assignment.append_inLeft (.there i) (Assignment.cons y xs) e
      rw [holds_atom, Atomic.holds_graph, hp, Assignment.append_inLeft]
      exact hg

end Formula

end SHIGURE
