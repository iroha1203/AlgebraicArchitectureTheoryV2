import Formal.SHIGURE.Part1.Protocol
import Mathlib.CategoryTheory.PathCategory.Basic
import Mathlib.CategoryTheory.Quotient

/-! # Protocols presented by edges and path equations

The second part of Theorem 2.12 uses the free path category and its category
quotient by the specified path equations. State maps, readouts and their
commutation on edges suffice to reconstruct the protocol.

## Implementation notes

The generator action is a quiver action. Its named Laws compare the terms
of each specified pair of paths and impose readout naturality on edges.
They are enough to obtain a quotient functor via mathlib `Quotient.lift`.
An action with a state function already supplied for every quotient arrow
would make that reconstruction unnecessary and obscure the role of the Laws.
-/

universe u

namespace SHIGURE.Protocol.Generated

open CategoryTheory

variable {V : Type u} [Quiver.{u} V]

/-- The execution category generated by the quiver and its designated path equations. -/
abbrev Execution (relations : HomRel (Paths V)) := CategoryTheory.Quotient relations

/-- Include the generating edges into the actual path quotient. -/
def edges (relations : HomRel (Paths V)) : V ⥤q Execution relations :=
  Paths.of V ⋙q (CategoryTheory.Quotient.functor relations).toPrefunctor

/-- The observation data of the presentation is the observation action on the generators. -/
def observations {relations : HomRel (Paths V)} (O : Execution relations ⥤ Type u) : V ⥤q Type u :=
  edges relations ⋙q O.toPrefunctor

/-- The term of a path uses the original state variable and each successive named edge. -/
def pathTerm {i : V} : {j : V} → Quiver.Path i j → Term (signature V) [.inl i] (.inl j)
  | _, .nil => .var .here
  | _, .cons p e => applySymbol (.step e) (pathTerm p)

/-- The action on generating edges as a prefunctor. -/
def stateEdges {O : V ⥤q Type u} (X : Action O) : V ⥤q Type u where
  obj := X.state
  map e := X.step e

/-- The state action on a path is the actual free extension of the generating maps. -/
def pathValue {O : V ⥤q Type u} (X : Action O) {i j : V} (p : Quiver.Path i j) : X.state i → X.state j :=
  (Paths.lift (stateEdges X)).map p

/-- The empty path acts by the identity. -/
theorem pathValue_nil {O : V ⥤q Type u} (X : Action O) (i : V) (x : X.state i) :
    pathValue X (Quiver.Path.nil : Quiver.Path i i) x = x := rfl

/-- Appending a generator applies the corresponding state function after the prefix. -/
theorem pathValue_cons {O : V ⥤q Type u} (X : Action O) {i j k : V}
    (p : Quiver.Path i j) (e : j ⟶ k) (x : X.state i) :
    pathValue X (p.cons e) x = X.step e (pathValue X p x) := rfl

/-- The one-edge path executes the original generator. -/
theorem pathValue_edge {O : V ⥤q Type u} (X : Action O) {i j : V} (e : i ⟶ j) (x : X.state i) :
    pathValue X e.toPath x = X.step e x :=
  congrFun (Paths.lift_toPath (stateEdges X) e) x

/-- Evaluation of the composite of two paths is the composition of their evaluations. -/
theorem pathValue_comp {O : V ⥤q Type u} (X : Action O) {i j k : V}
    (p : Quiver.Path i j) (q : Quiver.Path j k) (x : X.state i) :
    pathValue X (p.comp q) x = pathValue X q (pathValue X p x) :=
  congrFun ((Paths.lift (stateEdges X)).map_comp p q) x

/-- Evaluating the term of a path is evaluating the successive named actions on its sole input. -/
theorem totalValue_pathTerm {O : V ⥤q Type u} (X : Action O) {i j : V} (p : Quiver.Path i j)
    (xs : Assignment X.toStructure.carrier [.inl i]) :
    (pathTerm p).totalValue X.toStructure xs = pathValue X p (xs .here) := by
  induction p with
  | nil => rfl
  | cons p e ih =>
    rw [show pathTerm (p.cons e) = applySymbol (.step e) (pathTerm p) from rfl,
      totalValue_applySymbol, Action.symbolValue_toStructure, ih, pathValue_cons]
    rfl

/-- A path equation is a Law comparing the two actual state terms at every input. -/
def relationLaw {i j : V} (p q : Quiver.Path i j) : Law (signature V) :=
  Law.equality (pathTerm p) (pathTerm q)

/-- A model satisfies a path equation exactly when both path actions agree. -/
theorem relationLaw_holds_iff {O : V ⥤q Type u} (X : Action O) {i j : V}
    (p q : Quiver.Path i j) : (relationLaw p q).Holds X.toStructure ↔ ∀ x, pathValue X p x = pathValue X q x := by
  rw [relationLaw, Law.holds_equality_totalValue_iff]
  simp only [totalValue_pathTerm]
  exact ⟨fun h x => h (Assignment.cons x Assignment.empty), fun h xs => h (xs .here)⟩

/-- Required equations for the edge presentation. -/
inductive LawName (relations : HomRel (Paths V))
  /-- Each related parallel pair is required to give equal state functions. -/
  | relation {i j : V} (p q : Quiver.Path i j) (related : relations p q)
  /-- The readout commutes on each generating edge. -/
  | naturality {i j : V} (e : i ⟶ j)

/-- The Law of a named path pair or generating edge. -/
def law {relations : HomRel (Paths V)} : LawName relations → Law (signature V)
  | .relation p q _ => relationLaw p q
  | .naturality e => observationLaw e

/-- The theory of the presentation requires the specified path equations and edge naturality. -/
def theory (relations : HomRel (Paths V)) : Theory.{u} := theoryWithLaws (law (relations := relations))

/-- Actions of generators with precisely the specified Laws and fixed observation functions. -/
abbrev Actions {relations : HomRel (Paths V)} (O : Execution relations ⥤ Type u) :=
  LawfulAction (observations O) (law (relations := relations))

/-- The semantic category with only the generating signature and its required Laws. -/
abbrev Models {relations : HomRel (Paths V)} (O : Execution relations ⥤ Type u) :=
  Semantic (observations O) (law (relations := relations))

variable {relations : HomRel (Paths V)} {O : Execution relations ⥤ Type u}

/-- The specified path equations make the free state action respect the quotient relations. -/
theorem statePaths_respects (X : Actions O) {i j : Paths V} (p q : i ⟶ j) (h : relations p q) :
    (Paths.lift (stateEdges X.obj)).map p = (Paths.lift (stateEdges X.obj)).map q :=
  funext ((relationLaw_holds_iff X.obj p q).1 (X.property (.relation p q h)))

/-- The reconstructed state action on the quotient is defined by the actual quotient lift. -/
def stateFunctor (X : Actions O) : Execution relations ⥤ Type u :=
  CategoryTheory.Quotient.lift relations (Paths.lift (stateEdges X.obj)) (fun _ _ => statePaths_respects X)

/-- On a representative path the quotient state action is the free state action. -/
theorem stateFunctor_map_path (X : Actions O) {i j : Paths V} (p : i ⟶ j) :
    (stateFunctor X).map ((CategoryTheory.Quotient.functor relations).map p) =
      pathValue X.obj (i := i) (j := j) p :=
  CategoryTheory.Quotient.lift_map_functor_map relations (Paths.lift (stateEdges X.obj))
    (fun _ _ => statePaths_respects X) p

/-- Executing the image of a generator evaluates the original state action of that edge. -/
theorem stateFunctor_map_edge (X : Actions O) {i j : V} (e : i ⟶ j) (x : X.obj.state i) :
    (stateFunctor X).map ((edges relations).map e) x = X.obj.step e x :=
  (congrFun (stateFunctor_map_path X e.toPath) x).trans (pathValue_edge X.obj e x)

/-- Edge naturality extends to the readout of every path. -/
theorem path_observe (X : Actions O) {i j : V} (p : Quiver.Path i j) (x : X.obj.state i) :
    X.obj.observe j (pathValue X.obj p x) =
      O.map ((CategoryTheory.Quotient.functor relations).map p) (X.obj.observe i x) := by
  induction p with
  | nil =>
    rw [pathValue_nil]
    change X.obj.observe i x =
      O.map ((CategoryTheory.Quotient.functor relations).map (𝟙 ((Paths.of V).obj i))) _
    rw [Functor.map_id, Functor.map_id, types_id_apply]
  | cons p e ih =>
    rw [pathValue_cons, (observationLaw_holds_iff X.obj e).1 (X.property (.naturality e)), ih]
    change O.map ((CategoryTheory.Quotient.functor relations).map e.toPath)
        (O.map ((CategoryTheory.Quotient.functor relations).map p) (X.obj.observe i x)) =
      O.map ((CategoryTheory.Quotient.functor relations).map (p ≫ e.toPath : _ ⟶ _)) (X.obj.observe i x)
    rw [Functor.map_comp, Functor.map_comp, types_comp_apply]

/-- The readout is natural along every quotient arrow by induction on its representative. -/
def toProtocol (X : Actions O) : Protocol O :=
  Over.mk (X := O) (Y := stateFunctor X) {
    app := fun a => X.obj.observe a.as
    naturality := by
      intro a b f
      induction f using CategoryTheory.Quotient.induction with
      | h p =>
        funext x
        change X.obj.observe _ ((stateFunctor X).map ((CategoryTheory.Quotient.functor relations).map p) x) = _
        rw [stateFunctor_map_path]
        exact path_observe X p x }

/-- Restrict a quotient protocol to its generating state actions and readouts. -/
def action (P : Protocol O) : Action (observations O) where
  state i := P.left.obj ((edges relations).obj i)
  step e := P.left.map ((edges relations).map e)
  observe i := P.hom.app ((edges relations).obj i)

/-- Free extension of the restricted generators agrees with the original state functor on paths. -/
theorem paths_lift_restrict (P : Protocol O) :
    Paths.lift (stateEdges (action P)) = CategoryTheory.Quotient.functor relations ⋙ P.left := by
  symm
  apply Paths.lift_unique
  rfl

/-- Along equality of functors to types, the action on an input transports its result. -/
private theorem map_transport {C : Type u} [Category.{u} C] {F G : C ⥤ Type u}
    (same : F = G) {i j : C} (p : i ⟶ j) (x : F.obj i) :
    cast (congrArg (fun K => K.obj j) same) (F.map p x) =
      G.map p (cast (congrArg (fun K => K.obj i) same) x) := by
  subst G
  rfl

/-- A path in the restricted action executes its image in the original quotient protocol. -/
theorem pathValue_restrict (P : Protocol O) {i j : Paths V} (p : i ⟶ j) (x : (action P).state i) :
    pathValue (action P) p x = P.left.map ((CategoryTheory.Quotient.functor relations).map p) x :=
  map_transport (paths_lift_restrict P) p x

/-- The restricted generating action satisfies the given path equations and the edge squares. -/
def ofProtocol (P : Protocol O) : Actions O :=
  ⟨action P, fun name => match name with
    | .relation p q h => (relationLaw_holds_iff (action P) p q).2 (by
        intro x
        rw [pathValue_restrict, pathValue_restrict, CategoryTheory.Quotient.sound relations h])
    | .naturality e => (observationLaw_holds_iff (action P) e).2
        (congrFun (P.hom.naturality ((edges relations).map e)))⟩

/-- A map commuting with the generators commutes with the state functions of all paths. -/
theorem path_state_comm {X Y : Actions O} (f : X ⟶ Y) {i j : V}
    (p : Quiver.Path i j) (x : X.obj.state i) :
    f.hom.state j (pathValue X.obj p x) = pathValue Y.obj p (f.hom.state i x) := by
  induction p with
  | nil => rfl
  | cons p e ih => rw [pathValue_cons, pathValue_cons, f.hom.step_comm, ih]

/-- Restrict a protocol map to its generator and readout squares. -/
def ofProtocolHom {P Q : Protocol O} (f : P ⟶ Q) : ofProtocol P ⟶ ofProtocol Q :=
  ObjectProperty.homMk {
    state i := f.left.app ((edges relations).obj i)
    step_comm e := congrFun (f.left.naturality ((edges relations).map e))
    observe_comm i := congrFun (NatTrans.congr_app (Over.w f) ((edges relations).obj i)) }

/-- The maps along generators and readouts extend to an actual quotient protocol map. -/
def toProtocolHom {X Y : Actions O} (f : X ⟶ Y) : toProtocol X ⟶ toProtocol Y := by
  let map : stateFunctor X ⟶ stateFunctor Y :=
    { app := fun a => f.hom.state a.as
      naturality := by
        intro a b e
        induction e using CategoryTheory.Quotient.induction with
        | h p =>
          funext x
          change f.hom.state _ ((stateFunctor X).map ((CategoryTheory.Quotient.functor relations).map p) x) =
            (stateFunctor Y).map ((CategoryTheory.Quotient.functor relations).map p) (f.hom.state _ x)
          rw [stateFunctor_map_path, stateFunctor_map_path]
          exact path_state_comm f p x }
  refine Over.homMk map ?_
  ext i x
  exact f.hom.observe_comm i.as x

/-- Restricting the extended action gives exactly its original generating data. -/
@[simp] theorem ofProtocol_toProtocol (X : Actions O) : ofProtocol (toProtocol X) = X := by
  apply ObjectProperty.FullSubcategory.ext
  cases X with
  | mk A h => cases A; rfl

/-- Equality of the state functors and transported readouts identifies over-category objects. -/
private theorem protocol_ext {P Q : Protocol O} (states : P.left = Q.left)
    (readouts : ∀ a x, P.hom.app a x = Q.hom.app a (cast (congrArg (fun F => F.obj a) states) x)) : P = Q := by
  obtain ⟨F, α, rfl⟩ := Over.mk_surjective P
  obtain ⟨G, β, rfl⟩ := Over.mk_surjective Q
  change F = G at states
  subst G
  have same : α = β := by
    ext a x
    exact readouts a x
  cases same
  rfl

/-- Extending the restricted action gives the original protocol on the quotient. -/
@[simp] theorem toProtocol_ofProtocol (P : Protocol O) : toProtocol (ofProtocol P) = P := by
  have states : stateFunctor (ofProtocol P) = P.left := by
    symm
    apply CategoryTheory.Quotient.lift_unique
    exact (paths_lift_restrict P).symm
  apply protocol_ext states
  intro a x
  cases a
  rfl

/-- Restrict protocols and all arrows to the generating signature and Law models. -/
def ofProtocols (O : Execution relations ⥤ Type u) : Protocol O ⥤ Actions O where
  obj := ofProtocol
  map := ofProtocolHom
  map_id _ := ObjectProperty.hom_ext _ (Action.hom_ext (fun _ _ => rfl))
  map_comp _ _ := ObjectProperty.hom_ext _ (Action.hom_ext (fun _ _ => rfl))

/-- Extend the generating signature action and its arrows to the actual execution quotient. -/
def toProtocols (O : Execution relations ⥤ Type u) : Actions O ⥤ Protocol O where
  obj := toProtocol
  map := toProtocolHom
  map_id _ := Over.OverMorphism.ext (by ext i x; rfl)
  map_comp _ _ := Over.OverMorphism.ext (by ext i x; rfl)

/-- Restriction followed by extension is strictly the identity on quotient protocols. -/
theorem ofProtocols_comp_toProtocols (O : Execution relations ⥤ Type u) :
    ofProtocols O ⋙ toProtocols O = 𝟭 (Protocol O) := by
  have objects (P : Protocol O) : (ofProtocols O ⋙ toProtocols O).obj P = (𝟭 _).obj P :=
    toProtocol_ofProtocol P
  refine Functor.ext objects ?_
  intro P Q f
  apply Over.OverMorphism.ext
  ext i x
  simp only [Over.comp_left, NatTrans.comp_app, types_comp_apply, eqToHom_app]
  cases i
  rfl

/-- Extension followed by restriction is strictly the identity on the generators and all their maps. -/
theorem toProtocols_comp_ofProtocols (O : Execution relations ⥤ Type u) :
    toProtocols O ⋙ ofProtocols O = 𝟭 (Actions O) := by
  have objects (X : Actions O) : (toProtocols O ⋙ ofProtocols O).obj X = (𝟭 _).obj X :=
    ofProtocol_toProtocol X
  refine Functor.ext objects ?_
  intro X Y f
  apply ObjectProperty.hom_ext (satisfies (observations O) (law (relations := relations)))
  let forget := (satisfies (observations O) (law (relations := relations))).ι
  change forget.map ((toProtocols O ⋙ ofProtocols O).map f) =
    forget.map (eqToHom (objects X) ≫ f ≫ eqToHom (objects Y).symm)
  rw [Functor.map_comp, Functor.map_comp, eqToHom_map, eqToHom_map]
  apply Action.hom_ext
  intro i x
  rw [Action.comp_state, Action.comp_state, Action.eqToHom_state, Action.eqToHom_state]
  rfl

/-- Restriction and extension give a strict isomorphism of categories. -/
def actionIso (O : Execution relations ⥤ Type u) : Cat.of (Protocol O) ≅ Cat.of (Actions O) where
  hom := (ofProtocols O).toCatHom
  inv := (toProtocols O).toCatHom
  hom_inv_id := congrArg Functor.toCatHom (ofProtocols_comp_toProtocols O)
  inv_hom_id := congrArg Functor.toCatHom (toProtocols_comp_ofProtocols O)

/-- The effective edge presentation and path Laws recover the quotient protocol category. -/
def modelIso (O : Execution relations ⥤ Type u) : Cat.of (Protocol O) ≅ Cat.of (Models O) :=
  actionIso O ≪≫ LawfulAction.modelIso (observations O) law

/-- The generating and the full execution signatures recover the same fixed-observation models. -/
def compareModels (O : Execution relations ⥤ Type u) : Cat.of (Protocol.Models O) ≅ Cat.of (Models O) :=
  (Protocol.modelIso O).symm ≪≫ modelIso O

end SHIGURE.Protocol.Generated
