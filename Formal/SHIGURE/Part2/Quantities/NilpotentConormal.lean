import Formal.SHIGURE.Part2.Quantities.NilpotentExample
import Mathlib.LinearAlgebra.TensorProduct.Tower
import Mathlib.RingTheory.Ideal.Cotangent

/-!
# The conormal direction of a square-zero quantity

Example 5.7 uses the original principal ideal in the ambient polynomial
algebra. Its conormal module is a free module of rank one over the quotient.
Changing coefficients to the origin retains that generator.
-/

open TensorProduct
open scoped TensorProduct

universe u

noncomputable section

namespace SHIGURE.Quantities

section Principal

variable {A : Type u} [CommRing A] (t : A)

/-- Multiplication by the chosen generator, with values in the principal ideal. -/
private def principalMultiply : A →ₗ[A] Ideal.span ({t} : Set A) :=
  LinearMap.toSpanSingleton A _ ⟨t, Ideal.subset_span (Set.mem_singleton t)⟩

/-- The generator of the principal conormal module and its ambient multiples. -/
private def principalConormalMap : A →ₗ[A] (Ideal.span ({t} : Set A)).Cotangent :=
  (Ideal.span ({t} : Set A)).toCotangent.comp (principalMultiply t)

/-- A multiple of a regular generator lies in the squared ideal exactly at the original ideal. -/
private theorem principalConormalMap_eq_zero (h : IsRegular t) (a : A) :
    principalConormalMap t a = 0 ↔ a ∈ Ideal.span ({t} : Set A) := by
  change (Ideal.span ({t} : Set A)).toCotangent (principalMultiply t a) = 0 ↔ _
  rw [Ideal.toCotangent_eq_zero]
  change a * t ∈ (Ideal.span ({t} : Set A)) ^ 2 ↔ _
  rw [pow_two, Ideal.span_singleton_mul_span_singleton, Ideal.mem_span_singleton, Ideal.mem_span_singleton]
  constructor
  · rintro ⟨b, hb⟩
    refine ⟨b, h.left ?_⟩
    simpa only [mul_assoc, mul_comm t a] using hb
  · rintro ⟨b, rfl⟩
    refine ⟨b, ?_⟩
    ac_rfl

/-- The quotient by a regular principal ideal identifies with its conormal module. -/
def principalConormalEquiv (h : IsRegular t) :
    let I := Ideal.span ({t} : Set A)
    (A ⧸ I) ≃ₗ[A ⧸ I] I.Cotangent := by
  let I := Ideal.span ({t} : Set A)
  let m := principalConormalMap t
  have hk : I ≤ LinearMap.ker m := fun a ha => (principalConormalMap_eq_zero t h a).mpr ha
  let f := Submodule.liftQ (I : Submodule A A) m hk
  let g : (A ⧸ I) →ₗ[A ⧸ I] I.Cotangent :=
    { toFun := f
      map_add' := map_add f
      map_smul' := by
        intro a z
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
        change f (a • z) = a • f z
        exact map_smul f a z }
  refine LinearEquiv.ofBijective g ⟨?_, ?_⟩
  · apply (LinearMap.ker_eq_bot).mp
    rw [LinearMap.ker_eq_bot']
    intro z hz
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
    change principalConormalMap t a = 0 at hz
    exact Ideal.Quotient.eq_zero_iff_mem.mpr ((principalConormalMap_eq_zero t h a).mp hz)
  · intro z
    obtain ⟨a, rfl⟩ := I.toCotangent_surjective z
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton.mp a.property
    refine ⟨Ideal.Quotient.mk I b, ?_⟩
    change I.toCotangent (principalMultiply t b) = I.toCotangent a
    apply congrArg I.toCotangent
    apply Subtype.ext
    change b * t = a.val
    rw [hb, mul_comm]

end Principal

variable (k : Type u) [CommRing k]

/-- The ambient polynomial ideal of Example 5.7. -/
def nilpotentPolynomialIdeal : Ideal (Polynomial k) :=
  Ideal.span ({Polynomial.X ^ 2} : Set (Polynomial k))

/-- The square of the original residual ideal is the ideal generated by the fourth power. -/
theorem nilpotentPolynomialIdeal_sq : (nilpotentPolynomialIdeal k) ^ 2 =
    Ideal.span ({Polynomial.X ^ 4} : Set (Polynomial k)) := by
  rw [nilpotentPolynomialIdeal, pow_two, Ideal.span_singleton_mul_span_singleton, ← pow_add]

/-- The zero point of the square-zero coordinate, as a map of algebras. -/
def nilpotentOrigin : (Polynomial k ⧸ nilpotentPolynomialIdeal k) →ₐ[k] k := by
  let f : Polynomial k →ₐ[k] k := Polynomial.aeval (0 : k)
  have h : nilpotentPolynomialIdeal k ≤ RingHom.ker f.toRingHom := by
    apply Ideal.span_le.mpr
    intro a ha
    have he : a = Polynomial.X ^ 2 := ha
    subst a
    change f (Polynomial.X ^ 2) = 0
    rw [map_pow, Polynomial.aeval_X, zero_pow (by decide : (2 : ℕ) ≠ 0)]
  exact Ideal.Quotient.liftₐ _ f h

/-- The algebra of the origin sends the distinguished coordinate to zero. -/
theorem nilpotentOrigin_X :
    nilpotentOrigin k (Ideal.Quotient.mk (nilpotentPolynomialIdeal k) Polynomial.X) = 0 := by
  change (Polynomial.aeval (0 : k)) (Polynomial.X : Polynomial k) = 0
  exact Polynomial.aeval_X _

variable {sig : Signature.{u}} (A : Structure sig)

/-- The origin of the original Law presentation, obtained from the polynomial quotient point. -/
def nilpotentModelOrigin : (nilpotentPresentation k A).Model k :=
  (nilpotentPresentation k A).modelAlgHomEquiv.symm
    ((nilpotentOrigin k).comp (nilpotentLawAlgebraEquiv k A).toAlgHom)

/-- The origin sends the universal quantity in the original Law presentation to zero. -/
theorem nilpotentModelOrigin_value : (nilpotentModelOrigin k A).val PUnit.unit PUnit.unit = 0 := by
  change nilpotentOrigin k
    (nilpotentLawAlgebraEquiv k A (Ideal.Quotient.mk (nilpotentPresentation k A).residualIdeal
      ((nilpotentPresentation k A).universalQuantity PUnit.unit PUnit.unit))) = 0
  rw [nilpotentLawAlgebraEquiv, Ideal.quotientEquivAlg_mk, nilpotentCoordinates_generator]
  exact nilpotentOrigin_X k

/-- Reduction of a Law model along the dual-number projection lies over the origin exactly in the stated directions. -/
theorem nilpotentDualModel_originFiber (q : (nilpotentPresentation k A).Model (DualNumber k)) :
    (nilpotentPresentation k A).map (TrivSqZeroExt.fstHom k k k) q = nilpotentModelOrigin k A ↔
      ∃! a : k, q = nilpotentDualModel k A a := by
  rw [← nilpotentDualModel_fiber]
  constructor
  · intro h
    exact (congrArg (fun q : (nilpotentPresentation k A).Model k => q.val PUnit.unit PUnit.unit) h).trans
      (nilpotentModelOrigin_value k A)
  · intro h
    apply Subtype.ext
    funext j x
    have hj : j = PUnit.unit := Subsingleton.elim (α := PUnit) _ _
    subst j
    have hx : x = PUnit.unit := Subsingleton.elim (α := PUnit) _ _
    subst x
    exact h.trans (nilpotentModelOrigin_value k A).symm

/-- The fiber of the original conormal module at the origin is the coefficient ring. -/
def nilpotentConormalFiber :
    let I := nilpotentPolynomialIdeal k
    letI : Algebra (Polynomial k ⧸ I) k := (nilpotentOrigin k).toRingHom.toAlgebra
    letI : Module (Polynomial k ⧸ I) I.Cotangent := Ideal.instModuleQuotientCotangent I
    k ⊗[Polynomial k ⧸ I] I.Cotangent ≃ₗ[k] k := by
  let I := nilpotentPolynomialIdeal k
  letI : Algebra (Polynomial k ⧸ I) k := (nilpotentOrigin k).toRingHom.toAlgebra
  let e := (principalConormalEquiv (Polynomial.X ^ 2 : Polynomial k)
    (Polynomial.isRegular_X_pow 2)).symm
  let extended := @LinearEquiv.baseChange (Polynomial k ⧸ I) k I.Cotangent (Polynomial k ⧸ I)
    inferInstance inferInstance inferInstance inferInstance inferInstance
    (Ideal.instModuleQuotientCotangent I) Semiring.toModule e
  exact extended.trans (AlgebraTensorModule.rid (Polynomial k ⧸ I) k k)

end SHIGURE.Quantities
