import Formal.SHIGURE.Part2.AffineFoundations
import Formal.SHIGURE.Part2.Copying.Coalgebra
import Formal.SHIGURE.Part2.Quantities.FixedModels
import Mathlib.LinearAlgebra.SymmetricAlgebra.Basis

/-!
# Universal quantities and their residual ideal

Construction 5.2 gives a coordinate for each quantity and its fixed argument.
The ideal retains the residual of every Law input, without finiteness conditions
on the collection of generators. Lemma 5.3 compares specialization with the
direct evaluation of the original terms.
-/

open AlgebraicGeometry CategoryTheory

universe u

noncomputable section

namespace SHIGURE.Quantities.Presentation

variable {k : Type u} [CommRing k] {sig : Signature.{u}} {A : Structure sig} (P : Presentation k A)
variable {R S : Type u} [CommRing R] [CommRing S] [Algebra k R] [Algebra k S]

/-- The free module with a basis indexed by the named quantity arguments. -/
abbrev FreeQuantityModule := P.Coordinate →₀ k

/-- The coordinate algebra in equation (5.1), in its polynomial presentation. -/
abbrev CoordinateAlgebra := MvPolynomial P.Coordinate k

/-- The symmetric algebra of the free quantity module has these polynomial coordinates. -/
def symmetricCoordinateEquiv : SymmetricAlgebra k P.FreeQuantityModule ≃ₐ[k] P.CoordinateAlgebra :=
  SymmetricAlgebra.equivMvPolynomial Finsupp.basisSingleOne

/-- The symmetric generator for a quantity argument is the corresponding variable. -/
theorem symmetricCoordinateEquiv_generator (x : P.Coordinate) :
    P.symmetricCoordinateEquiv (SymmetricAlgebra.ι k P.FreeQuantityModule (Finsupp.single x 1)) =
      MvPolynomial.X x := by
  exact SymmetricAlgebra.equivMvPolynomial_ι_apply Finsupp.basisSingleOne x

/-- The universal quantity records both the declaration and its specific argument. -/
def universalQuantity : P.Candidate P.CoordinateAlgebra := fun j x => MvPolynomial.X ⟨j, x⟩

/-- Evaluate both written sides at the universal quantity to get the named residual. -/
def residual (l : P.Law) (e : P.Input l) : P.CoordinateAlgebra :=
  (P.left l e).eval (fun x => P.universalQuantity x.1 x.2) -
    (P.right l e).eval (fun x => P.universalQuantity x.1 x.2)

/-- Record the residual as a linear map on the free module of Law inputs. -/
def residualMap (l : P.Law) : Copying.CopyCoalgebra k (P.Input l) →ₗ[k] P.CoordinateAlgebra :=
  Finsupp.linearCombination k (P.residual l)

/-- The residual map sends a basis element to the corresponding residual polynomial. -/
theorem residualMap_single (l : P.Law) (e : P.Input l) :
    P.residualMap l (Finsupp.single e 1) = P.residual l e := by
  simp [residualMap]

/-- The ideal generated by all required residuals in equation (5.2). -/
def residualIdeal : Ideal P.CoordinateAlgebra :=
  Ideal.span (Set.range (fun x : Σ l, P.Input l => P.residual x.1 x.2))

/-- The coordinate algebra on the common zero locus of the required Laws. -/
abbrev LawAlgebra := P.CoordinateAlgebra ⧸ P.residualIdeal

/-- The affine space that carries the universal quantities. -/
def ambientScheme : Over (Spec (CommRingCat.of k)) := specOver P.CoordinateAlgebra

/-- The affine scheme cut out by the required residuals. -/
def lawScheme : Over (Spec (CommRingCat.of k)) := specOver P.LawAlgebra

/-- The inclusion of the Law scheme is induced by quotienting by the original residual ideal. -/
def lawInclusion : P.lawScheme ⟶ P.ambientScheme :=
  specOverMap (Ideal.Quotient.mkₐ k P.residualIdeal)

/-- The coefficient evaluation determined by a quantity assignment. -/
def evaluate (q : P.Candidate R) : P.CoordinateAlgebra →ₐ[k] R :=
  (polynomialPointEquiv (k := k)).symm (fun x => q x.1 x.2)

/-- Evaluation of a variable recovers the assigned quantity. -/
@[simp]
theorem evaluate_X (q : P.Candidate R) (x : P.Coordinate) :
    P.evaluate q (MvPolynomial.X x) = q x.1 x.2 :=
  congrFun (polynomialPointEquiv.apply_symm_apply (fun x : P.Coordinate => q x.1 x.2)) x

/-- The coefficient evaluation is uniquely determined on the universal quantities. -/
theorem evaluate_unique (q : P.Candidate R) (f : P.CoordinateAlgebra →ₐ[k] R)
    (h : ∀ x : P.Coordinate, f (MvPolynomial.X x) = q x.1 x.2) : f = P.evaluate q := by
  apply MvPolynomial.algHom_ext
  intro x
  rw [h, evaluate_X]

/-- Specialization of a universal residual agrees with the original expression difference. -/
theorem evaluate_residual (q : P.Candidate R) (l : P.Law) (e : P.Input l) :
    P.evaluate q (P.residual l e) =
      (P.left l e).eval (fun x => q x.1 x.2) - (P.right l e).eval (fun x => q x.1 x.2) := by
  have h : P.evaluate q ∘ (fun x : P.Coordinate => P.universalQuantity x.1 x.2) =
      (fun x => q x.1 x.2) := funext (P.evaluate_X q)
  rw [residual, map_sub, ← Expression.eval_map, ← Expression.eval_map, h]

/-- Evaluation along a coefficient map agrees with postcomposition of the quantities. -/
theorem evaluate_natural (q : P.Candidate R) (f : R →ₐ[k] S) :
    f.comp (P.evaluate q) = P.evaluate (fun j x => f (q j x)) := by
  apply P.evaluate_unique
  intro x
  exact congrArg f (P.evaluate_X q x)

/-- A substituted written expression read at universal quantities specializes to its original state evaluation. -/
theorem evaluate_stateExpression_substitute {Γ Δ : List sig.SortType}
    (θ : Substitution sig Γ Δ) (e : θ.domain A)
    (term : Expression k (StateQuantityInput A (θ.value A e) P.Coordinate)) (q : P.Candidate R) :
    P.evaluate q ((StateQuantityInput.compile (term.rename (StateQuantityInput.substitute θ e))).eval
        (fun x => P.universalQuantity x.1 x.2)) =
      term.eval (fun x => q x.coordinate.1 x.coordinate.2) := by
  rw [StateQuantityInput.compile_substitute, ← Expression.eval_map]
  change ((term.rename StateQuantityInput.coordinate).eval
    (P.evaluate q ∘ fun x : P.Coordinate => P.universalQuantity x.1 x.2)) = _
  rw [Expression.eval_rename]
  congr 1
  funext x
  exact P.evaluate_X q x.coordinate

/-- Both sides of a substituted Law give the same residual difference at every candidate. -/
theorem evaluate_stateResidual_substitute {Γ Δ : List sig.SortType}
    (θ : Substitution sig Γ Δ) (e : θ.domain A)
    (left right : Expression k (StateQuantityInput A (θ.value A e) P.Coordinate)) (q : P.Candidate R) :
    P.evaluate q
      ((StateQuantityInput.compile (left.rename (StateQuantityInput.substitute θ e))).eval
        (fun x => P.universalQuantity x.1 x.2) -
       (StateQuantityInput.compile (right.rename (StateQuantityInput.substitute θ e))).eval
        (fun x => P.universalQuantity x.1 x.2)) =
      left.eval (fun x => q x.coordinate.1 x.coordinate.2) -
        right.eval (fun x => q x.coordinate.1 x.coordinate.2) := by
  rw [map_sub, P.evaluate_stateExpression_substitute, P.evaluate_stateExpression_substitute]

end SHIGURE.Quantities.Presentation
