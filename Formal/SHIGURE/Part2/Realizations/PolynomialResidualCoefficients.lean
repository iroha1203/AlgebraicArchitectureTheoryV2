import Mathlib.Data.Matrix.Mul
import Mathlib.Algebra.MvPolynomial.CommRing
import Mathlib.Algebra.MvPolynomial.Monad
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-! # Coefficients of polynomial residuals on free charts

The ideal is generated by every monomial coefficient in each original
output component. Substitution and multiplication by the output change
matrix preserve ideal containment, so inverse changes of basis preserve
the ideal. The results apply to the typed residuals of Definition 6.1.
-/

namespace SHIGURE.RealizationFamilies

noncomputable section

open MvPolynomial

universe u v w z j k p

variable {R : Type u} [CommRing R] {I : Type v} {O : Type w}

/-- The residual ideal on a free chart of Definition 6.1 is generated by
all monomial coefficients in every output component. -/
def polynomialResidualIdeal (r : O → MvPolynomial I R) : Ideal R :=
  Ideal.span {c | ∃ o m, coeff m (r o) = c}

/-- Testing containment of the residual ideal tests every coefficient of
the residuals in Definition 6.1. -/
theorem polynomialResidualIdeal_le_iff (r : O → MvPolynomial I R) (J : Ideal R) :
    polynomialResidualIdeal r ≤ J ↔ ∀ (o : O) (m : I →₀ ℕ), coeff m (r o) ∈ J := by
  rw [polynomialResidualIdeal, Ideal.span_le]
  constructor
  · intro contained o m
    exact contained ⟨o, m, rfl⟩
  · rintro contained _ ⟨o, m, rfl⟩
    exact contained o m

/-- In Definition 6.1 the universal input is the tuple of indeterminates.
Consequently vanishing under all algebra extensions is equivalent to
vanishing of every monomial coefficient. -/
theorem universalInput_vanishes_iff (r : O → MvPolynomial I R) :
    (∀ (S : Type (max u v)) [CommRing S] [Algebra R S] (input : I → S) (o : O),
      aeval input (r o) = 0) ↔ ∀ (o : O) (m : I →₀ ℕ), coeff m (r o) = 0 := by
  constructor
  · intro valid o m
    have h : r o = 0 := by
      simpa only [aeval_X_left_apply] using valid (MvPolynomial I R) X o
    rw [h, coeff_zero]
  · intro coefficients S _ _ input o
    have h : r o = 0 := by
      ext m
      rw [coeff_zero, coefficients o m]
    rw [h, map_zero]

/-- The generating ideal of Definition 6.1 commutes with an arbitrary
change of coefficient ring, using the image ideal. -/
theorem polynomialResidualIdeal_map {S : Type z} [CommRing S] (f : R →+* S)
    (r : O → MvPolynomial I R) :
    polynomialResidualIdeal (fun o => map f (r o)) = Ideal.map f (polynomialResidualIdeal r) := by
  unfold polynomialResidualIdeal
  rw [Ideal.map_span]
  congr 1
  ext c
  constructor
  · rintro ⟨o, m, eq⟩
    exact ⟨_, ⟨o, m, rfl⟩, (coeff_map f (r o) m).symm.trans eq⟩
  · rintro ⟨_, ⟨o, m, rfl⟩, eq⟩
    exact ⟨o, m, (coeff_map f (r o) m).trans eq⟩

/-- Substitution of the input polynomials in Definition 6.1 can only
produce coefficients in the ideal generated by the original residuals. -/
theorem polynomialResidualIdeal_subst_le {J : Type z} (substitute : I → MvPolynomial J R)
    (r : O → MvPolynomial I R) :
    polynomialResidualIdeal (fun o => bind₁ substitute (r o)) ≤ polynomialResidualIdeal r := by
  apply (polynomialResidualIdeal_le_iff _ _).2
  let K := polynomialResidualIdeal r
  let projection := Ideal.Quotient.mk K
  have zeroResidual (o : O) : map projection (r o) = 0 := by
    ext m
    rw [coeff_map, coeff_zero, Ideal.Quotient.eq_zero_iff_mem]
    exact (polynomialResidualIdeal_le_iff r K).1 le_rfl o m
  intro o m
  have zeroSubst : map projection (bind₁ substitute (r o)) = 0 := by
    rw [map_bind₁, zeroResidual, map_zero]
  have h := congrArg (coeff m) zeroSubst
  rw [coeff_map, coeff_zero] at h
  exact Ideal.Quotient.eq_zero_iff_mem.mp h


/-- Finite linear combinations of the output residuals of Definition 6.1
preserve containment in the original coefficient ideal. -/
theorem polynomialResidualIdeal_outputCombination_le {P : Type z} [Fintype O]
    (matrix : P → O → R) (r : O → MvPolynomial I R) :
    polynomialResidualIdeal (fun p => ∑ o, C (matrix p o) * r o) ≤ polynomialResidualIdeal r := by
  apply (polynomialResidualIdeal_le_iff _ _).2
  let K := polynomialResidualIdeal r
  let projection := Ideal.Quotient.mk K
  have zeroResidual (o : O) : map projection (r o) = 0 := by
    ext m
    rw [coeff_map, coeff_zero, Ideal.Quotient.eq_zero_iff_mem]
    exact (polynomialResidualIdeal_le_iff r K).1 le_rfl o m
  intro p m
  have zeroCombination : map projection (∑ o, C (matrix p o) * r o) = 0 := by
    simp only [map_sum, map_mul, zeroResidual, mul_zero, Finset.sum_const_zero]
  have h := congrArg (coeff m) zeroCombination
  rw [coeff_map, coeff_zero] at h
  exact Ideal.Quotient.eq_zero_iff_mem.mp h


/-- A polynomial substitution over the coefficient ring preserves inclusion
in the original residual ideal of Definition 6.1. -/
theorem polynomialResidualIdeal_reparameterize_le {J : Type j}
    (change : MvPolynomial I R →ₐ[R] MvPolynomial J R) (r : O → MvPolynomial I R) :
    polynomialResidualIdeal (fun o => change (r o)) ≤ polynomialResidualIdeal r := by
  have equal : change = bind₁ (fun i => change (X i)) := by
    apply algHom_ext
    intro i
    rw [bind₁_X_right]
  rw [equal]
  exact polynomialResidualIdeal_subst_le (fun i => change (X i)) r

/-- The two coordinate descriptions of Definition 6.1 generate the same
ideal whenever the forward and inverse substitution and output combinations
relate the respective residuals. -/
theorem polynomialResidualIdeal_changeCoordinates {J : Type j} {P : Type z}
    [Fintype O] [Fintype P] (r : O → MvPolynomial I R) (r' : P → MvPolynomial J R)
    (forward : MvPolynomial I R →ₐ[R] MvPolynomial J R)
    (backward : MvPolynomial J R →ₐ[R] MvPolynomial I R)
    (rows : P → O → R) (inverseRows : O → P → R)
    (eqForward : ∀ p, r' p = ∑ o, C (rows p o) * forward (r o))
    (eqBackward : ∀ o, r o = ∑ p, C (inverseRows o p) * backward (r' p)) :
    polynomialResidualIdeal r' = polynomialResidualIdeal r := by
  apply le_antisymm
  · calc
      _ = polynomialResidualIdeal (fun p => ∑ o, C (rows p o) * forward (r o)) :=
        congrArg polynomialResidualIdeal (funext eqForward)
      _ ≤ polynomialResidualIdeal (fun o => forward (r o)) :=
        polynomialResidualIdeal_outputCombination_le rows _
      _ ≤ _ := polynomialResidualIdeal_reparameterize_le forward r
  · calc
      _ = polynomialResidualIdeal (fun o => ∑ p, C (inverseRows o p) * backward (r' p)) :=
        congrArg polynomialResidualIdeal (funext eqBackward)
      _ ≤ polynomialResidualIdeal (fun p => backward (r' p)) :=
        polynomialResidualIdeal_outputCombination_le inverseRows _
      _ ≤ _ := polynomialResidualIdeal_reparameterize_le backward r'


section Matrices

variable {J : Type j} {K : Type k} {P : Type z} {Q : Type p}

/-- The coordinate change of Definition 6.1 substitutes the input
polynomials and combines the output components using the given matrix. -/
def transformPolynomialResiduals [Fintype O] (matrix : Matrix P O R)
    (substitute : MvPolynomial I R →ₐ[R] MvPolynomial J R) (r : O → MvPolynomial I R) :
    P → MvPolynomial J R :=
  fun p => ∑ o, C (matrix p o) * substitute (r o)

/-- Consecutive changes of output coordinates in Definition 6.1 multiply
their matrices, and the corresponding input substitutions compose. -/
theorem transformPolynomialResiduals_comp [Fintype O] [Fintype P]
    (A : Matrix P O R) (B : Matrix Q P R) (first : MvPolynomial I R →ₐ[R] MvPolynomial J R)
    (second : MvPolynomial J R →ₐ[R] MvPolynomial K R) (r : O → MvPolynomial I R) :
    transformPolynomialResiduals B second (transformPolynomialResiduals A first r) =
      transformPolynomialResiduals (B * A) (second.comp first) r := by
  funext q
  have constant (x : R) : second (C x) = C x := by
    simpa only [MvPolynomial.algebraMap_eq] using second.commutes x
  simp only [transformPolynomialResiduals, map_sum, map_mul, constant, Finset.mul_sum,
    Matrix.mul_apply, AlgHom.comp_apply]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro o _
  rw [Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro p _
  rw [mul_assoc]

/-- The identity coordinates of Definition 6.1 preserve each residual. -/
theorem transformPolynomialResiduals_id [Fintype O] [DecidableEq O] (r : O → MvPolynomial I R) :
    transformPolynomialResiduals (1 : Matrix O O R) (AlgHom.id R _) r = r := by
  funext o
  simp [transformPolynomialResiduals, Matrix.one_apply, apply_ite, Finset.sum_ite_eq]

/-- A change of basis with inverse output matrix and inverse input
substitution preserves the residual ideal in Definition 6.1. -/
theorem polynomialResidualIdeal_transform [Fintype O] [Fintype P] [DecidableEq O]
    (A : Matrix P O R) (B : Matrix O P R) (inverse : B * A = 1)
    (coordinates : MvPolynomial I R ≃ₐ[R] MvPolynomial J R) (r : O → MvPolynomial I R) :
    polynomialResidualIdeal (transformPolynomialResiduals A coordinates.toAlgHom r) =
      polynomialResidualIdeal r := by
  let r' := transformPolynomialResiduals A coordinates.toAlgHom r
  have reverse : transformPolynomialResiduals B coordinates.symm.toAlgHom r' = r := by
    rw [transformPolynomialResiduals_comp, inverse]
    have cancel : coordinates.symm.toAlgHom.comp coordinates.toAlgHom = AlgHom.id R _ := by
      exact AlgHom.ext (fun p => coordinates.symm_apply_apply p)
    rw [cancel, transformPolynomialResiduals_id]
  exact polynomialResidualIdeal_changeCoordinates r r' coordinates.toAlgHom coordinates.symm.toAlgHom
    A B (fun _ => rfl) (fun o => congrFun reverse.symm o)

end Matrices

section InputCoordinates

variable {J : Type j} {K : Type k}

/-- In the free chart of Definition 6.1, the input coordinates are
substituted by the linear forms given by the basis change matrix. -/
def linearPolynomialSubstitution [Fintype J] (A : Matrix I J R) :
    MvPolynomial I R →ₐ[R] MvPolynomial J R :=
  bind₁ (fun i => ∑ j, C (A i j) * X j)

/-- On an input variable, the substitution of Definition 6.1 has the
specified expression as a linear form. -/
theorem linearPolynomialSubstitution_X [Fintype J] (A : Matrix I J R) (i : I) :
    linearPolynomialSubstitution A (X i) = ∑ j, C (A i j) * X j :=
  bind₁_X_right _ _

/-- Performing two linear input substitutions multiplies their matrices. -/
theorem linearPolynomialSubstitution_comp [Fintype J] [Fintype K]
    (A : Matrix I J R) (B : Matrix J K R) :
    (linearPolynomialSubstitution B).comp (linearPolynomialSubstitution A) =
      linearPolynomialSubstitution (A * B) := by
  apply algHom_ext
  intro i
  have constant (x : R) : linearPolynomialSubstitution B (C x) = C x := by
    simpa only [MvPolynomial.algebraMap_eq] using (linearPolynomialSubstitution B).commutes x
  simp only [AlgHom.comp_apply, linearPolynomialSubstitution_X, map_sum, map_mul, constant,
    Finset.mul_sum, Matrix.mul_apply]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro l _
  rw [Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro j _
  rw [mul_assoc]

/-- In the original input basis, the substitution fixes every polynomial. -/
theorem linearPolynomialSubstitution_id [Fintype I] [DecidableEq I] :
    linearPolynomialSubstitution (1 : Matrix I I R) = AlgHom.id R _ := by
  apply algHom_ext
  intro i
  simp [linearPolynomialSubstitution_X, Matrix.one_apply, apply_ite, Finset.sum_ite_eq]

/-- Inverse input basis matrices in Definition 6.1 induce inverse
polynomial substitutions over the coefficient ring. -/
def linearPolynomialSubstitutionEquiv [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    (A : Matrix I J R) (B : Matrix J I R) (AB : A * B = 1) (BA : B * A = 1) :
    MvPolynomial I R ≃ₐ[R] MvPolynomial J R :=
  AlgEquiv.ofAlgHom (linearPolynomialSubstitution A) (linearPolynomialSubstitution B)
    (by rw [linearPolynomialSubstitution_comp, BA, linearPolynomialSubstitution_id])
    (by rw [linearPolynomialSubstitution_comp, AB, linearPolynomialSubstitution_id])

/-- The coefficient ideal of Definition 6.1 is unchanged by invertible
linear basis changes on the input and output coordinates. -/
theorem polynomialResidualIdeal_linearCoordinateChange
    {P : Type z} [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    [Fintype O] [Fintype P] [DecidableEq O]
    (A : Matrix I J R) (B : Matrix J I R) (AB : A * B = 1) (BA : B * A = 1)
    (U : Matrix P O R) (V : Matrix O P R) (VU : V * U = 1) (r : O → MvPolynomial I R) :
    polynomialResidualIdeal (transformPolynomialResiduals U (linearPolynomialSubstitution A) r) =
      polynomialResidualIdeal r :=
  polynomialResidualIdeal_transform U V VU (linearPolynomialSubstitutionEquiv A B AB BA) r

end InputCoordinates

section BaseChange

variable {S : Type p} [CommRing S] {J : Type j} {P : Type z}

/-- Changing coefficients in the linear input substitution of Definition
6.1 changes the entries of its matrix by the same ring map. -/
theorem map_linearPolynomialSubstitution [Fintype J]
    (f : R →+* S) (A : Matrix I J R) (r : MvPolynomial I R) :
    map f (linearPolynomialSubstitution A r) =
      linearPolynomialSubstitution (A.map f) (map f r) := by
  unfold linearPolynomialSubstitution
  rw [map_bind₁]
  have same : (fun i => map f (∑ j, C (A i j) * X j)) =
      (fun i => ∑ j, C ((A.map f) i j) * X j) := by
    funext i
    simp only [map_sum, map_mul, map_C, map_X, Matrix.map_apply]
  rw [same]

/-- Both linear changes of coordinates in Definition 6.1 commute with every
ring map, using the images of the two matrices entry by entry. -/
theorem map_linearCoordinateResiduals [Fintype O] [Fintype J]
    (f : R →+* S) (A : Matrix I J R) (U : Matrix P O R) (r : O → MvPolynomial I R) :
    (fun p => map f (transformPolynomialResiduals U (linearPolynomialSubstitution A) r p)) =
      transformPolynomialResiduals (U.map f) (linearPolynomialSubstitution (A.map f)) (fun o => map f (r o)) := by
  funext p
  simp only [transformPolynomialResiduals, map_sum, map_mul, map_C, Matrix.map_apply,
    map_linearPolynomialSubstitution]

end BaseChange

end

end SHIGURE.RealizationFamilies
