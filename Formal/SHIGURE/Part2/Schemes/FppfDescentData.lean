import Mathlib.CategoryTheory.Sites.Descent.Precoverage
import Formal.SHIGURE.Part2.Schemes.AffineFppfRefinement
import Formal.SHIGURE.Part2.Schemes.QuasiCoherentPullback

/-! # Descent data on the actual overlaps of an fppf cover -/

namespace SHIGURE.SchemeDescent

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits CategoryTheory.Pseudofunctor
open CategoryTheory.Pseudofunctor.LocallyDiscreteOpToCat Opposite

noncomputable section

universe t u v a b

section Overlaps

variable {C : Type u} [Category.{v} C] [HasPullbacks C]
  {F : Pseudofunctor (LocallyDiscrete Cᵒᵖ) Cat.{a, b}}
  {X : C} {ι : Type t} {U : ι → C} {f : ∀ i, U i ⟶ X}
  (D : F.DescentData f)

/-- The transition isomorphism on the actual double overlap. -/
def descentOverlapIso (i j : ι) :=
  D.iso (pullback.fst (f i) (f j) ≫ f i) (pullback.fst (f i) (f j)) (pullback.snd (f i) (f j))
    rfl (pullback.condition (f := f i) (g := f j)).symm

/-- Every comparison on a test object is pulled back from the actual double overlap. -/
theorem descentHom_eq_pullbackOverlap {T : C} (q : T ⟶ X)
    {i j : ι} (a : T ⟶ U i) (b : T ⟶ U j)
    (ha : a ≫ f i = q) (hb : b ≫ f j = q) :
    D.hom q a b ha hb =
      pullHom (descentOverlapIso D i j).hom (pullback.lift a b (ha.trans hb.symm)) a b := by
  let lift := pullback.lift a b (ha.trans hb.symm)
  have lfst : lift ≫ pullback.fst (f i) (f j) = a := pullback.lift_fst _ _ _
  have lsnd : lift ≫ pullback.snd (f i) (f j) = b := pullback.lift_snd _ _ _
  have lbase : lift ≫ pullback.fst (f i) (f j) ≫ f i = q := by
    rw [← Category.assoc, lfst, ha]
  exact (D.pullHom_hom lift _ q lbase _ _ rfl pullback.condition.symm a b lfst lsnd).symm

/-- The pullbacks of the pairwise transitions along any test triple satisfy the Čech cocycle. -/
theorem descentOverlap_cocycle {T : C} (q : T ⟶ X)
    {i j k : ι} (a : T ⟶ U i) (b : T ⟶ U j) (c : T ⟶ U k)
    (ha : a ≫ f i = q) (hb : b ≫ f j = q) (hc : c ≫ f k = q) :
    pullHom (descentOverlapIso D i j).hom (pullback.lift a b (ha.trans hb.symm)) a b ≫
      pullHom (descentOverlapIso D j k).hom (pullback.lift b c (hb.trans hc.symm)) b c =
        pullHom (descentOverlapIso D i k).hom (pullback.lift a c (ha.trans hc.symm)) a c := by
  calc
    _ = D.hom q a b ha hb ≫ D.hom q b c hb hc :=
      congrArg₂ (· ≫ ·) (descentHom_eq_pullbackOverlap D q a b ha hb).symm
        (descentHom_eq_pullbackOverlap D q b c hb hc).symm
    _ = D.hom q a c ha hc := D.hom_comp q a b c ha hb hc
    _ = _ := descentHom_eq_pullbackOverlap D q a c ha hc

end Overlaps

/-- The Grothendieck topology generated by jointly surjective flat,
locally finitely presented families. -/
abbrev fppfTopology : GrothendieckTopology Scheme.{u} :=
  (Scheme.precoverage FppfComponent).toGrothendieck

/-- The sieve generated by an actual fppf covering family is covering. -/
theorem fppfCover_sieve_mem {X : Scheme.{u}} (cover : FppfCover X) :
    Sieve.ofArrows cover.X cover.f ∈ fppfTopology X :=
  Precoverage.generate_mem_toGrothendieck cover.mem₀

/-- The category of descent data over the original fppf covering family. -/
abbrev FppfModuleDescentData {X : Scheme.{u}} (cover : FppfCover X) :=
  quasiCoherentModulesPseudofunctor.DescentData cover.f

/-- Restricting a global quasi-coherent module with its canonical comparisons. -/
abbrev fppfModuleComparison {X : Scheme.{u}} (cover : FppfCover X) :=
  quasiCoherentModulesPseudofunctor.toDescentData cover.f

end

end SHIGURE.SchemeDescent
