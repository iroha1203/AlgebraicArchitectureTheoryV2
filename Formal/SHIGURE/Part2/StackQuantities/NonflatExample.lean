import Formal.SHIGURE.Part2.AffineBaseChange
import Mathlib.Algebra.MvPolynomial.CommRing
import Mathlib.RingTheory.TensorProduct.MvPolynomial
import Mathlib.Algebra.Polynomial.Eval.Coeff

/-! # A non-flat specialization of a principal residual ideal

Here `Polynomial k` is `k[a]` and `MvPolynomial Unit (Polynomial k)` is
`k[a,t]`.  The coefficient map evaluates `a` at zero.  Regularity of the
two indeterminates is valid over an arbitrary commutative coefficient ring.
-/

open MvPolynomial TensorProduct
open scoped TensorProduct

noncomputable section

namespace SHIGURE.StackQuantities.Nonflat

universe u
variable (k : Type u) [CommRing k]

/-- The base ring `k[a]`. -/
abbrev Base := Polynomial k

/-- The ambient algebra `k[a,t]`. -/
abbrev Ambient := MvPolynomial Unit (Base k)

/-- Specialization of the base variable `a` to zero. -/
def specialize : Base k →+* k := Polynomial.evalRingHom 0

-- Fix the canonical self-action and polynomial-algebra action before
-- installing the evaluation algebra below.
local instance baseAlgebra : Algebra (Base k) (Base k) := Algebra.id _
local instance baseModule : Module (Base k) (Base k) := Semiring.toModule
local instance ambientAlgebra : Algebra (Base k) (Ambient k) := inferInstance
local instance ambientModule : Module (Base k) (Ambient k) := inferInstance

/-- The element `a t` in the ambient polynomial algebra. -/
def generator : Ambient k := C (Polynomial.X : Base k) * X ()

/-- The original residual ideal `(a t)`. -/
def residualIdeal : Ideal (Ambient k) := Ideal.span {generator k}

/-- Multiplication by `a t` is regular, even when `k` has zero divisors. -/
theorem generator_regular : IsRegular (generator k) := by
  rw [generator, C_mul_X_eq_monomial]
  exact (Polynomial.isRegular_X (R := k)).monomial

/-- Multiplication by `a t`, regarded as a map over the base `k[a]`. -/
def multiplyGenerator : Ambient k →ₗ[Base k] Ambient k :=
  LinearMap.mulLeft (Base k) (generator k)

/-- The range is exactly the actual residual ideal. -/
theorem multiplyGenerator_range :
    (multiplyGenerator k).range = (residualIdeal k).restrictScalars (Base k) := by
  ext x
  simp [multiplyGenerator, residualIdeal, Ideal.mem_span_singleton', mul_comm]

/-- Multiplication by `a t` identifies `k[a,t]` with the residual ideal
as a `k[a]`-module. -/
def generatorEquiv : Ambient k ≃ₗ[Base k] residualIdeal k :=
  LinearEquiv.ofInjective (multiplyGenerator k) (by
    intro x y h
    apply (generator_regular k).left
    simpa [multiplyGenerator] using h) ≪≫ₗ
    LinearEquiv.ofEq _ _ (multiplyGenerator_range k) ≪≫ₗ
    (Submodule.restrictScalarsEquiv (Base k) (Ambient k) (Ambient k) (residualIdeal k)).restrictScalars (Base k)

/-- The image of `1` under the multiplication is the polynomial `a t`. -/
theorem generatorEquiv_one : (generatorEquiv k 1 : Ambient k) = generator k := by
  simp [generatorEquiv, multiplyGenerator]

local instance idealModule : Module (Base k) (residualIdeal k) := inferInstance
local instance specializationAlgebra : Algebra (Base k) k := (specialize k).toAlgebra

/-- The generator survives as an element of the pulled-back ideal module. -/
theorem tensor_generator_ne_zero [Nontrivial k] :
    (1 : k) ⊗ₜ[Base k] generatorEquiv k 1 ≠ 0 := by
  intro h
  let evalT : Ambient k →ₗ[Base k] Base k :=
    (MvPolynomial.aeval (fun _ : Unit => (0 : Base k))).toLinearMap
  let detector : k ⊗[Base k] residualIdeal k →ₗ[k] k :=
    (AlgebraTensorModule.rid (Base k) k k).toLinearMap.comp
      ((evalT.baseChange k).comp ((generatorEquiv k).symm.toLinearMap.baseChange k))
  have hv := congrArg detector h
  have value : detector ((1 : k) ⊗ₜ[Base k] generatorEquiv k 1) = 1 := by
    simp [detector, evalT, LinearMap.baseChange_tmul, AlgebraTensorModule.rid_tmul]
  rw [value, map_zero] at hv
  exact one_ne_zero hv

/-- The image of `a t` in the scalar-extended ambient algebra is zero. -/
theorem generator_baseChange_eq_zero :
    (1 : k) ⊗ₜ[Base k] generator k = 0 := by
  apply (MvPolynomial.algebraTensorAlgEquiv (σ := Unit) (Base k) k).injective
  simp [generator, specialize, RingHom.algebraMap_toAlgebra]

/-- After specialization the image ideal, generated by the images of the
original residuals, is zero. -/
theorem imageIdeal_eq_bot :
    SHIGURE.baseChangeIdeal (R := Base k) k (residualIdeal k) = ⊥ := by
  rw [residualIdeal, SHIGURE.baseChangeIdeal_span (R := Base k)]
  simp [generator_baseChange_eq_zero]

/-- The complete base-changed inclusion map is zero, not only its value at
one selected tensor. -/
theorem inclusion_baseChange_eq_zero :
    (((residualIdeal k).subtype.restrictScalars (Base k)).baseChange k) = 0 := by
  apply AlgebraTensorModule.ext
  intro s x
  have hx : (1 : k) ⊗ₜ[Base k] (x : Ambient k) = 0 := by
    have member : (1 : k) ⊗ₜ[Base k] (x : Ambient k) ∈
        SHIGURE.baseChangeIdeal (R := Base k) k (residualIdeal k) := by
      exact Ideal.mem_map_of_mem
        (Algebra.TensorProduct.includeRight : Ambient k →ₐ[Base k] k ⊗[Base k] Ambient k)
        x.property
    rw [imageIdeal_eq_bot] at member
    exact member
  change s ⊗ₜ[Base k] (x : Ambient k) = 0
  have h := congrArg (fun z : k ⊗[Base k] Ambient k =>
    (s ⊗ₜ[Base k] (1 : Ambient k)) * z) hx
  simpa only [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, mul_zero] using h

/-- The actual base-changed inclusion sends the nonzero tensor generator to zero. -/
theorem inclusion_kills_tensor_generator :
    (((residualIdeal k).subtype.restrictScalars (Base k)).baseChange k)
      ((1 : k) ⊗ₜ[Base k] generatorEquiv k 1) = 0 := by
  rw [LinearMap.baseChange_tmul]
  change (1 : k) ⊗ₜ[Base k] (generatorEquiv k 1 : Ambient k) = 0
  rw [generatorEquiv_one]
  exact generator_baseChange_eq_zero k

/-- The pulled-back ideal module is nonzero while its actual inclusion
into the pulled-back ambient algebra is not injective. -/
theorem inclusion_baseChange_not_injective [Nontrivial k] :
    ¬ Function.Injective (((residualIdeal k).subtype.restrictScalars (Base k)).baseChange k) := by
  intro injective
  apply tensor_generator_ne_zero k
  apply injective
  rw [inclusion_baseChange_eq_zero]
  rfl

/-- The specialized quotient algebra is the polynomial algebra `k[t]`. -/
def quotientEquivPolynomial :
    ((k ⊗[Base k] Ambient k) ⧸ SHIGURE.baseChangeIdeal (R := Base k) k (residualIdeal k)) ≃ₐ[k]
      MvPolynomial Unit k :=
  (Ideal.quotientEquivAlgOfEq k (imageIdeal_eq_bot k)).trans
    ((AlgEquiv.quotientBot k _).trans (MvPolynomial.algebraTensorAlgEquiv (σ := Unit) (Base k) k))

end SHIGURE.StackQuantities.Nonflat
end
