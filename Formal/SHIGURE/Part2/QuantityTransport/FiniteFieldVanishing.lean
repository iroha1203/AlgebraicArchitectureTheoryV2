import Mathlib.Algebra.CharP.Algebra
import Mathlib.Algebra.MvPolynomial.Eval
import Mathlib.FieldTheory.Finite.Basic

/-!
# Vanishing on all tuples over a finite field

Example 5.12 identifies the vanishing ideal for an arbitrary variable
set. The quotient by the coordinate Frobenius equations is reduced,
and its prime quotients recover the original field by evaluation.
-/

open scoped BigOperators

universe u

namespace SHIGURE.Quantities

variable (k X : Type u) [Field k] [Fintype k]

/-- The ideal generated by the coordinate equations (tₓ^|k| − tₓ). -/
def finiteFieldCoordinateIdeal : Ideal (MvPolynomial X k) :=
  Ideal.span (Set.range fun x : X => MvPolynomial.X x ^ Fintype.card k - MvPolynomial.X x)

local notation "N" => Fintype.card k
local notation "J" => finiteFieldCoordinateIdeal k X

/-- Each coordinate power relation belongs to the ideal it generates. -/
private theorem coordinatePower_mem (x : X) :
    (MvPolynomial.X x ^ N - MvPolynomial.X x : MvPolynomial X k) ∈ J :=
  Ideal.subset_span (Set.mem_range_self x)

/-- In the quotient all elements, including sums of monomials, satisfy the same power equation. -/
private theorem quotient_pow_card (y : MvPolynomial X k) :
    Ideal.Quotient.mk J y ^ N = Ideal.Quotient.mk J y := by
  let p := ringChar k
  obtain ⟨n, prime, card⟩ := FiniteField.card k p
  letI : Fact (Nat.Prime p) := ⟨prime⟩
  letI : CharP (MvPolynomial X k) p :=
    charP_of_injective_ringHom (MvPolynomial.C_injective X k) p
  let F := iterateFrobenius (MvPolynomial X k) p (n : ℕ)
  let m := Ideal.Quotient.mk J
  have generatorPower (x : X) : m (MvPolynomial.X x) ^ N = m (MvPolynomial.X x) := by
    have h := Ideal.Quotient.eq_zero_iff_mem.mpr (coordinatePower_mem k X x)
    rw [map_sub, map_pow] at h
    exact sub_eq_zero.mp h
  have same : m.comp F = m := by
    apply MvPolynomial.ringHom_ext
    · intro a
      change m ((MvPolynomial.C a) ^ (p ^ (n : ℕ))) = m (MvPolynomial.C a)
      rw [← card, ← map_pow, FiniteField.pow_card]
    · intro x
      change m ((MvPolynomial.X x) ^ (p ^ (n : ℕ))) = m (MvPolynomial.X x)
      rw [← card, map_pow]
      exact generatorPower x
  have hy := RingHom.congr_fun same y
  change m (y ^ (p ^ (n : ℕ))) = m y at hy
  rwa [map_pow, ← card] at hy

/-- The coordinate equations generate a radical ideal. -/
private theorem finiteFieldCoordinateIdeal_radical : (finiteFieldCoordinateIdeal k X).IsRadical := by
  apply (Ideal.isRadical_iff_pow_one_lt N Fintype.one_lt_card).mpr
  intro y hy
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  rw [← quotient_pow_card k X y, ← map_pow]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr hy

/-- An integral domain over k in which all elements satisfy the Frobenius equation is just k. -/
private theorem finiteFieldAlgebra_surjective {B : Type u} [CommRing B] [IsDomain B] [Algebra k B]
    (fixed : ∀ b : B, b ^ N = b) : Function.Surjective (algebraMap k B) := by
  classical
  let P : Polynomial k := Polynomial.X ^ N - Polynomial.X
  have deg : P.natDegree = N := FiniteField.X_pow_card_sub_X_natDegree_eq k Fintype.one_lt_card
  have monic : P.Monic := by
    apply (Polynomial.monic_X_pow N).sub_of_left
    rw [Polynomial.degree_X, Polynomial.degree_X_pow]
    exact_mod_cast (Fintype.one_lt_card : 1 < N)
  have factoring := Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq monic (by
    change P.roots.card = P.natDegree
    rw [deg, show P.roots = Finset.univ.val from FiniteField.roots_X_pow_card_sub_X k]
    rfl)
  have factorization : (∏ a ∈ (Finset.univ : Finset k), (Polynomial.X - Polynomial.C a)) = P := by
    change (Finset.univ.val.map (fun a : k => Polynomial.X - Polynomial.C a)).prod = P
    simpa only [show P.roots = Finset.univ.val from FiniteField.roots_X_pow_card_sub_X k] using factoring
  intro b
  have atB := congrArg (Polynomial.aeval b) factorization
  change (Polynomial.aeval b) (∏ a ∈ (Finset.univ : Finset k), (Polynomial.X - Polynomial.C a)) =
    (Polynomial.aeval b) (Polynomial.X ^ N - Polynomial.X) at atB
  simp only [map_prod, map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, fixed, sub_self] at atB
  obtain ⟨a, _, heq⟩ := Finset.prod_eq_zero_iff.mp atB
  exact ⟨a, (sub_eq_zero.mp heq).symm⟩

/-- A polynomial vanishes on every k-valued tuple exactly when it is in the coordinate ideal. -/
theorem mem_finiteFieldCoordinateIdeal_iff (f : MvPolynomial X k) :
    f ∈ J ↔ ∀ x : X → k, MvPolynomial.eval x f = 0 := by
  constructor
  · intro hf x
    have included : J ≤ RingHom.ker (MvPolynomial.eval x) := by
      rw [finiteFieldCoordinateIdeal, Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      change MvPolynomial.eval x (MvPolynomial.X i ^ N - MvPolynomial.X i) = 0
      rw [map_sub, map_pow, MvPolynomial.eval_X, FiniteField.pow_card, sub_self]
    exact included hf
  · intro zero
    rw [← (finiteFieldCoordinateIdeal_radical k X).radical, Ideal.radical_eq_sInf, Ideal.mem_sInf]
    intro P hP
    obtain ⟨included, prime⟩ := hP
    letI : P.IsPrime := prime
    have fixed : ∀ b : MvPolynomial X k ⧸ P, b ^ N = b := by
      intro b
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective b
      have h : a ^ N - a ∈ J := by
        apply Ideal.Quotient.eq_zero_iff_mem.mp
        rw [map_sub, map_pow, quotient_pow_card, sub_self]
      have h' := Ideal.Quotient.eq_zero_iff_mem.mpr (included h)
      rw [map_sub, map_pow] at h'
      exact sub_eq_zero.mp h'
    let e := AlgEquiv.ofBijective (Algebra.ofId k (MvPolynomial X k ⧸ P))
      ⟨(algebraMap k (MvPolynomial X k ⧸ P)).injective, finiteFieldAlgebra_surjective k fixed⟩
    let v : X → k := fun x => e.symm (Ideal.Quotient.mk P (MvPolynomial.X x))
    have eval : e.symm.toAlgHom.comp (Ideal.Quotient.mkₐ k P) = MvPolynomial.aeval v := by
      apply MvPolynomial.algHom_ext
      intro x
      exact (MvPolynomial.aeval_X v x).symm
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    apply e.symm.injective
    have h := AlgHom.congr_fun eval f
    change e.symm (Ideal.Quotient.mk P f) = MvPolynomial.aeval v f at h
    rwa [MvPolynomial.aeval_eq_eval, zero v, ← map_zero e.symm] at h

/-- The vanishing ideal of the full set of native inputs is generated by the coordinate relations. -/
theorem finiteField_vanishingIdeal :
    (⨅ x : X → k, RingHom.ker (MvPolynomial.eval x)) = J := by
  ext f
  simp only [Ideal.mem_iInf, RingHom.mem_ker, mem_finiteFieldCoordinateIdeal_iff]

end SHIGURE.Quantities
