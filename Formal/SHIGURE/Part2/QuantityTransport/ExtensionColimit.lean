import Formal.SHIGURE.Part2.QuantityTransport.FiniteExtensionStages
import Mathlib.Algebra.Category.CommAlgCat.Basic
import Mathlib.CategoryTheory.Category.Preorder
import Mathlib.CategoryTheory.Limits.FunctorCategory.Basic
import Mathlib.CategoryTheory.Yoneda

/-!
# The colimit of the finite extension stages

The union of two finite monomial sets is a common stage. Two
representatives agree there precisely when they give the same
polynomial. The quotient by that relation has the colimit
universal property and is natural in the coefficient algebra.

## Implementation notes

Mathlib's filtered colimit of types can identify representatives using the
existence of a common stage. Here the setoid uses equality of the represented
polynomials so that its inverse can read the actual support of a polynomial.
The union of the two supports realizes the common-stage relation, and the
pointwise universal property gives the colimit in the functor category.
-/

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite
open scoped BigOperators

universe u

noncomputable section

namespace SHIGURE.Quantities

variable {k D X C : Type u} [CommRing k] [CommRing C] [Algebra k C]
variable (q : D → X → k) (ε : D → k)

/-- A point represented in some finite stage. -/
abbrev ExtensionRepresentative :=
  Σ F : Finset (X →₀ ℕ), StagePoint (C := C) q ε F

/-- Read the underlying polynomial of an element of a finite stage. -/
def representativePolynomial (a : ExtensionRepresentative (C := C) q ε) :
    ExtensionPolynomial (C := C) q ε :=
  (stagePointPolynomialEquiv q ε a.1 a.2).val

/-- Extending to a larger stage does not change the polynomial. -/
theorem extendStagePoint_polynomial {F G : Finset (X →₀ ℕ)} (h : F ⊆ G)
    (a : StagePoint (C := C) q ε F) :
    (stagePointPolynomialEquiv q ε G (extendStagePoint q ε F h a)).val =
      (stagePointPolynomialEquiv q ε F a).val := by
  unfold extendStagePoint
  rw [Equiv.apply_symm_apply]

open Classical in
/-- Two finite-stage representatives have the same polynomial exactly when they agree
after including both in their union stage. -/
theorem representative_eq_iff_union (a b : ExtensionRepresentative (C := C) q ε) :
    representativePolynomial q ε a = representativePolynomial q ε b ↔
      extendStagePoint q ε a.1 Finset.subset_union_left a.2 =
        extendStagePoint q ε b.1 Finset.subset_union_right b.2 := by
  classical
  let E := stagePointPolynomialEquiv (C := C) q ε (a.1 ∪ b.1)
  constructor
  · intro eq
    apply E.injective
    apply Subtype.ext
    rw [extendStagePoint_polynomial, extendStagePoint_polynomial]
    exact eq
  · intro eq
    have same := congrArg (fun p => (E p).val) eq
    change (stagePointPolynomialEquiv q ε _ (extendStagePoint q ε _ _ _)).val =
      (stagePointPolynomialEquiv q ε _ (extendStagePoint q ε _ _ _)).val at same
    rw [extendStagePoint_polynomial, extendStagePoint_polynomial] at same
    exact same

/-- The equivalence relation on finite stages generated by passing to a common larger stage. -/
def extensionRepresentativeSetoid : Setoid (ExtensionRepresentative (C := C) q ε) where
  r a b := representativePolynomial q ε a = representativePolynomial q ε b
  iseqv := ⟨fun _ => rfl, fun e => e.symm, fun e f => e.trans f⟩

/-- The pointwise colimit of all finite stages on a coefficient algebra. -/
abbrev ExtensionColimit := Quotient (extensionRepresentativeSetoid (C := C) q ε)

/-- The map into the colimit from the indicated finite stage. -/
def stageToColimit (F : Finset (X →₀ ℕ)) (a : StagePoint (C := C) q ε F) :
    ExtensionColimit (C := C) q ε :=
  Quotient.mk _ ⟨F, a⟩

/-- Classes in the colimit are exactly the extending polynomials, each represented on its support. -/
def extensionColimitEquiv : ExtensionColimit (C := C) q ε ≃ ExtensionPolynomial (C := C) q ε where
  toFun := Quotient.lift (representativePolynomial q ε) (fun _ _ eq => eq)
  invFun p := stageToColimit q ε p.val.support
    ((stagePointPolynomialEquiv q ε p.val.support).symm ⟨p, Finset.Subset.refl _⟩)
  left_inv x := by
    refine Quotient.inductionOn x ?_
    intro a
    apply Quotient.sound
    change (stagePointPolynomialEquiv q ε _ ((stagePointPolynomialEquiv q ε _).symm _)).val = _
    rw [Equiv.apply_symm_apply]
    rfl
  right_inv p := by
    change (stagePointPolynomialEquiv q ε _ ((stagePointPolynomialEquiv q ε _).symm _)).val = _
    rw [Equiv.apply_symm_apply]

/-- A compatible family of maps on the stages factors through the colimit. -/
def extensionColimitLift {Y : Type u}
    (family : ∀ F : Finset (X →₀ ℕ), StagePoint (C := C) q ε F → Y)
    (agree : ∀ (F G : Finset (X →₀ ℕ)) (h : F ⊆ G) (a : StagePoint (C := C) q ε F),
      family G (extendStagePoint q ε F h a) = family F a) :
    ExtensionColimit (C := C) q ε → Y :=
  Quotient.lift (fun a => family a.1 a.2) (fun a b eq => by
    classical
    have same := (representative_eq_iff_union q ε a b).mp eq
    exact (agree _ _ Finset.subset_union_left a.2).symm.trans
      ((congrArg (family _) same).trans (agree _ _ Finset.subset_union_right b.2)))

/-- The factorization is uniquely determined by the maps on the stages. -/
theorem extensionColimitLift_unique {Y : Type u}
    (family : ∀ F : Finset (X →₀ ℕ), StagePoint (C := C) q ε F → Y)
    (agree : ∀ (F G : Finset (X →₀ ℕ)) (h : F ⊆ G) (a : StagePoint (C := C) q ε F),
      family G (extendStagePoint q ε F h a) = family F a)
    (g : ExtensionColimit (C := C) q ε → Y)
    (hg : ∀ F (a : StagePoint (C := C) q ε F), g (stageToColimit q ε F a) = family F a) :
    g = extensionColimitLift q ε family agree := by
  funext z
  refine Quotient.inductionOn z ?_
  intro a
  exact hg a.1 a.2

variable {C' : Type u} [CommRing C'] [Algebra k C']

/-- A coefficient map applies to each stage coordinate and preserves its extension equations. -/
def mapStagePoint (F : Finset (X →₀ ℕ)) (f : C →ₐ[k] C') (a : StagePoint (C := C) q ε F) :
    StagePoint (C := C') q ε F :=
  ⟨fun m => f (a.val m), fun d => by
    have h := congrArg f (a.property d)
    simpa only [map_sum, map_mul, AlgHom.commutes] using h⟩

/-- The polynomial of a stage point changes coefficients coefficientwise. -/
theorem stagePolynomial_mapStagePoint (F : Finset (X →₀ ℕ)) (f : C →ₐ[k] C')
    (a : StagePoint (C := C) q ε F) :
    stagePolynomial F (mapStagePoint q ε F f a).val =
      MvPolynomial.map f.toRingHom (stagePolynomial F a.val) := by
  simp only [stagePolynomial, mapStagePoint, map_sum, MvPolynomial.map_monomial]
  rfl

/-- Coefficient change on the colimit applies the coefficient map to an extending polynomial. -/
def extensionColimitMap (f : C →ₐ[k] C') (x : ExtensionColimit (C := C) q ε) :
    ExtensionColimit (C := C') q ε :=
  (extensionColimitEquiv q ε).symm (mapExtensionPolynomial q ε f (extensionColimitEquiv q ε x))

/-- The maps from the stages are natural in the coefficient algebra. -/
theorem stageToColimit_natural (F : Finset (X →₀ ℕ)) (f : C →ₐ[k] C')
    (a : StagePoint (C := C) q ε F) :
    extensionColimitMap q ε f (stageToColimit q ε F a) =
      stageToColimit q ε F (mapStagePoint q ε F f a) := by
  apply (extensionColimitEquiv q ε).injective
  unfold extensionColimitMap
  rw [Equiv.apply_symm_apply]
  apply Subtype.ext
  exact (stagePolynomial_mapStagePoint q ε F f a).symm

/-- The regular extension functor of Theorem 5.11. -/
def extensionFunctor : CommAlgCat.{u} k ⥤ Type u where
  obj C := ExtensionColimit (C := C) q ε
  map f := ↾extensionColimitMap q ε f.hom
  map_id C := by
    ext x
    apply (extensionColimitEquiv q ε).injective
    change extensionColimitEquiv q ε (extensionColimitMap q ε (AlgHom.id k C) x) = _
    unfold extensionColimitMap
    rw [Equiv.apply_symm_apply]
    apply Subtype.ext
    exact MvPolynomial.map_id _
  map_comp f g := by
    ext x
    apply (extensionColimitEquiv q ε).injective
    change extensionColimitEquiv q ε (extensionColimitMap q ε (g.hom.comp f.hom) x) =
      extensionColimitEquiv q ε (extensionColimitMap q ε g.hom (extensionColimitMap q ε f.hom x))
    simp only [extensionColimitMap, Equiv.apply_symm_apply]
    apply Subtype.ext
    exact (MvPolynomial.map_map _ _ _).symm

/-- The functor of affine test points of a single stage. -/
def stagePointFunctor (F : Finset (X →₀ ℕ)) : CommAlgCat.{u} k ⥤ Type u where
  obj C := StagePoint (C := C) q ε F
  map f := ↾mapStagePoint q ε F f.hom
  map_id _ := rfl
  map_comp _ _ := rfl

/-- Changing coefficients commutes with enlarging the stage by zero coefficients. -/
private theorem mapStagePoint_extend {F G : Finset (X →₀ ℕ)} (h : F ⊆ G) (f : C →ₐ[k] C')
    (a : StagePoint (C := C) q ε F) :
    extendStagePoint q ε F h (mapStagePoint q ε F f a) =
      mapStagePoint q ε G f (extendStagePoint q ε F h a) := by
  classical
  apply Subtype.ext
  funext m
  change (extendStagePoint q ε F h (mapStagePoint q ε F f a)).val m =
    f ((extendStagePoint q ε F h a).val m)
  rw [extendStagePoint_coeff, extendStagePoint_coeff]
  by_cases hm : m.val ∈ F
  · rw [dif_pos hm, dif_pos hm]
    rfl
  · rw [dif_neg hm, dif_neg hm, map_zero]

/-- The diagram of the finite-stage point functors and the geometric inclusions' zero-extension maps. -/
def extensionStageDiagram : Finset (X →₀ ℕ) ⥤ (CommAlgCat.{u} k ⥤ Type u) where
  obj := stagePointFunctor q ε
  map h :=
    { app := fun _ => ↾extendStagePoint q ε _ (leOfHom h)
      naturality := fun {_ _} f => by
        ext a
        exact mapStagePoint_extend q ε (leOfHom h) f.hom a }
  map_id F := by
    ext C a
    change extendStagePoint q ε F (Finset.Subset.refl _) a = a
    apply (stagePointPolynomialEquiv q ε F).injective
    exact Subtype.ext (extendStagePoint_polynomial q ε _ a)
  map_comp {F G H} h g := by
    ext C a
    change extendStagePoint q ε F (leOfHom h |>.trans (leOfHom g)) a =
      extendStagePoint q ε G (leOfHom g) (extendStagePoint q ε F (leOfHom h) a)
    apply (stagePointPolynomialEquiv q ε H).injective
    apply Subtype.ext
    rw [extendStagePoint_polynomial, extendStagePoint_polynomial, extendStagePoint_polynomial]

/-- The stage maps fit into the regular extension functor's cocone. -/
def extensionCocone : Cocone (extensionStageDiagram q ε) where
  pt := extensionFunctor q ε
  ι :=
    { app := fun F =>
        { app := fun _ => ↾stageToColimit q ε F
          naturality := fun {_ _} f => by
            ext a
            exact (stageToColimit_natural q ε F f.hom a).symm }
      naturality := fun {F G} h => by
        ext C a
        change stageToColimit q ε G (extendStagePoint q ε F (leOfHom h) a) = stageToColimit q ε F a
        apply (extensionColimitEquiv q ε).injective
        exact extendStagePoint_polynomial q ε (leOfHom h) a }

/-- The extension functor is the colimit in the category of functors on test algebras. -/
def extensionCoconeIsColimit : IsColimit (extensionCocone q ε) :=
  evaluationJointlyReflectsColimits _ fun C =>
    { desc := fun s => ↾extensionColimitLift q ε
        (fun F a => s.ι.app F a) (fun F G h a =>
          congrArg (fun g => g a) (s.w (homOfLE h : F ⟶ G)))
      fac := fun s F => by
        ext a
        rfl
      uniq := fun s m same => by
        ext z
        refine Quotient.inductionOn z ?_
        intro a
        exact congrArg (fun g => g a.2) (same a.1) }

/-- The finite stage's algebra map changes coefficients by composition. -/
theorem stagePointAlgHomEquiv_natural (F : Finset (X →₀ ℕ)) (f : C →ₐ[k] C')
    (a : StagePoint (C := C) q ε F) :
    stagePointAlgHomEquiv q ε F (mapStagePoint q ε F f a) =
      f.comp (stagePointAlgHomEquiv q ε F a) := by
  apply Ideal.Quotient.algHom_ext
  apply MvPolynomial.algHom_ext
  intro m
  change MvPolynomial.aeval (mapStagePoint q ε F f a).val (MvPolynomial.X m) =
    f (MvPolynomial.aeval a.val (MvPolynomial.X m))
  simp only [MvPolynomial.aeval_X]
  rfl

/-- Pullback of relative scheme points applies the global sections map to the coefficients. -/
theorem stagePointSchemeEquiv_natural (F : Finset (X →₀ ℕ))
    {T T' : Over (Spec (CommRingCat.of k))} (f : T' ⟶ T) :
    letI := globalSectionsAlgebra T
    letI := globalSectionsAlgebra T'
    ∀ a : StagePoint (C := Γ(T.left, ⊤)) q ε F,
      stagePointSchemeEquiv q ε F T' (mapStagePoint q ε F (globalSectionsMap f) a) =
        f ≫ stagePointSchemeEquiv q ε F T a := by
  letI := globalSectionsAlgebra T
  letI := globalSectionsAlgebra T'
  intro a
  apply (specOverPointEquiv T' (StageAlgebra q ε F)).injective
  rw [specOverPointEquiv_precomp]
  change (specOverPointEquiv T' (StageAlgebra q ε F))
      ((specOverPointEquiv T' (StageAlgebra q ε F)).symm
        (stagePointAlgHomEquiv q ε F (mapStagePoint q ε F (globalSectionsMap f) a))) =
    (globalSectionsMap f).comp ((specOverPointEquiv T (StageAlgebra q ε F))
      ((specOverPointEquiv T (StageAlgebra q ε F)).symm (stagePointAlgHomEquiv q ε F a)))
  rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply, stagePointAlgHomEquiv_natural]

/-- The finite-stage coordinate rings, contravariant in inclusion of monomial sets. -/
def extensionCoordinateDiagram : Finset (X →₀ ℕ) ⥤ (CommAlgCat.{u} k)ᵒᵖ where
  obj F := op (CommAlgCat.of k (StageAlgebra q ε F))
  map {F G} h := (CommAlgCat.ofHom (extensionStageAlgebraMap q ε F (leOfHom h))).op
  map_id F := by
    apply Quiver.Hom.unop_inj
    change CommAlgCat.ofHom (extensionStageAlgebraMap q ε F (Finset.Subset.refl _)) = _
    rw [extensionStageAlgebraMap_id, CommAlgCat.ofHom_id]
    rfl
  map_comp {F G H} h g := by
    apply Quiver.Hom.unop_inj
    change CommAlgCat.ofHom (extensionStageAlgebraMap q ε F ((leOfHom h).trans (leOfHom g))) =
      CommAlgCat.ofHom (extensionStageAlgebraMap q ε G (leOfHom g)) ≫
        CommAlgCat.ofHom (extensionStageAlgebraMap q ε F (leOfHom h))
    rw [extensionStageAlgebraMap_comp, CommAlgCat.ofHom_comp]

/-- The coefficient solutions are the affine points of each coordinate scheme, naturally in the test algebra. -/
def stagePointFunctorIso (F : Finset (X →₀ ℕ)) :
    stagePointFunctor q ε F ≅ coyoneda.obj (op (CommAlgCat.of k (StageAlgebra q ε F))) :=
  NatIso.ofComponents (fun C => Equiv.toIso
    ((stagePointAlgHomEquiv (C := C) q ε F).trans
      ⟨CommAlgCat.ofHom, CommAlgCat.Hom.hom, fun _ => rfl, fun _ => rfl⟩)) (by
    intro C C' f
    ext a
    apply CommAlgCat.hom_ext
    exact stagePointAlgHomEquiv_natural q ε F f.hom a)

/-- The finite coefficient equation diagram agrees with the actual affine-point diagram. -/
def extensionStageDiagramIso :
    extensionStageDiagram q ε ≅ extensionCoordinateDiagram q ε ⋙ coyoneda :=
  NatIso.ofComponents (stagePointFunctorIso q ε) (by
    intro F G h
    ext C a
    apply CommAlgCat.hom_ext
    exact stagePointAlgHomEquiv_extend q ε F (leOfHom h) a)

/-- The extension functor receives the geometric stages on affine test algebras. -/
def extensionAffineCocone : Cocone (extensionCoordinateDiagram q ε ⋙ coyoneda) :=
  (Cocones.precompose (extensionStageDiagramIso q ε).inv).obj (extensionCocone q ε)

/-- The geometric stages on affine test algebras have the asserted extension functor as their colimit. -/
def extensionAffineCoconeIsColimit : IsColimit (extensionAffineCocone q ε) :=
  (IsColimit.precomposeInvEquiv (extensionStageDiagramIso q ε) (extensionCocone q ε)).symm
    (extensionCoconeIsColimit q ε)

/-- Distinct required values at the same native tuple rule out a regular extension over k. -/
theorem noExtension_of_eq_input {d e : D} (same : q d = q e) (different : ε d ≠ ε e) :
    IsEmpty (ExtensionColimit (C := k) q ε) := by
  refine ⟨fun a => different ?_⟩
  let p := extensionColimitEquiv q ε a
  have left := p.property d
  have right := p.property e
  simp only [Algebra.algebraMap_self, RingHom.id_apply] at left right
  rw [same] at left
  exact left.symm.trans right

/-- The colimit represents precisely the extending natural scalar operations. -/
def extensionColimitScalarEquiv :
    ExtensionColimit (C := C) q ε ≃ ScalarExtension (C := C) q ε :=
  (extensionColimitEquiv q ε).trans (extensionPolynomialEquiv q ε)

/-- The classification is natural under an arbitrary map of base coefficient algebras. -/
theorem extensionColimitScalarEquiv_natural (f : C →ₐ[k] C') (x : ExtensionColimit (C := C) q ε) :
    extensionColimitScalarEquiv q ε (extensionColimitMap q ε f x) =
      mapScalarExtension q ε f (extensionColimitScalarEquiv q ε x) := by
  apply Subtype.ext
  change polynomialOperation (extensionColimitEquiv q ε (extensionColimitMap q ε f x)).val =
    (polynomialOperation (extensionColimitEquiv q ε x).val).changeBase f.toRingHom
  unfold extensionColimitMap
  rw [Equiv.apply_symm_apply, changeBase_polynomialOperation]
  rfl

end SHIGURE.Quantities
