import Formal.SHIGURE.Part2.QuantityTransport.Maps

/-!
# Coefficient change of a quantity-model comparison

The square in §5.4 takes the residual ideal to its extended ideal.
Lemma B.3 identifies scalar extension of each Law quotient with the
quotient by the extended residual equations.

## Implementation notes

The extended ideal is generated by the image of the residual equations.
The quotient comparison from Appendix B.1 applies to every coefficient
algebra, so it also handles the localized algebras for principal opens.
-/

open scoped TensorProduct

universe u

noncomputable section

namespace SHIGURE.Quantities.LawMap

variable {k : Type u} [CommRing k] {sig sig' : Signature.{u}}
variable {A : Structure sig} {B : Structure sig'}
variable {P : Presentation k A} {Q : Presentation k B}
variable (h : LawMap P Q)
variable (R : Type u) [CommRing R] [Algebra k R]

/-- The map between the quotients by the extended residual ideals. -/
def extendedEquationMap :
    ((R ⊗[k] P.CoordinateAlgebra) ⧸ baseChangeIdeal R P.residualIdeal) →ₐ[R]
      ((R ⊗[k] Q.CoordinateAlgebra) ⧸ baseChangeIdeal R Q.residualIdeal) :=
  Ideal.quotientMapₐ (baseChangeIdeal R Q.residualIdeal)
    (Algebra.TensorProduct.map (AlgHom.id R R) h.toQuantityMap.polynomial)
    (baseChangeIdeal_le_comap R h.toQuantityMap.polynomial h.residualIdeal_le_comap)

/-- Extend the original Law comparison after imposing the source and target equations. -/
def extendedLawMap : (R ⊗[k] P.LawAlgebra) →ₐ[R] (R ⊗[k] Q.LawAlgebra) :=
  Algebra.TensorProduct.map (AlgHom.id R R) h.algebra

/-- On a pure tensor the two orders use the same transported polynomial class and coefficient. -/
theorem extendedLawMap_tmul (r : R) (a : P.LawAlgebra) :
    h.extendedLawMap R (r ⊗ₜ[k] a) = r ⊗ₜ[k] h.algebra a :=
  Algebra.TensorProduct.map_tmul _ _ _ _

/-- Scalar extension commutes with the comparison of Law quotients. No flatness is assumed. -/
theorem extendedEquationMap_natural :
    (baseChangeQuotient (R := k) R Q.residualIdeal).symm.toAlgHom.comp (h.extendedEquationMap R) =
      (h.extendedLawMap R).comp (baseChangeQuotient (R := k) R P.residualIdeal).symm.toAlgHom :=
  baseChangeQuotient_natural R h.toQuantityMap.polynomial h.residualIdeal_le_comap

end SHIGURE.Quantities.LawMap
