import Formal.SHIGURE.Part2.Minimal.ReachabilityMaps

/-! A chain of N one-dimensional sorts makes the N−1 bound sharp for every N ≥ 2. -/

namespace SHIGURE.Minimal.SharpnessExample

variable (K : Type*) [Field K]
variable (N : ℕ) (hN : 0 < N)

/-- One operation from position `s` to `s+1`, and no other operations. -/
def ChainOp (s t : Fin N) : Type := PLift (t.val = s.val + 1)

/-- Input enters the first sort, and the chain operations are identities. -/
def chainSystem : Word.LinearSystem (K := K) (ChainOp N) (fun _ => K) (fun _ => K) where
  input s := if s.val = 0 then LinearMap.id else 0
  operation _ := LinearMap.id

/-- The first sort of a nonempty chain. -/
def first : Fin N := ⟨0, hN⟩

/-- The word that follows the chain from the first sort to position `n`. -/
noncomputable def chainWord (n : ℕ) (hn : n < N) : Word (ChainOp N) (first N hN) ⟨n, hn⟩ := by
  induction n with
  | zero => exact .nil _
  | succ n ih =>
    exact .snoc (ih (by omega)) ⟨rfl⟩

/-- Every word in this system advances by exactly its length. -/
theorem word_length_eq_displacement {s t : Fin N} (w : Word (ChainOp N) s t) :
    s.val + w.length = t.val := by
  induction w with
  | nil => simp [Word.length]
  | snoc w e ih =>
    have he := e.down
    change s.val + (w.length + 1) = _
    omega

/-- Each canonical chain word acts as the identity of `K`. -/
theorem evaluate_chainWord (n : ℕ) (hn : n < N) :
    (chainWord N hN n hn).evaluate (chainSystem K N) = LinearMap.id := by
  induction n with
  | zero => rfl
  | succ n ih =>
    change LinearMap.id.comp
      ((chainWord N hN n (by omega)).evaluate (chainSystem K N)) = LinearMap.id
    simpa only [LinearMap.id_comp] using ih (by omega)

/-- All sorts are generated by their corresponding chain word. -/
theorem all_sorts_reached : ∀ s, allReach (chainSystem K N) s = ⊤ := by
  intro s
  have hn : 0 < N := (Nat.zero_le s.val).trans_lt s.isLt
  apply top_unique
  intro x _
  apply Submodule.subset_span
  refine ⟨first N hn, chainWord N hn s.val s.isLt, x, ?_⟩
  change x = (chainWord N hn s.val s.isLt).evaluate (chainSystem K N) x
  simp only [evaluate_chainWord, LinearMap.id_apply]

include hN in
/-- A word shorter than the last position cannot deliver a nonzero input there. -/
theorem last_bounded_eq_bot (r : ℕ) (hr : r < N - 1) :
    boundedReach (chainSystem K N) (⟨N - 1, by omega⟩ : Fin N) r = ⊥ := by
  apply le_bot_iff.mp
  apply Submodule.span_le.mpr
  intro x hx
  rcases hx with ⟨s, w, a, hw, rfl⟩
  have hdis := word_length_eq_displacement N w
  change s.val + w.length = N - 1 at hdis
  have hs : s.val ≠ 0 := by omega
  have hin : (chainSystem K N).input s a = 0 := by simp [chainSystem, hs]
  rw [hin, map_zero]
  exact Submodule.zero_mem _

/-- The state-space dimension of the chain is exactly N. -/
theorem chain_dimension : Module.finrank K (∀ _ : Fin N, K) = N := by
  simp [Module.finrank_pi]

/-- For every N ≥ 2, length N−2 fails although all words reach all sorts. -/
theorem bound_is_sharp (hN2 : 2 ≤ N) :
    (∀ s, allReach (chainSystem K N) s = ⊤) ∧
      boundedReach (chainSystem K N) (⟨N - 1, by omega⟩ : Fin N) (N - 2) ≠ ⊤ := by
  have hn : 0 < N := by omega
  refine ⟨all_sorts_reached K N, ?_⟩
  rw [last_bounded_eq_bot K N hn (N - 2) (by omega)]
  intro h
  have h1 : (1 : K) ∈ (⊥ : Submodule K K) := by rw [h]; exact Submodule.mem_top
  exact one_ne_zero ((Submodule.mem_bot K).mp h1)

end SHIGURE.Minimal.SharpnessExample
