import Formal.SHIGURE.Part2.Tensor.CoefficientPoints
import Formal.SHIGURE.Part2.Realizations.TensorMode
import Mathlib.Algebra.DualNumber

/-!
# Recovering native structure maps from their coefficient families

Proposition 4.13. A structured linear map defined over all coefficient
algebras is determined by its component over the base ring.

## Implementation notes

The naturality square is stated on the actual semilinear maps of carrier
elements. Applying the square to the base-ring component determines the
pure tensors with scalar factor one. Linearity and tensor induction then
determine the whole arrow, with its original primitive diagrams.
-/

open CategoryTheory TensorProduct
open scoped TensorProduct

universe u

noncomputable section

namespace SHIGURE.TensorRealization

variable {k : Type u} [CommRing k] {sig : Signature.{u}}

/-- The actual linear, structure-preserving maps over all coefficients, compatible
with every coefficient homomorphism on module elements. -/
structure NaturalTensorHom (A B : TensorStructure k sig) where
  /-- All the components of the family. -/
  app (R : Type u) [CommRing R] [Algebra k R] : extendStructure k R A ⟶ extendStructure k R B
  /-- Each component is compatible with transporting all carrier elements. -/
  natural {R S : Type u} [CommRing R] [CommRing S] [Algebra k R] [Algebra k S]
    (f : R →ₐ[k] S) (s : sig.SortType) (x : R ⊗[k] A.carrier s) :
    mapCoefficients f ((app R).onSort s x) = (app S).onSort s (mapCoefficients f x)

namespace NaturalTensorHom

variable {A B D : TensorStructure k sig}

/-- Equality of families is determined by their components. -/
@[ext]
theorem ext {f g : NaturalTensorHom A B} (h : ∀ (R : Type u) [CommRing R] [Algebra k R],
    f.app R = g.app R) : f = g := by
  cases f
  cases g
  congr
  funext R _ _
  exact h R

/-- The family generated by changing the coefficients of a native map. -/
def ofNative (g : A ⟶ B) : NaturalTensorHom A B where
  app R := extendStructureMap R g
  natural f s x := LinearMap.rTensor_baseChange f x (g.onSort s)

/-- Read the base component through the structured unit isomorphisms. -/
def native (f : NaturalTensorHom A B) : A ⟶ B :=
  (structureScalarUnit A).inv ≫ f.app k ≫ (structureScalarUnit B).hom

/-- The base algebra arrow becomes the unit state inclusion after reading the scalar unit. -/
private theorem baseArrowTensor {R M : Type u} [CommRing R] [Algebra k R]
    [AddCommGroup M] [Module k M] (x : k ⊗[k] M) :
    mapCoefficients (Algebra.ofId k R) x = (1 : R) ⊗ₜ[k] scalarUnit x := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul a m =>
    rw [mapCoefficients_tmul, scalarUnit_tmul, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
    rfl
  | add x y hx hy => simp only [map_add, tmul_add, hx, hy]

/-- Naturality along the unit algebra map determines the value at a unit tensor. -/
theorem app_unit {R : Type u} [CommRing R] [Algebra k R] (f : NaturalTensorHom A B)
    (s : sig.SortType) (x : A.carrier s) :
    (f.app R).onSort s ((1 : R) ⊗ₜ[k] x) = (1 : R) ⊗ₜ[k] f.native.onSort s x := by
  have h := f.natural (Algebra.ofId k R) s ((1 : k) ⊗ₜ[k] x)
  rw [baseArrowTensor, mapCoefficients_tmul, map_one] at h
  change (1 : R) ⊗ₜ[k] f.native.onSort s x = _ at h
  exact h.symm

/-- On an arbitrary pure tensor the family applies the recovered native map to the module factor. -/
theorem app_tmul {R : Type u} [CommRing R] [Algebra k R] (f : NaturalTensorHom A B)
    (s : sig.SortType) (r : R) (x : A.carrier s) :
    (f.app R).onSort s (r ⊗ₜ[k] x) = r ⊗ₜ[k] f.native.onSort s x := by
  calc
    _ = (f.app R).onSort s (r • ((1 : R) ⊗ₜ[k] x)) := by
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    _ = r • ((1 : R) ⊗ₜ[k] f.native.onSort s x) := by rw [map_smul, app_unit]
    _ = _ := by rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]

/-- Every natural family is the coefficient extension of its recovered native map. -/
theorem ofNative_native (f : NaturalTensorHom A B) : ofNative f.native = f := by
  apply NaturalTensorHom.ext
  intro R _ _
  apply TensorStructure.Hom.ext
  funext s
  change (f.native.onSort s).baseChange R =
    ((f.app R).onSort s : R ⊗[k] A.carrier s →ₗ[R] R ⊗[k] B.carrier s)
  apply AlgebraTensorModule.ext
  intro r x
  rw [show (r : R) ⊗ₜ[k] x = r • ((1 : R) ⊗ₜ[k] x) by
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one], map_smul, map_smul]
  rw [LinearMap.baseChange_tmul]
  exact congrArg (fun y : R ⊗[k] B.carrier s => r • y) (f.app_unit (R := R) s x).symm

/-- Reading the family of a native map recovers that exact map. -/
theorem native_ofNative (g : A ⟶ B) : (ofNative g).native = g := by
  apply TensorStructure.Hom.ext
  funext s
  apply LinearMap.ext
  intro x
  change scalarUnit ((g.onSort s).baseChange k (scalarUnit.symm x)) = g.onSort s x
  have h : scalarUnit.symm x = (1 : k) ⊗ₜ[k] x := by
    apply scalarUnit.injective
    rw [LinearEquiv.apply_symm_apply, scalarUnit_tmul, one_smul]
  rw [h, LinearMap.baseChange_tmul, scalarUnit_tmul, one_smul]

/-- The family with the identity at each coefficient algebra. -/
def id (A : TensorStructure k sig) : NaturalTensorHom A A where
  app R := 𝟙 (extendStructure k R A)
  natural _ _ _ := rfl

/-- The componentwise composition of natural families. -/
def comp (f : NaturalTensorHom A B) (g : NaturalTensorHom B D) : NaturalTensorHom A D where
  app R := f.app R ≫ g.app R
  natural h s x := by
    change mapCoefficients h ((g.app _).onSort s ((f.app _).onSort s x)) = _
    rw [g.natural, f.natural]
    rfl

/-- Extending the native identity gives the identity family. -/
theorem ofNative_id (A : TensorStructure k sig) : ofNative (𝟙 A) = id A := by
  apply NaturalTensorHom.ext
  intro R _ _
  exact (extendStructureFunctor k R sig).map_id A

/-- Extending composition gives the composition of the extended families. -/
theorem ofNative_comp (f : A ⟶ B) (g : B ⟶ D) :
    ofNative (f ≫ g) = (ofNative f).comp (ofNative g) := by
  apply NaturalTensorHom.ext
  intro R _ _
  exact (extendStructureFunctor k R sig).map_comp f g

/-- The bijection of Proposition 4.13, on all native and natural structured maps. -/
def nativeEquiv (A B : TensorStructure k sig) : (A ⟶ B) ≃ NaturalTensorHom A B where
  toFun := ofNative
  invFun := native
  left_inv := native_ofNative
  right_inv := ofNative_native

end NaturalTensorHom

/-- Every preserving linear map at the fixed coefficients is a semantic arrow of the full Law model category. -/
def fixedCoefficientTensorHomEquiv {base : CoefficientRing.{u}} (T : RealizationTheory.{u})
    (R : CoefficientAlgebra base) (scope : FullDomainTensorSignature T.signature)
    (holds : TensorAt R.scalars T.signature → T.Statement → Prop)
    (A B : TensorModelsAt T R scope holds) :
    letI := R.scalars.ring
    (A ⟶ B) ≃ TensorStructure.Hom A.obj B.obj := by
  letI := R.scalars.ring
  let e := tensorStructureHomEquiv (R := R.scalars.Carrier) T.signature scope A.obj B.obj
  exact
    { toFun := fun f => e f.hom
      invFun := fun f => ObjectProperty.homMk (e.symm f)
      left_inv := fun f => ObjectProperty.hom_ext _ (e.symm_apply_apply f.hom)
      right_inv := fun f => e.apply_symm_apply f }

/-- Fixed-coefficient arrow comparison preserves the actual categorical identities. -/
theorem fixedCoefficientTensorHomEquiv_id {base : CoefficientRing.{u}} (T : RealizationTheory.{u})
    (R : CoefficientAlgebra base) (scope : FullDomainTensorSignature T.signature)
    (holds : TensorAt R.scalars T.signature → T.Statement → Prop) (A : TensorModelsAt T R scope holds) :
    letI := R.scalars.ring
    fixedCoefficientTensorHomEquiv T R scope holds A A (𝟙 A) = TensorStructure.Hom.id A.obj := by
  letI := R.scalars.ring
  exact TensorStructure.Hom.ext rfl

/-- Fixed-coefficient arrow comparison preserves composition of all semantic arrows. -/
theorem fixedCoefficientTensorHomEquiv_comp {base : CoefficientRing.{u}} (T : RealizationTheory.{u})
    (R : CoefficientAlgebra base) (scope : FullDomainTensorSignature T.signature)
    (holds : TensorAt R.scalars T.signature → T.Statement → Prop) (A B D : TensorModelsAt T R scope holds)
    (f : A ⟶ B) (g : B ⟶ D) :
    letI := R.scalars.ring
    fixedCoefficientTensorHomEquiv T R scope holds A D (f ≫ g) =
      (fixedCoefficientTensorHomEquiv T R scope holds A B f).comp
        (fixedCoefficientTensorHomEquiv T R scope holds B D g) := by
  letI := R.scalars.ring
  exact TensorStructure.Hom.ext rfl

private def scalarSignature : Signature where
  SortType := PUnit
  Total := PEmpty
  Rel := PEmpty
  Partial := PEmpty
  Quantity := PEmpty
  totalArity := PEmpty.elim
  relInputs := PEmpty.elim
  partialArity := PEmpty.elim
  quantityArity := PEmpty.elim

private def nativeScalar (k : Type u) [CommRing k] : TensorStructure k scalarSignature where
  carrier _ := ModuleCat.of k k
  total f := PEmpty.elim f
  quantity q := PEmpty.elim q

/-- Multiplication by ε is a linear map on the scalar sort over the dual numbers. -/
def dualNumberEpsilonMap (k : Type u) [Field k] :
    extendStructure k (DualNumber k) (nativeScalar k) ⟶
      extendStructure k (DualNumber k) (nativeScalar k) where
  onSort _ := (extendScalarSort (k := k) (DualNumber k)).symm.toLinearMap.comp
    ((LinearMap.toSpanSingleton (DualNumber k) (DualNumber k) DualNumber.eps).comp
      (extendScalarSort (k := k) (DualNumber k)).toLinearMap)
  preservesTotal f := PEmpty.elim f
  preservesQuantity q := PEmpty.elim q

/-- The scalar comparison reads the fixed-coefficient map as multiplication by ε. -/
theorem dualNumberEpsilonMap_apply {k : Type u} [Field k] (z : DualNumber k) :
    extendScalarSort (k := k) (DualNumber k)
      ((dualNumberEpsilonMap k).onSort PUnit.unit ((extendScalarSort (k := k) (DualNumber k)).symm z)) =
    z * DualNumber.eps := by
  change extendScalarSort (k := k) (DualNumber k) ((extendScalarSort (k := k) (DualNumber k)).symm
    (extendScalarSort (k := k) (DualNumber k) ((extendScalarSort (k := k) (DualNumber k)).symm z) * DualNumber.eps)) = _
  rw [LinearEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply]

/-- The dual-number map cannot be obtained by extending a native map on the field. -/
theorem dualNumberEpsilonMap_not_extension (k : Type u) [Field k] :
    dualNumberEpsilonMap k ∉ Set.range
      (extendStructureMap (DualNumber k) (A := nativeScalar k) (B := nativeScalar k)) := by
  rintro ⟨g, hg⟩
  let R := DualNumber k
  let x : R ⊗[k] k := (1 : R) ⊗ₜ[k] (1 : k)
  have hx : (extendScalarSort (k := k) R).symm 1 = x := by
    apply (extendScalarSort (k := k) R).injective
    rw [LinearEquiv.apply_symm_apply]
    exact (one_smul k (1 : R)).symm
  have h := congrArg (fun f => extendScalarSort (k := k) R (f.onSort PUnit.unit x)) hg
  let g₀ : k →ₗ[k] k := g.onSort PUnit.unit
  change extendScalarSort (k := k) R (g₀.baseChange R x) = _ at h
  have h₀ : (algebraMap k R (g₀ 1)) = extendScalarSort (k := k) R (g₀.baseChange R x) := by
    change _ = extendScalarSort (k := k) R (g₀.baseChange R ((1 : R) ⊗ₜ[k] (1 : k)))
    rw [LinearMap.baseChange_tmul, extendScalarSort_tmul, Algebra.smul_def, mul_one]
  have hε : extendScalarSort (k := k) R ((dualNumberEpsilonMap k).onSort PUnit.unit x) = DualNumber.eps := by
    rw [← hx]
    exact (dualNumberEpsilonMap_apply (1 : DualNumber k)).trans (one_mul _)
  exact zero_ne_one (congrArg TrivSqZeroExt.snd (h₀.trans (h.trans hε)) : (0 : k) = 1)

/-- The dual-number map cannot be a component of a natural family over all coefficient algebras. -/
theorem dualNumberEpsilonMap_not_natural (k : Type u) [Field k] :
    ¬ ∃ f : NaturalTensorHom (nativeScalar k) (nativeScalar k), f.app (DualNumber k) = dualNumberEpsilonMap k := by
  rintro ⟨f, hf⟩
  apply dualNumberEpsilonMap_not_extension k
  refine ⟨f.native, ?_⟩
  exact (congrArg (fun g : NaturalTensorHom (nativeScalar k) (nativeScalar k) => g.app (DualNumber k))
    f.ofNative_native).trans hf

private def scalarTheory : RealizationTheory.{u} :=
  ⟨scalarSignature, PEmpty, PEmpty, fun l => nomatch l⟩

private def scalarScope : FullDomainTensorSignature scalarSignature :=
  ⟨⟨fun r => nomatch r⟩, ⟨fun p => nomatch p⟩⟩

private def dualNumberCoefficientAlgebra (k : Type u) [Field k] : CoefficientAlgebra ⟨k, inferInstance⟩ :=
  ⟨⟨DualNumber k, inferInstance⟩, algebraMap k (DualNumber k)⟩

private def dualNumberScalarModel (k : Type u) [Field k] :
    TensorModelsAt scalarTheory (dualNumberCoefficientAlgebra k) scalarScope (fun _ l => nomatch l) :=
  ⟨extendStructure k (DualNumber k) (nativeScalar k), trivial, fun l => nomatch l⟩

private def dualNumberScalarHomEquiv (k : Type u) [Field k] :=
  fixedCoefficientTensorHomEquiv scalarTheory (dualNumberCoefficientAlgebra k) scalarScope
    (fun _ l => nomatch l) (dualNumberScalarModel k) (dualNumberScalarModel k)

/-- Multiplication by the nilpotent is a morphism in the fixed-coefficient tensor meaning category. -/
def dualNumberEpsilonSemanticMap (k : Type u) [Field k] :
    dualNumberScalarModel k ⟶ dualNumberScalarModel k :=
  (dualNumberScalarHomEquiv k).symm (dualNumberEpsilonMap k)

/-- That semantic morphism lies outside the coefficient extensions of native linear maps. -/
theorem dualNumberEpsilonSemanticMap_not_extension (k : Type u) [Field k] :
    dualNumberEpsilonSemanticMap k ∉ Set.range (fun g : nativeScalar k ⟶ nativeScalar k =>
      (dualNumberScalarHomEquiv k).symm (extendStructureMap (DualNumber k) g)) := by
  rintro ⟨g, h⟩
  apply dualNumberEpsilonMap_not_extension k
  exact ⟨g, (dualNumberScalarHomEquiv k).symm.injective h⟩

end SHIGURE.TensorRealization
